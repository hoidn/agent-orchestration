(workflow-lisp
  (:language "0.1")
  (:target-dsl "3.0")
  (:budget 50000)
  (defmodule dynamic_consumer/search)
  (import dynamic_consumer/types :only (Candidate Evaluation Trial SearchResult))
  (export run-search)

  (define (propose operation branch base other history-size)
    (command-result propose-branch-candidate
      :adapter propose_candidate
      :inputs ((operation operation) (branch branch)
               (candidate_a (field base "a")) (candidate_b (field base "b"))
               (other_a (field other "a")) (other_b (field other "b"))
               (history_size history-size))
      :returns Candidate))

  (define (evaluate-candidate candidate)
    (command-result evaluate-branch-candidate
      :adapter evaluate_candidate
      :inputs ((a (field candidate "a")) (b (field candidate "b")))
      :returns Evaluation))

  (define (make-trial action branch parents candidate evaluation accepted)
    (record (action action) (branch branch) (parents parents)
            (candidate candidate) (evaluation evaluation) (accepted accepted)))

  (define (result state status)
    (record (candidate (field state "best"))
            (evaluation (field state "best_evaluation"))
            (evaluations (field state "evaluations"))
            (status status)
            (trace (field state "history"))))

  (define (seed-b-is-best seed-a-evaluation seed-b-evaluation)
    (if (field seed-b-evaluation "valid")
        (if (= (field seed-a-evaluation "valid") false)
            true
            (< (field seed-b-evaluation "score")
               (field seed-a-evaluation "score")))
        false))

  (define (initial-state seed-a seed-a-evaluation seed-b seed-b-evaluation)
    (let* ((seed-b-best (seed-b-is-best seed-a-evaluation seed-b-evaluation))
           (best (if seed-b-best seed-b seed-a))
           (best-evaluation (if seed-b-best seed-b-evaluation seed-a-evaluation))
           (seed-a-trial (make-trial "seed" "A" (list) seed-a seed-a-evaluation true))
           (seed-b-trial (make-trial "seed" "B" (list) seed-b seed-b-evaluation true)))
      (record (a seed-a) (a_evaluation seed-a-evaluation)
              (b seed-b) (b_evaluation seed-b-evaluation)
              (best best) (best_evaluation best-evaluation)
              (history (list seed-a-trial seed-b-trial))
              (evaluations 2) (next_branch "A")
              (pending_branch "none") (pending_candidate seed-a)
              (stall_a 0) (stall_b 0) (fused false))))

  (define (branch-step state operation branch)
    (let* ((current (if (= branch "A") (field state "a") (field state "b")))
           (other (if (= branch "A") (field state "b") (field state "a")))
           (base (if (= operation "repair") (field state "pending_candidate") current))
           (parents (if (= operation "repair")
                        (list (field state "pending_candidate"))
                        (list current)))
           (candidate (propose operation branch base other (field state "evaluations")))
           (evaluation (evaluate-candidate candidate))
           (current-evaluation (if (= branch "A")
                                   (field state "a_evaluation")
                                   (field state "b_evaluation")))
           (accepted (if (field evaluation "valid")
                         (< (field evaluation "score")
                            (field current-evaluation "score"))
                         false))
           (best-changed (if accepted
                             (< (field evaluation "score")
                                (field (field state "best_evaluation") "score"))
                             false))
           (trial (make-trial operation branch parents candidate evaluation accepted))
           (next-pending (if (= operation "repair")
                             "none"
                             (if (field evaluation "valid") "none" branch)))
           (next (record-update state
                   (best (if best-changed candidate (field state "best")))
                   (best_evaluation (if best-changed evaluation
                                        (field state "best_evaluation")))
                   (history (list/append (field state "history") trial))
                   (evaluations (+ (field state "evaluations") 1))
                   (next_branch (if (= branch "A") "B" "A"))
                   (pending_branch next-pending)
                   (pending_candidate (if (= operation "repair")
                                          (field state "pending_candidate")
                                          candidate)))))
      (if (= branch "A")
          (record-update next
            (a (if accepted candidate (field state "a")))
            (a_evaluation (if accepted evaluation (field state "a_evaluation")))
            (stall_a (if accepted 0 (+ (field state "stall_a") 1))))
          (record-update next
            (b (if accepted candidate (field state "b")))
            (b_evaluation (if accepted evaluation (field state "b_evaluation")))
            (stall_b (if accepted 0 (+ (field state "stall_b") 1)))))))

  (define (fusion-step state max-evaluations target-score iteration)
    (let* ((candidate (propose "fuse" "both" (field state "a")
                               (field state "b") (field state "evaluations")))
           (evaluation (evaluate-candidate candidate))
           (accepted (if (field evaluation "valid")
                         (< (field evaluation "score")
                            (field (field state "best_evaluation") "score"))
                         false))
           (trial (make-trial "fuse" "both"
                              (list (field state "a") (field state "b"))
                              candidate evaluation accepted))
           (next (record-update state
                   (best (if accepted candidate (field state "best")))
                   (best_evaluation (if accepted evaluation
                                        (field state "best_evaluation")))
                   (history (list/append (field state "history") trial))
                   (evaluations (+ (field state "evaluations") 1))
                   (stall_a 0) (stall_b 0) (fused true))))
      (search-loop next max-evaluations target-score (+ iteration 1))))

  (define (search-loop state max-evaluations target-score iteration)
    (if (= iteration 16)
        (result state "loop_bound_exhausted")
        (if (if (field (field state "best_evaluation") "valid")
                (<= (field (field state "best_evaluation") "score") target-score)
                false)
            (result state "solved")
            (if (>= (field state "evaluations") max-evaluations)
                (result state "budget_exhausted")
                (if (!= (field state "pending_branch") "none")
                    (search-loop
                      (branch-step state "repair" (field state "pending_branch"))
                      max-evaluations target-score (+ iteration 1))
                    (if (if (= (field state "fused") false)
                            (if (>= (field state "stall_a") 2)
                                (>= (field state "stall_b") 2)
                                false)
                            false)
                        (fusion-step state max-evaluations target-score iteration)
                        (search-loop
                          (branch-step state "improve" (field state "next_branch"))
                          max-evaluations target-score (+ iteration 1))))))))

  (define (invalid-budget target-score)
    (record (candidate (record (a 1) (b 0)))
            (evaluation (record (valid false) (score target-score) (error "invalid_budget")))
            (evaluations 0) (status "invalid_budget") (trace (list))))

  (define (search-start max-evaluations target-score)
    (if (< max-evaluations 2)
        (invalid-budget target-score)
        (if (> max-evaluations 16)
            (invalid-budget target-score)
            (let* ((seed-a (record (a 1) (b 0)))
                   (seed-a-evaluation (evaluate-candidate seed-a))
                   (seed-b (record (a 0) (b 1)))
                   (seed-b-evaluation (evaluate-candidate seed-b))
                   (state (initial-state seed-a seed-a-evaluation
                                         seed-b seed-b-evaluation)))
              (search-loop state max-evaluations target-score 0)))))

  (defworkflow run-search ((max_evaluations Int) (target_score Float)) -> SearchResult
    (search-start max_evaluations target_score)))

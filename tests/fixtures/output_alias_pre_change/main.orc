(workflow-lisp (:language "0.1") (:target-dsl "2.40")
  (defmodule main) (export run)
  (defpath Report :kind relpath :under "artifacts" :must-exist false)
  (defrecord Result (ok Bool))
  (defprompt review (:fills (a :path :out Report) (b :path :out Report)) -> Result "A={a} B={b}")
  (defworkflow run ((message String) (report Report)) -> Result
    (let* ((one (provider-result providers.review :prompt (review :a report :b report)))
           (two (provider-result providers.review :prompt prompts.two :inputs (message)
                  :model "m" :effort "low" :returns Result)))
      two)))

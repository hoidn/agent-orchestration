+"""Interactive Workflow Lisp REPL (first cut: session loop only)."""
+
+import sys
+
+_HELP = """Commands:
+  :help   show this help
+  :quit   leave the REPL
+Expressions are not evaluated yet."""
+
+
+def repl_workflow(args) -> int:
+    """Read forms from standard input until :quit or end of input."""
+    for raw in sys.stdin:
+        line = raw.strip()
+        if not line:
+            continue
+        if line == ":quit":
+            return 0
+        if line == ":help":
+            print(_HELP)
+            continue
+        print(f"[repl_unsupported] cannot evaluate {line!r} yet", file=sys.stderr)
+    return 0

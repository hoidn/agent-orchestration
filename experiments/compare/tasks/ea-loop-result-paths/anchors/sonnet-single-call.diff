diff --git a/tests/test_workflow_lisp_loop_result_paths.py b/tests/test_workflow_lisp_loop_result_paths.py
new file mode 100644
index 0000000..48947a5
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths.py
@@ -0,0 +1,75 @@
+"""Loop results with path fields in non-exhausted variants compile and run at 2.28 and 2.29+."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.loaded_bundle import workflow_runtime_input_contracts
+from orchestrator.workflow.signatures import bind_workflow_inputs
+from orchestrator.workflow_lisp.compiler import compile_stage3_module
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+SOURCE = """\
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "{version}")
+  (defpath Report :kind relpath :under "artifacts/review" :must-exist true)
+  (defunion Outcome
+    (READY (report Report) (rounds Int))
+    (UNRESOLVED (rounds Int)))
+  (defworkflow path-loop ((report Report) (finish Bool)) -> Outcome
+    (loop/recur :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (if finish
+            (done (variant Outcome READY :report report :rounds state.round))
+            (continue (loop-state :like state :round (+ state.round 1))))))))
+"""
+
+
+def _run(tmp_path: Path, version: str, finish: bool):
+    module_path = tmp_path / "path_loop.orc"
+    module_path.write_text(SOURCE.format(version=version), encoding="utf-8")
+    report = tmp_path / "artifacts" / "review" / "r.md"
+    report.parent.mkdir(parents=True)
+    report.write_text("ok", encoding="utf-8")
+    bundle = next(
+        iter(
+            compile_stage3_module(
+                module_path, validate_shared=True, workspace_root=tmp_path
+            ).validated_bundles.values()
+        )
+    )
+    public_inputs = {
+        name: contract
+        for name, contract in workflow_runtime_input_contracts(bundle).items()
+        if not name.startswith("__write_root__")
+    }
+    state_manager = StateManager(workspace=tmp_path, run_id=f"r-{version}-{finish}")
+    state_manager.initialize(
+        str(module_path),
+        context=bundle_context_dict(bundle),
+        bound_inputs=bind_workflow_inputs(
+            public_inputs,
+            {"report": "artifacts/review/r.md", "finish": finish},
+            tmp_path,
+        ),
+    )
+    return WorkflowExecutor(bundle, tmp_path, state_manager, retry_delay_ms=0).execute(
+        on_error="stop"
+    )
+
+
+@pytest.mark.parametrize("version", ["2.28", "2.29", "2.32"])
+@pytest.mark.parametrize("finish", [True, False])
+def test_loop_union_result_with_path_field_runs(tmp_path: Path, version: str, finish: bool) -> None:
+    state = _run(tmp_path, version, finish)
+
+    assert state["status"] == "completed"
+    outputs = state["workflow_outputs"]
+    assert outputs["return__rounds"] == (1 if finish else 2)

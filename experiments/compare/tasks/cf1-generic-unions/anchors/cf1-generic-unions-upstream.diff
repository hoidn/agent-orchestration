+{
+  "R256": {
+    "cause": 2, "contracts": 2, "generality": 2, "fit": 2, "merge": "yes",
+    "why": {
+      "cause": "validation.py _validate_repeat_until_on_exhausted now checks the exact compiler-ref allowance before the relpath rejection, which fixes the compile error where it arises. loops.py repeat_until_exhaustion_artifacts resolves the stored {ref} overrides, so the union match no longer reads raw ref payloads through LoopOutputAddress.",

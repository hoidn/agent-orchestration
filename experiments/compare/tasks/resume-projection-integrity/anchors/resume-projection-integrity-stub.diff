@@ -0,0 +1,56 @@
+"""Resume projection integrity audit (first cut: entry points only, no checks)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Path from the root run to one audited scope."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(root_workflow_file=workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Audit failure carrying its diagnostic (first cut: never raised)."""
+
+    def __init__(self, error: Mapping[str, Any]) -> None:
+        super().__init__(str(error.get("message", "")))
+        self.error = dict(error)
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Malformed or ambiguous call-frame lineage (first cut: never raised)."""
+
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class RetryFrameMember:
+    frame_id: str
+    ordinal: int
+
+
+def audit_scope(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+    """First cut: accept every scope."""
+    return None
+
+
+def index_retry_lineage(boundary_step_id: str, frame_items: Iterable[tuple[str, Any]], *, frontend_kind: str | None) -> Any:
+    raise NotImplementedError("index_retry_lineage")
+
+
+def next_unused_retry_frame_id(lineage: Any) -> str:
+    raise NotImplementedError("next_unused_retry_frame_id")

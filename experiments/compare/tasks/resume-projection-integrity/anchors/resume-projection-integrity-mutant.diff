+class CallFrameRetryLineageError(ValueError):
+    """Reject malformed or ambiguous persisted call-frame lineage."""
+
+    def __init__(
+        self,
+        reason: str,
+        *,
+        frame_id: str | None = None,
+        offending_value: Any = None,
+    ) -> None:
+        self.reason = reason

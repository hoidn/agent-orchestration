#!/usr/bin/env bash
# Experiment PATH guard for both CLI names. Absolute paths, reset PATH and direct APIs bypass it;
# session metadata is scanned separately. Exact IDs deliberately refuse unknown model tiers.
name=$(basename "$0"); here=$(cd "$(dirname "$0")" && pwd -P); real=
case $name in
  claude) default=claude-sonnet-5-5 ;;
  codex) default=gpt-5.6-terra ;;
  *) echo "model guard: unsupported CLI '$name'" >&2; exit 2 ;;
esac
refuse() { echo "model guard: $*" >&2; exit 2; }
check_model() {
  [ "$1" = "$default" ] || refuse "'$1' is outside the owner's Sonnet/Terra model cap"
  if [ "$name" = claude ] && [ -n "${ORC_ALLOWED_CLAUDE_MODELS+set}" ]; then
    case ,$ORC_ALLOWED_CLAUDE_MODELS, in
      *,"$1",*) return ;;
    esac
    refuse "'$1' is outside the criterion's allowed Claude model IDs"
  fi
}
# A config file/table/profile can change model routes or enable native agents. Only the binding's
# ordinary scalar effort setting is admitted; quoted values must be single TOML string literals.
check_config() {
  [[ $1 =~ ^model_reasoning_effort=(none|minimal|low|medium|high|xhigh|\"(none|minimal|low|medium|high|xhigh)\"|\'(none|minimal|low|medium|high|xhigh)\')$ ]] ||
    refuse "configuration override '$1' is not an ordinary effort setting"
}
given=; args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg=${args[i]}; model=
  case $arg in
    --) break ;;
    --model) given=1; model=${args[i + 1]-} ;;
    --model=*) given=1; model=${arg#--model=} ;;
    --fallback-model) model=${args[i + 1]-} ;;
    --fallback-model=*) model=${arg#--fallback-model=} ;;
    *)
      if [ "$name" = codex ]; then
        case $arg in
          -m) given=1; model=${args[i + 1]-} ;;
          -m*) given=1; model=${arg#-m}; model=${model#=} ;;
          -c|--config) check_config "${args[i + 1]-}"; continue ;;
          -c*) check_config "${arg#-c}"; continue ;;
          --config=*) check_config "${arg#--config=}"; continue ;;
          cloud|remote-control|dispatch|queue|resume|fork|review|--remote|--remote=*|--approve-for-me|-p*|--profile|--profile=*|--model-provider|--model-provider=*|--local-provider|--local-provider=*|--oss|--enable|--enable=*)
            refuse "'$arg' can override the model route or native-agent policy" ;;
          *) continue ;;
        esac
      else
        case $arg in
          --cloud|--cloud=*|--environment|--environment=*|--desktop|ultrareview|--remote-control|--remote-control=*|--settings|--settings=*)
            refuse "'$arg' can dispatch an independently configured agent" ;;
          *) continue ;;
        esac
      fi ;;
  esac
  [[ -n $model && $model != ,* && $model != *, && $model != *,,* ]] || check_model ""
  IFS=, read -ra models <<< "$model"
  for selected in "${models[@]}"; do check_model "$selected"; done
done
[ "${CLAUDE_CODE_SUBAGENT_MODEL:-claude-sonnet-5-5}" = claude-sonnet-5-5 ] ||
  refuse "forbidden forced Claude subagent model '${CLAUDE_CODE_SUBAGENT_MODEL}'"
export CLAUDE_CODE_SUBAGENT_MODEL=claude-sonnet-5-5 CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1
if [ -z "$given" ]; then
  check_model "$default"
  set -- --model "$default" "$@"
fi
if [ "$name" = codex ]; then
  set -- --disable multi_agent --disable multi_agent_v2 --disable multi_agent_v2_dynamic_tools "$@"
fi
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$here" ] && continue
  [ -x "$d/$name" ] && { real="$d/$name"; break; }
done
[ -n "$real" ] || { echo "model guard: no real $name on PATH outside $here" >&2; exit 127; }
exec "$real" "$@"

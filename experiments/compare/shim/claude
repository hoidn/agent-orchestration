#!/usr/bin/env bash
# Stand-in for the agent CLI it is named after (shim/codex links here): runs the next real one on
# PATH with the same arguments and stdin, tees stdout and stderr live, records the call in
# $COMPARE_ROOT/calls/<n>/ with each $COMPARE_TREE/cand-* patch against $COMPARE_BASE, taken through a
# copy of the candidate's index so what the agent staged stays staged. The agent loses PYTHONPATH,
# OLDPWD, COMPARE_* and this directory on PATH (they name the runtime, main checkout and records), and,
# for an ordinary attempt (ORCHESTRATOR_WORKSPACE_ROOT unset), its ORCHESTRATOR_OUTPUT_BUNDLE_PATH and
# ORCHESTRATOR_PROVIDER_ATTEMPT_SITE_KEY (an orchestrator task repository's own code and tests read them, so its
# test runs overwrote the result; the prompt's `- path:` line names the result file relative to the working
# directory). A launch-workspace attempt keeps all three: its prompt tells the agent to use them, so the
# overwrite risk remains there (disclosed in experiments/compare/README.md). It
# runs under bubblewrap with a private /tmp ($COMPARE_TREE/tmp), an empty /var/tmp (other sessions keep
# worktrees there), a private /dev/shm and process list;
# the rest of the filesystem, home and network stay shared: reads there are only detected (R35). Each existing
# directory of the optional colon-separated $COMPARE_HIDE is masked by an empty tmpfs, and the tree is then bound
# back over itself, so a masked parent of the tree leaves the tree reachable.
# The shared model guard is installed under both CLI names and stays first on PATH for nested calls.
# Identical installed copies are left alone; missing copies use atomic hard links, edited ones rename.
# Claude native agents are forced to Sonnet; the guard disables Codex native multiagent features.
: "${COMPARE_ROOT:?the run's records directory}" "${COMPARE_TREE:?the agents' tree}" "${COMPARE_BASE:?the seeded commit}"
sandbox=$(command -v bwrap) || { echo "shim: bubblewrap (bwrap) is required on PATH" >&2; exit 127; }
[ -d "$COMPARE_TREE/tmp" ] || { echo "shim: $COMPARE_TREE/tmp is missing (the agent's /tmp)" >&2; exit 70; }
here=$(cd "$(dirname "$0")" && pwd -P); name=$(basename "$0"); real=; path=
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$here" ] && continue
  path="${path:+$path:}$d"
  [ -z "$real" ] && [ -x "$d/$name" ] && real="$d/$name"
done
[ -n "$real" ] || { echo "shim: no real $name on PATH outside $here" >&2; exit 127; }
mkdir -p "$COMPARE_ROOT/calls"; n=1
until mkdir "$COMPARE_ROOT/calls/$n" 2>/dev/null; do
  [ -d "$COMPARE_ROOT/calls/$n" ] || { echo "shim: cannot create $COMPARE_ROOT/calls/$n" >&2; exit 70; }
  n=$((n + 1))
done
call="$COMPARE_ROOT/calls/$n"
printf '%s\n' "$name" > "$call/provider.txt"
printf '%s\0' "$@" > "$call/argv.nul"
if [ -n "${COMPARE_MAX_CALLS+set}" ]; then
  cap="$COMPARE_MAX_CALLS"
  while [[ "$cap" == 0* && ${#cap} -gt 1 ]]; do cap="${cap#0}"; done
  if [[ ! "$cap" =~ ^[0-9]+$ || ${#n} -gt ${#cap} || ( ${#n} -eq ${#cap} && "$n" > "$cap" ) ]]; then
    echo "shim: call $n refused by COMPARE_MAX_CALLS=$COMPARE_MAX_CALLS" | tee "$call/stderr.txt" >&2
    : > "$call/stdout.txt"
    exit 75
  fi
fi
attempt=(-u ORCHESTRATOR_OUTPUT_BUNDLE_PATH -u ORCHESTRATOR_PROVIDER_ATTEMPT_SITE_KEY)
[ -n "${ORCHESTRATOR_WORKSPACE_ROOT+set}" ] && attempt=()
guard="$COMPARE_TREE/.model-guard"; staged=
for guarded in claude codex; do
  cmp -s "$here/model-guard" "$guard/$guarded" || {
    mkdir -p "$guard" && staged=$(mktemp "$guard/.$guarded.XXXXXX") && cp "$here/model-guard" "$staged" &&
      chmod 755 "$staged" &&
      { ln "$staged" "$guard/$guarded" 2>/dev/null || cmp -s "$staged" "$guard/$guarded" || mv -f "$staged" "$guard/$guarded"; } &&
      rm -f "$staged"
  } || { [ -n "$staged" ] && rm -f "$staged"; echo "shim: cannot install the model guard in $guard" >&2; exit 70; }
done
real="$guard/$name"
hide=()
if [ -n "${COMPARE_HIDE-}" ]; then
  IFS=: read -ra masked <<< "$COMPARE_HIDE"
  for d in "${masked[@]}"; do [ -d "$d" ] && hide+=(--tmpfs "$d"); done
  hide+=(--bind "$COMPARE_TREE" "$COMPARE_TREE")
fi
cat > "$call/prompt.txt"
exec 3> >(tee "$call/stderr.txt" >&2); errors=$!
model_env=(-u ORC_ALLOWED_CLAUDE_MODELS)
if [ -n "${COMPARE_CLAUDE_MODELS+set}" ]; then
  model_env=("ORC_ALLOWED_CLAUDE_MODELS=$COMPARE_CLAUDE_MODELS")
fi
env -u PYTHONPATH -u OLDPWD -u COMPARE_ROOT -u COMPARE_TREE -u COMPARE_BASE -u COMPARE_HIDE -u COMPARE_CLAUDE_MODELS -u COMPARE_MAX_CALLS "${attempt[@]}" "${model_env[@]}" \
  PATH="$guard:$path" CLAUDE_CODE_SUBAGENT_MODEL=claude-sonnet-5-5 CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1 "$sandbox" \
  --dev-bind / / "${hide[@]}" --bind "$COMPARE_TREE/tmp" /tmp --tmpfs /dev/shm --tmpfs /var/tmp --unshare-pid --proc /proc --die-with-parent \
  "$real" "$@" < "$call/prompt.txt" 2>&3 3>&- | tee "$call/stdout.txt" 3>&-
status=${PIPESTATUS[0]}
exec 3>&-; wait "$errors"
shopt -s nullglob
for repo in "$COMPARE_TREE"/cand-*; do
  # cp -p keeps the index mtime, so git still content-checks racily clean entries (same-size edits within the
  # checkout's second would otherwise be read as unchanged)
  t=$(mktemp) && cp -p "$repo/.git/index" "$t" && GIT_INDEX_FILE=$t git -C "$repo" add -A -N . &&
    GIT_INDEX_FILE=$t git -C "$repo" diff --binary --no-ext-diff --no-color --no-textconv \
      --src-prefix=a/ --dst-prefix=b/ "$COMPARE_BASE" > "$call/patch-${repo##*/}.diff"
  rm -f "$t"
done
exit "$status"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ES F1v2 controller-only reference product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bindings",
    "lineage",
    "repository",
    "adaptation",
    "evidence",
    "evaluation",
    "patch",
    "metric",
    "no_delivery",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "es_f1_reference_product.v2"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preedit_policy",
        "a1_anchor",
        "task_seed_manifest",
        "task_profile",
        "configuration_consumer_census",
        "preedit_selector_manifest",
        "visible_task_contract",
        "evaluator_fixture_manifest",
        "governing_design",
        "governing_plan",
        "reference_calibration",
        "f1_evaluator"
      ],
      "properties": {
        "preedit_policy": {},
        "a1_anchor": {},
        "task_seed_manifest": {},
        "task_profile": {},
        "configuration_consumer_census": {},
        "preedit_selector_manifest": {},
        "visible_task_contract": {},
        "evaluator_fixture_manifest": {},
        "governing_design": {},
        "governing_plan": {},
        "reference_calibration": {},
        "f1_evaluator": {}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree",
        "projection_commit",
        "projection_tree",
        "task_seed_commit",
        "task_seed_tree",
        "campaign_parent",
        "campaign_start",
        "campaign_end",
        "reference_commit",
        "reference_tree"
      ],
      "properties": {
        "source_commit": {},
        "source_tree": {},
        "projection_commit": {},
        "projection_tree": {},
        "task_seed_commit": {},
        "task_seed_tree": {},
        "campaign_parent": {},
        "campaign_start": {},
        "campaign_end": {},
        "reference_commit": {},
        "reference_tree": {}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_root",
        "relative_path",
        "locator",
        "head_ref",
        "object_format",
        "commit_count",
        "object_count",
        "unreachable_object_count",
        "repository_snapshot_sha256",
        "reference_commit",
        "reference_tree"
      ],
      "properties": {
        "storage_root": {},
        "relative_path": {},
        "locator": {},
        "head_ref": {},
        "object_format": {},
        "commit_count": {},
        "object_count": {},
        "unreachable_object_count": {},
        "repository_snapshot_sha256": {},
        "reference_commit": {},
        "reference_tree": {}
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "historical_production_paths",
        "historical_production_path_count",
        "historical_production_paths_sha256",
        "rows",
        "new_production_responsibilities"
      ],
      "properties": {
        "strategy": {},
        "historical_production_paths": {},
        "historical_production_path_count": {},
        "historical_production_paths_sha256": {},
        "rows": {},
        "new_production_responsibilities": {}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "root", "members"],
      "properties": {"algorithm": {}, "root": {}, "members": {}}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_tree",
        "evaluation_replay_member_id",
        "normalized_result_sha256"
      ],
      "properties": {
        "target_tree": {},
        "evaluation_replay_member_id": {},
        "normalized_result_sha256": {}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "base_commit", "target_commit", "argv"],
      "properties": {
        "member_id": {},
        "base_commit": {},
        "target_commit": {},
        "argv": {}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_version",
        "git_contract_policy_sha256",
        "rows",
        "totals_by_classification",
        "implementation_additions",
        "implementation_deletions",
        "base_physical_lines",
        "candidate_postimage_physical_lines",
        "base_commit",
        "base_tree",
        "reference_commit",
        "reference_tree",
        "historical_churn"
      ],
      "properties": {
        "metric_version": {},
        "git_contract_policy_sha256": {},
        "rows": {},
        "totals_by_classification": {},
        "implementation_additions": {},
        "implementation_deletions": {},
        "base_physical_lines": {},
        "candidate_postimage_physical_lines": {},
        "base_commit": {},
        "base_tree": {},
        "reference_commit": {},
        "reference_tree": {},
        "historical_churn": {}
      }
    },
    "no_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_member_id",
        "report_sha256",
        "claim_limit",
        "surface_set",
        "reference_canary",
        "decomposition_vocabulary",
        "reference_only_object_catalog_sha256"
      ],
      "properties": {
        "report_member_id": {},
        "report_sha256": {},
        "claim_limit": {},
        "surface_set": {},
        "reference_canary": {},
        "decomposition_vocabulary": {},
        "reference_only_object_catalog_sha256": {}
      }
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

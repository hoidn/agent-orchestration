{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjudicator-review.schema.json",
  "title": "ES F1 adjudicator review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pairwise_results"
  ],
  "properties": {
    "schema_version": {
      "const": "es-f1-adjudicator-review.v1"
    },
    "pairwise_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/pairwiseResult"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_label",
        "citable_item_id"
      ],
      "properties": {
        "opaque_label": {
          "type": "string",
          "pattern": "^opaque-[0-9a-f]{64}$"
        },
        "citable_item_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "pairwiseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_a_label",
        "candidate_b_label",
        "outcome",
        "rationale",
        "citations"
      ],
      "properties": {
        "candidate_a_label": {
          "type": "string",
          "pattern": "^opaque-[0-9a-f]{64}$"
        },
        "candidate_b_label": {
          "type": "string",
          "pattern": "^opaque-[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "A",
            "B",
            "TIE",
            "INDETERMINATE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "citations": {
          "$ref": "#/$defs/citations"
        }
      }
    }
  }
}

diff --git a/tests/test_workflow_lisp_loop_result_paths_target_229.py b/tests/test_workflow_lisp_loop_result_paths_target_229.py
new file mode 100644
index 0000000..31fa8cc
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths_target_229.py
@@ -0,0 +1,139 @@
+"""Loop results with path fields in non-exhausted union variants across targets."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_SOURCE = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "{target}")
+  (defmodule reviewed_change)
+  (export reviewed-change)
+  (defpath ReviewReport :kind relpath :under "artifacts/review" :must-exist true)
+  (defrecord Change (summary String))
+  (defunion Review
+    (APPROVE (report ReviewReport))
+    (REQUEST_CHANGES (report ReviewReport) (findings List[String]))
+    (NEEDS_HUMAN (question String)))
+  (defunion Outcome
+    (READY (report ReviewReport) (rounds Int))
+    (ESCALATED (question String))
+    (UNRESOLVED (rounds Int)))
+  (defprompt review-prompt (:fills (task :text)) -> Review "Review {{task}}")
+  (defprompt fix-prompt (:fills (task :text) (findings :value List[String])) -> Change
+    "Fix {{task}} {{findings}}")
+  (defworkflow reviewed-change ((task String)) -> Outcome
+    (loop/recur :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (let* ((review (provider-result providers.reviewer
+                         :prompt (review-prompt :task task))))
+          (match review
+            ((APPROVE a)
+             (done (variant Outcome READY :report a.report :rounds state.round)))
+            ((REQUEST_CHANGES r)
+             (let* ((fix (provider-result providers.coder
+                           :prompt (fix-prompt :task task :findings r.findings))))
+               (continue (loop-state :like state :round (+ state.round 1)))))
+            ((NEEDS_HUMAN h)
+             (done (variant Outcome ESCALATED :question h.question))))))))
+)
+"""
+
+_REPORT = "artifacts/review/r.md"
+_REQUEST = {"variant": "REQUEST_CHANGES", "report": _REPORT, "findings": ["f"]}
+
+
+def _run(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, target: str, reviews: list):
+    source = tmp_path / "reviewed_change.orc"
+    source.write_text(_SOURCE.format(target=target), encoding="utf-8")
+    providers = tmp_path / "providers.json"
+    providers.write_text(json.dumps({"providers.coder": "coder", "providers.reviewer": "reviewer"}))
+    inputs = tmp_path / "inputs.json"
+    inputs.write_text(json.dumps({"task": "t"}))
+    report = tmp_path / _REPORT
+    report.parent.mkdir(parents=True)
+    report.write_text("ok\n")
+    pending = list(reviews)
+
+    def prepare(_self, provider_name, *_a, **kw):
+        prompt = str(kw.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kw.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kw.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        output = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not output.is_absolute():
+            output = Path.cwd() / output
+        output.parent.mkdir(parents=True, exist_ok=True)
+        payload = pending.pop(0) if invocation.provider_name == "reviewer" else {"summary": "s"}
+        output.write_text(json.dumps(payload) + "\n", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    args = Namespace(
+        workflow=str(source), context=None, context_file=None, input=[], input_file=str(inputs),
+        clean_processed=False, archive_processed=None, debug=False, stream_output=False,
+        dry_run=False, backup_state=False, state_dir=None, on_error="stop", max_retries=0,
+        retry_delay=0, quiet=True, verbose=False, log_level="error", step_summaries=False,
+        summary_mode=None, summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="reviewed_change::reviewed-change", source_root=[str(tmp_path)],
+        provider_externs_file=str(providers), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None, emit_debug_yaml=False,
+    )
+    argv = ["orchestrator", "run", str(source), "--source-root", str(tmp_path),
+            "--entry-workflow", "reviewed_change::reviewed-change",
+            "--provider-externs-file", str(providers)]
+    monkeypatch.chdir(tmp_path)
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute,
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(args)
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.32"])
+def test_exhaustion_selects_variant_without_path_field(tmp_path, monkeypatch, target) -> None:
+    result = _run(tmp_path, monkeypatch, target, [_REQUEST, _REQUEST])
+    assert result.exit_code == 0
+    assert dict(result.workflow_outputs) == {"return__variant": "UNRESOLVED", "return__rounds": 2}
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.32"])
+def test_done_keeps_path_field(tmp_path, monkeypatch, target) -> None:
+    approve = {"variant": "APPROVE", "report": _REPORT}
+    result = _run(tmp_path, monkeypatch, target, [_REQUEST, approve])
+    assert result.exit_code == 0
+    assert dict(result.workflow_outputs) == {
+        "return__variant": "READY", "return__report": _REPORT, "return__rounds": 2,
+    }
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.32"])
+def test_malformed_provider_path_still_fails(tmp_path, monkeypatch, target) -> None:
+    bad = {"variant": "APPROVE", "report": "../escape.md"}
+    result = _run(tmp_path, monkeypatch, target, [bad])
+    assert result.exit_code == 1

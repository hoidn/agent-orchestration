diff --git a/tests/test_workflow_lisp_loop_result_paths_e2e.py b/tests/test_workflow_lisp_loop_result_paths_e2e.py
new file mode 100644
index 0000000..fc96264
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths_e2e.py
@@ -0,0 +1,81 @@
+"""A loop result union with a path field in a non-exhausted variant behaves the
+same at every target from 2.28 through 2.32, including on exhaustion."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.test_workflow_lisp_strict_boolean_control_flow_e2e import (
+    _compile_and_bind,
+    _provider_patches,
+)
+
+SOURCE = """
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "{target}")
+  (defmodule loop_paths)
+  (export run)
+  (defpath Report :kind relpath :under "artifacts/review" :must-exist true)
+  (defunion Review
+    (APPROVE (report Report))
+    (RETRY (note String)))
+  (defunion Outcome
+    (READY (report Report) (rounds Int))
+    (UNRESOLVED (rounds Int)))
+  (defworkflow run () -> Outcome
+    (loop/recur :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (match (provider-result providers.reviewer :prompt prompts.review :inputs () :returns Review)
+          ((APPROVE a) (done (variant Outcome READY :report a.report :rounds state.round)))
+          ((RETRY r) (continue (loop-state :like state :round (+ state.round 1))))))))
+)
+"""
+
+
+def _run(tmp_path: Path, target: str, document: dict):
+    module = tmp_path / "loop_paths.orc"
+    module.write_text(SOURCE.format(target=target), encoding="utf-8")
+    (tmp_path / "artifacts/review").mkdir(parents=True)
+    (tmp_path / "review.md").write_text("Review.\n", encoding="utf-8")
+    (tmp_path / "artifacts/review/r.md").write_text("ok\n", encoding="utf-8")
+    bundle, sm = _compile_and_bind(
+        tmp_path, module, run_id="r", command_boundaries={},
+        provider_externs={"providers.reviewer": "fake"}, prompt_externs={"prompts.review": {"input_file": "review.md"}},
+    )
+    p1, p2 = _provider_patches(tmp_path, json.dumps(document), [])
+    with p1, p2:
+        return WorkflowExecutor(bundle, tmp_path, sm, retry_delay_ms=0).execute(on_error="stop")
+
+
+TARGETS = ["2.28", "2.29", "2.30", "2.31", "2.32"]
+
+
+def _outputs(state: dict) -> dict:
+    assert state["status"] == "completed", state.get("error")
+    return {k: v for k, v in state["workflow_outputs"].items() if k != "return__report"}
+
+
+@pytest.mark.parametrize("target", TARGETS)
+def test_exhaustion_matches_2_28(tmp_path: Path, target: str) -> None:
+    state = _run(tmp_path, target, {"variant": "RETRY", "note": "again"})
+    assert _outputs(state) == {"return__variant": "UNRESOLVED", "return__rounds": 2}
+
+
+@pytest.mark.parametrize("target", TARGETS)
+def test_done_path_matches(tmp_path: Path, target: str) -> None:
+    state = _run(tmp_path, target, {"variant": "APPROVE", "report": "artifacts/review/r.md"})
+    assert _outputs(state) == {"return__variant": "READY", "return__rounds": 1}
+    assert state["workflow_outputs"]["return__report"] == "artifacts/review/r.md"
+
+
+@pytest.mark.parametrize("target", TARGETS)
+def test_malformed_provider_path_still_fails(tmp_path: Path, target: str) -> None:
+    state = _run(tmp_path, target, {"variant": "APPROVE", "report": "artifacts/review/missing.md"})
+    assert state["status"] == "failed"

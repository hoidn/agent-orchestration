+    @staticmethod
+    def _resolve_exhaustion_override(
+        override: Any,
+        frame_artifacts: Mapping[str, Any],
+        step_name: str,
+        state: Mapping[str, Any],
+    ) -> Any:
+        """Dereference a compiler-emitted `{ref: root.steps.S.artifacts.N}` override.
+
+        Refs to the exhausted loop itself read its exhaustion frame; refs to an
+        earlier step read that step's persisted artifacts. Anything else is kept
+        as authored.
+        """
+        ref = override.get("ref") if isinstance(override, Mapping) and set(override) == {"ref"} else None
+        if not isinstance(ref, str):
+            return override
+        prefix = "root.steps."
+        head, sep, member = ref.rpartition(".artifacts.")
+        if not (sep and head.startswith(prefix)):
+            return override
+        target = head[len(prefix):]
+        if target == step_name:
+            artifacts = frame_artifacts
+        else:
+            result = state.get("steps", {}).get(target)
+            artifacts = result.get("artifacts") if isinstance(result, Mapping) else None
+        if isinstance(artifacts, Mapping) and member in artifacts:
+            return artifacts[member]
+        return override
+

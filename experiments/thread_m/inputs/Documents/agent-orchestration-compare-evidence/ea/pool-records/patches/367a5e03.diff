diff --git a/tests/test_workflow_lisp_loop_result_union_paths.py b/tests/test_workflow_lisp_loop_result_union_paths.py
new file mode 100644
index 0000000..9913d12
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_union_paths.py
@@ -0,0 +1,120 @@
+"""Loop results that are unions with path fields in non-exhausted variants."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_BUG = Path(__file__).resolve().parents[1] / "bugs" / "loop_result_paths"
+
+
+def _source(target: str) -> str:
+    text = (_BUG / "reviewed_change.orc").read_text(encoding="utf-8")
+    return text.replace('(:target-dsl "2.32")', f'(:target-dsl "{target}")')
+
+
+def _run(tmp_path: Path, monkeypatch, target: str, reviews: list[dict]):
+    src = tmp_path / "reviewed_change.orc"
+    src.write_text(_source(target), encoding="utf-8")
+    providers = tmp_path / "providers.json"
+    providers.write_text(
+        json.dumps({"providers.coder": "codex", "providers.reviewer": "claude"}),
+        encoding="utf-8",
+    )
+    inputs = tmp_path / "inputs.json"
+    inputs.write_text(json.dumps({"task": "t"}), encoding="utf-8")
+    pending = list(reviews)
+
+    def prepare(_self, provider_name, *_a, **kw):
+        prompt = str(kw.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kw.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kw.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        out = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not out.is_absolute():
+            out = Path.cwd() / out
+        out.parent.mkdir(parents=True, exist_ok=True)
+        if invocation.provider_name == "claude":
+            review = pending.pop(0)
+            report = review.get("report")
+            if report and review.pop("write", True):
+                (tmp_path / report).parent.mkdir(parents=True, exist_ok=True)
+                (tmp_path / report).write_text("r\n", encoding="utf-8")
+            payload = review
+        else:
+            payload = {"summary": "s"}
+        out.write_text(json.dumps(payload) + "\n", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False,
+            raw_stdout=None, normalized_stdout=None, provider_session=None,
+        )
+
+    args = Namespace(
+        workflow=str(src), context=None, context_file=None, input=[], input_file=str(inputs),
+        clean_processed=False, archive_processed=None, debug=False, stream_output=False,
+        dry_run=False, backup_state=False, state_dir=None, on_error="stop", max_retries=0,
+        retry_delay=0, quiet=True, verbose=False, log_level="error", step_summaries=False,
+        summary_mode=None, summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="reviewed_change::reviewed-change", source_root=[str(tmp_path)],
+        provider_externs_file=str(providers), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None,
+        emit_debug_yaml=False,
+    )
+    monkeypatch.chdir(tmp_path)
+    argv = ["orchestrator", "run", str(src), "--entry-workflow", args.entry_workflow,
+            "--source-root", str(tmp_path), "--provider-externs-file", str(providers)]
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(args)
+
+
+APPROVE = {"variant": "APPROVE", "report": "artifacts/review/r.md"}
+CHANGES = {
+    "variant": "REQUEST_CHANGES",
+    "report": "artifacts/review/r.md",
+    "findings": ["f"],
+}
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.32"])
+def test_exhaustion_returns_inactive_path_variant_outcome(tmp_path, monkeypatch, target):
+    result = _run(tmp_path, monkeypatch, target, [dict(CHANGES) for _ in range(3)])
+    assert result.exit_code == 0
+    assert result.workflow_outputs == {"return__variant": "UNRESOLVED", "return__rounds": 3}
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.32"])
+def test_done_path_returns_report(tmp_path, monkeypatch, target):
+    result = _run(tmp_path, monkeypatch, target, [dict(APPROVE)])
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "READY"
+    assert result.workflow_outputs["return__report"] == "artifacts/review/r.md"
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.32"])
+def test_malformed_provider_path_still_fails(tmp_path, monkeypatch, target):
+    bad = {"variant": "APPROVE", "report": "artifacts/review/missing.md", "write": False}
+    result = _run(tmp_path, monkeypatch, target, [bad])
+    assert result.exit_code == 1

+def _exhausted_variant_placeholder_ref(
+    on_exhausted: Any,
+    exhausted_placeholder_refs: Mapping[str, str],
+    *,
+    variant_name: str,
+    field_name: str,
+) -> str | None:
+    """Read inactive-variant fields of the exhausted variant's case from the placeholder step.
+
+    Exhaustion overrides carry them as unresolved ``{"ref": ...}`` loop artifacts.
+    """

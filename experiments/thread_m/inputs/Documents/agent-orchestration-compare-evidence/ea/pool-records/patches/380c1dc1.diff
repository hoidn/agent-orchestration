diff --git a/tests/test_workflow_lisp_loop_recur.py b/tests/test_workflow_lisp_loop_recur.py
index 618764b..3ef83ee 100644
--- a/tests/test_workflow_lisp_loop_recur.py
+++ b/tests/test_workflow_lisp_loop_recur.py
@@ -1810,3 +1810,82 @@ def test_loop_recur_exhaustion_projection_relaxes_variant_relpath_at_result_boun
         "ref": "root.steps.loop-recur-exhaustion-missing-projection__loop.artifacts.result__last_report"
     }
     assert authored["outputs"]["return__last_report"]["must_exist_target"] is False
+
+
+_PATH_VARIANT_LOOP_SOURCE = "\n".join(
+    [
+        "(workflow-lisp",
+        '  (:language "0.1")',
+        '  (:target-dsl "{target}")',
+        "  (defpath Report",
+        "    :kind relpath",
+        '    :under "artifacts/review"',
+        "    :must-exist false)",
+        "  (defrecord LoopState (round Int))",
+        "  (defunion Outcome",
+        "    (READY (report Report) (rounds Int))",
+        "    (UNRESOLVED (rounds Int)))",
+        "  (defworkflow path-variant-loop",
+        "    ((report_path Report))",
+        "    -> Outcome",
+        "    (loop/recur",
+        "      :max 2",
+        "      :state (record LoopState :round 0)",
+        "      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)",
+        "      (fn (state)",
+        "        (if (= state.round 99)",
+        "          (done (variant Outcome READY :report report_path :rounds state.round))",
+        "          (continue (record LoopState :round (+ state.round 1))))))))",
+    ]
+)
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.30", "2.31", "2.32"])
+def test_loop_result_path_in_non_exhausted_variant_compiles_and_exhausts(
+    tmp_path: Path, target: str
+) -> None:
+    workflow_path = _write_module(
+        tmp_path / "path_variant_loop.orc",
+        _PATH_VARIANT_LOOP_SOURCE.replace("{target}", target),
+    )
+    result = _compile(workflow_path, tmp_path=tmp_path, validate_shared=True)
+    bundle = result.validated_bundles["path-variant-loop"]
+    state_manager = StateManager(workspace=tmp_path, run_id=f"path-variant-loop-{target}")
+    state_manager.initialize(workflow_path.as_posix())
+
+    state = WorkflowExecutor(bundle, tmp_path, state_manager, retry_delay_ms=0).execute(
+        {"report_path": "artifacts/review/r.md"}, on_error="stop"
+    )
+
+    assert state["status"] == "completed", json.dumps({k: v for k, v in state["steps"].items() if "__result" in k} | {"error": state.get("error")}, default=str)
+    assert state["workflow_outputs"]["return__variant"] == "UNRESOLVED"
+    assert state["workflow_outputs"]["return__rounds"] == 1
+
+
+def test_hand_authored_relpath_on_exhausted_override_stays_rejected(tmp_path: Path) -> None:
+    workflow_path = _write_module(
+        tmp_path / "path_variant_loop.orc",
+        _PATH_VARIANT_LOOP_SOURCE.replace("{target}", "2.29"),
+    )
+    result = _compile(workflow_path, tmp_path=tmp_path, validate_shared=True)
+    mapping = json.loads(json.dumps(result.lowered_workflows[0].authored_mapping))
+    repeat = next(s["repeat_until"] for s in mapping["steps"] if "repeat_until" in s)
+    repeat["on_exhausted"]["outputs"]["result__report"] = "artifacts/review/x.md"
+    lowered = replace(
+        result.lowered_workflows[0],
+        authored_mapping=mapping,
+        compiler_owned_repeat_until_metadata=(
+            lowering_core._capture_compiler_owned_repeat_until_metadata(mapping)
+        ),
+    )
+
+    with pytest.raises(LispFrontendCompileError) as exc:
+        lowering_core._validate_one_lowered_workflow(
+            lowered,
+            workspace_root=tmp_path,
+            imported_bundles={},
+            workflow_is_imported=False,
+            boundary_validation_policy=WorkflowBoundaryValidationPolicy.PUBLIC_CALLABLE,
+        )
+
+    assert "may only override scalar repeat_until outputs" in exc.value.diagnostics[0].message

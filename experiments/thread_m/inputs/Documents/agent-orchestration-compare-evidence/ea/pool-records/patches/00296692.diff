diff --git a/tests/fixtures/workflow_lisp/valid/loop_recur_on_exhausted_union_path_variant.orc b/tests/fixtures/workflow_lisp/valid/loop_recur_on_exhausted_union_path_variant.orc
new file mode 100644
index 0000000..6c3619b
--- /dev/null
+++ b/tests/fixtures/workflow_lisp/valid/loop_recur_on_exhausted_union_path_variant.orc
@@ -0,0 +1,21 @@
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.32")
+  (defpath Report
+    :kind relpath
+    :under "artifacts/review"
+    :must-exist true)
+  (defunion Outcome
+    (READY (report Report) (rounds Int))
+    (UNRESOLVED (rounds Int)))
+  (defworkflow loop-recur-on-exhausted-union-path-variant
+    ((report_path Report))
+    -> Outcome
+    (loop/recur
+      :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (if (= state.round 99)
+            (done (variant Outcome READY :report report_path :rounds state.round))
+            (continue (loop-state :like state :round (+ state.round 1))))))))

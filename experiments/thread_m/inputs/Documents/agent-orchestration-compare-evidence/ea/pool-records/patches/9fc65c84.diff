+        state: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        """Replace compiler-emitted {"ref"} exhaustion overrides with their values (2.29+).
+
+        Downstream consumers (structured match outputs) read loop artifacts as
+        plain values, so a ref left in place would fail output validation.
+        """
+        if not self.executor._workflow_version_at_least("2.29"):
+            return artifacts
+        frame_prefix = f"root.steps.{step_name}.artifacts."
+        resolved = dict(artifacts)
+        for name, value in artifacts.items():
+            if not (isinstance(value, Mapping) and set(value) == {"ref"} and isinstance(value["ref"], str)):
+                continue
+            ref = value["ref"]
+            if ref.startswith(frame_prefix) and ref[len(frame_prefix):] in frame_artifacts:
+                resolved[name] = frame_artifacts[ref[len(frame_prefix):]]
+                continue
+            resolved_value, error = self.executor._resolve_ref_value(ref, state)
+            if error is not None:
+                raise LoopStateIntegrityError(
+                    f"repeat_until exhaustion output '{name}' ref '{ref}' is unresolved"
+                )
+            resolved[name] = resolved_value
+        return resolved
+

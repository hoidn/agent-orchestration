+        step_name: str,
+        frame_artifacts: Mapping[str, Any],
+        state: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        """Replace compiler-emitted ref overrides with their values (target 2.29+).
+
+        Union result joins read loop-frame artifacts without following refs, so
+        an exhaustion override must be a value by the time it is persisted.
+        """
+        if not self.executor._workflow_version_at_least("2.29"):
+            return artifacts
+        own_prefix = f"root.steps.{step_name}.artifacts."
+        resolved = dict(artifacts)
+        for name, value in artifacts.items():
+            if not (isinstance(value, dict) and set(value) == {"ref"} and isinstance(value["ref"], str)):
+                continue
+            ref = value["ref"]
+            if ref.startswith(own_prefix) and ref[len(own_prefix):] in frame_artifacts:
+                resolved[name] = frame_artifacts[ref[len(own_prefix):]]
+                continue
+            target, error = self.executor._resolve_ref_value(ref, state)
+            if error is not None:
+                raise LoopStateIntegrityError(
+                    f"repeat_until exhaustion override '{name}' could not resolve '{ref}'"
+                )
+            resolved[name] = target
+        return resolved
+

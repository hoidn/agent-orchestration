diff --git a/tests/test_workflow_lisp_loop_result_inactive_path_variants.py b/tests/test_workflow_lisp_loop_result_inactive_path_variants.py
new file mode 100644
index 0000000..2d5cf0a
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_inactive_path_variants.py
@@ -0,0 +1,144 @@
+"""loop/recur results with path fields in non-exhausted variants behave alike at 2.28 and 2.29+."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_SOURCE = """
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "@@VERSION@@")
+  (defmodule loop_paths)
+  (export run)
+  (defpath Report :kind relpath :under "artifacts/review" :must-exist true)
+  (defrecord Change (summary String))
+  (defunion Review
+    (APPROVE (report Report))
+    (REQUEST_CHANGES (note String))
+    (NEEDS_HUMAN (question String)))
+  (defunion Outcome
+    (READY (report Report) (rounds Int))
+    (ESCALATED (question String))
+    (UNRESOLVED (rounds Int)))
+  (defprompt review-prompt (:fills (task :text)) -> Review "Review {task}")
+  (defprompt fix-prompt (:fills (task :text)) -> Change "Fix {task}")
+  (defworkflow run ((task String)) -> Outcome
+    (loop/recur :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (let* ((review (provider-result providers.reviewer :prompt (review-prompt :task task))))
+          (match review
+            ((APPROVE a) (done (variant Outcome READY :report a.report :rounds state.round)))
+            ((REQUEST_CHANGES r)
+             (let* ((fix (provider-result providers.coder :prompt (fix-prompt :task task))))
+               (continue (loop-state :like state :round (+ state.round 1)))))
+            ((NEEDS_HUMAN h) (done (variant Outcome ESCALATED :question h.question))))))))
+)
+"""
+
+_REVIEWS = {
+    "exhaust": [{"variant": "REQUEST_CHANGES", "note": "n"}] * 2,
+    "approve": [
+        {"variant": "REQUEST_CHANGES", "note": "n"},
+        {"variant": "APPROVE", "report": "artifacts/review/r.md"},
+    ],
+    "escalate": [{"variant": "NEEDS_HUMAN", "question": "q?"}],
+}
+
+
+def _run(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, version: str, scenario: str):
+    source = tmp_path / "loop_paths.orc"
+    source.write_text(_SOURCE.replace("@@VERSION@@", version), encoding="utf-8")
+    providers = tmp_path / "providers.json"
+    providers.write_text(
+        json.dumps({"providers.coder": "coder", "providers.reviewer": "reviewer"}),
+        encoding="utf-8",
+    )
+    inputs = tmp_path / "inputs.json"
+    inputs.write_text(json.dumps({"task": "t"}), encoding="utf-8")
+    (tmp_path / "artifacts" / "review").mkdir(parents=True)
+    (tmp_path / "artifacts" / "review" / "r.md").write_text("ok\n", encoding="utf-8")
+    reviews = iter(_REVIEWS[scenario])
+
+    def prepare(_self, provider_name, *_args, **kwargs):
+        prompt = str(kwargs.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kwargs.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kwargs.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kwargs):
+        payload = (
+            next(reviews)
+            if invocation.provider_name == "reviewer"
+            else {"summary": "s"}
+        )
+        output = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not output.is_absolute():
+            output = Path.cwd() / output
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(json.dumps(payload) + "\n", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    args = Namespace(
+        workflow=str(source), context=None, context_file=None, input=[], input_file=str(inputs),
+        clean_processed=False, archive_processed=None, debug=False, stream_output=False,
+        dry_run=False, backup_state=False, state_dir=None, on_error="stop", max_retries=0,
+        retry_delay=0, quiet=True, verbose=False, log_level="error", step_summaries=False,
+        summary_mode=None, summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="run", source_root=[str(tmp_path)],
+        provider_externs_file=str(providers), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None, emit_debug_yaml=False,
+    )
+    argv = ["orchestrator", "run", str(source), "--source-root", str(tmp_path),
+            "--entry-workflow", "run", "--provider-externs-file", str(providers)]
+    monkeypatch.chdir(tmp_path)
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute,
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(args)
+
+
+@pytest.mark.parametrize("scenario", sorted(_REVIEWS))
+@pytest.mark.parametrize("version", ["2.29", "2.30", "2.31", "2.32"])
+def test_result_matches_target_228(tmp_path, monkeypatch, version, scenario):
+    (tmp_path / "base").mkdir()
+    (tmp_path / "new").mkdir()
+    base = _run(tmp_path / "base", monkeypatch, "2.28", scenario)
+    new = _run(tmp_path / "new", monkeypatch, version, scenario)
+    assert base.exit_code == 0
+    assert new.exit_code == 0
+    assert new.workflow_outputs == base.workflow_outputs
+
+
+@pytest.mark.parametrize("version", ["2.28", "2.32"])
+def test_malformed_provider_report_still_fails_run(tmp_path, monkeypatch, version):
+    _REVIEWS["bad"] = [{"variant": "APPROVE", "report": "../escape.md"}]
+    try:
+        result = _run(tmp_path, monkeypatch, version, "bad")
+    finally:
+        del _REVIEWS["bad"]
+    assert result.exit_code != 0

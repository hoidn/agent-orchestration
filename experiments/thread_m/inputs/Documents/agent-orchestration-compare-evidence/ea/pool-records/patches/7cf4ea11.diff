diff --git a/tests/test_workflow_lisp_loop_result_paths.py b/tests/test_workflow_lisp_loop_result_paths.py
new file mode 100644
index 0000000..61b45ae
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths.py
@@ -0,0 +1,131 @@
+"""A loop result union with path fields in non-exhausted variants at targets 2.28-2.32."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_SOURCE = """\
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "{target}")
+  (defmodule loop_paths)
+  (export run)
+  (defpath Report :kind relpath :under "artifacts/review" :must-exist true)
+  (defunion Review
+    (APPROVE (report Report))
+    (RETRY (note String))
+    (HUMAN (question String)))
+  (defunion Outcome
+    (READY (report Report) (rounds Int))
+    (ESCALATED (question String))
+    (UNRESOLVED (rounds Int)))
+  (defprompt review-prompt (:fills (task :text)) -> Review "Review {task}")
+  (defworkflow run ((task String)) -> Outcome
+    (loop/recur :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (let* ((review (provider-result providers.reviewer
+                         :prompt (review-prompt :task task))))
+          (match review
+            ((APPROVE a)
+             (done (variant Outcome READY :report a.report :rounds state.round)))
+            ((RETRY r)
+             (continue (loop-state :like state :round (+ state.round 1))))
+            ((HUMAN h)
+             (done (variant Outcome ESCALATED :question h.question)))))))))
+"""
+
+_TARGETS = ["2.28", "2.29", "2.30", "2.31", "2.32"]
+
+
+def _run(tmp_path: Path, monkeypatch, target: str, reviews: list[dict]):
+    src = tmp_path / "loop_paths.orc"
+    src.write_text(_SOURCE.replace("{target}", target), encoding="utf-8")
+    providers = tmp_path / "providers.json"
+    providers.write_text(json.dumps({"providers.reviewer": "reviewer"}), encoding="utf-8")
+    inputs = tmp_path / "inputs.json"
+    inputs.write_text(json.dumps({"task": "t"}), encoding="utf-8")
+    (tmp_path / "artifacts" / "review").mkdir(parents=True)
+    (tmp_path / "artifacts" / "review" / "r.md").write_text("ok\n", encoding="utf-8")
+    queue = list(reviews)
+
+    def prepare(_self, provider_name, *_a, **kw):
+        prompt = str(kw.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kw.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kw.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        output = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not output.is_absolute():
+            output = Path.cwd() / output
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(json.dumps(queue.pop(0)) + "\n", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    args = Namespace(
+        workflow=str(src), context=None, context_file=None, input=[], input_file=str(inputs),
+        clean_processed=False, archive_processed=None, debug=False, stream_output=False,
+        dry_run=False, backup_state=False, state_dir=None, on_error="stop", max_retries=0,
+        retry_delay=0, quiet=True, verbose=False, log_level="error", step_summaries=False,
+        summary_mode=None, summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="run", source_root=[str(tmp_path)],
+        provider_externs_file=str(providers), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None, emit_debug_yaml=True,
+    )
+    monkeypatch.chdir(tmp_path)
+    argv = ["orchestrator", "run", str(src), "--entry-workflow", "run",
+            "--provider-externs-file", str(providers)]
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(args)
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_exhaustion_yields_unresolved(tmp_path, monkeypatch, target):
+    retry = {"variant": "RETRY", "note": "x"}
+    result = _run(tmp_path, monkeypatch, target, [retry, retry])
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "UNRESOLVED"
+    assert result.workflow_outputs["return__rounds"] == 2
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_done_with_path_variant_keeps_report(tmp_path, monkeypatch, target):
+    approve = {"variant": "APPROVE", "report": "artifacts/review/r.md"}
+    result = _run(tmp_path, monkeypatch, target, [approve])
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "READY"
+    assert result.workflow_outputs["return__report"] == "artifacts/review/r.md"
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_malformed_provider_output_still_fails(tmp_path, monkeypatch, target):
+    bad = {"variant": "APPROVE", "report": "artifacts/review/missing.md"}
+    result = _run(tmp_path, monkeypatch, target, [bad])
+    assert result.exit_code != 0

+    def _resolve_exhaustion_override_refs(
+        self,
+        step_name: str,
+        frame_artifacts: Mapping[str, Any],
+        artifacts: Mapping[str, Any],
+        state: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        """Replace compiler-emitted `{ref}` overrides with the values they name.
+
+        Refs into this loop's own frame resolve against the exhaustion snapshot
+        (the frame is not yet in `state`); all others resolve against `state`.
+        """
+        own_prefix = f"root.steps.{step_name}.artifacts."
+        resolved = dict(artifacts)
+        for name, value in artifacts.items():
+            if not (isinstance(value, Mapping) and set(value) == {"ref"} and isinstance(value["ref"], str)):
+                continue
+            ref = value["ref"]
+            if ref.startswith(own_prefix) and ref[len(own_prefix):] in frame_artifacts:
+                resolved[name] = frame_artifacts[ref[len(own_prefix):]]
+                continue
+            resolved_value, error = self.executor._resolve_ref_value(ref, state)
+            if error is not None:
+                raise LoopStateIntegrityError(
+                    f"repeat_until on_exhausted output '{name}' ref '{ref}' did not resolve"
+                )
+            resolved[name] = resolved_value
+        return resolved
+

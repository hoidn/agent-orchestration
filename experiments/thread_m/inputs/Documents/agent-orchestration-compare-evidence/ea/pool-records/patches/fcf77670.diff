diff --git a/tests/test_workflow_lisp_loop_result_paths.py b/tests/test_workflow_lisp_loop_result_paths.py
new file mode 100644
index 0000000..ba3b21f
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths.py
@@ -0,0 +1,122 @@
+"""loop/recur union results with path fields in non-exhausted variants (targets 2.29+)."""
+
+from __future__ import annotations
+
+import json
+import shutil
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_BUG = Path(__file__).resolve().parent.parent / "bugs" / "loop_result_paths"
+
+
+def _args(source: Path, workspace: Path) -> Namespace:
+    return Namespace(
+        workflow=str(source), context=None, context_file=None, input=[],
+        input_file=str(workspace / "inputs.json"),
+        clean_processed=False, archive_processed=None, debug=False, stream_output=False,
+        dry_run=False, backup_state=False, state_dir=None, on_error="stop", max_retries=0,
+        retry_delay=0, quiet=True, verbose=False, log_level="error", step_summaries=False,
+        summary_mode=None, summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="reviewed_change::reviewed-change", source_root=[str(workspace)],
+        provider_externs_file=str(workspace / "providers.json"), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None, emit_debug_yaml=False,
+    )
+
+
+def _run(tmp_path: Path, monkeypatch, reviews: list[dict], target: str = "2.32"):
+    for name in ("reviewed_change.orc", "providers.json", "inputs.json"):
+        shutil.copy(_BUG / name, tmp_path / name)
+    source = tmp_path / "reviewed_change.orc"
+    source.write_text(
+        source.read_text().replace('(:target-dsl "2.32")', f'(:target-dsl "{target}")'),
+        encoding="utf-8",
+    )
+    queue = list(reviews)
+    seen: list[str] = []
+
+    def prepare(_self, provider_name, *_a, **kwargs):
+        prompt = str(kwargs.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kwargs.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kwargs.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        seen.append(invocation.provider_name)
+        output = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not output.is_absolute():
+            output = Path.cwd() / output
+        output.parent.mkdir(parents=True, exist_ok=True)
+        if invocation.provider_name == "claude":
+            review = queue.pop(0)
+            report = review.get("report")
+            if report and review.pop("write", True):
+                (tmp_path / report).parent.mkdir(parents=True, exist_ok=True)
+                (tmp_path / report).write_text("ok\n", encoding="utf-8")
+            payload = review
+        else:
+            payload = {"summary": "done"}
+        output.write_text(json.dumps(payload) + "\n", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    monkeypatch.chdir(tmp_path)
+    argv = ["orchestrator", "run", str(source), "--source-root", str(tmp_path)]
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute,
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(_args(source, tmp_path)), seen
+
+
+_REQUEST = {"variant": "REQUEST_CHANGES", "report": "artifacts/review/r.md", "findings": ["x"]}
+_TARGETS = ["2.28", "2.29", "2.32"]
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_exhausted_loop_matches_across_targets(tmp_path, monkeypatch, target):
+    result, _ = _run(tmp_path, monkeypatch, [dict(_REQUEST) for _ in range(3)], target)
+
+    assert (result.exit_code, dict(result.workflow_outputs)) == (
+        0,
+        {"return__variant": "UNRESOLVED", "return__rounds": 3},
+    )
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_done_arm_with_report_path_matches_across_targets(tmp_path, monkeypatch, target):
+    approve = {"variant": "APPROVE", "report": "artifacts/review/a.md"}
+    result, _ = _run(tmp_path, monkeypatch, [dict(_REQUEST), approve], target)
+
+    assert dict(result.workflow_outputs) == {
+        "return__variant": "READY",
+        "return__report": "artifacts/review/a.md",
+        "return__rounds": 2,
+    }
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_malformed_provider_report_still_fails_run(tmp_path, monkeypatch, target):
+    approve = {"variant": "APPROVE", "report": "artifacts/review/missing.md", "write": False}
+    result, _ = _run(tmp_path, monkeypatch, [approve], target)
+
+    assert result.exit_code != 0

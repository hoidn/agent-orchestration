@@ -1810,3 +1813,69 @@ def test_loop_recur_exhaustion_projection_relaxes_variant_relpath_at_result_boun
         "ref": "root.steps.loop-recur-exhaustion-missing-projection__loop.artifacts.result__last_report"
     }
     assert authored["outputs"]["return__last_report"]["must_exist_target"] is False
+
+
+@pytest.mark.parametrize("target_dsl", ["2.28", "2.29", "2.30", "2.31", "2.32"])
+@pytest.mark.parametrize("finish", [True, False])
+def test_loop_recur_inactive_result_path_preserves_done_and_exhaustion(
+    tmp_path: Path, target_dsl: str, finish: bool
+) -> None:
+    workflow_path = _write_module(
+        tmp_path / "inactive_result_path.orc",
+        "\n".join(
+            [
+                "(workflow-lisp",
+                '  (:language "0.1")',
+                f'  (:target-dsl "{target_dsl}")',
+                "  (defpath Receipt :kind relpath :under \"artifacts/review\" :must-exist true)",
+                "  (defunion Decision",
+                "    (ACCEPT (receipt Receipt))",
+                "    (EXHAUSTED (attempts Int)))",
+                "  (defworkflow decide ((receipt Receipt) (finish Bool)) -> Decision",
+                "    (loop/recur :max 1 :state (loop-state (round Int 0))",
+                "      :on-exhausted (variant Decision EXHAUSTED :attempts state.round)",
+                "      (fn (state)",
+                "        (if finish",
+                "          (done (variant Decision ACCEPT :receipt receipt))",
+                "          (continue (loop-state :like state :round (+ state.round 1))))))))",
+            ]
+        ),
+    )
+    report = tmp_path / "artifacts/review/receipt.json"
+    report.parent.mkdir(parents=True)
+    report.write_text("{}", encoding="utf-8")
+    result = _compile(workflow_path, tmp_path=tmp_path, validate_shared=True)
+    bundle = result.validated_bundles["decide"]
+    repeat = next(step for step in result.lowered_workflows[0].authored_mapping["steps"] if "repeat_until" in step)
+    assert "result__receipt" not in repeat["repeat_until"]["on_exhausted"]["outputs"]
+
+    contracts = {
+        name: contract
+        for name, contract in workflow_runtime_input_contracts(bundle).items()
+        if not name.startswith("__write_root__")
+    }
+    manager = StateManager(workspace=tmp_path, run_id=f"decision-{target_dsl}-{finish}")
+    manager.initialize(
+        workflow_path.as_posix(),
+        context=bundle_context_dict(bundle),
+        bound_inputs=bind_workflow_inputs(
+            contracts, {"receipt": "artifacts/review/receipt.json", "finish": finish}, tmp_path
+        ),
+    )
+    state = WorkflowExecutor(bundle, tmp_path, manager, retry_delay_ms=0).execute(on_error="stop")
+    assert state["status"] == "completed", state.get("error")
+    if finish:
+        assert state["workflow_outputs"] == {
+            "return__variant": "ACCEPT",
+            "return__receipt": "artifacts/review/receipt.json",
+        }
+    else:
+        assert state["workflow_outputs"] == {
+            "return__variant": "EXHAUSTED",
+            "return__attempts": 1,
+        }
+        loop_value = state["steps"]["decide__loop"]["artifacts"]["result__attempts"]
+        if target_dsl == "2.28":
+            assert loop_value == {"ref": "root.steps.decide__loop.artifacts.state__round"}
+        else:
+            assert loop_value == 1

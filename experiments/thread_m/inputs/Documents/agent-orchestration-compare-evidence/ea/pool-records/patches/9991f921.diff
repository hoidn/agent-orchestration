+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.30", "2.31", "2.32"])
+@pytest.mark.parametrize(
+    ("terminal", "expected"),
+    [
+        (
+            "(done (variant Outcome READY :report report_path))",
+            {"return__variant": "READY", "return__report": "artifacts/review/report.md"},
+        ),
+        (
+            '(done (variant Outcome ESCALATED :question "ask"))',
+            {"return__variant": "ESCALATED", "return__question": "ask"},
+        ),
+        (
+            "(if (< state.round 0) (done (variant Outcome READY :report report_path)) (continue state))",
+            {"return__variant": "UNRESOLVED", "return__rounds": 1},
+        ),
+    ],
+)
+def test_loop_union_result_inactive_path_matches_target_228(
+    tmp_path: Path, target: str, terminal: str, expected: dict[str, object]
+) -> None:
+    source = _write_module(
+        tmp_path / "inactive_path.orc",
+        f'''(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "{target}")
+  (defpath ReviewReport :kind relpath :under "artifacts/review" :must-exist true)
+  (defunion Outcome
+    (READY (report ReviewReport))
+    (ESCALATED (question String))
+    (UNRESOLVED (rounds Int)))
+  (defworkflow choose ((report_path ReviewReport)) -> Outcome
+    (loop/recur :max 1 :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state) {terminal}))))
+''',
+    )
+    report = tmp_path / "artifacts/review/report.md"
+    report.parent.mkdir(parents=True)
+    report.write_text("review", encoding="utf-8")
+    result = _compile(source, tmp_path=tmp_path, validate_shared=True)
+    bundle = result.validated_bundles["choose"]
+    contracts = {
+        name: contract
+        for name, contract in workflow_runtime_input_contracts(bundle).items()
+        if not name.startswith("__write_root__")
+    }
+    bound_inputs = bind_workflow_inputs(
+        contracts, {"report_path": "artifacts/review/report.md"}, tmp_path
+    )
+    manager = StateManager(
+        workspace=tmp_path, run_id=f"inactive-path-{target}-{expected['return__variant']}"
+    )
+    manager.initialize(
+        source.as_posix(), context=bundle_context_dict(bundle), bound_inputs=bound_inputs
+    )
+    state = WorkflowExecutor(bundle, tmp_path, manager, retry_delay_ms=0).execute(on_error="stop")
+
+    assert state["status"] == "completed", (
+        state.get("error"),
+        {name: (step.get("status"), step.get("error")) for name, step in state["steps"].items()},
+    )
+    assert state["workflow_outputs"] == expected
+
+
 def test_lowering_loop_recur_supports_union_return_fixture(tmp_path: Path) -> None:

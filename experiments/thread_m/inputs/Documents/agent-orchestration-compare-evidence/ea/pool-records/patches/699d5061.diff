diff --git a/tests/test_workflow_lisp_loop_result_paths_e2e.py b/tests/test_workflow_lisp_loop_result_paths_e2e.py
new file mode 100644
index 0000000..c052fe4
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths_e2e.py
@@ -0,0 +1,115 @@
+"""A loop result union with path fields in non-exhausted variants runs at 2.28 and 2.29+."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_SOURCE = (
+    Path(__file__).resolve().parents[1] / "bugs" / "loop_result_paths" / "reviewed_change.orc"
+)
+_ENTRY = "reviewed_change::reviewed-change"
+
+
+def _setup(tmp_path: Path, target: str) -> Path:
+    source = tmp_path / "reviewed_change.orc"
+    source.write_text(
+        _SOURCE.read_text(encoding="utf-8").replace('(:target-dsl "2.32")', f'(:target-dsl "{target}")'),
+        encoding="utf-8",
+    )
+    (tmp_path / "providers.json").write_text(
+        json.dumps({"providers.coder": "coder", "providers.reviewer": "reviewer"}),
+        encoding="utf-8",
+    )
+    (tmp_path / "inputs.json").write_text(json.dumps({"task": "t"}), encoding="utf-8")
+    return source
+
+
+def _run(tmp_path: Path, source: Path, reviews: list[dict], monkeypatch) -> object:
+    queue = list(reviews)
+
+    def prepare(_self, provider_name, *_a, **kwargs):
+        prompt = str(kwargs.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kwargs.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kwargs.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        output = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not output.is_absolute():
+            output = Path.cwd() / output
+        output.parent.mkdir(parents=True, exist_ok=True)
+        payload = queue.pop(0) if invocation.provider_name == "reviewer" else {"summary": "s"}
+        output.write_text(json.dumps(payload), encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    report = tmp_path / "artifacts" / "review" / "r.md"
+    report.parent.mkdir(parents=True)
+    report.write_text("ok\n", encoding="utf-8")
+    args = Namespace(
+        workflow=str(source), context=None, context_file=None, input=[],
+        input_file=str(tmp_path / "inputs.json"), clean_processed=False, archive_processed=None,
+        debug=False, stream_output=False, dry_run=False, backup_state=False, state_dir=None,
+        on_error="stop", max_retries=0, retry_delay=0, quiet=True, verbose=False,
+        log_level="error", step_summaries=False, summary_mode=None,
+        summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow=_ENTRY, source_root=[str(tmp_path)],
+        provider_externs_file=str(tmp_path / "providers.json"), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None,
+        emit_debug_yaml=False,
+    )
+    monkeypatch.chdir(tmp_path)
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute,
+    ), patch.object(sys, "argv", ["orchestrator", "run", str(source)]):
+        return run_workflow(args)
+
+
+_REQUEST = {"variant": "REQUEST_CHANGES", "report": "artifacts/review/r.md", "findings": ["f"]}
+_APPROVE = {"variant": "APPROVE", "report": "artifacts/review/r.md"}
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.32"])
+def test_exhaustion_publishes_unresolved_without_path_field(tmp_path, monkeypatch, target) -> None:
+    result = _run(tmp_path, _setup(tmp_path, target), [_REQUEST] * 3, monkeypatch)
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "UNRESOLVED"
+    assert result.workflow_outputs["return__rounds"] == 3
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.32"])
+def test_approval_publishes_report_path(tmp_path, monkeypatch, target) -> None:
+    result = _run(tmp_path, _setup(tmp_path, target), [_REQUEST, _APPROVE], monkeypatch)
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "READY"
+    assert result.workflow_outputs["return__report"] == "artifacts/review/r.md"
+    assert result.workflow_outputs["return__rounds"] == 2
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.32"])
+def test_malformed_provider_path_still_fails(tmp_path, monkeypatch, target) -> None:
+    bad = {"variant": "APPROVE", "report": "artifacts/review/missing.md"}
+    result = _run(tmp_path, _setup(tmp_path, target), [bad], monkeypatch)
+    assert result.exit_code != 0

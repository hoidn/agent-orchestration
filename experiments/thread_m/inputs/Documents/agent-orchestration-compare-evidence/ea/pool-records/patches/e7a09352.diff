index 0000000..cbf0b21
--- /dev/null
+++ b/tests/test_workflow_lisp_loop_result_paths.py
@@ -0,0 +1,164 @@
+"""loop/recur union results with path fields in non-exhausted variants (targets 2.28..2.32)."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+from orchestrator.workflow_lisp.build import FrontendBuildRequest, build_frontend_bundle
+
+_SOURCE = """\
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "TARGET")
+  (defmodule reviewed_change)
+  (export run)
+  (defpath ReviewReport :kind relpath :under "artifacts/review" :must-exist true)
+  (defrecord Change (summary String))
+  (defunion Review
+    (APPROVE (report ReviewReport))
+    (REQUEST_CHANGES (report ReviewReport) (findings List[String]))
+    (NEEDS_HUMAN (question String)))
+  (defunion Outcome
+    (READY (report ReviewReport) (rounds Int))
+    (ESCALATED (question String))
+    (UNRESOLVED (rounds Int)))
+  (defprompt review-prompt (:fills (task :text)) -> Review "Review: {task}")
+  (defprompt fix-prompt (:fills (task :text) (findings :value List[String])) -> Change
+    "Fix: {task} {findings}")
+  (defworkflow run ((task String)) -> Outcome
+    (loop/recur :max 2
+      :state (loop-state (round Int 1))
+      :on-exhausted (variant Outcome UNRESOLVED :rounds state.round)
+      (fn (state)
+        (let* ((review (provider-result providers.reviewer
+                         :prompt (review-prompt :task task))))
+          (match review
+            ((APPROVE a)
+             (done (variant Outcome READY :report a.report :rounds state.round)))
+            ((REQUEST_CHANGES r)
+             (let* ((fix (provider-result providers.coder
+                           :prompt (fix-prompt :task task :findings r.findings))))
+               (continue (loop-state :like state :round (+ state.round 1)))))
+            ((NEEDS_HUMAN h)
+             (done (variant Outcome ESCALATED :question h.question))))))))
+)
+"""
+
+_REQUEST = {"variant": "REQUEST_CHANGES", "report": "artifacts/review/r.md", "findings": ["f"]}
+
+
+def _files(tmp_path: Path, target: str) -> dict[str, Path]:
+    src = tmp_path / "reviewed_change.orc"
+    src.write_text(_SOURCE.replace("TARGET", target), encoding="utf-8")
+    providers = tmp_path / "providers.json"
+    providers.write_text(
+        json.dumps({"providers.coder": "coder", "providers.reviewer": "reviewer"}),
+        encoding="utf-8",
+    )
+    return {"source": src, "providers": providers}
+
+
+def _request(tmp_path: Path, files: dict[str, Path]) -> FrontendBuildRequest:
+    return FrontendBuildRequest(
+        source_path=files["source"], source_roots=(tmp_path,), entry_workflow="run",
+        provider_externs_path=files["providers"], prompt_externs_path=None,
+        imported_workflow_bundles_path=None, command_boundaries_path=None,
+        emit_debug_yaml=True, workspace_root=tmp_path,
+    )
+
+
+def _run(tmp_path, monkeypatch, target, reviews):
+    files = _files(tmp_path, target)
+    inputs = tmp_path / "inputs.json"
+    inputs.write_text(json.dumps({"task": "t"}), encoding="utf-8")
+    pending = list(reviews)
+    args = Namespace(
+        workflow=str(files["source"]), context=None, context_file=None, input=[],
+        input_file=str(inputs), clean_processed=False, archive_processed=None, debug=False,
+        stream_output=False, dry_run=False, backup_state=False, state_dir=None,
+        on_error="stop", max_retries=0, retry_delay=0, quiet=True, verbose=False,
+        log_level="error", step_summaries=False, summary_mode=None,
+        summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="run", source_root=[str(tmp_path)],
+        provider_externs_file=str(files["providers"]), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None,
+        emit_debug_yaml=True,
+    )
+
+    def prepare(_self, provider_name, *_a, **kw):
+        prompt = str(kw.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kw.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kw.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        payload = (
+            {"summary": "s"} if invocation.provider_name == "coder" else pending.pop(0)
+        )
+        out = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not out.is_absolute():
+            out = Path.cwd() / out
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(payload) + "\n", encoding="utf-8")
+        (tmp_path / "artifacts" / "review").mkdir(parents=True, exist_ok=True)
+        (tmp_path / "artifacts" / "review" / "r.md").write_text("ok", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    argv = [
+        "orchestrator", "run", str(files["source"]), "--source-root", str(tmp_path),
+        "--entry-workflow", "run", "--provider-externs-file", str(files["providers"]),
+    ]
+    monkeypatch.chdir(tmp_path)
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute,
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(args)
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.29", "2.30", "2.31", "2.32"])
+def test_loop_union_result_with_inactive_path_variant_compiles(tmp_path, target) -> None:
+    files = _files(tmp_path, target)
+    assert build_frontend_bundle(_request(tmp_path, files)).validated_bundle is not None
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.32"])
+def test_exhaustion_returns_unresolved(tmp_path, monkeypatch, target) -> None:
+    result = _run(tmp_path, monkeypatch, target, [_REQUEST, _REQUEST])
+    assert (result.exit_code, result.workflow_outputs["return__variant"],
+            result.workflow_outputs["return__rounds"]) == (0, "UNRESOLVED", 2)
+
+
+@pytest.mark.parametrize("target", ["2.28", "2.32"])
+def test_approval_returns_ready_with_report(tmp_path, monkeypatch, target) -> None:
+    approve = {"variant": "APPROVE", "report": "artifacts/review/r.md"}
+    result = _run(tmp_path, monkeypatch, target, [_REQUEST, approve])
+    assert (result.exit_code, result.workflow_outputs["return__variant"],
+            result.workflow_outputs["return__report"]) == (0, "READY", "artifacts/review/r.md")
+
+
+def test_malformed_provider_path_still_fails_run(tmp_path, monkeypatch) -> None:
+    bad = {"variant": "APPROVE", "report": "../escape.md"}
+    result = _run(tmp_path, monkeypatch, "2.32", [bad])
+    assert result.exit_code != 0

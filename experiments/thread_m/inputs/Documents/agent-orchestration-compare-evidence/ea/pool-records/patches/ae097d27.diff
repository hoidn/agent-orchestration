@@ -1810,3 +1813,62 @@ def test_loop_recur_exhaustion_projection_relaxes_variant_relpath_at_result_boun
         "ref": "root.steps.loop-recur-exhaustion-missing-projection__loop.artifacts.result__last_report"
     }
     assert authored["outputs"]["return__last_report"]["must_exist_target"] is False
+
+
+@pytest.mark.parametrize("target", ("2.28", "2.29", "2.30", "2.31", "2.32"))
+@pytest.mark.parametrize("finish", (False, True))
+def test_loop_recur_union_path_result_executes_or_exhausts(
+    tmp_path: Path, target: str, finish: bool
+) -> None:
+    workflow_path = _write_module(
+        tmp_path / "evidence_loop.orc",
+        "\n".join(
+            [
+                "(workflow-lisp",
+                '  (:language "0.1")',
+                f'  (:target-dsl "{target}")',
+                "  (defmodule evidence_loop)",
+                "  (export decide)",
+                '  (defpath Evidence :kind relpath :under "artifacts/evidence" :must-exist true)',
+                "  (defunion Decision",
+                "    (FOUND (evidence Evidence))",
+                "    (TIMED_OUT (attempts Int)))",
+                "  (defworkflow decide ((evidence Evidence) (finish Bool)) -> Decision",
+                "    (loop/recur :max 2 :state (loop-state (attempt Int 0))",
+                "      :on-exhausted (variant Decision TIMED_OUT :attempts state.attempt)",
+                "      (fn (state)",
+                "        (if finish",
+                "          (done (variant Decision FOUND :evidence evidence))",
+                "          (continue (loop-state :like state :attempt (+ state.attempt 1))))))))",
+            ]
+        ),
+    )
+    report = tmp_path / "artifacts/evidence/report.md"
+    report.parent.mkdir(parents=True)
+    report.write_text("valid report", encoding="utf-8")
+
+    result = _compile_entrypoint(
+        workflow_path, source_root=tmp_path, tmp_path=tmp_path, validate_shared=True
+    )
+    bundle = result.validated_bundles_by_name["evidence_loop::decide"]
+    contracts = dict(workflow_runtime_input_contracts(bundle))
+    bound_inputs = bind_workflow_inputs(
+        {name: contract for name, contract in contracts.items() if not name.startswith("__write_root__")},
+        {"evidence": "artifacts/evidence/report.md", "finish": finish},
+        tmp_path,
+    )
+    state_manager = StateManager(workspace=tmp_path, run_id=f"evidence-loop-{target}-{finish}")
+    state_manager.initialize(
+        workflow_path.as_posix(),
+        context=bundle_context_dict(bundle),
+        bound_inputs=bound_inputs,
+    )
+
+    state = WorkflowExecutor(bundle, tmp_path, state_manager, retry_delay_ms=0).execute(on_error="stop")
+
+    assert state["status"] == "completed", state
+    assert state["workflow_outputs"] == (
+        {"return__variant": "FOUND", "return__evidence": "artifacts/evidence/report.md"}
+        if finish
+        else {"return__variant": "TIMED_OUT", "return__attempts": 1 if target == "2.28" else 2}
+    )

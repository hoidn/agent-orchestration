@@ -0,0 +1,115 @@
+"""Loop results with path fields in non-exhausted union variants (targets 2.28-2.32)."""
+
+from __future__ import annotations
+
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.commands.run import run_workflow
+from orchestrator.providers.executor import ProviderExecutor
+from orchestrator.providers.types import PreparedProviderPolicy
+
+_SOURCE = (Path(__file__).parent.parent / "bugs/loop_result_paths/reviewed_change.orc").read_text(
+    encoding="utf-8"
+)
+_TARGETS = ("2.28", "2.29", "2.30", "2.31", "2.32")
+
+
+def _files(workspace: Path, target: str) -> dict[str, Path]:
+    source = workspace / "reviewed_change.orc"
+    source.write_text(_SOURCE.replace('"2.32"', f'"{target}"', 1), encoding="utf-8")
+    providers = workspace / "providers.json"
+    providers.write_text(
+        json.dumps({"providers.coder": "coder", "providers.reviewer": "reviewer"}),
+        encoding="utf-8",
+    )
+    return {"source": source, "providers": providers}
+
+
+def _args(files: dict[str, Path], input_file: Path) -> Namespace:
+    return Namespace(
+        workflow=str(files["source"]), context=None, context_file=None, input=[],
+        input_file=str(input_file), clean_processed=False, archive_processed=None,
+        debug=False, stream_output=False, dry_run=False, backup_state=False,
+        state_dir=None, on_error="stop", max_retries=0, retry_delay=0, quiet=True,
+        verbose=False, log_level="error", step_summaries=False, summary_mode=None,
+        summary_provider="claude_sonnet_summary", summary_timeout_sec=120,
+        summary_max_input_chars=12000, summary_profile=None, live_agent_notes=False,
+        live_agent_note_provider=None, live_agent_note_interval_sec=15.0,
+        live_agent_note_timeout_sec=30, live_agent_note_max_tail_chars=6000,
+        entry_workflow="reviewed_change::reviewed-change", source_root=[str(files["source"].parent)],
+        provider_externs_file=str(files["providers"]), prompt_externs_file=None,
+        imported_workflow_bundles_file=None, command_boundaries_file=None,
+        emit_debug_yaml=False,
+    )
+
+
+def _run(tmp_path, monkeypatch, target, reviews):
+    """Run the workflow; each reviewer call returns the next dict in `reviews`."""
+    files = _files(tmp_path, target)
+    (tmp_path / "artifacts/review").mkdir(parents=True)
+    (tmp_path / "artifacts/review/r.md").write_text("ok", encoding="utf-8")
+    inputs = tmp_path / "inputs.json"
+    inputs.write_text(json.dumps({"task": "t"}), encoding="utf-8")
+    queue = list(reviews)
+
+    def prepare(_self, provider_name, *_a, **kwargs):
+        prompt = str(kwargs.get("prompt_content", ""))
+        return SimpleNamespace(
+            provider_name=provider_name, prompt=prompt, prepared_prompt=prompt,
+            prepared_provider_policy=PreparedProviderPolicy(
+                provider_name=provider_name, model=None, effort=None,
+                timeout_sec=kwargs.get("timeout_sec"), input_mode="stdin",
+            ),
+            env=dict(kwargs.get("env") or {}), input_mode="stdin",
+        ), None
+
+    def execute(_self, invocation, **_kw):
+        payload = (
+            queue.pop(0) if invocation.provider_name == "reviewer" else {"summary": "s"}
+        )
+        output = Path(invocation.env["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+        if not output.is_absolute():
+            output = Path.cwd() / output
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(json.dumps(payload) + "\n", encoding="utf-8")
+        return SimpleNamespace(
+            exit_code=0, stdout=b"", stderr=b"", duration_ms=1, error=None,
+            missing_placeholders=None, invalid_prompt_placeholder=False, raw_stdout=None,
+            normalized_stdout=None, provider_session=None,
+        )
+
+    monkeypatch.chdir(tmp_path)
+    argv = ["orchestrator", "run", str(files["source"])]
+    with patch.object(ProviderExecutor, "prepare_invocation", prepare), patch.object(
+        ProviderExecutor, "execute", execute
+    ), patch.object(sys, "argv", argv):
+        return run_workflow(_args(files, inputs))
+
+
+_CHANGES = {"variant": "REQUEST_CHANGES", "report": "artifacts/review/r.md", "findings": ["f"]}
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_exhaustion_matches_across_targets(tmp_path, monkeypatch, target):
+    result = _run(tmp_path, monkeypatch, target, [_CHANGES] * 3)
+
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "UNRESOLVED"
+    assert result.workflow_outputs["return__rounds"] == 3
+
+
+@pytest.mark.parametrize("target", _TARGETS)
+def test_approval_returns_report_path(tmp_path, monkeypatch, target):
+    approve = {"variant": "APPROVE", "report": "artifacts/review/r.md"}
+    result = _run(tmp_path, monkeypatch, target, [approve])
+
+    assert result.exit_code == 0
+    assert result.workflow_outputs["return__variant"] == "READY"
+    assert result.workflow_outputs["return__report"] == "artifacts/review/r.md"

+def _inactive_result_path_source(tmp_path: Path, target: str) -> Path:
+    return _write_module(
+        tmp_path / "inactive_result_path.orc",
+        f'''(workflow-lisp
+  (:language "0.1") (:target-dsl "{target}")
+  (defpath ReviewFile :kind relpath :under "artifacts/review" :must-exist true)
+  (defunion Decision
+    (ACCEPTED (evidence ReviewFile))
+    (ESCALATED (reason String))
+    (TIMED_OUT (attempt Int)))
+  (defworkflow decide ((finish Bool) (evidence ReviewFile)) -> Decision
+    (loop/recur :max 1 :state (loop-state (attempt Int 1))
+      :on-exhausted (variant Decision TIMED_OUT :attempt state.attempt)
+      (fn (state)
+        (if finish
+          (done (variant Decision ACCEPTED :evidence evidence))
+          (continue (loop-state :like state :attempt (+ state.attempt 1))))))))''',
+    )
+
+
+@pytest.mark.parametrize("target", ("2.28", "2.29", "2.30", "2.31", "2.32"))
+def test_loop_exhaustion_omits_path_from_inactive_result_variant(
+    tmp_path: Path, target: str,
+) -> None:
+    source = _inactive_result_path_source(tmp_path, target)
+    result = compile_stage3_module(
+        source, validate_shared=True, workspace_root=tmp_path, lowering_route="wcc_m4",
+    )
+    repeat_step = next(
+        step for step in result.lowered_workflows[0].authored_mapping["steps"]
+        if "repeat_until" in step
+    )
+    outputs = repeat_step["repeat_until"]["on_exhausted"]["outputs"]
+    assert outputs["result__variant"] == "TIMED_OUT"
+    assert "result__evidence" not in outputs
+
+
+@pytest.mark.parametrize("target", ("2.28", "2.29", "2.30", "2.31", "2.32"))
+@pytest.mark.parametrize("finish", (False, True))
+def test_loop_result_path_preserves_done_and_exhaustion_behavior(
+    tmp_path: Path, target: str, finish: bool,
+) -> None:
+    source = _inactive_result_path_source(tmp_path, target)
+    result = compile_stage3_module(
+        source, validate_shared=True, workspace_root=tmp_path, lowering_route="wcc_m4",
+    )
+    bundle = result.validated_bundles["decide"]
+    evidence = tmp_path / "artifacts" / "review" / "evidence.md"
+    evidence.parent.mkdir(parents=True)
+    evidence.write_text("reviewed\n", encoding="utf-8")
+    contracts = {
+        name: contract for name, contract in workflow_runtime_input_contracts(bundle).items()
+        if not name.startswith("__write_root__")
+    }
+    bound_inputs = bind_workflow_inputs(
+        contracts,
+        {"finish": finish, "evidence": "artifacts/review/evidence.md"},
+        tmp_path,
+    )
+    manager = StateManager(tmp_path, run_id=f"loop-result-path-{target}-{finish}")
+    manager.initialize(source.as_posix(), context=bundle_context_dict(bundle), bound_inputs=bound_inputs)
+    state = WorkflowExecutor(bundle, tmp_path, manager, retry_delay_ms=0).execute(on_error="stop")
+
+    assert state["status"] == "completed"
+    assert state["workflow_outputs"] == (
+        {"return__variant": "ACCEPTED", "return__evidence": "artifacts/review/evidence.md"}
+        if finish else {"return__variant": "TIMED_OUT", "return__attempt": 2}
+    )
+

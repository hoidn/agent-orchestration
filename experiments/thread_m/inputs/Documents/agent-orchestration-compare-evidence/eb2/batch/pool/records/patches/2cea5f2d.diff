+def _lineage_trailer(message: bytes) -> dict[str, str] | None:
+    if b"Retirement-Control-" not in message and b"Retirement-Transaction-ID" not in message:
+        return None
+    coordinates = _trailer_coordinates(message)
+    if coordinates is None or message.count(b"Retirement-Control-Schema:") != 1:
+        raise SourceBindingError("commit_control_trailer_invalid")
+    return {"transaction_id": coordinates[0], "normalized_control_sha256": coordinates[1]}
+
+
+def _lineage_commit_row(root: Path, commit: str) -> dict[str, Any]:
+    parents = _git(root, "rev-list", "--parents", "-n", "1", commit).decode("ascii").split()[1:]
+    if len(parents) != 1:
+        raise SourceBindingError(f"committed_predecessor_lineage_merge_or_root:{commit}")
+    raw = _git(root, "diff-tree", "--no-commit-id", "--name-only", "-r", "-z", "--no-renames", commit)
+    paths = [_decode_path(item) for item in raw.split(b"\0") if item]
+    if len(paths) != len(set(paths)):
+        raise SourceBindingError(f"committed_predecessor_lineage_duplicate_path:{commit}")
+    message = _raw_commit_message(root, commit)
+    return {
+        "commit": commit,
+        "parent": parents[0],
+        "tree": _git(root, "rev-parse", f"{commit}^{{tree}}").decode("ascii").strip(),
+        "raw_message_sha256": _sha256_bytes(message),
+        "changed_paths": sorted(paths),
+        "changed_path_set_sha256": _path_list_digest(paths),
+        "control_coordinates": _lineage_trailer(message),
+    }
+
+
+def derive_committed_predecessor_lineage(
+    repository_root: Path | str,
+    *,
+    baseline_head: str,
+    intended_predecessor_head: str,
+    require_uncovered_paths: bool = False,
+) -> dict[str, Any]:
+    """Project the first-parent commits in ``(baseline_head, intended_predecessor_head]``.
+
+    Depends only on Git objects; raises SourceBindingError on any ambiguity.
+    """
+
+    root = _repository_root(repository_root)
+    for value in (baseline_head, intended_predecessor_head):
+        if not isinstance(value, str) or _HEX40_RE.fullmatch(value) is None:
+            raise SourceBindingError("lineage_commit_identity_invalid")
+    for value in (baseline_head, intended_predecessor_head):
+        _git(root, "cat-file", "-e", f"{value}^{{commit}}")
+    ancestor = subprocess.run(
+        ["git", "merge-base", "--is-ancestor", baseline_head, intended_predecessor_head],
+        cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    if ancestor.returncode != 0:
+        raise SourceBindingError("baseline_head_not_ancestor")
+    merges = _git(root, "rev-list", "--first-parent", "--merges", f"{baseline_head}..{intended_predecessor_head}")
+    if merges.strip():
+        raise SourceBindingError("committed_predecessor_lineage_merge")
+    commits = _git(
+        root, "rev-list", "--first-parent", "--reverse", f"{baseline_head}..{intended_predecessor_head}"
+    ).decode("ascii").split()
+    rows = [_lineage_commit_row(root, commit) for commit in commits]
+    controlled = sorted({p for r in rows if r["control_coordinates"] is not None for p in r["changed_paths"]})
+    uncovered = sorted({p for r in rows if r["control_coordinates"] is None for p in r["changed_paths"]})
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("committed_predecessor_lineage_fully_covered")
+    changed = sorted(set(controlled) | set(uncovered))
+    projection: dict[str, Any] = {
+        "baseline_head": baseline_head,
+        "intended_predecessor_head": intended_predecessor_head,
+        "intended_predecessor_tree": _git(
+            root, "rev-parse", f"{intended_predecessor_head}^{{tree}}"
+        ).decode("ascii").strip(),
+        "first_parent_commits": rows,
+        "commit_count": len(rows),
+        "changed_paths": changed,
+        "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": controlled,
+        "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": uncovered,
+        "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    projection["normalized_projection_sha256"] = _canonical_sha256(projection)
+    return projection
+

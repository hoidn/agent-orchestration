+def test_lineage_separates_controlled_and_uncovered_paths(repo: Path) -> None:
+    base = _commit(repo, "base.txt", "base")
+    _commit(repo, "controlled.txt", "c\n" + SUFFIX.format(t="1" * 64, c="2" * 64))
+    head = _commit(repo, "plain.txt", "plain")
+    lineage = derive_committed_predecessor_lineage(
+        repo, baseline_head=base, intended_predecessor_head=head, require_uncovered_paths=True
+    )
+    assert lineage["controlled_paths"] == ["controlled.txt"]
+    assert lineage["uncovered_paths"] == ["plain.txt"]
+    assert lineage["changed_paths"] == ["controlled.txt", "plain.txt"]
+    assert lineage["commit_count"] == 2
+    assert lineage["first_parent_commits"][0]["control_coordinates"] == {
+        "transaction_id": "1" * 64,
+        "normalized_control_sha256": "sha256:" + "2" * 64,
+    }
+    assert lineage["first_parent_commits"][1]["control_coordinates"] is None
+    assert lineage["normalized_projection_sha256"] == canonical_sha256(
+        lineage, exclude={"normalized_projection_sha256"}

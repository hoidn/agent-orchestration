+            "sha256:" + hashlib.sha256(data).hexdigest(),
+        ).as_posix()
+        del view[snapshot_path]
+        view[new_path] = {"data": data}
+        binding = {**binding, "snapshot_path": new_path}
+        snapshot_path = new_path
+    record = _semantic_record(binding)
+    if role is None:
+        _generation_semantics(repo, record, view)
+        return
+    with pytest.raises(
+        AttemptMigrationError,
+        match=f"semantic_coordinate_row_binding_mismatch:{role}",
+    ):
+        _generation_semantics(repo, record, view)
+
+
+def test_v2_capture_cli_prints_both_records(
+    v2_repository: dict[str, object], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    import sys
+
+    from orchestrator.retirement import attempt_migration
+
+    argv = ["capture-invalidated-adopted", "--repository-root", str(v2_repository["root"])]
+    for option in attempt_migration.INVALIDATED_ADOPTED_OPTIONS:
+        key = {"source_root": "source_root"}.get(option, option)
+        argv += ["--" + option.replace("_", "-"), str(v2_repository[key])]
+    for path in v2_repository["protected_paths"]:
+        argv += ["--protected-path", path]
+    import io
+    from contextlib import redirect_stderr, redirect_stdout
+
+    out, err = io.StringIO(), io.StringIO()
+    with redirect_stdout(out), redirect_stderr(err):
+        code = attempt_migration.main(argv)
+    assert (code, err.getvalue()) == (0, "")
+    printed = json.loads(out.getvalue())
+    assert set(printed) == {"incident", "disposition"}

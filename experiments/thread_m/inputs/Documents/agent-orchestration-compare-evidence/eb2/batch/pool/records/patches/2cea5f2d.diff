--- /dev/null
+++ b/orchestrator/retirement/byte_overlay.py
@@ -0,0 +1,79 @@
+"""Context-scoped repository byte overlay shared by the evidence validators.
+
+Depends on: the process-local ContextVar below and, for committed fallback, the
+Git object database of the validated repository (``HEAD`` blobs).  Inside
+``active(files, require_committed_fallback)`` the validators read each mapped
+repository-relative path from ``files``.  An unmapped path reads the live file;
+with ``require_committed_fallback`` it is accepted only when it is a regular
+file committed at HEAD whose current bytes equal the HEAD blob.
+"""
+
+from __future__ import annotations
+
+import subprocess
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterator, Mapping
+
+
+@dataclass(frozen=True)
+class Overlay:
+    files: Mapping[str, bytes]
+    require_committed_fallback: bool
+
+    def names_in(self, directory: str) -> list[str]:
+        prefix = "" if directory in {"", "."} else directory.rstrip("/") + "/"
+        return sorted(
+            path[len(prefix):]
+            for path in self.files
+            if path.startswith(prefix) and "/" not in path[len(prefix):]
+        )
+
+
+_ACTIVE: ContextVar[Overlay | None] = ContextVar("retirement_byte_overlay", default=None)
+
+
+def current() -> Overlay | None:
+    return _ACTIVE.get()
+
+
+@contextmanager
+def active(
+    files: Mapping[str, bytes] | None, require_committed_fallback: bool = False
+) -> Iterator[None]:
+    """Install an overlay merged over any outer one (inner entries win)."""
+
+    if files is None and not require_committed_fallback:
+        yield
+        return
+    outer = _ACTIVE.get()
+    merged = {**(outer.files if outer else {}), **(files or {})}
+    token = _ACTIVE.set(
+        Overlay(
+            merged,
+            require_committed_fallback
+            or (outer is not None and outer.require_committed_fallback),
+        )
+    )
+    try:
+        yield
+    finally:
+        _ACTIVE.reset(token)
+
+
+def committed_regular_matches(root: Path, path: str, data: bytes) -> bool:
+    """True when ``path`` is a regular HEAD blob whose bytes equal ``data``."""
+
+    def run(*args: str) -> bytes | None:
+        done = subprocess.run(
+            ["git", *args], cwd=root, stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL, check=False,
+        )
+        return done.stdout if done.returncode == 0 else None
+
+    entry = run("ls-tree", "HEAD", "--", path)
+    if not entry or entry.split(b" ", 1)[0] not in {b"100644", b"100755"}:
+        return False
+    return run("show", f"HEAD:{path}") == data

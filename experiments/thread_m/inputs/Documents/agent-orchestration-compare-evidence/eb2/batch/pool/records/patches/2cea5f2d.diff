@@ -0,0 +1,1123 @@
+"""Invalidated owner-adopted uncommitted attempt: incident and v2 disposition.
+
+Depends on files and Git objects only (the workspace baseline, owner
+attestation records, the known-failure baseline, the attempt files under the
+source root, and committed authority bytes).  ``attempt_migration`` owns the
+shared primitives; this module adds the incident record
+``attempt_migration_incident.v1``, the disposition
+``attempt_migration_disposition.v2`` capture, and the post-archive logical view
+through which v2 validation re-derives archived evidence.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from . import attempt_migration as am
+from . import byte_overlay
+from .attempt_migration import AttemptMigrationError
+
+INCIDENT_KEYS = {
+    "schema_version",
+    "governing_plan_binding",
+    "migration_plan_binding",
+    "workspace_baseline_binding",
+    "owner_attestation_binding",
+    "pending_attestation_snapshot_binding",
+    "known_failure_baseline_binding",
+    "expected_paths_manifest_binding",
+    "source_root",
+    "intended_predecessor",
+    "predecessor_projection",
+    "pre_move_repository_state",
+    "attempt_rows",
+    "attempt_path_count",
+    "attempt_path_set_sha256",
+    "normalized_attempt_row_set_sha256",
+    "adoption_facts",
+    "normalized_incident_sha256",
+    "claims_not_made",
+}
+INCIDENT_CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+INCIDENT_ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+LIFECYCLE_KEYS = {
+    "adoption_state",
+    "repository_commit_state",
+    "invalidation_reason",
+    "incident_binding",
+    "workspace_baseline_role",
+    "owner_attestation_role",
+    "adoption_transfer",
+}
+# Historical drift the incident tolerates when reopening the known-failure
+# baseline: HEAD advanced and unrelated paths entered the status.
+TOLERATED_BASELINE_ISSUES = frozenset(
+    {"candidate_path_set_live_mismatch", "candidate_git_identity_mismatch"}
+)
+POST_REPORT_SCHEMA = "attempt_migration_post_report.v1"
+POST_REPORT_KEYS = frozenset(
+    {
+        "schema_version",
+        "result",
+        "disposition_binding",
+        "disposition_review_bindings",
+        "repository_state",
+        "archive_rows",
+        "archive_path_count",
+        "archive_path_set_sha256",
+        "protected_path_bindings",
+        "outside_status_projection_sha256",
+        "normalized_report_sha256",
+        "claims_not_made",
+    }
+)
+
+
+def _err(code: str, detail: str = "") -> AttemptMigrationError:
+    return AttemptMigrationError(code, detail)
+
+
+class _Reader:
+    """Reads repository files from a logical view, else live (committed-only in a view)."""
+
+    def __init__(self, root: Path, view: Mapping[str, Mapping[str, Any]] | None) -> None:
+        self.root = root
+        self.view = view
+
+    def snapshot(self, path: str, *, committed: bool = False) -> dict[str, Any] | None:
+        if self.view is not None and path in self.view:
+            return dict(self.view[path])
+        if committed:
+            try:
+                return am._require_committed_live(self.root, path)
+            except AttemptMigrationError:
+                return None
+        live = am._read_regular(self.root, path, missing_ok=True)
+        if live is not None and self.view is not None and not (
+            byte_overlay.committed_regular_matches(self.root, path, live["data"])
+        ):
+            return None
+        return live
+
+    def overlay(self) -> dict[str, bytes] | None:
+        if self.view is None:
+            return None
+        return {path: snap["data"] for path, snap in self.view.items()}
+
+
+def _binding(
+    reader: _Reader, name: str, path: str, *, committed: bool = False
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    snap = reader.snapshot(path, committed=committed)
+    if snap is None:
+        raise _err(f"incident_{name}_binding_invalid", path)
+    return am._content_binding(snap), snap
+
+
+def _json_snapshot(snap: Mapping[str, Any], name: str) -> dict[str, Any]:
+    try:
+        value = am._json_bytes(snap["data"], snap["path"])
+    except AttemptMigrationError as exc:
+        raise _err(f"incident_{name}_binding_invalid", exc.code) from exc
+    return value
+
+
+def _owner_facts(attestation: Mapping[str, Any]) -> dict[str, Any]:
+    def mapping(key: str) -> Mapping[str, Any]:
+        value = attestation.get(key)
+        if not isinstance(value, Mapping):
+            raise _err("incident_owner_lifecycle_invalid", key)
+        return value
+
+    if attestation.get("evidence_status") != "owner_confirmed":
+        raise _err("incident_owner_lifecycle_invalid", "evidence_status")
+    owner = mapping("owner")
+    confirmations = mapping("owner_confirmations")
+    adoption = mapping("owner_adoption")
+    identity = owner.get("identity")
+    if (
+        not isinstance(identity, str)
+        or not identity
+        or not isinstance(owner.get("role"), str)
+        or adoption.get("identity") != identity
+        or not isinstance(confirmations.get("confirmed_at"), str)
+        or not isinstance(adoption.get("adopted_at"), str)
+    ):
+        raise _err("incident_owner_lifecycle_invalid", "owner")
+    return {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed",
+        "owner_identity": identity,
+        "owner_role": owner["role"],
+        "confirmed_at": confirmations["confirmed_at"],
+        "adopted_at": adoption["adopted_at"],
+    }
+
+
+def _check_baseline(
+    reader: _Reader, root: Path, snap: Mapping[str, Any], attestation: Mapping[str, Any]
+) -> None:
+    from . import broad_evidence
+
+    record = _json_snapshot(snap, "known_failure_baseline")
+    claimed = attestation.get("baseline_binding")
+    candidate = record.get("candidate_binding")
+    if (
+        not isinstance(claimed, Mapping)
+        or claimed.get("path") != snap["path"]
+        or claimed.get("sha256") != snap["sha256"]
+        or not isinstance(candidate, Mapping)
+        or claimed.get("candidate_path_set_sha256")
+        != candidate.get("candidate_path_set_sha256")
+    ):
+        raise _err("incident_known_failure_baseline_binding_invalid", "attestation_mismatch")
+    issues = list(broad_evidence.validate_record(record))
+    if record.get("schema_version") != "broad_known_failure_baseline.v1":
+        issues.append(broad_evidence.Issue("schema_version_invalid"))
+    elif not issues:
+        issues.extend(
+            broad_evidence.validate_bound_record(
+                record,
+                root,
+                bound_file_bytes=reader.overlay(),
+                require_committed_fallback=reader.view is not None,
+            )
+        )
+    if not issues:
+        issues.extend(
+            broad_evidence.validate_bound_record(
+                attestation,
+                root,
+                bound_file_bytes=reader.overlay(),
+                require_committed_fallback=reader.view is not None,
+            )
+        )
+    codes = sorted({i.code for i in issues} - TOLERATED_BASELINE_ISSUES)
+    if codes:
+        raise _err("incident_known_failure_baseline_binding_invalid", ",".join(codes))
+
+
+def _lineage(root: Path, baseline_head: str, predecessor: str) -> dict[str, Any]:
+    from .source_bindings import SourceBindingError, derive_committed_predecessor_lineage
+
+    try:
+        return derive_committed_predecessor_lineage(
+            root,
+            baseline_head=baseline_head,
+            intended_predecessor_head=predecessor,
+            require_uncovered_paths=True,
+        )
+    except SourceBindingError as exc:
+        raise _err("incident_predecessor_lineage_invalid", str(exc)) from exc
+
+
+def _derive_incident(
+    root: Path,
+    reader: _Reader,
+    *,
+    governing_plan_path: str,
+    migration_plan_path: str,
+    workspace_baseline_path: str,
+    owner_attestation_path: str,
+    pending_snapshot_path: str,
+    known_failure_baseline_path: str,
+    manifest_path: str,
+    source_root: str,
+    intended_predecessor_head: str,
+    state: Mapping[str, Any],
+) -> dict[str, Any]:
+    from .source_bindings import validate_workspace_record_shape
+
+    governing, _ = _binding(reader, "governing_plan", governing_plan_path, committed=True)
+    migration, _ = _binding(reader, "migration_plan", migration_plan_path, committed=True)
+    manifest, manifest_snap = _binding(
+        reader, "expected_paths_manifest", manifest_path, committed=True
+    )
+    expected = am._manifest_paths(manifest_snap["data"], manifest_path)
+    if any(not am._under(path, source_root) for path in expected):
+        raise _err("expected_path_outside_source_root")
+    manifest["row_count"] = len(expected)
+
+    workspace, workspace_snap = _binding(reader, "workspace_baseline", workspace_baseline_path)
+    workspace_record = _json_snapshot(workspace_snap, "workspace_baseline")
+    if validate_workspace_record_shape(workspace_record) or not am._is_commit_identity(
+        workspace_record.get("head")
+    ):
+        raise _err("incident_workspace_baseline_binding_invalid", "shape")
+
+    attestation_binding, attestation_snap = _binding(
+        reader, "owner_attestation", owner_attestation_path
+    )
+    attestation = _json_snapshot(attestation_snap, "owner_attestation")
+    facts = _owner_facts(attestation)
+    from . import broad_evidence
+
+    issues = broad_evidence.validate_record(attestation)
+    if attestation.get("schema_version") != "broad_failure_baseline_attestation.v1" or issues:
+        raise _err(
+            "incident_owner_attestation_binding_invalid",
+            ",".join(sorted({i.code for i in issues})),
+        )
+
+    pending, pending_snap = _binding(
+        reader, "pending_attestation_snapshot", pending_snapshot_path
+    )
+    pending_record = _json_snapshot(pending_snap, "pending_attestation_snapshot")
+    if (
+        pending_record.get("schema_version") != attestation["schema_version"]
+        or pending_record.get("evidence_status") != "pending_owner_confirmation"
+        or broad_evidence.validate_record(pending_record)
+        or any(
+            pending_record.get(key) != attestation.get(key)
+            for key in (
+                "baseline_binding",
+                "failure_set_binding",
+                "normalization_binding",
+                "classification_summary",
+                "specification_review_binding",
+                "quality_review_binding",
+                "prepared_by",
+                "prepared_at",
+            )
+        )
+    ):
+        raise _err("incident_pending_attestation_snapshot_binding_invalid")
+
+    baseline, baseline_snap = _binding(
+        reader, "known_failure_baseline", known_failure_baseline_path
+    )
+    _check_baseline(reader, root, baseline_snap, attestation)
+
+    projection = _lineage(root, workspace_record["head"], intended_predecessor_head)
+    rows: list[dict[str, Any]] = []
+    for path in expected:
+        snap = reader.snapshot(path)
+        if snap is None:
+            raise _err("attempt_row_state_invalid", path)
+        rows.append(
+            {
+                "path": path,
+                "file_type": "regular",
+                "lstat_mode": snap["lstat_mode"],
+                "size": snap["size"],
+                "sha256": snap["sha256"],
+                "tracked_state": "modified"
+                if am._is_tracked(root, path)
+                else "untracked",
+            }
+        )
+    record: dict[str, Any] = {
+        "schema_version": am.INCIDENT_SCHEMA_VERSION,
+        "governing_plan_binding": governing,
+        "migration_plan_binding": migration,
+        "workspace_baseline_binding": workspace,
+        "owner_attestation_binding": attestation_binding,
+        "pending_attestation_snapshot_binding": pending,
+        "known_failure_baseline_binding": baseline,
+        "expected_paths_manifest_binding": manifest,
+        "source_root": source_root,
+        "intended_predecessor": {
+            "head": intended_predecessor_head,
+            "tree": projection["intended_predecessor_tree"],
+        },
+        "predecessor_projection": projection,
+        "pre_move_repository_state": dict(state),
+        "attempt_rows": rows,
+        "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": am._canonical_digest(expected),
+        "normalized_attempt_row_set_sha256": am._canonical_digest(rows),
+        "adoption_facts": facts,
+        "normalized_incident_sha256": "",
+        "claims_not_made": INCIDENT_CLAIMS_NOT_MADE,
+    }
+    record["normalized_incident_sha256"] = am._canonical_digest(
+        record, exclude="normalized_incident_sha256"
+    )
+    return record
+
+
+def _incident_paths(record: Mapping[str, Any]) -> dict[str, Any]:
+    def path(key: str) -> str:
+        binding = record[key]
+        return am._relative_path(binding["path"])
+
+    return {
+        "governing_plan_path": path("governing_plan_binding"),
+        "migration_plan_path": path("migration_plan_binding"),
+        "workspace_baseline_path": path("workspace_baseline_binding"),
+        "owner_attestation_path": path("owner_attestation_binding"),
+        "pending_snapshot_path": path("pending_attestation_snapshot_binding"),
+        "known_failure_baseline_path": path("known_failure_baseline_binding"),
+        "manifest_path": path("expected_paths_manifest_binding"),
+        "source_root": am._relative_path(record["source_root"]),
+        "intended_predecessor_head": record["intended_predecessor"]["head"],
+    }
+
+
+_BINDING_FIELDS = (
+    ("governing_plan", "governing_plan_binding", {"path", "size", "sha256"}),
+    ("migration_plan", "migration_plan_binding", {"path", "size", "sha256"}),
+    ("workspace_baseline", "workspace_baseline_binding", {"path", "size", "sha256"}),
+    ("owner_attestation", "owner_attestation_binding", {"path", "size", "sha256"}),
+    (
+        "pending_attestation_snapshot",
+        "pending_attestation_snapshot_binding",
+        {"path", "size", "sha256"},
+    ),
+    ("known_failure_baseline", "known_failure_baseline_binding", {"path", "size", "sha256"}),
+    (
+        "expected_paths_manifest",
+        "expected_paths_manifest_binding",
+        {"path", "size", "sha256", "row_count"},
+    ),
+)
+
+
+def _validate_incident_shape(record: Any) -> Mapping[str, Any]:
+    if not isinstance(record, Mapping) or set(record) != INCIDENT_KEYS:
+        raise _err("incident_keys_mismatch")
+    if record["schema_version"] != am.INCIDENT_SCHEMA_VERSION:
+        raise _err("incident_schema_invalid")
+    if record["claims_not_made"] != INCIDENT_CLAIMS_NOT_MADE:
+        raise _err("incident_claims_invalid")
+    if record["normalized_incident_sha256"] != am._canonical_digest(
+        record, exclude="normalized_incident_sha256"
+    ):
+        raise _err("incident_digest_mismatch")
+    for name, key, keys in _BINDING_FIELDS:
+        binding = record[key]
+        if not isinstance(binding, Mapping) or set(binding) != keys:
+            raise _err(f"incident_{name}_binding_invalid", "shape")
+        if (
+            not isinstance(binding["path"], str)
+            or type(binding["size"]) is not int
+            or not am._is_sha256(binding["sha256"])
+        ):
+            raise _err(f"incident_{name}_binding_invalid", "shape")
+    rows = record["attempt_rows"]
+    if not isinstance(rows, list) or not rows:
+        raise _err("incident_attempt_rows_invalid")
+    for row in rows:
+        if not isinstance(row, Mapping) or set(row) != INCIDENT_ROW_KEYS:
+            raise _err("incident_attempt_rows_invalid")
+    return record
+
+
+def _validate_incident_with(
+    root: Path, record: Any, view: Mapping[str, Mapping[str, Any]] | None
+) -> Mapping[str, Any]:
+    _validate_incident_shape(record)
+    try:
+        state = record["pre_move_repository_state"]
+        head = state["head"]
+        paths = _incident_paths(record)
+    except (KeyError, TypeError, AttemptMigrationError) as exc:
+        raise _err("incident_structure_invalid") from exc
+    if not am._is_commit_identity(head) or not am._git_is_ancestor(
+        root, head, am._git(root, "rev-parse", "HEAD").decode("ascii").strip()
+    ):
+        raise _err("capture_head_not_ancestor")
+    rebuilt = _derive_incident(root, _Reader(root, view), state=state, **paths)
+    if rebuilt != record:
+        for name, key, _ in _BINDING_FIELDS:
+            if rebuilt[key] != record[key]:
+                raise _err(f"incident_{name}_binding_invalid", "changed")
+        for key in sorted(INCIDENT_KEYS):
+            if rebuilt[key] != record[key]:
+                raise _err("incident_projection_mismatch", key)
+    return record
+
+
+def build_attempt_migration_incident(
+    repository_root: Path | str,
+    *,
+    governing_plan_path: Path | str,
+    migration_plan_path: Path | str,
+    workspace_baseline_path: Path | str,
+    owner_attestation_path: Path | str,
+    pending_attestation_snapshot_path: Path | str,
+    known_failure_baseline_path: Path | str,
+    expected_paths_manifest_path: Path | str,
+    source_root: Path | str,
+    intended_predecessor_head: str,
+) -> dict[str, Any]:
+    """Derive the incident record from live files and Git objects."""
+
+    root = am._repository_root(repository_root)
+    return _derive_incident(
+        root,
+        _Reader(root, None),
+        governing_plan_path=am._relative_path(governing_plan_path),
+        migration_plan_path=am._relative_path(migration_plan_path),
+        workspace_baseline_path=am._relative_path(workspace_baseline_path),
+        owner_attestation_path=am._relative_path(owner_attestation_path),
+        pending_snapshot_path=am._relative_path(pending_attestation_snapshot_path),
+        known_failure_baseline_path=am._relative_path(known_failure_baseline_path),
+        manifest_path=am._relative_path(expected_paths_manifest_path),
+        source_root=am._relative_path(source_root, field="source_root"),
+        intended_predecessor_head=intended_predecessor_head,
+        state=am._repository_state(root),
+    )
+
+
+def validate_attempt_migration_incident(
+    repository_root: Path | str, record: Any
+) -> Mapping[str, Any]:
+    """Reopen every binding of ``record``; return it unchanged when valid."""
+
+    root = am._repository_root(repository_root)
+    return _validate_incident_with(root, record, None)
+
+
+# --- v2 disposition ----------------------------------------------------------
+
+
+def validate_lifecycle_shape(value: Any) -> None:
+    lifecycle = am._require_keys(value, LIFECYCLE_KEYS, "attempt_lifecycle_invalid")
+    expected = {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+        "workspace_baseline_role": "workspace_baseline",
+        "owner_attestation_role": "attestation_record",
+        "adoption_transfer": "forbidden",
+    }
+    if any(lifecycle[key] != item for key, item in expected.items()):
+        raise _err("attempt_lifecycle_invalid")
+    am._validate_file_binding(lifecycle["incident_binding"], full=False)
+
+
+def _logical_view(root: Path, record: Mapping[str, Any]) -> dict[str, dict[str, Any]]:
+    """Map each attempt original path to its exact row-bound source or archive bytes."""
+
+    view: dict[str, dict[str, Any]] = {}
+    for row in record["attempt_rows"]:
+        original = row["original_path"]
+        try:
+            view[original] = am._resolve_attempt_row_snapshot(root, row)
+        except AttemptMigrationError as exc:
+            raise _err("attempt_row_state_invalid", original) from exc
+    return view
+
+
+def _generation_semantics(
+    root: Path, record: Mapping[str, Any], view: Mapping[str, Mapping[str, Any]]
+) -> None:
+    """Re-run the materialization validator over the row-bound view bytes."""
+
+    from .materialization import validate_generation
+
+    g = record["ledger_lineage"]["generation_11"]
+    request_path = g["request_binding"]["path"]
+    snapshot_path = g["snapshot_binding"]["path"]
+    issues = validate_generation(
+        root,
+        Path(request_path),
+        Path(snapshot_path),
+        bound_file_bytes={path: entry["data"] for path, entry in view.items()},
+        require_committed_fallback=True,
+    )
+    if issues:
+        duplicated = view[snapshot_path]["data"] == view[request_path]["data"]
+        raise _err(
+            "semantic_coordinate_row_binding_mismatch",
+            "generation11_snapshot" if duplicated else "generation11_request",
+        )
+
+
+def _reviews_committed(root: Path, bindings: Any) -> bool:
+    """Both disposition review bindings name files committed at HEAD with those bytes."""
+
+    if not isinstance(bindings, Mapping) or set(bindings) != {"specification", "code_quality"}:
+        return False
+    for binding in bindings.values():
+        if not isinstance(binding, Mapping) or not isinstance(binding.get("path"), str):
+            return False
+        current = am._read_regular(root, binding["path"], missing_ok=True)
+        if (
+            current is None
+            or am._content_binding(current) != binding
+            or not byte_overlay.committed_regular_matches(root, binding["path"], current["data"])
+        ):
+            return False
+    return True
+
+
+def _is_valid_post_report(
+    report: Mapping[str, Any],
+    file: Mapping[str, Any],
+    snapshot: Mapping[str, Any],
+    record: Mapping[str, Any],
+    root: Path,
+    state: Mapping[str, Any],
+    ignored: set[str],
+) -> bool:
+    """True only for the closed canonical report ``postvalidate`` would emit now."""
+
+    rows = record["attempt_rows"]
+    archive_paths = [row["archive_path"] for row in rows]
+    candidate_path = file["path"]
+    try:
+        return (
+            set(report) == POST_REPORT_KEYS
+            and report["schema_version"] == POST_REPORT_SCHEMA
+            and report["result"] == "passed"
+            and report["disposition_binding"] == am._content_binding(snapshot)
+            and _reviews_committed(root, report["disposition_review_bindings"])
+            and report["repository_state"]
+            == am._state_without_paths(state, {candidate_path})
+            and report["outside_status_projection_sha256"]
+            == am._canonical_digest(
+                am._outside_status_rows(
+                    state["status_projection"]["rows"], {*ignored, candidate_path}
+                )
+            )
+            and report["archive_rows"]
+            == [am._binding_from_row(row, path_field="archive_path") for row in rows]
+            and report["archive_path_count"] == len(rows)
+            and report["archive_path_set_sha256"] == am._canonical_digest(archive_paths)
+            and report["protected_path_bindings"] == record["protected_path_bindings"]
+            and report["claims_not_made"] == am.POST_CLAIMS_NOT_MADE
+            and report["normalized_report_sha256"]
+            == am._canonical_digest(report, exclude="normalized_report_sha256")
+            and file["data"] == am._canonical_json(report) + b"\n"
+            and file["lstat_mode"] == 0o644
+        )
+    except (KeyError, TypeError):
+        return False
+
+
+def _post_report_paths(
+    root: Path,
+    disposition_relative: str,
+    record: Mapping[str, Any],
+    extra_ignored: Sequence[str],
+) -> list[str]:
+    """Untracked outside paths that are valid post reports of this disposition."""
+
+    snapshot = am._read_regular(root, disposition_relative)
+    assert snapshot is not None
+    state = am._repository_state(root)
+    ignored = {
+        *(row["original_path"] for row in record["attempt_rows"]),
+        *(row["archive_path"] for row in record["attempt_rows"]),
+        *extra_ignored,
+    }
+    result: list[str] = []
+    for row in state["status_projection"]["rows"]:
+        if row["status"] != "??" or am._under(
+            row["path"], record["attempt_binding"]["source_root"]
+        ):
+            continue
+        candidate = am._read_regular(root, row["path"], missing_ok=True)
+        if candidate is None:
+            continue
+        try:
+            report = am._json_bytes(candidate["data"], row["path"])
+        except AttemptMigrationError:
+            continue
+        if _is_valid_post_report(
+            report, candidate, snapshot, record, root, state, ignored
+        ):
+            result.append(row["path"])
+    return result
+
+
+def validate_v2_extras(
+    root: Path,
+    record: Mapping[str, Any],
+    disposition_relative: str,
+    *,
+    check_outside: bool,
+) -> tuple[str, ...]:
+    """Reopen the incident and re-derive archived evidence; return ignorable paths."""
+
+    lifecycle = record["attempt_lifecycle"]
+    incident_binding = lifecycle["incident_binding"]
+    incident_path = am._relative_path(incident_binding["path"])
+    am._reject_output_overlap(
+        incident_path,
+        record["attempt_binding"]["source_root"],
+        record["attempt_binding"]["archive_root"],
+        [row["original_path"] for row in record["attempt_rows"]],
+    )
+    incident_file = am._read_regular(root, incident_path, missing_ok=True)
+    if incident_file is None or am._content_binding(incident_file) != incident_binding:
+        raise _err("incident_binding_mismatch", incident_path)
+    incident = am._json_bytes(incident_file["data"], incident_path)
+    if incident_file["data"] != am._canonical_json(incident) + b"\n":
+        raise _err("incident_not_canonical")
+
+    view = _logical_view(root, record)
+    _generation_semantics(root, record, view)
+    _validate_incident_with(root, incident, view)
+
+    if incident["pre_move_repository_state"] != record["pre_move_repository_state"]:
+        raise _err("incident_repository_state_mismatch")
+    if incident["source_root"] != record["attempt_binding"]["source_root"]:
+        raise _err("incident_source_root_mismatch")
+    for key in ("governing_plan_binding", "migration_plan_binding"):
+        if incident[key] != record[key]:
+            raise _err("incident_binding_mismatch", key)
+    if incident["expected_paths_manifest_binding"] != {
+        key: record["attempt_binding"]["expected_paths_manifest_binding"][key]
+        for key in ("path", "size", "sha256", "row_count")
+    }:
+        raise _err("incident_binding_mismatch", "expected_paths_manifest_binding")
+    rows = [
+        {
+            "path": row["original_path"],
+            "file_type": row["file_type"],
+            "lstat_mode": row["lstat_mode"],
+            "size": row["size"],
+            "sha256": row["sha256"],
+            "tracked_state": row["tracked_state"],
+        }
+        for row in record["attempt_rows"]
+    ]
+    if rows != incident["attempt_rows"]:
+        raise _err("incident_attempt_rows_mismatch")
+    artifacts = record["attempt_binding"]["artifact_bindings"]
+    for role, key in (
+        ("workspace_baseline", "workspace_baseline_binding"),
+        ("attestation_record", "owner_attestation_binding"),
+        ("attestation_snapshot", "pending_attestation_snapshot_binding"),
+    ):
+        if artifacts[role]["path"] != incident[key]["path"] or (
+            artifacts[role]["size"],
+            artifacts[role]["sha256"],
+        ) != (incident[key]["size"], incident[key]["sha256"]):
+            raise _err("incident_artifact_role_mismatch", role)
+
+    ignored = (incident_path, disposition_relative)
+    if check_outside and am._is_full_migration_post_state(root, record):
+        am._require_outside_status_projection_unchanged(
+            root,
+            record,
+            additional_ignored_paths=(
+                *ignored,
+                *_post_report_paths(root, disposition_relative, record, ignored),
+            ),
+        )
+    return ignored
+
+
+# --- capture -----------------------------------------------------------------
+
+
+def _publish_if_new(root: Path, path: str, data: bytes) -> None:
+    am._publish_exclusive(root, path, data, 0o644)
+
+
+def _outputs_untracked(root: Path, state: Mapping[str, Any], paths: Sequence[str]) -> None:
+    for path in paths:
+        if am._is_tracked(root, path):
+            raise _err("incident_output_path_tracked", path)
+        for row in state["status_projection"]["rows"]:
+            if path in (row["path"], row["source_path"]):
+                raise _err("incident_output_path_in_status", path)
+
+
+def _expected_crash_state(state: Mapping[str, Any], incident_path: str) -> dict[str, Any]:
+    rows = sorted(
+        [*state["status_projection"]["rows"],
+         {"path": incident_path, "source_path": None, "status": "??"}],
+        key=lambda row: (row["path"], row["source_path"] or "", row["status"]),
+    )
+    expected = dict(state)
+    expected["status_projection"] = {
+        "rows": rows,
+        "row_count": len(rows),
+        "normalized_rows_sha256": am._canonical_digest(rows),
+    }
+    return expected
+
+
+def _resolve_state(
+    root: Path,
+    incident_file: Mapping[str, Any] | None,
+    disposition_file: Mapping[str, Any] | None,
+    incident_path: str,
+    disposition_path: str,
+) -> tuple[dict[str, Any], dict[str, Any] | None]:
+    if incident_file is None:
+        if disposition_file is not None:
+            raise _err("disposition_without_incident", disposition_path)
+        return am._repository_state(root), None
+    if incident_file["lstat_mode"] != 0o644:
+        raise _err("incident_mode_invalid", incident_path)
+    incident = am._json_bytes(incident_file["data"], incident_path)
+    if incident_file["data"] != am._canonical_json(incident) + b"\n":
+        raise _err("incident_not_canonical")
+    state = incident.get("pre_move_repository_state")
+    if not isinstance(state, Mapping):
+        raise _err("incident_structure_invalid")
+    current = am._repository_state(root)
+    if disposition_file is None:
+        if current != _expected_crash_state(state, incident_path):
+            raise _err("incident_replay_state_changed")
+    else:
+        ignored = {incident_path, disposition_path}
+        if am._state_without_paths(current, ignored) != am._state_without_paths(
+            state, ignored
+        ):
+            raise _err("incident_replay_state_changed")
+    return dict(state), incident
+
+
+def capture_invalidated_adopted(
+    repository_root: Path | str,
+    *,
+    incident_path: Path | str,
+    disposition_path: Path | str,
+    source_root: Path | str,
+    archive_root: Path | str,
+    governing_plan_path: Path | str,
+    migration_plan_path: Path | str,
+    authority_subject_path: Path | str,
+    authority_specification_review_path: Path | str,
+    authority_quality_review_path: Path | str,
+    intended_predecessor_head: str,
+    restoration_commit: str,
+    restoration_tree: str,
+    expected_paths_manifest_path: Path | str,
+    protected_paths: Sequence[Path | str],
+    generation5_request_path: Path | str,
+    generation5_snapshot_path: Path | str,
+    generation11_request_path: Path | str,
+    generation11_snapshot_path: Path | str,
+    live_ledger_path: Path | str,
+    baseline_path: Path | str,
+    baseline_specification_review_path: Path | str,
+    baseline_quality_review_path: Path | str,
+    workspace_baseline_path: Path | str,
+    attestation_request_path: Path | str,
+    attestation_snapshot_path: Path | str,
+    attestation_record_path: Path | str,
+) -> dict[str, Any]:
+    """Publish the incident, then the v2 disposition; replay only exact outputs."""
+
+    root = am._repository_root(repository_root)
+    incident_rel = am._relative_path(incident_path, field="incident_path")
+    disposition_rel = am._relative_path(disposition_path, field="disposition_path")
+    source_prefix = am._relative_path(source_root, field="source_root")
+    archive_prefix = am._relative_path(archive_root, field="archive_root")
+    if am._under(source_prefix, archive_prefix) or am._under(archive_prefix, source_prefix):
+        raise _err("source_archive_roots_overlap")
+    for output in (incident_rel, disposition_rel):
+        am._reject_output_overlap(output, source_prefix, archive_prefix)
+    if incident_rel == disposition_rel:
+        raise _err("output_paths_collide")
+    if am._scan_regular_files(root, archive_prefix):
+        raise _err("archive_not_empty", archive_prefix)
+
+    incident_file = am._read_regular(root, incident_rel, missing_ok=True)
+    disposition_file = am._read_regular(root, disposition_rel, missing_ok=True)
+    state, _ = _resolve_state(
+        root, incident_file, disposition_file, incident_rel, disposition_rel
+    )
+    _outputs_untracked(root, state, (incident_rel, disposition_rel))
+
+    paths = {
+        "governing_plan_path": am._relative_path(governing_plan_path),
+        "migration_plan_path": am._relative_path(migration_plan_path),
+        "workspace_baseline_path": am._relative_path(workspace_baseline_path),
+        "owner_attestation_path": am._relative_path(attestation_record_path),
+        "pending_snapshot_path": am._relative_path(attestation_snapshot_path),
+        "known_failure_baseline_path": am._relative_path(baseline_path),
+        "manifest_path": am._relative_path(expected_paths_manifest_path),
+        "source_root": source_prefix,
+        "intended_predecessor_head": intended_predecessor_head,
+    }
+    incident = _derive_incident(root, _Reader(root, None), state=state, **paths)
+    incident_bytes = am._canonical_json(incident) + b"\n"
+    if incident_file is not None and incident_file["data"] != incident_bytes:
+        raise _err("incident_output_mismatch", incident_rel)
+
+    record = _derive_disposition(
+        root,
+        incident,
+        incident_bytes,
+        incident_rel=incident_rel,
+        source_prefix=source_prefix,
+        archive_prefix=archive_prefix,
+        authority_subject_path=authority_subject_path,
+        authority_specification_review_path=authority_specification_review_path,
+        authority_quality_review_path=authority_quality_review_path,
+        restoration_commit=restoration_commit,
+        restoration_tree=restoration_tree,
+        protected_paths=protected_paths,
+        generation_paths=(
+            generation5_request_path,
+            generation5_snapshot_path,
+            generation11_request_path,
+            generation11_snapshot_path,
+        ),
+        live_ledger_path=live_ledger_path,
+        role_paths={
+            "baseline": baseline_path,
+            "baseline_specification_review": baseline_specification_review_path,
+            "baseline_quality_review": baseline_quality_review_path,
+            "workspace_baseline": workspace_baseline_path,
+            "attestation_request": attestation_request_path,
+            "attestation_snapshot": attestation_snapshot_path,
+            "attestation_record": attestation_record_path,
+        },
+    )
+    disposition_bytes = am._canonical_json(record) + b"\n"
+    if disposition_file is not None:
+        if disposition_file["data"] != disposition_bytes or disposition_file["lstat_mode"] != 0o644:
+            raise _err("disposition_output_mismatch", disposition_rel)
+        am.validate(root, disposition_rel)
+        return {"incident": incident, "disposition": record}
+    if incident_file is None:
+        _publish_if_new(root, incident_rel, incident_bytes)
+    _publish_if_new(root, disposition_rel, disposition_bytes)
+    am.validate(root, disposition_rel)
+    return {"incident": incident, "disposition": record}
+
+
+def _derive_disposition(
+    root: Path,
+    incident: Mapping[str, Any],
+    incident_bytes: bytes,
+    *,
+    incident_rel: str,
+    source_prefix: str,
+    archive_prefix: str,
+    authority_subject_path: Path | str,
+    authority_specification_review_path: Path | str,
+    authority_quality_review_path: Path | str,
+    restoration_commit: str,
+    restoration_tree: str,
+    protected_paths: Sequence[Path | str],
+    generation_paths: Sequence[Path | str],
+    live_ledger_path: Path | str,
+    role_paths: Mapping[str, Path | str],
+) -> dict[str, Any]:
+    state = incident["pre_move_repository_state"]
+    governing = am._committed_binding(root, incident["governing_plan_binding"]["path"])
+    migration = am._committed_binding(root, incident["migration_plan_binding"]["path"])
+    manifest_path = incident["expected_paths_manifest_binding"]["path"]
+    manifest_file = am._require_committed_live(root, manifest_path)
+    expected_paths = am._manifest_paths(manifest_file["data"], manifest_path)
+    status_rows = state["status_projection"]["rows"]
+    am._validate_status_projection_boundaries(status_rows, source_prefix)
+    if am._status_paths(status_rows, source_prefix) != expected_paths:
+        raise _err("source_set_mismatch")
+
+    if not am._is_commit_identity(restoration_commit) or not am._is_commit_identity(
+        restoration_tree
+    ):
+        raise _err("source_identity_invalid")
+    observed_tree = am._git(root, "rev-parse", f"{restoration_commit}^{{tree}}")
+    if observed_tree.decode("ascii").strip() != restoration_tree:
+        raise _err("source_tree_mismatch")
+    if not am._git_is_ancestor(root, restoration_commit, state["head"]):
+        raise _err("source_commit_not_ancestor")
+
+    protected: list[dict[str, Any]] = []
+    for raw in protected_paths:
+        path = am._relative_path(raw, field="protected_path")
+        if path in expected_paths or am._under(path, archive_prefix):
+            raise _err("protected_path_overlaps_attempt", path)
+        snapshot = am._read_regular(root, path)
+        assert snapshot is not None
+        protected.append(am._public_binding(snapshot))
+    protected.sort(key=lambda row: row["path"])
+    if [row["path"] for row in protected] != am._outside_status_paths(
+        status_rows, source_prefix
+    ):
+        raise _err("protected_status_coverage_mismatch")
+
+    manifest_binding = am._content_binding(manifest_file)
+    manifest_binding.update(
+        {
+            "row_count": len(expected_paths),
+            "normalized_path_set_sha256": am._canonical_digest(expected_paths),
+        }
+    )
+    subject_rel = am._relative_path(authority_subject_path)
+    subject_file = am._validate_authority_subject(
+        root,
+        subject_rel,
+        governing_plan_binding=governing,
+        migration_plan_binding=migration,
+        expected_manifest_binding=manifest_binding,
+        protected_path_bindings=protected,
+    )
+    spec_file, quality_file, _, _ = am._validate_review_pair(
+        root,
+        am._relative_path(authority_specification_review_path),
+        am._relative_path(authority_quality_review_path),
+        require_committed=True,
+        expected_subject_kind="attempt_migration_authority",
+        expected_subject_path=subject_rel,
+        expected_subject_sha256=subject_file["sha256"],
+    )
+
+    rows: list[dict[str, Any]] = []
+    for original in expected_paths:
+        snapshot = am._read_regular(root, original)
+        assert snapshot is not None
+        rows.append(
+            {
+                "original_path": original,
+                "archive_path": f"{archive_prefix}/{original}",
+                "tracked_state": "modified" if am._is_tracked(root, original) else "untracked",
+                "file_type": "regular",
+                "lstat_mode": snapshot["lstat_mode"],
+                "size": snapshot["size"],
+                "sha256": snapshot["sha256"],
+            }
+        )
+    incident_rows = [
+        {
+            "path": row["original_path"],
+            **{k: row[k] for k in ("file_type", "lstat_mode", "size", "sha256", "tracked_state")},
+        }
+        for row in rows
+    ]
+    if incident_rows != incident["attempt_rows"]:
+        raise _err("incident_attempt_rows_mismatch")
+
+    live_path = am._relative_path(live_ledger_path)
+    modified = [row for row in rows if row["tracked_state"] == "modified"]
+    if len(modified) != 1 or modified[0]["original_path"] != live_path:
+        raise _err("tracked_source_set_invalid")
+
+    row_by_path = {row["original_path"]: row for row in rows}
+    resolved_roles = {role: am._relative_path(p) for role, p in role_paths.items()}
+    if any(path not in row_by_path for path in resolved_roles.values()):
+        raise _err("attempt_artifact_coordinates_invalid")
+    for role, key in (
+        ("workspace_baseline", "workspace_baseline_binding"),
+        ("attestation_record", "owner_attestation_binding"),
+        ("attestation_snapshot", "pending_attestation_snapshot_binding"),
+    ):
+        if resolved_roles[role] != incident[key]["path"]:
+            raise _err("incident_artifact_role_mismatch", role)
+    artifacts = {
+        role: am._binding_from_row(row_by_path[path], path_field="original_path")
+        for role, path in sorted(resolved_roles.items())
+    }
+    baseline_file = am._read_regular(root, resolved_roles["baseline"])
+    assert baseline_file is not None
+    am._validate_review_pair(
+        root,
+        resolved_roles["baseline_specification_review"],
+        resolved_roles["baseline_quality_review"],
+        require_committed=False,
+        expected_subject_kind="implementation_failure_baseline",
+        expected_subject_path=resolved_roles["baseline"],
+        expected_subject_sha256=baseline_file["sha256"],
+    )
+
+    g5_request_path, g5_snapshot_path, g11_request_path, g11_snapshot_path = (
+        am._relative_path(p) for p in generation_paths
+    )
+    g5_request_file = am._require_committed_live(root, g5_request_path)
+    g5_snapshot_file = am._require_committed_live(root, g5_snapshot_path)
+    if g11_request_path not in row_by_path or g11_snapshot_path not in row_by_path:
+        raise _err("generation11_coordinates_invalid")
+    committed_live = am._committed_bytes(root, live_path, revision=restoration_commit)
+    if g5_snapshot_file["data"] != committed_live:
+        raise _err("restoration_bytes_mismatch")
+    mode_text = am._git(root, "ls-tree", restoration_commit, "--", live_path).decode(
+        "ascii", "strict"
+    ).strip()
+    if not mode_text:
+        raise _err("restoration_source_missing")
+    if not am._git_regular_mode_matches_live(mode_text, g5_snapshot_file["lstat_mode"]):
+        raise _err("restoration_mode_mismatch")
+
+    attempt_binding = {
+        "source_commit": restoration_commit,
+        "source_tree": restoration_tree,
+        "source_root": source_prefix,
+        "archive_root": archive_prefix,
+        "expected_paths_manifest_binding": manifest_binding,
+        "artifact_bindings": artifacts,
+    }
+    lineage = {
+        "generation_5": {
+            "generation": 5,
+            "request_binding": am._public_binding(g5_request_file),
+            "snapshot_binding": am._public_binding(g5_snapshot_file),
+        },
+        "generation_11": {
+            "generation": 11,
+            "request_binding": am._binding_from_row(
+                row_by_path[g11_request_path], path_field="original_path"
+            ),
+            "snapshot_binding": am._binding_from_row(
+                row_by_path[g11_snapshot_path], path_field="original_path"
+            ),
+            "live_binding": am._binding_from_row(
+                row_by_path[live_path], path_field="original_path"
+            ),
+        },
+        "restoration_binding": {
+            "source_path": g5_snapshot_path,
+            "target_path": live_path,
+            "source_commit": restoration_commit,
+            "source_tree": restoration_tree,
+            "file_type": "regular",
+            "lstat_mode": g5_snapshot_file["lstat_mode"],
+            "size": g5_snapshot_file["size"],
+            "sha256": g5_snapshot_file["sha256"],
+        },
+    }
+    am._validate_semantic_coordinates(
+        rows=rows,
+        artifact_bindings=artifacts,
+        generation5=lineage["generation_5"],
+        generation11=lineage["generation_11"],
+        restoration=lineage["restoration_binding"],
+        roles=am.ARTIFACT_ROLES_V2,
+        pending_pair=False,
+    )
+
+    record: dict[str, Any] = {
+        "schema_version": am.SCHEMA_VERSION_V2,
+        "disposition": am.DISPOSITION_V2,
+        "governing_plan_binding": governing,
+        "migration_plan_binding": migration,
+        "authority_review_bindings": {
+            "specification": am._content_binding(spec_file),
+            "code_quality": am._content_binding(quality_file),
+        },
+        "attempt_binding": attempt_binding,
+        "attempt_lifecycle": {
+            "adoption_state": "owner_adopted",
+            "repository_commit_state": "uncommitted",
+            "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+            "incident_binding": {
+                "path": incident_rel,
+                "size": len(incident_bytes),
+                "sha256": "sha256:" + hashlib.sha256(incident_bytes).hexdigest(),
+            },
+            "workspace_baseline_role": "workspace_baseline",
+            "owner_attestation_role": "attestation_record",
+            "adoption_transfer": "forbidden",
+        },
+        "pre_move_repository_state": dict(state),
+        "protected_path_bindings": protected,
+        "ledger_lineage": lineage,
+        "attempt_rows": rows,
+        "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": am._canonical_digest(expected_paths),
+        "archive_path_set_sha256": am._canonical_digest([r["archive_path"] for r in rows]),
+        "normalized_row_set_sha256": am._canonical_digest(rows),
+        "normalized_disposition_sha256": "",
+        "claims_not_made": am.CLAIMS_NOT_MADE_V2,
+    }
+    record["normalized_disposition_sha256"] = am._canonical_digest(
+        record, exclude="normalized_disposition_sha256"

+"""Recovery outputs remain bound to their original logical directories."""
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+from orchestrator.retirement import safe_io
+
+
+def test_recovery_publication_is_exclusive(tmp_path: Path) -> None:
+    migration._publish_exclusive(tmp_path, "recovery/incident.json", b"{}\n", 0o644, bind_parent=True)
+    with pytest.raises(migration.AttemptMigrationError):
+        migration._publish_exclusive(tmp_path, "recovery/incident.json", b"changed\n", 0o644, bind_parent=True)
+    assert (tmp_path / "recovery/incident.json").read_bytes() == b"{}\n"
+
+
+def test_recovery_publication_rejects_relocated_parent(tmp_path: Path, monkeypatch) -> None:
+    destination = tmp_path / "recovery"
+    destination.mkdir()
+    outside = tmp_path / "elsewhere"
+    outside.mkdir()
+
+    def relocate(stage, *_args):
+        if stage == "before_parent_validation":
+            destination.rename(tmp_path / "displaced")
+            destination.symlink_to(outside, target_is_directory=True)
+
+    monkeypatch.setattr(safe_io, "_conditional_publish_boundary", relocate)
+    with pytest.raises(migration.AttemptMigrationError, match="exclusive_publication_failed"):
+        migration._publish_exclusive(tmp_path, "recovery/incident.json", b"{}\n", 0o644, bind_parent=True)
+    assert list(outside.iterdir()) == []
+    assert not (tmp_path / "displaced/incident.json").exists()

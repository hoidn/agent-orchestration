+
+
+def _recovery_repository(tmp_path):
+    root = tmp_path / "repository"
+    root.mkdir()
+    git = lambda *args: fixtures._git_output(root, *args)
+    write = lambda path, value: fixtures._write_producer_json(root, path, value)
+    candidate, ledger, bootstrap = fixtures._producer_task1_candidate_ledger_and_bootstrap(root)
+    for _ in range(2):
+        _, receipt = fixtures._advance_bound_ledger(root, ledger)
+        ledger = fixtures._ledger_binding(receipt)
+    _, receipt = fixtures._advance_bound_ledger(root, ledger, future_paths=[
+        "evidence/implementation-commits/task-01-bootstrap/specification-review.json",
+        "evidence/implementation-commits/task-01-bootstrap/quality-review.json",
+    ])
+    ledger = fixtures._ledger_binding(receipt)
+    subject, specification, quality = fixtures._producer_bootstrap_subject_and_reviews(
+        root, candidate=candidate, ledger=ledger, bootstrap=bootstrap,
+    )
+    closing = [{"path": path, "sha256": fixtures.file_sha256(root / path)} for path in sorted([
+        subject.as_posix(), specification["logical_path"], quality["logical_path"],
+    ])]
+    _, receipt = fixtures._advance_bound_ledger(root, ledger, evidence_bindings=closing)
+    generation5 = fixtures._ledger_binding(receipt)
+    git("add", "--", "evidence")
+    git("commit", "-qm", "Commit reviewed fifth generation")
+    restoration_commit = git("rev-parse", "HEAD").decode().strip()
+    restoration_tree = git("rev-parse", "HEAD^{tree}").decode().strip()
+    fixtures._bind_candidate_to_repository(root, candidate)
+    workspace = capture_workspace_baseline(root)
+    write("evidence/workspace-baseline.json", workspace)
+    ledger = generation5
+    for _ in range(6):
+        _, receipt = fixtures._advance_bound_ledger(root, ledger)
+        ledger = fixtures._ledger_binding(receipt)
+    assert ledger["generation"] == 11
+    preflight = root / "evidence/implementation-baseline/pytest-temp-root-preflight.json"
+    # Reuse the committed probe so only the live ledger becomes a tracked change.
+    preflight_bytes = preflight.read_bytes()
+    inputs = fixtures._producer_broad_builder_inputs(root, candidate, ledger)
+    preflight.write_bytes(preflight_bytes)
+    git("status", "--porcelain=v1")
+    fixtures._bind_candidate_to_repository(root, candidate)
+    outcome = broad.build_broad_outcome(**inputs)
+    write("evidence/implementation-baseline/outcome.json", outcome)
+    baseline = broad.build_broad_known_failure_baseline(
+        repository_root=root,
+        broad_outcome_path="evidence/implementation-baseline/outcome.json",
+        ownership_classifications=[
+            {"node_id": row["node_id"], "ownership_class": "queue_owned",
+             "ownership_basis": ["source.py"], "authorized_remediation_scope": ["source.py"]}
+            for row in outcome["outcomes"]["failures"]
+        ],
+    )
+    baseline_path = "evidence/implementation-baseline/known-failure-baseline.json"
+    baseline_spec = "evidence/reviews/implementation-baseline-specification.json"
+    baseline_quality = "evidence/reviews/implementation-baseline-quality.json"
+    write(baseline_path, baseline)
+    fixtures._publish_producer_review_pair(

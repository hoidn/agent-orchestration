+def derive_committed_predecessor_lineage(
+    repository_root: Path | str,
+    *,
+    baseline_head: str,
+    intended_predecessor_head: str,
+    require_uncovered_paths: bool = False,
+) -> dict[str, Any]:
+    """Bind the committed first-parent delta without granting its paths authority."""
+    root = _repository_root(repository_root)
+    baseline = _git(
+        root, "rev-parse", "--verify", "--end-of-options", f"{baseline_head}^{{commit}}"
+    ).decode("ascii").strip()
+    intended = _git(
+        root, "rev-parse", "--verify", "--end-of-options",
+        f"{intended_predecessor_head}^{{commit}}",
+    ).decode("ascii").strip()
+    _git(root, "merge-base", "--is-ancestor", baseline, intended)
+    _git(root, "rev-list", "--objects", "--missing=error", baseline, intended)
+    tree = _git(root, "rev-parse", f"{intended}^{{tree}}").decode("ascii").strip()
+    commits = _git(
+        root, "rev-list", "--first-parent", "--reverse", f"{baseline}..{intended}"
+    ).decode("ascii").splitlines()
+    rows: list[dict[str, Any]] = []
+    controlled: set[str] = set()
+    uncovered: set[str] = set()
+    previous = baseline
+    for commit in commits:
+        raw_commit = _git(root, "cat-file", "commit", commit)
+        headers, separator, message = raw_commit.partition(b"\n\n")
+        if not separator:
+            raise SourceBindingError("commit_message_separator_missing")
+        parents = [line[7:].decode("ascii") for line in headers.splitlines() if line.startswith(b"parent ")]
+        if len(parents) != 1:
+            raise SourceBindingError("predecessor_lineage_merge")
+        if parents[0] != previous:
+            raise SourceBindingError("predecessor_lineage_not_first_parent")
+        commit_tree = _git(root, "rev-parse", f"{commit}^{{tree}}").decode("ascii").strip()
+        raw_paths = _git(
+            root, "diff-tree", "--no-commit-id", "--name-only", "--no-renames",
+            "-r", "-z", parents[0], commit,
+        )
+        paths = [_decode_path(path) for path in raw_paths.split(b"\0") if path]
+        if len(paths) != len(set(paths)):
+            raise SourceBindingError("duplicate_committed_path")
+        paths.sort()
+        coordinates = None
+        markers = re.findall(
+            rb"(?m)^Retirement-(?:Control-Schema|Transaction-ID|Control-SHA256)(?=[: \t\r\n]|$)", message
+        )
+        if markers:
+            trailer = re.search(
+                rb"\n\nRetirement-Control-Schema: precommit_control\.v1\n"
+                rb"Retirement-Transaction-ID: ([0-9a-f]{64})\n"
+                rb"Retirement-Control-SHA256: ([0-9a-f]{64})\n\Z", message,
+            )
+            if trailer is None or len(markers) != 3:
+                raise SourceBindingError("commit_control_trailer_invalid")
+            coordinates = {
+                "transaction_id": trailer.group(1).decode("ascii"),
+                "normalized_control_sha256": "sha256:" + trailer.group(2).decode("ascii"),
+            }
+        (controlled if coordinates is not None else uncovered).update(paths)
+        rows.append({
+            "commit": commit, "parent": parents[0], "tree": commit_tree,
+            "raw_message_sha256": _sha256_bytes(message), "changed_paths": paths,
+            "changed_path_set_sha256": _path_list_digest(paths),
+            "control_coordinates": coordinates,
+        })
+        previous = commit
+    if previous != intended:
+        raise SourceBindingError("predecessor_lineage_not_first_parent")
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("predecessor_lineage_uncovered_paths_missing")
+    changed = sorted(controlled | uncovered)
+    result = {
+        "baseline_head": baseline, "intended_predecessor_head": intended,
+        "intended_predecessor_tree": tree, "first_parent_commits": rows,
+        "commit_count": len(rows), "changed_paths": changed,
+        "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": sorted(controlled),
+        "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": sorted(uncovered),
+        "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    result["normalized_projection_sha256"] = _canonical_sha256(result)
+    return result

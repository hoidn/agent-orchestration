+    evidence = {role: f"verification/{role}.txt" for role in migration.AUTHORITY_EVIDENCE_ROLES}
+    for path in evidence.values():
+        migration_fixtures._write(root, path, b"Verification evidence.\n")
+    binding = lambda path, full=False: migration_fixtures._file_binding(root, path, full=full)
+    manifest_binding = binding(manifest_path)
+    manifest_binding.update(row_count=len(paths), normalized_path_set_sha256=migration._canonical_digest(paths))
+    authority_subject = {
+        "schema_version": "attempt_migration_authority_subject.v1",
+        "governing_plan_binding": binding("plan.md"), "migration_plan_binding": binding("correction.md"),
+        "expected_paths_manifest_binding": manifest_binding,
+        "protected_path_bindings": [binding("source.py", full=True)],
+        "mechanism_binding": binding(mechanism, full=True), "test_binding": binding(test_path, full=True),
+        "evidence_bindings": {role: binding(path, full=True) for role, path in evidence.items()},
+        "claims_not_made": migration.AUTHORITY_SUBJECT_CLAIMS_NOT_MADE,
+    }
+    authority_subject["normalized_subject_sha256"] = migration._canonical_digest(authority_subject)
+    subject_path = f"{authority}/subject.json"
+    migration_fixtures._write(root, subject_path, migration._canonical_json(authority_subject) + b"\n")
+    for kind, name in [("specification", "specification-review"), ("code_quality", "quality-review")]:
+        migration_fixtures._write(root, f"{authority}/{name}.json", migration_fixtures._review(
+            kind, subject_path, (root / subject_path).read_bytes(), kind + "-reviewer",
+        ))
+    git("add", "--", authority, "correction.md", "implementation", "verification")
+    git("commit", "-qm", "Uncovered recovery predecessor")
+    parameters = {
+        "incident_path": "recovery/incident.json", "disposition_path": "recovery/disposition.json",
+        "source_root": "evidence", "archive_root": "archive",
+        "governing_plan_path": "plan.md", "migration_plan_path": "correction.md",
+        "authority_subject_path": subject_path,
+        "authority_specification_review_path": f"{authority}/specification-review.json",
+        "authority_quality_review_path": f"{authority}/quality-review.json",
+        "intended_predecessor_head": git("rev-parse", "HEAD").decode().strip(),
+        "restoration_commit": restoration_commit, "restoration_tree": restoration_tree,
+        "expected_paths_manifest_path": manifest_path, "protected_paths": ["source.py"],
+        "generation5_request_path": generation5["request_path"], "generation5_snapshot_path": generation5["snapshot_path"],
+        "generation11_request_path": ledger["request_path"], "generation11_snapshot_path": ledger["snapshot_path"],
+        "live_ledger_path": ledger["live_path"], "baseline_path": baseline_path,
+        "baseline_specification_review_path": baseline_spec, "baseline_quality_review_path": baseline_quality,
+        "workspace_baseline_path": "evidence/workspace-baseline.json",
+        "attestation_request_path": attestation.request_path.as_posix(),
+        "attestation_snapshot_path": attestation.snapshot_path.as_posix(),
+        "attestation_record_path": attestation.output_path.as_posix(),
+    }
+    return root, parameters
+
+
+def _commit_disposition(root, parameters, *, commit_incident=True):
+    reviews = {
+        "root": root, "disposition_path": parameters["disposition_path"],
+        "disposition_specification_review_path": "recovery/specification.json",
+        "disposition_quality_review_path": "recovery/quality.json",
+    }
+    if commit_incident:
+        fixtures._git_output(root, "add", "--", parameters["incident_path"])
+    migration_fixtures._commit_disposition_reviews(reviews)
+    return reviews["disposition_specification_review_path"], reviews["disposition_quality_review_path"]
+
+
+@pytest.mark.parametrize("commit_incident", [True, False])
+def test_adopted_capture_apply_and_postvalidate_with_real_generation_lineage(tmp_path, commit_incident):
+    root, parameters = _recovery_repository(tmp_path)
+    result = migration.capture_invalidated_adopted(root, **parameters)
+    assert result["incident"]["adoption_facts"]["adoption_state"] == "owner_adopted"
+    state = migration._repository_state(root)
+    assert migration.capture_invalidated_adopted(root, **parameters) == result
+    assert migration._repository_state(root) == state
+    command = [sys.executable, "-m", "orchestrator.retirement.attempt_migration",
+               "capture-invalidated-adopted", "--repository-root", str(root)]
+    for name, value in parameters.items():
+        if name == "protected_paths":
+            for path in value:
+                command.extend(["--protected-path", path])
+        else:
+            command.extend(["--" + name.replace("_", "-"), value])
+    cli = subprocess.run(command, capture_output=True, text=True, check=False)
+    assert cli.returncode == 0, cli.stderr
+    assert cli.stderr == ""
+    assert json.loads(cli.stdout) == result
+    disposition_path = root / parameters["disposition_path"]
+    original_disposition = disposition_path.read_bytes()
+    for defect in ("unknown_schema", "missing_lifecycle", "v1_artifact_roles"):
+        malformed = json.loads(original_disposition)
+        if defect == "unknown_schema":
+            malformed["schema_version"] = "attempt_migration_disposition.v99"
+        elif defect == "missing_lifecycle":
+            del malformed["attempt_lifecycle"]
+        else:
+            malformed["attempt_binding"]["artifact_bindings"] = {
+                role: malformed["attempt_binding"]["artifact_bindings"]["baseline"]
+                for role in migration.ARTIFACT_ROLES
+            }
+        malformed["normalized_disposition_sha256"] = migration._canonical_digest(
+            malformed, exclude="normalized_disposition_sha256"
+        )
+        disposition_path.write_bytes(migration._canonical_json(malformed) + b"\n")
+        with pytest.raises(migration.AttemptMigrationError):
+            migration.validate(root, parameters["disposition_path"])
+    disposition_path.write_bytes(original_disposition)
+    spec, quality = _commit_disposition(root, parameters, commit_incident=commit_incident)
+    disposition = parameters["disposition_path"]
+    assert migration.validate(root, disposition) == result["disposition"]
+    assert migration.apply(root, disposition, spec, quality) == result["disposition"]
+    state = migration._repository_state(root)
+    assert migration.validate(root, disposition) == result["disposition"]
+    assert migration.apply(root, disposition, spec, quality) == result["disposition"]
+    assert migration._repository_state(root) == state
+    report = migration.postvalidate(root, disposition, spec, quality, "recovery/report.json")
+    assert report["result"] == "passed"
+    assert report["disposition_binding"]["path"] == disposition
+    for row in result["disposition"]["attempt_rows"]:
+        archived = root / row["archive_path"]
+        assert migration._bytes_digest(archived.read_bytes()) == row["sha256"]
+        assert archived.stat().st_mode & 0o7777 == row["lstat_mode"]
+    assert (root / parameters["live_ledger_path"]).read_bytes() == (root / parameters["generation5_snapshot_path"]).read_bytes()
+    (root / "recovery/report.json").unlink()
+    (root / "unexpected.txt").write_text("Outside the status projection.\n")
+    with pytest.raises(migration.AttemptMigrationError, match="outside_status_projection_changed"):
+        migration.validate(root, disposition)
+    (root / "unexpected.txt").unlink()
+    prior_head = fixtures._git_output(root, "rev-parse", "HEAD").decode().strip()
+    generation5_request = root / parameters["generation5_request_path"]
+    duplicate = generation5_request.with_name("00000005-" + "f" * 64 + ".json")
+    duplicate.write_bytes(generation5_request.read_bytes())
+    fixtures._git_output(root, "add", "--", duplicate.relative_to(root).as_posix())
+    fixtures._git_output(root, "commit", "-qm", "Duplicate a committed generation slot")
+    with pytest.raises(migration.AttemptMigrationError, match="incident_known_failure_baseline_binding_invalid:.*ledger_generation_invalid"):
+        migration.validate(root, disposition)
+    fixtures._git_output(root, "reset", "--hard", prior_head)
+    archived_request = root / "archive" / parameters["generation11_request_path"]
+    archived_request.unlink()
+    with pytest.raises(migration.AttemptMigrationError, match="attempt_row_state_invalid"):
+        migration.validate(root, disposition)
+
+
+def test_adopted_capture_recovers_incident_only_publication(tmp_path):
+    root, parameters = _recovery_repository(tmp_path)
+    result = migration.capture_invalidated_adopted(root, **parameters)
+    (root / parameters["disposition_path"]).unlink()
+    assert migration.capture_invalidated_adopted(root, **parameters) == result
+    (root / parameters["disposition_path"]).unlink()
+    (root / "unexpected.txt").write_text("Uncaptured change.\n")
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(root, **parameters)
+    assert not (root / parameters["disposition_path"]).exists()
+    (root / "unexpected.txt").unlink()
+    fixtures._git_output(root, "add", "--", parameters["incident_path"])
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(root, **parameters)
+    assert not (root / parameters["disposition_path"]).exists()
+
+
+@pytest.mark.parametrize("defect", ["pending_owner", "extra_path", "missing_path"])
+def test_adopted_capture_rejects_changed_attempt_before_publication(tmp_path, defect):
+    root, parameters = _recovery_repository(tmp_path)
+    if defect == "pending_owner":
+        (root / parameters["attestation_record_path"]).write_bytes(
+            (root / parameters["attestation_snapshot_path"]).read_bytes()
+        )
+    elif defect == "extra_path":
+        (root / "evidence/unexpected.json").write_text("{}\n")
+    else:
+        (root / parameters["generation11_request_path"]).unlink()
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(root, **parameters)
+    assert not (root / parameters["incident_path"]).exists()
+    assert not (root / parameters["disposition_path"]).exists()

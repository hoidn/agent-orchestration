+from __future__ import annotations
+
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+
+
+def _adopted_incident_repository(tmp_path: Path, *, candidate_after_workspace: bool = False):
+    """Real broad evidence and owner adoption, before any controlled commit."""
+    from tests import test_retirement_broad_evidence as fixtures
+    from orchestrator.retirement import attempt_migration as migration
+    from orchestrator.retirement import broad_evidence as broad
+    from orchestrator.retirement.materialization import materialize_pending
+    from orchestrator.retirement.source_bindings import capture_workspace_baseline
+
+    root = tmp_path / "repository"
+    root.mkdir()
+    candidate, ledger = fixtures._producer_candidate_and_ledger(root)
+    source_bytes = (root / "source.py").read_bytes()
+    if candidate_after_workspace:
+        (root / "source.py").unlink()
+    workspace = capture_workspace_baseline(root)
+    if candidate_after_workspace:
+        (root / "source.py").write_bytes(source_bytes)
+    write = lambda path, value: fixtures._write_producer_json(root, path, value)
+    write("evidence/workspace-baseline.json", workspace)
+    outcome = broad.build_broad_outcome(
+        **fixtures._producer_broad_builder_inputs(root, candidate, ledger)
+    )
+    write("evidence/implementation-baseline/outcome.json", outcome)
+    baseline = broad.build_broad_known_failure_baseline(
+        repository_root=root,
+        broad_outcome_path="evidence/implementation-baseline/outcome.json",
+        ownership_classifications=[
+            {"node_id": row["node_id"], "ownership_class": "queue_owned",
+             "ownership_basis": ["source.py"], "authorized_remediation_scope": ["source.py"]}
+            for row in outcome["outcomes"]["failures"]
+        ],
+    )
+    baseline_path = "evidence/implementation-baseline/known-failure-baseline.json"
+    write(baseline_path, baseline)
+    spec, quality = fixtures._publish_producer_review_pair(
+        root, evidence_root=Path("evidence"),
+        subject_path=Path(baseline_path), subject_kind="implementation_failure_baseline",
+        specification_name="reviews/implementation-baseline-specification.json", quality_name="reviews/implementation-baseline-quality.json",
+    )
+    receipt = materialize_pending(
+        repository_root=root, evidence_root=Path("evidence"),
+        record_kind="broad-failure-baseline-attestation",
+        output_path=Path("evidence/attestations/pre-implementation/broad-failure-baseline.json"), generation=1,
+        input_paths={"baseline": Path(baseline_path),
+                     "specification_review": Path("evidence/reviews/implementation-baseline-specification.json"),
+                     "quality_review": Path("evidence/reviews/implementation-baseline-quality.json")},
+        parameters={"prepared_by": {"identity": "preparer"},
+                    "prepared_at": "2026-01-02T00:00:00+00:00"},
+    )
+    owner = broad.load_json_closed(root / receipt.output_path)
+    owner["evidence_status"] = "owner_confirmed"
+    owner["owner"] = {"identity": "owner", "role": "repository owner"}
+    owner["owner_confirmations"] = {
+        key: ("2026-01-03T00:00:00+00:00" if key == "confirmed_at" else True)
+        for key in owner["owner_confirmations"]
+    }
+    owner["owner_adoption"] = {"identity": "owner", "statement": "I adopt this evidence.",
+                                "adopted_at": "2026-01-03T00:00:00+00:00"}
+    write(receipt.output_path.as_posix(), owner)
+    assert broad.validate_record(owner) == []
+    (root / "correction.md").write_text("Recovery plan.\n")
+    (root / "outside.txt").write_text("An uncovered predecessor edit.\n")
+    fixtures._git_output(root, "add", "--", "correction.md", "outside.txt")
+    fixtures._git_output(root, "commit", "-q", "-m", "predecessor advanced")

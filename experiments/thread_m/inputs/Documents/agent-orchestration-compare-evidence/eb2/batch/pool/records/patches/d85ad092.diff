+"""Tamper rejection through real, fully archived recovery attempts."""
+
+from copy import deepcopy
+import json
+from pathlib import Path
+import shutil
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+from tests import test_retirement_broad_evidence as fixtures
+from tests.test_retirement_adopted_recovery import _recovery_repository, _commit_disposition
+
+
+@pytest.fixture(scope="module")
+def archived_template(tmp_path_factory):
+    root, parameters = _recovery_repository(tmp_path_factory.mktemp("adopted-tamper"))
+    result = migration.capture_invalidated_adopted(root, **parameters)
+    specification, quality = _commit_disposition(root, parameters)
+    migration.apply(root, parameters["disposition_path"], specification, quality)
+    return root, parameters, result
+
+
+@pytest.fixture
+def archived(archived_template, tmp_path):
+    original, parameters, result = archived_template
+    root = tmp_path / "repository"
+    shutil.copytree(original, root)
+    return root, deepcopy(parameters), deepcopy(result)
+
+
+def _expect(root, parameters, code):
+    with pytest.raises(migration.AttemptMigrationError, match=code):
+        migration.validate(root, parameters["disposition_path"])
+
+
+def _write(root, path, data):
+    absolute = root / path
+    mode = absolute.stat().st_mode & 0o7777
+    absolute.chmod(mode | 0o200)
+    absolute.write_bytes(data)
+    absolute.chmod(mode)
+
+
+def _rebind_archived_bytes(root, result, replacements):
+    """Rebind row digests and incident coordinates so semantic checks decide."""
+    disposition = result["disposition"]
+    incident = result["incident"]
+    for row in disposition["attempt_rows"]:
+        path = row["original_path"]
+        if path not in replacements:
+            continue
+        data = replacements[path]
+        _write(root, row["archive_path"], data)
+        row.update(size=len(data), sha256=migration._bytes_digest(data))
+        for incident_row in incident["attempt_rows"]:
+            if incident_row["path"] == path:
+                incident_row.update(size=row["size"], sha256=row["sha256"])
+        for generation in disposition["ledger_lineage"].values():
+            for binding in generation.values():
+                if isinstance(binding, dict) and binding.get("path") == path:
+                    binding.update(size=row["size"], sha256=row["sha256"])
+    incident["normalized_attempt_row_set_sha256"] = migration._canonical_digest(incident["attempt_rows"])
+    incident["normalized_incident_sha256"] = migration._canonical_digest(incident, exclude="normalized_incident_sha256")
+    incident_binding = disposition["attempt_lifecycle"]["incident_binding"]
+    incident_bytes = migration._canonical_json(incident) + b"\n"
+    _write(root, incident_binding["path"], incident_bytes)
+    incident_binding.update(size=len(incident_bytes), sha256=migration._bytes_digest(incident_bytes))
+    disposition["normalized_row_set_sha256"] = migration._canonical_digest(disposition["attempt_rows"])
+    disposition["normalized_disposition_sha256"] = migration._canonical_digest(disposition, exclude="normalized_disposition_sha256")
+    return disposition
+
+
+def _publish_rebound_disposition(root, parameters, disposition):
+    _write(root, parameters["disposition_path"], migration._canonical_json(disposition) + b"\n")
+
+
+def test_postarchive_rejects_new_path_outside_capture(archived):
+    root, parameters, _ = archived
+    (root / "outside-new.txt").write_text("Uncaptured file.\n")
+    _expect(root, parameters, "outside_status_projection_changed")
+
+
+@pytest.mark.parametrize("state", ["staged", "unstaged"])
+def test_postarchive_rejects_candidate_git_state_drift(archived, state):
+    root, parameters, _ = archived
+    fixtures._git_output(root, "add", "--", "source.py")
+    if state == "unstaged":
+        (root / "source.py").write_text("candidate = False\n")
+    _expect(root, parameters, "outside_status_projection_changed")
+
+
+def test_postarchive_rejects_non_descendant_head(archived):
+    root, parameters, result = archived
+    predecessor = result["disposition"]["pre_move_repository_state"]["head"]
+    fixtures._git_output(root, "update-ref", "HEAD", predecessor + "^")
+    _expect(root, parameters, "capture_head_not_ancestor")
+
+
+@pytest.mark.parametrize("role", ["request", "snapshot"])
+def test_postarchive_rejects_missing_earlier_materialization_row(archived, role):
+    root, parameters, result = archived
+    segment = "materialization-inputs" if role == "request" else "immutable-outputs"
+    row = next(row for row in result["disposition"]["attempt_rows"]
+               if segment in row["original_path"] and Path(row["original_path"]).name.startswith("00000010-"))
+    (root / row["archive_path"]).unlink()
+    _expect(root, parameters, "attempt_row_state_invalid")
+
+
+@pytest.mark.parametrize("defect,role", [
+    ("duplicate_snapshot", "generation11_snapshot"),
+    ("swap", "generation11_request"),
+    ("noncontiguous", "generation11_request"),
+    ("request_parent", "generation11_request"),
+    ("snapshot_parent", "generation11_request"),
+])
+def test_postarchive_rejects_internally_rebound_generation_coordinates(archived, defect, role):
+    root, parameters, result = archived
+    disposition = result["disposition"]
+    generation = disposition["ledger_lineage"]["generation_11"]
+    request_path = generation["request_binding"]["path"]
+    snapshot_path = generation["snapshot_binding"]["path"]
+    live_path = generation["live_binding"]["path"]
+    rows = {row["original_path"]: row for row in disposition["attempt_rows"]}
+    request_bytes = (root / rows[request_path]["archive_path"]).read_bytes()
+    snapshot_bytes = (root / rows[snapshot_path]["archive_path"]).read_bytes()
+    if defect in {"swap", "duplicate_snapshot"}:
+        replacements = {snapshot_path: request_bytes, live_path: request_bytes}
+        if defect == "swap":
+            replacements[request_path] = snapshot_bytes
+    else:
+        request = json.loads(request_bytes)
+        prior = request["prior_generation_binding"]
+        if defect == "noncontiguous":
+            prior["generation"] -= 1
+        else:
+            coordinate = "request_path" if defect == "request_parent" else "snapshot_path"
+            prior[coordinate] = "wrong-parent/" + prior[coordinate]
+        request["normalized_request_sha256"] = migration._canonical_digest(request, exclude="normalized_request_sha256")
+        replacements = {request_path: migration._canonical_json(request) + b"\n"}
+    disposition = _rebind_archived_bytes(root, result, replacements)
+    _publish_rebound_disposition(root, parameters, disposition)
+    _expect(root, parameters, "semantic_coordinate_row_binding_mismatch:" + role)
+
+
+@pytest.mark.parametrize("role", ["request", "snapshot"])
+def test_postarchive_rejects_committed_duplicate_generation_slot(archived, role):
+    root, parameters, result = archived
+    binding = result["disposition"]["ledger_lineage"]["generation_5"][role + "_binding"]
+    original = Path(binding["path"])
+    duplicate = original.with_name("00000005-" + "f" * 64 + ".json")
+    (root / duplicate).write_bytes((root / original).read_bytes())
+    fixtures._git_output(root, "add", "--", duplicate.as_posix())
+    fixtures._git_output(root, "commit", "-qm", "Add duplicate committed generation slot")
+    _expect(root, parameters, "incident_known_failure_baseline_binding_invalid:.*ledger_generation_invalid")
+
+
+def test_candidate_index_drift_is_rejected_when_porcelain_stays_modified(tmp_path):
+    from orchestrator.retirement.source_bindings import capture_workspace_baseline
+
+    fixtures._initialize_candidate_repository(tmp_path)
+    candidate = tmp_path / "source.py"
+    candidate.write_bytes(b"original\n")
+    fixtures._git_output(tmp_path, "add", "--", "source.py")
+    fixtures._git_output(tmp_path, "commit", "-qm", "Track candidate")
+    candidate.write_bytes(b"first staged value\n")
+    fixtures._git_output(tmp_path, "add", "--", "source.py")
+    candidate.write_bytes(b"working value\n")
+    workspace = capture_workspace_baseline(tmp_path)
+    state = migration._repository_state(tmp_path)
+    record = {
+        "attempt_binding": {
+            "source_root": "evidence",
+            "artifact_bindings": {"workspace_baseline": {"path": "evidence/workspace.json"}},
+        },
+        "pre_move_repository_state": state,
+    }
+    overlay = {"evidence/workspace.json": migration._canonical_json(workspace) + b"\n"}
+    migration._require_adopted_outside_index(tmp_path, record, overlay)
+    before = fixtures._git_output(tmp_path, "status", "--porcelain=v1", "--", "source.py")
+    assert before == b"MM source.py\n"
+    different_blob = migration._git(tmp_path, "hash-object", "-w", "--stdin",
+                                    input_bytes=b"other staged value\n").decode().strip()
+    fixtures._git_output(tmp_path, "update-index", "--cacheinfo",
+                         "100644," + different_blob + ",source.py")
+    assert fixtures._git_output(tmp_path, "status", "--porcelain=v1", "--", "source.py") == before
+    assert candidate.read_bytes() == b"working value\n"
+    with pytest.raises(migration.AttemptMigrationError, match="^outside_status_projection_changed$"):
+        migration._require_adopted_outside_index(tmp_path, record, overlay)
+
+
+def test_postarchive_reopens_internally_rebound_nested_broad_evidence(archived):
+    root, parameters, result = archived
+    path = "evidence/implementation-baseline/outcome.json"
+    row = next(row for row in result["disposition"]["attempt_rows"] if row["original_path"] == path)
+    outcome = json.loads((root / row["archive_path"]).read_bytes())
+    outcome["outcomes"]["totals"]["passed"] += 1
+    outcome["normalized_outcome_sha256"] = migration._canonical_digest(outcome, exclude="normalized_outcome_sha256")
+    disposition = _rebind_archived_bytes(root, result, {path: migration._canonical_json(outcome) + b"\n"})
+    _publish_rebound_disposition(root, parameters, disposition)
+    _expect(root, parameters, "incident_known_failure_baseline_binding_invalid")

+"""Behavioral predecessor evidence checks against temporary Git objects."""
+
+import hashlib
+import json
+import subprocess
+
+import pytest
+
+from orchestrator.retirement import source_bindings
+
+
+def git(root, *args, data=None):
+    return subprocess.run(
+        ["git", *args], cwd=root, input=data, check=True, capture_output=True
+    ).stdout
+
+
+@pytest.fixture
+def repository(tmp_path):
+    git(tmp_path, "init", "-q")
+    git(tmp_path, "config", "user.name", "Evidence Owner")
+    git(tmp_path, "config", "user.email", "owner@example.test")
+    commit_file(tmp_path, "initial", b"Initial\n")
+    return tmp_path
+
+
+def commit_file(root, path, message):
+    (root / path).write_text(path)
+    git(root, "add", "--", path)
+    git(root, "commit", "-q", "--cleanup=verbatim", "-F", "-", data=message)
+    return git(root, "rev-parse", "HEAD").decode().strip()
+
+
+def digest(data):
+    return "sha256:" + hashlib.sha256(data).hexdigest()
+
+
+def test_closed_projection_binds_raw_messages_paths_and_control_coordinates(repository):
+    git(repository, "config", "i18n.commitEncoding", "ISO-8859-1")
+    baseline = git(repository, "rev-parse", "HEAD").decode().strip()
+    raw_message = b"Ordinary commit\n\nraw \xff bytes\n"
+    first = commit_file(repository, "uncovered", raw_message)
+    trailer = (
+        b"Controlled commit\n\nRetirement-Control-Schema: precommit_control.v1\n"
+        + b"Retirement-Transaction-ID: " + b"a" * 64
+        + b"\nRetirement-Control-SHA256: " + b"b" * 64 + b"\n"
+    )
+    last = commit_file(repository, "controlled", trailer)
+    result = source_bindings.derive_committed_predecessor_lineage(
+        repository, baseline_head=baseline, intended_predecessor_head=last,
+        require_uncovered_paths=True,
+    )
+    assert set(result) == {
+        "baseline_head", "intended_predecessor_head", "intended_predecessor_tree",
+        "first_parent_commits", "commit_count", "changed_paths", "changed_path_count",
+        "changed_path_set_sha256", "controlled_paths", "controlled_path_set_sha256",
+        "uncovered_paths", "uncovered_path_set_sha256", "normalized_projection_sha256",
+    }
+    assert result["changed_paths"] == ["controlled", "uncovered"]
+    assert result["changed_path_count"] == 2
+    assert result["controlled_paths"] == ["controlled"]
+    assert result["uncovered_paths"] == ["uncovered"]
+    assert result["commit_count"] == 2
+    rows = result["first_parent_commits"]
+    assert rows == [
+        {"commit": first, "parent": baseline,
+         "tree": git(repository, "rev-parse", first + "^{tree}").decode().strip(),
+         "raw_message_sha256": digest(raw_message), "changed_paths": ["uncovered"],
+         "changed_path_set_sha256": digest(b"uncovered\n"), "control_coordinates": None},
+        {"commit": last, "parent": first,
+         "tree": git(repository, "rev-parse", last + "^{tree}").decode().strip(),
+         "raw_message_sha256": digest(trailer), "changed_paths": ["controlled"],
+         "changed_path_set_sha256": digest(b"controlled\n"),
+         "control_coordinates": {"transaction_id": "a" * 64,
+                                 "normalized_control_sha256": "sha256:" + "b" * 64}},
+    ]
+    assert result["changed_path_set_sha256"] == digest(b"controlled\nuncovered\n")
+    projection = {k: v for k, v in result.items() if k != "normalized_projection_sha256"}
+    assert result["normalized_projection_sha256"] == digest(
+        json.dumps(projection, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+    )
+
+
+@pytest.mark.parametrize("message", [
+    b"Malformed\n\nRetirement-Control-Schema: precommit_control.v1\n",
+    b"Malformed\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: "
+    + b"a" * 64 + b"\nRetirement-Control-SHA256: " + b"b" * 64 + b"\n",
+    b"Malformed\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: "
+    + b"a" * 64 + b"\nRetirement-Control-SHA256: " + b"b" * 64 + b"\nextra\n",
+])
+def test_malformed_trailer_is_rejected(repository, message):
+    baseline = git(repository, "rev-parse", "HEAD").decode().strip()
+    head = commit_file(repository, "changed", message)
+    with pytest.raises(source_bindings.SourceBindingError):
+        source_bindings.derive_committed_predecessor_lineage(
+            repository, baseline_head=baseline, intended_predecessor_head=head
+        )
+
+
+def test_empty_and_fully_controlled_ranges_are_ineligible(repository):
+    baseline = git(repository, "rev-parse", "HEAD").decode().strip()
+    assert source_bindings.derive_committed_predecessor_lineage(
+        repository, baseline_head=baseline, intended_predecessor_head=baseline
+    )["commit_count"] == 0
+    with pytest.raises(source_bindings.SourceBindingError):
+        source_bindings.derive_committed_predecessor_lineage(
+            repository, baseline_head=baseline, intended_predecessor_head=baseline,
+            require_uncovered_paths=True,
+        )
+    head = commit_file(repository, "controlled", b"Controlled\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: " + b"a" * 64 + b"\nRetirement-Control-SHA256: " + b"b" * 64 + b"\n")
+    with pytest.raises(source_bindings.SourceBindingError):
+        source_bindings.derive_committed_predecessor_lineage(
+            repository, baseline_head=baseline, intended_predecessor_head=head,
+            require_uncovered_paths=True,
+        )
+
+
+def test_nonancestor_missing_commit_and_merge_are_rejected(repository):
+    baseline = git(repository, "rev-parse", "HEAD").decode().strip()
+    branch = git(repository, "symbolic-ref", "--short", "HEAD").decode().strip()
+    git(repository, "checkout", "-q", "-b", "other")
+    other = commit_file(repository, "other", b"Other\n")
+    git(repository, "checkout", "-q", branch)
+    head = commit_file(repository, "main", b"Main\n")
+    for start, end in [(other, head), (baseline, "f" * 40)]:
+        with pytest.raises(source_bindings.SourceBindingError):
+            source_bindings.derive_committed_predecessor_lineage(
+                repository, baseline_head=start, intended_predecessor_head=end
+            )
+    git(repository, "merge", "-q", "--no-ff", "-m", "Merge", "other")
+    with pytest.raises(source_bindings.SourceBindingError):
+        source_bindings.derive_committed_predecessor_lineage(
+            repository, baseline_head=baseline, intended_predecessor_head="HEAD"
+        )
+
+
+def test_missing_referenced_object_is_rejected(repository):
+    baseline = git(repository, "rev-parse", "HEAD").decode().strip()
+    head = commit_file(repository, "changed", b"Changed\n")
+    blob = git(repository, "rev-parse", "HEAD:changed").decode().strip()
+    (repository / ".git" / "objects" / blob[:2] / blob[2:]).unlink()
+    with pytest.raises(source_bindings.SourceBindingError):
+        source_bindings.derive_committed_predecessor_lineage(
+            repository, baseline_head=baseline, intended_predecessor_head=head
+        )
+
+
+def test_duplicate_changed_path_projection_is_rejected(repository, monkeypatch):
+    baseline = git(repository, "rev-parse", "HEAD").decode().strip()
+    head = commit_file(repository, "changed", b"Changed\n")
+    real_git = source_bindings._git
+
+    def duplicate_projection(root, *args, **kwargs):
+        result = real_git(root, *args, **kwargs)
+        return result + result if args[0] == "diff-tree" else result
+
+    monkeypatch.setattr(source_bindings, "_git", duplicate_projection)
+    with pytest.raises(source_bindings.SourceBindingError):
+        source_bindings.derive_committed_predecessor_lineage(
+            repository, baseline_head=baseline, intended_predecessor_head=head
+        )

+from pathlib import Path
+import subprocess
+
+import pytest
+
+from orchestrator.retirement import broad_evidence as evidence
+from orchestrator.retirement.materialization import validate_generation
+from tests.test_retirement_broad_evidence import (
+    _three_generation_ledger_chain,
+    _write_review_subject,
+    _write_live_review,
+)
+
+
+def _git(root, *args):
+    return subprocess.run(["git", "-C", str(root), *args], check=True,
+                          stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout
+
+
+def test_generation_replays_all_ancestors_from_overlay(tmp_path):
+    _, receipts = _three_generation_ledger_chain(tmp_path)
+    overlay = {p.relative_to(tmp_path).as_posix(): p.read_bytes()
+               for p in tmp_path.rglob("*") if p.is_file()}
+    for relative in overlay:
+        (tmp_path / relative).unlink()
+    last = receipts[-1]
+    assert validate_generation(tmp_path, last.request_path, last.snapshot_path,
+                               bound_file_bytes=overlay) == []
+    first = receipts[0]
+    overlay[first.request_path.as_posix()] = overlay[first.snapshot_path.as_posix()]
+    issues = validate_generation(tmp_path, last.request_path, last.snapshot_path,
+                                 bound_file_bytes=overlay)
+    assert any(i.code == "prior_generation_invalid" and
+               i.message == "prior_generation_changed" for i in issues)
+
+
+@pytest.mark.parametrize("role", ["request", "snapshot"])
+def test_overlay_duplicate_generation_slots_are_rejected(tmp_path, role):
+    _, receipts = _three_generation_ledger_chain(tmp_path)
+    last = receipts[-1]
+    path = getattr(last, f"{role}_path")
+    duplicate = path.with_name("00000003-" + "f" * 64 + ".json")
+    overlay = {duplicate.as_posix(): (tmp_path / path).read_bytes()}
+    issues = validate_generation(tmp_path, last.request_path, last.snapshot_path,
+                                 bound_file_bytes=overlay)
+    assert f"generation_{role}_slot_extra" in {i.code for i in issues}
+
+
+def test_review_overlay_and_committed_fallback(tmp_path):
+    subject = Path("evidence/failure-remediation.json")
+    live = Path("evidence/remediation-specification-review.json")
+    _write_review_subject(tmp_path, subject)
+    _write_live_review(tmp_path, subject_path=subject, review_path=live)
+    binding = evidence.publish_immutable_review(repository_root=tmp_path,
+        evidence_root=Path("evidence"), subject_path=subject, review_path=live)
+    immutable = tmp_path / binding["immutable_path"]
+    original = immutable.read_bytes()
+    immutable.chmod(0o644)
+    immutable.write_bytes(b"broken")
+    assert evidence.validate_bound_record(binding, tmp_path,
+        bound_file_bytes={binding["immutable_path"]: original}) == []
+    _git(tmp_path, "init")
+    _git(tmp_path, "-c", "user.name=Tests", "-c", "user.email=tests@example.test",
+         "commit", "--allow-empty", "-m", "initial")
+    immutable.write_bytes(original)
+    assert "review_binding_immutable_unreadable" in {i.code for i in
+        evidence.validate_bound_record(binding, tmp_path, bound_file_bytes={},
+                                        require_committed_fallback=True)}
+    _git(tmp_path, "add", ".")
+    _git(tmp_path, "-c", "user.name=Tests", "-c", "user.email=tests@example.test",
+         "commit", "-m", "evidence")
+    assert evidence.validate_bound_record(binding, tmp_path,
+        bound_file_bytes={}, require_committed_fallback=True) == []
+
+
+def test_completed_ledger_reopens_closing_reviews_from_overlay(tmp_path):
+    from tests.test_retirement_broad_evidence import (
+        _producer_task1_candidate_ledger_and_bootstrap,
+        _advance_bound_ledger, _ledger_binding,
+        _producer_bootstrap_subject_and_reviews,
+    )
+    candidate, binding, bootstrap = _producer_task1_candidate_ledger_and_bootstrap(tmp_path)
+    for _ in range(2):
+        _, receipt = _advance_bound_ledger(tmp_path, binding)
+        binding = _ledger_binding(receipt)
+    _, receipt = _advance_bound_ledger(tmp_path, binding, future_paths=[
+        "evidence/implementation-commits/task-01-bootstrap/specification-review.json",
+        "evidence/implementation-commits/task-01-bootstrap/quality-review.json",
+    ])
+    binding = _ledger_binding(receipt)
+    subject, specification, quality = _producer_bootstrap_subject_and_reviews(
+        tmp_path, candidate=candidate, ledger=binding, bootstrap=bootstrap)
+    closing = [subject, Path(specification["logical_path"]), Path(quality["logical_path"])]
+    _, completed = _advance_bound_ledger(tmp_path, binding, evidence_bindings=[
+        {"path": path.as_posix(), "sha256": evidence.file_sha256(tmp_path / path)}
+        for path in sorted(closing)])
+    overlay = {path.relative_to(tmp_path).as_posix(): path.read_bytes()
+               for path in (tmp_path / "evidence").rglob("*") if path.is_file()}
+    for relative in overlay:
+        path = tmp_path / relative
+        path.chmod(0o644)
+        path.unlink()
+    assert validate_generation(tmp_path, completed.request_path, completed.snapshot_path,
+                               bound_file_bytes=overlay) == []
+    review = closing[-1].as_posix()
+    overlay[review] = b"broken"
+    assert "ledger_completion_review_pair_invalid" in {i.code for i in
+        validate_generation(tmp_path, completed.request_path, completed.snapshot_path,
+                            bound_file_bytes=overlay)}
+
+
+@pytest.mark.parametrize("defect,expected", [
+    ("request_parent", "request_path_mismatch"),
+    ("snapshot_parent", "snapshot_path_mismatch"),
+    ("noncontiguous", "request_prior_generation_invalid"),
+])
+def test_overlay_checks_ancestor_coordinates(tmp_path, defect, expected):
+    import json
+    from orchestrator.retirement import materialization
+    _, receipts = _three_generation_ledger_chain(tmp_path)
+    first, second, _ = receipts
+    overlay = {p.relative_to(tmp_path).as_posix(): p.read_bytes()
+               for p in tmp_path.rglob("*") if p.is_file()}
+    for relative in overlay:
+        (tmp_path / relative).unlink()
+    request = json.loads(overlay.pop(second.request_path.as_posix()))
+    prior = request["prior_generation_binding"]
+    if defect == "noncontiguous":
+        prior["generation"] = 0
+    else:
+        role = "request" if defect == "request_parent" else "snapshot"
+        original = getattr(first, f"{role}_path")
+        relocated = Path("other") / original
+        prior[f"{role}_path"] = relocated.as_posix()
+        overlay[relocated.as_posix()] = overlay.pop(original.as_posix())
+    request["normalized_request_sha256"] = evidence.canonical_sha256(
+        request, exclude={"normalized_request_sha256"})
+    path = materialization._request_path(Path("evidence"), second.output_path,
+        second.generation, request["normalized_request_sha256"])
+    overlay[path.as_posix()] = materialization._json_output(request)
+    issues = validate_generation(tmp_path, path, second.snapshot_path,
+                                 bound_file_bytes=overlay)
+    assert expected in {i.code for i in issues}
+
+
+def test_strict_fallback_capture_rejects_change_after_head_comparison(tmp_path, monkeypatch):
+    from orchestrator.retirement import materialization
+    from tests import test_retirement_broad_evidence as fixtures
+
+    fixtures._initialize_candidate_repository(tmp_path)
+    path = tmp_path / "bound.txt"
+    path.write_bytes(b"committed bytes\n")
+    fixtures._git_output(tmp_path, "add", "bound.txt")
+    fixtures._git_output(tmp_path, "commit", "-qm", "Bind fallback file")
+    original = materialization.capture_regular_file_at
+
+    def replace_before_capture(*args, **kwargs):
+        path.write_bytes(b"changed after HEAD comparison\n")
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(materialization, "capture_regular_file_at", replace_before_capture)
+    token = evidence._BOUND_FILE_VIEW.set((tmp_path.resolve(), {}, True))
+    try:
+        with pytest.raises(materialization.MaterializationError, match="publication_path_unreadable"):
+            materialization._capture_bound_relative_regular(tmp_path, Path("bound.txt"))
+    finally:
+        evidence._BOUND_FILE_VIEW.reset(token)

+++ b/orchestrator/retirement/attempt_incident.py
@@ -0,0 +1,340 @@
+"""Content-addressed evidence of an adopted attempt with an invalid predecessor."""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+SCHEMA_VERSION = "attempt_migration_incident.v1"
+CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+BINDING_NAMES = (
+    "governing_plan", "migration_plan", "workspace_baseline", "owner_attestation",
+    "pending_attestation_snapshot", "known_failure_baseline", "expected_paths_manifest",
+)
+TOP_LEVEL_KEYS = {
+    "schema_version", *(name + "_binding" for name in BINDING_NAMES),
+    "source_root", "intended_predecessor", "predecessor_projection",
+    "pre_move_repository_state", "attempt_rows", "attempt_path_count",
+    "attempt_path_set_sha256", "normalized_attempt_row_set_sha256",
+    "adoption_facts", "normalized_incident_sha256", "claims_not_made",
+}
+ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+
+
+def _adoption_facts(owner: Mapping[str, Any]) -> dict[str, Any]:
+    from . import attempt_migration as migration
+    from .broad_evidence import validate_record
+
+    identity = owner.get("owner")
+    confirmations = owner.get("owner_confirmations")
+    adoption = owner.get("owner_adoption")
+    if (
+        owner.get("evidence_status") != "owner_confirmed"
+        or not isinstance(identity, Mapping)
+        or not isinstance(confirmations, Mapping)
+        or not isinstance(adoption, Mapping)
+        or adoption.get("identity") != identity.get("identity")
+        or validate_record(owner)
+    ):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    return {
+        "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed", "owner_identity": identity["identity"],
+        "owner_role": identity["role"], "confirmed_at": confirmations["confirmed_at"],
+        "adopted_at": adoption["adopted_at"],
+    }
+
+
+def _validate_repository_state(root: Path, state: Any, source_root: str) -> None:
+    from . import attempt_migration as migration
+
+    migration._require_keys(state, {"head", "tree", "index_sha256", "status_projection"}, "incident_repository_state_invalid")
+    if (not migration._is_commit_identity(state["head"])
+        or not migration._is_commit_identity(state["tree"])
+        or not migration._is_sha256(state["index_sha256"])):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    projection = migration._require_keys(
+        state["status_projection"], {"rows", "row_count", "normalized_rows_sha256"},
+        "incident_repository_state_invalid",
+    )
+    rows = projection["rows"]
+    if (not isinstance(rows, list) or type(projection["row_count"]) is not int
+        or projection["row_count"] != len(rows)
+        or projection["normalized_rows_sha256"] != migration._canonical_digest(rows)):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    for row in rows:
+        migration._require_keys(row, {"path", "source_path", "status"}, "incident_repository_state_invalid")
+        migration._relative_path(row["path"])
+        if row["source_path"] is not None:
+            migration._relative_path(row["source_path"])
+        if (not isinstance(row["status"], str)
+            or migration.GIT_STATUS_RE.fullmatch(row["status"]) is None
+            or row["status"] == "  "):
+            raise migration.AttemptMigrationError("incident_repository_state_invalid")
+        is_rename = row["status"][0] in "RC" or row["status"][1] in "RC"
+        if is_rename != (row["source_path"] is not None):
+            raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    identities = [(row["path"], row["source_path"], row["status"]) for row in rows]
+    if len(identities) != len(set(identities)):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    migration._validate_status_projection_boundaries(rows, source_root)
+    if rows != sorted(rows, key=lambda row: (row["path"], row["source_path"] or "", row["status"])):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    actual_tree = migration._git(root, "rev-parse", state["head"] + "^{tree}").decode("ascii").strip()
+    if actual_tree != state["tree"]:
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    head = migration._git(root, "rev-parse", "HEAD").decode("ascii").strip()
+    if not migration._git_is_ancestor(root, state["head"], head):
+        raise migration.AttemptMigrationError("capture_head_not_ancestor")
+
+
+def build_attempt_migration_incident(
+    repository_root: Path | str, *, governing_plan_path: Path | str,
+    migration_plan_path: Path | str, workspace_baseline_path: Path | str,
+    owner_attestation_path: Path | str, pending_attestation_snapshot_path: Path | str,
+    known_failure_baseline_path: Path | str, expected_paths_manifest_path: Path | str,
+    source_root: Path | str, intended_predecessor_head: str,
+) -> dict[str, Any]:
+    from . import attempt_migration as migration
+    from .source_bindings import derive_committed_predecessor_lineage, SourceBindingError
+
+    root = migration._repository_root(repository_root)
+    prefix = migration._relative_path(source_root)
+    paths = {
+        "governing_plan": governing_plan_path, "migration_plan": migration_plan_path,
+        "workspace_baseline": workspace_baseline_path, "owner_attestation": owner_attestation_path,
+        "pending_attestation_snapshot": pending_attestation_snapshot_path,
+        "known_failure_baseline": known_failure_baseline_path,
+        "expected_paths_manifest": expected_paths_manifest_path,
+    }
+    files = {name: migration._read_regular(root, path) for name, path in paths.items()}
+    owner = migration._json_bytes(files["owner_attestation"]["data"], str(owner_attestation_path))
+    facts = _adoption_facts(owner)
+    workspace = migration._json_bytes(files["workspace_baseline"]["data"], str(workspace_baseline_path))
+    state = migration._repository_state(root)
+    if (not migration._is_commit_identity(intended_predecessor_head)
+        or not migration._git_is_ancestor(root, intended_predecessor_head, state["head"])):
+        raise migration.AttemptMigrationError("incident_intended_predecessor_invalid")
+    try:
+        projection = derive_committed_predecessor_lineage(
+            root, baseline_head=workspace.get("head"), intended_predecessor_head=intended_predecessor_head,
+            require_uncovered_paths=True,
+        )
+    except SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_invalid", str(exc)) from exc
+    manifest = migration._manifest_paths(files["expected_paths_manifest"]["data"], str(expected_paths_manifest_path))
+    observed = migration._status_paths(state["status_projection"]["rows"], prefix)
+    migration._validate_status_projection_boundaries(state["status_projection"]["rows"], prefix)
+    if manifest != observed or any(not migration._under(path, prefix) for path in manifest):
+        raise migration.AttemptMigrationError("source_set_mismatch")
+    rows = []
+    for path in manifest:
+        snapshot = migration._read_regular(root, path)
+        rows.append({**migration._public_binding(snapshot),
+                     "tracked_state": "modified" if migration._is_tracked(root, path) else "untracked"})
+    bindings = {name + "_binding": migration._content_binding(snapshot) for name, snapshot in files.items()}
+    bindings["expected_paths_manifest_binding"]["row_count"] = len(manifest)
+    record = {
+        "schema_version": SCHEMA_VERSION, **bindings, "source_root": prefix,
+        "intended_predecessor": {"head": intended_predecessor_head, "tree": projection["intended_predecessor_tree"]},
+        "predecessor_projection": projection, "pre_move_repository_state": state,
+        "attempt_rows": rows, "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": migration._canonical_digest(manifest),
+        "normalized_attempt_row_set_sha256": migration._canonical_digest(rows),
+        "adoption_facts": facts, "claims_not_made": CLAIMS_NOT_MADE,
+    }
+    record["normalized_incident_sha256"] = migration._canonical_digest(record)
+    return validate_attempt_migration_incident(root, record)
+
+
+def _validate_attempt_migration_incident(
+    repository_root: Path | str, record: Any, *,
+    bound_file_bytes: Mapping[str, bytes] | None = None,
+    require_committed_fallback: bool = False,
+    attempt_rows: Sequence[Mapping[str, Any]] | None = None,
+) -> dict[str, Any]:
+    """Reopen an incident, optionally through already mode-verified archival rows."""
+    from . import attempt_migration as migration
+    from . import broad_evidence as broad
+    from .source_bindings import derive_committed_predecessor_lineage, SourceBindingError, validate_workspace_record_shape
+
+    root = migration._repository_root(repository_root)
+    migration._require_keys(record, TOP_LEVEL_KEYS, "incident_keys_mismatch")
+    if record["schema_version"] != SCHEMA_VERSION or record["claims_not_made"] != CLAIMS_NOT_MADE:
+        raise migration.AttemptMigrationError("incident_schema_invalid")
+    if record["normalized_incident_sha256"] != migration._canonical_digest(record, exclude="normalized_incident_sha256"):
+        raise migration.AttemptMigrationError("incident_normalized_digest_mismatch")
+    prefix = migration._relative_path(record["source_root"])
+
+    def read(path: str) -> bytes:
+        if bound_file_bytes is not None and path in bound_file_bytes:
+            data = bound_file_bytes[path]
+            if not isinstance(data, bytes):
+                raise migration.AttemptMigrationError("attempt_row_state_invalid", path)
+            return data
+        snapshot = (migration._require_committed_live(root, path) if require_committed_fallback
+                    else migration._read_regular(root, path))
+        return snapshot["data"]
+
+    files = {}
+    for name in BINDING_NAMES:
+        code = "incident_" + name + "_binding_invalid"
+        binding = record[name + "_binding"]
+        try:
+            keys = {"path", "size", "sha256"} | ({"row_count"} if name == "expected_paths_manifest" else set())
+            migration._require_keys(binding, keys, code)
+            migration._validate_file_binding({key: binding[key] for key in ("path", "size", "sha256")}, full=False)
+            data = read(binding["path"])
+            if len(data) != binding["size"] or migration._bytes_digest(data) != binding["sha256"]:
+                raise migration.AttemptMigrationError(code)
+            files[name] = data
+        except (migration.AttemptMigrationError, OSError, TypeError, ValueError) as exc:
+            raise migration.AttemptMigrationError(code) from exc
+
+    def document(name: str) -> dict[str, Any]:
+        try:
+            return migration._json_bytes(files[name], record[name + "_binding"]["path"])
+        except migration.AttemptMigrationError as exc:
+            raise migration.AttemptMigrationError("incident_" + name + "_binding_invalid") from exc
+
+    owner = document("owner_attestation")
+    if migration._canonical_json(record["adoption_facts"]) != migration._canonical_json(_adoption_facts(owner)):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    pending = document("pending_attestation_snapshot")
+    if pending.get("evidence_status") != "pending_owner_confirmation" or broad.validate_record(pending):
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid")
+    # Owner confirmation changes only the lifecycle fields of the immutable pending form.
+    lifecycle = {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+    if migration._canonical_json({key: value for key, value in owner.items() if key not in lifecycle}) != migration._canonical_json({key: value for key, value in pending.items() if key not in lifecycle}):
+        raise migration.AttemptMigrationError("incident_owner_attestation_binding_invalid")
+    baseline = document("known_failure_baseline")
+    baseline_issues = broad.validate_record(baseline)
+    if baseline.get("schema_version") != "broad_known_failure_baseline.v1" or baseline_issues:
+        codes = sorted({issue.code for issue in baseline_issues} or {"schema_version_mismatch"})
+        raise migration.AttemptMigrationError("incident_known_failure_baseline_binding_invalid", ",".join(codes))
+    workspace = document("workspace_baseline")
+    if validate_workspace_record_shape(workspace):
+        raise migration.AttemptMigrationError("incident_workspace_baseline_binding_invalid")
+    _validate_repository_state(root, record["pre_move_repository_state"], prefix)
+    ambient = None
+    if attempt_rows is None:
+        current_status = migration._repository_state(root)["status_projection"]["rows"]
+        manifest_paths = migration._manifest_paths(files["expected_paths_manifest"], record["expected_paths_manifest_binding"]["path"])
+        if set(migration._status_paths(current_status, prefix)) - set(manifest_paths):
+            raise migration.AttemptMigrationError("attempt_row_state_invalid")
+        ambient = set(migration._outside_status_paths(record["pre_move_repository_state"]["status_projection"]["rows"], prefix))
+        for row in migration._repository_state(root)["status_projection"]["rows"]:
+            if row["status"] != "??" or row["path"] in ambient or migration._under(row["path"], prefix):
+                continue
+            output = migration._read_regular(root, row["path"])
+            if output["lstat_mode"] != 0o644:
+                continue
+            if output["data"] == migration._canonical_json(record) + b"\n":
+                ambient.add(row["path"])
+                continue
+            try:
+                disposition = migration._json_bytes(output["data"], row["path"])
+            except migration.AttemptMigrationError:
+                continue
+            lifecycle_binding = disposition.get("attempt_lifecycle", {})
+            incident_binding = lifecycle_binding.get("incident_binding", {}) if isinstance(lifecycle_binding, Mapping) else {}
+            if not isinstance(incident_binding, Mapping):
+                continue
+            if (disposition.get("schema_version") == "attempt_migration_disposition.v2"
+                and incident_binding.get("sha256") == migration._bytes_digest(migration._canonical_json(record) + b"\n")
+                and migration._canonical_json(disposition.get("pre_move_repository_state")) == migration._canonical_json(record["pre_move_repository_state"])
+                and disposition.get("normalized_disposition_sha256") == migration._canonical_digest(disposition, exclude="normalized_disposition_sha256")
+                and output["data"] == migration._canonical_json(disposition) + b"\n"):
+                ambient.add(row["path"])
+    with broad._historical_candidate_view(root, workspace, permitted_ambient_paths=ambient):
+        for name, value in (("known_failure_baseline", baseline), ("owner_attestation", owner), ("pending_attestation_snapshot", pending)):
+            options = {"bound_file_bytes": bound_file_bytes}
+            if require_committed_fallback:
+                options["require_committed_fallback"] = True
+            issues = broad.validate_bound_record(value, root, **options)
+            codes = sorted({issue.code for issue in issues})
+            if codes:
+                raise migration.AttemptMigrationError("incident_" + name + "_binding_invalid", ",".join(codes))
+    baseline_binding = owner.get("baseline_binding", {})
+    expected_baseline = record["known_failure_baseline_binding"]
+    if baseline_binding.get("path") != expected_baseline["path"] or baseline_binding.get("sha256") != expected_baseline["sha256"]:
+        raise migration.AttemptMigrationError("incident_owner_attestation_binding_invalid")
+    intended = migration._require_keys(record["intended_predecessor"], {"head", "tree"}, "incident_intended_predecessor_invalid")
+    if (not migration._is_commit_identity(intended["head"])
+        or not migration._is_commit_identity(intended["tree"])
+        or not migration._git_is_ancestor(root, intended["head"], record["pre_move_repository_state"]["head"])):
+        raise migration.AttemptMigrationError("incident_intended_predecessor_invalid")
+    try:
+        projection = derive_committed_predecessor_lineage(root, baseline_head=workspace["head"], intended_predecessor_head=intended["head"], require_uncovered_paths=True)
+    except SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_invalid", str(exc)) from exc
+    if migration._canonical_json(record["predecessor_projection"]) != migration._canonical_json(projection) or intended["tree"] != projection["intended_predecessor_tree"]:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_invalid")
+    rows = record["attempt_rows"]
+    if not isinstance(rows, list) or not rows:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    row_coordinates = ({row["original_path"]: row for row in attempt_rows} if attempt_rows is not None else None)
+    for row in rows:
+        migration._require_keys(row, ROW_KEYS, "attempt_row_state_invalid")
+        migration._validate_file_binding({key: row[key] for key in ROW_KEYS - {"tracked_state"}})
+        path = row["path"]
+        if not migration._under(path, prefix) or not isinstance(row["tracked_state"], str) or row["tracked_state"] not in {"modified", "untracked"}:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid", path)
+        if row_coordinates is not None:
+            archived = row_coordinates.get(path)
+            if archived is None or migration._canonical_json(row) != migration._canonical_json({**migration._binding_from_row(archived, path_field="original_path"), "tracked_state": archived["tracked_state"]}):
+                raise migration.AttemptMigrationError("attempt_row_state_invalid", path)
+            data = read(path)
+            if len(data) != row["size"] or migration._bytes_digest(data) != row["sha256"]:
+                raise migration.AttemptMigrationError("attempt_row_state_invalid", path)
+        else:
+            snapshot = migration._read_regular(root, path, missing_ok=True)
+            if (snapshot is None or migration._public_binding(snapshot) != {key: row[key] for key in ROW_KEYS - {"tracked_state"}}
+                or migration._is_tracked(root, path) != (row["tracked_state"] == "modified")):
+                raise migration.AttemptMigrationError("attempt_row_state_invalid", path)
+    paths = [row["path"] for row in rows]
+    manifest = migration._manifest_paths(files["expected_paths_manifest"], record["expected_paths_manifest_binding"]["path"])
+    if (paths != sorted(set(paths)) or paths != manifest
+        or type(record["attempt_path_count"]) is not int or record["attempt_path_count"] != len(rows)
+        or type(record["expected_paths_manifest_binding"]["row_count"]) is not int
+        or record["expected_paths_manifest_binding"]["row_count"] != len(rows)
+        or record["attempt_path_set_sha256"] != migration._canonical_digest(paths)
+        or record["normalized_attempt_row_set_sha256"] != migration._canonical_digest(rows)
+        or migration._status_paths(record["pre_move_repository_state"]["status_projection"]["rows"], prefix) != paths):
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    if attempt_rows is None:
+        current_rows = migration._repository_state(root)["status_projection"]["rows"]
+        migration._validate_status_projection_boundaries(current_rows, prefix)
+        if migration._status_paths(current_rows, prefix) != paths:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    owner_path = record["owner_attestation_binding"]["path"]
+    try:
+        committed_owner = migration._committed_bytes(root, owner_path, revision=record["pre_move_repository_state"]["head"])
+    except migration.AttemptMigrationError as exc:
+        if exc.code != "git_command_failed":
+            raise
+    else:
+        if committed_owner == files["owner_attestation"]:
+            raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    return record
+
+
+def validate_attempt_migration_incident(
+    repository_root: Path | str, record: Any, *,
+    bound_file_bytes: Mapping[str, bytes] | None = None,
+    require_committed_fallback: bool = False,
+    attempt_rows: Sequence[Mapping[str, Any]] | None = None,
+) -> dict[str, Any]:
+    """Validate a closed incident and report malformed JSON values consistently."""
+    from .attempt_migration import AttemptMigrationError
+
+    try:
+        return _validate_attempt_migration_incident(
+            repository_root, record, bound_file_bytes=bound_file_bytes,
+            require_committed_fallback=require_committed_fallback, attempt_rows=attempt_rows,
+        )
+    except AttemptMigrationError:
+        raise
+    except (KeyError, TypeError, ValueError, AttributeError) as exc:
+        raise AttemptMigrationError("incident_structure_invalid") from exc

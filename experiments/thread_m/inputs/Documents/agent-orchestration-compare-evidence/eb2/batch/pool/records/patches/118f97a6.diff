+    ]
+    _, receipt = be._advance_bound_ledger(root, binding, evidence_bindings=closing)
+    gen5 = be._ledger_binding(receipt)
+    predecessor = _commit(root, "task one state", "evidence")
+    restoration_tree = _git(root, "rev-parse", "HEAD^{tree}")

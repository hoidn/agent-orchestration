+def _authorize(root: Path, facts: dict[str, Any]) -> dict[str, Any]:
+    """Commit the migration authority over the exact attempt path set."""
+
+    expected = sorted(p for p in _status_paths(root) if p.startswith("evidence/"))
+    _write(root, "plans/governing.md", b"governing plan\n")
+    _write(root, "plans/correction.md", b"corrective plan\n")
+    _write(root, "authority/expected-paths.txt", ("\n".join(expected) + "\n").encode())
+    _write(root, "implementation/mechanism.py", b"generic mechanism\n")
+    _write(root, "implementation/test_mechanism.py", b"generic tests\n")
+    evidence = {
+        "candidate_manifest": "verification/candidate-manifest.json",
+        "exact_diff": "verification/exact.diff",
+        "focused_test_evidence": "verification/focused.txt",
+        "broad_test_evidence": "verification/broad.txt",
+    }
+    for path in evidence.values():
+        _write(root, path, f"evidence {path}\n".encode())
+    manifest = _binding(root, "authority/expected-paths.txt")
+    manifest.update(
+        row_count=len(expected), normalized_path_set_sha256=_digest(_canonical(expected))
+    )
+    subject = {
+        "schema_version": "attempt_migration_authority_subject.v1",
+        "governing_plan_binding": _binding(root, "plans/governing.md"),
+        "migration_plan_binding": _binding(root, "plans/correction.md"),
+        "expected_paths_manifest_binding": manifest,
+        "protected_path_bindings": [_binding(root, "source.py", full=True)],
+        "mechanism_binding": _binding(root, "implementation/mechanism.py", full=True),
+        "test_binding": _binding(root, "implementation/test_mechanism.py", full=True),
+        "evidence_bindings": {
+            role: _binding(root, path, full=True) for role, path in evidence.items()
+        },
+        "normalized_subject_sha256": "",
+        "claims_not_made": am.AUTHORITY_SUBJECT_CLAIMS_NOT_MADE,
+    }
+    subject["normalized_subject_sha256"] = _digest(
+        _canonical({k: v for k, v in subject.items() if k != "normalized_subject_sha256"})
+    )
+    data = _canonical(subject) + b"\n"
+    _write(root, "authority/subject.json", data)
+    for kind, name in (("specification", "spec"), ("code_quality", "quality")):
+        _write(
+            root,
+            f"authority/{name}-review.json",
+            _review_bytes(kind, "attempt_migration_authority", "authority/subject.json", data),

+def _rebind_archived(attempt: dict[str, Any], original: str, data: bytes) -> None:
+    """Replace one archived file and rebind every digest that names it."""
+
+    root, path = attempt["root"], attempt["arguments"]["disposition_path"]
+    record = json.loads((root / path).read_text())
+    row = next(r for r in record["attempt_rows"] if r["original_path"] == original)
+    archive = root / row["archive_path"]
+    archive.unlink()
+    archive.write_bytes(data)
+    archive.chmod(row["lstat_mode"])
+    new = {"size": len(data), "sha256": _digest(data)}
+    row.update(new)
+    stack = [record["attempt_binding"]["artifact_bindings"], record["ledger_lineage"]]
+    while stack:
+        value = stack.pop()
+        if isinstance(value, dict):
+            if value.get("path") == original:
+                value.update(new)
+            if value.get("target_path") == original:
+                value.update(new)
+            stack.extend(value.values())
+    _rewrite_disposition(root, path, record)
+

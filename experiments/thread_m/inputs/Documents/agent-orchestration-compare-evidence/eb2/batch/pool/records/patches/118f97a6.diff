new file mode 100644
index 0000000..6f9664d
--- /dev/null
+++ b/orchestrator/retirement/attempt_migration_incident.py
@@ -0,0 +1,544 @@
+"""Incident record ``attempt_migration_incident.v1``.
+
+Binds an owner-adopted attempt that never reached its controlled commit to the
+committed predecessor lineage that invalidated it.  Everything is derived from
+files and Git objects; ``attempt_migration_adopted`` builds the v2 disposition
+on top of it.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from . import attempt_migration as am
+from .attempt_migration import AttemptMigrationError
+from .broad_evidence import (
+    Issue,
+    committed_regular_bytes,
+    validate_bound_record,
+    validate_record,
+)
+from .source_bindings import (
+    SourceBindingError,
+    derive_committed_predecessor_lineage,
+    validate_workspace_record_shape,
+)
+
+
+INCIDENT_SCHEMA = "attempt_migration_incident.v1"
+DISPOSITION_SCHEMA = "attempt_migration_disposition.v2"
+DISPOSITION_VALUE = (
+    "archive_invalidated_owner_adopted_uncommitted_attempt_and_restore_tracked_files"
+)
+INCIDENT_BINDING_NAMES = (
+    "governing_plan",
+    "migration_plan",
+    "workspace_baseline",
+    "owner_attestation",
+    "pending_attestation_snapshot",
+    "known_failure_baseline",
+    "expected_paths_manifest",
+)
+# Bindings that name attempt files (rows) rather than committed authority files.
+_ATTEMPT_BINDING_NAMES = frozenset(
+    {
+        "workspace_baseline",
+        "owner_attestation",
+        "pending_attestation_snapshot",
+        "known_failure_baseline",
+    }
+)
+INCIDENT_KEYS = {
+    "schema_version",
+    *(f"{name}_binding" for name in INCIDENT_BINDING_NAMES),
+    "source_root",
+    "intended_predecessor",
+    "predecessor_projection",
+    "pre_move_repository_state",
+    "attempt_rows",
+    "attempt_path_count",
+    "attempt_path_set_sha256",
+    "normalized_attempt_row_set_sha256",
+    "adoption_facts",
+    "normalized_incident_sha256",
+    "claims_not_made",
+}
+INCIDENT_CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+INCIDENT_ROW_KEYS = {
+    "path",
+    "file_type",
+    "lstat_mode",
+    "size",
+    "sha256",
+    "tracked_state",
+}
+ADOPTION_FACT_KEYS = {
+    "adoption_state",
+    "repository_commit_state",
+    "evidence_status",
+    "owner_identity",
+    "owner_role",
+    "confirmed_at",
+    "adopted_at",
+}
+INCIDENT_CONTENT_KEYS = {"path", "size", "sha256"}
+
+
+def _fail(code: str, detail: str = "") -> AttemptMigrationError:
+    return AttemptMigrationError(code, detail)
+
+
+def _attempt_row(snapshot: Mapping[str, Any], tracked: bool) -> dict[str, Any]:
+    return {
+        "path": snapshot["path"],
+        "file_type": "regular",
+        "lstat_mode": snapshot["lstat_mode"],
+        "size": snapshot["size"],
+        "sha256": snapshot["sha256"],
+        "tracked_state": "modified" if tracked else "untracked",
+    }
+
+
+def _parse_json(data: bytes, path: str, code: str) -> dict[str, Any]:
+    try:
+        return am._json_bytes(data, path)
+    except AttemptMigrationError as exc:
+        raise _fail(code, exc.code) from exc
+
+
+def _owner_adoption_facts(attestation: Mapping[str, Any]) -> dict[str, Any]:
+    """Derive adoption facts from an owner-confirmed attestation, or fail closed."""
+
+    code = "incident_owner_lifecycle_invalid"
+    issues = validate_record(attestation)
+    if issues:
+        raise _fail(code, issues[0].code)
+    if attestation.get("schema_version") != "broad_failure_baseline_attestation.v1":
+        raise _fail(code, "schema")
+    if attestation.get("evidence_status") != "owner_confirmed":
+        raise _fail(code, "evidence_status")
+    owner = attestation.get("owner")
+    confirmations = attestation.get("owner_confirmations")
+    adoption = attestation.get("owner_adoption")
+    if (
+        not isinstance(owner, Mapping)
+        or not isinstance(confirmations, Mapping)
+        or not isinstance(adoption, Mapping)
+        or adoption.get("identity") != owner.get("identity")
+    ):
+        raise _fail(code, "owner_fields")
+    return {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed",
+        "owner_identity": owner["identity"],
+        "owner_role": owner["role"],
+        "confirmed_at": confirmations["confirmed_at"],
+        "adopted_at": adoption["adopted_at"],
+    }
+
+
+def _known_failure_baseline_check(
+    root: Path, data: bytes, path: str, row_bytes: Mapping[str, bytes]
+) -> dict[str, Any]:
+    """Reopen the baseline with the broad-evidence validators.
+
+    Only historical candidate drift (HEAD moved, candidate set no longer the
+    live status set) is tolerated; any other issue code is reported verbatim.
+    """
+
+    prefix = "incident_known_failure_baseline_binding_invalid"
+    try:
+        baseline = json.loads(data.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise _fail(prefix, "json_invalid") from exc
+    if not isinstance(baseline, dict):
+        raise _fail(prefix, "json_root_invalid")
+    issues = list(validate_record(baseline))
+    if not issues:
+        if baseline.get("schema_version") != "broad_known_failure_baseline.v1":
+            issues = [Issue("schema_version_mismatch")]
+        else:
+            issues = validate_bound_record(
+                baseline,
+                root,
+                bound_file_bytes=dict(row_bytes),
+                require_committed_fallback=True,
+                tolerate_historical_candidate_drift=True,
+            )
+    if issues:
+        raise _fail(prefix, ",".join(sorted({issue.code for issue in issues})))
+    return baseline
+
+
+def _validate_content_binding(value: Any, name: str, keys: set[str]) -> dict[str, Any]:
+    code = f"incident_{name}_binding_invalid"
+    if not isinstance(value, Mapping) or set(value) != keys:
+        raise _fail(code, "keys")
+    try:
+        am._validate_file_binding(
+            {key: value[key] for key in ("path", "size", "sha256")}, full=False
+        )
+    except AttemptMigrationError as exc:
+        raise _fail(code, exc.code) from exc
+    return dict(value)
+
+
+def _read_bound(
+    root: Path, path: str, row_bytes: Mapping[str, bytes], name: str
+) -> bytes:
+    """Attempt rows come from the logical view; other paths must be committed."""
+
+    code = f"incident_{name}_binding_invalid"
+    if name in _ATTEMPT_BINDING_NAMES:
+        if path not in row_bytes:
+            raise _fail(code, "not_an_attempt_row")
+        return row_bytes[path]
+    if path in row_bytes:
+        raise _fail(code, "attempt_row_alias")
+    data = committed_regular_bytes(root, path)
+    if data is None:
+        raise _fail(code, "not_committed_at_head")
+    return data
+
+
+def _validate_incident_rows(
+    record: Mapping[str, Any], row_bytes: Mapping[str, bytes]
+) -> list[str]:
+    rows = record["attempt_rows"]
+    if not isinstance(rows, list) or not rows:
+        raise _fail("incident_attempt_rows_invalid")
+    source_root = am._relative_path(record["source_root"])
+    for row in rows:
+        if not isinstance(row, Mapping) or set(row) != INCIDENT_ROW_KEYS:
+            raise _fail("incident_attempt_row_keys_mismatch")
+        am._validate_file_binding(
+            {key: row[key] for key in ("path", "file_type", "lstat_mode", "size", "sha256")}
+        )
+        if row["tracked_state"] not in {"modified", "untracked"}:
+            raise _fail("incident_attempt_row_tracked_state_invalid")
+    paths = [row["path"] for row in rows]
+    if paths != sorted(paths) or len(paths) != len(set(paths)):
+        raise _fail("incident_attempt_row_order_invalid")
+    if any(not am._under(path, source_root) for path in paths):
+        raise _fail("incident_attempt_row_outside_source_root")
+    if sum(row["tracked_state"] == "modified" for row in rows) != 1:
+        raise _fail("tracked_source_set_invalid")
+    if (
+        type(record["attempt_path_count"]) is not int
+        or record["attempt_path_count"] != len(rows)
+        or record["attempt_path_set_sha256"] != am._canonical_digest(paths)
+        or record["normalized_attempt_row_set_sha256"] != am._canonical_digest(rows)
+    ):
+        raise _fail("incident_attempt_row_digest_mismatch")
+    return paths
+
+
+def _check_row_bytes(record: Mapping[str, Any], row_bytes: Mapping[str, bytes]) -> None:
+    for row in record["attempt_rows"]:
+        data = row_bytes.get(row["path"])
+        if (
+            data is None
+            or len(data) != row["size"]
+            or am._bytes_digest(data) != row["sha256"]
+        ):
+            raise _fail("attempt_row_state_invalid", row["path"])
+
+
+def _validate_incident_lineage(root: Path, record: Mapping[str, Any]) -> None:
+    predecessor = record["intended_predecessor"]
+    if not isinstance(predecessor, Mapping) or set(predecessor) != {"head", "tree"}:
+        raise _fail("incident_intended_predecessor_invalid")
+    projection = record["predecessor_projection"]
+    if not isinstance(projection, Mapping):
+        raise _fail("incident_predecessor_projection_invalid")
+    try:
+        derived = derive_committed_predecessor_lineage(
+            root,
+            baseline_head=projection.get("baseline_head"),
+            intended_predecessor_head=predecessor["head"],
+            require_uncovered_paths=True,
+        )
+    except SourceBindingError as exc:
+        raise _fail("incident_predecessor_projection_invalid", str(exc)) from exc
+    if derived != projection or derived["intended_predecessor_tree"] != predecessor["tree"]:
+        raise _fail("incident_predecessor_projection_invalid", "recomputed_mismatch")
+    state = record["pre_move_repository_state"]
+    if not am._git_is_ancestor(root, predecessor["head"], state["head"]):
+        raise _fail("incident_predecessor_not_ancestor")
+
+
+def _validate_incident(
+    root: Path, record: Any, row_bytes: Mapping[str, bytes]
+) -> dict[str, Any]:
+    """Reopen every binding and recompute every digest of an incident record."""
+
+    if not isinstance(record, Mapping) or set(record) != INCIDENT_KEYS:
+        raise _fail("incident_keys_mismatch")
+    if record["schema_version"] != INCIDENT_SCHEMA:
+        raise _fail("incident_schema_invalid")
+    if record["claims_not_made"] != INCIDENT_CLAIMS_NOT_MADE:
+        raise _fail("incident_claims_invalid")
+    if record["normalized_incident_sha256"] != am._canonical_digest(
+        record, exclude="normalized_incident_sha256"
+    ):
+        raise _fail("incident_normalized_digest_mismatch")
+    try:
+        am._relative_path(record["source_root"], field="source_root")
+        paths = _validate_incident_rows(record, row_bytes)
+    except (KeyError, TypeError) as exc:
+        raise _fail("incident_structure_invalid") from exc
+
+    contents: dict[str, bytes] = {}
+    for name in INCIDENT_BINDING_NAMES:
+        keys = set(INCIDENT_CONTENT_KEYS)
+        if name == "expected_paths_manifest":
+            keys.add("row_count")
+        binding = _validate_content_binding(record[f"{name}_binding"], name, keys)
+        data = _read_bound(root, binding["path"], row_bytes, name)
+        if len(data) != binding["size"] or am._bytes_digest(data) != binding["sha256"]:
+            raise _fail(f"incident_{name}_binding_invalid", "bytes_changed")
+        contents[name] = data
+    _check_row_bytes(record, row_bytes)
+    manifest = record["expected_paths_manifest_binding"]
+    try:
+        manifest_paths = am._manifest_paths(
+            contents["expected_paths_manifest"], manifest["path"]
+        )
+    except AttemptMigrationError as exc:
+        raise _fail("incident_expected_paths_manifest_binding_invalid", exc.code) from exc
+    if (
+        manifest_paths != paths
+        or type(manifest["row_count"]) is not int
+        or manifest["row_count"] != len(paths)
+    ):
+        raise _fail("incident_expected_paths_manifest_binding_invalid", "rows")
+
+    attestation = _parse_json(
+        contents["owner_attestation"],
+        record["owner_attestation_binding"]["path"],
+        "incident_owner_lifecycle_invalid",
+    )
+    facts = _owner_adoption_facts(attestation)
+    if record["adoption_facts"] != facts or set(record["adoption_facts"]) != ADOPTION_FACT_KEYS:
+        raise _fail("incident_adoption_facts_mismatch")
+    snapshot = _parse_json(
+        contents["pending_attestation_snapshot"],
+        record["pending_attestation_snapshot_binding"]["path"],
+        "incident_pending_attestation_snapshot_binding_invalid",
+    )
+    mutable = {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+    if (
+        validate_record(snapshot)
+        or snapshot.get("evidence_status") != "pending_owner_confirmation"
+        or {k: v for k, v in snapshot.items() if k not in mutable}
+        != {k: v for k, v in attestation.items() if k not in mutable}
+    ):
+        raise _fail("incident_pending_attestation_snapshot_binding_invalid", "lifecycle")
+    baseline_binding = record["known_failure_baseline_binding"]
+    if attestation["baseline_binding"].get("path") != baseline_binding["path"] or attestation[
+        "baseline_binding"
+    ].get("sha256") != baseline_binding["sha256"]:
+        raise _fail("incident_owner_attestation_binding_invalid", "baseline_mismatch")
+
+    workspace = _parse_json(
+        contents["workspace_baseline"],
+        record["workspace_baseline_binding"]["path"],
+        "incident_workspace_baseline_binding_invalid",
+    )
+    if validate_workspace_record_shape(workspace):
+        raise _fail("incident_workspace_baseline_binding_invalid", "shape")
+    if workspace["head"] != record["predecessor_projection"].get("baseline_head"):
+        raise _fail("incident_workspace_baseline_binding_invalid", "head_mismatch")
+
+    state = record["pre_move_repository_state"]
+    if not isinstance(state, Mapping):
+        raise _fail("incident_repository_state_invalid")
+    am._validate_repository_state_structure(
+        state, record["source_root"], paths, None
+    )
+    _validate_incident_lineage(root, record)
+    capture_tree = am._git(root, "rev-parse", f"{state['head']}^{{tree}}").decode().strip()
+    if capture_tree != state["tree"]:
+        raise _fail("capture_head_tree_mismatch")
+    current_head = am._git(root, "rev-parse", "HEAD").decode("ascii").strip()
+    if not am._git_is_ancestor(root, state["head"], current_head):
+        raise _fail("capture_head_not_ancestor")
+
+    _known_failure_baseline_check(
+        root,
+        contents["known_failure_baseline"],
+        baseline_binding["path"],
+        row_bytes,
+    )
+    return dict(record)
+
+
+def _live_row_bytes(root: Path, rows: Any) -> dict[str, bytes]:
+    """Live bytes of the attempt rows; digests are checked against bindings later."""
+
+    result: dict[str, bytes] = {}
+    for row in rows if isinstance(rows, list) else []:
+        try:
+            path = am._relative_path(row["path"])
+        except (KeyError, TypeError) as exc:
+            raise _fail("incident_attempt_row_keys_mismatch") from exc
+        snapshot = am._read_regular(root, path, missing_ok=True)
+        if snapshot is None:
+            raise _fail("attempt_row_state_invalid", path)
+        result[path] = snapshot["data"]
+    return result
+
+
+def validate_attempt_migration_incident(
+    repository_root: Path | str, record: Any
+) -> dict[str, Any]:
+    """Return ``record`` unchanged when every binding and digest reopens."""
+
+    root = am._repository_root(repository_root)
+    if not isinstance(record, Mapping):
+        raise _fail("incident_keys_mismatch")
+    _validate_incident(root, record, _live_row_bytes(root, record.get("attempt_rows")))
+    return record  # type: ignore[return-value]
+
+
+def _derive_incident(
+    root: Path,
+    *,
+    governing_plan_path: str,
+    migration_plan_path: str,
+    workspace_baseline_path: str,
+    owner_attestation_path: str,
+    pending_attestation_snapshot_path: str,
+    known_failure_baseline_path: str,
+    expected_paths_manifest_path: str,
+    source_prefix: str,
+    intended_predecessor_head: str,
+    exclude_status_paths: Sequence[str] = (),
+) -> dict[str, Any]:
+    governing = am._committed_binding(root, governing_plan_path)
+    migration = am._committed_binding(root, migration_plan_path)
+    manifest_file = am._require_committed_live(root, expected_paths_manifest_path)
+    expected = am._manifest_paths(manifest_file["data"], expected_paths_manifest_path)
+    if any(not am._under(path, source_prefix) for path in expected):
+        raise _fail("expected_path_outside_source_root")
+    state = am._state_without_paths(am._repository_state(root), set(exclude_status_paths))
+    rows_status = state["status_projection"]["rows"]
+    am._validate_status_projection_boundaries(rows_status, source_prefix)
+    observed = am._status_paths(rows_status, source_prefix)
+    if observed != expected:
+        raise _fail(
+            "source_set_mismatch",
+            am._canonical_json({"expected": expected, "observed": observed}).decode(),
+        )
+    if not am._is_commit_identity(intended_predecessor_head):
+        raise _fail("source_identity_invalid")
+
+    attempt_rows: list[dict[str, Any]] = []
+    snapshots: dict[str, dict[str, Any]] = {}
+    for path in expected:
+        snapshot = am._read_regular(root, path)
+        assert snapshot is not None
+        snapshots[path] = snapshot
+        attempt_rows.append(_attempt_row(snapshot, am._is_tracked(root, path)))
+
+    bound_paths = {
+        "workspace_baseline": workspace_baseline_path,
+        "owner_attestation": owner_attestation_path,
+        "pending_attestation_snapshot": pending_attestation_snapshot_path,
+        "known_failure_baseline": known_failure_baseline_path,
+    }
+    if any(path not in snapshots for path in bound_paths.values()):
+        raise _fail("attempt_artifact_coordinates_invalid")
+    if len(set(bound_paths.values())) != len(bound_paths):
+        raise _fail("semantic_coordinate_alias")
+    workspace = _parse_json(
+        snapshots[workspace_baseline_path]["data"],
+        workspace_baseline_path,
+        "incident_workspace_baseline_binding_invalid",
+    )
+    if validate_workspace_record_shape(workspace) or not am._is_commit_identity(
+        workspace.get("head")
+    ):
+        raise _fail("incident_workspace_baseline_binding_invalid", "shape")
+    try:
+        projection = derive_committed_predecessor_lineage(
+            root,
+            baseline_head=workspace["head"],
+            intended_predecessor_head=intended_predecessor_head,
+            require_uncovered_paths=True,
+        )
+    except SourceBindingError as exc:
+        raise _fail("incident_predecessor_projection_invalid", str(exc)) from exc
+    attestation = _parse_json(
+        snapshots[owner_attestation_path]["data"],
+        owner_attestation_path,
+        "incident_owner_lifecycle_invalid",
+    )
+    record: dict[str, Any] = {
+        "schema_version": INCIDENT_SCHEMA,
+        "governing_plan_binding": governing,
+        "migration_plan_binding": migration,
+        "expected_paths_manifest_binding": {
+            **am._content_binding(manifest_file),
+            "row_count": len(expected),
+        },
+        "source_root": source_prefix,
+        "intended_predecessor": {
+            "head": intended_predecessor_head,
+            "tree": projection["intended_predecessor_tree"],
+        },
+        "predecessor_projection": projection,
+        "pre_move_repository_state": state,
+        "attempt_rows": attempt_rows,
+        "attempt_path_count": len(attempt_rows),
+        "attempt_path_set_sha256": am._canonical_digest(expected),
+        "normalized_attempt_row_set_sha256": am._canonical_digest(attempt_rows),
+        "adoption_facts": _owner_adoption_facts(attestation),
+        "normalized_incident_sha256": "",
+        "claims_not_made": list(INCIDENT_CLAIMS_NOT_MADE),
+    }
+    for name, path in bound_paths.items():
+        record[f"{name}_binding"] = am._content_binding(snapshots[path])
+    record["normalized_incident_sha256"] = am._canonical_digest(
+        record, exclude="normalized_incident_sha256"
+    )
+    _validate_incident(root, record, {p: s["data"] for p, s in snapshots.items()})
+    return record
+
+
+def build_attempt_migration_incident(
+    repository_root: Path | str,
+    *,
+    governing_plan_path: Path | str,
+    migration_plan_path: Path | str,
+    workspace_baseline_path: Path | str,
+    owner_attestation_path: Path | str,
+    pending_attestation_snapshot_path: Path | str,
+    known_failure_baseline_path: Path | str,
+    expected_paths_manifest_path: Path | str,
+    source_root: Path | str,
+    intended_predecessor_head: str,
+) -> dict[str, Any]:
+    """Build the incident record for the current repository state (no writes)."""
+
+    root = am._repository_root(repository_root)
+    rel = am._relative_path
+    return _derive_incident(
+        root,
+        governing_plan_path=rel(governing_plan_path),
+        migration_plan_path=rel(migration_plan_path),
+        workspace_baseline_path=rel(workspace_baseline_path),
+        owner_attestation_path=rel(owner_attestation_path),
+        pending_attestation_snapshot_path=rel(pending_attestation_snapshot_path),
+        known_failure_baseline_path=rel(known_failure_baseline_path),
+        expected_paths_manifest_path=rel(expected_paths_manifest_path),
+        source_prefix=rel(source_root, field="source_root"),
+        intended_predecessor_head=intended_predecessor_head,
+    )
+
+
diff --git a/orchestrator/retirement/broad_evidence.py b/orchestrator/retirement/broad_evidence.py
index 810478f..b32bce6 100644

+def _rewrite_disposition(root: Path, path: str, record: dict[str, Any]) -> None:
+    record["normalized_row_set_sha256"] = am._canonical_digest(record["attempt_rows"])
+    record["normalized_disposition_sha256"] = am._canonical_digest(
+        record, exclude="normalized_disposition_sha256"
+    )
+    _write(root, path, _canonical(record) + b"\n")

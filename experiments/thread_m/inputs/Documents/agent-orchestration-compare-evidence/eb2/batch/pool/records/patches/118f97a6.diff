+    be._bind_candidate_to_repository(root, candidate)
+
+    environment = {"LC_ALL": "C.UTF-8", "PYTHONHASHSEED": "0", "PYTEST_DEBUG_TEMPROOT": None}
+    empty = broad_evidence.canonical_sha256([])
+    outcome = broad_evidence.build_broad_outcome(

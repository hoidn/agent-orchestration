@@ -0,0 +1,326 @@
+"""Committed predecessor lineage projection and byte overlays for validators."""
+
+from __future__ import annotations
+
+import hashlib
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import materialization
+from orchestrator.retirement.source_bindings import (
+    SourceBindingError,
+    derive_committed_predecessor_lineage,
+)
+from tests import test_retirement_broad_evidence as be
+
+TRAILER = (
+    "\n\nRetirement-Control-Schema: precommit_control.v1\n"
+    "Retirement-Transaction-ID: {txn}\n"
+    "Retirement-Control-SHA256: {sha}\n"
+)
+
+
+def _git(root: Path, *arguments: str) -> str:
+    return subprocess.run(
+        ["git", *arguments], cwd=root, check=True, capture_output=True, text=True
+    ).stdout.strip()
+
+
+def _repository(tmp_path: Path) -> Path:
+    root = tmp_path / "repo"
+    root.mkdir()
+    _git(root, "init", "-q")
+    _git(root, "config", "user.email", "t@example.invalid")
+    _git(root, "config", "user.name", "t")
+    return root
+
+
+def _commit(root: Path, name: str, message: str) -> str:
+    (root / name).write_text(name)
+    _git(root, "add", "--", name)
+    _git(root, "commit", "-q", "-m", message)
+    return _git(root, "rev-parse", "HEAD")
+
+
+def _sha(data: bytes) -> str:
+    return "sha256:" + hashlib.sha256(data).hexdigest()
+
+
+def test_lineage_projects_covered_and_uncovered_first_parent_commits(
+    tmp_path: Path,
+) -> None:
+    root = _repository(tmp_path)
+    base = _commit(root, "a.txt", "base")
+    trailer = TRAILER.format(txn="1" * 64, sha="2" * 64)
+    covered = _commit(root, "b.txt", "controlled" + trailer)
+    head = _commit(root, "c.txt", "plain")
+
+    lineage = derive_committed_predecessor_lineage(
+        root, baseline_head=base, intended_predecessor_head=head
+    )
+
+    assert [row["commit"] for row in lineage["first_parent_commits"]] == [covered, head]
+    assert lineage["controlled_paths"] == ["b.txt"]
+    assert lineage["uncovered_paths"] == ["c.txt"]
+    assert lineage["changed_paths"] == ["b.txt", "c.txt"]
+    assert lineage["commit_count"] == 2
+    assert lineage["first_parent_commits"][0]["control_coordinates"] == {
+        "transaction_id": "1" * 64,
+        "normalized_control_sha256": "sha256:" + "2" * 64,
+    }
+    assert lineage["first_parent_commits"][1]["control_coordinates"] is None
+    assert lineage["changed_path_set_sha256"] == _sha(b"b.txt\nc.txt\n")
+    body = {k: v for k, v in lineage.items() if k != "normalized_projection_sha256"}
+    from orchestrator.retirement.source_bindings import _canonical_sha256
+
+    assert lineage["normalized_projection_sha256"] == _canonical_sha256(body)
+
+
+def test_lineage_requires_an_uncovered_path_when_asked(tmp_path: Path) -> None:
+    root = _repository(tmp_path)
+    base = _commit(root, "a.txt", "base")
+    head = _commit(root, "b.txt", "controlled" + TRAILER.format(txn="1" * 64, sha="2" * 64))
+
+    assert derive_committed_predecessor_lineage(
+        root, baseline_head=base, intended_predecessor_head=head
+    )["uncovered_paths"] == []
+    with pytest.raises(SourceBindingError):
+        derive_committed_predecessor_lineage(
+            root,
+            baseline_head=base,
+            intended_predecessor_head=head,
+            require_uncovered_paths=True,
+        )
+
+
+def test_lineage_rejects_non_ancestor_merge_missing_and_malformed_trailer(
+    tmp_path: Path,
+) -> None:
+    root = _repository(tmp_path)
+    base = _commit(root, "a.txt", "base")
+    _git(root, "checkout", "-q", "-b", "side")
+    side = _commit(root, "side.txt", "side")
+    _git(root, "checkout", "-q", "-")
+    main = _commit(root, "main.txt", "main")
+    with pytest.raises(SourceBindingError):
+        derive_committed_predecessor_lineage(
+            root, baseline_head=side, intended_predecessor_head=main
+        )
+    with pytest.raises(SourceBindingError):
+        derive_committed_predecessor_lineage(
+            root, baseline_head=base, intended_predecessor_head="f" * 40
+        )
+    _git(root, "merge", "-q", "--no-ff", "-m", "merge", "side")
+    merged = _git(root, "rev-parse", "HEAD")
+    with pytest.raises(SourceBindingError):
+        derive_committed_predecessor_lineage(
+            root, baseline_head=base, intended_predecessor_head=merged
+        )
+    malformed = _commit(
+        root, "m.txt", "bad\n\nRetirement-Control-Schema: precommit_control.v1\n"
+    )
+    with pytest.raises(SourceBindingError):
+        derive_committed_predecessor_lineage(
+            root, baseline_head=merged, intended_predecessor_head=malformed
+        )
+
+
+def _chain(repository: Path):
+    _, record, first = be._materialize_first_ledger(repository)
+    record, second = be._materialize_next_ledger(repository, record, first)
+    record, third = be._materialize_next_ledger(repository, record, second)
+    return (first, second, third)
+
+
+def _bytes(repository: Path, *paths: Path) -> dict[str, bytes]:
+    return {p.as_posix(): (repository / p).read_bytes() for p in paths}
+
+
+def test_generation_overlay_replaces_a_relocated_lineage(tmp_path: Path) -> None:
+    repository = tmp_path / "repo"
+    repository.mkdir()
+    first, second, third = _chain(repository)
+    overlay = _bytes(
+        repository,
+        first.request_path, first.snapshot_path,
+        second.request_path, second.snapshot_path,
+        third.request_path, third.snapshot_path,
+    )
+    (repository / "relocated").mkdir()
+    for index, relative in enumerate(overlay):
+        (repository / relative).rename(repository / "relocated" / f"{index}.json")
+
+    assert (
+        materialization.validate_generation(
+            repository, third.request_path, third.snapshot_path, bound_file_bytes=overlay
+        )
+        == []
+    )
+    assert materialization.validate_generation(
+        repository, third.request_path, third.snapshot_path
+    )
+
+
+def test_generation_overlay_applies_lineage_checks_to_overlay_bytes(
+    tmp_path: Path,
+) -> None:
+    repository = tmp_path / "repo"
+    repository.mkdir()
+    first, second, third = _chain(repository)
+    live = _bytes(
+        repository,
+        first.request_path, first.snapshot_path,
+        second.request_path, second.snapshot_path,
+        third.request_path, third.snapshot_path,
+    )
+
+    missing = dict(live)
+    del missing[first.request_path.as_posix()]
+    (repository / first.request_path).rename(repository / "relocated-first.json")
+    issues = materialization.validate_generation(
+        repository, third.request_path, third.snapshot_path, bound_file_bytes=missing
+    )
+    assert any(
+        issue.code == "prior_generation_invalid" and issue.message == "prior_generation_changed"
+        for issue in issues
+    )
+    (repository / "relocated-first.json").rename(repository / first.request_path)
+
+    swapped = dict(live)
+    swapped[second.request_path.as_posix()], swapped[second.snapshot_path.as_posix()] = (
+        live[second.snapshot_path.as_posix()],
+        live[second.request_path.as_posix()],
+    )
+    assert materialization.validate_generation(
+        repository, third.request_path, third.snapshot_path, bound_file_bytes=swapped
+    )
+
+    duplicate = dict(live)
+    slot = third.request_path.with_name("00000003-" + "d" * 64 + ".json")
+    duplicate[slot.as_posix()] = b"{}\n"
+    assert "generation_request_slot_extra" in {
+        issue.code
+        for issue in materialization.validate_generation(
+            repository,
+            third.request_path,
+            third.snapshot_path,
+            bound_file_bytes=duplicate,
+        )
+    }
+
+
+def test_committed_fallback_reads_only_unmodified_head_files(tmp_path: Path) -> None:
+    repository = tmp_path / "repo"
+    repository.mkdir()
+    be._initialize_candidate_repository(repository)
+    first, second, third = _chain(repository)
+    overlay = _bytes(repository, third.request_path, third.snapshot_path)
+
+    uncommitted = materialization.validate_generation(
+        repository,
+        third.request_path,
+        third.snapshot_path,
+        bound_file_bytes=overlay,
+        require_committed_fallback=True,
+    )
+    assert uncommitted
+
+    _git(repository, "add", "--", "evidence", "plan.md")
+    _git(repository, "commit", "-q", "-m", "evidence")
+    assert (
+        materialization.validate_generation(
+            repository,
+            third.request_path,
+            third.snapshot_path,
+            bound_file_bytes=overlay,
+            require_committed_fallback=True,
+        )
+        == []
+    )
+
+
+def _closed_task_one(repository: Path):
+    candidate, binding, bootstrap = be._producer_task1_candidate_ledger_and_bootstrap(
+        repository
+    )
+    for _ in range(2):
+        _, receipt = be._advance_bound_ledger(repository, binding)
+        binding = be._ledger_binding(receipt)
+    reserved = [
+        "evidence/implementation-commits/task-01-bootstrap/specification-review.json",
+        "evidence/implementation-commits/task-01-bootstrap/quality-review.json",
+    ]
+    _, receipt = be._advance_bound_ledger(repository, binding, future_paths=reserved)
+    binding = be._ledger_binding(receipt)
+    subject, specification, quality = be._producer_bootstrap_subject_and_reviews(
+        repository, candidate=candidate, ledger=binding, bootstrap=bootstrap
+    )
+    evidence = [
+        {"path": p.as_posix(), "sha256": "sha256:" + hashlib.sha256((repository / p).read_bytes()).hexdigest()}
+        for p in sorted(
+            [subject, Path(specification["logical_path"]), Path(quality["logical_path"])]
+        )
+    ]
+    _, receipt = be._advance_bound_ledger(repository, binding, evidence_bindings=evidence)
+    return be._ledger_binding(receipt), subject, specification, quality
+
+
+def test_completed_ledger_validates_from_overlay_only_closing_evidence(
+    tmp_path: Path,
+) -> None:
+    binding, subject, specification, quality = _closed_task_one(tmp_path)
+    paths = [
+        subject,
+        Path(specification["logical_path"]),
+        Path(quality["logical_path"]),
+        Path(specification["immutable_path"]),
+        Path(quality["immutable_path"]),
+    ]
+    overlay = _bytes(tmp_path, *paths)
+    for path in paths:
+        (tmp_path / path).chmod(0o644)
+        (tmp_path / path).write_bytes(b"not json\n")
+    request, snapshot = Path(binding["request_path"]), Path(binding["snapshot_path"])
+
+    assert materialization.validate_generation(tmp_path, request, snapshot)
+    assert (
+        materialization.validate_generation(
+            tmp_path, request, snapshot, bound_file_bytes=overlay
+        )
+        == []
+    )
+
+    changed = dict(overlay)
+    changed[specification["immutable_path"]] += b" "
+    assert "ledger_completion_review_pair_invalid" in {
+        issue.message or issue.code
+        for issue in materialization.validate_generation(
+            tmp_path, request, snapshot, bound_file_bytes=changed
+        )
+    }
+
+
+def test_review_binding_requires_committed_bytes_for_unmapped_fallback(
+    tmp_path: Path,
+) -> None:
+    _, _subject, specification, _quality = _closed_task_one(tmp_path)
+    from orchestrator.retirement import broad_evidence
+
+    assert broad_evidence.validate_bound_record(specification, tmp_path) == []
+    uncommitted = broad_evidence.validate_bound_record(
+        specification, tmp_path, require_committed_fallback=True
+    )
+    assert "review_binding_immutable_unreadable" in {i.code for i in uncommitted}
+
+    overlay = {specification["immutable_path"]: (tmp_path / specification["immutable_path"]).read_bytes()}
+    assert (
+        broad_evidence.validate_bound_record(
+            specification,
+            tmp_path,
+            bound_file_bytes=overlay,
+            require_committed_fallback=True,
+        )
+        == []
+    )

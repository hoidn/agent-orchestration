+"""Disposition ``attempt_migration_disposition.v2`` and its capture.
+
+Version 1 archives an attempt that stopped before owner adoption.  This module
+adds the sibling case: the owner personally adopted the attempt, but its
+workspace-baseline HEAD is not the intended commit predecessor.  Version 1
+behaviour is untouched (see ``attempt_migration``); the incident record lives in
+``attempt_migration_incident``.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path, PurePosixPath
+from typing import Any, Mapping, Sequence
+
+from . import attempt_migration as am
+from .attempt_migration import AttemptMigrationError
+from .attempt_migration_incident import (
+    INCIDENT_CONTENT_KEYS,
+    _derive_incident,
+    _fail,
+    _validate_incident,
+)
+from .materialization import validate_generation

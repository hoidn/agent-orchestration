+        "capture-invalidated-adopted", "--repository-root", str(root),
+    ]
+    for key, value in arguments.items():
+        if key == "protected_paths":
+            for protected in value:
+                command += ["--protected-path", protected]
+        else:
+            command += ["--" + key.replace("_", "-"), value]
+
+    completed = subprocess.run(
+        command, cwd=Path.cwd(), capture_output=True, text=True, check=False
+    )
+
+    assert completed.returncode == 0, completed.stderr
+    assert completed.stderr == ""
+    printed = json.loads(completed.stdout)
+    assert set(printed) == {"incident", "disposition"}
+    again = subprocess.run(command, cwd=Path.cwd(), capture_output=True, text=True)
+    assert again.returncode == 0 and json.loads(again.stdout) == printed
+    (root / arguments["incident_path"]).write_bytes(b"{}\n")
+    failed = subprocess.run(command, cwd=Path.cwd(), capture_output=True, text=True)
+    assert failed.returncode == 1 and failed.stdout == "" and failed.stderr.strip()

+# ------------------------------------------------------- v2 live validation
+
+
+def _validate_lifecycle(root: Path, record: Mapping[str, Any]) -> bytes:
+    lifecycle = am._require_keys(
+        record["attempt_lifecycle"], LIFECYCLE_KEYS, "attempt_lifecycle_keys_mismatch"
+    )
+    constants = {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+        "workspace_baseline_role": "workspace_baseline",
+        "owner_attestation_role": "attestation_record",
+        "adoption_transfer": "forbidden",
+    }
+    if any(lifecycle[key] != value for key, value in constants.items()):
+        raise _fail("attempt_lifecycle_invalid")
+    binding = am._require_keys(
+        lifecycle["incident_binding"], INCIDENT_CONTENT_KEYS, "incident_binding_invalid"
+    )
+    am._validate_file_binding(binding, full=False)
+    return binding  # type: ignore[return-value]
+
+
+def _shape_check_lifecycle(record: Mapping[str, Any]) -> None:
+    try:
+        _validate_lifecycle(Path("."), record)
+    except (KeyError, TypeError) as exc:
+        raise _fail("attempt_lifecycle_invalid") from exc
+
+
+def _view_bytes(root: Path, record: Mapping[str, Any]) -> dict[str, bytes]:
+    return {
+        row["original_path"]: am._resolve_attempt_row_snapshot(root, row)["data"]
+        for row in record["attempt_rows"]
+    }
+
+
+def _cross_check_incident(record: Mapping[str, Any], incident: Mapping[str, Any]) -> None:
+    attempt = record["attempt_binding"]
+    artifacts = attempt["artifact_bindings"]
+    rows = [
+        {
+            "path": row["original_path"],
+            "file_type": row["file_type"],
+            "lstat_mode": row["lstat_mode"],
+            "size": row["size"],
+            "sha256": row["sha256"],
+            "tracked_state": row["tracked_state"],
+        }
+        for row in record["attempt_rows"]
+    ]
+    manifest = attempt["expected_paths_manifest_binding"]
+    pairs = {
+        "governing_plan_binding": record["governing_plan_binding"],
+        "migration_plan_binding": record["migration_plan_binding"],
+        "expected_paths_manifest_binding": {
+            "path": manifest["path"],
+            "size": manifest["size"],
+            "sha256": manifest["sha256"],
+            "row_count": manifest["row_count"],
+        },
+    }
+    roles = {
+        "workspace_baseline_binding": "workspace_baseline",
+        "owner_attestation_binding": "attestation_record",
+        "pending_attestation_snapshot_binding": "attestation_snapshot",
+        "known_failure_baseline_binding": "baseline",
+    }
+    for key, role in roles.items():
+        binding = artifacts[role]
+        pairs[key] = {
+            "path": binding["path"],
+            "size": binding["size"],
+            "sha256": binding["sha256"],
+        }
+    if (
+        incident["attempt_rows"] != rows
+        or incident["source_root"] != attempt["source_root"]
+        or incident["pre_move_repository_state"] != record["pre_move_repository_state"]
+        or any(incident[key] != value for key, value in pairs.items())
+    ):
+        raise _fail("incident_disposition_binding_mismatch")
+
+
+def _json_or_none(data: bytes) -> dict[str, Any] | None:
+    try:
+        value = json.loads(data.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _check_generation11_coordinates(
+    record: Mapping[str, Any], view: Mapping[str, bytes]
+) -> None:
+    """Structural role check of the generation-11 pair, from row bytes only.
+
+    A request must be a generation-11 materialization request whose prior is the
+    contiguous generation-10 pair under the same parents; a snapshot must be the
+    ledger record that request carries, at its content-addressed name.
+    """
+
+    g11 = record["ledger_lineage"]["generation_11"]
+    request_path = g11["request_binding"]["path"]
+    snapshot_path = g11["snapshot_binding"]["path"]
+    code = "semantic_coordinate_row_binding_mismatch"
+    request = _json_or_none(view[request_path])
+    prior = request.get("prior_generation_binding") if request else None
+    live_path = g11["live_binding"]["path"]
+    if (
+        request is None
+        or request.get("schema_version") != "retirement_materialization_request.v1"
+        or request.get("record_kind") != "execution-ledger"
+        or request.get("generation") != 11
+        or request.get("output_path") != live_path
+        or not isinstance(prior, dict)
+        or prior.get("generation") != 10
+        or prior.get("output_path") != live_path
+        or PurePosixPath(str(prior.get("request_path"))).parent
+        != PurePosixPath(request_path).parent
+        or PurePosixPath(str(prior.get("snapshot_path"))).parent
+        != PurePosixPath(snapshot_path).parent
+    ):
+        raise _fail(code, "generation11_request")
+    ledger = _json_or_none(view[snapshot_path])
+    parameters = request.get("parameters")
+    if (
+        ledger is None
+        or ledger.get("schema_version") != "workflow_retirement_execution_ledger.v1"
+        or not isinstance(parameters, dict)
+        or parameters.get("record") != ledger
+        or PurePosixPath(snapshot_path).name.split("-", 1)[-1].split(".")[0]
+        != am._bytes_digest(view[snapshot_path]).removeprefix("sha256:")
+    ):
+        raise _fail(code, "generation11_snapshot")
+
+
+def _validate_generation_lineage(
+    root: Path, record: Mapping[str, Any], view: Mapping[str, bytes]
+) -> None:
+    g11 = record["ledger_lineage"]["generation_11"]
+    issues = validate_generation(
+        root,
+        Path(g11["request_binding"]["path"]),
+        Path(g11["snapshot_binding"]["path"]),
+        bound_file_bytes=view,
+        require_committed_fallback=True,
+    )
+    if issues:
+        raise _fail("semantic_coordinate_row_binding_mismatch", "generation11_request")
+    live = g11["live_binding"]
+    if (g11["snapshot_binding"]["size"], g11["snapshot_binding"]["sha256"]) != (
+        live["size"],
+        live["sha256"],
+    ):
+        raise _fail("generation11_snapshot_live_mismatch")
+    attestation = record["attempt_binding"]["artifact_bindings"]
+    attestation_issues = validate_generation(
+        root,
+        Path(attestation["attestation_request"]["path"]),
+        Path(attestation["attestation_snapshot"]["path"]),
+        bound_file_bytes=view,
+        require_committed_fallback=True,
+    )
+    if attestation_issues:
+        raise _fail("attestation_generation_invalid", attestation_issues[0].code)
+
+
+def _is_review_of(root: Path, row: Mapping[str, Any], disposition_path: str) -> bool:
+    """An uncommitted review of this very disposition is not drift."""
+
+    snapshot = am._read_regular(root, row["path"], missing_ok=True)
+    if snapshot is None:
+        return False
+    try:
+        review = am._json_bytes(snapshot["data"], row["path"])
+    except AttemptMigrationError:
+        return False
+    subject = review.get("subject")
+    return (
+        review.get("schema_version") == "review.v1"
+        and isinstance(subject, dict)
+        and subject.get("kind") == "attempt_migration_disposition"
+        and subject.get("path") == disposition_path
+    )
+
+
+def _validate_outside_status(
+    root: Path,
+    record: Mapping[str, Any],
+    ignored: Sequence[str],
+    disposition_path: str,
+) -> None:
+    current = am._repository_state(root)["status_projection"]["rows"]
+    extra = {
+        row["path"]
+        for row in current
+        if row["status"] == "??"
+        and row["source_path"] is None
+        and _is_review_of(root, row, disposition_path)
+    }
+    am._require_outside_status_projection_unchanged(
+        root, record, additional_ignored_paths=[*ignored, *sorted(extra)]
+    )
+
+
+def validate_v2(
+    root: Path,
+    record: Mapping[str, Any],
+    *,
+    disposition_path: str | None = None,
+    ignored_paths: Sequence[str] = (),
+) -> None:
+    """Reopen incident, attestations, baseline, lineage and Git state of a v2 record."""
+
+    try:
+        incident_binding = _validate_lifecycle(root, record)
+        am._validate_live_bindings(root, record)
+        incident_file = am._read_regular(root, incident_binding["path"])
+        assert incident_file is not None
+        if (
+            incident_file["size"] != incident_binding["size"]
+            or incident_file["sha256"] != incident_binding["sha256"]
+            or incident_file["lstat_mode"] != 0o644
+        ):
+            raise _fail("incident_binding_mismatch")
+        incident = am._json_bytes(incident_file["data"], incident_binding["path"])
+        if incident_file["data"] != am._canonical_json(incident) + b"\n":
+            raise _fail("incident_not_canonical")
+        view = _view_bytes(root, record)
+        _check_generation11_coordinates(record, view)
+        _validate_incident(root, incident, view)
+        _cross_check_incident(record, incident)
+        _validate_generation_lineage(root, record, view)
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("disposition_structure_invalid") from exc
+    _validate_outside_status(
+        root,
+        record,
+        [incident_binding["path"], *([disposition_path] if disposition_path else []), *ignored_paths],
+        disposition_path or "",
+    )
+
+
+PROFILE: dict[str, Any] = {
+    "schema_version": DISPOSITION_SCHEMA,
+    "disposition": DISPOSITION_VALUE,
+    "top_level_keys": TOP_LEVEL_KEYS,
+    "claims_not_made": CLAIMS_NOT_MADE,
+    "artifact_roles": ARTIFACT_ROLES,
+    "identical_pair": None,
+    "enforce_snapshot_live": False,
+    "extra_structure": _shape_check_lifecycle,
+}

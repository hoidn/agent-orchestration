+def _require_fresh_output(root: Path, path: str, rows: Sequence[Mapping[str, Any]]) -> None:
+    """An output is neither tracked, staged, nor part of a rename."""
+
+    if am._is_tracked(root, path):
+        raise _fail("output_path_tracked", path)
+    for row in rows:
+        if path in (row["path"], row["source_path"]) and (
+            row["status"] != "??" or row["source_path"] is not None
+        ):
+            raise _fail("output_path_not_plain_untracked", path)
+
+
+def _published_equals(root: Path, path: str, data: bytes) -> bool:
+    existing = am._read_regular(root, path, missing_ok=True)
+    return (
+        existing is not None
+        and existing["data"] == data
+        and existing["lstat_mode"] == 0o644
+    )
+
+
+def capture_invalidated_adopted(
+    repository_root: Path | str,
+    *,
+    incident_path: Path | str,
+    disposition_path: Path | str,
+    source_root: Path | str,
+    archive_root: Path | str,
+    governing_plan_path: Path | str,
+    migration_plan_path: Path | str,
+    authority_subject_path: Path | str,
+    authority_specification_review_path: Path | str,
+    authority_quality_review_path: Path | str,
+    intended_predecessor_head: str,
+    restoration_commit: str,
+    restoration_tree: str,
+    expected_paths_manifest_path: Path | str,
+    protected_paths: Sequence[Path | str],
+    generation5_request_path: Path | str,
+    generation5_snapshot_path: Path | str,
+    generation11_request_path: Path | str,
+    generation11_snapshot_path: Path | str,
+    live_ledger_path: Path | str,
+    baseline_path: Path | str,
+    baseline_specification_review_path: Path | str,
+    baseline_quality_review_path: Path | str,
+    workspace_baseline_path: Path | str,
+    attestation_request_path: Path | str,
+    attestation_snapshot_path: Path | str,
+    attestation_record_path: Path | str,
+) -> dict[str, Any]:
+    """Publish the incident, then the disposition; replay-safe and exclusive."""
+
+    root = am._repository_root(repository_root)
+    rel = am._relative_path
+    incident_relative = rel(incident_path, field="incident_path")
+    disposition_relative = rel(disposition_path, field="disposition_path")
+    source_prefix = rel(source_root, field="source_root")
+    archive_prefix = rel(archive_root, field="archive_root")
+    if am._under(source_prefix, archive_prefix) or am._under(archive_prefix, source_prefix):
+        raise _fail("source_archive_roots_overlap")
+    if incident_relative == disposition_relative:
+        raise _fail("output_paths_alias")
+    for output in (incident_relative, disposition_relative):
+        am._reject_output_overlap(output, source_prefix, archive_prefix)
+    if am._scan_regular_files(root, archive_prefix):
+        raise _fail("archive_not_empty", archive_prefix)
+
+    incident_file = am._read_regular(root, incident_relative, missing_ok=True)
+    disposition_file = am._read_regular(root, disposition_relative, missing_ok=True)
+    if disposition_file is not None and incident_file is None:
+        raise _fail("disposition_without_incident", disposition_relative)
+    outputs = [
+        path
+        for path, existing in (
+            (incident_relative, incident_file),
+            (disposition_relative, disposition_file),
+        )
+        if existing is not None
+    ]
+    status_rows = am._repository_state(root)["status_projection"]["rows"]
+    for output in (incident_relative, disposition_relative):
+        _require_fresh_output(root, output, status_rows)
+
+    paths = {
+        "governing": rel(governing_plan_path),
+        "migration": rel(migration_plan_path),
+        "manifest": rel(expected_paths_manifest_path),
+        "baseline": rel(baseline_path),
+        "workspace": rel(workspace_baseline_path),
+        "snapshot": rel(attestation_snapshot_path),
+        "record": rel(attestation_record_path),
+    }
+    incident = _derive_incident(
+        root,
+        governing_plan_path=paths["governing"],
+        migration_plan_path=paths["migration"],
+        workspace_baseline_path=paths["workspace"],
+        owner_attestation_path=paths["record"],
+        pending_attestation_snapshot_path=paths["snapshot"],
+        known_failure_baseline_path=paths["baseline"],
+        expected_paths_manifest_path=paths["manifest"],
+        source_prefix=source_prefix,
+        intended_predecessor_head=intended_predecessor_head,
+        exclude_status_paths=outputs,
+    )
+    incident_data = am._canonical_json(incident) + b"\n"
+    role_paths = {
+        "baseline": paths["baseline"],
+        "baseline_specification_review": rel(baseline_specification_review_path),
+        "baseline_quality_review": rel(baseline_quality_review_path),
+        "workspace_baseline": paths["workspace"],
+        "attestation_request": rel(attestation_request_path),
+        "attestation_snapshot": paths["snapshot"],
+        "attestation_record": paths["record"],
+    }
+    facts = am._gather_capture(
+        root,
+        profile=PROFILE,
+        source_prefix=source_prefix,
+        archive_prefix=archive_prefix,
+        governing_plan_path=paths["governing"],
+        migration_plan_path=paths["migration"],
+        authority_subject_path=rel(authority_subject_path),
+        authority_specification_review_path=rel(authority_specification_review_path),
+        authority_quality_review_path=rel(authority_quality_review_path),
+        source_commit=restoration_commit,
+        source_tree=restoration_tree,
+        expected_paths_manifest_path=paths["manifest"],
+        protected_paths=protected_paths,
+        generation5_request_path=rel(generation5_request_path),
+        generation5_snapshot_path=rel(generation5_snapshot_path),
+        generation11_request_path=rel(generation11_request_path),
+        generation11_snapshot_path=rel(generation11_snapshot_path),
+        live_ledger_path=rel(live_ledger_path),
+        role_paths=role_paths,
+        exclude_status_paths=outputs,
+    )
+    if facts["state"] != incident["pre_move_repository_state"]:
+        raise _fail("incident_repository_state_mismatch")
+    if facts["expected_paths"] != [row["path"] for row in incident["attempt_rows"]]:
+        raise _fail("incident_attempt_rows_mismatch")
+    rows = facts["rows"]
+    attempt_binding = facts["attempt_binding"]
+    record: dict[str, Any] = {
+        "schema_version": DISPOSITION_SCHEMA,
+        "disposition": DISPOSITION_VALUE,
+        "governing_plan_binding": facts["governing_binding"],
+        "migration_plan_binding": facts["migration_binding"],
+        "authority_review_bindings": {
+            "specification": am._content_binding(facts["authority_spec_file"]),
+            "code_quality": am._content_binding(facts["authority_quality_file"]),
+        },
+        "attempt_binding": attempt_binding,
+        "attempt_lifecycle": {
+            "adoption_state": "owner_adopted",
+            "repository_commit_state": "uncommitted",
+            "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+            "incident_binding": {
+                "path": incident_relative,
+                "size": len(incident_data),
+                "sha256": am._bytes_digest(incident_data),
+            },
+            "workspace_baseline_role": "workspace_baseline",
+            "owner_attestation_role": "attestation_record",
+            "adoption_transfer": "forbidden",
+        },
+        "pre_move_repository_state": facts["state"],
+        "protected_path_bindings": facts["protected"],
+        "ledger_lineage": facts["ledger_lineage"],
+        "attempt_rows": rows,
+        "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": am._canonical_digest(facts["expected_paths"]),
+        "archive_path_set_sha256": am._canonical_digest(
+            [row["archive_path"] for row in rows]
+        ),
+        "normalized_row_set_sha256": am._canonical_digest(rows),
+        "normalized_disposition_sha256": "",
+        "claims_not_made": list(CLAIMS_NOT_MADE),
+    }
+    record["normalized_disposition_sha256"] = am._canonical_digest(
+        record, exclude="normalized_disposition_sha256"
+    )
+    disposition_data = am._canonical_json(record) + b"\n"
+
+    if incident_file is not None:
+        if not _published_equals(root, incident_relative, incident_data):
+            raise _fail("incident_replay_mismatch", incident_relative)
+    if disposition_file is not None:
+        if not _published_equals(root, disposition_relative, disposition_data):
+            raise _fail("disposition_replay_mismatch", disposition_relative)
+        return {"incident": incident, "disposition": record}
+    if incident_file is None:
+        am._publish_exclusive(root, incident_relative, incident_data, 0o644)
+    am._publish_exclusive(root, disposition_relative, disposition_data, 0o644)
+    validated, _ = am._load_disposition(root, disposition_relative)
+    validate_v2(root, validated, disposition_path=disposition_relative)
+    return {"incident": incident, "disposition": record}

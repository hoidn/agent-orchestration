+        if coordinates is None and b"Retirement-Control-" in message:
+            raise SourceBindingError(f"commit_control_trailer_invalid:{commit}")
+        paths = _commit_changed_paths(root, commit)
+        (controlled if coordinates else uncovered).update(paths)
+        rows.append(
+            {
+                "commit": commit,
+                "parent": fields[1],
+                "tree": _git(root, "rev-parse", f"{commit}^{{tree}}").decode("ascii").strip(),
+                "raw_message_sha256": _sha256_bytes(message),
+                "changed_paths": paths,
+                "changed_path_set_sha256": _path_list_digest(paths),
+                "control_coordinates": None
+                if coordinates is None
+                else {"transaction_id": coordinates[0], "normalized_control_sha256": coordinates[1]},
+            }
+        )
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("lineage_uncovered_paths_missing")
+    changed = sorted(controlled | uncovered)
+    projection: dict[str, Any] = {
+        "baseline_head": baseline_head,
+        "intended_predecessor_head": intended_predecessor_head,
+        "intended_predecessor_tree": _git(root, "rev-parse", f"{intended_predecessor_head}^{{tree}}").decode("ascii").strip(),
+        "first_parent_commits": rows,
+        "commit_count": len(rows),
+        "changed_paths": changed,
+        "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": sorted(controlled),
+        "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": sorted(uncovered),
+        "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    projection["normalized_projection_sha256"] = _canonical_sha256(projection)
+    return projection
+

+def validate_v2_lifecycle(root: Path, record: Mapping[str, Any]) -> None:
+    """Reopen the incident through the logical view and cross-link it to ``record``."""
+
+    attempt = record["attempt_binding"]
+    binding = record["attempt_lifecycle"]["incident_binding"]
+    originals = [row["original_path"] for row in record["attempt_rows"]]
+    _reject_output_overlap(
+        binding["path"], attempt["source_root"], attempt["archive_root"], originals
+    )
+    snapshot = _read_regular(root, binding["path"])
+    if not _same_content(snapshot, binding):
+        raise _fail("attempt_lifecycle_incident_binding_mismatch")
+    incident = _json_bytes(snapshot["data"], binding["path"])  # type: ignore[index]
+    if snapshot["data"] != _canonical_json(incident) + b"\n":  # type: ignore[index]
+        raise _fail("incident_not_canonical")
+    files, archived = _logical_view(root, record)
+    with byte_overlay.use_overlay(root, files, archived):
+        validate_attempt_migration_incident(root, incident)
+    _cross_link(record, incident)

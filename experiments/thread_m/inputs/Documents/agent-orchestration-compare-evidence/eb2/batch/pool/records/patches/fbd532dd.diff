+def test_incident_validation_rejects_predecessor_after_pre_move_head(
+    incident_repository: dict,
+) -> None:
+    args = incident_repository
+    root: Path = args["root"]
+    incident = _capture_v2(args)["incident"]
+    later = _commit(root, "docs-later.txt", "corrective", "corrective")
+    lineage = derive_committed_predecessor_lineage(
+        root,
+        baseline_head=incident["predecessor_projection"]["baseline_head"],
+        intended_predecessor_head=later,
+        require_uncovered_paths=True,
+    )
+    forged = {
+        **incident,
+        "intended_predecessor": {
+            "head": lineage["intended_predecessor_head"],
+            "tree": lineage["intended_predecessor_tree"],
+        },
+        "predecessor_projection": lineage,
+    }
+    forged["normalized_incident_sha256"] = adopted_incident._canonical_digest(
+        forged, exclude="normalized_incident_sha256"
+    )
+    with pytest.raises(AttemptMigrationError) as caught:
+        validate_attempt_migration_incident(root, forged)
+    assert str(caught.value) == "incident_intended_predecessor_not_ancestor"

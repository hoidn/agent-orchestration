+"""Recovery class for an owner-adopted attempt that never reached its commit.
+
+``attempt_migration_incident.v1`` records why the attempt's workspace-baseline
+HEAD is not the intended commit predecessor; ``attempt_migration_disposition.v2``
+archives that attempt.  Every lifecycle fact is derived from files and Git
+objects.  Depends on: the Git object database and index of the repository, the
+bound plan/manifest files (committed at HEAD), and the attempt files under the
+source root (or their archive copies, read through ``byte_overlay``).
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from . import byte_overlay
+from .attempt_migration import (
+    ARTIFACT_ROLES_V2,
+    CLAIMS_NOT_MADE_V2,
+    DISPOSITION_V2,
+    LIFECYCLE_V2_FIXED,
+    SCHEMA_VERSION_V2,
+    AttemptMigrationError,
+    _binding_from_row,
+    _bytes_digest,
+    _canonical_digest,
+    _canonical_json,
+    _committed_bytes,
+    _content_binding,
+    _git,
+    _git_is_ancestor,
+    _git_regular_mode_matches_live,
+    _is_commit_identity,
+    _is_tracked,
+    _json_bytes,
+    _manifest_paths,
+    _outside_status_paths,
+    _public_binding,
+    _publish_exclusive,
+    _read_regular,
+    _reject_output_overlap,
+    _relative_path,
+    _repository_root,
+    _repository_state,
+    _require_committed_live,
+    _same_content,
+    _scan_regular_files,
+    _state_without_paths,
+    _status_paths,
+    _under,
+    _validate_authority_subject,
+    _validate_file_binding,
+    _validate_review_pair,
+    _validate_semantic_coordinates,
+    _validate_status_projection_boundaries,
+    validate,
+)
+from .broad_evidence import validate_bound_record, validate_record
+from .source_bindings import (
+    SourceBindingError,
+    derive_committed_predecessor_lineage,
+    validate_workspace_record_shape,
+)
+
+INCIDENT_SCHEMA = "attempt_migration_incident.v1"
+INCIDENT_CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+INCIDENT_KEYS = {
+    "schema_version",
+    "governing_plan_binding",
+    "migration_plan_binding",
+    "workspace_baseline_binding",
+    "owner_attestation_binding",
+    "pending_attestation_snapshot_binding",
+    "known_failure_baseline_binding",
+    "expected_paths_manifest_binding",
+    "source_root",
+    "intended_predecessor",
+    "predecessor_projection",
+    "pre_move_repository_state",
+    "attempt_rows",
+    "attempt_path_count",
+    "attempt_path_set_sha256",
+    "normalized_attempt_row_set_sha256",
+    "adoption_facts",
+    "normalized_incident_sha256",
+    "claims_not_made",
+}
+BINDING_NAMES = (
+    "governing_plan",
+    "migration_plan",
+    "workspace_baseline",
+    "owner_attestation",
+    "pending_attestation_snapshot",
+    "known_failure_baseline",
+    "expected_paths_manifest",
+)
+COMMITTED_BINDINGS = {"governing_plan", "migration_plan", "expected_paths_manifest"}
+INCIDENT_ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+ATTESTATION_SCHEMA = "broad_failure_baseline_attestation.v1"
+ATTESTATION_OWNER_FIELDS = {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+TOLERATED_BASELINE_ISSUES = {"candidate_path_set_live_mismatch"}
+# The attestation's review pair re-validates the baseline deeply against live
+# HEAD (raised only after the immutable review bindings and the subject bytes
+# bind); the incident checks the baseline itself historically instead.
+HEAD_RELATIVE_ATTESTATION_ISSUES = {"review_pair_subject_invalid"}
+
+
+def _fail(code: str, detail: str = "") -> AttemptMigrationError:
+    return AttemptMigrationError(code, detail)
+
+
+def _binding_error(name: str) -> AttemptMigrationError:
+    return AttemptMigrationError(f"incident_{name}_binding_invalid")
+
+
+def _bound_bytes(root: Path, path: str) -> bytes | None:
+    def live() -> bytes | None:
+        snapshot = _read_regular(root, path, missing_ok=True)
+        return None if snapshot is None else snapshot["data"]
+
+    try:
+        return byte_overlay.read(path, live)
+    except AttemptMigrationError:
+        return None
+
+
+def _reopen(root: Path, name: str, binding: Any) -> bytes:
+    """Reopen one bound file through the active overlay; fail with its binding code."""
+
+    try:
+        _validate_file_binding(
+            {key: binding[key] for key in ("path", "size", "sha256")}, full=False
+        )
+    except (AttemptMigrationError, KeyError, TypeError) as exc:
+        raise _binding_error(name) from exc
+    data = _bound_bytes(root, binding["path"])
+    if (
+        data is None
+        or len(data) != binding["size"]
+        or _bytes_digest(data) != binding["sha256"]
+        or (
+            name in COMMITTED_BINDINGS
+            and not byte_overlay.committed_identical(root, binding["path"], data)
+        )
+    ):
+        raise _binding_error(name)
+    return data
+
+
+def _json_record(data: bytes, name: str) -> dict[str, Any]:
+    try:
+        return _json_bytes(data, name)
+    except AttemptMigrationError as exc:
+        raise _binding_error(name) from exc
+
+
+def _adoption_facts(record: Any) -> dict[str, Any]:
+    lifecycle = _fail("incident_owner_lifecycle_invalid")
+    if not isinstance(record, Mapping) or record.get("evidence_status") != "owner_confirmed":
+        raise lifecycle
+    owner = record.get("owner")
+    confirmations = record.get("owner_confirmations")
+    adoption = record.get("owner_adoption")
+    if not (
+        isinstance(owner, Mapping)
+        and isinstance(confirmations, Mapping)
+        and isinstance(adoption, Mapping)
+    ):
+        raise lifecycle
+    values = (
+        owner.get("identity"),
+        owner.get("role"),
+        confirmations.get("confirmed_at"),
+        adoption.get("adopted_at"),
+        adoption.get("identity"),
+    )
+    if any(not isinstance(value, str) or not value for value in values):
+        raise lifecycle
+    if adoption["identity"] != owner["identity"]:
+        raise lifecycle
+    return {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed",
+        "owner_identity": owner["identity"],
+        "owner_role": owner["role"],
+        "confirmed_at": confirmations["confirmed_at"],
+        "adopted_at": adoption["adopted_at"],
+    }
+
+
+def _check_attestations(root: Path, record: Mapping[str, Any]) -> dict[str, Any]:
+    owner_data = _reopen(root, "owner_attestation", record["owner_attestation_binding"])
+    owner = _json_record(owner_data, "owner_attestation")
+    facts = _adoption_facts(owner)
+    baseline = record["known_failure_baseline_binding"]
+    owner_baseline = owner.get("baseline_binding")
+    if (
+        owner.get("schema_version") != ATTESTATION_SCHEMA
+        or any(
+            issue.code not in HEAD_RELATIVE_ATTESTATION_ISSUES
+            for issue in validate_bound_record(owner, root)
+        )
+        or not isinstance(owner_baseline, Mapping)
+        or (owner_baseline.get("path"), owner_baseline.get("sha256"))
+        != (baseline["path"], baseline["sha256"])
+    ):
+        raise _binding_error("owner_attestation")
+    pending_data = _reopen(
+        root, "pending_attestation_snapshot", record["pending_attestation_snapshot_binding"]
+    )
+    pending = _json_record(pending_data, "pending_attestation_snapshot")
+
+    def stable(value: Mapping[str, Any]) -> dict[str, Any]:
+        return {k: v for k, v in value.items() if k not in ATTESTATION_OWNER_FIELDS}
+
+    if (
+        pending.get("schema_version") != ATTESTATION_SCHEMA
+        or pending.get("evidence_status") != "pending_owner_confirmation"
+        or validate_record(pending)
+        or stable(pending) != stable(owner)
+    ):
+        raise _binding_error("pending_attestation_snapshot")
+    return facts
+
+
+def _tolerated(root: Path, issue: Any, candidate_head: Any) -> bool:
+    if issue.code in TOLERATED_BASELINE_ISSUES:
+        return True
+    if issue.code == "candidate_git_identity_mismatch":
+        return (
+            isinstance(candidate_head, str)
+            and _is_commit_identity(candidate_head)
+            and _git_is_ancestor(root, candidate_head, "HEAD")
+        )
+    return False
+
+
+def _check_known_failure_baseline(root: Path, binding: Any) -> None:
+    def fail(*codes: str) -> AttemptMigrationError:
+        return AttemptMigrationError(
+            "incident_known_failure_baseline_binding_invalid", ",".join(sorted(set(codes)))
+        )
+
+    try:
+        data = _reopen(root, "known_failure_baseline", binding)
+        record = _json_bytes(data, "known_failure_baseline")
+    except AttemptMigrationError as exc:
+        raise fail("bound_file_unreadable") from exc
+    if record.get("schema_version") != "broad_known_failure_baseline.v1":
+        raise fail("bound_record_invalid")
+    candidate = record.get("candidate_binding")
+    candidate_head = candidate.get("head") if isinstance(candidate, Mapping) else None
+    issues = validate_bound_record(record, root)
+    fatal = [issue.code for issue in issues if not _tolerated(root, issue, candidate_head)]
+    if fatal:
+        raise fail(*fatal)
+
+
+def _workspace_head(root: Path, binding: Any) -> str:
+    data = _reopen(root, "workspace_baseline", binding)
+    record = _json_record(data, "workspace_baseline")
+    if (
+        record.get("schema_version") != "workspace_baseline.v1"
+        or validate_workspace_record_shape(record)
+        or not _is_commit_identity(record.get("head"))
+    ):
+        raise _binding_error("workspace_baseline")
+    return record["head"]
+
+
+def _lineage(root: Path, baseline_head: str, predecessor: Any) -> dict[str, Any]:
+    if not _is_commit_identity(predecessor):
+        raise _fail("incident_intended_predecessor_invalid")
+    try:
+        return derive_committed_predecessor_lineage(
+            root,
+            baseline_head=baseline_head,
+            intended_predecessor_head=predecessor,
+            require_uncovered_paths=True,
+        )
+    except SourceBindingError as exc:
+        raise _fail("incident_predecessor_lineage_invalid", str(exc)) from exc
+
+
+def _require_head_descends(root: Path, head: str, tree: str) -> None:
+    if _git(root, "rev-parse", f"{head}^{{tree}}").decode("ascii").strip() != tree:
+        raise _fail("capture_head_tree_mismatch")
+    if not _git_is_ancestor(root, head, "HEAD"):
+        raise _fail("capture_head_not_ancestor")
+
+
+def _manifest_binding(file: Mapping[str, Any], count: int) -> dict[str, Any]:
+    return {**_content_binding(file), "row_count": count}
+
+
+def _attempt_rows(root: Path, paths: Sequence[str]) -> list[dict[str, Any]]:
+    rows = []
+    for path in paths:
+        snapshot = _read_regular(root, path)
+        assert snapshot is not None
+        rows.append(
+            {
+                "path": path,
+                "file_type": "regular",
+                "lstat_mode": snapshot["lstat_mode"],
+                "size": snapshot["size"],
+                "sha256": snapshot["sha256"],
+                "tracked_state": "modified" if _is_tracked(root, path) else "untracked",
+            }
+        )
+    return rows
+
+
+def _build_incident(
+    root: Path,
+    *,
+    governing_plan_path: Path | str,
+    migration_plan_path: Path | str,
+    workspace_baseline_path: Path | str,
+    owner_attestation_path: Path | str,
+    pending_attestation_snapshot_path: Path | str,
+    known_failure_baseline_path: Path | str,
+    expected_paths_manifest_path: Path | str,
+    source_root: Path | str,
+    intended_predecessor_head: str,
+    ignored_status_paths: Sequence[str] = (),
+) -> dict[str, Any]:
+    prefix = _relative_path(source_root, field="source_root")
+    bindings: dict[str, dict[str, Any]] = {}
+    for name, path in (
+        ("governing_plan", governing_plan_path),
+        ("migration_plan", migration_plan_path),
+        ("workspace_baseline", workspace_baseline_path),
+        ("owner_attestation", owner_attestation_path),
+        ("pending_attestation_snapshot", pending_attestation_snapshot_path),
+        ("known_failure_baseline", known_failure_baseline_path),
+        ("expected_paths_manifest", expected_paths_manifest_path),
+    ):
+        relative = _relative_path(path, field=name)
+        snapshot = (
+            _require_committed_live(root, relative)
+            if name in COMMITTED_BINDINGS
+            else _read_regular(root, relative)
+        )
+        assert snapshot is not None
+        bindings[name] = _content_binding(snapshot)
+    manifest = _manifest_paths(
+        _read_regular(root, bindings["expected_paths_manifest"]["path"])["data"],
+        bindings["expected_paths_manifest"]["path"],
+    )
+    if any(not _under(path, prefix) for path in manifest):
+        raise _fail("expected_path_outside_source_root")
+    state = _state_without_paths(_repository_state(root), set(ignored_status_paths))
+    rows_status = state["status_projection"]["rows"]
+    _validate_status_projection_boundaries(rows_status, prefix)
+    observed = _status_paths(rows_status, prefix)
+    if observed != manifest:
+        raise _fail(
+            "source_set_mismatch",
+            _canonical_json({"expected": manifest, "observed": observed}).decode(),
+        )
+    record: dict[str, Any] = {
+        "schema_version": INCIDENT_SCHEMA,
+        **{f"{name}_binding": bindings[name] for name in BINDING_NAMES},
+        "source_root": prefix,
+        "pre_move_repository_state": state,
+        "claims_not_made": INCIDENT_CLAIMS_NOT_MADE,
+    }
+    record["expected_paths_manifest_binding"] = {
+        **bindings["expected_paths_manifest"],
+        "row_count": len(manifest),
+    }
+    record["adoption_facts"] = _check_attestations(root, record)
+    _check_known_failure_baseline(root, bindings["known_failure_baseline"])
+    lineage = _lineage(
+        root, _workspace_head(root, bindings["workspace_baseline"]), intended_predecessor_head
+    )
+    if not _git_is_ancestor(root, intended_predecessor_head, state["head"]):
+        raise _fail("incident_intended_predecessor_not_ancestor")
+    record["intended_predecessor"] = {
+        "head": lineage["intended_predecessor_head"],
+        "tree": lineage["intended_predecessor_tree"],
+    }
+    record["predecessor_projection"] = lineage
+    rows = _attempt_rows(root, manifest)
+    record.update(
+        attempt_rows=rows,
+        attempt_path_count=len(rows),
+        attempt_path_set_sha256=_canonical_digest(manifest),
+        normalized_attempt_row_set_sha256=_canonical_digest(rows),
+        normalized_incident_sha256="",
+    )
+    record["normalized_incident_sha256"] = _canonical_digest(
+        record, exclude="normalized_incident_sha256"
+    )
+    return {key: record[key] for key in sorted(record)}
+
+
+def build_attempt_migration_incident(
+    repository_root: Path | str,
+    *,
+    governing_plan_path: Path | str,
+    migration_plan_path: Path | str,
+    workspace_baseline_path: Path | str,
+    owner_attestation_path: Path | str,
+    pending_attestation_snapshot_path: Path | str,
+    known_failure_baseline_path: Path | str,
+    expected_paths_manifest_path: Path | str,
+    source_root: Path | str,
+    intended_predecessor_head: str,
+) -> dict[str, Any]:
+    return _build_incident(
+        _repository_root(repository_root),
+        governing_plan_path=governing_plan_path,
+        migration_plan_path=migration_plan_path,
+        workspace_baseline_path=workspace_baseline_path,
+        owner_attestation_path=owner_attestation_path,
+        pending_attestation_snapshot_path=pending_attestation_snapshot_path,
+        known_failure_baseline_path=known_failure_baseline_path,
+        expected_paths_manifest_path=expected_paths_manifest_path,
+        source_root=source_root,
+        intended_predecessor_head=intended_predecessor_head,
+    )
+
+
+def _validate_incident_structure(record: Any) -> None:
+    if not isinstance(record, Mapping) or set(record) != INCIDENT_KEYS:
+        raise _fail("incident_keys_mismatch")
+    if record["schema_version"] != INCIDENT_SCHEMA:
+        raise _fail("incident_schema_invalid")
+    if record["claims_not_made"] != INCIDENT_CLAIMS_NOT_MADE:
+        raise _fail("incident_claims_invalid")
+    if record["normalized_incident_sha256"] != _canonical_digest(
+        record, exclude="normalized_incident_sha256"
+    ):
+        raise _fail("normalized_incident_digest_mismatch")
+    for name in BINDING_NAMES:
+        binding = record[f"{name}_binding"]
+        keys = {"path", "size", "sha256"} | (
+            {"row_count"} if name == "expected_paths_manifest" else set()
+        )
+        if not isinstance(binding, Mapping) or set(binding) != keys:
+            raise _binding_error(name)
+    _relative_path(record["source_root"], field="source_root")
+    rows = record["attempt_rows"]
+    if not isinstance(rows, list) or not rows:
+        raise _fail("incident_attempt_rows_invalid")
+    for row in rows:
+        if not isinstance(row, Mapping) or set(row) != INCIDENT_ROW_KEYS:
+            raise _fail("incident_attempt_row_keys_mismatch")
+        _validate_file_binding({key: row[key] for key in INCIDENT_ROW_KEYS - {"tracked_state"}})
+        if row["tracked_state"] not in {"modified", "untracked"}:
+            raise _fail("incident_attempt_row_tracked_state_invalid")
+    paths = [row["path"] for row in rows]
+    if paths != sorted(set(paths)) or any(not _under(p, record["source_root"]) for p in paths):
+        raise _fail("incident_attempt_row_order_invalid")
+    manifest = record["expected_paths_manifest_binding"]
+    if (
+        record["attempt_path_count"] != len(rows)
+        or manifest["row_count"] != len(rows)
+        or record["attempt_path_set_sha256"] != _canonical_digest(paths)
+        or record["normalized_attempt_row_set_sha256"] != _canonical_digest(rows)
+    ):
+        raise _fail("incident_attempt_row_set_mismatch")
+
+
+def _check_state(root: Path, record: Mapping[str, Any]) -> None:
+    state = record["pre_move_repository_state"]
+    if not isinstance(state, Mapping) or set(state) != {
+        "head",
+        "tree",
+        "index_sha256",
+        "status_projection",
+    }:
+        raise _fail("incident_repository_state_invalid")
+    projection = state["status_projection"]
+    if (
+        not isinstance(projection, Mapping)
+        or set(projection) != {"rows", "row_count", "normalized_rows_sha256"}
+        or not isinstance(projection["rows"], list)
+        or projection["row_count"] != len(projection["rows"])
+        or projection["normalized_rows_sha256"] != _canonical_digest(projection["rows"])
+        or not _is_commit_identity(state["head"])
+        or not _is_commit_identity(state["tree"])
+    ):
+        raise _fail("incident_repository_state_invalid")
+    _validate_status_projection_boundaries(projection["rows"], record["source_root"])
+    if _status_paths(projection["rows"], record["source_root"]) != [
+        row["path"] for row in record["attempt_rows"]
+    ]:
+        raise _fail("source_status_coverage_mismatch")
+    _require_head_descends(root, state["head"], state["tree"])
+
+
+def _check_attempt_rows(root: Path, rows: Sequence[Mapping[str, Any]]) -> None:
+    overlay = byte_overlay.current()
+    for row in rows:
+        mapped = overlay is not None and row["path"] in overlay.files
+        if mapped:
+            data = overlay.files[row["path"]]
+            same = len(data) == row["size"] and _bytes_digest(data) == row["sha256"]
+        else:
+            same = _same_content(_read_regular(root, row["path"], missing_ok=True), row)
+        if not same:
+            raise _fail("incident_attempt_row_drift", row["path"])
+
+
+def validate_attempt_migration_incident(
+    repository_root: Path | str, record: Any
+) -> dict[str, Any]:
+    root = _repository_root(repository_root)
+    try:
+        _validate_incident_structure(record)
+        _check_state(root, record)
+        for name in ("governing_plan", "migration_plan", "workspace_baseline"):
+            _reopen(root, name, record[f"{name}_binding"])
+        manifest = record["expected_paths_manifest_binding"]
+        listed = _manifest_paths(_reopen(root, "expected_paths_manifest", manifest), manifest["path"])
+        if listed != [row["path"] for row in record["attempt_rows"]]:
+            raise _binding_error("expected_paths_manifest")
+        _check_attempt_rows(root, record["attempt_rows"])
+        facts = _check_attestations(root, record)
+        if record["adoption_facts"] != facts:
+            raise _fail("incident_owner_lifecycle_invalid")
+        _check_known_failure_baseline(root, record["known_failure_baseline_binding"])
+        head = _workspace_head(root, record["workspace_baseline_binding"])
+        projection = record["predecessor_projection"]
+        predecessor = record["intended_predecessor"]
+        if not isinstance(projection, Mapping) or not isinstance(predecessor, Mapping):
+            raise _fail("incident_predecessor_projection_invalid")
+        derived = _lineage(root, head, projection.get("intended_predecessor_head"))
+        if derived != projection or predecessor != {
+            "head": derived["intended_predecessor_head"],
+            "tree": derived["intended_predecessor_tree"],
+        }:
+            raise _fail("incident_predecessor_projection_invalid")
+        if not _git_is_ancestor(root, predecessor["head"], record["pre_move_repository_state"]["head"]):
+            raise _fail("incident_intended_predecessor_not_ancestor")
+    except (KeyError, TypeError, ValueError) as exc:
+        raise _fail("incident_structure_invalid") from exc
+    return record  # type: ignore[no-any-return]
+
+
+def _logical_view(root: Path, record: Mapping[str, Any]) -> tuple[dict[str, bytes], bool]:
+    """Map every original path to its row-exact source or archive bytes."""
+
+    files: dict[str, bytes] = {}
+    archived = False
+    for row in record["attempt_rows"]:
+        source = _read_regular(root, row["original_path"], missing_ok=True)
+        if _same_content(source, _binding_from_row(row, path_field="original_path")):
+            files[row["original_path"]] = source["data"]  # type: ignore[index]
+            continue
+        archive = _read_regular(root, row["archive_path"], missing_ok=True)
+        if not _same_content(archive, _binding_from_row(row, path_field="archive_path")):
+            raise _fail("attempt_row_state_invalid", row["original_path"])
+        files[row["original_path"]] = archive["data"]  # type: ignore[index]
+        archived = True
+    return files, archived

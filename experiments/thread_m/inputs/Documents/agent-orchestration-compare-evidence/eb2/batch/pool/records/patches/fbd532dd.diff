+def test_capture_rejects_owner_attestation_with_unbound_review(incident_repository: dict) -> None:
+    args = incident_repository
+    root: Path = args["root"]
+    for key in ("pending_snapshot_path", "pending_record_path"):
+        path = root / args[key]
+        record = json.loads(path.read_text())
+        binding = record["specification_review_binding"]
+        binding["immutable_path"] = binding["immutable_path"].replace("specification-", "missing-")
+        binding["normalized_binding_sha256"] = canonical_sha256(
+            binding, exclude={"normalized_binding_sha256"}
+        )
+        path.write_text(json.dumps(record, sort_keys=True) + "\n")
+    with pytest.raises(AttemptMigrationError) as caught:
+        _capture_v2(args)
+    assert str(caught.value) == "incident_owner_attestation_binding_invalid"
+

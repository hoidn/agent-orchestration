+def _attestation_pair(root: Path, baseline: str) -> tuple[bytes, bytes]:
+    """Pending and confirmed records bound to real immutable review files."""
+
+    from orchestrator.retirement.broad_evidence import derive_review_binding
+    from tests.test_retirement_attempt_migration import _review
+
+    data = (root / baseline).read_bytes()
+    digest = "sha256:" + __import__("hashlib").sha256(data).hexdigest()
+    evidence_root = Path(baseline).parent.parent  # outside the attempt source root
+    bindings = {}
+    written: list[str] = []
+    for key, kind, name in (
+        ("specification_review_binding", "specification", "implementation-baseline-specification"),
+        ("quality_review_binding", "code_quality", "implementation-baseline-quality"),
+    ):
+        review = _review(kind, baseline, data, f"{kind}-reviewer",
+                         subject_kind="implementation_failure_baseline")
+        # reviews must precede the fixture attestation's prepared_at
+        parsed = json.loads(review)
+        parsed["reviewed_at"] = f"2025-12-31T00:0{len(bindings)}:00+00:00"
+        review = json.dumps(parsed, sort_keys=True, separators=(",", ":")).encode() + b"\n"
+        logical = evidence_root / "reviews" / f"{name}.json"
+        binding = derive_review_binding(
+            evidence_root=evidence_root, review_path=logical, review_bytes=review
+        )
+        for path in (logical.as_posix(), binding["immutable_path"]):
+            _write(root, path, review)
+            written.append(path)
+        bindings[key] = binding
+    out = []
+    for name in ("pending", "confirmed"):
+        record = json.loads((FIXTURES / f"broad_failure_baseline_attestation.{name}.v1.json").read_text())
+        record["baseline_binding"].update({"path": baseline, "sha256": digest})
+        record.update(bindings)
+        out.append(json.dumps(record, sort_keys=True).encode() + b"\n")
+    _git(root, "add", *written)
+    _git(root, "commit", "-q", "-m", "baseline reviews")
+    return out[0], out[1]

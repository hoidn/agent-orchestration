+def test_v2_record_with_v1_roles_is_rejected(incident_repository: dict) -> None:
+    args = incident_repository
+    result = _capture_v2(args)
+    record = deepcopy(result["disposition"])
+    del record["attempt_lifecycle"]
+    record["normalized_disposition_sha256"] = canonical_sha256(
+        record, exclude={"normalized_disposition_sha256"}
+    )
+    (args["root"] / args["disposition_path"]).write_bytes(
+        json.dumps(record, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode() + b"\n"
+    )
+    with pytest.raises(am.AttemptMigrationError):
+        am.validate(args["root"], args["disposition_path"])
+

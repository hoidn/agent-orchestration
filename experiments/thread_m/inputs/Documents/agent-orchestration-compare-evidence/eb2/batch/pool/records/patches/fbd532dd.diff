+
+def _cross_link(record: Mapping[str, Any], incident: Mapping[str, Any]) -> None:
+    attempt = record["attempt_binding"]
+    artifacts = attempt["artifact_bindings"]
+    manifest = attempt["expected_paths_manifest_binding"]
+    identity = ("path", "size", "sha256")
+    pairs = [
+        (incident["governing_plan_binding"], record["governing_plan_binding"]),
+        (incident["migration_plan_binding"], record["migration_plan_binding"]),
+        (
+            {key: incident["expected_paths_manifest_binding"][key] for key in identity},
+            {key: manifest[key] for key in identity},
+        ),
+    ]
+    for name, role in (
+        ("workspace_baseline", "workspace_baseline"),
+        ("owner_attestation", "attestation_record"),
+        ("pending_attestation_snapshot", "attestation_snapshot"),
+        ("known_failure_baseline", "baseline"),
+    ):
+        pairs.append(
+            (incident[f"{name}_binding"], {key: artifacts[role][key] for key in identity})
+        )
+    rows = [
+        {
+            "path": row["original_path"],
+            **{key: row[key] for key in ("file_type", "lstat_mode", "size", "sha256", "tracked_state")},
+        }
+        for row in record["attempt_rows"]
+    ]
+    if (
+        any(left != right for left, right in pairs)
+        or incident["source_root"] != attempt["source_root"]
+        or incident["pre_move_repository_state"] != record["pre_move_repository_state"]
+        or incident["attempt_rows"] != rows
+    ):
+        raise _fail("attempt_lifecycle_incident_mismatch")

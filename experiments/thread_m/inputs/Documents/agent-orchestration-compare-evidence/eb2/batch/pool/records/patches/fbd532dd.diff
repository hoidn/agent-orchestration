@@ -0,0 +1,111 @@
+"""Scoped path-to-bytes overlay for retirement evidence validators.
+
+Validators read bound files through a handful of low-level readers.  Those
+readers consult the overlay installed here, so a caller can re-derive evidence
+from archived bytes without moving them back.  Git-derived checks do not use it.
+
+Depends on: the Git object database of ``root`` (only when
+``require_committed_fallback`` is set) and the live file at the queried path.
+"""
+
+from __future__ import annotations
+
+import subprocess
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable, Iterator, Mapping
+
+
+@dataclass(frozen=True)
+class Overlay:
+    root: Path
+    files: Mapping[str, bytes]
+    require_committed_fallback: bool
+
+
+_CURRENT: ContextVar[Overlay | None] = ContextVar("retirement_byte_overlay", default=None)
+
+
+def current() -> Overlay | None:
+    return _CURRENT.get()
+
+
+@contextmanager
+def use_overlay(
+    root: Path,
+    files: Mapping[str, bytes] | None,
+    require_committed_fallback: bool = False,
+) -> Iterator[None]:
+    """Install ``files`` on top of any outer overlay for the dynamic extent."""
+
+    outer = _CURRENT.get()
+    if not files and not require_committed_fallback:
+        yield
+        return
+    merged = {**(outer.files if outer else {}), **dict(files or {})}
+    token = _CURRENT.set(
+        Overlay(
+            Path(root),
+            merged,
+            require_committed_fallback
+            or (outer is not None and outer.require_committed_fallback),
+        )
+    )
+    try:
+        yield
+    finally:
+        _CURRENT.reset(token)
+
+
+def committed_identical(root: Path, path: str, data: bytes) -> bool:
+    """True when ``path`` is a regular blob at HEAD whose bytes equal ``data``."""
+
+    listing = subprocess.run(
+        ["git", "ls-tree", "-z", "HEAD", "--", path],
+        cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    fields = listing.stdout.split(b"\0")[0].split(b"\t", 1)
+    if listing.returncode != 0 or len(fields) != 2 or fields[1].decode("utf-8", "replace") != path:
+        return False
+    mode, kind, _oid = fields[0].decode("ascii").split(" ")
+    if kind != "blob" or mode not in {"100644", "100755"}:
+        return False
+    blob = subprocess.run(
+        ["git", "show", f"HEAD:{path}"],
+        cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    return blob.returncode == 0 and blob.stdout == data
+
+
+def read(path: str, live: Callable[[], bytes | None]) -> bytes | None:
+    """Bytes for ``path`` through the active overlay, else through ``live``."""
+
+    overlay = _CURRENT.get()
+    if overlay is None:
+        return live()
+    if path in overlay.files:
+        return overlay.files[path]
+    data = live()
+    if (
+        data is not None
+        and overlay.require_committed_fallback
+        and not committed_identical(overlay.root, path, data)
+    ):
+        return None
+    return data
+
+
+def names_in(directory: str) -> list[str]:
+    """Overlay-mapped file names directly under ``directory``."""
+
+    overlay = _CURRENT.get()
+    if overlay is None:
+        return []
+    prefix = "" if directory in {"", "."} else directory + "/"
+    return sorted(
+        path[len(prefix):]
+        for path in overlay.files
+        if path.startswith(prefix) and "/" not in path[len(prefix):]
+    )

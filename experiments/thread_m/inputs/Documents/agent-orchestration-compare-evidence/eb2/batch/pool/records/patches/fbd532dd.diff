+def _require_incident_untracked(root: Path, path: str) -> None:
+    rows = _repository_state(root)["status_projection"]["rows"]
+    mine = [row for row in rows if path in (row["path"], row["source_path"])]
+    if mine != [{"path": path, "source_path": None, "status": "??"}] or _is_tracked(
+        root, path
+    ):
+        raise _fail("incident_output_state_invalid", path)

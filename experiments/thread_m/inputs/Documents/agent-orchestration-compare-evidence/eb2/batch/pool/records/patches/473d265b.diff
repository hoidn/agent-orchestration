+def capture_invalidated_adopted(
+    repository_root: Path | str, *,
+    incident_path: Path | str, disposition_path: Path | str,
+    source_root: Path | str, archive_root: Path | str,
+    governing_plan_path: Path | str, migration_plan_path: Path | str,
+    authority_subject_path: Path | str, authority_specification_review_path: Path | str,
+    authority_quality_review_path: Path | str, intended_predecessor_head: str,
+    restoration_commit: str, restoration_tree: str,
+    expected_paths_manifest_path: Path | str, protected_paths: Sequence[Path | str],
+    generation5_request_path: Path | str, generation5_snapshot_path: Path | str,
+    generation11_request_path: Path | str, generation11_snapshot_path: Path | str,
+    live_ledger_path: Path | str, baseline_path: Path | str,
+    baseline_specification_review_path: Path | str, baseline_quality_review_path: Path | str,
+    workspace_baseline_path: Path | str, attestation_request_path: Path | str,
+    attestation_snapshot_path: Path | str, attestation_record_path: Path | str,
+) -> dict[str, Any]:
+    """Publish incident then disposition, resuming only the exact publication prefix."""
+    root = _repository_root(repository_root)
+    incident_relative = _relative_path(incident_path)
+    disposition_relative = _relative_path(disposition_path)
+    if incident_relative == disposition_relative:
+        raise AttemptMigrationError("output_path_overlap")
+    for output in (incident_relative, disposition_relative):
+        _reject_output_overlap(output, _relative_path(source_root), _relative_path(archive_root))
+    if _is_tracked(root, incident_relative):
+        raise AttemptMigrationError("incident_output_state_invalid")
+    before = _repository_state(root)
+    for row in before["status_projection"]["rows"]:
+        if incident_relative in {row["path"], row["source_path"]} and (
+            row["path"] != incident_relative or row["source_path"] is not None or row["status"] != "??"
+        ):
+            raise AttemptMigrationError("incident_output_state_invalid")
+    existing_incident = _read_regular(root, incident_relative, missing_ok=True)
+    existing_disposition = _read_regular(root, disposition_relative, missing_ok=True)
+    if existing_disposition is not None and existing_incident is None:
+        raise AttemptMigrationError("incident_missing")
+    coordinates = dict(
+        governing_plan_path=governing_plan_path, migration_plan_path=migration_plan_path,
+        workspace_baseline_path=workspace_baseline_path, owner_attestation_path=attestation_record_path,
+        pending_attestation_snapshot_path=attestation_snapshot_path, known_failure_baseline_path=baseline_path,
+        expected_paths_manifest_path=expected_paths_manifest_path, source_root=source_root,
+        intended_predecessor_head=intended_predecessor_head,
+    )
+    incident = build_attempt_migration_incident(root, **coordinates)
+    _require_source_file_coverage(root, _relative_path(source_root), [row["path"] for row in incident["attempt_rows"]])
+    if existing_incident is not None:
+        if {"path": incident_relative, "source_path": None, "status": "??"} not in before["status_projection"]["rows"]:
+            raise AttemptMigrationError("incident_output_state_invalid")
+        captured = _json_bytes(existing_incident["data"], incident_relative)
+        if existing_incident["lstat_mode"] != 0o644 or existing_incident["data"] != _canonical_json(captured) + b"\n":
+            raise AttemptMigrationError("incident_output_conflict")
+        ignored = {incident_relative}
+        if existing_disposition is not None:
+            ignored.add(disposition_relative)
+        if _state_without_paths(before, ignored) != captured.get("pre_move_repository_state"):
+            raise AttemptMigrationError("incident_publication_state_changed")
+        incident["pre_move_repository_state"] = captured["pre_move_repository_state"]
+        incident["normalized_incident_sha256"] = _canonical_digest(incident, exclude="normalized_incident_sha256")
+        if incident != captured:
+            raise AttemptMigrationError("incident_output_conflict")
+    incident_bytes = _canonical_json(incident) + b"\n"
+    incident_binding = {"path": incident_relative, "size": len(incident_bytes), "sha256": _bytes_digest(incident_bytes)}
+    disposition = _build_adopted_disposition(
+        root, disposition_path=disposition_relative, source_root=source_root, archive_root=archive_root,
+        governing_plan_path=governing_plan_path, migration_plan_path=migration_plan_path,
+        authority_subject_path=authority_subject_path,
+        authority_specification_review_path=authority_specification_review_path,
+        authority_quality_review_path=authority_quality_review_path,
+        restoration_commit=restoration_commit, restoration_tree=restoration_tree,
+        expected_paths_manifest_path=expected_paths_manifest_path, protected_paths=protected_paths,
+        generation5_request_path=generation5_request_path, generation5_snapshot_path=generation5_snapshot_path,
+        generation11_request_path=generation11_request_path, generation11_snapshot_path=generation11_snapshot_path,
+        live_ledger_path=live_ledger_path, baseline_path=baseline_path,
+        baseline_specification_review_path=baseline_specification_review_path,
+        baseline_quality_review_path=baseline_quality_review_path, workspace_baseline_path=workspace_baseline_path,
+        attestation_request_path=attestation_request_path, attestation_snapshot_path=attestation_snapshot_path,
+        attestation_record_path=attestation_record_path, incident=incident, incident_binding=incident_binding,
+    )
+    _validate_adopted_evidence(root, disposition, incident=incident)
+    disposition_bytes = _canonical_json(disposition) + b"\n"
+    if existing_disposition is not None and (
+        existing_disposition["data"] != disposition_bytes or existing_disposition["lstat_mode"] != 0o644
+    ):
+        raise AttemptMigrationError("disposition_output_conflict")
+    if _repository_state(root) != before:
+        raise AttemptMigrationError("incident_publication_state_changed")
+    if existing_incident is None:
+        _publish_exclusive(root, incident_relative, incident_bytes, 0o644)
+    if existing_disposition is None:
+        _publish_exclusive(root, disposition_relative, disposition_bytes, 0o644)
+    return {"incident": incident, "disposition": disposition}
+

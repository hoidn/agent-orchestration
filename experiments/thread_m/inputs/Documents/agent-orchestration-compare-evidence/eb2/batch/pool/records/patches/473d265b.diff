+from __future__ import annotations
+
+from copy import deepcopy
+from pathlib import Path
+import subprocess
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+from tests.test_retirement_adopted_migration import adopted_repository
+from tests.test_retirement_attempt_migration import _git
+
+
+def status(root: Path) -> bytes:
+    return _git(root, 'status', '--porcelain=v1', '-z', '--untracked-files=all')
+
+
+def test_incident_only_crash_replay_completes_exact_publication(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    expected = migration.capture_invalidated_adopted(**arguments)
+    incident = tmp_path / arguments['incident_path']
+    disposition = tmp_path / arguments['disposition_path']
+    complete_status = status(tmp_path)
+    incident_bytes, incident_mtime = incident.read_bytes(), incident.stat().st_mtime_ns
+    disposition_bytes = disposition.read_bytes()
+    disposition.unlink()
+
+    assert migration.capture_invalidated_adopted(**arguments) == expected
+    assert incident.read_bytes() == incident_bytes
+    assert incident.stat().st_mtime_ns == incident_mtime
+    assert disposition.read_bytes() == disposition_bytes
+    assert status(tmp_path) == complete_status
+
+
+def test_incident_only_crash_replay_rejects_new_untracked_path(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    migration.capture_invalidated_adopted(**arguments)
+    disposition = tmp_path / arguments['disposition_path']
+    disposition.unlink()
+    (tmp_path / 'new-untracked.txt').write_text('arrived after incident publication\n')
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(**arguments)
+    assert not disposition.exists()
+    assert status(tmp_path) == before
+
+
+def test_disposition_without_incident_is_not_repaired(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    migration.capture_invalidated_adopted(**arguments)
+    incident = tmp_path / arguments['incident_path']
+    disposition = tmp_path / arguments['disposition_path']
+    disposition_bytes = disposition.read_bytes()
+    incident.unlink()
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(**arguments)
+    assert not incident.exists()
+    assert disposition.read_bytes() == disposition_bytes
+    assert status(tmp_path) == before
+
+
+@pytest.mark.parametrize('output', ['incident_path', 'disposition_path'])
+def test_capture_replay_rejects_one_byte_output_tamper(tmp_path: Path, output: str) -> None:
+    arguments = adopted_repository(tmp_path)
+    migration.capture_invalidated_adopted(**arguments)
+    path = tmp_path / arguments[output]
+    changed = path.read_bytes() + b' '
+    path.write_bytes(changed)
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(**arguments)
+    assert path.read_bytes() == changed
+    assert status(tmp_path) == before
+
+
+@pytest.mark.parametrize('committed', [False, True], ids=['staged', 'tracked'])
+def test_incident_only_replay_rejects_staged_or_tracked_incident(tmp_path: Path, committed: bool) -> None:
+    arguments = adopted_repository(tmp_path)
+    migration.capture_invalidated_adopted(**arguments)
+    disposition = tmp_path / arguments['disposition_path']
+    disposition.unlink()
+    _git(tmp_path, 'add', '--', arguments['incident_path'])
+    if committed:
+        _git(tmp_path, 'commit', '-qm', 'incident already committed')
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(**arguments)
+    assert not disposition.exists()
+    assert status(tmp_path) == before
+
+
+@pytest.mark.parametrize('substitution', ['missing_lifecycle', 'v1_artifact_roles'])
+def test_v2_public_validation_rejects_v1_field_substitution(tmp_path: Path, substitution: str) -> None:
+    arguments = adopted_repository(tmp_path)
+    result = migration.capture_invalidated_adopted(**arguments)
+    record = deepcopy(result['disposition'])
+    if substitution == 'missing_lifecycle':
+        record.pop('attempt_lifecycle')
+    else:
+        artifacts = record['attempt_binding']['artifact_bindings']
+        record['attempt_binding']['artifact_bindings'] = {
+            'baseline': artifacts['baseline'],
+            'baseline_specification_review': artifacts['baseline_specification_review'],
+            'baseline_quality_review': artifacts['baseline_quality_review'],
+            'pending_request': artifacts['attestation_request'],
+            'pending_snapshot': artifacts['attestation_snapshot'],
+            'pending_record': artifacts['attestation_record'],
+        }
+    record['normalized_disposition_sha256'] = migration._canonical_digest(record, exclude='normalized_disposition_sha256')
+    (tmp_path / arguments['disposition_path']).write_bytes(migration._canonical_json(record) + b'\n')
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.validate(tmp_path, arguments['disposition_path'])
+
+
+def test_adopted_capture_rejects_pending_owner_without_publication(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    owner = tmp_path / arguments['attestation_record_path']
+    owner.write_bytes((tmp_path / arguments['attestation_snapshot_path']).read_bytes())
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError, match='^incident_owner_lifecycle_invalid$'):
+        migration.capture_invalidated_adopted(**arguments)
+    assert not (tmp_path / arguments['incident_path']).exists()
+    assert not (tmp_path / arguments['disposition_path']).exists()
+    assert status(tmp_path) == before
+
+
+def test_incident_only_crash_replay_requires_visible_untracked_incident(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    migration.capture_invalidated_adopted(**arguments)
+    disposition = tmp_path / arguments['disposition_path']
+    disposition.unlink()
+    with (tmp_path / '.git/info/exclude').open('a') as exclusions:
+        exclusions.write('\n/' + arguments['incident_path'] + '\n')
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError, match='^incident_output_state_invalid$'):
+        migration.capture_invalidated_adopted(**arguments)
+    assert not disposition.exists()
+    assert status(tmp_path) == before
+
+
+def ignored_attempt_extra(root: Path) -> None:
+    with (root / '.git/info/exclude').open('a') as exclusions:
+        exclusions.write('\n/evidence/extra-ignored.json\n')
+    (root / 'evidence/extra-ignored.json').write_bytes(b'unreviewed attempt file\n')
+
+
+def test_capture_rejects_ignored_attempt_extra_without_publication(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    ignored_attempt_extra(tmp_path)
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.capture_invalidated_adopted(**arguments)
+    assert not (tmp_path / arguments['incident_path']).exists()
+    assert not (tmp_path / arguments['disposition_path']).exists()
+    assert status(tmp_path) == before
+
+
+def test_public_validation_rejects_ignored_attempt_extra(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path)
+    migration.capture_invalidated_adopted(**arguments)
+    ignored_attempt_extra(tmp_path)
+    before = status(tmp_path)
+
+    with pytest.raises(migration.AttemptMigrationError):
+        migration.validate(tmp_path, arguments['disposition_path'])
+    assert status(tmp_path) == before
+
+
+def test_public_validation_rejects_candidate_index_drift_with_identical_status(tmp_path: Path) -> None:
+    arguments = adopted_repository(tmp_path, staged_candidate=True)
+    migration.capture_invalidated_adopted(**arguments)
+    before = status(tmp_path)
+    candidate = tmp_path / 'source.py'
+    worktree_bytes = candidate.read_bytes()
+    assert b'AM source.py\0' in before
+    blob = subprocess.check_output(
+        ['git', 'hash-object', '-w', '--stdin'], cwd=tmp_path,
+        input=b'different staged candidate\n',
+    ).decode().strip()
+    _git(tmp_path, 'update-index', '--cacheinfo', f'100644,{blob},source.py')
+    assert status(tmp_path) == before
+    assert candidate.read_bytes() == worktree_bytes
+
+    with pytest.raises(migration.AttemptMigrationError, match='^outside_status_projection_changed$'):
+        migration.validate(tmp_path, arguments['disposition_path'])
+    assert status(tmp_path) == before
+    assert candidate.read_bytes() == worktree_bytes

+    _rebind_archived(root, arguments, result, replacements)
+    with pytest.raises(migration.AttemptMigrationError, match='semantic_coordinate_row_binding_mismatch:' + expected_role):
+        migration.validate(root, arguments['disposition_path'])
+
+

+    root, arguments, result = archived_attempt
+    path = Path(arguments[role]).as_posix()
+    row = next(row for row in result['disposition']['attempt_rows'] if row['original_path'] == path)
+    (root / row['archive_path']).unlink()
+    with pytest.raises(migration.AttemptMigrationError, match='attempt_row_state_invalid'):
+        migration.validate(root, arguments['disposition_path'])
+
+
+@pytest.mark.parametrize('defect', ['swap', 'duplicate_snapshot', 'noncontiguous', 'wrong_parent_request', 'wrong_parent_snapshot'])
+def test_postarchive_revalidates_rebound_generation_coordinates(archived_attempt, defect):
+    root, arguments, result = archived_attempt
+    request_path = Path(arguments['generation11_request_path']).as_posix()
+    snapshot_path = Path(arguments['generation11_snapshot_path']).as_posix()
+    ledger_path = Path(arguments['live_ledger_path']).as_posix()
+    by_path = {row['original_path']: row for row in result['disposition']['attempt_rows']}
+    request = (root / by_path[request_path]['archive_path']).read_bytes()
+    snapshot = (root / by_path[snapshot_path]['archive_path']).read_bytes()
+    expected_role = 'generation11_request'
+    if defect == 'swap':
+        replacements = {request_path: snapshot, snapshot_path: request, ledger_path: request}
+    elif defect == 'duplicate_snapshot':
+        replacements = {snapshot_path: request, ledger_path: request}
+        expected_role = 'generation11_snapshot'
+    else:
+        record = migration._json_bytes(request, request_path)
+        prior = record['prior_generation_binding']
+        if defect == 'noncontiguous':
+            prior['generation'] -= 1
+        else:
+            field = 'request_path' if defect == 'wrong_parent_request' else 'snapshot_path'
+            prior[field] = 'wrong-parent/' + Path(prior[field]).name
+        record['normalized_request_sha256'] = migration._canonical_digest(record, exclude='normalized_request_sha256')

+from __future__ import annotations
+
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+from orchestrator.retirement import broad_evidence as broad
+from orchestrator.retirement import source_bindings
+from tests.test_retirement_broad_evidence import (
+    _producer_candidate_and_ledger, _producer_broad_builder_inputs,
+    _write_producer_json, _publish_producer_review_pair,
+    _PRODUCER_FAILURE_NODE_IDS, _git_output, _bind_candidate_to_repository,
+)
+
+
+def incident_repository(root: Path, *, ledger_generation: int = 1, candidate_and_ledger: tuple | None = None) -> dict:
+    candidate, ledger = candidate_and_ledger or _producer_candidate_and_ledger(root, ledger_generation=ledger_generation)
+    workspace = source_bindings.capture_workspace_baseline(root)
+    (root / 'uncovered.txt').write_text('uncontrolled intervening change\n')
+    _git_output(root, 'add', '--', 'uncovered.txt')
+    _git_output(root, 'commit', '-qm', 'uncontrolled intervening change', '--only', '--', 'uncovered.txt')
+    _bind_candidate_to_repository(root, candidate)
+    outcome = broad.build_broad_outcome(**_producer_broad_builder_inputs(root, candidate, ledger))
+    _write_producer_json(root, 'evidence/implementation-baseline/outcome.json', outcome)
+    baseline = broad.build_broad_known_failure_baseline(
+        repository_root=root, broad_outcome_path='evidence/implementation-baseline/outcome.json',
+        ownership_classifications=[dict(node_id=node, ownership_class='queue_owned',
+            ownership_basis=['source.py'], authorized_remediation_scope=['source.py'])
+            for node in _PRODUCER_FAILURE_NODE_IDS])
+    baseline_path = 'evidence/implementation-baseline/known-failure-baseline.json'
+    _write_producer_json(root, baseline_path, baseline)
+    specification, quality = _publish_producer_review_pair(root,
+        evidence_root=Path('evidence/implementation-baseline'), subject_path=Path(baseline_path),
+        subject_kind='implementation_failure_baseline', specification_name='implementation-baseline-specification.json', quality_name='implementation-baseline-quality.json')
+    owner = dict(schema_version='broad_failure_baseline_attestation.v1', evidence_status='owner_confirmed',
+        baseline_binding=dict(path=baseline_path, sha256=broad.file_sha256(root / baseline_path),
+            schema_version='broad_known_failure_baseline.v1', candidate_path_set_sha256=candidate['candidate_path_set_sha256']),
+        failure_set_binding=dict(failure_count=len(baseline['failures']), normalized_failure_set_sha256=baseline['normalized_failure_set_sha256']),
+        normalization_binding=dict(schema_version='broad_failure_payload_normalization.v1', normalized_contract_sha256=baseline['failure_normalization']['normalized_contract_sha256']),
+        classification_summary=baseline['classification_summary'], specification_review_binding=specification,
+        quality_review_binding=quality, prepared_by=dict(identity='preparer'), prepared_at='2026-01-01T00:00:00+00:00',
+        owner=dict(identity='Owner', role='owner'), owner_confirmations=dict(
+            exact_failure_table_confirmed=True, normalization_contract_confirmed=True,
+            classification_partition_confirmed=True, reviews_confirmed=True, comparison_only_confirmed=True,
+            no_out_of_scope_repair_confirmed=True, confirmed_at='2026-01-01T00:00:01+00:00'),
+        owner_adoption=dict(identity='Owner', statement='I adopt this baseline.', adopted_at='2026-01-01T00:00:02+00:00'),
+        claims_not_made=list(broad.FAILURE_BASELINE_ATTESTATION_CLAIMS_NOT_MADE))
+    pending = deepcopy(owner)
+    pending.update(evidence_status='pending_owner_confirmation', owner=None, owner_adoption=None)
+    pending['owner_confirmations'] = {key: None if key == 'confirmed_at' else False for key in owner['owner_confirmations']}
+    _write_producer_json(root, 'evidence/owner.json', owner)
+    _write_producer_json(root, 'evidence/pending.json', pending)
+    _write_producer_json(root, 'evidence/workspace.json', workspace)
+    (root / 'migration.md').write_text('migration authority\n')
+    paths = migration._scan_regular_files(root, 'evidence')
+    (root / 'expected.txt').write_text('\n'.join(paths) + '\n')
+    return dict(repository_root=root, governing_plan_path='plan.md', migration_plan_path='migration.md',
+        workspace_baseline_path='evidence/workspace.json', owner_attestation_path='evidence/owner.json',
+        pending_attestation_snapshot_path='evidence/pending.json', known_failure_baseline_path=baseline_path,
+        expected_paths_manifest_path='expected.txt', source_root='evidence',
+        intended_predecessor_head=_git_output(root, 'rev-parse', 'HEAD').decode().strip())
+
+
+def test_incident_build_reopens_bound_evidence_and_preserves_capture(tmp_path: Path) -> None:
+    from orchestrator.retirement.attempt_incident import build_attempt_migration_incident, validate_attempt_migration_incident
+    arguments = incident_repository(tmp_path)
+    record = build_attempt_migration_incident(**arguments)
+    assert record['adoption_facts']['owner_identity'] == 'Owner'
+    assert record['predecessor_projection']['uncovered_paths'] == ['uncovered.txt']
+    assert validate_attempt_migration_incident(tmp_path, record) is record
+    original = (tmp_path / 'expected.txt').read_bytes()
+    (tmp_path / 'expected.txt').write_bytes(original + b'\n')
+    with pytest.raises(migration.AttemptMigrationError, match='incident_expected_paths_manifest_binding_invalid'):
+        validate_attempt_migration_incident(tmp_path, record)

+
+
+@pytest.fixture
+def archived_attempt(tmp_path):
+    arguments = adopted_repository(tmp_path)
+    result = migration.capture_invalidated_adopted(**arguments)
+    disposition_path = arguments['disposition_path']
+    for kind, path in [('specification', 'recovery/spec.json'), ('code_quality', 'recovery/quality.json')]:
+        _write(tmp_path, path, _review(kind, disposition_path, (tmp_path / disposition_path).read_bytes(),
+                                     kind, subject_kind='attempt_migration_disposition'))
+    _git(tmp_path, 'add', '--', disposition_path, 'recovery/spec.json', 'recovery/quality.json')
+    _git(tmp_path, 'commit', '-qm', 'reviewed recovery disposition')
+    migration.apply(tmp_path, disposition_path, 'recovery/spec.json', 'recovery/quality.json')
+    return tmp_path, arguments, result
+
+
+def _replace_binding_metadata(value, path, data):
+    if isinstance(value, dict):
+        if 'size' in value and 'sha256' in value and (value.get('path') == path or value.get('original_path') == path):
+            value.update(size=len(data), sha256=migration._bytes_digest(data))
+        for nested in value.values():
+            _replace_binding_metadata(nested, path, data)
+    elif isinstance(value, list):
+        for nested in value:
+            _replace_binding_metadata(nested, path, data)
+
+
+def _rebind_archived(root, arguments, result, replacements):
+    disposition = result['disposition']
+    incident = result['incident']
+    for path, data in replacements.items():
+        row = next(row for row in disposition['attempt_rows'] if row['original_path'] == path)
+        (root / row['archive_path']).write_bytes(data)
+        _replace_binding_metadata(disposition, path, data)
+        _replace_binding_metadata(incident, path, data)
+    incident['normalized_attempt_row_set_sha256'] = migration._canonical_digest(incident['attempt_rows'])
+    incident['normalized_incident_sha256'] = migration._canonical_digest(incident, exclude='normalized_incident_sha256')
+    incident_data = migration._canonical_json(incident) + b'\n'
+    (root / arguments['incident_path']).write_bytes(incident_data)
+    disposition['attempt_lifecycle']['incident_binding'].update(size=len(incident_data), sha256=migration._bytes_digest(incident_data))
+    disposition['normalized_row_set_sha256'] = migration._canonical_digest(disposition['attempt_rows'])
+    disposition['normalized_disposition_sha256'] = migration._canonical_digest(disposition, exclude='normalized_disposition_sha256')
+    (root / arguments['disposition_path']).write_bytes(migration._canonical_json(disposition) + b'\n')
+
+

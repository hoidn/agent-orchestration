     return matches[0].group(1).decode("ascii"), "sha256:" + matches[0].group(2).decode("ascii")
 
 
+def derive_committed_predecessor_lineage(
+    repository_root: Path | str,
+    *,
+    baseline_head: str,
+    intended_predecessor_head: str,
+    require_uncovered_paths: bool = False,
+) -> dict[str, Any]:
+    """Bind the first-parent delta and distinguish controlled from uncovered paths."""
+    root = _repository_root(repository_root)
+    baseline = _git(root, "rev-parse", "--verify", baseline_head + "^{commit}").decode("ascii").strip()
+    predecessor = _git(root, "rev-parse", "--verify", intended_predecessor_head + "^{commit}").decode("ascii").strip()
+    _git(root, "merge-base", "--is-ancestor", baseline, predecessor)
+    _git(root, "rev-list", "--objects", "--missing=error", f"{baseline}..{predecessor}")
+    commits = _git(
+        root, "rev-list", "--first-parent", "--reverse", "--parents",
+        f"{baseline}..{predecessor}",
+    ).decode("ascii").splitlines()
+    rows: list[dict[str, Any]] = []
+    controlled: set[str] = set()
+    uncovered: set[str] = set()
+    previous = baseline
+    trailer_pattern = re.compile(
+        rb"\n\nRetirement-Control-Schema: precommit_control\.v1\n"
+        rb"Retirement-Transaction-ID: ([0-9a-f]{64})\n"
+        rb"Retirement-Control-SHA256: ([0-9a-f]{64})\n\Z"
+    )
+    for commit_line in commits:
+        fields = commit_line.split()
+        if len(fields) != 2:
+            raise SourceBindingError("predecessor_lineage_merge")
+        commit, parent = fields
+        if parent != previous:
+            raise SourceBindingError("predecessor_first_parent_ancestry_invalid")
+        message = _raw_commit_message(root, commit)
+        trailer = trailer_pattern.search(message)
+        coordinates = None
+        if trailer is not None:
+            if re.search(rb"(?m)^Retirement-(?:Control-|Transaction-ID:)", message[:trailer.start()]):
+                raise SourceBindingError("commit_control_trailer_invalid")
+            coordinates = {
+                "transaction_id": trailer.group(1).decode("ascii"),
+                "normalized_control_sha256": "sha256:" + trailer.group(2).decode("ascii"),
+            }
+        elif re.search(rb"(?m)^Retirement-(?:Control-|Transaction-ID:)", message):
+            raise SourceBindingError("commit_control_trailer_invalid")
+        raw_paths = _git(
+            root, "diff-tree", "--no-commit-id", "--name-only", "--no-renames",
+            "-r", "-z", parent, commit,
+        )
+        paths = sorted(_decode_path(path) for path in raw_paths.split(b"\0") if path)
+        if len(paths) != len(set(paths)):
+            raise SourceBindingError("duplicate_committed_path")
+        (controlled if coordinates is not None else uncovered).update(paths)
+        rows.append({
+            "commit": commit,
+            "parent": parent,
+            "tree": _git(root, "rev-parse", "--verify", commit + "^{tree}").decode("ascii").strip(),
+            "raw_message_sha256": _sha256_bytes(message),
+            "changed_paths": paths,
+            "changed_path_set_sha256": _path_list_digest(paths),
+            "control_coordinates": coordinates,
+        })
+        previous = commit
+    if previous != predecessor:
+        raise SourceBindingError("predecessor_first_parent_ancestry_invalid")
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("predecessor_uncovered_paths_missing")
+    changed = sorted(controlled | uncovered)
+    result = {
+        "baseline_head": baseline,
+        "intended_predecessor_head": predecessor,
+        "intended_predecessor_tree": _git(root, "rev-parse", "--verify", predecessor + "^{tree}").decode("ascii").strip(),
+        "first_parent_commits": rows,
+        "commit_count": len(rows),
+        "changed_paths": changed,
+        "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": sorted(controlled),
+        "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": sorted(uncovered),
+        "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    result["normalized_projection_sha256"] = _canonical_sha256(result)
+    return result

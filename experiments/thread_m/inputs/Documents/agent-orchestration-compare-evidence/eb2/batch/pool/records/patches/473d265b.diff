+# Keep one logical view through recursive evidence and materialization validation.
+_BOUND_FILE_VIEW: ContextVar[tuple[Path, Mapping[str, bytes], bool] | None] = ContextVar(
+    "retirement_bound_file_view", default=None
+)
+
+
+def _bound_file_view(repository_root: Path) -> tuple[Mapping[str, bytes], bool] | None:
+    view = _BOUND_FILE_VIEW.get()
+    if view is not None and view[0] == repository_root.resolve():
+        return view[1], view[2]
+    return None
+
+
+def _with_bound_file_view(function):
+    call_signature = signature(function)
+
+    @wraps(function)
+    def validate(*args, **kwargs):
+        arguments = call_signature.bind(*args, **kwargs).arguments
+        root = Path(arguments["repository_root"]).resolve()
+        inherited = _bound_file_view(root)
+        overlay = arguments.get("bound_file_bytes")
+        strict = arguments.get("require_committed_fallback", False)
+        if overlay is None and not strict:
+            return function(*args, **kwargs)
+        bound = dict(inherited[0]) if inherited is not None else {}
+        bound.update(overlay or {})
+        token = _BOUND_FILE_VIEW.set(
+            (root, bound, strict or bool(inherited and inherited[1]))
+        )
+        try:
+            return function(*args, **kwargs)
+        finally:
+            _BOUND_FILE_VIEW.reset(token)
+
+    return validate
+
+
+def _read_evidence_file_no_follow(repository_root: Path, logical_path: Any) -> bytes | None:
+    if not _is_relative_logical_path(logical_path):
+        return None
+    view = _bound_file_view(repository_root)
+    if view is not None and logical_path in view[0]:
+        return view[0][logical_path]
+    data = _read_repository_file_no_follow(repository_root, logical_path)
+    if data is None or view is None or not view[1]:
+        return data
+    try:
+        entry = subprocess.run(
+            ["git", "--literal-pathspecs", "ls-tree", "-z", "HEAD", "--", logical_path],
+            cwd=repository_root, capture_output=True, check=True,
+        ).stdout
+        metadata, path = entry.rstrip(b"\0").split(b"\t", 1)
+        mode, object_type, oid = metadata.split()
+        if (
+            mode not in {b"100644", b"100755"}
+            or object_type != b"blob"
+            or path != os.fsencode(logical_path)
+        ):
+            return None
+        committed = subprocess.run(
+            ["git", "cat-file", "blob", oid.decode("ascii")],
+            cwd=repository_root, capture_output=True, check=True,
+        ).stdout
+        return data if data == committed else None
+    except (OSError, ValueError, subprocess.SubprocessError):
+        return None

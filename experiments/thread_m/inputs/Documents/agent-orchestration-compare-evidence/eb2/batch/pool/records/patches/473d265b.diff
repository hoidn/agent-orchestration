@@ -0,0 +1,307 @@
+"""Content-addressed evidence for an adopted attempt with an invalid predecessor."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from . import broad_evidence, source_bindings
+
+
+class AttemptMigrationError(RuntimeError):
+    """A closed migration precondition or replay check failed."""
+
+    def __init__(self, code: str, detail: str = "") -> None:
+        self.code = code
+        self.detail = detail
+        super().__init__(f"{code}:{detail}" if detail else code)
+
+
+SCHEMA_VERSION = "attempt_migration_incident.v1"
+CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+BINDING_NAMES = (
+    "governing_plan", "migration_plan", "workspace_baseline", "owner_attestation",
+    "pending_attestation_snapshot", "known_failure_baseline", "expected_paths_manifest",
+)
+TOP_LEVEL_KEYS = {
+    "schema_version", *(name + "_binding" for name in BINDING_NAMES), "source_root",
+    "intended_predecessor", "predecessor_projection", "pre_move_repository_state",
+    "attempt_rows", "attempt_path_count", "attempt_path_set_sha256",
+    "normalized_attempt_row_set_sha256", "adoption_facts", "normalized_incident_sha256",
+    "claims_not_made",
+}
+
+
+def _adoption_facts(owner: Mapping[str, Any]) -> dict[str, Any]:
+    from . import attempt_migration as migration
+
+    if (
+        owner.get("schema_version") != "broad_failure_baseline_attestation.v1"
+        or owner.get("evidence_status") != "owner_confirmed"
+        or broad_evidence.validate_record(owner)
+    ):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    return {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed",
+        "owner_identity": owner["owner"]["identity"],
+        "owner_role": owner["owner"]["role"],
+        "confirmed_at": owner["owner_confirmations"]["confirmed_at"],
+        "adopted_at": owner["owner_adoption"]["adopted_at"],
+    }
+
+
+def _read_binding(root: Path, binding: Any, name: str, *, bound_file_bytes: Mapping[str, bytes] | None, require_committed_fallback: bool) -> bytes:
+    from . import attempt_migration as migration
+
+    code = f"incident_{name}_binding_invalid"
+    try:
+        migration._validate_file_binding(binding, full=False)
+        path = binding["path"]
+        if bound_file_bytes is not None and path in bound_file_bytes:
+            data = bound_file_bytes[path]
+        elif require_committed_fallback:
+            data = migration._require_committed_live(root, path)["data"]
+        else:
+            data = migration._read_regular(root, path)["data"]
+        if not isinstance(data, bytes) or len(data) != binding["size"] or migration._bytes_digest(data) != binding["sha256"]:
+            raise migration.AttemptMigrationError(code)
+        return data
+    except (migration.AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+        raise migration.AttemptMigrationError(code) from exc
+
+
+def _historical_candidate_identity(root: Path, record: Mapping[str, Any]) -> bool:
+    from . import attempt_migration as migration
+
+    candidate = record.get("candidate_binding", {})
+    try:
+        head = candidate["head"]
+        current = migration._git(root, "rev-parse", "HEAD").decode("ascii").strip()
+        return (
+            head != current
+            and migration._git_is_ancestor(root, head, current)
+            and migration._git(root, "rev-parse", f"{head}^{{tree}}").decode("ascii").strip() == candidate["head_tree"]
+        )
+    except (KeyError, TypeError, migration.AttemptMigrationError):
+        return False
+
+
+def _bound_issues(root: Path, value: Mapping[str, Any], *, bound_file_bytes: Mapping[str, bytes] | None, require_committed_fallback: bool) -> list[Any]:
+    options: dict[str, Any] = {"bound_file_bytes": bound_file_bytes}
+    if require_committed_fallback:
+        options["require_committed_fallback"] = True
+    return broad_evidence.validate_bound_record(value, root, **options)
+
+
+def _reopen_evidence(root: Path, record: Mapping[str, Any], *, bound_file_bytes: Mapping[str, bytes] | None, require_committed_fallback: bool) -> dict[str, Any]:
+    from . import attempt_migration as migration
+
+    values: dict[str, Any] = {}
+    for name in BINDING_NAMES:
+        binding = record[name + "_binding"]
+        content_binding = {key: value for key, value in binding.items() if key != "row_count"} if isinstance(binding, Mapping) and name == "expected_paths_manifest" else binding
+        raw = _read_binding(root, content_binding, name, bound_file_bytes=bound_file_bytes, require_committed_fallback=require_committed_fallback)
+        if name in {"governing_plan", "migration_plan"}:
+            continue
+        try:
+            values[name] = migration._manifest_paths(raw, binding["path"]) if name == "expected_paths_manifest" else migration._json_bytes(raw, binding["path"])
+        except migration.AttemptMigrationError as exc:
+            raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid") from exc
+
+    workspace = values["workspace_baseline"]
+    if workspace.get("schema_version") not in {"workspace_baseline.v1", "bootstrap_workspace_baseline.v1"} or source_bindings.validate_workspace_record_shape(workspace):
+        raise migration.AttemptMigrationError("incident_workspace_baseline_binding_invalid")
+    facts = _adoption_facts(values["owner_attestation"])
+    if facts != record["adoption_facts"]:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    pending = values["pending_attestation_snapshot"]
+    if pending.get("evidence_status") != "pending_owner_confirmation" or broad_evidence.validate_record(pending):
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid")
+    lifecycle_fields = {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+    if {key: value for key, value in pending.items() if key not in lifecycle_fields} != {key: value for key, value in values["owner_attestation"].items() if key not in lifecycle_fields}:
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid")
+    baseline = values["known_failure_baseline"]
+    if baseline.get("schema_version") != "broad_known_failure_baseline.v1":
+        raise migration.AttemptMigrationError("incident_known_failure_baseline_binding_invalid")
+    issues = _bound_issues(root, baseline, bound_file_bytes=bound_file_bytes, require_committed_fallback=require_committed_fallback)
+    ignored = {"candidate_path_set_live_mismatch"}
+    if _historical_candidate_identity(root, baseline):
+        ignored.add("candidate_git_identity_mismatch")
+    # Reopen the nested outcome so historical candidate drift cannot mask defects.
+    expanded_issues = []
+    for issue in issues:
+        if issue.code == "bound_record_invalid" and issue.path == "$.broad_outcome_binding":
+            binding = baseline.get("broad_outcome_binding", {})
+            path = binding.get("path")
+            try:
+                if bound_file_bytes is not None and path in bound_file_bytes:
+                    raw = bound_file_bytes[path]
+                elif require_committed_fallback:
+                    raw = migration._require_committed_live(root, path)["data"]
+                else:
+                    raw = migration._read_regular(root, path)["data"]
+                outcome = migration._json_bytes(raw, path)
+                nested = _bound_issues(root, outcome, bound_file_bytes=bound_file_bytes, require_committed_fallback=require_committed_fallback)
+                if migration._bytes_digest(raw) == binding.get("sha256") and nested:
+                    expanded_issues.extend(nested)
+                    continue
+            except (migration.AttemptMigrationError, KeyError, TypeError):
+                pass
+        expanded_issues.append(issue)
+    codes = sorted({issue.code for issue in expanded_issues if issue.code not in ignored})
+    if codes:
+        raise migration.AttemptMigrationError("incident_known_failure_baseline_binding_invalid", ",".join(codes))
+    for name in ("owner_attestation", "pending_attestation_snapshot"):
+        if any(issue.code != "review_pair_subject_invalid" for issue in _bound_issues(root, values[name], bound_file_bytes=bound_file_bytes, require_committed_fallback=require_committed_fallback)):
+            raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid")
+    baseline_binding = values["owner_attestation"]["baseline_binding"]
+    if any(baseline_binding[key] != record["known_failure_baseline_binding"][key] for key in ("path", "sha256")):
+        raise migration.AttemptMigrationError("incident_owner_attestation_binding_invalid")
+    return values
+
+
+def _validate_state(root: Path, state: Any, source_root: str) -> None:
+    from . import attempt_migration as migration
+
+    migration._require_keys(state, {"head", "tree", "index_sha256", "status_projection"}, "incident_repository_state_invalid")
+    if not migration._is_commit_identity(state["head"]) or not migration._is_commit_identity(state["tree"]) or not migration._is_sha256(state["index_sha256"]):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    projection = migration._require_keys(state["status_projection"], {"rows", "row_count", "normalized_rows_sha256"}, "incident_repository_state_invalid")
+    rows = projection["rows"]
+    if not isinstance(rows, list) or type(projection["row_count"]) is not int or projection["row_count"] != len(rows) or projection["normalized_rows_sha256"] != migration._canonical_digest(rows):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    for row in rows:
+        migration._require_keys(row, {"path", "source_path", "status"}, "incident_repository_state_invalid")
+        migration._relative_path(row["path"])
+        if row["source_path"] is not None:
+            migration._relative_path(row["source_path"])
+        if not isinstance(row["status"], str) or not migration.GIT_STATUS_RE.fullmatch(row["status"]) or row["status"] == "  ":
+            raise migration.AttemptMigrationError("incident_repository_state_invalid")
+        rename = any(character in row["status"] for character in "RC")
+        if rename != (row["source_path"] is not None):
+            raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    identities = [(row["path"], row["source_path"] or "", row["status"]) for row in rows]
+    if identities != sorted(set(identities)):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    migration._validate_status_projection_boundaries(rows, source_root)
+    if migration._git(root, "rev-parse", f"{state['head']}^{{tree}}").decode("ascii").strip() != state["tree"]:
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    current_head = migration._git(root, "rev-parse", "HEAD").decode("ascii").strip()
+    if not migration._git_is_ancestor(root, state["head"], current_head):
+        raise migration.AttemptMigrationError("capture_head_not_ancestor")
+
+
+def validate_incident(repository_root: Path | str, record: Any, *, bound_file_bytes: Mapping[str, bytes] | None = None, attempt_rows: Sequence[Mapping[str, Any]] | None = None, require_committed_fallback: bool = False) -> dict[str, Any]:
+    """Validate an incident, optionally through exact disposition-bound bytes."""
+    from . import attempt_migration as migration
+
+    root = migration._repository_root(repository_root)
+    migration._require_keys(record, TOP_LEVEL_KEYS, "incident_keys_mismatch")
+    if record["schema_version"] != SCHEMA_VERSION or record["claims_not_made"] != CLAIMS_NOT_MADE:
+        raise migration.AttemptMigrationError("incident_schema_invalid")
+    if record["normalized_incident_sha256"] != migration._canonical_digest(record, exclude="normalized_incident_sha256"):
+        raise migration.AttemptMigrationError("incident_normalized_digest_mismatch")
+    source_root = migration._relative_path(record["source_root"])
+    for name in BINDING_NAMES:
+        binding = record[name + "_binding"]
+        keys = {"path", "size", "sha256"} | ({"row_count"} if name == "expected_paths_manifest" else set())
+        migration._require_keys(binding, keys, f"incident_{name}_binding_invalid")
+    values = _reopen_evidence(root, record, bound_file_bytes=bound_file_bytes, require_committed_fallback=require_committed_fallback)
+    predecessor = migration._require_keys(record["intended_predecessor"], {"head", "tree"}, "incident_intended_predecessor_invalid")
+    if not migration._is_commit_identity(predecessor["head"]) or not migration._is_commit_identity(predecessor["tree"]):
+        raise migration.AttemptMigrationError("incident_intended_predecessor_invalid")
+    try:
+        projection = source_bindings.derive_committed_predecessor_lineage(root, baseline_head=values["workspace_baseline"]["head"], intended_predecessor_head=predecessor["head"], require_uncovered_paths=True)
+    except source_bindings.SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_invalid", str(exc)) from exc
+    if migration._canonical_json(record["predecessor_projection"]) != migration._canonical_json(projection) or predecessor["tree"] != projection["intended_predecessor_tree"]:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_invalid")
+    _validate_state(root, record["pre_move_repository_state"], source_root)
+    if not migration._git_is_ancestor(root, predecessor["head"], record["pre_move_repository_state"]["head"]):
+        raise migration.AttemptMigrationError("incident_intended_predecessor_invalid")
+    rows = record["attempt_rows"]
+    if not isinstance(rows, list) or not rows:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    for row in rows:
+        migration._require_keys(row, {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}, "attempt_row_state_invalid")
+        migration._validate_file_binding({key: value for key, value in row.items() if key != "tracked_state"})
+        if row["tracked_state"] not in ("modified", "untracked") or not migration._under(row["path"], source_root):
+            raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    paths = [row["path"] for row in rows]
+    if paths != sorted(set(paths)) or paths != values["expected_paths_manifest"]:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    if type(record["attempt_path_count"]) is not int or record["attempt_path_count"] != len(rows) or record["attempt_path_set_sha256"] != migration._canonical_digest(paths) or record["normalized_attempt_row_set_sha256"] != migration._canonical_digest(rows):
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    if type(record["expected_paths_manifest_binding"]["row_count"]) is not int or record["expected_paths_manifest_binding"]["row_count"] != len(rows):
+        raise migration.AttemptMigrationError("incident_expected_paths_manifest_binding_invalid")
+    migration._require_source_file_coverage(root, source_root, paths)
+    if attempt_rows is None:
+        if migration._status_paths(migration._repository_state(root)["status_projection"]["rows"], source_root) != paths:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid")
+        observed = []
+        for path in paths:
+            snapshot = migration._read_regular(root, path)
+            observed.append({**migration._public_binding(snapshot), "tracked_state": "modified" if migration._is_tracked(root, path) else "untracked"})
+    else:
+        observed = [{"path": row["original_path"], **{key: row[key] for key in ("file_type", "lstat_mode", "size", "sha256", "tracked_state")}} for row in attempt_rows]
+        for row in observed:
+            data = (bound_file_bytes or {}).get(row["path"])
+            if data is None or len(data) != row["size"] or migration._bytes_digest(data) != row["sha256"]:
+                raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    if observed != rows:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    return record
+
+
+def validate_attempt_migration_incident(repository_root: Path | str, record: Any) -> dict[str, Any]:
+    return validate_incident(repository_root, record)
+
+
+def build_attempt_migration_incident(repository_root: Path | str, *, governing_plan_path: Path | str, migration_plan_path: Path | str, workspace_baseline_path: Path | str, owner_attestation_path: Path | str, pending_attestation_snapshot_path: Path | str, known_failure_baseline_path: Path | str, expected_paths_manifest_path: Path | str, source_root: Path | str, intended_predecessor_head: str) -> dict[str, Any]:
+    from . import attempt_migration as migration
+
+    root = migration._repository_root(repository_root)
+    source = migration._relative_path(source_root)
+    role_paths = dict(zip(BINDING_NAMES, (governing_plan_path, migration_plan_path, workspace_baseline_path, owner_attestation_path, pending_attestation_snapshot_path, known_failure_baseline_path, expected_paths_manifest_path), strict=True))
+    files = {name: migration._read_regular(root, path) for name, path in role_paths.items()}
+    try:
+        owner = migration._json_bytes(files["owner_attestation"]["data"], files["owner_attestation"]["path"])
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid") from exc
+    facts = _adoption_facts(owner)
+    workspace = migration._json_bytes(files["workspace_baseline"]["data"], files["workspace_baseline"]["path"])
+    if source_bindings.validate_workspace_record_shape(workspace) or workspace.get("schema_version") not in {"workspace_baseline.v1", "bootstrap_workspace_baseline.v1"}:
+        raise migration.AttemptMigrationError("incident_workspace_baseline_binding_invalid")
+    try:
+        projection = source_bindings.derive_committed_predecessor_lineage(root, baseline_head=workspace.get("head"), intended_predecessor_head=intended_predecessor_head, require_uncovered_paths=True)
+    except source_bindings.SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_invalid", str(exc)) from exc
+    paths = migration._status_paths(migration._repository_state(root)["status_projection"]["rows"], source)
+    manifest_paths = migration._manifest_paths(files["expected_paths_manifest"]["data"], files["expected_paths_manifest"]["path"])
+    if paths != manifest_paths:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    rows = []
+    for path in paths:
+        snapshot = migration._read_regular(root, path)
+        rows.append({**migration._public_binding(snapshot), "tracked_state": "modified" if migration._is_tracked(root, path) else "untracked"})
+    record = {
+        "schema_version": SCHEMA_VERSION,
+        **{name + "_binding": migration._content_binding(snapshot) for name, snapshot in files.items()},
+        "source_root": source,
+        "intended_predecessor": {"head": intended_predecessor_head, "tree": projection["intended_predecessor_tree"]},
+        "predecessor_projection": projection,
+        "pre_move_repository_state": migration._repository_state(root),
+        "attempt_rows": rows,
+        "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": migration._canonical_digest(paths),
+        "normalized_attempt_row_set_sha256": migration._canonical_digest(rows),
+        "adoption_facts": facts,
+        "claims_not_made": CLAIMS_NOT_MADE,
+    }
+    record["expected_paths_manifest_binding"]["row_count"] = len(paths)
+    record["normalized_incident_sha256"] = migration._canonical_digest(record)
+    return validate_attempt_migration_incident(root, record)

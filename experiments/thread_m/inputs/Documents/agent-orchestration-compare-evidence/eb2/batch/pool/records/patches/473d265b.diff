+from __future__ import annotations
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+from tests.test_retirement_attempt_migration import _make_migration_repository, _capture
+
+
+def test_adopted_recovery_public_surface():
+    assert callable(getattr(migration, 'capture_invalidated_adopted', None))
+    assert callable(getattr(migration, 'build_attempt_migration_incident', None))
+    assert callable(getattr(migration, 'validate_attempt_migration_incident', None))
+
+
+def test_v2_cannot_substitute_v1_lifecycle_or_artifacts(tmp_path):
+    case = _make_migration_repository(tmp_path)
+    record = _capture(case)
+    record['schema_version'] = 'attempt_migration_disposition.v2'
+    with pytest.raises(migration.AttemptMigrationError):
+        migration._validate_disposition_structure(record)
+
+
+def test_adopted_capture_cli_arguments_are_available():
+    parser = migration._parser()
+    assert 'capture-invalidated-adopted' in parser.format_help()
+
+
+def adopted_repository(root, *, staged_candidate=False):
+    """Real eleven-generation evidence with five generations committed as foundation."""
+    from orchestrator.retirement import materialization, broad_evidence as broad
+    from tests.test_retirement_broad_evidence import (
+        _initialize_candidate_repository, _ledger, _materialize_next_ledger,
+        _ledger_binding, _bind_candidate_to_repository,
+    )
+    from tests.test_retirement_attempt_incident import incident_repository
+    from tests.test_retirement_attempt_migration import (
+        _write, _git, _canonical, _digest, _file_binding, _review,
+        AUTHORITY_CLAIMS_NOT_MADE,
+    )
+    from pathlib import Path
+
+    _initialize_candidate_repository(root)
+    plan = root / 'plan.md'
+    plan.write_text('\n'.join(
+        f'### Task {number}: Task {number}\n\n' + '\n'.join(
+            f'- [ ] **Step {step}: Work**' for step in range(1, 2 if number == 1 else 21)
+        ) for number in range(1, 18)) + '\n')
+    _git(root, 'add', '--', 'plan.md')
+    _git(root, 'commit', '-qm', 'approved evidence plan')
+    record = _ledger(Path('plan.md'))
+    for task in record['tasks']:
+        task['total_step_count'] = 1 if task['task_number'] == 1 else 20
+    record['plan_binding']['sha256'] = broad.file_sha256(plan)
+    record['normalized_ledger_sha256'] = broad.canonical_sha256(record, exclude={'normalized_ledger_sha256'})
+    receipt = materialization.materialize_transaction(
+        repository_root=root, evidence_root=Path('evidence'), record_kind='execution-ledger',
+        output_path=Path('evidence/execution-ledger.json'), generation=1,
+        input_paths={'approved_plan': Path('plan.md')}, parameters={'record': record})
+    for number in range(2, 12):
+        record, receipt = _materialize_next_ledger(root, record, receipt)
+        if number == 5:
+            foundation = receipt
+            _git(root, 'add', '--', 'evidence')
+            _git(root, 'commit', '-qm', 'reviewed ledger foundation')
+            restoration_commit = _git(root, 'rev-parse', 'HEAD').decode().strip()
+            restoration_tree = _git(root, 'rev-parse', 'HEAD^{tree}').decode().strip()
+    _write(root, 'source.py', b'candidate = True\n')
+    if staged_candidate:
+        _git(root, 'add', '--', 'source.py')
+        _write(root, 'source.py', b'candidate = True  # working copy\n')
+    row = {'path': 'source.py', 'sha256': broad.file_sha256(root / 'source.py'),
+           'size': (root / 'source.py').stat().st_size, 'state': 'added'}
+    candidate = {'head': '0'*40, 'head_tree': '0'*40, 'index_sha256': 'sha256:'+'0'*64,
+                 'evidence_root_exclusion': 'evidence', 'candidate_paths': [row],
+                 'candidate_path_set_sha256': broad.canonical_sha256([row])}
+    _bind_candidate_to_repository(root, candidate)
+    args = incident_repository(root, candidate_and_ledger=(candidate, _ledger_binding(receipt)))
+    args.pop('owner_attestation_path')
+    args.pop('pending_attestation_snapshot_path')
+    args.pop('known_failure_baseline_path')
+    # Pending materialization request bytes are a separate historical coordinate.
+    _write(root, 'evidence/attestation-request.json', b'{"historical_request":true}\n')
+    paths = migration._status_paths(migration._repository_state(root)['status_projection']['rows'], 'evidence')
+    _write(root, 'expected.txt', ('\n'.join(paths)+'\n').encode())
+    mechanism_files = {'implementation/mechanism.py': b'generic mechanism\n',
+                       'implementation/test_mechanism.py': b'generic tests\n'}
+    for path, data in mechanism_files.items():
+        _write(root, path, data)
+    evidence_paths = {role: f'verification/{role}.txt' for role in (
+        'candidate_manifest', 'exact_diff', 'focused_test_evidence', 'broad_test_evidence')}
+    for path in evidence_paths.values():
+        _write(root, path, b'verification\n')
+    protected = ['source.py']
+    manifest = _file_binding(root, 'expected.txt')
+    manifest.update(row_count=len(paths), normalized_path_set_sha256=_digest(_canonical(paths)))
+    subject = dict(schema_version='attempt_migration_authority_subject.v1',
+        governing_plan_binding=_file_binding(root, 'plan.md'),
+        migration_plan_binding=_file_binding(root, 'migration.md'),
+        expected_paths_manifest_binding=manifest,
+        protected_path_bindings=[_file_binding(root, path, full=True) for path in protected],
+        mechanism_binding=_file_binding(root, 'implementation/mechanism.py', full=True),
+        test_binding=_file_binding(root, 'implementation/test_mechanism.py', full=True),
+        evidence_bindings={role: _file_binding(root, path, full=True) for role, path in evidence_paths.items()},
+        normalized_subject_sha256='', claims_not_made=AUTHORITY_CLAIMS_NOT_MADE)
+    subject['normalized_subject_sha256'] = migration._canonical_digest(subject, exclude='normalized_subject_sha256')
+    subject_bytes = _canonical(subject)+b'\n'
+    _write(root, 'authority/subject.json', subject_bytes)
+    for kind, path in [('specification', 'authority/spec.json'), ('code_quality', 'authority/quality.json')]:
+        _write(root, path, _review(kind, 'authority/subject.json', subject_bytes, kind))
+    _git(root, 'add', '--', 'migration.md', 'expected.txt', 'authority', 'implementation', 'verification')
+    _git(root, 'commit', '-qm', 'recovery authority', '--only', '--',
+         'migration.md', 'expected.txt', 'authority', 'implementation', 'verification')
+    args.update(incident_path='recovery/incident.json', disposition_path='recovery/disposition.json',
+        archive_root='archive', protected_paths=protected,
+        authority_subject_path='authority/subject.json', authority_specification_review_path='authority/spec.json',
+        authority_quality_review_path='authority/quality.json', restoration_commit=restoration_commit,
+        restoration_tree=restoration_tree, generation5_request_path=foundation.request_path,
+        generation5_snapshot_path=foundation.snapshot_path, generation11_request_path=receipt.request_path,
+        generation11_snapshot_path=receipt.snapshot_path, live_ledger_path=receipt.output_path,
+        baseline_path='evidence/implementation-baseline/known-failure-baseline.json',
+        baseline_specification_review_path='evidence/implementation-baseline/implementation-baseline-specification.json',
+        baseline_quality_review_path='evidence/implementation-baseline/implementation-baseline-quality.json',
+        attestation_request_path='evidence/attestation-request.json', attestation_snapshot_path='evidence/pending.json',
+        attestation_record_path='evidence/owner.json')
+    return args
+
+
+def test_adopted_capture_replay_and_archive_validation(tmp_path):
+    from tests.test_retirement_attempt_migration import _git, _write, _review
+    arguments = adopted_repository(tmp_path)
+    result = migration.capture_invalidated_adopted(**arguments)
+    status = _git(tmp_path, 'status', '--porcelain=v1', '-z', '--untracked-files=all')
+    assert migration.capture_invalidated_adopted(**arguments) == result
+    assert _git(tmp_path, 'status', '--porcelain=v1', '-z', '--untracked-files=all') == status
+    disposition_path = arguments['disposition_path']
+    assert migration.validate(tmp_path, disposition_path) == result['disposition']
+    for kind, path in [('specification', 'recovery/spec.json'), ('code_quality', 'recovery/quality.json')]:
+        _write(tmp_path, path, _review(kind, disposition_path, (tmp_path / disposition_path).read_bytes(),
+                                     kind, subject_kind='attempt_migration_disposition'))
+    _git(tmp_path, 'add', '--', disposition_path, 'recovery/spec.json', 'recovery/quality.json')
+    _git(tmp_path, 'commit', '-qm', 'reviewed recovery disposition')
+    assert migration.apply(tmp_path, disposition_path, 'recovery/spec.json', 'recovery/quality.json') == result['disposition']
+    assert migration.validate(tmp_path, disposition_path) == result['disposition']
+    assert migration.apply(tmp_path, disposition_path, 'recovery/spec.json', 'recovery/quality.json') == result['disposition']
+    report = migration.postvalidate(tmp_path, disposition_path, 'recovery/spec.json', 'recovery/quality.json', 'recovery/post.json')
+    assert report['result'] == 'passed'
+    assert report['disposition_binding']['path'] == disposition_path
+
+
+def test_adopted_capture_cli_runs_against_real_git_repository(tmp_path):
+    import json
+    import subprocess
+    import sys
+
+    arguments = adopted_repository(tmp_path)
+    argv = [sys.executable, '-m', 'orchestrator.retirement.attempt_migration', 'capture-invalidated-adopted']
+    for key, value in arguments.items():
+        if key == 'protected_paths':
+            for path in value:
+                argv.extend(['--protected-path', str(path)])
+        else:
+            argv.extend(['--' + key.replace('_', '-'), str(value)])
+    result = subprocess.run(argv, capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    assert result.stderr == ''
+    records = json.loads(result.stdout)
+    assert records['disposition']['schema_version'] == 'attempt_migration_disposition.v2'
+    assert records['incident']['schema_version'] == 'attempt_migration_incident.v1'
+    argv[argv.index('--attestation-record-path') + 1] = 'missing.json'
+    failed = subprocess.run(argv, capture_output=True, text=True)
+    assert failed.returncode == 1
+    assert failed.stdout == ''
+    assert failed.stderr

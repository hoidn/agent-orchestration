+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import source_bindings
+
+
+def git(root: Path, *args: str, data: bytes | None = None) -> bytes:
+    return subprocess.check_output(['git', *args], cwd=root, input=data)
+
+
+@pytest.fixture
+def repository(tmp_path: Path) -> Path:
+    git(tmp_path, 'init', '-q')
+    git(tmp_path, 'config', 'user.email', 'tests@example.invalid')
+    git(tmp_path, 'config', 'user.name', 'Tests')
+    commit(tmp_path, 'base', 'base\n')
+    return tmp_path
+
+
+def commit(root: Path, path: str, message: str) -> str:
+    (root / path).write_text(message)
+    git(root, 'add', '--', path)
+    git(root, 'commit', '-q', '--cleanup=verbatim', '-F', '-', data=message.encode())
+    return git(root, 'rev-parse', 'HEAD').decode().strip()
+
+
+def sha(data: bytes) -> str:
+    return 'sha256:' + hashlib.sha256(data).hexdigest()
+
+
+def lineage(root: Path, baseline: str, predecessor: str, **kwargs: object) -> dict:
+    return source_bindings.derive_committed_predecessor_lineage(
+        root, baseline_head=baseline, intended_predecessor_head=predecessor, **kwargs
+    )
+
+
+def test_lineage_is_closed_ordered_and_bound_to_raw_messages(repository: Path) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    uncontrolled = commit(repository, 'odd\tname', 'uncontrolled\n')
+    message = ('controlled\n\nRetirement-Control-Schema: precommit_control.v1\n'
+               + 'Retirement-Transaction-ID: ' + 'a' * 64 + '\n'
+               + 'Retirement-Control-SHA256: ' + 'b' * 64 + '\n')
+    controlled = commit(repository, 'covered', message)
+    result = lineage(repository, base, controlled, require_uncovered_paths=True)
+    assert set(result) == {
+        'baseline_head', 'intended_predecessor_head', 'intended_predecessor_tree',
+        'first_parent_commits', 'commit_count', 'changed_paths', 'changed_path_count',
+        'changed_path_set_sha256', 'controlled_paths', 'controlled_path_set_sha256',
+        'uncovered_paths', 'uncovered_path_set_sha256', 'normalized_projection_sha256',
+    }
+    assert result['baseline_head'] == base
+    assert result['intended_predecessor_head'] == controlled
+    assert result['intended_predecessor_tree'] == git(repository, 'rev-parse', 'HEAD^{tree}').decode().strip()
+    assert result['commit_count'] == 2
+    assert result['changed_paths'] == ['covered', 'odd\tname']
+    assert result['changed_path_count'] == 2
+    assert result['controlled_paths'] == ['covered']
+    assert result['uncovered_paths'] == ['odd\tname']
+    for field in ('changed', 'controlled', 'uncovered'):
+        assert result[f'{field}_path_set_sha256'] == sha(''.join(p + '\n' for p in result[f'{field}_paths']).encode())
+    rows = result['first_parent_commits']
+    assert [r['commit'] for r in rows] == [uncontrolled, controlled]
+    assert [r['parent'] for r in rows] == [base, uncontrolled]
+    for row, raw_message in zip(rows, (b'uncontrolled\n', message.encode())):
+        assert set(row) == {'commit', 'parent', 'tree', 'raw_message_sha256', 'changed_paths', 'changed_path_set_sha256', 'control_coordinates'}
+        assert row['raw_message_sha256'] == sha(raw_message)
+        assert row['tree'] == git(repository, 'rev-parse', row['commit'] + '^{tree}').decode().strip()
+    assert rows[0]['control_coordinates'] is None
+    assert rows[1]['control_coordinates'] == {'transaction_id': 'a' * 64, 'normalized_control_sha256': 'sha256:' + 'b' * 64}
+    projection = {k: v for k, v in result.items() if k != 'normalized_projection_sha256'}
+    assert result['normalized_projection_sha256'] == sha(json.dumps(projection, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode())
+
+
+@pytest.mark.parametrize('message', [
+    'bad\n\nRetirement-Control-Schema: precommit_control.v2\n',
+    'bad\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: nope\n',
+    'bad\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: ' + 'a' * 64 + '\nRetirement-Control-SHA256: ' + 'b' * 64 + '\n',
+    'bad\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: ' + 'a' * 64 + '\nRetirement-Control-SHA256: ' + 'b' * 64 + '\nextra\n',
+])
+def test_lineage_rejects_malformed_trailer(repository: Path, message: str) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    head = commit(repository, 'bad', message)
+    with pytest.raises(source_bindings.SourceBindingError):
+        lineage(repository, base, head)
+
+
+def test_lineage_rejects_covered_only_and_empty_ranges(repository: Path) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    message = 'covered\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: ' + 'a' * 64 + '\nRetirement-Control-SHA256: ' + 'b' * 64 + '\n'
+    head = commit(repository, 'covered', message)
+    for predecessor in (base, head):
+        with pytest.raises(source_bindings.SourceBindingError):
+            lineage(repository, base, predecessor, require_uncovered_paths=True)
+    assert lineage(repository, base, base)['first_parent_commits'] == []
+
+
+def test_lineage_rejects_missing_objects_nonancestor_and_merge(repository: Path) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    git(repository, 'checkout', '-qb', 'side')
+    side = commit(repository, 'side', 'side\n')
+    git(repository, 'checkout', '-q', '-')
+    main = commit(repository, 'main', 'main\n')
+    for lower, upper in ((side, main), (base, '0' * 40), ('0' * 40, main)):
+        with pytest.raises(source_bindings.SourceBindingError):
+            lineage(repository, lower, upper)
+    git(repository, 'merge', '-q', '--no-ff', '-m', 'merge', 'side')
+    head = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    with pytest.raises(source_bindings.SourceBindingError):
+        lineage(repository, base, head)
+    with pytest.raises(source_bindings.SourceBindingError):
+        lineage(repository, side, head)
+
+
+def test_retirement_public_exports_remain_lazy() -> None:
+    result = subprocess.check_output([sys.executable, '-c',
+        "import json, sys; import orchestrator.retirement as r; "
+        "assert 'derive_committed_predecessor_lineage' in r.__all__; "
+        "assert 'validate_attempt_migration_incident' in r.__all__; "
+        "assert not any(n.startswith('orchestrator.retirement.') for n in sys.modules); "
+        "assert r.derive_committed_predecessor_lineage.__name__ == 'derive_committed_predecessor_lineage'"
+    ])
+    assert result == b''
+
+
+def test_lineage_rejects_missing_tree_object(repository: Path) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    head = commit(repository, 'changed', 'changed\n')
+    tree = git(repository, 'rev-parse', head + '^{tree}').decode().strip()
+    (repository / '.git' / 'objects' / tree[:2] / tree[2:]).unlink()
+    with pytest.raises(source_bindings.SourceBindingError):
+        lineage(repository, base, head)
+
+
+def test_lineage_rejects_duplicate_changed_path_projection(repository: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    head = commit(repository, 'changed', 'changed\n')
+    original_git = source_bindings._git
+
+    def duplicate_projection(root: Path, *args: str, **kwargs: object) -> bytes:
+        if args[0] == 'diff-tree':
+            return b'changed\0changed\0'
+        return original_git(root, *args, **kwargs)
+
+    monkeypatch.setattr(source_bindings, '_git', duplicate_projection)
+    with pytest.raises(source_bindings.SourceBindingError):
+        lineage(repository, base, head)
+
+
+def test_lineage_rejects_missing_changed_blob_object(repository: Path) -> None:
+    base = git(repository, 'rev-parse', 'HEAD').decode().strip()
+    head = commit(repository, 'changed', 'changed\n')
+    blob = git(repository, 'rev-parse', head + ':changed').decode().strip()
+    (repository / '.git' / 'objects' / blob[:2] / blob[2:]).unlink()
+    with pytest.raises(source_bindings.SourceBindingError):
+        lineage(repository, base, head)

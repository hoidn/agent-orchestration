+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import broad_evidence as broad
+from orchestrator.retirement import materialization as materialization
+from tests.test_retirement_broad_evidence import (
+    _advance_bound_ledger,
+    _ledger_binding,
+    _materialize_first_ledger,
+)
+
+
+def _git(repository: Path, *args: str) -> None:
+    subprocess.run(['git', '-C', str(repository), *args], check=True, capture_output=True)
+
+
+def _repository(tmp_path: Path) -> Path:
+    repository = tmp_path / 'repo'
+    repository.mkdir()
+    _git(repository, 'init', '-q')
+    _git(repository, 'config', 'user.name', 'Test')
+    _git(repository, 'config', 'user.email', 'test@example.invalid')
+    return repository
+
+
+def _overlay(repository: Path) -> dict[str, bytes]:
+    return {
+        path.relative_to(repository).as_posix(): path.read_bytes()
+        for path in repository.rglob('*')
+        if path.is_file() and '.git' not in path.relative_to(repository).parts
+    }
+
+
+def test_generation_and_ledger_binding_validate_from_archived_bytes(tmp_path: Path) -> None:
+    repository = _repository(tmp_path)
+    _, _, first = _materialize_first_ledger(repository)
+    _, second = _advance_bound_ledger(repository, _ledger_binding(first))
+    overlay = _overlay(repository)
+    for path in overlay:
+        (repository / path).unlink()
+    assert materialization.validate_generation(
+        repository, second.request_path, second.snapshot_path,
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    ) == []
+    assert materialization.validate_generation(repository, second.request_path, second.snapshot_path)
+    assert materialization.validate_generation_binding_current(
+        repository, _ledger_binding(first), bound_file_bytes=overlay,
+        require_committed_fallback=True,
+    ) == []
+
+
+@pytest.mark.parametrize('slot', ['request', 'snapshot'])
+def test_generation_slots_include_mapped_duplicates_alongside_live(tmp_path: Path, slot: str) -> None:
+    repository = _repository(tmp_path)
+    _, _, first = _materialize_first_ledger(repository)
+    path = getattr(first, f'{slot}_path')
+    duplicate = path.with_name(f"00000001-{'f' * 64}.json")
+    issues = materialization.validate_generation(
+        repository, first.request_path, first.snapshot_path,
+        bound_file_bytes={duplicate.as_posix(): b'{}\n'},
+    )
+    assert f'generation_{slot}_slot_extra' in {issue.code for issue in issues}
+
+
+def test_overlay_recursive_lineage_detects_missing_ancestor(tmp_path: Path) -> None:
+    repository = _repository(tmp_path)
+    _, _, first = _materialize_first_ledger(repository)
+    _, second = _advance_bound_ledger(repository, _ledger_binding(first))
+    _, third = _advance_bound_ledger(repository, _ledger_binding(second), future_paths=[
+        'evidence/implementation-commits/task-01-bootstrap/specification-review.json',
+        'evidence/implementation-commits/task-01-bootstrap/quality-review.json',
+    ])
+    overlay = _overlay(repository)
+    del overlay[first.snapshot_path.as_posix()]
+    issues = materialization.validate_generation(
+        repository, third.request_path, third.snapshot_path,
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    )
+    assert any(issue.code == 'prior_generation_invalid' and issue.message == 'prior_generation_changed'
+               for issue in issues)
+
+
+def test_review_overlay_shadows_live_and_fallback_requires_head_blob(tmp_path: Path) -> None:
+    repository = _repository(tmp_path)
+    review = broad.load_json_closed(Path('tests/fixtures/retirement_broad_evidence/review.v1.json'))
+    subject = {'kind': 'implementation_failure_baseline', 'path': 'evidence/baseline.json',
+               'sha256': 'sha256:' + '1' * 64}
+    review['subject'] = subject
+    data = broad.canonical_json_bytes(review) + b'\n'
+    binding = broad.derive_review_binding(evidence_root=Path('evidence'),
+        review_path=Path('evidence/baseline-specification-review.json'), review_bytes=data)
+    target = repository / binding['immutable_path']
+    target.parent.mkdir(parents=True)
+    target.write_bytes(data)
+    assert broad.validate_bound_record(binding, repository, bound_file_bytes={},
+        require_committed_fallback=True)[0].code == 'review_binding_immutable_unreadable'
+    _git(repository, 'add', '.')
+    _git(repository, 'commit', '-qm', 'bind review')
+    assert broad.validate_bound_record(binding, repository, bound_file_bytes={},
+        require_committed_fallback=True) == []
+    target.write_bytes(b'changed\n')
+    assert broad.validate_bound_record(binding, repository,
+        bound_file_bytes={binding['immutable_path']: data}, require_committed_fallback=True) == []
+    assert broad.validate_bound_record(binding, repository, bound_file_bytes={},
+        require_committed_fallback=True)[0].code == 'review_binding_immutable_unreadable'
+
+
+def test_completed_generation_reopens_overlay_only_subject_and_review_history(tmp_path: Path) -> None:
+    from tests.test_retirement_broad_evidence import (
+        _producer_task1_candidate_ledger_and_bootstrap,
+        _producer_bootstrap_subject_and_reviews,
+    )
+    repository = tmp_path / 'repo'
+    repository.mkdir()
+    candidate, binding, bootstrap = _producer_task1_candidate_ledger_and_bootstrap(repository)
+    for _ in range(2):
+        _, receipt = _advance_bound_ledger(repository, binding)
+        binding = _ledger_binding(receipt)
+    _, receipt = _advance_bound_ledger(repository, binding, future_paths=[
+        'evidence/implementation-commits/task-01-bootstrap/specification-review.json',
+        'evidence/implementation-commits/task-01-bootstrap/quality-review.json',
+    ])
+    binding = _ledger_binding(receipt)
+    subject, specification, quality = _producer_bootstrap_subject_and_reviews(
+        repository, candidate=candidate, ledger=binding, bootstrap=bootstrap,
+    )
+    _, receipt = _advance_bound_ledger(repository, binding, evidence_bindings=[
+        {'path': path, 'sha256': broad.file_sha256(repository / path)}
+        for path in sorted([subject.as_posix(), specification['logical_path'], quality['logical_path']])
+    ])
+    overlay = _overlay(repository)
+    for path in overlay:
+        if not path.startswith('evidence/'):
+            continue
+        (repository / path).chmod(0o600)
+        (repository / path).write_bytes(b'invalid live bytes\n')
+    assert materialization.validate_generation(
+        repository, receipt.request_path, receipt.snapshot_path,
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    ) == []
+    subject_record = json.loads(overlay[subject.as_posix()])
+    direct_issues = broad.validate_review_subject(
+        subject_kind='broad_evidence_bootstrap', record=subject_record,
+        repository_root=repository, subject_path=subject,
+        permitted_manifest_exclusions=sorted({subject.as_posix(), specification['logical_path'],
+            specification['immutable_path'], quality['logical_path'], quality['immutable_path']}),
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    )
+    assert direct_issues == []
+    assert broad.validate_review_pair(
+        specification_binding=specification, quality_binding=quality,
+        repository_root=repository, bound_file_bytes=overlay,
+        require_committed_fallback=True,
+    ) == []
+    overlay[specification['immutable_path']] = b'changed overlay review\n'
+    issues = materialization.validate_generation(
+        repository, receipt.request_path, receipt.snapshot_path,
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    )
+    assert 'ledger_completion_review_pair_invalid' in {issue.code for issue in issues}
+
+
+@pytest.mark.parametrize('defect', ['missing_request', 'missing_snapshot', 'swapped'])
+def test_overlay_immediate_ancestor_reports_lineage_failure(tmp_path: Path, defect: str) -> None:
+    repository = _repository(tmp_path)
+    _, _, first = _materialize_first_ledger(repository)
+    _, second = _advance_bound_ledger(repository, _ledger_binding(first))
+    overlay = _overlay(repository)
+    if defect == 'swapped':
+        request = first.request_path.as_posix()
+        snapshot = first.snapshot_path.as_posix()
+        overlay[request], overlay[snapshot] = overlay[snapshot], overlay[request]
+    else:
+        path = getattr(first, f"{defect.removeprefix('missing_')}_path")
+        del overlay[path.as_posix()]
+    issues = materialization.validate_generation(
+        repository, second.request_path, second.snapshot_path,
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    )
+    assert any(issue.code == 'prior_generation_invalid' and issue.message == 'prior_generation_changed'
+               for issue in issues)
+
+
+@pytest.mark.parametrize(('defect', 'expected'), [
+    ('request_parent', 'request_path_mismatch'),
+    ('snapshot_parent', 'snapshot_path_mismatch'),
+    ('noncontiguous', 'request_prior_generation_invalid'),
+])
+def test_overlay_ancestor_coordinates_are_revalidated(tmp_path: Path, defect: str, expected: str) -> None:
+    import hashlib
+
+    repository = _repository(tmp_path)
+    _, _, first = _materialize_first_ledger(repository)
+    _, second = _advance_bound_ledger(repository, _ledger_binding(first))
+    overlay = _overlay(repository)
+    for path in overlay:
+        (repository / path).unlink()
+    request = json.loads(overlay.pop(second.request_path.as_posix()))
+    record = json.loads(overlay.pop(second.snapshot_path.as_posix()))
+    prior = request['prior_generation_binding']
+    if defect == 'noncontiguous':
+        prior['generation'] = 0
+    else:
+        slot = defect.removesuffix('_parent')
+        path = Path(prior[f'{slot}_path'])
+        moved = path.parent.with_name('f' * 64) / path.name
+        overlay[moved.as_posix()] = overlay.pop(path.as_posix())
+        prior[f'{slot}_path'] = moved.as_posix()
+    record['last_transition']['prior_generation_binding'] = dict(prior)
+    record['normalized_ledger_sha256'] = broad.canonical_sha256(record, exclude={'normalized_ledger_sha256'})
+    request['parameters']['record'] = record
+    request['normalized_request_sha256'] = broad.canonical_sha256(request, exclude={'normalized_request_sha256'})
+    request_path = materialization._request_path(Path('evidence'), second.output_path, 2,
+        request['normalized_request_sha256'])
+    snapshot_bytes = materialization._json_output(record)
+    snapshot_path = materialization._snapshot_path(Path('evidence'), second.output_path, 2,
+        'sha256:' + hashlib.sha256(snapshot_bytes).hexdigest())
+    overlay[request_path.as_posix()] = materialization._json_output(request)
+    overlay[snapshot_path.as_posix()] = snapshot_bytes
+    overlay[second.output_path.as_posix()] = snapshot_bytes
+    issues = materialization.validate_generation(
+        repository, request_path, snapshot_path, bound_file_bytes=overlay,
+        require_committed_fallback=True,
+    )
+    assert expected in {value for issue in issues for value in (issue.code, issue.message)}
+
+
+def test_committed_fallback_capture_rejects_bytes_changed_after_head_check(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    repository = _repository(tmp_path)
+    path = Path('evidence.json')
+    (repository / path).write_bytes(b'committed\n')
+    _git(repository, 'add', '.')
+    _git(repository, 'commit', '-qm', 'bind evidence')
+    capture = materialization.capture_regular_file_at
+
+    def change_then_capture(*args, **kwargs):
+        (repository / path).write_bytes(b'changed after HEAD verification\n')
+        return capture(*args, **kwargs)
+
+    monkeypatch.setattr(materialization, 'capture_regular_file_at', change_then_capture)
+    token = broad._BOUND_FILE_VIEW.set((repository.resolve(), {}, True))
+    try:
+        with pytest.raises(materialization.MaterializationError):
+            materialization._capture_bound_relative_regular(repository, path)
+    finally:
+        broad._BOUND_FILE_VIEW.reset(token)
+
+
+@pytest.mark.parametrize('swap', [False, True])
+def test_overlay_snapshot_bytes_cannot_be_used_as_current_request(
+    tmp_path: Path, swap: bool,
+) -> None:
+    repository = _repository(tmp_path)
+    _, _, receipt = _materialize_first_ledger(repository)
+    overlay = _overlay(repository)
+    request_path = receipt.request_path.as_posix()
+    snapshot_path = receipt.snapshot_path.as_posix()
+    request_bytes = overlay[request_path]
+    overlay[request_path] = overlay[snapshot_path]
+    if swap:
+        overlay[snapshot_path] = request_bytes
+    issues = materialization.validate_generation(
+        repository, receipt.request_path, receipt.snapshot_path,
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    )
+    assert any(issue.code == 'generation_unreadable' and issue.message == 'request_schema_invalid'
+               for issue in issues)

+def _validate_adopted_generations(
+    root: Path, record: Mapping[str, Any], snapshots: Mapping[str, Mapping[str, Any]]
+) -> None:
+    from .materialization import validate_generation
+
+    overlay = {path: snapshot["data"] for path, snapshot in snapshots.items()}
+    coordinate = record["ledger_lineage"]["generation_11"]
+    request_path = coordinate["request_binding"]["path"]
+    snapshot_path = coordinate["snapshot_binding"]["path"]
+    request_data = overlay[request_path]
+    failed_role = (
+        "generation11_snapshot" if request_data == overlay[snapshot_path]
+        else "generation11_request"
+    )
+    issues = validate_generation(
+        root, Path(request_path), Path(snapshot_path),
+        bound_file_bytes=overlay, require_committed_fallback=True,
+    )
+    # Slot collisions belong to the baseline's ledger-generation validation.
+    slot_codes = {"generation_request_slot_extra", "generation_snapshot_slot_extra"}
+    if any(
+        issue.code not in slot_codes
+        and not (issue.code == "prior_generation_invalid" and issue.message in slot_codes)
+        for issue in issues
+    ):
+        raise AttemptMigrationError("semantic_coordinate_row_binding_mismatch", failed_role)
+    if _json_bytes(request_data, request_path).get("generation") != coordinate["generation"]:
+        raise AttemptMigrationError("semantic_coordinate_row_binding_mismatch", "generation11_request")
+
+
+def _validate_adopted_evidence(
+    root: Path, record: Mapping[str, Any], *, incident: Mapping[str, Any] | None = None
+) -> None:
+    from .attempt_incident import validate_incident, TOP_LEVEL_KEYS as INCIDENT_KEYS
+
+    snapshots = _adopted_attempt_view(root, record)
+    _validate_adopted_generations(root, record, snapshots)
+    binding = record["attempt_lifecycle"]["incident_binding"]
+    if incident is None:
+        incident_file = _read_regular(root, binding["path"])
+        if _content_binding(incident_file) != binding:
+            raise AttemptMigrationError("incident_binding_invalid")
+        incident = _json_bytes(incident_file["data"], binding["path"])
+        if incident_file["data"] != _canonical_json(incident) + b"\n":
+            raise AttemptMigrationError("incident_binding_invalid")
+    elif _content_binding({"path": binding["path"], "size": len(_canonical_json(incident) + b"\n"),
+                           "sha256": _bytes_digest(_canonical_json(incident) + b"\n")}) != binding:
+        raise AttemptMigrationError("incident_binding_invalid")
+    _require_keys(incident, INCIDENT_KEYS, "incident_keys_mismatch")
+    if record["pre_move_repository_state"] != incident["pre_move_repository_state"]:
+        raise AttemptMigrationError("incident_repository_state_mismatch")
+    artifacts = record["attempt_binding"]["artifact_bindings"]
+    for incident_field, role in (
+        ("workspace_baseline_binding", "workspace_baseline"),
+        ("owner_attestation_binding", "attestation_record"),
+        ("pending_attestation_snapshot_binding", "attestation_snapshot"),
+        ("known_failure_baseline_binding", "baseline"),
+    ):
+        if incident[incident_field] != {key: artifacts[role][key] for key in ("path", "size", "sha256")}:
+            raise AttemptMigrationError("incident_coordinate_binding_mismatch", role)
+    for field in ("governing_plan_binding", "migration_plan_binding"):
+        if incident[field] != record[field]:
+            raise AttemptMigrationError("incident_coordinate_binding_mismatch", field)
+    manifest = record["attempt_binding"]["expected_paths_manifest_binding"]
+    if incident["expected_paths_manifest_binding"] != {
+        key: manifest[key] for key in ("path", "size", "sha256", "row_count")
+    }:
+        raise AttemptMigrationError("incident_coordinate_binding_mismatch", "expected_paths_manifest")
+    if incident["source_root"] != record["attempt_binding"]["source_root"]:
+        raise AttemptMigrationError("incident_coordinate_binding_mismatch", "source_root")
+    validate_incident(
+        root, incident,
+        bound_file_bytes={path: snapshot["data"] for path, snapshot in snapshots.items()},
+        attempt_rows=record["attempt_rows"],
+        require_committed_fallback=True,
+    )
+    workspace_path = artifacts["workspace_baseline"]["path"]
+    baseline_path = artifacts["baseline"]["path"]
+    workspace = _json_bytes(snapshots[workspace_path]["data"], workspace_path)
+    baseline = _json_bytes(snapshots[baseline_path]["data"], baseline_path)
+    candidate_paths = {row["path"] for row in baseline["candidate_binding"]["candidate_paths"]}
+    # Corrective commits may advance HEAD; candidate index entries stay bound.
+    expected_index = {
+        row["path"]: (row["mode"], row["oid"])
+        for row in workspace["index_entries"] if row["path"] in candidate_paths
+    }
+    if any(row["stage"] != 0 for row in workspace["index_entries"] if row["path"] in candidate_paths):
+        raise AttemptMigrationError("outside_status_projection_changed")
+    try:
+        current_index = _git_path_entries(root, sorted(candidate_paths), index=True) if candidate_paths else {}
+    except AttemptMigrationError as exc:
+        raise AttemptMigrationError("outside_status_projection_changed") from exc
+    if current_index != expected_index:
+        raise AttemptMigrationError("outside_status_projection_changed")
+

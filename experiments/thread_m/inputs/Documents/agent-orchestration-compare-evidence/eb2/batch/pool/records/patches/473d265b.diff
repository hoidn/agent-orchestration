+    _git_output(tmp_path, 'commit', '-qm', 'advance correction')
+    assert validate_attempt_migration_incident(tmp_path, record) is record
+    _git_output(tmp_path, 'add', '--', 'source.py')
+    _git_output(tmp_path, 'commit', '-qm', 'land candidate')
+    with pytest.raises(migration.AttemptMigrationError, match='incident_known_failure_baseline_binding_invalid:.*candidate_path_git_state_mismatch'):
+        validate_attempt_migration_incident(tmp_path, record)
+
+
+@pytest.mark.parametrize("committed_fallback", [False, True])
+def test_incident_replays_exact_logical_rows_after_relocation(tmp_path: Path, committed_fallback: bool) -> None:
+    from orchestrator.retirement.attempt_incident import build_attempt_migration_incident, validate_incident
+    arguments = incident_repository(tmp_path)
+    _git_output(tmp_path, "add", "--", "expected.txt", "migration.md")
+    _git_output(tmp_path, "commit", "-qm", "commit incident authority")
+    record = build_attempt_migration_incident(**arguments)
+    overlay = {row['path']: (tmp_path / row['path']).read_bytes() for row in record['attempt_rows']}
+    disposition_rows = []
+    for row in record['attempt_rows']:
+        archive = 'archive/' + row['path']
+        disposition_rows.append({**{key: value for key, value in row.items() if key != 'path'},
+                                 'original_path': row['path'], 'archive_path': archive})
+        target = tmp_path / archive
+        target.parent.mkdir(parents=True, exist_ok=True)
+        (tmp_path / row['path']).rename(target)
+    assert validate_incident(tmp_path, record, bound_file_bytes=overlay, attempt_rows=disposition_rows, require_committed_fallback=committed_fallback) is record
+    disposition_rows[0]['lstat_mode'] ^= 0o100
+    with pytest.raises(migration.AttemptMigrationError, match='attempt_row_state_invalid'):
+        validate_incident(tmp_path, record, bound_file_bytes=overlay, attempt_rows=disposition_rows, require_committed_fallback=committed_fallback)
+
+
+def test_incident_rejects_rebound_nested_broad_evidence(tmp_path: Path) -> None:

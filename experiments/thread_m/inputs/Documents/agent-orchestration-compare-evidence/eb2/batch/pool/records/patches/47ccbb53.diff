+def _rebind_child(files, child, prior):
+    request = json.loads(files.pop(child["request_path"]))
+    prior_coordinates = {key: prior[key] for key in (
+        "request_path", "request_sha256", "snapshot_path", "snapshot_sha256", "generation")}
+    prior_coordinates["output_path"] = prior["live_path"]
+    request["prior_generation_binding"] = prior_coordinates
+    ledger = request["parameters"]["record"]
+    ledger["last_transition"]["prior_generation_binding"] = prior_coordinates
+    ledger["normalized_ledger_sha256"] = broad.canonical_sha256(ledger, exclude={"normalized_ledger_sha256"})
+    snapshot = material._json_output(ledger)
+    snapshot_sha = "sha256:" + hashlib.sha256(snapshot).hexdigest()
+    snapshot_path = material._snapshot_path(Path("evidence"), Path(child["live_path"]), child["generation"], snapshot_sha)
+    files.pop(child["snapshot_path"])
+    files[snapshot_path.as_posix()] = snapshot
+    request["normalized_request_sha256"] = broad.canonical_sha256(request, exclude={"normalized_request_sha256"})
+    request_path = material._request_path(Path("evidence"), Path(child["live_path"]), child["generation"],
+                                          request["normalized_request_sha256"])
+    request_bytes = material._json_output(request)
+    files[request_path.as_posix()] = request_bytes
+    return {**child, "request_path": request_path.as_posix(),
+            "request_sha256": "sha256:" + hashlib.sha256(request_bytes).hexdigest(),
+            "snapshot_path": snapshot_path.as_posix(), "snapshot_sha256": snapshot_sha,
+            "byte_sha256": snapshot_sha}

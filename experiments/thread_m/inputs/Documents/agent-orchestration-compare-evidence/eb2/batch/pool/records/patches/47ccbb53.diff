+def _rewrite_request(files, binding, change):
+    request = json.loads(files[binding["request_path"]])
+    change(request)
+    request["normalized_request_sha256"] = broad.canonical_sha256(request, exclude={"normalized_request_sha256"})
+    path = material._request_path(Path("evidence"), Path(request["output_path"]),
+                                  request["generation"], request["normalized_request_sha256"])
+    del files[binding["request_path"]]
+    files[path.as_posix()] = _json_bytes(request)
+    return {**binding, "request_path": path.as_posix()}

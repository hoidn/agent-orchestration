@@ -0,0 +1,184 @@
+"""Incident-first publication of exact owner-adopted uncommitted recovery.
+
+Capture derives lifecycle facts from evidence and Git and reuses v1 authority,
+row, restoration and archive contracts. Existing outputs must replay exactly.
+"""
+import subprocess
+from pathlib import PurePosixPath
+
+from . import attempt_migration as shared
+from .attempt_incident import derive_incident
+from .attempt_disposition_v2 import (
+    LIFECYCLE_VALUES, V2_ARTIFACT_ROLES, V2_CLAIMS_NOT_MADE,
+    V2_DISPOSITION, V2_SCHEMA_VERSION, validate_live_v2, validate_structure_v2,
+)
+
+
+def _classify_output(root, path, rows, name):
+    try:
+        parts = PurePosixPath(path).parts
+        if ".git" in parts:
+            raise ValueError("Git metadata output")
+        ancestors = {"/".join(parts[:index]) for index in range(1, len(parts))}
+        if ancestors:
+            ancestor_bytes = {ancestor.encode("utf-8") for ancestor in ancestors}
+            entries = shared._git(root, "ls-files", "--stage", "-z", "--", *sorted(ancestors))
+            for entry in entries.split(b"\0"):
+                metadata, _, raw_path = entry.partition(b"\t")
+                if metadata.startswith(b"160000 ") and raw_path in ancestor_bytes:
+                    raise ValueError("output under gitlink")
+        if shared._is_tracked(root, path) or any(
+            row["source_path"] == path or (row["path"] == path and row["source_path"] is not None)
+            for row in rows
+        ):
+            raise ValueError("tracked output")
+        snapshot = shared._read_regular(root, path, missing_ok=True)
+        if snapshot is None:
+            ignored = subprocess.run(
+                ["git", "check-ignore", "--no-index", "--quiet", "--", path],
+                cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            if ignored.returncode != 1:
+                raise ValueError("ignored output or ignore check failed")
+        if snapshot is not None and [row for row in rows if row["path"] == path] != [
+            {"path": path, "source_path": None, "status": "??"}
+        ]:
+            raise ValueError("output status")
+        return snapshot
+    except (shared.AttemptMigrationError, OSError, ValueError) as exc:
+        raise shared.AttemptMigrationError(name + "_output_state_invalid", path) from exc
+
+
+def capture_invalidated_adopted(
+    repository_root, *, incident_path, disposition_path, source_root, archive_root,
+    governing_plan_path, migration_plan_path, authority_subject_path,
+    authority_specification_review_path, authority_quality_review_path,
+    intended_predecessor_head, restoration_commit, restoration_tree,
+    expected_paths_manifest_path, protected_paths, generation5_request_path,
+    generation5_snapshot_path, generation11_request_path, generation11_snapshot_path,
+    live_ledger_path, baseline_path, baseline_specification_review_path,
+    baseline_quality_review_path, workspace_baseline_path, attestation_request_path,
+    attestation_snapshot_path, attestation_record_path,
+):
+    """Publish both records only after full validation; replay byte-exact outputs."""
+    root = shared._repository_root(repository_root)
+    incident_path, disposition_path, source_root, archive_root = [shared._relative_path(p) for p in (
+        incident_path, disposition_path, source_root, archive_root)]
+    if shared._under(source_root, archive_root) or shared._under(archive_root, source_root):
+        raise shared.AttemptMigrationError("source_archive_roots_overlap")
+    for path in (incident_path, disposition_path):
+        shared._reject_output_overlap(path, source_root, archive_root)
+        if shared._under(source_root, path) or shared._under(archive_root, path):
+            raise shared.AttemptMigrationError("output_path_overlaps_migration", path)
+    if shared._under(incident_path, disposition_path) or shared._under(disposition_path, incident_path):
+        raise shared.AttemptMigrationError("output_path_overlaps_migration", incident_path)
+    if shared._scan_regular_files(root, archive_root):
+        raise shared.AttemptMigrationError("archive_not_empty", archive_root)
+    status = shared._parse_status(shared._git(root, "status", "--porcelain=v1", "-z", "--untracked-files=all"))
+    existing = {
+        "incident": _classify_output(root, incident_path, status, "incident"),
+        "disposition": _classify_output(root, disposition_path, status, "disposition"),
+    }
+    if existing["incident"] is None and existing["disposition"] is not None:
+        raise shared.AttemptMigrationError("disposition_without_incident")
+    state = shared._state_without_paths(shared._repository_state(root), {
+        path for name, path in (("incident", incident_path), ("disposition", disposition_path))
+        if existing[name] is not None
+    })
+    incident = derive_incident(
+        root, governing_plan_path=governing_plan_path, migration_plan_path=migration_plan_path,
+        workspace_baseline_path=workspace_baseline_path, owner_attestation_path=attestation_record_path,
+        pending_attestation_snapshot_path=attestation_snapshot_path, known_failure_baseline_path=baseline_path,
+        expected_paths_manifest_path=expected_paths_manifest_path, source_root=source_root,
+        intended_predecessor_head=intended_predecessor_head, state=state,
+    )
+    incident_bytes = shared._canonical_json(incident) + b"\n"
+    if not shared._is_commit_identity(restoration_commit) or not shared._is_commit_identity(restoration_tree):
+        raise shared.AttemptMigrationError("source_identity_invalid")
+    if shared._git(root, "rev-parse", f"{restoration_commit}^{{tree}}").decode("ascii").strip() != restoration_tree:
+        raise shared.AttemptMigrationError("source_tree_mismatch")
+    if not shared._git_is_ancestor(root, restoration_commit, state["head"]):
+        raise shared.AttemptMigrationError("source_commit_not_ancestor")
+    paths = [row["path"] for row in incident["attempt_rows"]]
+    rows = [{"original_path": row["path"], "archive_path": f"{archive_root}/{row['path']}",
+             **{k: row[k] for k in ("tracked_state", "file_type", "lstat_mode", "size", "sha256")}}
+            for row in incident["attempt_rows"]]
+    row_by_path = {row["original_path"]: row for row in rows}
+    live_path = shared._relative_path(live_ledger_path)
+    if [row["original_path"] for row in rows if row["tracked_state"] == "modified"] != [live_path]:
+        raise shared.AttemptMigrationError("tracked_source_set_invalid")
+    protected = []
+    for raw_path in protected_paths:
+        path = shared._relative_path(raw_path, field="protected_path")
+        if path in paths or shared._under(path, archive_root):
+            raise shared.AttemptMigrationError("protected_path_overlaps_attempt", path)
+        protected.append(shared._public_binding(shared._read_regular(root, path)))
+    protected.sort(key=lambda binding: binding["path"])
+    if len({binding["path"] for binding in protected}) != len(protected):
+        raise shared.AttemptMigrationError("protected_path_duplicate")
+    if [binding["path"] for binding in protected] != shared._outside_status_paths(state["status_projection"]["rows"], source_root):
+        raise shared.AttemptMigrationError("protected_status_coverage_mismatch")
+    manifest = {**incident["expected_paths_manifest_binding"], "normalized_path_set_sha256": shared._canonical_digest(paths)}
+    authority_subject_path = shared._relative_path(authority_subject_path)
+    subject_file = shared._validate_authority_subject(
+        root, authority_subject_path, governing_plan_binding=incident["governing_plan_binding"],
+        migration_plan_binding=incident["migration_plan_binding"], expected_manifest_binding=manifest,
+        protected_path_bindings=protected,
+    )
+    spec, quality, _, _ = shared._validate_review_pair(
+        root, shared._relative_path(authority_specification_review_path), shared._relative_path(authority_quality_review_path),
+        require_committed=True, expected_subject_kind="attempt_migration_authority",
+        expected_subject_path=authority_subject_path, expected_subject_sha256=subject_file["sha256"],
+    )
+    role_paths = dict(zip(V2_ARTIFACT_ROLES, [shared._relative_path(p) for p in (
+        baseline_path, baseline_specification_review_path, baseline_quality_review_path,
+        workspace_baseline_path, attestation_request_path, attestation_snapshot_path, attestation_record_path)]))
+    if any(path not in row_by_path for path in role_paths.values()):
+        raise shared.AttemptMigrationError("attempt_artifact_coordinates_invalid")
+    artifacts = {role: shared._binding_from_row(row_by_path[path], path_field="original_path") for role, path in role_paths.items()}
+    g5_request = shared._require_committed_live(root, shared._relative_path(generation5_request_path))
+    g5_snapshot = shared._require_committed_live(root, shared._relative_path(generation5_snapshot_path))
+    g11_request_path, g11_snapshot_path = map(shared._relative_path, (generation11_request_path, generation11_snapshot_path))
+    if g11_request_path not in row_by_path or g11_snapshot_path not in row_by_path:
+        raise shared.AttemptMigrationError("generation11_coordinates_invalid")
+    if g5_snapshot["data"] != shared._committed_bytes(root, live_path, revision=restoration_commit):
+        raise shared.AttemptMigrationError("restoration_bytes_mismatch")
+    source_mode = shared._git(root, "ls-tree", restoration_commit, "--", live_path).decode("ascii").strip()
+    if not source_mode:
+        raise shared.AttemptMigrationError("restoration_source_missing")
+    if not shared._git_regular_mode_matches_live(source_mode, g5_snapshot["lstat_mode"]):
+        raise shared.AttemptMigrationError("restoration_mode_mismatch")
+    record = {
+        "schema_version": V2_SCHEMA_VERSION, "disposition": V2_DISPOSITION,
+        "governing_plan_binding": incident["governing_plan_binding"], "migration_plan_binding": incident["migration_plan_binding"],
+        "authority_review_bindings": {"specification": shared._content_binding(spec), "code_quality": shared._content_binding(quality)},
+        "attempt_binding": {"source_commit": restoration_commit, "source_tree": restoration_tree,
+                            "source_root": source_root, "archive_root": archive_root,
+                            "expected_paths_manifest_binding": manifest, "artifact_bindings": artifacts},
+        "attempt_lifecycle": {**LIFECYCLE_VALUES, "incident_binding": {
+            "path": incident_path, "size": len(incident_bytes), "sha256": shared._bytes_digest(incident_bytes)}},
+        "pre_move_repository_state": state, "protected_path_bindings": protected,
+        "ledger_lineage": {
+            "generation_5": {"generation": 5, "request_binding": shared._public_binding(g5_request), "snapshot_binding": shared._public_binding(g5_snapshot)},
+            "generation_11": {"generation": 11, **{role: shared._binding_from_row(row_by_path[path], path_field="original_path")
+                for role, path in (("request_binding", g11_request_path), ("snapshot_binding", g11_snapshot_path), ("live_binding", live_path))}},
+            "restoration_binding": {"source_path": g5_snapshot["path"], "target_path": live_path,
+                "source_commit": restoration_commit, "source_tree": restoration_tree,
+                **{k: g5_snapshot[k] for k in ("file_type", "lstat_mode", "size", "sha256")}},
+        },
+        "attempt_rows": rows, "attempt_path_count": len(rows), "attempt_path_set_sha256": shared._canonical_digest(paths),
+        "archive_path_set_sha256": shared._canonical_digest([row["archive_path"] for row in rows]),
+        "normalized_row_set_sha256": shared._canonical_digest(rows), "claims_not_made": list(V2_CLAIMS_NOT_MADE),
+    }
+    record["normalized_disposition_sha256"] = shared._canonical_digest(record)
+    validate_structure_v2(record)
+    validate_live_v2(root, record, incident_bytes=incident_bytes)
+    disposition_bytes = shared._canonical_json(record) + b"\n"
+    for name, data in (("incident", incident_bytes), ("disposition", disposition_bytes)):
+        snapshot = existing[name]
+        if snapshot is not None and (snapshot["data"] != data or snapshot["lstat_mode"] != 0o644):
+            raise shared.AttemptMigrationError(name + "_replay_mismatch")
+    for name, path, data in (("incident", incident_path, incident_bytes), ("disposition", disposition_path, disposition_bytes)):
+        if existing[name] is None:
+            shared._publish_exclusive(root, path, data, 0o644)
+    return {"incident": incident, "disposition": record}

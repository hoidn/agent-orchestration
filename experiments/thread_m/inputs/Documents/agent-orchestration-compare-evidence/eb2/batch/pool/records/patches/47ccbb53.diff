+        outcome = json.loads(archived(path).read_bytes())
+        outcome["failure_normalization"]["repository_root"] = "/wrong-root"
+        normalization = outcome["failure_normalization"]
+        normalization["normalized_contract_sha256"] = _digest(_canonical({
+            k: v for k, v in normalization.items() if k != "normalized_contract_sha256"}))
+        outcome["normalized_outcome_sha256"] = _digest(_canonical({
+            k: v for k, v in outcome.items() if k != "normalized_outcome_sha256"}))
+        outcome_bytes = _canonical(outcome) + b"\n"
+        baseline = json.loads(archived(a["baseline_path"]).read_bytes())
+        baseline["broad_outcome_binding"]["sha256"] = _digest(outcome_bytes)
+        baseline["failure_normalization"] = dict(normalization)
+        baseline_bytes = _canonical(baseline) + b"\n"
+        changes = {path: outcome_bytes, a["baseline_path"]: baseline_bytes}
+        for key in ("baseline_specification_review_path", "baseline_quality_review_path"):
+            review = json.loads(archived(a[key]).read_bytes())
+            review["subject"]["sha256"] = _digest(baseline_bytes)
+            changes[a[key]] = _canonical(review) + b"\n"
+        from orchestrator.retirement.broad_evidence import validate_record
+        assert validate_record(outcome) == []
+        assert validate_record(baseline) == []
+        _rebind(a, result, changes)
+    elif defect == "outside":
+        _write(a["root"], "outside", b"new")
+    elif defect == "staged":
+        _git(a["root"], "add", "--", "feature.py")
+    else:
+        _git(a["root"], "reset", "--soft", a["restoration_commit"])

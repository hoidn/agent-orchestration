+            prior[field] = copy
+        request["normalized_request_sha256"] = _digest(_canonical({k: v for k, v in request.items() if k != "normalized_request_sha256"}))
+        _rebind(a, result, {request_path: _canonical(request) + b"\n"})
+    elif defect.startswith("row-"):

+"""Public incident contracts over root-bound real Git and producer evidence."""
+from copy import deepcopy
+import json
+
+import pytest
+
+from orchestrator.retirement.attempt_migration import (
+    AttemptMigrationError, build_attempt_migration_incident,
+    validate_attempt_migration_incident, _canonical_json, _canonical_digest,
+)
+from tests.retirement_adopted_attempt_helpers import (
+    adopted_attempt, adopted_attempt_readonly, incident_arguments,
+)
+from tests.test_retirement_attempt_migration import _git, _digest, _write
+
+
+def _build(arguments):
+    return build_attempt_migration_incident(arguments["root"], **incident_arguments(arguments))
+
+
+def _redigest(record):
+    record["normalized_incident_sha256"] = _canonical_digest(record, exclude="normalized_incident_sha256")
+
+
+def _rebind(record, root, path):
+    data = (root / path).read_bytes()
+    for row in record["attempt_rows"]:
+        if row["path"] == path:
+            row.update(size=len(data), sha256=_digest(data))
+    for key, binding in record.items():
+        if key.endswith("_binding") and isinstance(binding, dict) and binding.get("path") == path:
+            binding.update(size=len(data), sha256=_digest(data))
+    record["normalized_attempt_row_set_sha256"] = _canonical_digest(record["attempt_rows"])
+    _redigest(record)
+
+
+def test_build_returns_exact_closed_incident_and_validate_returns_it_unchanged(adopted_attempt_readonly):
+    args = adopted_attempt_readonly
+    record = _build(args)
+    assert set(record) == {
+        "schema_version", "governing_plan_binding", "migration_plan_binding",
+        "workspace_baseline_binding", "owner_attestation_binding", "pending_attestation_snapshot_binding",
+        "known_failure_baseline_binding", "expected_paths_manifest_binding", "source_root",
+        "intended_predecessor", "predecessor_projection", "pre_move_repository_state",
+        "attempt_rows", "attempt_path_count", "attempt_path_set_sha256",
+        "normalized_attempt_row_set_sha256", "adoption_facts", "normalized_incident_sha256", "claims_not_made",
+    }
+    assert record["schema_version"] == "attempt_migration_incident.v1"
+    assert record["adoption_facts"] == {
+        "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed", "owner_identity": "Owner", "owner_role": "owner",
+        "confirmed_at": "2026-01-02T00:00:00+00:00", "adopted_at": "2026-01-02T00:00:01+00:00",
+    }
+    assert record["claims_not_made"] == ["This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."]
+    assert validate_attempt_migration_incident(args["root"], record) is record
+    assert not (args["root"] / args["incident_path"]).exists()
+
+
+@pytest.mark.parametrize("mutation", ["pending", "owner", "owner_confirmations", "owner_adoption", "identity", "malformed"])
+def test_pending_attestation_is_rejected_as_owner_lifecycle_invalid(adopted_attempt, mutation):
+    args = adopted_attempt
+    path = args["root"] / args["attestation_record_path"]
+    owner = json.loads(path.read_bytes())
+    if mutation == "pending":
+        owner["evidence_status"] = "pending_owner_confirmation"
+    elif mutation == "identity":
+        owner["owner_adoption"]["identity"] = "Other"
+    elif mutation != "malformed":
+        owner.pop(mutation)
+    path.write_bytes(b"{" if mutation == "malformed" else _canonical_json(owner) + b"\n")
+    with pytest.raises(AttemptMigrationError, match="^incident_owner_lifecycle_invalid$"):
+        _build(args)
+
+
+def test_landed_candidate_drift_is_tolerated(adopted_attempt_readonly):

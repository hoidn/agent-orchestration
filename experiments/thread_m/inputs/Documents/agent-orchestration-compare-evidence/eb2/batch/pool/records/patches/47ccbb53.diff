+            raise SourceBindingError("commit_control_trailer_invalid")
+        transaction_id, digest = coordinates
+        suffix = (
+            b"\nRetirement-Control-Schema: precommit_control.v1\n"
+            + b"Retirement-Transaction-ID: " + transaction_id.encode("ascii")
+            + b"\nRetirement-Control-SHA256: " + digest.removeprefix("sha256:").encode("ascii") + b"\n"
+        )
+        base = message[:-len(suffix)]
+        if not _base_message_bytes_valid(base) or _derive_final_message_bytes(base, transaction_id, digest) != message:
+            raise SourceBindingError("commit_control_trailer_invalid")
+    except SourceBindingError as exc:
+        raise SourceBindingError(f"predecessor_control_trailer_invalid:{commit}") from exc
+    return {"transaction_id": transaction_id, "normalized_control_sha256": digest}
+
+
+def derive_committed_predecessor_lineage(
+    repository_root: Path | str, *, baseline_head: str,
+    intended_predecessor_head: str, require_uncovered_paths: bool = False,
+) -> dict[str, Any]:
+    """Project a merge-free first-parent range, preserving raw-message identity.
+
+    The closed projection distinguishes controller-produced trailer commits
+    from uncovered commits. Its path digests hash sorted LF-terminated paths;
+    its normalized digest excludes only itself. Malformed or missing Git
+    objects and malformed reserved trailers fail closed with predecessor codes.
+    """
+    root = _repository_root(repository_root)
+    for name, value in (("baseline_head", baseline_head), ("intended_predecessor_head", intended_predecessor_head)):
+        if not isinstance(value, str) or _HEX40_RE.fullmatch(value) is None:
+            raise SourceBindingError(f"predecessor_head_invalid:{name}")
+    _commit_object(root, baseline_head)
+    intended_tree, _, _ = _commit_object(root, intended_predecessor_head)
+    if not _is_ancestor(root, baseline_head, intended_predecessor_head):
+        raise SourceBindingError("predecessor_baseline_not_ancestor")
+    rows = []
+    cursor = intended_predecessor_head
+    while cursor != baseline_head:
+        tree, parents, message = _commit_object(root, cursor)
+        if len(parents) > 1:
+            raise SourceBindingError(f"predecessor_merge_commit:{cursor}")
+        if not parents:
+            raise SourceBindingError("predecessor_first_parent_chain_invalid")
+        paths = _commit_changed_paths(root, parents[0], cursor)
+        coordinates = _strict_trailer_coordinates(message, cursor)
+        rows.append({
+            "commit": cursor, "parent": parents[0], "tree": tree,
+            "raw_message_sha256": _sha256_bytes(message), "changed_paths": paths,
+            "changed_path_set_sha256": _path_list_digest(paths),
+            "control_coordinates": coordinates,
+        })
+        cursor = parents[0]
+    rows.reverse()
+    controlled = sorted({path for row in rows if row["control_coordinates"] is not None for path in row["changed_paths"]})
+    uncovered = sorted({path for row in rows if row["control_coordinates"] is None for path in row["changed_paths"]})
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("predecessor_uncovered_paths_missing")
+    changed = sorted(set(controlled) | set(uncovered))
+    projection = {
+        "baseline_head": baseline_head,
+        "intended_predecessor_head": intended_predecessor_head,
+        "intended_predecessor_tree": intended_tree,
+        "first_parent_commits": rows, "commit_count": len(rows),
+        "changed_paths": changed, "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": controlled, "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": uncovered, "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    projection["normalized_projection_sha256"] = _canonical_sha256(projection, exclude=["normalized_projection_sha256"])
+    return projection
+
+
 def _prior_trailers(root: Path, baseline_head: str, base_head: str) -> list[dict[str, str]]:
     if baseline_head == base_head:
         return []

+"""Logical original-path views of exact live or archived attempt rows.
+
+Callers validate replay states before constructing a disposition view. Unmapped
+reads admit only no-follow regular files identical to their regular HEAD blob.
+"""
+from pathlib import Path
+from typing import Mapping, Sequence, Any
+
+from . import byte_overlay
+from .attempt_migration import (
+    AttemptMigrationError, _binding_from_row, _read_regular, _same_content,
+)
+
+
+def live_row_view(root: Path, rows: Sequence[Mapping[str, Any]]) -> dict[str, bytes]:
+    view = {}
+    for row in rows:
+        snapshot = _read_regular(root, row["path"], missing_ok=True)
+        if snapshot is not None:
+            view[row["path"]] = snapshot["data"]
+    return view
+
+
+def disposition_view(root: Path, record: Mapping[str, Any]) -> dict[str, bytes]:
+    view = {}
+    for row in record["attempt_rows"]:
+        for field in ("original_path", "archive_path"):
+            snapshot = _read_regular(root, row[field], missing_ok=True)
+            if _same_content(snapshot, _binding_from_row(row, path_field=field)):
+                view[row["original_path"]] = snapshot["data"]
+                break
+        else:
+            raise AttemptMigrationError("attempt_row_state_invalid", row["original_path"])
+    return view
+
+
+def relocation_started(root: Path, record: Mapping[str, Any]) -> bool:
+    return any((root / row["archive_path"]).exists() for row in record["attempt_rows"])
+
+
+def read_logical(root: Path, view: Mapping[str, bytes], path: str) -> bytes:
+    if path in view:
+        return view[path]
+    try:
+        snapshot = _read_regular(root, path, missing_ok=True)
+        with byte_overlay.bound_scope(root, {}, True):
+            if snapshot is not None and byte_overlay.live_permitted(
+                byte_overlay.active_scope(root), path, snapshot["data"]
+            ):
+                return snapshot["data"]
+    except (AttemptMigrationError, ValueError):
+        pass
+    raise AttemptMigrationError("attempt_row_state_invalid", path)

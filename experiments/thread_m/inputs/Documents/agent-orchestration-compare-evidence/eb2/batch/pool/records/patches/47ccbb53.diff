+def test_post_archive_validation_rejects(adopted_attempt, defect, expected):
+    a = adopted_attempt
+    result = _archived(a)
+    d = result["disposition"]
+    request_path, snapshot_path = a["generation11_request_path"], a["generation11_snapshot_path"]
+    row = lambda path: next(r for r in d["attempt_rows"] if r["original_path"] == path)
+    archived = lambda path: a["root"] / row(path)["archive_path"]
+    if defect.startswith("missing-"):
+        archived(request_path if defect == "missing-request" else snapshot_path).unlink()
+    elif defect == "swap":
+        _rebind(a, result, {request_path: archived(snapshot_path).read_bytes(), snapshot_path: archived(request_path).read_bytes()})
+    elif defect == "duplicate":

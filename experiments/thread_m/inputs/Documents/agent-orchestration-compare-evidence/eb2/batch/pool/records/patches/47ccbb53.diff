+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import source_bindings as bindings
+
+
+PROJECTION_KEYS = {
+    'baseline_head', 'intended_predecessor_head', 'intended_predecessor_tree',
+    'first_parent_commits', 'commit_count', 'changed_paths', 'changed_path_count',
+    'changed_path_set_sha256', 'controlled_paths', 'controlled_path_set_sha256',
+    'uncovered_paths', 'uncovered_path_set_sha256', 'normalized_projection_sha256',
+}
+ROW_KEYS = {
+    'commit', 'parent', 'tree', 'raw_message_sha256', 'changed_paths',
+    'changed_path_set_sha256', 'control_coordinates',
+}
+
+
+def git(root, *args, data=None):
+    return subprocess.check_output(['git', *args], cwd=root, input=data).strip()
+
+
+@pytest.fixture
+def repository(tmp_path):
+    root = tmp_path / 'repo'
+    root.mkdir()
+    git(root, 'init', '-q')
+    git(root, 'config', 'user.email', 'tests@example.invalid')
+    git(root, 'config', 'user.name', 'Tests')
+    commit(root, 'base', b'base\n')
+    return root
+
+
+def commit(root, path, message):
+    (root / path).write_bytes(message)
+    git(root, 'add', '--', path)
+    message_path = root.parent / 'message.txt'
+    message_path.write_bytes(message)
+    git(root, 'commit', '-q', '--cleanup=verbatim', '-F', str(message_path))
+    return git(root, 'rev-parse', 'HEAD').decode()
+
+
+def controlled(base=b'controlled\n'):
+    return bindings._derive_final_message_bytes(base, 'a' * 64, 'sha256:' + 'b' * 64)
+
+
+def project(root, baseline, intended=None, **kwargs):
+    return bindings.derive_committed_predecessor_lineage(
+        root, baseline_head=baseline,
+        intended_predecessor_head=intended or git(root, 'rev-parse', 'HEAD').decode(),
+        **kwargs,
+    )
+
+
+def chain(root):
+    baseline = git(root, 'rev-parse', 'HEAD').decode()
+    first = commit(root, 'z controlled', controlled())
+    second = commit(root, 'a uncovered', b'plain\n')
+    return baseline, first, second
+
+
+def test_projection_has_exact_keys_and_oldest_first_first_parent_rows(repository):
+    baseline, first, second = chain(repository)
+    result = project(repository, baseline)
+    assert set(result) == PROJECTION_KEYS
+    assert all(set(row) == ROW_KEYS for row in result['first_parent_commits'])
+    assert [row['commit'] for row in result['first_parent_commits']] == [first, second]
+    assert [row['parent'] for row in result['first_parent_commits']] == [baseline, first]
+    assert result['commit_count'] == 2
+    assert result['changed_path_count'] == 2
+    assert result['intended_predecessor_tree'] == git(repository, 'rev-parse', 'HEAD^{tree}').decode()
+    raw = subprocess.check_output(['git', 'cat-file', 'commit', first], cwd=repository)
+    assert result['first_parent_commits'][0]['raw_message_sha256'] == 'sha256:' + hashlib.sha256(raw.split(b'\n\n', 1)[1]).hexdigest()
+
+
+def test_trailer_commits_are_controlled_and_other_commits_uncovered(repository):
+    baseline, _, _ = chain(repository)
+    result = project(repository, baseline)
+    assert result['controlled_paths'] == ['z controlled']
+    assert result['uncovered_paths'] == ['a uncovered']
+    assert result['changed_paths'] == ['a uncovered', 'z controlled']
+    assert result['first_parent_commits'][0]['control_coordinates'] == {
+        'transaction_id': 'a' * 64, 'normalized_control_sha256': 'sha256:' + 'b' * 64,
+    }
+    assert result['first_parent_commits'][1]['control_coordinates'] is None
+
+
+def test_path_set_digests_hash_sorted_newline_terminated_paths(repository):
+    baseline, _, _ = chain(repository)
+    result = project(repository, baseline)
+    for field in ('changed', 'controlled', 'uncovered'):
+        raw = ''.join(path + '\n' for path in result[field + '_paths']).encode()
+        assert result[field + '_path_set_sha256'] == 'sha256:' + hashlib.sha256(raw).hexdigest()
+    for row in result['first_parent_commits']:
+        assert row['changed_path_set_sha256'] == 'sha256:' + hashlib.sha256(''.join(path + '\n' for path in row['changed_paths']).encode()).hexdigest()
+
+
+def test_normalized_projection_digest_excludes_itself(repository):
+    baseline, _, _ = chain(repository)
+    result = project(repository, baseline)
+    digest = result.pop('normalized_projection_sha256')
+    raw = json.dumps(result, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()
+    assert digest == 'sha256:' + hashlib.sha256(raw).hexdigest()
+
+
+def test_rejects_baseline_that_is_not_an_ancestor(repository):
+    baseline, _, second = chain(repository)
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_baseline_not_ancestor$'):
+        project(repository, second, baseline)
+
+
+def test_rejects_merge_in_first_parent_range(repository):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    git(repository, 'checkout', '-qb', 'side')
+    commit(repository, 'side', b'side\n')
+    git(repository, 'checkout', '-q', '-')
+    commit(repository, 'main', b'main\n')
+    git(repository, 'merge', '--no-ff', '-qm', 'merge', 'side')
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_merge_commit:'):
+        project(repository, baseline)
+
+
+@pytest.mark.parametrize('kind', ['commit', 'tree'])
+def test_rejects_missing_commit_or_tree_object(repository, kind):
+    baseline, _, second = chain(repository)
+    oid = second if kind == 'commit' else git(repository, 'rev-parse', second + '^{tree}').decode()
+    (repository / '.git' / 'objects' / oid[:2] / oid[2:]).unlink()
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_object_missing:' + oid + '$'):
+        project(repository, baseline, second)
+
+
+@pytest.mark.parametrize('message', [
+    controlled().replace(b'precommit_control.v1', b'wrong_schema.v1'),
+    controlled().replace(('a' * 64).encode(), ('a' * 63).encode()),
+    controlled().replace(b'controlled\n\n', b'controlled\n'),
+    controlled() + b'after\n',
+    b'Retirement-Control-marker\n' + controlled(),
+])
+def test_rejects_malformed_trailer_block(repository, message):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    commit(repository, 'bad', message)
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_control_trailer_invalid:'):
+        project(repository, baseline)
+
+
+def test_controller_produced_message_with_transaction_id_text_in_base_is_controlled(repository):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    base = b'Describe Retirement-Transaction-ID handling\n'
+    assert bindings._base_message_bytes_valid(base)
+    commit(repository, 'controlled', controlled(base))
+    result = project(repository, baseline)
+    assert result['controlled_paths'] == ['controlled']
+    assert result['first_parent_commits'][0]['control_coordinates'] == {
+        'transaction_id': 'a' * 64, 'normalized_control_sha256': 'sha256:' + 'b' * 64,
+    }
+
+
+def test_transaction_id_text_without_trailer_block_is_uncovered(repository):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    commit(repository, 'ordinary', b'Describe Retirement-Transaction-ID handling\n')
+    result = project(repository, baseline)
+    assert result['uncovered_paths'] == ['ordinary']
+    assert result['first_parent_commits'][0]['control_coordinates'] is None
+
+
+def test_rejects_duplicate_changed_path_projection(repository):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    blob = git(repository, 'hash-object', '-w', '--stdin', data=b'new\n').decode()
+    entry = b'100644 duplicate\0' + bytes.fromhex(blob)
+    tree = git(repository, 'hash-object', '-t', 'tree', '-w', '--literally', '--stdin', data=entry + entry).decode()
+    head = git(repository, 'commit-tree', tree, '-p', baseline, data=b'duplicate\n').decode()
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_changed_path_duplicate:' + head + '$'):
+        project(repository, baseline, head)
+
+
+def test_require_uncovered_paths_rejects_fully_controlled_range(repository):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    commit(repository, 'controlled', controlled())
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_uncovered_paths_missing$'):
+        project(repository, baseline, require_uncovered_paths=True)
+
+
+def test_equal_heads_project_empty_unless_uncovered_paths_required(repository):
+    baseline = git(repository, 'rev-parse', 'HEAD').decode()
+    result = project(repository, baseline)
+    assert result['first_parent_commits'] == []
+    assert result['changed_paths'] == []
+    assert result['commit_count'] == result['changed_path_count'] == 0
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_uncovered_paths_missing$'):
+        project(repository, baseline, require_uncovered_paths=True)
+
+
+@pytest.mark.parametrize('field,value', [('baseline_head', True), ('intended_predecessor_head', 'not-a-head')])
+def test_rejects_invalid_head_coordinates(repository, field, value):
+    head = git(repository, 'rev-parse', 'HEAD').decode()
+    arguments = {'baseline_head': head, 'intended_predecessor_head': head, field: value}
+    with pytest.raises(bindings.SourceBindingError, match='^predecessor_head_invalid:' + field + '$'):
+        bindings.derive_committed_predecessor_lineage(repository, **arguments)

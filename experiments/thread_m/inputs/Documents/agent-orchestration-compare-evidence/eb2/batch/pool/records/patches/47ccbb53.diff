index 0000000..07685d7
--- /dev/null
+++ b/orchestrator/retirement/attempt_incident.py
@@ -0,0 +1,322 @@
+"""Content-addressed owner-adopted, uncommitted predecessor incidents.
+
+The closed attempt_migration_incident.v1 contract is owned by
+adopted-attempt-predecessor-recovery.md. Adoption comes from owner bytes;
+invalidating uncovered changes and the narrow landed-candidate allowance come
+from Git. Archived validation supplies a row-bound logical byte view.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping
+
+from . import broad_evidence, byte_overlay, source_bindings
+from .attempt_migration import (
+    AttemptMigrationError, _bytes_digest, _canonical_digest, _canonical_json,
+    _committed_binding, _content_binding, _git, _git_is_ancestor,
+    _is_commit_identity, _is_tracked, _json_bytes, _manifest_paths,
+    _public_binding, _read_regular, _relative_path, _repository_root,
+    _repository_state, _require_committed_live, _require_keys, _status_paths,
+    _under, _validate_file_binding, _validate_repository_state_shape,
+    _validate_status_projection_boundaries,
+)
+from .attempt_view import live_row_view
+
+INCIDENT_SCHEMA_VERSION = "attempt_migration_incident.v1"
+FILE_BINDING_NAMES = (
+    "governing_plan", "migration_plan", "workspace_baseline", "owner_attestation",
+    "pending_attestation_snapshot", "known_failure_baseline", "expected_paths_manifest",
+)
+ATTEMPT_BINDING_NAMES = FILE_BINDING_NAMES[2:6]
+INCIDENT_TOP_LEVEL_KEYS = {
+    "schema_version", *(name + "_binding" for name in FILE_BINDING_NAMES),
+    "source_root", "intended_predecessor", "predecessor_projection",
+    "pre_move_repository_state", "attempt_rows", "attempt_path_count",
+    "attempt_path_set_sha256", "normalized_attempt_row_set_sha256",
+    "adoption_facts", "normalized_incident_sha256", "claims_not_made",
+}
+INCIDENT_ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+ADOPTION_FACT_KEYS = {
+    "adoption_state", "repository_commit_state", "evidence_status",
+    "owner_identity", "owner_role", "confirmed_at", "adopted_at",
+}
+INCIDENT_CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+
+
+def derive_adoption_facts(owner_bytes: bytes) -> dict[str, str]:
+    try:
+        owner_record = _json_bytes(owner_bytes, "owner_attestation")
+        owner = owner_record["owner"]
+        confirmations = owner_record["owner_confirmations"]
+        adoption = owner_record["owner_adoption"]
+        if owner_record["evidence_status"] != "owner_confirmed" or not all(
+            isinstance(value, dict) for value in (owner, confirmations, adoption)
+        ):
+            raise ValueError
+        values = (owner["identity"], owner["role"], confirmations["confirmed_at"],
+                  adoption["adopted_at"], adoption["identity"])
+        if any(not isinstance(value, str) or not value for value in values):
+            raise ValueError
+        if adoption["identity"] != owner["identity"]:
+            raise ValueError
+    except (AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+        raise AttemptMigrationError("incident_owner_lifecycle_invalid") from exc
+    return {
+        "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed", "owner_identity": values[0],
+        "owner_role": values[1], "confirmed_at": values[2], "adopted_at": values[3],
+    }
+
+
+def historical_candidate_for(root, kfb_record, workspace_head, projection):
+    candidate = kfb_record.get("candidate_binding", {})
+    if not broad_evidence._is_candidate_binding(candidate) or candidate.get("head") != workspace_head:
+        return None
+    landed = {}
+    for row in candidate.get("candidate_paths", []):
+        path = row["path"]
+        if path not in projection["changed_paths"]:
+            continue
+        entries = _git(root, "ls-tree", "-z", projection["intended_predecessor_head"], "--", path)
+        if row["state"] == "deleted" and not entries:
+            landed[path] = None
+        elif row["state"] in {"added", "modified"} and entries:
+            entry, tail = entries.split(b"\0", 1)
+            coordinates, raw_path = entry.split(b"\t", 1)
+            mode, kind, oid = coordinates.split(b" ")
+            if tail or raw_path.decode("utf-8") != path or mode not in {b"100644", b"100755"} or kind != b"blob":
+                continue
+            data = _git(root, "cat-file", "blob", oid.decode("ascii"))
+            if type(row["size"]) is int and len(data) == row["size"] and _bytes_digest(data) == row["sha256"]:
+                landed[path] = (row["size"], row["sha256"])
+    return byte_overlay.HistoricalCandidate(candidate["head"], candidate["head_tree"], landed)
+
+
+def _predecessor(root, workspace_head, intended):
+    try:
+        return source_bindings.derive_committed_predecessor_lineage(
+            root, baseline_head=workspace_head, intended_predecessor_head=intended,
+            require_uncovered_paths=True,
+        )
+    except source_bindings.SourceBindingError as exc:
+        raise AttemptMigrationError("incident_predecessor_projection_invalid", str(exc)) from exc
+
+
+def derive_incident(root, *, governing_plan_path, migration_plan_path,
+                    workspace_baseline_path, owner_attestation_path,
+                    pending_attestation_snapshot_path, known_failure_baseline_path,
+                    expected_paths_manifest_path, source_root,
+                    intended_predecessor_head, state):
+    coordinates = locals()
+    paths = {name: _relative_path(coordinates[name + "_path"]) for name in FILE_BINDING_NAMES}
+    source_root = _relative_path(source_root)
+    plans = {name + "_binding": _committed_binding(root, paths[name]) for name in FILE_BINDING_NAMES[:2]}
+    manifest = _require_committed_live(root, paths["expected_paths_manifest"])
+    expected = _manifest_paths(manifest["data"], manifest["path"])
+    if any(not _under(path, source_root) for path in expected):
+        raise AttemptMigrationError("expected_path_outside_source_root")
+    status_rows = state["status_projection"]["rows"]
+    _validate_status_projection_boundaries(status_rows, source_root)
+    observed = _status_paths(status_rows, source_root)
+    if observed != expected:
+        raise AttemptMigrationError("source_set_mismatch", _canonical_json({"expected": expected, "observed": observed}).decode())
+    rows = []
+    for path in expected:
+        snapshot = _read_regular(root, path)
+        rows.append({**_public_binding(snapshot), "tracked_state": "modified" if _is_tracked(root, path) else "untracked"})
+    by_path = {row["path"]: row for row in rows}
+    if any(paths[name] not in by_path for name in ATTEMPT_BINDING_NAMES):
+        raise AttemptMigrationError("incident_attempt_coordinates_invalid")
+    view = live_row_view(root, rows)
+    adoption = derive_adoption_facts(view[paths["owner_attestation"]])
+    try:
+        workspace = _json_bytes(view[paths["workspace_baseline"]], paths["workspace_baseline"])
+        workspace_head = workspace["head"]
+    except (AttemptMigrationError, KeyError, TypeError) as exc:
+        raise AttemptMigrationError("incident_workspace_baseline_binding_invalid") from exc
+    projection = _predecessor(root, workspace_head, intended_predecessor_head)
+    record = {
+        "schema_version": INCIDENT_SCHEMA_VERSION, **plans,
+        **{name + "_binding": _content_binding(by_path[paths[name]]) for name in ATTEMPT_BINDING_NAMES},
+        "expected_paths_manifest_binding": {**_content_binding(manifest), "row_count": len(expected)},
+        "source_root": source_root,
+        "intended_predecessor": {"head": intended_predecessor_head, "tree": projection["intended_predecessor_tree"]},
+        "predecessor_projection": projection, "pre_move_repository_state": state,
+        "attempt_rows": rows, "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": _canonical_digest(expected),
+        "normalized_attempt_row_set_sha256": _canonical_digest(rows),
+        "adoption_facts": adoption, "claims_not_made": list(INCIDENT_CLAIMS_NOT_MADE),
+    }
+    record["normalized_incident_sha256"] = _canonical_digest(record)
+    return validate_incident_with_view(root, record, view, check_live_rows=True)
+
+
+def _validate_shape(record):
+    _require_keys(record, INCIDENT_TOP_LEVEL_KEYS, "incident_keys_mismatch")
+    if record["schema_version"] != INCIDENT_SCHEMA_VERSION:
+        raise AttemptMigrationError("incident_schema_invalid")
+    if record["claims_not_made"] != INCIDENT_CLAIMS_NOT_MADE:
+        raise AttemptMigrationError("incident_claims_invalid")
+    if record["normalized_incident_sha256"] != _canonical_digest(record, exclude="normalized_incident_sha256"):
+        raise AttemptMigrationError("incident_digest_mismatch")
+    for name in FILE_BINDING_NAMES:
+        key = name + "_binding"
+        try:
+            binding = record[key]
+            if name == "expected_paths_manifest":
+                _require_keys(binding, {"path", "size", "sha256", "row_count"}, "invalid")
+                if type(binding["row_count"]) is not int or binding["row_count"] < 1:
+                    raise ValueError
+                binding = {k: v for k, v in binding.items() if k != "row_count"}
+            _validate_file_binding(binding, full=False)
+        except (AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+            raise AttemptMigrationError("incident_structure_invalid", key) from exc
+    for key in ("source_root", "intended_predecessor"):
+        try:
+            if key == "source_root":
+                _relative_path(record[key])
+            else:
+                _require_keys(record[key], {"head", "tree"}, "invalid")
+                if not all(_is_commit_identity(value) for value in record[key].values()):
+                    raise ValueError
+        except (AttemptMigrationError, TypeError, ValueError) as exc:
+            raise AttemptMigrationError("incident_structure_invalid", key) from exc
+    status_rows = _validate_repository_state_shape(record["pre_move_repository_state"], record["source_root"])
+    rows = record["attempt_rows"]
+    try:
+        if not isinstance(rows, list) or not rows:
+            raise ValueError
+        for row in rows:
+            _require_keys(row, INCIDENT_ROW_KEYS, "invalid")
+            _validate_file_binding({k: v for k, v in row.items() if k != "tracked_state"})
+            if row["tracked_state"] not in {"modified", "untracked"} or not _under(row["path"], record["source_root"]):
+                raise ValueError
+        paths = [row["path"] for row in rows]
+        if (paths != sorted(set(paths)) or paths != _status_paths(status_rows, record["source_root"])
+            or type(record["attempt_path_count"]) is not int or record["attempt_path_count"] != len(rows)
+            or record["attempt_path_set_sha256"] != _canonical_digest(paths)
+            or record["normalized_attempt_row_set_sha256"] != _canonical_digest(rows)):
+            raise ValueError
+    except (AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+        raise AttemptMigrationError("incident_attempt_rows_invalid") from exc
+    _require_keys(record["adoption_facts"], ADOPTION_FACT_KEYS, "incident_adoption_facts_mismatch")
+    by_path = {row["path"]: row for row in rows}
+    for name in ATTEMPT_BINDING_NAMES:
+        binding = record[name + "_binding"]
+        if binding["path"] not in by_path or _canonical_json(binding) != _canonical_json(_content_binding(by_path[binding["path"]])):
+            raise AttemptMigrationError("incident_attempt_coordinates_invalid")
+    return paths
+
+
+def validate_incident_with_view(root, record, view, *, check_live_rows):
+    try:
+        return _validate_incident(root, record, view, check_live_rows=check_live_rows)
+    except (KeyError, TypeError, ValueError) as exc:
+        raise AttemptMigrationError("incident_structure_invalid") from exc
+
+
+def _validate_incident(root, record, view, *, check_live_rows):
+    paths = _validate_shape(record)
+    for name in ("governing_plan", "migration_plan", "expected_paths_manifest"):
+        binding = record[name + "_binding"]
+        try:
+            snapshot = _require_committed_live(root, binding["path"])
+            expected = _content_binding(snapshot)
+            if name == "expected_paths_manifest":
+                manifest_paths = _manifest_paths(snapshot["data"], binding["path"])
+                expected["row_count"] = len(manifest_paths)
+                if manifest_paths != paths:
+                    raise ValueError
+            if _canonical_json(expected) != _canonical_json(binding):
+                raise ValueError
+        except (AttemptMigrationError, ValueError) as exc:
+            raise AttemptMigrationError("incident_" + name + "_binding_invalid") from exc
+    for name in ATTEMPT_BINDING_NAMES:
+        binding = record[name + "_binding"]
+        data = view.get(binding["path"])
+        if data is None or len(data) != binding["size"] or _bytes_digest(data) != binding["sha256"]:
+            raise AttemptMigrationError("incident_" + name + "_binding_invalid")
+    owner_bytes = view[record["owner_attestation_binding"]["path"]]
+    adoption = derive_adoption_facts(owner_bytes)
+    if _canonical_json(adoption) != _canonical_json(record["adoption_facts"]):
+        raise AttemptMigrationError("incident_adoption_facts_mismatch")
+    owner = _json_bytes(owner_bytes, "owner_attestation")
+    try:
+        pending = _json_bytes(view[record["pending_attestation_snapshot_binding"]["path"]], "pending_snapshot")
+        omitted = {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+        if (pending.get("evidence_status") != "pending_owner_confirmation" or broad_evidence.validate_record(pending)
+            or _canonical_json({k: v for k, v in pending.items() if k not in omitted})
+            != _canonical_json({k: v for k, v in owner.items() if k not in omitted})):
+            raise ValueError
+    except (AttemptMigrationError, ValueError) as exc:
+        raise AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid") from exc
+    try:
+        workspace = _json_bytes(view[record["workspace_baseline_binding"]["path"]], "workspace_baseline")
+        if source_bindings.validate_workspace_record_shape(workspace) or not _is_commit_identity(workspace.get("head")):
+            raise ValueError
+    except (AttemptMigrationError, ValueError) as exc:
+        raise AttemptMigrationError("incident_workspace_baseline_binding_invalid") from exc
+    intended = record["intended_predecessor"]["head"]
+    projection = _predecessor(root, workspace["head"], intended)
+    if _canonical_json(projection) != _canonical_json(record["predecessor_projection"]):
+        raise AttemptMigrationError("incident_predecessor_projection_mismatch")
+    if _canonical_json(record["intended_predecessor"]) != _canonical_json({"head": intended, "tree": projection["intended_predecessor_tree"]}):
+        raise AttemptMigrationError("incident_intended_predecessor_invalid")
+    state = record["pre_move_repository_state"]
+    if _git(root, "rev-parse", state["head"] + "^{tree}").decode().strip() != state["tree"]:
+        raise AttemptMigrationError("capture_head_tree_mismatch")
+    if not _git_is_ancestor(root, intended, state["head"]):
+        raise AttemptMigrationError("incident_intended_predecessor_not_ancestor")
+    if not _git_is_ancestor(root, state["head"], "HEAD"):
+        raise AttemptMigrationError("capture_head_not_ancestor")
+    try:
+        baseline = _json_bytes(view[record["known_failure_baseline_binding"]["path"]], "known_failure_baseline")
+    except AttemptMigrationError as exc:
+        raise AttemptMigrationError("incident_known_failure_baseline_binding_invalid") from exc
+    allowance = historical_candidate_for(root, baseline, workspace["head"], projection)
+    with byte_overlay.historical_candidate_scope(root, allowance):
+        for name, value in (("known_failure_baseline", baseline), ("owner_attestation", owner)):
+            issues = broad_evidence.validate_bound_record(value, root, bound_file_bytes=view, require_committed_fallback=True)
+            if issues:
+                raise AttemptMigrationError("incident_" + name + "_binding_invalid", ",".join(sorted({issue.code for issue in issues})))
+    baseline_binding = record["known_failure_baseline_binding"]
+    owner_baseline = owner.get("baseline_binding")
+    if not isinstance(owner_baseline, dict) or _canonical_json({k: owner_baseline.get(k) for k in ("path", "sha256")}) != _canonical_json({k: baseline_binding[k] for k in ("path", "sha256")}):
+        raise AttemptMigrationError("incident_owner_attestation_binding_invalid")
+    for row in record["attempt_rows"]:
+        data = view.get(row["path"])
+        if data is None or len(data) != row["size"] or _bytes_digest(data) != row["sha256"]:
+            raise AttemptMigrationError("attempt_row_state_invalid", row["path"])
+    if check_live_rows:
+        for row in record["attempt_rows"]:
+            try:
+                snapshot = _read_regular(root, row["path"])
+                if _canonical_json(_public_binding(snapshot)) != _canonical_json({k: v for k, v in row.items() if k != "tracked_state"}):
+                    raise ValueError
+            except (AttemptMigrationError, ValueError) as exc:
+                raise AttemptMigrationError("attempt_row_state_invalid", row["path"]) from exc
+        if _status_paths(_repository_state(root)["status_projection"]["rows"], record["source_root"]) != paths:
+            raise AttemptMigrationError("source_set_mismatch")
+    return record
+
+
+def build_attempt_migration_incident(repository_root, *, governing_plan_path,
+        migration_plan_path, workspace_baseline_path, owner_attestation_path,
+        pending_attestation_snapshot_path, known_failure_baseline_path,
+        expected_paths_manifest_path, source_root, intended_predecessor_head) -> dict:
+    """Derive a closed incident from committed authorities, live files and Git."""
+    coordinates = dict(locals())
+    root = _repository_root(coordinates.pop("repository_root"))
+    return derive_incident(root, **coordinates, state=_repository_state(root))
+
+
+def validate_attempt_migration_incident(repository_root, record) -> dict:
+    """Validate pre-relocation bytes and return the incident unchanged."""
+    root = _repository_root(repository_root)
+    try:
+        view = live_row_view(root, record["attempt_rows"])
+    except (KeyError, TypeError, ValueError) as exc:
+        raise AttemptMigrationError("incident_structure_invalid") from exc
+    return validate_incident_with_view(root, record, view, check_live_rows=True)

+def test_noncontiguous_overlay_ancestor_reports_request_prior_generation_invalid(chain):
+    root, bindings, files = chain
+    _hide_lineage(root, files)
+    binding = _rewrite_request(files, bindings[-1],
+        lambda request: request["prior_generation_binding"].update(generation=1))
+    assert "request_prior_generation_invalid" in {issue.code for issue in _validate(root, binding, files)}
+

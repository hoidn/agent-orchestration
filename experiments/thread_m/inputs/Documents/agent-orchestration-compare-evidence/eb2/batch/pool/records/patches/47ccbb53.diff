+
+def _write_record(a, key, record, digest_key):
+    record[digest_key] = _digest(_canonical({k: v for k, v in record.items() if k != digest_key}))
+    _write(a["root"], a[key], _canonical(record) + b"\n")
+
+
+def _rebind(a, result, changes, *, incident=True, coordinates=True):
+    d, i = result["disposition"], result["incident"]
+    for path, data in changes.items():
+        row = next(r for r in d["attempt_rows"] if r["original_path"] == path)
+        (a["root"] / row["archive_path"]).chmod(row["lstat_mode"] | 0o200)
+        _write(a["root"], row["archive_path"], data, mode=row["lstat_mode"])
+        row.update(size=len(data), sha256=_digest(data))
+        if coordinates:
+            for binding in [*d["ledger_lineage"]["generation_11"].values(),
+                            *d["attempt_binding"]["artifact_bindings"].values()]:
+                if isinstance(binding, dict) and binding.get("path") == path:
+                    binding.update(size=len(data), sha256=_digest(data))
+        if incident:
+            ir = next(r for r in i["attempt_rows"] if r["path"] == path)
+            ir.update(size=len(data), sha256=_digest(data))
+            for binding in i.values():
+                if isinstance(binding, dict) and binding.get("path") == path:
+                    binding.update(size=len(data), sha256=_digest(data))
+    d["normalized_row_set_sha256"] = _digest(_canonical(d["attempt_rows"]))
+    if incident:
+        i["normalized_attempt_row_set_sha256"] = _digest(_canonical(i["attempt_rows"]))
+        _write_record(a, "incident_path", i, "normalized_incident_sha256")
+        data = (a["root"] / a["incident_path"]).read_bytes()
+        d["attempt_lifecycle"]["incident_binding"].update(size=len(data), sha256=_digest(data))
+    _write_record(a, "disposition_path", d, "normalized_disposition_sha256")
+
+
+def _cli(a):
+    args = [sys.executable, "-m", "orchestrator.retirement.attempt_migration", "capture-invalidated-adopted",
+            "--repository-root", str(a["root"])]
+    for key, value in capture_arguments(a).items():
+        if key == "protected_paths":
+            for path in value:
+                args.extend(["--protected-path", path])
+        else:
+            args.extend(["--" + key.replace("_", "-"), str(value)])
+    return subprocess.run(args, capture_output=True)
+

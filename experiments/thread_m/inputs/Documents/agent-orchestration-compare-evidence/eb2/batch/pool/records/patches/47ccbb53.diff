+"""Scoped repository byte views for archived retirement evidence.
+
+Overlays redirect file reads only. Git identity and candidate checks remain live;
+committed fallback admits only regular HEAD blobs with identical live bytes.
+Non-fallback overlays also work in non-Git directories, preserving ledger builders;
+upgrading such a scope to committed fallback requires a resolvable HEAD.
+"""
+from __future__ import annotations
+
+import contextvars
+import os
+import stat
+import subprocess
+from contextlib import contextmanager
+from dataclasses import dataclass, replace
+from pathlib import Path, PurePosixPath
+from typing import Iterable, Iterator, Mapping
+
+
+@dataclass(frozen=True)
+class HistoricalCandidate:
+    head: str
+    head_tree: str
+    landed: Mapping[str, tuple[int, str] | None]
+
+
+@dataclass(frozen=True)
+class ReadScope:
+    repository_root: Path
+    head: str
+    files: Mapping[str, bytes]
+    require_committed_fallback: bool
+    historical_candidate: HistoricalCandidate | None
+    head_blobs: dict[str, bytes | None]
+
+
+_SCOPE: contextvars.ContextVar[ReadScope | None] = contextvars.ContextVar(
+    "retirement_read_scope", default=None
+)
+
+
+def _git(root: Path, *arguments: str) -> bytes:
+    result = subprocess.run(
+        ["git", *arguments], cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE
+    )
+    if result.returncode:
+        raise ValueError("bound_scope_git_unreadable")
+    return result.stdout
+
+
+def active_scope(repository_root: Path | str) -> ReadScope | None:
+    scope = _SCOPE.get()
+    return scope if scope and Path(repository_root).resolve() == scope.repository_root else None
+
+
+def _valid_path(path: str) -> bool:
+    return (
+        isinstance(path, str) and bool(path) and "\x00" not in path
+        and not PurePosixPath(path).is_absolute()
+        and all(part not in {"", ".", ".."} for part in path.split("/"))
+    )
+
+
+def _scope(root: Path, require_head: bool = False) -> ReadScope:
+    active = _SCOPE.get()
+    if active is not None:
+        if active.repository_root != root:
+            raise ValueError("bound_scope_repository_mismatch")
+        if active.head or not require_head:
+            return active
+        return replace(active, head=_git(root, "rev-parse", "HEAD").decode("ascii").strip())
+    try:
+        head = _git(root, "rev-parse", "HEAD").decode("ascii").strip()
+    except ValueError:
+        if require_head:
+            raise
+        head = ""
+    return ReadScope(root, head, {}, False, None, {})
+
+
+@contextmanager
+def bound_scope(repository_root, bound_file_bytes: Mapping[str, bytes] | None,
+                require_committed_fallback: bool) -> Iterator[None]:
+    if bound_file_bytes is None and not require_committed_fallback:
+        yield
+        return
+    files = dict(bound_file_bytes or {})
+    if any(not _valid_path(path) for path in files):
+        raise ValueError("bound_scope_path_invalid")
+    scope = _scope(Path(repository_root).resolve(), require_committed_fallback)
+    token = _SCOPE.set(replace(
+        scope, files={**scope.files, **files},
+        require_committed_fallback=scope.require_committed_fallback or require_committed_fallback,
+    ))
+    try:
+        yield
+    finally:
+        _SCOPE.reset(token)
+
+
+@contextmanager
+def historical_candidate_scope(repository_root, candidate: HistoricalCandidate | None) -> Iterator[None]:
+    scope = _scope(Path(repository_root).resolve())
+    token = _SCOPE.set(replace(scope, historical_candidate=candidate))
+    try:
+        yield
+    finally:
+        _SCOPE.reset(token)
+
+
+def mapped_bytes(scope: ReadScope, path: str) -> bytes | None:
+    return scope.files.get(path)
+
+
+def live_permitted(scope: ReadScope, path: str, live_bytes: bytes) -> bool:
+    if not scope.require_committed_fallback:
+        return True
+    if path not in scope.head_blobs:
+        data = None
+        try:
+            entries = _git(scope.repository_root, "ls-tree", "-z", scope.head, "--", path).split(b"\0")
+            if len(entries) == 2 and entries[1] == b"":
+                coordinates, raw_path = entries[0].split(b"\t", 1)
+                mode, kind, oid = coordinates.split(b" ")
+                if mode in {b"100644", b"100755"} and kind == b"blob" and raw_path.decode("utf-8") == path:
+                    data = _git(scope.repository_root, "cat-file", "blob", oid.decode("ascii"))
+        except (ValueError, UnicodeError):
+            pass
+        scope.head_blobs[path] = data
+    return scope.head_blobs[path] is not None and scope.head_blobs[path] == live_bytes
+
+
+def _live_bytes(scope: ReadScope, path: str) -> bytes | None:
+    descriptor = os.open(scope.repository_root, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        parts = path.split("/")
+        for part in parts[:-1]:
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
+            os.close(descriptor)
+            descriptor = child
+        file_fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=descriptor)
+        try:
+            if not stat.S_ISREG(os.fstat(file_fd).st_mode):
+                return None
+            with os.fdopen(file_fd, "rb", closefd=False) as stream:
+                return stream.read()
+        finally:
+            os.close(file_fd)
+    except OSError:
+        return None
+    finally:
+        os.close(descriptor)
+
+
+def merged_names(scope: ReadScope, directory: str, live_names: Iterable[str]) -> list[str]:
+    prefix = directory.rstrip("/") + "/" if directory not in {"", "."} else ""
+    names = set()
+    for name in live_names:
+        path = prefix + name
+        if not scope.require_committed_fallback:
+            names.add(name)
+            continue
+        try:
+            if not stat.S_ISREG((scope.repository_root / path).lstat().st_mode):
+                names.add(name)
+                continue
+        except OSError:
+            continue
+        data = _live_bytes(scope, path)
+        if data is not None and live_permitted(scope, path, data):
+            names.add(name)
+    names.update(path[len(prefix):].split("/", 1)[0] for path in scope.files if path.startswith(prefix))
+    return sorted(names)
+
+
+def list_files(scope: ReadScope, prefix: str, live_files: Iterable[str]) -> list[str]:
+    prefix = prefix.rstrip("/") + "/"
+    paths = set()
+    for path in live_files:
+        if not path.startswith(prefix):
+            continue
+        data = _live_bytes(scope, path) if scope.require_committed_fallback else b""
+        if data is not None and live_permitted(scope, path, data):
+            paths.add(path)
+    paths.update(path for path in scope.files if path.startswith(prefix))
+    return sorted(paths)

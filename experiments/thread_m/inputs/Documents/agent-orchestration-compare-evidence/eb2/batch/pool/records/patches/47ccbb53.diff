+        (directory / "unexpected").mkdir()
+    else:
+        name = "a" * 64 if depth < 2 else f"specification-{'c' * 64}.json"
+        if kind == "symlink":
+            (directory / name).symlink_to(root / "p")
+        else:
+            import os
+            os.mkfifo(directory / name)
+    if kind != "fifo":
+        with pytest.raises(broad.ContractError, match="immutable_review_path_invalid"):
+            broad._validated_immutable_review_bindings(root, Path("evidence"))
+    with overlay.bound_scope(root, {"unrelated": b"mapped"}, committed_fallback):
+        with pytest.raises(broad.ContractError, match="immutable_review_path_invalid"):
+            broad._validated_immutable_review_bindings(root, Path("evidence"))
+
+
+def test_scoped_immutable_review_enumeration_accepts_missing_live_root(repositories):
+    root, _ = repositories
+    with overlay.bound_scope(root, {"unrelated": b"mapped"}, True):
+        assert broad._validated_immutable_review_bindings(root, Path("evidence")) == []
+
+
+def test_committed_review_fallback_filters_uncommitted_regular_file_before_layout_check(repositories):
+    root, _ = repositories
+    path = root / "evidence/immutable-reviews/uncommitted-malformed.json"
+    path.parent.mkdir(parents=True)
+    path.write_bytes(b"uncommitted")
+    with overlay.bound_scope(root, {"unrelated": b"mapped"}, False):
+        with pytest.raises(broad.ContractError, match="immutable_review_path_invalid"):
+            broad._validated_immutable_review_bindings(root, Path("evidence"))
+    with overlay.bound_scope(root, {"unrelated": b"mapped"}, True):
+        assert broad._validated_immutable_review_bindings(root, Path("evidence")) == []

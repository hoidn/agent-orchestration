+++ b/orchestrator/retirement/attempt_disposition_v2.py
@@ -0,0 +1,190 @@
+"""Closed owner-adopted uncommitted recovery disposition and logical replay.
+
+The incident binds historical adoption; it never transfers to later evidence.
+Generation coordinates are checked before reopening the incident's baseline.
+Ledger and evidence semantics remain owned by their existing validators.
+"""
+from pathlib import Path
+
+from . import attempt_migration as shared, broad_evidence, materialization
+from .attempt_incident import historical_candidate_for, validate_incident_with_view
+from .attempt_view import disposition_view, read_logical, relocation_started
+from .byte_overlay import historical_candidate_scope
+
+V2_SCHEMA_VERSION = "attempt_migration_disposition.v2"
+V2_DISPOSITION = "archive_invalidated_owner_adopted_uncommitted_attempt_and_restore_tracked_files"
+V2_TOP_LEVEL_KEYS = shared.TOP_LEVEL_KEYS | {"attempt_lifecycle"}
+V2_ARTIFACT_ROLES = (
+    "baseline", "baseline_specification_review", "baseline_quality_review",
+    "workspace_baseline", "attestation_request", "attestation_snapshot", "attestation_record",
+)
+V2_CLAIMS_NOT_MADE = [
+    "The captured attempt was personally owner-adopted but remained uncommitted when its repository predecessor was invalidated.",
+    "Historical owner adoption remains bound only to the archived attempt and may not be transferred to or consumed by any later attestation, index, or completion claim.",
+    "Archival relocation preserves bytes but grants no mutation or completion authority.",
+    "A later attempt may begin only after the tracked live file equals its reviewed restoration binding.",
+]
+LIFECYCLE_VALUES = {
+    "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+    "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+    "workspace_baseline_role": "workspace_baseline", "owner_attestation_role": "attestation_record",
+    "adoption_transfer": "forbidden",
+}
+ATTEMPT_LIFECYCLE_KEYS = set(LIFECYCLE_VALUES) | {"incident_binding"}
+SNAPSHOT_SIDE = {"generation_snapshot_slot_extra", "snapshot_path_mismatch", "snapshot_output_mismatch",
+                 "snapshot_output_contract_invalid", "snapshot_unreadable"}
+
+
+def _coordinate_error(role):
+    return shared.AttemptMigrationError("semantic_coordinate_row_binding_mismatch", role)
+
+
+def validate_structure_v2(record):
+    shared._require_keys(record, V2_TOP_LEVEL_KEYS, "disposition_keys_mismatch")
+    if record["schema_version"] != V2_SCHEMA_VERSION:
+        raise shared.AttemptMigrationError("disposition_schema_invalid")
+    if record["disposition"] != V2_DISPOSITION:
+        raise shared.AttemptMigrationError("disposition_value_invalid")
+    if record["claims_not_made"] != V2_CLAIMS_NOT_MADE:
+        raise shared.AttemptMigrationError("disposition_claims_invalid")
+    if record["normalized_disposition_sha256"] != shared._canonical_digest(record, exclude="normalized_disposition_sha256"):
+        raise shared.AttemptMigrationError("normalized_disposition_digest_mismatch")
+    try:
+        lifecycle = shared._require_keys(record["attempt_lifecycle"], ATTEMPT_LIFECYCLE_KEYS, "attempt_lifecycle_invalid")
+        if any(lifecycle[k] != v for k, v in LIFECYCLE_VALUES.items()):
+            raise shared.AttemptMigrationError("attempt_lifecycle_invalid")
+        shared._validate_file_binding(lifecycle["incident_binding"], full=False)
+    except (shared.AttemptMigrationError, TypeError, KeyError) as exc:
+        raise shared.AttemptMigrationError("attempt_lifecycle_invalid") from exc
+    attempt = record["attempt_binding"]
+    shared._reject_output_overlap(lifecycle["incident_binding"]["path"], attempt["source_root"], attempt["archive_root"],
+                                  [row["original_path"] for row in record["attempt_rows"]])
+    attempt, artifacts, rows, g5, g11, restoration = shared._validate_disposition_body(record, V2_ARTIFACT_ROLES)
+    coordinates = {
+        "generation5_request": g5["request_binding"], "generation5_snapshot": g5["snapshot_binding"],
+        "generation11_request": g11["request_binding"], "generation11_snapshot": g11["snapshot_binding"],
+        "generation11_live": g11["live_binding"], **{role: artifacts[role] for role in V2_ARTIFACT_ROLES},
+    }
+    paths = [binding["path"] for binding in coordinates.values()]
+    if len(paths) != len(set(paths)):
+        raise shared.AttemptMigrationError("semantic_coordinate_alias")
+    row_by_path = {row["original_path"]: row for row in rows}
+    for role, binding in coordinates.items():
+        if role.startswith("generation5_"):
+            continue
+        row = row_by_path.get(binding["path"])
+        if row is None or shared._canonical_json(binding) != shared._canonical_json(shared._binding_from_row(row, path_field="original_path")):
+            raise _coordinate_error(role)
+    if row_by_path[g11["live_binding"]["path"]]["tracked_state"] != "modified":
+        raise _coordinate_error("generation11_live")
+    if restoration["source_path"] != g5["snapshot_binding"]["path"] or restoration["target_path"] != g11["live_binding"]["path"]:
+        raise shared.AttemptMigrationError("semantic_restoration_coordinate_mismatch")
+    if shared._content_metadata(restoration) != shared._content_metadata(g5["snapshot_binding"]):
+        raise shared.AttemptMigrationError("semantic_restoration_metadata_mismatch")
+    if restoration["source_commit"] != attempt["source_commit"] or restoration["source_tree"] != attempt["source_tree"]:
+        raise shared.AttemptMigrationError("restoration_coordinates_mismatch")
+    return record
+
+
+def _generation11_coordinate_role(root, record, view):
+    lineage = record["ledger_lineage"]
+    g11, g5 = lineage["generation_11"], lineage["generation_5"]
+    request_path = g11["request_binding"]["path"]
+    output = g11["live_binding"]["path"]
+    try:
+        evidence_root = materialization._evidence_root_from_request_path(Path(request_path))
+        def request_at(path, generation):
+            request = shared._json_bytes(read_logical(root, view, path), path)
+            if (broad_evidence.validate_record(request) or request.get("record_kind") != "execution-ledger"
+                    or request.get("generation") != generation or request.get("output_path") != output
+                    or path != materialization._request_path(evidence_root, Path(output), generation, request["normalized_request_sha256"]).as_posix()):
+                raise ValueError("request coordinates")
+            return request
+        request = request_at(request_path, 11)
+        for generation in range(11, 5, -1):
+            prior = request["prior_generation_binding"]
+            if prior["generation"] != generation - 1 or prior["output_path"] != output:
+                raise ValueError("prior coordinates")
+            prior_request = read_logical(root, view, prior["request_path"])
+            prior_snapshot = read_logical(root, view, prior["snapshot_path"])
+            if shared._bytes_digest(prior_request) != prior["request_sha256"] or shared._bytes_digest(prior_snapshot) != prior["snapshot_sha256"]:
+                raise ValueError("prior digest")
+            if prior["snapshot_path"] != materialization._snapshot_path(evidence_root, Path(output), generation - 1, prior["snapshot_sha256"]).as_posix():
+                raise ValueError("snapshot coordinates")
+            request = request_at(prior["request_path"], generation - 1)
+            if generation == 6 and any(prior[key] != g5[role][field] for key, role, field in (
+                ("request_path", "request_binding", "path"), ("request_sha256", "request_binding", "sha256"),
+                ("snapshot_path", "snapshot_binding", "path"), ("snapshot_sha256", "snapshot_binding", "sha256"),
+            )):
+                raise ValueError("generation5 coordinates")
+    except (shared.AttemptMigrationError, materialization.MaterializationError, KeyError, TypeError, ValueError):
+        raise _coordinate_error("generation11_request") from None
+    try:
+        snapshot_path = g11["snapshot_binding"]["path"]
+        snapshot = read_logical(root, view, snapshot_path)
+        if snapshot_path != materialization._snapshot_path(evidence_root, Path(output), 11, shared._bytes_digest(snapshot)).as_posix():
+            raise ValueError("snapshot coordinates")
+    except (shared.AttemptMigrationError, KeyError, TypeError, ValueError):
+        raise _coordinate_error("generation11_snapshot") from None
+
+
+def require_incident_committed(root, record):
+    binding = record["attempt_lifecycle"]["incident_binding"]
+    try:
+        if shared._canonical_json(shared._content_binding(shared._require_committed_live(root, binding["path"]))) != shared._canonical_json(binding):
+            raise ValueError("incident binding")
+    except (shared.AttemptMigrationError, ValueError) as exc:
+        raise shared.AttemptMigrationError("incident_not_committed_at_head") from exc
+
+
+def validate_live_v2(root, record, *, ignored_paths=(), incident_bytes=None):
+    shared._validate_live_bindings(root, record)
+    binding = record["attempt_lifecycle"]["incident_binding"]
+    if incident_bytes is None:
+        snapshot = shared._read_regular(root, binding["path"])
+        if snapshot["lstat_mode"] != 0o644:
+            raise shared.AttemptMigrationError("incident_mode_invalid")
+        incident_bytes = snapshot["data"]
+    if len(incident_bytes) != binding["size"] or shared._bytes_digest(incident_bytes) != binding["sha256"]:
+        raise shared.AttemptMigrationError("incident_binding_mismatch")
+    incident = shared._json_bytes(incident_bytes, binding["path"])
+    if incident_bytes != shared._canonical_json(incident) + b"\n":
+        raise shared.AttemptMigrationError("incident_not_canonical")
+    view = disposition_view(root, record)
+    _generation11_coordinate_role(root, record, view)
+    g11 = record["ledger_lineage"]["generation_11"]
+    if shared._byte_identity(g11["snapshot_binding"]) != shared._byte_identity(g11["live_binding"]):
+        raise shared.AttemptMigrationError("generation11_snapshot_live_mismatch")
+    validate_incident_with_view(root, incident, view, check_live_rows=False)
+    attempt = record["attempt_binding"]
+    artifacts = attempt["artifact_bindings"]
+    pairs = [(field, incident[field], record[field]) for field in ("governing_plan_binding", "migration_plan_binding")]
+    pairs.extend([
+        ("source_root", incident["source_root"], attempt["source_root"]),
+        ("expected_paths_manifest_binding", incident["expected_paths_manifest_binding"],
+         {k: attempt["expected_paths_manifest_binding"][k] for k in ("path", "size", "sha256", "row_count")}),
+        ("pre_move_repository_state", incident["pre_move_repository_state"], record["pre_move_repository_state"]),
+        ("attempt_rows", incident["attempt_rows"], [
+            {"path": row["original_path"], **{k: row[k] for k in ("file_type", "lstat_mode", "size", "sha256", "tracked_state")}}
+            for row in record["attempt_rows"]]),
+    ])
+    for role, field in (("workspace_baseline", "workspace_baseline_binding"), ("attestation_record", "owner_attestation_binding"),
+                        ("attestation_snapshot", "pending_attestation_snapshot_binding"), ("baseline", "known_failure_baseline_binding")):
+        pairs.append((role, incident[field], {k: artifacts[role][k] for k in ("path", "size", "sha256")}))
+    for field, left, right in pairs:
+        if shared._canonical_json(left) != shared._canonical_json(right):
+            raise shared.AttemptMigrationError("incident_coordinate_mismatch", field)
+    baseline = shared._json_bytes(view[artifacts["baseline"]["path"]], artifacts["baseline"]["path"])
+    workspace = shared._json_bytes(view[artifacts["workspace_baseline"]["path"]], artifacts["workspace_baseline"]["path"])
+    allowance = historical_candidate_for(root, baseline, workspace["head"], incident["predecessor_projection"])
+    with historical_candidate_scope(root, allowance):
+        for request, snapshot, request_role, snapshot_role in (
+            (g11["request_binding"], g11["snapshot_binding"], "generation11_request", "generation11_snapshot"),
+            (artifacts["attestation_request"], artifacts["attestation_snapshot"], "attestation_request", "attestation_snapshot"),
+        ):
+            issues = materialization.validate_generation(root, Path(request["path"]), Path(snapshot["path"]),
+                                                        bound_file_bytes=view, require_committed_fallback=True)
+            if issues:
+                raise _coordinate_error(request_role if any(i.code not in SNAPSHOT_SIDE for i in issues) else snapshot_role)
+    if relocation_started(root, record):
+        shared._require_outside_status_projection_unchanged(root, record, additional_ignored_paths=ignored_paths)
diff --git a/orchestrator/retirement/attempt_incident.py b/orchestrator/retirement/attempt_incident.py

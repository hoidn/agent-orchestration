+++ b/orchestrator/retirement/byte_overlay.py
@@ -0,0 +1,145 @@
+"""Scoped path-to-bytes views for retirement validators.
+
+``overlay_scope(root, files, require_committed_fallback=...)`` merges same-root
+views; mapped files shadow live bytes. Unmapped reads optionally require an
+identical regular HEAD blob, checked with Git and no-follow filesystem reads.
+Candidate-drift tolerance has an independent ContextVar and never changes Git
+observations. Neither context manager mutates repository files.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+import os
+from pathlib import Path, PurePosixPath
+import stat
+import subprocess
+from typing import Iterator, Literal, Mapping
+
+
+OverlayRead = tuple[Literal["overlay", "live", "unreadable"], bytes | None]
+
+
+@dataclass(frozen=True)
+class _Scope:
+    root: Path
+    files: Mapping[str, bytes]
+    require_committed_fallback: bool
+    committed_cache: dict[str, bool]
+
+
+_SCOPE: ContextVar[_Scope | None] = ContextVar("retirement_byte_overlay", default=None)
+_TOLERATED: ContextVar[frozenset[str]] = ContextVar("retirement_candidate_drift", default=frozenset())
+
+
+@contextmanager
+def overlay_scope(
+    repository_root: Path,
+    bound_file_bytes: Mapping[str, bytes] | None,
+    *,
+    require_committed_fallback: bool,
+) -> Iterator[None]:
+    if bound_file_bytes is None and not require_committed_fallback:
+        yield
+        return
+    root = repository_root.resolve()
+    outer = _SCOPE.get()
+    if outer is not None and outer.root == root:
+        files = {**outer.files, **(bound_file_bytes or {})}
+        require_committed_fallback |= outer.require_committed_fallback
+    else:
+        files = dict(bound_file_bytes or {})
+    token = _SCOPE.set(_Scope(root, files, require_committed_fallback, {}))
+    try:
+        yield
+    finally:
+        _SCOPE.reset(token)
+
+
+@contextmanager
+def candidate_drift_tolerance(codes: frozenset[str]) -> Iterator[None]:
+    token = _TOLERATED.set(_TOLERATED.get() | codes)
+    try:
+        yield
+    finally:
+        _TOLERATED.reset(token)
+
+
+def tolerated_candidate_codes() -> frozenset[str]:
+    return _TOLERATED.get()
+
+
+def _scope_for(repository_root: Path) -> _Scope | None:
+    scope = _SCOPE.get()
+    return scope if scope is not None and scope.root == repository_root.resolve() else None
+
+
+def read(repository_root: Path, logical_path: str) -> OverlayRead:
+    scope = _scope_for(repository_root)
+    if scope is None:
+        return "live", None
+    if logical_path in scope.files:
+        return "overlay", scope.files[logical_path]
+    if not scope.require_committed_fallback:
+        return "live", None
+    if logical_path not in scope.committed_cache:
+        scope.committed_cache[logical_path] = _committed_identical(scope.root, logical_path)
+    return ("live" if scope.committed_cache[logical_path] else "unreadable"), None
+
+
+def is_mapped(repository_root: Path, logical_path: str) -> bool:
+    scope = _scope_for(repository_root)
+    return scope is not None and logical_path in scope.files
+
+
+def mapped_names(repository_root: Path, directory: str, prefix: str) -> list[str]:
+    scope = _scope_for(repository_root)
+    if scope is None:
+        return []
+    parent = PurePosixPath(directory)
+    return sorted(
+        PurePosixPath(path).name for path in scope.files
+        if PurePosixPath(path).parent == parent and PurePosixPath(path).name.startswith(prefix)
+    )
+
+
+def _regular_bytes(root: Path, logical_path: str) -> bytes:
+    path = PurePosixPath(logical_path)
+    if path.is_absolute() or not path.parts or ".." in path.parts:
+        raise ValueError("path_not_relative")
+    current = root
+    for component in path.parts[:-1]:
+        current /= component
+        if not stat.S_ISDIR(current.lstat().st_mode):
+            raise ValueError("parent_not_directory")
+    final = root / logical_path
+    if not stat.S_ISREG(final.lstat().st_mode):
+        raise ValueError("path_not_regular")
+    descriptor = os.open(final, os.O_RDONLY | os.O_NOFOLLOW)
+    with os.fdopen(descriptor, "rb") as stream:
+        return stream.read()
+
+
+def _committed_identical(root: Path, logical_path: str) -> bool:
+    try:
+        data = _regular_bytes(root, logical_path)
+        entries = subprocess.run(
+            ["git", "ls-tree", "-z", "HEAD", "--", logical_path],
+            cwd=root, check=True, capture_output=True,
+        ).stdout.removesuffix(b"\0").split(b"\0")
+        if len(entries) != 1:
+            return False
+        coordinates, raw_path = entries[0].split(b"\t", 1)
+        mode, kind, blob = coordinates.split(b" ")
+        if mode not in {b"100644", b"100755"} or kind != b"blob" or raw_path.decode("utf-8") != logical_path:
+            return False
+        observed = subprocess.run(
+            ["git", "hash-object", "--no-filters", "--stdin"],
+            cwd=root, input=data, check=True, capture_output=True,
+        ).stdout.strip()
+        # shortcut: callers may race this check; return checked bytes if identity rechecks become insufficient.
+        return observed == blob
+    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
+        return False

@@ -0,0 +1,160 @@
+"""Replay-safe publication of an adopted incident before its v2 disposition.
+
+The public capture derives lifecycle facts from files and Git; output preflight,
+shared v1 gates, incident and materialization checks all precede publication.
+"""
+
+import os
+
+from . import attempt_migration as m, attempt_incident as incident
+from . import attempt_disposition_v2 as v2
+
+CAPTURE_OPTIONS = (
+    "incident_path", "disposition_path", "source_root", "archive_root",
+    "governing_plan_path", "migration_plan_path", "authority_subject_path",
+    "authority_specification_review_path", "authority_quality_review_path",
+    "intended_predecessor_head", "restoration_commit", "restoration_tree",
+    "expected_paths_manifest_path", "generation5_request_path",
+    "generation5_snapshot_path", "generation11_request_path",
+    "generation11_snapshot_path", "live_ledger_path", "baseline_path",
+    "baseline_specification_review_path", "baseline_quality_review_path",
+    "workspace_baseline_path", "attestation_request_path",
+    "attestation_snapshot_path", "attestation_record_path",
+)
+_IDENTITY_OPTIONS = frozenset({"intended_predecessor_head", "restoration_commit", "restoration_tree"})
+
+
+def _classify_output(root, path, name):
+    try:
+        descriptor, _, _ = m._open_parent(root, path)
+        os.close(descriptor)
+    except m.AttemptMigrationError as exc:
+        if exc.code == "path_parent_missing":
+            raise
+        raise m.AttemptMigrationError(name + "_output_path_invalid", "parent") from exc
+    state = m._repository_state(root)
+    rows = state["status_projection"]["rows"]
+    rename = any(row["source_path"] is not None and path in (row["path"], row["source_path"]) for row in rows)
+    if m._git_path_entries(root, [path], index=False) or m._git_path_entries(root, [path], index=True) or rename:
+        raise m.AttemptMigrationError(name + "_output_path_invalid", "tracked")
+    snapshot = m._read_regular(root, path, missing_ok=True)
+    expected = [{"path": path, "source_path": None, "status": "??"}] if snapshot else []
+    if [row for row in rows if path in (row["path"], row["source_path"])] != expected:
+        raise m.AttemptMigrationError(name + "_output_path_invalid", "status")
+    return snapshot
+
+
+def _outputs(root, options):
+    source, archive = options["source_root"], options["archive_root"]
+    if m._under(source, archive) or m._under(archive, source):
+        raise m.AttemptMigrationError("source_archive_roots_overlap")
+    for name in ("incident", "disposition"):
+        m._reject_output_overlap(options[name + "_path"], source, archive)
+    if options["incident_path"] == options["disposition_path"]:
+        raise m.AttemptMigrationError("output_paths_alias")
+    if m._scan_regular_files(root, archive):
+        raise m.AttemptMigrationError("archive_not_empty", archive)
+    existing = {name: _classify_output(root, options[name + "_path"], name)
+                for name in ("incident", "disposition")}
+    if existing["disposition"] is not None and existing["incident"] is None:
+        raise m.AttemptMigrationError("capture_replay_state_invalid", "disposition_without_incident")
+    return existing
+
+
+def _preclassify(existing, state, path):
+    if existing is None:
+        return
+    try:
+        value = m._json_bytes(existing["data"], path)
+        if value.get("pre_move_repository_state") != state:
+            raise m.AttemptMigrationError("capture_replay_state_invalid", "incident_mismatch")
+    except m.AttemptMigrationError as exc:
+        raise m.AttemptMigrationError("capture_replay_state_invalid", "incident_mismatch") from exc
+
+
+def _common(root, state, options):
+    keys = ("governing_plan_path", "migration_plan_path", "authority_subject_path",
+        "authority_specification_review_path", "authority_quality_review_path",
+        "expected_paths_manifest_path", "generation5_request_path", "generation5_snapshot_path",
+        "generation11_request_path", "generation11_snapshot_path", "live_ledger_path")
+    return m._capture_common(root, state, **{key: options[key] for key in keys},
+        source_prefix=options["source_root"], archive_prefix=options["archive_root"],
+        source_commit=options["restoration_commit"], source_tree=options["restoration_tree"],
+        protected_paths=options["protected_paths"], coordinates=v2.validate_coordinates_v2,
+        artifact_paths={role: options[role + "_path"] for role in v2.V2_ARTIFACT_ROLES})
+
+
+def _build_incident(root, state, options):
+    keys = ("governing_plan_path", "migration_plan_path", "workspace_baseline_path",
+            "expected_paths_manifest_path", "source_root", "intended_predecessor_head")
+    return incident._build_incident(root, pre_state=state,
+        **{key: options[key] for key in keys},
+        owner_attestation_path=options["attestation_record_path"],
+        pending_attestation_snapshot_path=options["attestation_snapshot_path"],
+        known_failure_baseline_path=options["baseline_path"])
+
+
+def _disposition(root, common, value, incident_bytes, options):
+    record = {
+        "schema_version": v2.SCHEMA_VERSION, "disposition": v2.V2_DISPOSITION,
+        **common, "attempt_lifecycle": {**v2.LIFECYCLE_CONSTANTS,
+            "incident_binding": {"path": options["incident_path"], "size": len(incident_bytes),
+                                 "sha256": m._bytes_digest(incident_bytes)}},
+        "claims_not_made": v2.V2_CLAIMS_NOT_MADE,
+    }
+    record["normalized_disposition_sha256"] = m._canonical_digest(record)
+    v2.validate_structure(record)
+    view = {row["original_path"]: m._resolve_attempt_row_snapshot(root, row)
+            for row in record["attempt_rows"]}
+    v2.validate_generation11_coordinates(root, record, view)
+    v2.cross_check_incident(record, value)
+    v2.validate_attestation_pair(root, record, view)
+    return record
+
+
+def _publish(root, existing, records, options):
+    encoded = {name: m._canonical_json(value) + b"\n" for name, value in records.items()}
+    for name in ("incident", "disposition"):
+        snapshot = existing[name]
+        if snapshot is not None and (snapshot["data"] != encoded[name] or snapshot["lstat_mode"] != 0o644):
+            raise m.AttemptMigrationError("capture_replay_state_invalid", name + "_mismatch")
+    for name in ("incident", "disposition"):
+        if existing[name] is None:
+            m._publish_exclusive(root, options[name + "_path"], encoded[name], 0o644)
+
+
+def _capture(root, options):
+    existing = _outputs(root, options)
+    state = m._state_without_paths(m._repository_state(root),
+        {options["incident_path"], options["disposition_path"]})
+    _preclassify(existing["incident"], state, options["incident_path"])
+    common = _common(root, state, options)
+    value = _build_incident(root, state, options)
+    data = m._canonical_json(value) + b"\n"
+    record = _disposition(root, common, value, data, options)
+    _publish(root, existing, {"incident": value, "disposition": record}, options)
+    return {"incident": value, "disposition": m.validate(root, options["disposition_path"])}
+
+
+def capture_invalidated_adopted(repository_root, *, incident_path, disposition_path,
+    source_root, archive_root, governing_plan_path, migration_plan_path,
+    authority_subject_path, authority_specification_review_path,
+    authority_quality_review_path, intended_predecessor_head, restoration_commit,
+    restoration_tree, expected_paths_manifest_path, protected_paths,
+    generation5_request_path, generation5_snapshot_path, generation11_request_path,
+    generation11_snapshot_path, live_ledger_path, baseline_path,
+    baseline_specification_review_path, baseline_quality_review_path,
+    workspace_baseline_path, attestation_request_path, attestation_snapshot_path,
+    attestation_record_path) -> dict:
+    """Derive and exclusively publish the incident and its exact v2 disposition."""
+    arguments = locals()
+    try:
+        root = m._repository_root(repository_root)
+        options = {key: arguments[key] if key in _IDENTITY_OPTIONS else
+                   m._relative_path(arguments[key], field=key) for key in CAPTURE_OPTIONS}
+        options["protected_paths"] = [m._relative_path(path) for path in protected_paths]
+        return _capture(root, options)
+    except m.AttemptMigrationError:
+        raise
+    except v2._BOUNDARY_ERRORS as exc:
+        raise m.AttemptMigrationError("capture_invalid", str(exc)) from exc

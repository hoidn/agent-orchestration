+def _rebind(fixture, record, path, data):
+    row = next(row for row in record["attempt_rows"] if row["original_path"] == path)
+    (fixture["root"] / row["archive_path"]).write_bytes(data)
+    updates = {"size": len(data), "sha256": m._bytes_digest(data)}
+    row.update(updates)
+    def visit(value):
+        if isinstance(value, dict):
+            if value.get("path") == path and "size" in value and "sha256" in value:
+                value.update(updates)
+            for item in value.values():
+                visit(item)
+        elif isinstance(value, list):
+            for item in value:
+                visit(item)
+    visit(record)
+    record["normalized_row_set_sha256"] = m._canonical_digest(record["attempt_rows"])
+    _write_record(fixture, record)

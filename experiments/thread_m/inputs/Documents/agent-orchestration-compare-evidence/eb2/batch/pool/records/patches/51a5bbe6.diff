+def test_lineage_rejects_repeated_changed_path_from_literal_tree(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode().strip()
+    blob = _git(repository, "hash-object", "-w", "--stdin", data=b"duplicate").decode().strip()
+    entry = b"100644 duplicate\0" + bytes.fromhex(blob)
+    tree = _git(repository, "hash-object", "-t", "tree", "--literally", "-w", "--stdin", data=entry * 2).decode().strip()
+    commit = _git(repository, "commit-tree", tree, "-p", baseline, data=b"literal tree\n").decode().strip()
+    with pytest.raises(source_bindings.SourceBindingError, match=f"^changed_path_duplicate:{commit}$"):
+        _derive(repository, baseline, commit)
+

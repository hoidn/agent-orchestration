+def _committed_predecessor_row(root: Path, raw_row: str, previous: str) -> dict[str, Any]:
+    commit, *parents = raw_row.split()
+    if len(parents) != 1:
+        raise SourceBindingError(f"predecessor_range_merge:{commit}")
+    if parents[0] != previous:
+        raise SourceBindingError("predecessor_first_parent_chain_invalid")
+    try:
+        tree = _git(root, "rev-parse", "--verify", f"{commit}^{{tree}}").decode("ascii").strip()
+        message = _raw_commit_message(root, commit)
+        raw_paths = _git(

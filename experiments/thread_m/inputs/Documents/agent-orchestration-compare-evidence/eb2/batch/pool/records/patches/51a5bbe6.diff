+        previous = row["commit"]
+    if previous != intended_predecessor_head:
+        raise SourceBindingError("predecessor_first_parent_chain_invalid")
+    try:
+        intended_tree = _git(root, "rev-parse", "--verify", f"{intended_predecessor_head}^{{tree}}")
+    except SourceBindingError as exc:
+        raise SourceBindingError(f"predecessor_object_missing:{intended_predecessor_head}") from exc
+    controlled = {path for row in rows if row["control_coordinates"] is not None for path in row["changed_paths"]}
+    uncovered = {path for row in rows if row["control_coordinates"] is None for path in row["changed_paths"]}
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("predecessor_uncovered_paths_missing")
+    changed = controlled | uncovered
+    projection = {
+        "baseline_head": baseline_head, "intended_predecessor_head": intended_predecessor_head,
+        "intended_predecessor_tree": intended_tree.decode("ascii").strip(),
+        "first_parent_commits": rows, "commit_count": len(rows),
+        "changed_paths": sorted(changed), "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": sorted(controlled), "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": sorted(uncovered), "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    projection["normalized_projection_sha256"] = _canonical_sha256(
+        projection, exclude={"normalized_projection_sha256"}
+    )
+    return projection

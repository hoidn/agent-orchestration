index 0000000..59a8a32
--- /dev/null
+++ b/orchestrator/retirement/attempt_disposition_v2.py
@@ -0,0 +1,237 @@
+"""Closed owner-adopted disposition validation over row-exact logical bytes.
+
+Validation uses Git and repository files, with the byte overlay and independent
+candidate-tolerance ContextVars scoped only around historical evidence reopening.
+The ordered checks preserve the diagnostic precedence of the recovery contract.
+"""
+
+from pathlib import Path
+from typing import Any, Mapping
+
+from . import attempt_migration as m, attempt_incident as incident, byte_overlay
+from . import broad_evidence as broad, materialization as material
+
+SCHEMA_VERSION = "attempt_migration_disposition.v2"
+V2_TOP_LEVEL_KEYS = m.TOP_LEVEL_KEYS | {"attempt_lifecycle"}
+V2_DISPOSITION = "archive_invalidated_owner_adopted_uncommitted_attempt_and_restore_tracked_files"
+V2_ARTIFACT_ROLES = (
+    "baseline", "baseline_specification_review", "baseline_quality_review",
+    "workspace_baseline", "attestation_request", "attestation_snapshot",
+    "attestation_record",
+)
+V2_CLAIMS_NOT_MADE = [
+    "The captured attempt was personally owner-adopted but remained uncommitted when its repository predecessor was invalidated.",
+    "Historical owner adoption remains bound only to the archived attempt and may not be transferred to or consumed by any later attestation, index, or completion claim.",
+    "Archival relocation preserves bytes but grants no mutation or completion authority.",
+    "A later attempt may begin only after the tracked live file equals its reviewed restoration binding.",
+]
+LIFECYCLE_CONSTANTS = {
+    "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+    "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+    "workspace_baseline_role": "workspace_baseline",
+    "owner_attestation_role": "attestation_record", "adoption_transfer": "forbidden",
+}
+_BOUNDARY_ERRORS = (OSError, ValueError, TypeError, KeyError, material.MaterializationError)
+
+
+def validate_structure(record: Any) -> dict:
+    value = dict(m._require_keys(record, V2_TOP_LEVEL_KEYS, "disposition_keys_mismatch"))
+    if value["disposition"] != V2_DISPOSITION:
+        raise m.AttemptMigrationError("disposition_value_invalid")
+    if value["claims_not_made"] != V2_CLAIMS_NOT_MADE:
+        raise m.AttemptMigrationError("disposition_claims_invalid")
+    if value["normalized_disposition_sha256"] != m._canonical_digest(value, exclude="normalized_disposition_sha256"):
+        raise m.AttemptMigrationError("normalized_disposition_digest_mismatch")
+    _validate_lifecycle(value)
+    return m._validate_disposition_body(value, artifact_roles=V2_ARTIFACT_ROLES,
+                                        coordinates=validate_coordinates_v2)
+
+
+def _validate_lifecycle(record: Mapping) -> None:
+    lifecycle = m._require_keys(record["attempt_lifecycle"],
+        set(LIFECYCLE_CONSTANTS) | {"incident_binding"}, "attempt_lifecycle_invalid")
+    for key, value in LIFECYCLE_CONSTANTS.items():
+        if lifecycle[key] != value:
+            raise m.AttemptMigrationError("attempt_lifecycle_invalid", key)
+    try:
+        m._validate_file_binding(lifecycle["incident_binding"], full=False)
+    except m.AttemptMigrationError as exc:
+        raise m.AttemptMigrationError("attempt_lifecycle_invalid", "incident_binding") from exc
+    attempt = record["attempt_binding"]
+    m._reject_output_overlap(lifecycle["incident_binding"]["path"],
+        attempt["source_root"], attempt["archive_root"],
+        [row["original_path"] for row in record["attempt_rows"]])
+
+
+def validate_coordinates_v2(*, rows, artifact_bindings, generation5, generation11,
+                            restoration) -> None:
+    bindings = {
+        "generation5_request": generation5["request_binding"],
+        "generation5_snapshot": generation5["snapshot_binding"],
+        "generation11_request": generation11["request_binding"],
+        "generation11_snapshot": generation11["snapshot_binding"],
+        "generation11_live": generation11["live_binding"],
+        **{role: artifact_bindings[role] for role in V2_ARTIFACT_ROLES},
+    }
+    m._validate_coordinate_rows(rows, bindings, generation11, generation5, restoration)
+
+
+def _view_bytes(root: Path, view: Mapping, path: str) -> bytes:
+    snapshot = view[path] if path in view else m._require_committed_live(root, path)
+    if snapshot is None:
+        raise m.AttemptMigrationError("logical_path_unreadable", path)
+    return snapshot["data"]
+
+
+def _require_coordinate(condition: bool, role: str) -> None:
+    if not condition:
+        raise m.AttemptMigrationError("semantic_coordinate_row_binding_mismatch", role)
+
+
+def _validate_prior(root: Path, request: Mapping, generation: Mapping, view: Mapping) -> None:
+    prior = request.get("prior_generation_binding")
+    _require_coordinate(isinstance(prior, Mapping), "generation11_request")
+    _require_coordinate(prior.get("generation") == 10 and
+        prior.get("output_path") == request["output_path"], "generation11_request")
+    request_path, snapshot_path = Path(prior["request_path"]), Path(prior["snapshot_path"])
+    _require_coordinate(request_path.parent == Path(generation["request_binding"]["path"]).parent and
+        snapshot_path.parent == Path(generation["snapshot_binding"]["path"]).parent,
+        "generation11_request")
+    for key in ("request", "snapshot"):
+        data = _view_bytes(root, view, prior[key + "_path"])
+        _require_coordinate(m._bytes_digest(data) == prior[key + "_sha256"], "generation11_request")
+    previous = m._json_bytes(_view_bytes(root, view, prior["request_path"]), prior["request_path"])
+    _require_coordinate(previous.get("generation") == 10, "generation11_request")
+
+
+def _generation11_request(root: Path, record: Mapping, view: Mapping) -> tuple[bytes, Path, Path]:
+    generation = record["ledger_lineage"]["generation_11"]
+    path = Path(generation["request_binding"]["path"])
+    data = _view_bytes(root, view, path.as_posix())
+    request = m._json_bytes(data, path.as_posix())
+    _require_coordinate(not broad.validate_record(request) and
+        request.get("schema_version") == "retirement_materialization_request.v1",
+        "generation11_request")
+    output = Path(generation["live_binding"]["path"])
+    _require_coordinate(request.get("record_kind") == "execution-ledger" and
+        request.get("generation") == 11 and request.get("output_path") == output.as_posix(),
+        "generation11_request")
+    evidence = material._evidence_root_from_request_path(path)
+    _require_coordinate(path == material._request_path(evidence, output, 11,
+        request["normalized_request_sha256"]), "generation11_request")
+    _validate_prior(root, request, generation, view)
+    return data, evidence, output
+
+
+def validate_generation11_coordinates(root: Path, record: Mapping, view: Mapping) -> None:
+    try:
+        request, evidence, output = _generation11_request(root, record, view)
+    except (m.AttemptMigrationError, *_BOUNDARY_ERRORS) as exc:
+        raise m.AttemptMigrationError("semantic_coordinate_row_binding_mismatch", "generation11_request") from exc
+    try:
+        generation = record["ledger_lineage"]["generation_11"]
+        path = Path(generation["snapshot_binding"]["path"])
+        data = _view_bytes(root, view, path.as_posix())
+        _require_coordinate(data != request and path == material._snapshot_path(
+            evidence, output, 11, m._bytes_digest(data)) and
+            data == _view_bytes(root, view, output.as_posix()), "generation11_snapshot")
+    except (m.AttemptMigrationError, *_BOUNDARY_ERRORS) as exc:
+        raise m.AttemptMigrationError("semantic_coordinate_row_binding_mismatch", "generation11_snapshot") from exc
+
+
+def cross_check_incident(record: Mapping, value: Mapping) -> None:
+    coordinates = {
+        key: record[key] for key in ("pre_move_repository_state", "governing_plan_binding",
+            "migration_plan_binding")
+    }
+    attempt = record["attempt_binding"]
+    coordinates["source_root"] = attempt["source_root"]
+    coordinates["expected_paths_manifest_binding"] = {
+        key: attempt["expected_paths_manifest_binding"][key]
+        for key in ("path", "size", "sha256", "row_count")}
+    coordinates["attempt_rows"] = [{"path": row["original_path"], **{
+        key: row[key] for key in ("file_type", "lstat_mode", "size", "sha256", "tracked_state")}}
+        for row in record["attempt_rows"]]
+    coordinates["attempt_path_set_sha256"] = record["attempt_path_set_sha256"]
+    roles = {"baseline": "known_failure_baseline", "workspace_baseline": "workspace_baseline",
+             "attestation_snapshot": "pending_attestation_snapshot", "attestation_record": "owner_attestation"}
+    for role, name in roles.items():
+        coordinates[name + "_binding"] = {
+            key: attempt["artifact_bindings"][role][key] for key in ("path", "size", "sha256")}
+    for key, expected in coordinates.items():
+        if expected != value[key]:
+            raise m.AttemptMigrationError("incident_coordinate_mismatch", key)
+
+
+def _pair_request(root: Path, record: Mapping, view: Mapping) -> tuple[str, str]:
+    artifacts = record["attempt_binding"]["artifact_bindings"]
+    path = artifacts["attestation_request"]["path"]
+    request = m._json_bytes(_view_bytes(root, view, path), path)
+    if request.get("record_kind") != "broad-failure-baseline-attestation":
+        raise m.AttemptMigrationError("attestation_materialization_pair_invalid", "record_kind")
+    if request.get("output_path") != artifacts["attestation_record"]["path"]:
+        raise m.AttemptMigrationError("attestation_materialization_pair_invalid", "output_path")
+    inputs = {row["role"]: {key: row[key] for key in ("path", "size", "sha256")}
+              for row in request["input_bindings"]}
+    for source, target in (("baseline", "baseline"), ("specification_review", "baseline_specification_review"),
+                           ("quality_review", "baseline_quality_review")):
+        if inputs.get(source) != {key: artifacts[target][key] for key in ("path", "size", "sha256")}:
+            raise m.AttemptMigrationError("attestation_materialization_pair_invalid", "inputs")
+    return path, artifacts["attestation_snapshot"]["path"]
+
+
+def validate_attestation_pair(root: Path, record: Mapping, view: Mapping) -> None:
+    try:
+        request_path, snapshot_path = _pair_request(root, record, view)
+        with byte_overlay.candidate_drift_tolerance(incident.TOLERATED_CANDIDATE_DRIFT):
+            issues = material.validate_generation(root, Path(request_path), Path(snapshot_path),
+                bound_file_bytes={path: snapshot["data"] for path, snapshot in view.items() if snapshot is not None},
+                require_committed_fallback=True)
+        if issues:
+            raise m.AttemptMigrationError("attestation_materialization_pair_invalid",
+                                          ",".join(sorted({issue.code for issue in issues})))
+    except m.AttemptMigrationError as exc:
+        if exc.code == "attestation_materialization_pair_invalid":
+            raise
+        raise m.AttemptMigrationError("attestation_materialization_pair_invalid", str(exc)) from exc
+    except _BOUNDARY_ERRORS as exc:
+        raise m.AttemptMigrationError("attestation_materialization_pair_invalid", str(exc)) from exc
+
+
+def _read_incident(root: Path, record: Mapping, require_committed: bool) -> dict:
+    binding = record["attempt_lifecycle"]["incident_binding"]
+    try:
+        reader = m._require_committed_live if require_committed else m._read_regular
+        snapshot = reader(root, binding["path"])
+        if snapshot is None or m._content_binding(snapshot) != binding:
+            raise m.AttemptMigrationError("attempt_lifecycle_invalid", "incident_binding")
+    except m.AttemptMigrationError as exc:
+        raise m.AttemptMigrationError("attempt_lifecycle_invalid", "incident_binding") from exc
+    try:
+        value = m._json_bytes(snapshot["data"], binding["path"])
+    except m.AttemptMigrationError as exc:
+        raise m.AttemptMigrationError("attempt_lifecycle_invalid", "incident_not_canonical") from exc
+    if snapshot["lstat_mode"] != 0o644 or snapshot["data"] != m._canonical_json(value) + b"\n":
+        raise m.AttemptMigrationError("attempt_lifecycle_invalid", "incident_not_canonical")
+    return value
+
+
+def validate_live(root: Path, record: Mapping, *, disposition_path: str,
+                  require_committed: bool, extra_ignored_paths=()) -> dict:
+    try:
+        m._validate_live_bindings(root, record)
+        value = _read_incident(root, record, require_committed)
+        view = {row["original_path"]: m._resolve_attempt_row_snapshot(root, row)
+                for row in record["attempt_rows"]}
+        validate_generation11_coordinates(root, record, view)
+        incident._validate_incident(root, value, view)
+        cross_check_incident(record, value)
+        validate_attestation_pair(root, record, view)
+        m._require_outside_status_projection_unchanged(root, record,
+            additional_ignored_paths=(record["attempt_lifecycle"]["incident_binding"]["path"],
+                                      disposition_path, *extra_ignored_paths))
+        return record
+    except m.AttemptMigrationError:
+        raise
+    except _BOUNDARY_ERRORS as exc:
+        raise m.AttemptMigrationError("disposition_validation_invalid", str(exc)) from exc
diff --git a/orchestrator/retirement/attempt_incident.py b/orchestrator/retirement/attempt_incident.py
new file mode 100644
index 0000000..45a9306

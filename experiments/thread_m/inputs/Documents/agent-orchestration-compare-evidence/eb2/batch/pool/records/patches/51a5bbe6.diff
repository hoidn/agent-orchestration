+    "generation5_snapshot_path", "generation11_request_path",
+    "generation11_snapshot_path", "live_ledger_path", "baseline_path",
+    "baseline_specification_review_path", "baseline_quality_review_path",
+    "workspace_baseline_path", "attestation_request_path",
+    "attestation_snapshot_path", "attestation_record_path",
+)
+
+
+def _write_json(repository: Path, path: str, record: object) -> Path:
+    _write(repository, path, _canonical(record) + b"\n")
+    return repository / path
+
+
+def _genesis(repository: Path):
+    producer._initialize_candidate_repository(repository)
+    plan = repository / "plan.md"
+    producer._write_ledger_plan(plan)
+    producer._git_output(repository, "add", "--", "plan.md")
+    producer._git_output(repository, "commit", "-q", "-m", "bind plan")
+    bootstrap = source_bindings.capture_workspace_baseline(repository)
+    bootstrap.update({
+        "schema_version": "bootstrap_workspace_baseline.v1",
+        "bootstrap_capture_bindings": {
+            "producer_contract_version": "task1_first_write_capture.v1",
+            **{name: f"sha256:{'0' * 64}" for name in (
+                "head_file_sha256", "status_file_sha256",
+                "index_entries_file_sha256", "archive_sha256", "tar_stderr_sha256",
+            )},
+            "index_file_sha256": bootstrap["index_sha256"],
+        },
+        "raw_archive_not_persisted": True,
+    })
+    bootstrap["normalized_baseline_sha256"] = broad.canonical_sha256(
+        bootstrap, exclude={"normalized_baseline_sha256"}
+    )
+    record = broad.build_initial_execution_ledger(
+        plan_path=Path("plan.md"), plan_bytes=plan.read_bytes()
+    )
+    receipt = material.materialize_transaction(
+        repository_root=repository, evidence_root=Path(SOURCE_ROOT),
+        record_kind="execution-ledger",
+        output_path=Path(SOURCE_ROOT) / "execution-ledger.json", generation=1,
+        input_paths={"approved_plan": Path("plan.md")}, parameters={"record": record},
+    )
+    source = repository / "source.py"

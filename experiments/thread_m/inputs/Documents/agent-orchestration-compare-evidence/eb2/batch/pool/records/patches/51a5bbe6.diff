+    assert "request_prior_generation_invalid" in {i.code for i in issues}
+
+
+@pytest.mark.parametrize("kind", ["request", "snapshot"])
+def test_overlay_ancestor_wrong_parent_keeps_content_address_issue(tmp_path: Path, kind: str) -> None:

+def refresh_attempt_authority(fixture: dict) -> None:
+    """Commit the manifest and its authority reviews for the current attempt paths."""
+    from orchestrator.retirement import attempt_migration as migration
+
+    repository = fixture["root"]
+    _write(repository, fixture["migration_plan_path"], b"reviewed recovery plan\n")
+    paths = migration._status_paths(
+        migration._repository_state(repository)["status_projection"]["rows"], SOURCE_ROOT
+    )
+    fixture["expected_paths"] = paths
+    _write(repository, fixture["expected_paths_manifest_path"],
+           ("\n".join(paths) + "\n").encode())
+    mechanism, test = "implementation/recovery.py", "implementation/test_recovery.py"
+    evidence = {role: f"verification/{role}.txt" for role in (
+        "candidate_manifest", "exact_diff", "focused_test_evidence", "broad_test_evidence"
+    )}
+    for path in (mechanism, test, *evidence.values()):
+        _write(repository, path, f"generic verification: {path}\n".encode())
+    manifest = _file_binding(repository, fixture["expected_paths_manifest_path"])
+    manifest.update({"row_count": len(paths),
+                     "normalized_path_set_sha256": _digest(_canonical(paths))})
+    subject = {
+        "schema_version": "attempt_migration_authority_subject.v1",
+        "governing_plan_binding": _file_binding(repository, fixture["governing_plan_path"]),
+        "migration_plan_binding": _file_binding(repository, fixture["migration_plan_path"]),
+        "expected_paths_manifest_binding": manifest,
+        "protected_path_bindings": [_file_binding(repository, "source.py", full=True)],
+        "mechanism_binding": _file_binding(repository, mechanism, full=True),
+        "test_binding": _file_binding(repository, test, full=True),
+        "evidence_bindings": {role: _file_binding(repository, path, full=True)
+                              for role, path in evidence.items()},
+        "claims_not_made": AUTHORITY_CLAIMS_NOT_MADE,
+    }
+    subject["normalized_subject_sha256"] = _digest(_canonical(subject))
+    subject_data = _canonical(subject) + b"\n"
+    _write(repository, fixture["authority_subject_path"], subject_data)
+    for kind, field in (("specification", "authority_specification_review_path"),
+                        ("code_quality", "authority_quality_review_path")):
+        _write(repository, fixture[field], _review(
+            kind, fixture["authority_subject_path"], subject_data, f"{kind}-reviewer"
+        ))
+    producer._git_output(repository, "add", "--", "authority", "implementation",
+                         "verification", fixture["migration_plan_path"])
+    message = source_bindings._derive_final_message_bytes(
+        b"Commit recovery authority\n", "1" * 64, "sha256:" + "2" * 64
+    )
+    subprocess.run(["git", "commit", "-q", "--cleanup=verbatim", "-F", "-"],
+                   cwd=repository, input=message, check=True)
+
+
+def _commit_authority(repository: Path, fixture):
+    refresh_attempt_authority(fixture)
+    _write(repository, "uncovered.txt", b"uncovered predecessor change\n")
+    producer._git_output(repository, "add", "--", "uncovered.txt")
+    producer._git_output(repository, "commit", "-q", "-m", "plain predecessor change")
+
+
+def build_adopted_attempt_repository(tmp_path: Path) -> dict:
+    repository = tmp_path / "repository"
+    repository.mkdir(parents=True)
+    candidate, generations, restoration, workspace = _ledger_generations(repository)
+    fixture = {
+        "root": repository, "source_root": SOURCE_ROOT, "archive_root": "evidence/archive",
+        "incident_path": INCIDENT_PATH, "disposition_path": DISPOSITION_PATH,
+        "governing_plan_path": "plan.md", "migration_plan_path": "migration-plan.md",
+        "authority_subject_path": "authority/subject.json",
+        "authority_specification_review_path": "authority/specification-review.json",
+        "authority_quality_review_path": "authority/quality-review.json",
+        "expected_paths_manifest_path": "authority/expected-paths.txt",
+        "protected_paths": ["source.py"], "restoration_commit": restoration,
+        "restoration_tree": producer._git_output(
+            repository, "rev-parse", f"{restoration}^{{tree}}"
+        ).decode().strip(),
+        "workspace_baseline_path": workspace,
+        "generation5_request_path": generations[4]["request_path"],
+        "generation5_snapshot_path": generations[4]["snapshot_path"],
+        "generation11_request_path": generations[-1]["request_path"],
+        "generation11_snapshot_path": generations[-1]["snapshot_path"],
+        "live_ledger_path": generations[-1]["live_path"],
+        "generations": generations, "candidate": candidate,
+        **_adopted_attestation(repository, candidate, generations[-1]),
+        "disposition_specification_review_path": "evidence/migration/specification-review.json",
+        "disposition_quality_review_path": "evidence/migration/quality-review.json",
+        "post_report_path": "evidence/migration/post-report.json",
+    }
+    _commit_authority(repository, fixture)
+    fixture["intended_predecessor_head"] = producer._git_output(
+        repository, "rev-parse", "HEAD"
+    ).decode().strip()
+    (repository / "evidence/migration").mkdir()
+    for row in generations:
+        assert material.validate_generation(
+            repository, Path(row["request_path"]), Path(row["snapshot_path"])
+        ) == []
+    return fixture
+
+
+def capture_arguments(fixture: dict) -> list[str]:
+    arguments = ["--repository-root", str(fixture["root"])]
+    for name in CAPTURE_OPTIONS:
+        arguments.extend(["--" + name.replace("_", "-"), str(fixture[name])])
+    for path in fixture["protected_paths"]:
+        arguments.extend(["--protected-path", path])
+    return arguments
+
+
+def commit_disposition_reviews(fixture: dict) -> None:
+    producer._git_output(fixture["root"], "add", "--", fixture["incident_path"])
+    _commit_disposition_reviews(fixture)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("build", "commit-disposition-reviews"))
+    parser.add_argument("directory", type=Path)
+    args = parser.parse_args()
+    if args.mode == "build":
+        print("\n".join(capture_arguments(build_adopted_attempt_repository(args.directory))))
+    else:
+        fixture = {
+            "root": args.directory / "repository", "incident_path": INCIDENT_PATH,
+            "disposition_path": DISPOSITION_PATH,
+            "disposition_specification_review_path": "evidence/migration/specification-review.json",
+            "disposition_quality_review_path": "evidence/migration/quality-review.json",
+        }
+        commit_disposition_reviews(fixture)
+        print(fixture["disposition_specification_review_path"])
+        print(fixture["disposition_quality_review_path"])
+
+
+if __name__ == "__main__":
+    main()

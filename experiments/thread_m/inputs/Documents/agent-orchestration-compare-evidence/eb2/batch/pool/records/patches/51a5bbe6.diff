+++ b/orchestrator/retirement/attempt_incident.py
@@ -0,0 +1,367 @@
+"""Closed owner-adopted uncommitted incident build and validation contracts.
+
+Build and validate bind repository files and Git-derived predecessor lineage.
+Private validation accepts row-exact snapshots for post-archive reopening; nested
+broad evidence uses scoped byte and historical candidate-drift ContextVars.
+"""
+
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+from . import attempt_migration as m
+from . import broad_evidence as broad
+from . import byte_overlay, source_bindings
+from .materialization import MaterializationError
+
+SCHEMA_VERSION = "attempt_migration_incident.v1"
+CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+BINDING_NAMES = (
+    "governing_plan", "migration_plan", "workspace_baseline", "owner_attestation",
+    "pending_attestation_snapshot", "known_failure_baseline", "expected_paths_manifest",
+)
+ATTEMPT_BINDINGS = frozenset(BINDING_NAMES[2:6])
+TOP_LEVEL_KEYS = {
+    "schema_version", *(name + "_binding" for name in BINDING_NAMES), "source_root",
+    "intended_predecessor", "predecessor_projection", "pre_move_repository_state",
+    "attempt_rows", "attempt_path_count", "attempt_path_set_sha256",
+    "normalized_attempt_row_set_sha256", "adoption_facts", "normalized_incident_sha256",
+    "claims_not_made",
+}
+ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+ADOPTION_CONSTANTS = {
+    "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+    "evidence_status": "owner_confirmed",
+}
+ADOPTION_FIELDS = ("owner_identity", "owner_role", "confirmed_at", "adopted_at")
+TOLERATED_CANDIDATE_DRIFT = frozenset({
+    "candidate_git_identity_mismatch", "candidate_path_set_live_mismatch",
+})
+_BOUNDARY_ERRORS = (
+    OSError, ValueError, TypeError, KeyError, source_bindings.SourceBindingError,
+    MaterializationError,
+)
+
+
+def _structure(condition: bool, field: str) -> None:
+    if not condition:
+        raise m.AttemptMigrationError("incident_structure_invalid", field)
+
+
+def _binding_error(name: str, detail: str = "") -> m.AttemptMigrationError:
+    return m.AttemptMigrationError(f"incident_{name}_binding_invalid", detail)
+
+
+def _validate_binding_shape(name: str, binding: Any) -> None:
+    try:
+        if name == "expected_paths_manifest":
+            m._require_keys(binding, {"path", "size", "sha256", "row_count"}, "keys")
+            _structure(type(binding["row_count"]) is int and binding["row_count"] >= 1, "row_count")
+            binding = {key: binding[key] for key in ("path", "size", "sha256")}
+        m._validate_file_binding(binding, full=False)
+    except (m.AttemptMigrationError, TypeError, KeyError) as exc:
+        raise _binding_error(name) from exc
+
+
+def _validate_row(row: Any, source_root: str) -> None:
+    try:
+        m._require_keys(row, ROW_KEYS, "keys")
+        m._validate_file_binding({key: row[key] for key in ROW_KEYS - {"tracked_state"}})
+        _structure(isinstance(row["tracked_state"], str) and row["tracked_state"] in {"modified", "untracked"}, "attempt_rows")
+        _structure(m._under(row["path"], source_root), "attempt_rows")
+    except (m.AttemptMigrationError, TypeError, KeyError) as exc:
+        raise m.AttemptMigrationError("incident_structure_invalid", "attempt_rows") from exc
+
+
+def _validate_static_coordinates(record: Mapping[str, Any]) -> None:
+    try:
+        m._relative_path(record["source_root"])
+    except m.AttemptMigrationError as exc:
+        raise m.AttemptMigrationError("incident_structure_invalid", "source_root") from exc
+    predecessor = record["intended_predecessor"]
+    _structure(isinstance(predecessor, Mapping) and set(predecessor) == {"head", "tree"}, "intended_predecessor")
+    _structure(all(m._is_commit_identity(predecessor[key]) for key in ("head", "tree")), "intended_predecessor")
+    rows = record["attempt_rows"]
+    _structure(isinstance(rows, list) and bool(rows), "attempt_rows")
+    for row in rows:
+        _validate_row(row, record["source_root"])
+    paths = [row["path"] for row in rows]
+    _structure(paths == sorted(set(paths)), "attempt_rows")
+    _structure(type(record["attempt_path_count"]) is int and record["attempt_path_count"] == len(rows), "attempt_path_count")
+    _structure(record["attempt_path_set_sha256"] == m._canonical_digest(paths), "attempt_path_set_sha256")
+    _structure(record["normalized_attempt_row_set_sha256"] == m._canonical_digest(rows), "normalized_attempt_row_set_sha256")
+
+
+def _validate_incident_static(record: Any) -> None:
+    _structure(isinstance(record, Mapping) and set(record) == TOP_LEVEL_KEYS, "keys")
+    _structure(record["schema_version"] == SCHEMA_VERSION, "schema_version")
+    _structure(record["claims_not_made"] == CLAIMS_NOT_MADE, "claims_not_made")
+    if record["normalized_incident_sha256"] != m._canonical_digest(record, exclude="normalized_incident_sha256"):
+        raise m.AttemptMigrationError("incident_normalized_digest_mismatch")
+    for name in BINDING_NAMES:
+        _validate_binding_shape(name, record[name + "_binding"])
+    paths = [record[name + "_binding"]["path"] for name in BINDING_NAMES]
+    _structure(len(paths) == len(set(paths)), "binding_alias")
+    _validate_static_coordinates(record)
+    facts = record["adoption_facts"]
+    _structure(isinstance(facts, Mapping) and set(facts) == set(ADOPTION_CONSTANTS) | set(ADOPTION_FIELDS), "adoption_facts")
+    _structure(all(facts[key] == value for key, value in ADOPTION_CONSTANTS.items()), "adoption_facts")
+    _structure(all(isinstance(facts[key], str) and bool(facts[key].strip()) for key in ADOPTION_FIELDS), "adoption_facts")
+    _structure(isinstance(record["predecessor_projection"], Mapping), "predecessor_projection")
+
+
+def _adoption_facts(owner: Mapping[str, Any]) -> dict:
+    objects = [owner.get(name) for name in ("owner", "owner_confirmations", "owner_adoption")]
+    if owner.get("evidence_status") != "owner_confirmed" or not all(isinstance(item, Mapping) for item in objects):
+        raise m.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    identity, confirmation, adoption = objects
+    values = [identity.get("identity"), identity.get("role"), confirmation.get("confirmed_at"), adoption.get("adopted_at")]
+    if not all(isinstance(value, str) and bool(value.strip()) for value in values) or adoption.get("identity") != identity.get("identity"):
+        raise m.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    return {**ADOPTION_CONSTANTS, **dict(zip(ADOPTION_FIELDS, values))}
+
+
+def _parse_bound(name: str, snapshot: Mapping[str, Any]) -> dict:
+    try:
+        return m._json_bytes(snapshot["data"], snapshot["path"])
+    except m.AttemptMigrationError as exc:
+        raise _binding_error(name, "json_invalid") from exc
+
+
+def _read_bindings(root: Path, record: Mapping, view: Mapping) -> dict:
+    snapshots = {}
+    row_paths = {row["path"] for row in record["attempt_rows"]}
+    for name in BINDING_NAMES:
+        binding = record[name + "_binding"]
+        path = binding["path"]
+        if name in ATTEMPT_BINDINGS and path not in row_paths:
+            raise _binding_error(name, "not_attempt_row")
+        try:
+            snapshot = view[path] if path in view else m._require_committed_live(root, path)
+        except m.AttemptMigrationError:
+            snapshot = None
+        if snapshot is None or any(snapshot[key] != binding[key] for key in ("size", "sha256")):
+            raise _binding_error(name)
+        snapshots[name] = snapshot
+    return snapshots
+
+
+def _validate_rows_and_manifest(record: Mapping, view: Mapping, snapshots: Mapping) -> None:
+    for row in record["attempt_rows"]:
+        snapshot = view.get(row["path"])
+        if not m._same_content(snapshot, row):
+            raise _binding_error("attempt_rows", row["path"])
+    binding = record["expected_paths_manifest_binding"]
+    paths = [row["path"] for row in record["attempt_rows"]]
+    try:
+        expected = m._manifest_paths(snapshots["expected_paths_manifest"]["data"], binding["path"])
+    except m.AttemptMigrationError as exc:
+        raise _binding_error("expected_paths_manifest", "rows") from exc
+    if expected != paths or binding["row_count"] != len(paths):
+        raise _binding_error("expected_paths_manifest", "rows")
+
+
+def _require_no_issues(name: str, issues: list, prefix: str = "") -> None:
+    if issues:
+        raise _binding_error(name, prefix + ",".join(sorted({issue.code for issue in issues})))
+
+
+def _validate_attestations(record: Mapping, snapshots: Mapping) -> dict:
+    owner = _parse_bound("owner_attestation", snapshots["owner_attestation"])
+    if _adoption_facts(owner) != record["adoption_facts"]:
+        raise m.AttemptMigrationError("incident_owner_lifecycle_invalid", "adoption_facts_mismatch")
+    _require_no_issues("owner_attestation", broad.validate_record(owner))
+    pending = _parse_bound("pending_attestation_snapshot", snapshots["pending_attestation_snapshot"])
+    _require_no_issues("pending_attestation_snapshot", broad.validate_record(pending))
+    if pending.get("evidence_status") != "pending_owner_confirmation":
+        raise _binding_error("pending_attestation_snapshot", "not_pending")
+    omitted = {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+    if {k: v for k, v in owner.items() if k not in omitted} != {k: v for k, v in pending.items() if k not in omitted}:
+        raise _binding_error("owner_attestation", "pending_lineage_mismatch")
+    baseline = record["known_failure_baseline_binding"]
+    if any(owner["baseline_binding"][key] != baseline[key] for key in ("path", "sha256")):
+        raise _binding_error("owner_attestation", "baseline_binding_mismatch")
+    return pending
+
+
+def _derive_projection(root: Path, baseline_head: Any, intended: Any) -> dict:
+    try:
+        return source_bindings.derive_committed_predecessor_lineage(
+            root, baseline_head=baseline_head, intended_predecessor_head=intended,
+            require_uncovered_paths=True,
+        )
+    except source_bindings.SourceBindingError as exc:
+        raise m.AttemptMigrationError("incident_predecessor_projection_invalid", str(exc)) from exc
+
+
+def _validate_git(root: Path, record: Mapping, workspace: Mapping) -> None:
+    state = record["pre_move_repository_state"]
+    tree = m._git(root, "rev-parse", state["head"] + "^{tree}").decode("ascii").strip()
+    if tree != state["tree"]:
+        raise m.AttemptMigrationError("capture_head_tree_mismatch")
+    if not m._git_is_ancestor(root, state["head"], "HEAD"):
+        raise m.AttemptMigrationError("capture_head_not_ancestor")
+    intended = record["intended_predecessor"]
+    if not m._git_is_ancestor(root, intended["head"], state["head"]):
+        raise m.AttemptMigrationError("incident_predecessor_projection_invalid", "predecessor_not_in_capture_lineage")
+    projection = _derive_projection(root, workspace["head"], intended["head"])
+    if projection != record["predecessor_projection"]:
+        raise m.AttemptMigrationError("incident_predecessor_projection_invalid", "projection_mismatch")
+    if intended != {"head": projection["intended_predecessor_head"], "tree": projection["intended_predecessor_tree"]}:
+        raise m.AttemptMigrationError("incident_predecessor_projection_invalid", "intended_predecessor_mismatch")
+
+
+def _validate_baseline(root: Path, snapshots: Mapping, files: Mapping) -> None:
+    name = "known_failure_baseline"
+    try:
+        baseline = _parse_bound(name, snapshots[name])
+        if baseline.get("schema_version") != "broad_known_failure_baseline.v1":
+            raise _binding_error(name, "schema_version_mismatch")
+        with byte_overlay.candidate_drift_tolerance(TOLERATED_CANDIDATE_DRIFT):
+            issues = broad.validate_bound_record(baseline, root, bound_file_bytes=files, require_committed_fallback=True)
+        _require_no_issues(name, issues)
+    except (broad.ContractError, MaterializationError, OSError) as exc:
+        raise _binding_error(name, str(exc)) from exc
+
+
+def _validate_reviews(root: Path, record: Mapping, pending: Mapping, files: Mapping) -> None:
+    name = "pending_attestation_snapshot"
+    bindings = [pending[key] for key in ("specification_review_binding", "quality_review_binding")]
+    baseline = record["known_failure_baseline_binding"]
+    try:
+        with byte_overlay.candidate_drift_tolerance(TOLERATED_CANDIDATE_DRIFT):
+            issues = broad.validate_review_pair(
+                specification_binding=bindings[0], quality_binding=bindings[1], repository_root=root,
+                expected_subject_kind="implementation_failure_baseline",
+                expected_subject_binding={key: baseline[key] for key in ("path", "sha256")},
+                bound_file_bytes=files, require_committed_fallback=True,
+            )
+            # The existing pair validator summarizes leaf failures; retain their diagnostics here.
+            if issues:
+                for binding in bindings:
+                    issues.extend(broad.validate_bound_record(binding, root, bound_file_bytes=files, require_committed_fallback=True))
+        _require_no_issues(name, issues, "review_pair:")
+    except (broad.ContractError, MaterializationError, OSError) as exc:
+        raise _binding_error(name, "review_pair:" + str(exc)) from exc
+
+
+def _validate_incident(root: Path, record: Mapping, view: Mapping) -> dict:
+    _validate_incident_static(record)
+    rows = m._validate_repository_state_structure(record["pre_move_repository_state"], record["source_root"])
+    paths = [row["path"] for row in record["attempt_rows"]]
+    if m._status_paths(rows, record["source_root"]) != paths:
+        raise m.AttemptMigrationError("source_status_coverage_mismatch")
+    snapshots = _read_bindings(root, record, view)
+    _validate_rows_and_manifest(record, view, snapshots)
+    pending = _validate_attestations(record, snapshots)
+    workspace = _parse_bound("workspace_baseline", snapshots["workspace_baseline"])
+    _require_no_issues("workspace_baseline", source_bindings.validate_workspace_record_shape(workspace))
+    _validate_git(root, record, workspace)
+    files = {path: snapshot["data"] for path, snapshot in view.items() if snapshot is not None}
+    _validate_baseline(root, snapshots, files)
+    _validate_reviews(root, record, pending, files)
+    return record
+
+
+def validate_attempt_migration_incident(repository_root: Path | str, record: Any) -> dict:
+    """Return the unchanged incident after pure preflight and live reopening."""
+    try:
+        _validate_incident_static(record)
+        root = m._repository_root(repository_root)
+        view = _live_view(root, record)
+        current = m._repository_state(root)["status_projection"]["rows"]
+        if m._status_paths(current, record["source_root"]) != list(view):
+            raise _binding_error("attempt_rows", "source_set")
+        return _validate_incident(root, record, view)
+    except m.AttemptMigrationError:
+        raise
+    except _BOUNDARY_ERRORS as exc:
+        raise m.AttemptMigrationError("incident_structure_invalid", str(exc)) from exc
+
+
+def _live_view(root: Path, record: Mapping) -> dict:
+    view = {}
+    for row in record["attempt_rows"]:
+        try:
+            view[row["path"]] = m._read_regular(root, row["path"], missing_ok=True)
+        except OSError as exc:
+            raise _binding_error("attempt_rows", row["path"]) from exc
+    return view
+
+
+def _capture_rows(root: Path, paths: list[str]) -> list[dict]:
+    rows = []
+    for path in paths:
+        snapshot = m._read_regular(root, path)
+        rows.append({**m._public_binding(snapshot), "tracked_state": "modified" if m._is_tracked(root, path) else "untracked"})
+    return rows
+
+
+def _build_incident(root: Path, *, pre_state: Mapping, governing_plan_path,
+                    migration_plan_path, workspace_baseline_path, owner_attestation_path,
+                    pending_attestation_snapshot_path, known_failure_baseline_path,
+                    expected_paths_manifest_path, source_root, intended_predecessor_head) -> dict:
+    source_root = m._relative_path(source_root)
+    values = (governing_plan_path, migration_plan_path, workspace_baseline_path,
+              owner_attestation_path, pending_attestation_snapshot_path,
+              known_failure_baseline_path, expected_paths_manifest_path)
+    paths = dict(zip(BINDING_NAMES, (m._relative_path(value) for value in values)))

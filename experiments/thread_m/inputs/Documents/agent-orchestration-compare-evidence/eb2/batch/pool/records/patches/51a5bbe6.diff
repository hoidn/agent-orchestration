+def test_lineage_rejects_fully_controlled_range_when_uncovered_required(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode().strip()
+    message = source_bindings._derive_final_message_bytes(b"controlled\n", "a" * 64, "sha256:" + "b" * 64)
+    commit = _commit(repository, {"covered.txt": b"covered"}, message)
+    assert _derive(repository, baseline, commit)["uncovered_paths"] == []
+    with pytest.raises(source_bindings.SourceBindingError, match="^predecessor_uncovered_paths_missing$"):
+        _derive(repository, baseline, commit, require_uncovered_paths=True)

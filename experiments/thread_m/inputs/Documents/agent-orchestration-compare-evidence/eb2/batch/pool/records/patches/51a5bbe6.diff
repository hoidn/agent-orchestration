@@ -0,0 +1,175 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import source_bindings
+
+
+def _git(root: Path, *args: str, data: bytes | None = None) -> bytes:
+    return subprocess.check_output(["git", *args], cwd=root, input=data)
+
+
+@pytest.fixture
+def repository(tmp_path: Path) -> Path:
+    root = tmp_path / "repository"
+    root.mkdir()
+    _git(root, "init", "-q")
+    _git(root, "config", "user.email", "tests@example.invalid")
+    _git(root, "config", "user.name", "Tests")
+    _commit(root, {"tracked.txt": b"base\n"}, b"base\n")
+    return root
+
+
+def _commit(root: Path, files: dict[str, bytes], message: bytes) -> str:
+    for path, data in files.items():
+        (root / path).write_bytes(data)
+    _git(root, "add", "--", *files)
+    _git(root, "commit", "-q", "--cleanup=verbatim", "-F", "-", data=message)
+    return _git(root, "rev-parse", "HEAD").decode().strip()
+
+
+def _digest(data: bytes) -> str:
+    return "sha256:" + hashlib.sha256(data).hexdigest()
+
+
+def _path_digest(paths: list[str]) -> str:
+    return _digest("".join(path + "\n" for path in sorted(paths)).encode())
+
+
+def _derive(root: Path, baseline: str, intended: str, **options: bool) -> dict:
+    return source_bindings.derive_committed_predecessor_lineage(
+        root, baseline_head=baseline, intended_predecessor_head=intended, **options
+    )
+
+
+def test_lineage_derives_exact_oldest_first_projection(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode().strip()
+    transaction_id, control_sha256 = "a" * 64, "sha256:" + "b" * 64
+    controlled_message = source_bindings._derive_final_message_bytes(
+        b"controlled\n", transaction_id, control_sha256
+    )
+    controlled = _commit(
+        repository, {"covered.txt": b"covered", "shared.txt": b"first"}, controlled_message
+    )
+    plain_message = b"plain change\n"
+    plain = _commit(repository, {"plain.txt": b"plain", "shared.txt": b"second"}, plain_message)
+
+    result = _derive(repository, baseline, plain, require_uncovered_paths=True)
+
+    rows = []
+    previous = baseline
+    for commit, message, paths, coordinates in [
+        (controlled, controlled_message, ["covered.txt", "shared.txt"],
+         {"transaction_id": transaction_id, "normalized_control_sha256": control_sha256}),
+        (plain, plain_message, ["plain.txt", "shared.txt"], None),
+    ]:
+        rows.append({
+            "commit": commit, "parent": previous,
+            "tree": _git(repository, "rev-parse", f"{commit}^{{tree}}").decode().strip(),
+            "raw_message_sha256": _digest(message), "changed_paths": paths,
+            "changed_path_set_sha256": _path_digest(paths), "control_coordinates": coordinates,
+        })
+        previous = commit
+    expected = {
+        "baseline_head": baseline, "intended_predecessor_head": plain,
+        "intended_predecessor_tree": rows[-1]["tree"], "first_parent_commits": rows,
+        "commit_count": 2, "changed_paths": ["covered.txt", "plain.txt", "shared.txt"],
+        "changed_path_count": 3,
+        "changed_path_set_sha256": _path_digest(["covered.txt", "plain.txt", "shared.txt"]),
+        "controlled_paths": ["covered.txt", "shared.txt"],
+        "controlled_path_set_sha256": _path_digest(["covered.txt", "shared.txt"]),
+        "uncovered_paths": ["plain.txt", "shared.txt"],
+        "uncovered_path_set_sha256": _path_digest(["plain.txt", "shared.txt"]),
+    }
+    expected["normalized_projection_sha256"] = _digest(
+        json.dumps(expected, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+    )
+    assert result == expected
+
+
+def test_empty_range_is_allowed_unless_uncovered_paths_required(repository: Path) -> None:
+    head = _git(repository, "rev-parse", "HEAD").decode().strip()
+    result = _derive(repository, head, head)
+    assert result["first_parent_commits"] == []
+    assert result["commit_count"] == result["changed_path_count"] == 0
+    assert result["changed_paths"] == result["controlled_paths"] == result["uncovered_paths"] == []
+    with pytest.raises(source_bindings.SourceBindingError, match="^predecessor_uncovered_paths_missing$"):
+        _derive(repository, head, head, require_uncovered_paths=True)
+
+
+@pytest.mark.parametrize("field", ["baseline_head", "intended_predecessor_head"])
+@pytest.mark.parametrize("value", [None, "a" * 39, "A" * 40, "a" * 40 + "\n"])
+def test_lineage_rejects_invalid_heads(repository: Path, field: str, value: object) -> None:
+    head = _git(repository, "rev-parse", "HEAD").decode().strip()
+    arguments = {"baseline_head": head, "intended_predecessor_head": head, field: value}
+    with pytest.raises(source_bindings.SourceBindingError, match=f"^predecessor_head_invalid:{field}$"):
+        source_bindings.derive_committed_predecessor_lineage(repository, **arguments)
+
+
+@pytest.mark.parametrize("field", ["baseline_head", "intended_predecessor_head"])
+def test_lineage_rejects_missing_commit(repository: Path, field: str) -> None:
+    head = _git(repository, "rev-parse", "HEAD").decode().strip()
+    missing = "f" * 40
+    arguments = {"baseline_head": head, "intended_predecessor_head": head, field: missing}
+    with pytest.raises(source_bindings.SourceBindingError, match=f"^predecessor_object_missing:{missing}$"):
+        source_bindings.derive_committed_predecessor_lineage(repository, **arguments)
+
+
+def test_head_shapes_are_checked_before_object_resolution(repository: Path) -> None:
+    with pytest.raises(source_bindings.SourceBindingError, match="^predecessor_head_invalid:intended_predecessor_head$"):
+        _derive(repository, "f" * 40, "invalid")
+
+
+def test_lineage_rejects_nonancestor(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode().strip()
+    tree = _git(repository, "rev-parse", "HEAD^{tree}").decode().strip()
+    unrelated = _git(repository, "commit-tree", tree, data=b"unrelated\n").decode().strip()
+    with pytest.raises(source_bindings.SourceBindingError, match="^predecessor_not_descendant$"):
+        _derive(repository, baseline, unrelated)
+
+
+def test_lineage_rejects_merge_in_range(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode().strip()
+    first = _commit(repository, {"first.txt": b"first"}, b"first\n")
+    tree = _git(repository, "rev-parse", "HEAD^{tree}").decode().strip()
+    second = _git(repository, "commit-tree", tree, "-p", baseline, data=b"second\n").decode().strip()
+    merge = _git(repository, "commit-tree", tree, "-p", first, "-p", second, data=b"merge\n").decode().strip()
+    with pytest.raises(source_bindings.SourceBindingError, match=f"^predecessor_range_merge:{merge}$"):
+        _derive(repository, baseline, merge)
+
+
+@pytest.mark.parametrize("message", [
+    b"truncated\n\nRetirement-Control-Schema: precommit_control.v1\n",
+    source_bindings._derive_final_message_bytes(b"subject\n", "a" * 64, "sha256:" + "b" * 64) + b"after\n",
+    source_bindings._derive_final_message_bytes(b"subject\n", "a" * 64, "sha256:" + "b" * 64).replace(b"subject", b"Retirement-Control-extra"),
+    source_bindings._derive_final_message_bytes(b"subject\n", "a" * 64, "sha256:" + "b" * 64).replace(b"subject\n", b"subject\r\n"),
+])
+def test_lineage_rejects_malformed_control_trailer(repository: Path, message: bytes) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode().strip()
+    commit = _commit(repository, {"changed.txt": b"changed"}, message)
+    with pytest.raises(source_bindings.SourceBindingError, match=f"^commit_control_trailer_invalid:{commit}$"):
+        _derive(repository, baseline, commit)
+

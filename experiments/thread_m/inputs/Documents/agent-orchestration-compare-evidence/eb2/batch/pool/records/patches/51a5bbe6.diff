diff --git a/tests/test_retirement_byte_overlay.py b/tests/test_retirement_byte_overlay.py
new file mode 100644
index 0000000..1ea65e7
--- /dev/null
+++ b/tests/test_retirement_byte_overlay.py
@@ -0,0 +1,263 @@
+"""Behavioral checks for scoped retirement evidence byte views."""
+
+from importlib import import_module
+from pathlib import Path
+import subprocess
+
+import pytest
+
+
+def _overlay():
+    return import_module("orchestrator.retirement.byte_overlay")
+
+
+def _git(root: Path, *args: str) -> bytes:
+    return subprocess.run(
+        ["git", *args], cwd=root, check=True, capture_output=True
+    ).stdout
+
+
+def _committed_file(root: Path) -> None:
+    _git(root, "init", "-q")
+    _git(root, "config", "user.email", "fixture@example.invalid")
+    _git(root, "config", "user.name", "Fixture")
+    (root / "bound.txt").write_bytes(b"committed\n")
+    _git(root, "add", "--", "bound.txt")
+    _git(root, "commit", "-qm", "bind fixture")
+
+
+def test_overlay_scope_merges_and_restores_after_failure(tmp_path: Path) -> None:
+    overlay = _overlay()
+    assert overlay.read(tmp_path, "a") == ("live", None)
+    with overlay.overlay_scope(tmp_path, {"a": b"outer"}, require_committed_fallback=False):
+        with pytest.raises(RuntimeError):
+            with overlay.overlay_scope(tmp_path, {"a": b"inner", "b": b"b"}, require_committed_fallback=False):
+                assert overlay.read(tmp_path, "a") == ("overlay", b"inner")
+                assert overlay.is_mapped(tmp_path, "b")
+                raise RuntimeError("reset")
+        assert overlay.read(tmp_path, "a") == ("overlay", b"outer")
+        assert not overlay.is_mapped(tmp_path, "b")
+    assert overlay.read(tmp_path, "a") == ("live", None)
+
+
+def test_overlay_replaces_different_root_and_lists_exact_children(tmp_path: Path) -> None:
+    overlay = _overlay()
+    other = tmp_path / "other"
+    other.mkdir()
+    files = {"slots/00000001-a": b"a", "slots/00000002-b": b"b", "slots/deep/00000001-c": b"c"}
+    with overlay.overlay_scope(tmp_path, files, require_committed_fallback=False):
+        assert overlay.mapped_names(tmp_path, "slots", "00000001-") == ["00000001-a"]
+        with overlay.overlay_scope(other, {"c": b"c"}, require_committed_fallback=False):
+            assert overlay.read(tmp_path, "slots/00000001-a") == ("live", None)
+            assert overlay.read(other, "c") == ("overlay", b"c")
+        assert overlay.is_mapped(tmp_path, "slots/00000001-a")
+    assert overlay.mapped_names(tmp_path, "slots", "") == []
+
+
+@pytest.mark.parametrize("state", ["identical", "modified", "untracked", "missing", "symlink", "symlink_parent"])
+def test_committed_fallback_requires_identical_regular_file(tmp_path: Path, state: str) -> None:
+    overlay = _overlay()
+    _committed_file(tmp_path)
+    path = "bound.txt"
+    if state == "modified":
+        (tmp_path / path).write_bytes(b"changed\n")
+    elif state == "untracked":
+        path = "extra.txt"
+        (tmp_path / path).write_bytes(b"committed\n")
+    elif state == "missing":
+        (tmp_path / path).unlink()
+    elif state == "symlink":
+        (tmp_path / "target.txt").write_bytes(b"committed\n")
+        (tmp_path / path).unlink()
+        (tmp_path / path).symlink_to("target.txt")
+    elif state == "symlink_parent":
+        (tmp_path / "link").symlink_to(tmp_path, target_is_directory=True)
+        path = "link/bound.txt"
+    with overlay.overlay_scope(tmp_path, {}, require_committed_fallback=True):
+        expected = "live" if state == "identical" else "unreadable"
+        assert overlay.read(tmp_path, path) == (expected, None)
+        with overlay.overlay_scope(tmp_path, {path: b"mapped"}, require_committed_fallback=False):
+            assert overlay.read(tmp_path, path) == ("overlay", b"mapped")
+            assert overlay.read(tmp_path, "absent.txt") == ("unreadable", None)
+
+
+@pytest.mark.parametrize("outer_tolerance", [True, False])
+def test_candidate_tolerance_is_independent_of_scope_order_and_root(tmp_path: Path, outer_tolerance: bool) -> None:
+    overlay = _overlay()
+    codes = frozenset({"candidate_git_identity_mismatch", "candidate_path_set_live_mismatch"})
+    tolerance = overlay.candidate_drift_tolerance(codes)
+    scope = overlay.overlay_scope(tmp_path, {}, require_committed_fallback=True)
+    first, second = (tolerance, scope) if outer_tolerance else (scope, tolerance)
+    with first:
+        with second:
+            assert overlay.tolerated_candidate_codes() == codes
+            with overlay.overlay_scope(tmp_path / "other", {}, require_committed_fallback=True):
+                assert overlay.tolerated_candidate_codes() == codes
+            with overlay.candidate_drift_tolerance(frozenset({"additional"})):
+                assert overlay.tolerated_candidate_codes() == codes | {"additional"}
+            assert overlay.tolerated_candidate_codes() == codes
+    assert overlay.tolerated_candidate_codes() == frozenset()
+
+
+def _lineage(root: Path):
+    from tests.test_retirement_broad_evidence import _materialize_first_ledger, _materialize_next_ledger
+    _, record, first = _materialize_first_ledger(root)
+    record, second = _materialize_next_ledger(root, record, first)
+    record, third = _materialize_next_ledger(root, record, second)
+    return record, [first, second, third]
+
+
+def _all_files(root: Path) -> dict[str, bytes]:
+    return {p.relative_to(root).as_posix(): p.read_bytes() for p in root.rglob("*") if p.is_file() and ".git" not in p.relative_to(root).parts}
+
+
+def test_public_validators_reopen_lineage_from_overlay(tmp_path: Path) -> None:
+    from orchestrator.retirement import broad_evidence as broad, materialization as material
+    record, generations = _lineage(tmp_path)
+    last = generations[-1]
+    assert material.validate_generation(tmp_path, last.request_path, last.snapshot_path) == []
+    files = _all_files(tmp_path)
+    for path in files:
+        (tmp_path / path).chmod(0o644)
+        (tmp_path / path).write_bytes(b"invalid live bytes")
+    assert material.validate_generation(tmp_path, last.request_path, last.snapshot_path, bound_file_bytes=files) == []
+    assert broad.validate_bound_record(record, tmp_path, bound_file_bytes=files) == []
+    with _overlay().overlay_scope(tmp_path, files, require_committed_fallback=False):
+        assert material.validate_generation(tmp_path, last.request_path, last.snapshot_path) == []
+
+
+@pytest.mark.parametrize("swapped", [False, True])
+def test_overlay_ancestor_changes_keep_lineage_diagnostic(tmp_path: Path, swapped: bool) -> None:
+    from orchestrator.retirement.materialization import validate_generation
+    _, generations = _lineage(tmp_path)
+    first, _, last = generations
+    files = _all_files(tmp_path)
+    if swapped:
+        req, snap = first.request_path.as_posix(), first.snapshot_path.as_posix()
+        files[req], files[snap] = files[snap], files[req]
+    else:
+        files.pop(first.request_path.as_posix())
+        (tmp_path / first.request_path).unlink()
+    issues = validate_generation(tmp_path, last.request_path, last.snapshot_path, bound_file_bytes=files)
+    assert any(i.code == "prior_generation_invalid" and i.message == "prior_generation_changed" for i in issues)
+
+
+@pytest.mark.parametrize("kind", ["request", "snapshot"])
+def test_overlay_duplicate_generation_slot_is_counted_with_live_slot(tmp_path: Path, kind: str) -> None:
+    from orchestrator.retirement.materialization import validate_generation
+    _, generations = _lineage(tmp_path)
+    last = generations[-1]
+    path = last.request_path if kind == "request" else last.snapshot_path
+    duplicate = path.with_name(f"{last.generation:08d}-{'f' * 64}.json")
+    issues = validate_generation(tmp_path, last.request_path, last.snapshot_path, bound_file_bytes={duplicate.as_posix(): b"duplicate"})
+    assert f"generation_{kind}_slot_extra" in {i.code for i in issues}
+
+
+def _completed_generation(root: Path):
+    from tests.test_retirement_broad_evidence import (
+        _advance_bound_ledger, _ledger_binding,
+        _producer_bootstrap_subject_and_reviews,
+        _producer_task1_candidate_ledger_and_bootstrap,
+    )
+    from orchestrator.retirement.broad_evidence import file_sha256
+    candidate, binding, bootstrap = _producer_task1_candidate_ledger_and_bootstrap(root)
+    for _ in range(2):
+        _, receipt = _advance_bound_ledger(root, binding)
+        binding = _ledger_binding(receipt)
+    future = ["evidence/implementation-commits/task-01-bootstrap/specification-review.json", "evidence/implementation-commits/task-01-bootstrap/quality-review.json"]
+    _, receipt = _advance_bound_ledger(root, binding, future_paths=future)
+    binding = _ledger_binding(receipt)
+    subject, specification, quality = _producer_bootstrap_subject_and_reviews(root, candidate=candidate, ledger=binding, bootstrap=bootstrap)
+    paths = [subject, Path(specification["logical_path"]), Path(quality["logical_path"])]
+    evidence = [{"path": p.as_posix(), "sha256": file_sha256(root / p)} for p in sorted(paths)]
+    record, receipt = _advance_bound_ledger(root, binding, evidence_bindings=evidence)
+    return record, receipt, subject, specification, quality, candidate
+
+
+def test_completed_generation_reopens_closing_subject_and_reviews_only_in_overlay(tmp_path: Path) -> None:
+    from orchestrator.retirement import broad_evidence as broad, materialization as material
+    record, receipt, subject, specification, quality, _ = _completed_generation(tmp_path)
+    files = _all_files(tmp_path)
+    for path in (subject.as_posix(), specification["logical_path"], quality["logical_path"], specification["immutable_path"], quality["immutable_path"]):
+        (tmp_path / path).chmod(0o644)
+        (tmp_path / path).write_bytes(b"invalid live bytes")
+    assert material.validate_generation(tmp_path, receipt.request_path, receipt.snapshot_path, bound_file_bytes=files) == []
+    assert broad.validate_bound_record(record, tmp_path, bound_file_bytes=files) == []
+    files[quality["immutable_path"]] = b"changed replayed review"
+    issues = material.validate_generation(tmp_path, receipt.request_path, receipt.snapshot_path, bound_file_bytes=files)
+    assert "ledger_completion_review_pair_invalid" in {i.code for i in issues}
+
+
+@pytest.mark.parametrize("state", ["committed", "uncommitted", "modified"])
+def test_immutable_review_committed_fallback(tmp_path: Path, state: str) -> None:
+    from orchestrator.retirement.broad_evidence import validate_bound_record
+    _, _, _, specification, _, _ = _completed_generation(tmp_path)
+    if state != "uncommitted":
+        _git(tmp_path, "add", "--", "evidence")
+        _git(tmp_path, "commit", "-qm", "bind evidence")
+    if state == "modified":
+        (tmp_path / specification["immutable_path"]).chmod(0o644)
+        (tmp_path / specification["immutable_path"]).write_bytes(b"modified")
+    issues = validate_bound_record(specification, tmp_path, bound_file_bytes={}, require_committed_fallback=True)
+    if state == "committed":
+        assert issues == []
+    else:
+        assert "review_binding_immutable_unreadable" in {i.code for i in issues}
+
+
+@pytest.mark.parametrize("outer_tolerance", [True, False])
+def test_candidate_reads_stay_live_and_tolerance_survives_nesting(tmp_path: Path, outer_tolerance: bool) -> None:
+    from orchestrator.retirement.broad_evidence import _candidate_binding_live_issues
+    from tests.test_retirement_broad_evidence import _producer_task1_candidate_ledger_and_bootstrap
+    candidate, _, _ = _producer_task1_candidate_ledger_and_bootstrap(tmp_path)
+    (tmp_path / "extra.py").write_bytes(b"new")
+    overlay = _overlay()
+    codes = frozenset({"candidate_git_identity_mismatch", "candidate_path_set_live_mismatch"})
+    scope = overlay.overlay_scope(tmp_path, {"source.py": b"incorrect shadow", ".git/index": b"incorrect index"}, require_committed_fallback=True)
+    tolerance = overlay.candidate_drift_tolerance(codes)
+    first, second = (tolerance, scope) if outer_tolerance else (scope, tolerance)
+    with first:
+        with second:
+            issues = _candidate_binding_live_issues({"candidate_binding": candidate}, tmp_path)
+            assert issues == []
+            with overlay.overlay_scope(tmp_path / "other", {}, require_committed_fallback=True):
+                assert _candidate_binding_live_issues({"candidate_binding": candidate}, tmp_path) == []
+
+
+def test_overlay_noncontiguous_request_keeps_request_issue(tmp_path: Path) -> None:
+    import json
+    from orchestrator.retirement import broad_evidence as broad, materialization as material
+    _, generations = _lineage(tmp_path)

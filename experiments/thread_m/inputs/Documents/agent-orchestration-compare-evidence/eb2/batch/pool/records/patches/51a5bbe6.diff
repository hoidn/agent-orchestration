+def _capture_protected_bindings(
+    root: Path, protected_paths: Sequence[Path | str], expected_paths: Sequence[str],
+    archive_prefix: str, source_prefix: str, state: Mapping[str, Any],
+) -> list[dict[str, Any]]:
+    protected: list[dict[str, Any]] = []

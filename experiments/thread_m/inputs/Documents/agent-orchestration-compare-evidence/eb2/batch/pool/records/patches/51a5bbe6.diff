+        for name in ("attestation_snapshot_path", "attestation_record_path"):
+            path = root / adopted[name]
+            value = json.loads(path.read_bytes())
+            value["prepared_at"] = "2026-01-01T00:00:01.500000+00:00"
+            path.write_bytes(m._canonical_json(value) + b"\n")
+    else:
+        from tests.retirement_adopted_attempt_helpers import refresh_attempt_authority
+
+        path = adopted["source_root"] + "/other-owner-record.json"
+        (root / path).write_bytes((root / adopted["attestation_record_path"]).read_bytes())
+        adopted["attestation_record_path"] = path
+        refresh_attempt_authority(adopted)
+    with pytest.raises(m.AttemptMigrationError, match="^attestation_materialization_pair_invalid:.*" + detail):
+        capture(adopted)
+    assert not (root / adopted["incident_path"]).exists()
+    assert not (root / adopted["disposition_path"]).exists()

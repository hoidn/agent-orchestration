+def _committed_predecessor_range(root: Path, baseline: str, intended: str) -> list[str]:
+    for field, head in (("baseline_head", baseline), ("intended_predecessor_head", intended)):
+        if not isinstance(head, str) or _HEX40_RE.fullmatch(head) is None:
+            raise SourceBindingError(f"predecessor_head_invalid:{field}")
+    for head in (baseline, intended):
+        try:
+            resolved = _git(root, "rev-parse", "--verify", "--quiet", f"{head}^{{commit}}")
+        except SourceBindingError as exc:
+            raise SourceBindingError(f"predecessor_object_missing:{head}") from exc
+        if resolved.decode("ascii").strip() != head:
+            raise SourceBindingError(f"predecessor_object_missing:{head}")
+    ancestry = subprocess.run(
+        ["git", "merge-base", "--is-ancestor", baseline, intended], cwd=root,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    if ancestry.returncode == 1:
+        raise SourceBindingError("predecessor_not_descendant")
+    if ancestry.returncode != 0:
+        detail = ancestry.stderr.decode("utf-8", "replace").strip()
+        raise SourceBindingError(f"predecessor_object_missing:{detail}")
+    try:
+        return _git(
+            root, "rev-list", "--first-parent", "--parents", "--reverse",
+            intended, f"^{baseline}", "--",
+        ).decode("ascii").splitlines()
+    except SourceBindingError as exc:
+        raise SourceBindingError(f"predecessor_object_missing:{intended}") from exc
+

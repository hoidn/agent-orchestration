+             "size": source.stat().st_size, "state": "added"}]
+    candidate = {
+        "evidence_root_exclusion": "evidence", "candidate_paths": rows,
+        "candidate_path_set_sha256": broad.canonical_sha256(rows),
+    }
+    producer._bind_candidate_to_repository(repository, candidate)
+    return candidate, producer._ledger_binding(receipt), bootstrap
+
+
+def _bootstrap_handoff(repository: Path, candidate, ledger, bootstrap):
+    task, focused = producer._producer_focused_report(repository, candidate, ledger)
+    raw = producer._producer_raw_broad(repository)
+    directory = Path(SOURCE_ROOT) / "implementation-commits/task-01-bootstrap"
+    subject_path = directory / "subject.json"
+    baseline_path = Path(SOURCE_ROOT) / "bootstrap-workspace-baseline.json"

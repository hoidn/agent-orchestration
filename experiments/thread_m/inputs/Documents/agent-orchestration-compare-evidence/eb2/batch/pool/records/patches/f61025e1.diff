+@pytest.mark.parametrize('tamper', ['missing_request', 'duplicate_snapshot', 'swap_generation_files', 'outside_path', 'candidate_index', 'missing_request_row', 'missing_ancestor_row', 'committed_duplicate_slot', 'unrelated_ancestry'])

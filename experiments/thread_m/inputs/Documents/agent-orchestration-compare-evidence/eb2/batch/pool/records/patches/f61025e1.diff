+    prior = request["prior_generation_binding"]
+    old_path = prior[role]
+    prior[role] = "wrong-parent/" + old_path
+    overlay[prior[role]] = overlay[old_path]
+    request_path = _rebind_request(overlay, latest.request_path, request)
+    (tmp_path / latest.request_path).unlink()
+    issues = materialization.validate_generation(
+        tmp_path, request_path, latest.snapshot_path, bound_file_bytes=overlay,

     return matches[0].group(1).decode("ascii"), "sha256:" + matches[0].group(2).decode("ascii")
 
 
+def derive_committed_predecessor_lineage(
+    repository_root: Path | str,
+    *,
+    baseline_head: str,
+    intended_predecessor_head: str,
+    require_uncovered_paths: bool = False,
+) -> dict[str, Any]:
+    """Bind a linear committed delta, including paths lacking commit control."""
+    root = _repository_root(repository_root)
+    baseline = _git(root, "rev-parse", "--verify", f"{baseline_head}^{{commit}}").decode("ascii").strip()
+    intended = _git(root, "rev-parse", "--verify", f"{intended_predecessor_head}^{{commit}}").decode("ascii").strip()
+    _git(root, "merge-base", "--is-ancestor", baseline, intended)
+    tree = _git(root, "rev-parse", f"{intended}^{{tree}}").decode("ascii").strip()
+    _git(root, "cat-file", "-e", tree)
+    objects = _git(root, "rev-list", "--objects", "--no-object-names", f"{baseline}..{intended}")
+    object_rows = _git(root, "cat-file", "--batch-check", input_bytes=objects).splitlines()
+    if any(row.endswith(b" missing") for row in object_rows):
+        raise SourceBindingError("predecessor_lineage_object_missing")
+    commits = _git(root, "rev-list", "--first-parent", "--reverse", "--parents", f"{baseline}..{intended}").decode("ascii").splitlines()
+    rows: list[dict[str, Any]] = []
+    controlled: set[str] = set()
+    uncovered: set[str] = set()
+    previous = baseline
+    for line in commits:
+        coordinates = line.split()
+        if len(coordinates) != 2:
+            raise SourceBindingError("predecessor_lineage_merge_invalid")
+        commit, parent = coordinates
+        if parent != previous:
+            raise SourceBindingError("predecessor_lineage_first_parent_invalid")
+        commit_tree = _git(root, "rev-parse", f"{commit}^{{tree}}").decode("ascii").strip()
+        message = _raw_commit_message(root, commit)
+        control = _trailer_coordinates(message)
+        markers = re.findall(rb"(?m)^Retirement-(?:Control-Schema|Transaction-ID|Control-SHA256):", message)
+        if markers and (
+            control is None
+            or len(markers) != 3
+            or b"\n\nRetirement-Control-Schema:" not in message
+        ):
+            raise SourceBindingError("commit_control_trailer_invalid")
+        raw_paths = _git(root, "diff-tree", "--no-commit-id", "--name-only", "--no-renames", "-r", "-z", commit)
+        paths = sorted(_decode_path(item) for item in raw_paths.split(b"\0") if item)
+        if len(paths) != len(set(paths)):
+            raise SourceBindingError("committed_path_set_invalid")
+        (controlled if control is not None else uncovered).update(paths)
+        rows.append({
+            "commit": commit,
+            "parent": parent,
+            "tree": commit_tree,
+            "raw_message_sha256": _sha256_bytes(message),
+            "changed_paths": paths,
+            "changed_path_set_sha256": _path_list_digest(paths),
+            "control_coordinates": None if control is None else {
+                "transaction_id": control[0],
+                "normalized_control_sha256": control[1],
+            },
+        })
+        previous = commit
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("predecessor_lineage_uncovered_paths_required")
+    changed_paths = sorted(controlled | uncovered)
+    projection: dict[str, Any] = {
+        "baseline_head": baseline,
+        "intended_predecessor_head": intended,
+        "intended_predecessor_tree": tree,
+        "first_parent_commits": rows,
+        "commit_count": len(rows),
+        "changed_paths": changed_paths,
+        "changed_path_count": len(changed_paths),
+        "changed_path_set_sha256": _path_list_digest(changed_paths),
+        "controlled_paths": sorted(controlled),
+        "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": sorted(uncovered),
+        "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    projection["normalized_projection_sha256"] = _canonical_sha256(projection)
+    return projection
+

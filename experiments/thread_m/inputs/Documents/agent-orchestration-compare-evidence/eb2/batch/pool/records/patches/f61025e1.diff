+"""Evidence relocation reopens bound bytes while preserving live Git checks."""
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import broad_evidence, materialization
+from tests.test_retirement_broad_evidence import (
+    _git_output,
+    _publish_test_review_pair,
+    _three_generation_ledger_chain,
+)
+
+
+def _overlay(repository: Path) -> dict[str, bytes]:
+    return {
+        path.relative_to(repository).as_posix(): path.read_bytes()
+        for path in repository.rglob("*")
+        if path.is_file() and ".git" not in path.parts
+    }
+

+def _read_evidence_file(
+    repository_root: Path,
+    logical_path: Any,
+    *,
+    bound_file_bytes: Mapping[str, bytes] | None = None,
+    require_committed_fallback: bool = False,
+) -> bytes | None:
+    """Read logical evidence bytes; Git-derived candidate checks stay live."""
+    if not _is_relative_logical_path(logical_path):
+        return None
+    if bound_file_bytes is not None and logical_path in bound_file_bytes:
+        data = bound_file_bytes[logical_path]
+        return data if isinstance(data, bytes) else None
+    data = _read_repository_file_no_follow(repository_root, logical_path)
+    if data is None or not require_committed_fallback:
+        return data
+    try:
+        entry = subprocess.run(
+            ["git", "ls-tree", "-z", "HEAD", "--", logical_path],
+            cwd=repository_root, check=True, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        ).stdout
+        metadata, name = entry.rstrip(b"\0").split(b"\t", 1)
+        mode, kind, object_id = metadata.split()
+        if (
+            mode not in {b"100644", b"100755"}
+            or kind != b"blob"
+            or name != os.fsencode(logical_path)
+        ):
+            return None
+        committed = subprocess.run(
+            ["git", "cat-file", "blob", object_id.decode("ascii")],
+            cwd=repository_root, check=True, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        ).stdout
+    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
+        return None
+    return data if data == committed else None

+def _rebind_request(overlay: dict[str, bytes], request_path: Path, request: dict) -> Path:
+    request["normalized_request_sha256"] = broad_evidence.canonical_sha256(
+        request, exclude={"normalized_request_sha256"}
+    )
+    path = materialization._request_path(
+        materialization._evidence_root_from_request_path(request_path),
+        Path(request["output_path"]), request["generation"],
+        request["normalized_request_sha256"],
+    )
+    del overlay[request_path.as_posix()]
+    overlay[path.as_posix()] = broad_evidence.canonical_json_bytes(request) + b"\n"
+    return path

+++ b/orchestrator/retirement/attempt_incident.py
@@ -0,0 +1,330 @@
+"""Closed evidence for an adopted attempt with an invalid commit predecessor."""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping
+
+from . import attempt_migration as migration
+from . import broad_evidence, source_bindings
+
+SCHEMA_VERSION = "attempt_migration_incident.v1"
+CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+BINDING_ROLES = (
+    "governing_plan", "migration_plan", "workspace_baseline", "owner_attestation",
+    "pending_attestation_snapshot", "known_failure_baseline", "expected_paths_manifest",
+)
+KEYS = {
+    "schema_version", *(role + "_binding" for role in BINDING_ROLES),
+    "source_root", "intended_predecessor", "predecessor_projection",
+    "pre_move_repository_state", "attempt_rows", "attempt_path_count",
+    "attempt_path_set_sha256", "normalized_attempt_row_set_sha256", "adoption_facts",
+    "normalized_incident_sha256", "claims_not_made",
+}
+ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+
+
+def _owner_facts(record: Mapping[str, Any]) -> dict[str, Any]:
+    owner = record.get("owner")
+    confirmations = record.get("owner_confirmations")
+    adoption = record.get("owner_adoption")
+    if (
+        record.get("evidence_status") != "owner_confirmed"
+        or not isinstance(owner, Mapping)
+        or not isinstance(confirmations, Mapping)
+        or not isinstance(adoption, Mapping)
+        or not isinstance(owner.get("identity"), str) or not owner.get("identity")
+        or not isinstance(owner.get("role"), str) or not owner.get("role")
+        or adoption.get("identity") != owner.get("identity")
+        or broad_evidence._aware_timestamp(confirmations.get("confirmed_at")) is None
+        or broad_evidence._aware_timestamp(adoption.get("adopted_at")) is None
+    ):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    # The existing attestation contract also closes confirmations and timestamp order.
+    if broad_evidence.validate_record(record):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    return {
+        "adoption_state": "owner_adopted",
+        "repository_commit_state": "uncommitted",
+        "evidence_status": "owner_confirmed",
+        "owner_identity": owner["identity"], "owner_role": owner["role"],
+        "confirmed_at": confirmations["confirmed_at"],
+        "adopted_at": adoption["adopted_at"],
+    }
+
+
+def _read_binding(
+    root: Path, binding: Any, role: str, *,
+    bound_file_bytes: Mapping[str, bytes] | None = None,
+) -> bytes:
+    code = f"incident_{role}_binding_invalid"
+    try:
+        migration._validate_file_binding(binding, full=False)
+        path = binding["path"]
+        if bound_file_bytes is not None and path in bound_file_bytes:
+            data = bound_file_bytes[path]
+        elif bound_file_bytes is not None:
+            data = migration._require_committed_live(root, path)["data"]
+        else:
+            data = migration._read_regular(root, path)["data"]
+        if not isinstance(data, bytes) or len(data) != binding["size"] or migration._bytes_digest(data) != binding["sha256"]:
+            raise migration.AttemptMigrationError(code)
+        return data
+    except (migration.AttemptMigrationError, OSError, TypeError, KeyError) as exc:
+        raise migration.AttemptMigrationError(code) from exc
+
+
+def _read_bound_json(root, binding, role, *, bound_file_bytes=None):
+    try:
+        return migration._json_bytes(
+            _read_binding(root, binding, role, bound_file_bytes=bound_file_bytes), binding["path"]
+        )
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError(f"incident_{role}_binding_invalid") from exc
+
+
+def _bound_evidence_issues(record, root, *, bound_file_bytes):
+    kwargs = {} if bound_file_bytes is None else {
+        "bound_file_bytes": bound_file_bytes, "require_committed_fallback": True,
+    }
+    return broad_evidence.validate_bound_record(record, root, **kwargs)
+
+
+def _historical_evidence_issues(record, root, *, bound_file_bytes=None):
+    issues = _bound_evidence_issues(record, root, bound_file_bytes=bound_file_bytes)
+    candidate = record.get("candidate_binding")
+    historical_identity_valid = False
+    if isinstance(candidate, Mapping):
+        try:
+            historical_identity_valid = (
+                migration._is_commit_identity(candidate.get("head"))
+                and migration._git_is_ancestor(root, candidate["head"], "HEAD")
+                and migration._git(root, "rev-parse", candidate["head"] + "^{tree}").decode("ascii").strip() == candidate.get("head_tree")
+            )
+        except migration.AttemptMigrationError:
+            pass
+    # Later corrective commits advance HEAD/index; candidate bytes and Git state still validate.
+    issues = [issue for issue in issues if issue.code != "candidate_path_set_live_mismatch" and not (issue.code == "candidate_git_identity_mismatch" and historical_identity_valid)]
+    if record.get("schema_version") == "broad_known_failure_baseline.v1":
+        wrapped = [issue for issue in issues if issue.code == "bound_record_invalid" and issue.path == "$.broad_outcome_binding"]
+        if wrapped:
+            binding = record.get("broad_outcome_binding", {})
+            try:
+                path = binding["path"]
+                if bound_file_bytes is not None and path in bound_file_bytes:
+                    data = bound_file_bytes[path]
+                elif bound_file_bytes is not None:
+                    data = migration._require_committed_live(root, path)["data"]
+                else:
+                    data = migration._read_regular(root, path)["data"]
+                nested = migration._json_bytes(data, path)
+                if migration._bytes_digest(data) == binding["sha256"] and not _historical_evidence_issues(nested, root, bound_file_bytes=bound_file_bytes):
+                    issues = [issue for issue in issues if issue not in wrapped]
+            except (migration.AttemptMigrationError, KeyError, TypeError):
+                pass
+    return issues
+
+
+def _validate_evidence(root, bindings, *, bound_file_bytes=None):
+    workspace = _read_bound_json(root, bindings["workspace_baseline"], "workspace_baseline", bound_file_bytes=bound_file_bytes)
+    if workspace.get("schema_version") != "workspace_baseline.v1" or source_bindings.validate_workspace_record_shape(workspace):
+        raise migration.AttemptMigrationError("incident_workspace_baseline_binding_invalid")
+    owner = _read_bound_json(root, bindings["owner_attestation"], "owner_attestation", bound_file_bytes=bound_file_bytes)
+    facts = _owner_facts(owner)
+    pending = _read_bound_json(root, bindings["pending_attestation_snapshot"], "pending_attestation_snapshot", bound_file_bytes=bound_file_bytes)
+    if pending.get("evidence_status") != "pending_owner_confirmation" or broad_evidence.validate_record(pending):
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid")
+    immutable_keys = set(owner) - {"evidence_status", "owner", "owner_confirmations", "owner_adoption"}
+    if any(owner[key] != pending.get(key) for key in immutable_keys) or set(owner) != set(pending):
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid")
+    baseline = _read_bound_json(root, bindings["known_failure_baseline"], "known_failure_baseline", bound_file_bytes=bound_file_bytes)
+    issues = _historical_evidence_issues(baseline, root, bound_file_bytes=bound_file_bytes)
+    codes = {issue.code for issue in issues}
+    if baseline.get("schema_version") != "broad_known_failure_baseline.v1":
+        codes.add("schema_version_invalid")
+    if codes:
+        raise migration.AttemptMigrationError("incident_known_failure_baseline_binding_invalid", ",".join(sorted(codes)))
+    for role, value in (("owner_attestation", owner), ("pending_attestation_snapshot", pending)):
+        if value.get("baseline_binding", {}).get("path") != bindings["known_failure_baseline"]["path"] or value.get("baseline_binding", {}).get("sha256") != bindings["known_failure_baseline"]["sha256"]:
+            raise migration.AttemptMigrationError(f"incident_{role}_binding_invalid")
+        attestation_issues = _historical_evidence_issues(value, root, bound_file_bytes=bound_file_bytes)
+        # The exact shared baseline was reopened above with historical candidate checks.
+        attestation_issues = [issue for issue in attestation_issues if not (issue.code == "review_pair_subject_invalid" and issue.path == "$.subject")]
+        if attestation_issues:
+            raise migration.AttemptMigrationError(f"incident_{role}_binding_invalid")
+    return workspace, facts
+
+
+def _validate_source_inventory(root, source, expected):
+    for path in migration._scan_regular_files(root, source):
+        if path in expected:
+            continue
+        try:
+            migration._require_committed_live(root, path)
+        except migration.AttemptMigrationError as exc:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid", path) from exc
+
+
+def build_attempt_migration_incident(
+    repository_root: Path | str, *, governing_plan_path: Path | str,
+    migration_plan_path: Path | str, workspace_baseline_path: Path | str,
+    owner_attestation_path: Path | str, pending_attestation_snapshot_path: Path | str,
+    known_failure_baseline_path: Path | str, expected_paths_manifest_path: Path | str,
+    source_root: Path | str, intended_predecessor_head: str,
+) -> dict[str, Any]:
+    root = migration._repository_root(repository_root)
+    source = migration._relative_path(source_root)
+    paths = {
+        "governing_plan": governing_plan_path, "migration_plan": migration_plan_path,
+        "workspace_baseline": workspace_baseline_path, "owner_attestation": owner_attestation_path,
+        "pending_attestation_snapshot": pending_attestation_snapshot_path,
+        "known_failure_baseline": known_failure_baseline_path,
+        "expected_paths_manifest": expected_paths_manifest_path,
+    }
+    snapshots = {role: migration._read_regular(root, migration._relative_path(path)) for role, path in paths.items()}
+    bindings = {role: migration._content_binding(snapshot) for role, snapshot in snapshots.items()}
+    workspace, facts = _validate_evidence(root, bindings)
+    expected = migration._manifest_paths(snapshots["expected_paths_manifest"]["data"], bindings["expected_paths_manifest"]["path"])
+    state = migration._repository_state(root)
+    migration._validate_status_projection_boundaries(state["status_projection"]["rows"], source)
+    observed = migration._status_paths(state["status_projection"]["rows"], source)
+    if expected != observed or any(not migration._under(path, source) for path in expected):
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    rows = []
+    for path in expected:
+        snapshot = migration._read_regular(root, path)
+        rows.append({**migration._public_binding(snapshot), "tracked_state": "modified" if migration._is_tracked(root, path) else "untracked"})
+    bindings["expected_paths_manifest"]["row_count"] = len(expected)
+    try:
+        predecessor = source_bindings.derive_committed_predecessor_lineage(root, baseline_head=workspace["head"], intended_predecessor_head=intended_predecessor_head, require_uncovered_paths=True)
+    except source_bindings.SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_lineage_invalid", str(exc)) from exc
+    if not migration._git_is_ancestor(root, predecessor["intended_predecessor_head"], state["head"]):
+        raise migration.AttemptMigrationError("incident_predecessor_lineage_invalid")
+    record = {
+        "schema_version": SCHEMA_VERSION,
+        **{role + "_binding": binding for role, binding in bindings.items()},
+        "source_root": source,
+        "intended_predecessor": {"head": predecessor["intended_predecessor_head"], "tree": predecessor["intended_predecessor_tree"]},
+        "predecessor_projection": predecessor, "pre_move_repository_state": state,
+        "attempt_rows": rows, "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": migration._canonical_digest(expected),
+        "normalized_attempt_row_set_sha256": migration._canonical_digest(rows),
+        "adoption_facts": facts, "claims_not_made": CLAIMS_NOT_MADE,
+    }
+    record["normalized_incident_sha256"] = migration._canonical_digest(record)
+    return validate_attempt_migration_incident(root, record)
+
+
+def _validate_incident(repository_root, record, *, bound_file_bytes=None):
+    root = migration._repository_root(repository_root)
+    migration._require_keys(record, KEYS, "incident_keys_invalid")
+    if record["schema_version"] != SCHEMA_VERSION or record["claims_not_made"] != CLAIMS_NOT_MADE:
+        raise migration.AttemptMigrationError("incident_schema_invalid")
+    if record["normalized_incident_sha256"] != migration._canonical_digest(record, exclude="normalized_incident_sha256"):
+        raise migration.AttemptMigrationError("incident_digest_invalid")
+    bindings = {}
+    for role in BINDING_ROLES:
+        value = record[role + "_binding"]
+        if role == "expected_paths_manifest":
+            migration._require_keys(value, {"path", "size", "sha256", "row_count"}, "incident_expected_paths_manifest_binding_invalid")
+            value = {key: value[key] for key in ("path", "size", "sha256")}
+        _read_binding(root, value, role, bound_file_bytes=bound_file_bytes)
+        bindings[role] = value
+    workspace, facts = _validate_evidence(root, bindings, bound_file_bytes=bound_file_bytes)
+    if record["adoption_facts"] != facts:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    expected = migration._manifest_paths(_read_binding(root, bindings["expected_paths_manifest"], "expected_paths_manifest", bound_file_bytes=bound_file_bytes), bindings["expected_paths_manifest"]["path"])
+    manifest = record["expected_paths_manifest_binding"]
+    if type(manifest["row_count"]) is not int or manifest["row_count"] != len(expected):
+        raise migration.AttemptMigrationError("incident_expected_paths_manifest_binding_invalid")
+    source = migration._relative_path(record["source_root"])
+    rows = record["attempt_rows"]
+    if not isinstance(rows, list) or not rows:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    for row in rows:
+        migration._require_keys(row, ROW_KEYS, "attempt_row_state_invalid")
+        binding = {key: row[key] for key in ROW_KEYS - {"tracked_state"}}
+        migration._validate_file_binding(binding)
+        if not migration._under(row["path"], source) or not isinstance(row["tracked_state"], str) or row["tracked_state"] not in {"modified", "untracked"}:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid")
+        tracked_state = "modified" if migration._is_tracked(root, row["path"]) else "untracked"
+        if row["tracked_state"] != tracked_state:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid", row["path"])
+        if bound_file_bytes is None:
+            snapshot = migration._read_regular(root, row["path"], missing_ok=True)
+            if not migration._same_content(snapshot, binding):
+                raise migration.AttemptMigrationError("attempt_row_state_invalid", row["path"])
+        else:
+            data = bound_file_bytes.get(row["path"])
+            if data is None or len(data) != row["size"] or migration._bytes_digest(data) != row["sha256"]:
+                raise migration.AttemptMigrationError("attempt_row_state_invalid", row["path"])
+    if bound_file_bytes is None:
+        current = migration._repository_state(root)
+        if migration._status_paths(current["status_projection"]["rows"], source) != expected:
+            raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    _validate_source_inventory(root, source, set(expected))
+    if [row["path"] for row in rows] != expected or len(set(expected)) != len(rows):
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    if type(record["attempt_path_count"]) is not int or record["attempt_path_count"] != len(rows) or record["attempt_path_set_sha256"] != migration._canonical_digest(expected) or record["normalized_attempt_row_set_sha256"] != migration._canonical_digest(rows):
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    intended = migration._require_keys(record["intended_predecessor"], {"head", "tree"}, "incident_predecessor_invalid")
+    if not migration._is_commit_identity(intended["head"]) or not migration._is_commit_identity(intended["tree"]):
+        raise migration.AttemptMigrationError("incident_predecessor_invalid")
+    try:
+        projection = source_bindings.derive_committed_predecessor_lineage(root, baseline_head=workspace["head"], intended_predecessor_head=intended["head"], require_uncovered_paths=True)
+    except source_bindings.SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_lineage_invalid", str(exc)) from exc
+    if migration._canonical_json(record["predecessor_projection"]) != migration._canonical_json(projection) or intended["tree"] != projection["intended_predecessor_tree"]:
+        raise migration.AttemptMigrationError("incident_predecessor_lineage_invalid")
+    _validate_repository_state(root, record["pre_move_repository_state"])
+    capture_state = record["pre_move_repository_state"]
+    migration._validate_status_projection_boundaries(capture_state["status_projection"]["rows"], source)
+    if migration._status_paths(capture_state["status_projection"]["rows"], source) != expected:
+        raise migration.AttemptMigrationError("attempt_row_state_invalid")
+    row_by_path = {row["path"]: row for row in rows}
+    owner_binding = bindings["owner_attestation"]
+    owner_row = row_by_path.get(owner_binding["path"])
+    if owner_row is None or any(owner_row[key] != owner_binding[key] for key in ("size", "sha256")):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    owner_entry = migration._git(root, "ls-tree", capture_state["head"], "--", owner_binding["path"])
+    if owner_entry and migration._bytes_digest(migration._committed_bytes(root, owner_binding["path"], revision=capture_state["head"])) == owner_binding["sha256"]:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid")
+    if not migration._git_is_ancestor(root, intended["head"], record["pre_move_repository_state"]["head"]):
+        raise migration.AttemptMigrationError("incident_predecessor_lineage_invalid")
+    return record
+
+
+def _validate_repository_state(root, state):
+    migration._require_keys(state, {"head", "tree", "index_sha256", "status_projection"}, "incident_repository_state_invalid")
+    if not migration._is_commit_identity(state["head"]) or not migration._is_commit_identity(state["tree"]) or not migration._is_sha256(state["index_sha256"]):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    projection = migration._require_keys(state["status_projection"], {"rows", "row_count", "normalized_rows_sha256"}, "incident_repository_state_invalid")
+    rows = projection["rows"]
+    if not isinstance(rows, list) or type(projection["row_count"]) is not int or projection["row_count"] != len(rows) or projection["normalized_rows_sha256"] != migration._canonical_digest(rows):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    for row in rows:
+        migration._require_keys(row, {"path", "source_path", "status"}, "incident_repository_state_invalid")
+        migration._relative_path(row["path"])
+        if row["source_path"] is not None:
+            migration._relative_path(row["source_path"])
+        if not isinstance(row["status"], str) or migration.GIT_STATUS_RE.fullmatch(row["status"]) is None or row["status"] == "  ":
+            raise migration.AttemptMigrationError("incident_repository_state_invalid")
+        renamed = row["status"][0] in "RC" or row["status"][1] in "RC"
+        if renamed != (row["source_path"] is not None):
+            raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    identities = [(row["path"], row["source_path"], row["status"]) for row in rows]
+    if len(identities) != len(set(identities)):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    if rows != sorted(rows, key=lambda row: (row["path"], row["source_path"] or "", row["status"])):
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    if migration._git(root, "rev-parse", state["head"] + "^{tree}").decode("ascii").strip() != state["tree"]:
+        raise migration.AttemptMigrationError("incident_repository_state_invalid")
+    if not migration._git_is_ancestor(root, state["head"], "HEAD"):
+        raise migration.AttemptMigrationError("capture_head_not_ancestor")
+
+
+def validate_attempt_migration_incident(repository_root, record):
+    """Reopen every bound file and immutable Git projection without changing it."""
+    return _validate_incident(repository_root, record)

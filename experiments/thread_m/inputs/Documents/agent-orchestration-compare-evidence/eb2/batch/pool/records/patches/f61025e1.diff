new file mode 100644
index 0000000..e96c334
--- /dev/null
+++ b/tests/test_retirement_adopted_migration.py
@@ -0,0 +1,282 @@
+"""Additive recovery schema and command boundaries."""
+import subprocess
+import sys
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+
+
+def test_adopted_capture_command_is_exposed():
+    result = subprocess.run(
+        [sys.executable, '-m', 'orchestrator.retirement.attempt_migration',
+         'capture-invalidated-adopted', '--help'], capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    assert '--incident-path' in result.stdout
+    assert '--restoration-commit' in result.stdout
+    assert '--attestation-record-path' in result.stdout
+
+
+def test_schema_dispatch_rejects_v1_shape_as_v2():
+    with pytest.raises(migration.AttemptMigrationError):
+        migration._validate_disposition_structure({'schema_version': 'attempt_migration_disposition.v2'})
+
+
+def test_adopted_capture_and_incident_api_are_available():
+    assert callable(migration.capture_invalidated_adopted)
+    assert callable(migration.build_attempt_migration_incident)
+    assert callable(migration.validate_attempt_migration_incident)
+
+
+def _make_adopted_repository(tmp_path):
+    import importlib.util
+    import json
+    from pathlib import Path
+
+    spec = importlib.util.spec_from_file_location('adopted_incident_fixtures', Path(__file__).with_name('test_retirement_attempt_incident.py'))
+    fixtures = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(fixtures)
+    root, incident_arguments, arguments = fixtures._make_incident_repository(tmp_path)
+    arguments.update({key: incident_arguments[key] for key in (
+        'governing_plan_path', 'migration_plan_path', 'workspace_baseline_path',
+        'expected_paths_manifest_path', 'source_root', 'intended_predecessor_head',
+    )})
+    arguments.update(incident_path='recovery/incident.json', disposition_path='recovery/disposition.json',
+                     archive_root='archived-attempt', protected_paths=['source.py'],
+                     authority_subject_path='authority/subject.json',
+                     authority_specification_review_path='authority/specification.json',
+                     authority_quality_review_path='authority/quality.json')
+    for path in ('mechanism.py', 'mechanism_test.py', 'verification/candidate.json',
+                 'verification/exact.diff', 'verification/focused.txt', 'verification/broad.txt'):
+        (root / path).parent.mkdir(parents=True, exist_ok=True)
+        (root / path).write_text('bound authority evidence\n')
+    def snapshot(path):
+        return migration._read_regular(root, path)
+    manifest = migration._content_binding(snapshot(arguments['expected_paths_manifest_path']))
+    paths = migration._manifest_paths(snapshot(manifest['path'])['data'], manifest['path'])
+    manifest.update(row_count=len(paths), normalized_path_set_sha256=migration._canonical_digest(paths))
+    subject = {
+        'schema_version': 'attempt_migration_authority_subject.v1',
+        'governing_plan_binding': migration._content_binding(snapshot('plan.md')),
+        'migration_plan_binding': migration._content_binding(snapshot('migration.md')),
+        'expected_paths_manifest_binding': manifest,
+        'protected_path_bindings': [migration._public_binding(snapshot('source.py'))],
+        'mechanism_binding': migration._public_binding(snapshot('mechanism.py')),
+        'test_binding': migration._public_binding(snapshot('mechanism_test.py')),
+        'evidence_bindings': {role: migration._public_binding(snapshot(path)) for role, path in {
+            'candidate_manifest': 'verification/candidate.json', 'exact_diff': 'verification/exact.diff',
+            'focused_test_evidence': 'verification/focused.txt', 'broad_test_evidence': 'verification/broad.txt',
+        }.items()},
+        'claims_not_made': migration.AUTHORITY_SUBJECT_CLAIMS_NOT_MADE,
+    }
+    subject['normalized_subject_sha256'] = migration._canonical_digest(subject)
+    (root / 'authority').mkdir()
+    (root / arguments['authority_subject_path']).write_bytes(migration._canonical_json(subject) + b'\n')
+    for kind, role in [('specification', 'specification'), ('code_quality', 'quality')]:
+        path = arguments['authority_specification_review_path' if kind == 'specification' else 'authority_quality_review_path']
+        _write_review(root, path, kind, 'attempt_migration_authority', arguments['authority_subject_path'])
+    migration._git(root, 'add', 'authority', 'verification', 'mechanism.py', 'mechanism_test.py', 'expected-paths.txt')
+    migration._git(root, 'commit', '-qm', 'commit the recovery authority')
+    return root, arguments
+
+
+def _write_review(root, path, kind, subject_kind, subject_path):
+    record = {
+        'schema_version': 'review.v1', 'review_kind': kind,
+        'reviewer': {'identity': kind + '-reviewer'},
+        'reviewed_at': '2026-01-02T00:00:00+00:00' if kind == 'specification' else '2026-01-02T00:01:00+00:00',
+        'subject': {'kind': subject_kind, 'path': subject_path,
+                    'sha256': migration._read_regular(root, subject_path)['sha256']},
+        'result': 'approved', 'issues': [], 'claims_not_made': ['Review grants no authority alone.'],
+    }
+    (root / path).write_bytes(migration._canonical_json(record) + b'\n')
+
+
+def _commit_recovery_reviews(root, arguments):
+    for kind, path in [('specification', 'recovery/specification.json'), ('code_quality', 'recovery/quality.json')]:
+        _write_review(root, path, kind, 'attempt_migration_disposition', arguments['disposition_path'])
+    migration._git(root, 'add', 'recovery')
+    migration._git(root, 'commit', '-qm', 'approve the exact recovery')
+
+
+def test_adopted_capture_apply_validate_and_postvalidate_replay(tmp_path):
+    root, arguments = _make_adopted_repository(tmp_path)
+    captured = migration.capture_invalidated_adopted(root, **arguments)
+    assert captured['incident']['adoption_facts']['adoption_state'] == 'owner_adopted'
+    disposition = captured['disposition']
+    assert disposition['schema_version'] == 'attempt_migration_disposition.v2'
+    before_replay = migration._repository_state(root)
+    assert migration.capture_invalidated_adopted(root, **arguments) == captured
+    assert migration._repository_state(root) == before_replay
+    assert migration.validate(root, arguments['disposition_path']) == disposition
+    _commit_recovery_reviews(root, arguments)
+    apply_arguments = (root, arguments['disposition_path'], 'recovery/specification.json', 'recovery/quality.json')
+    assert migration.apply(*apply_arguments) == disposition
+    assert migration.validate(root, arguments['disposition_path']) == disposition
+    after = migration._repository_state(root)
+    assert migration.apply(*apply_arguments) == disposition
+    assert migration._repository_state(root) == after
+    report = migration.postvalidate(*apply_arguments, 'recovery/report.json')
+    assert report['result'] == 'passed'
+    assert report['disposition_binding']['path'] == arguments['disposition_path']
+    assert migration.postvalidate(*apply_arguments, 'recovery/report.json') == report
+
+
+def test_incident_only_crash_can_complete_but_rejects_unrelated_drift(tmp_path, monkeypatch):
+    root, arguments = _make_adopted_repository(tmp_path)
+    publish = migration._publish_exclusive
+    def crash_before_disposition(repository_root, path, data, mode):
+        if path == arguments['disposition_path']:
+            raise migration.AttemptMigrationError('simulated_crash')
+        return publish(repository_root, path, data, mode)
+    monkeypatch.setattr(migration, '_publish_exclusive', crash_before_disposition)
+    with pytest.raises(migration.AttemptMigrationError, match='simulated_crash'):
+        migration.capture_invalidated_adopted(root, **arguments)
+    assert (root / arguments['incident_path']).is_file()
+    assert not (root / arguments['disposition_path']).exists()
+    monkeypatch.setattr(migration, '_publish_exclusive', publish)
+    (root / 'unrelated.txt').write_text('unexpected change\n')
+    with pytest.raises(migration.AttemptMigrationError, match='incident_replay_state_invalid'):
+        migration.capture_invalidated_adopted(root, **arguments)
+    (root / 'unrelated.txt').unlink()
+    result = migration.capture_invalidated_adopted(root, **arguments)
+    assert migration.validate(root, arguments['disposition_path']) == result['disposition']
+
+
+@pytest.mark.parametrize('output', ['incident_path', 'disposition_path'])
+def test_capture_replay_rejects_one_byte_output_change(tmp_path, output):

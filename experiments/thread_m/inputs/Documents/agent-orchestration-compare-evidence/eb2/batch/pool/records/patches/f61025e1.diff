+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from orchestrator.retirement import source_bindings
+
+
+def git(root: Path, *args: str) -> str:
+    return subprocess.check_output(["git", *args], cwd=root, text=True).strip()
+
+
+@pytest.fixture
+def repository(tmp_path: Path) -> Path:
+    root = tmp_path / "repository"
+    root.mkdir()
+    git(root, "init", "-q")
+    git(root, "config", "user.email", "tests@example.invalid")
+    git(root, "config", "user.name", "Tests")
+    (root / "base").write_text("base\n")
+    git(root, "add", ".")
+    git(root, "commit", "-qm", "base")
+    return root
+
+
+def commit(root: Path, path: str, message: str) -> str:
+    (root / path).write_text(message + "\n")
+    git(root, "add", "--", path)
+    git(root, "commit", "--cleanup=verbatim", "-qm", message)
+    return git(root, "rev-parse", "HEAD")
+
+
+def path_digest(paths: list[str]) -> str:
+    return "sha256:" + hashlib.sha256("".join(path + "\n" for path in sorted(paths)).encode()).hexdigest()
+
+
+def derive(root: Path, baseline: str, intended: str, **kwargs: object) -> dict:
+    return source_bindings.derive_committed_predecessor_lineage(
+        root, baseline_head=baseline, intended_predecessor_head=intended, **kwargs
+    )
+
+
+def test_lineage_binds_ordered_commit_objects_and_path_coverage(repository: Path) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    first = commit(repository, "uncovered", "ordinary change")
+    message = "controlled change\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: " + "1" * 64 + "\nRetirement-Control-SHA256: " + "2" * 64 + "\n"
+    last = commit(repository, "controlled", message)
+    projection = derive(repository, baseline, last, require_uncovered_paths=True)
+    rows = projection["first_parent_commits"]
+    assert projection == {
+        "baseline_head": baseline,
+        "intended_predecessor_head": last,
+        "intended_predecessor_tree": git(repository, "rev-parse", last + "^{tree}"),
+        "first_parent_commits": rows,
+        "commit_count": 2,
+        "changed_paths": ["controlled", "uncovered"],
+        "changed_path_count": 2,
+        "changed_path_set_sha256": path_digest(["controlled", "uncovered"]),
+        "controlled_paths": ["controlled"],
+        "controlled_path_set_sha256": path_digest(["controlled"]),
+        "uncovered_paths": ["uncovered"],
+        "uncovered_path_set_sha256": path_digest(["uncovered"]),
+        "normalized_projection_sha256": source_bindings._canonical_sha256(projection, exclude={"normalized_projection_sha256"}),
+    }
+    for row, oid, parent, path in zip(rows, [first, last], [baseline, first], ["uncovered", "controlled"]):
+        raw = subprocess.check_output(["git", "cat-file", "commit", oid], cwd=repository).split(b"\n\n", 1)[1]
+        assert row == {
+            "commit": oid,
+            "parent": parent,
+            "tree": git(repository, "rev-parse", oid + "^{tree}"),
+            "raw_message_sha256": "sha256:" + hashlib.sha256(raw).hexdigest(),
+            "changed_paths": [path],
+            "changed_path_set_sha256": path_digest([path]),
+            "control_coordinates": None if oid == first else {"transaction_id": "1" * 64, "normalized_control_sha256": "sha256:" + "2" * 64},
+        }
+
+
+def test_lineage_allows_empty_range_unless_uncovered_paths_required(repository: Path) -> None:
+    head = git(repository, "rev-parse", "HEAD")
+    projection = derive(repository, head, head)
+    assert projection["commit_count"] == 0
+    assert projection["changed_paths"] == []
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, head, head, require_uncovered_paths=True)
+
+
+def test_lineage_rejects_fully_controlled_range(repository: Path) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    head = commit(repository, "controlled", "change\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: " + "a" * 64 + "\nRetirement-Control-SHA256: " + "b" * 64 + "\n")
+    assert derive(repository, baseline, head)["uncovered_paths"] == []
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, baseline, head, require_uncovered_paths=True)
+
+
+@pytest.mark.parametrize("message", [
+    "change\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: invalid\nRetirement-Control-SHA256: " + "2" * 64 + "\n",
+    "change\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: " + "1" * 64 + "\nRetirement-Control-SHA256: " + "2" * 64 + "\n",
+    "change\n\nRetirement-Control-Schema: precommit_control.v2\nRetirement-Transaction-ID: " + "1" * 64 + "\nRetirement-Control-SHA256: " + "2" * 64 + "\n",
+    "change\n\nRetirement-Control-Schema: precommit_control.v1\n",
+    "change\n\nRetirement-Control-Schema: precommit_control.v1\nRetirement-Transaction-ID: " + "1" * 64 + "\nRetirement-Control-SHA256: " + "2" * 64 + "\nextra\n",
+])
+def test_lineage_rejects_malformed_control_blocks(repository: Path, message: str) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    head = commit(repository, "changed", message)
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, baseline, head)
+
+
+def test_lineage_rejects_nonancestor_and_missing_commit(repository: Path) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    head = commit(repository, "changed", "later")
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, head, baseline)
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, baseline, "0" * 40)
+
+
+def test_lineage_rejects_first_parent_merge(repository: Path) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    git(repository, "checkout", "-qb", "side")
+    commit(repository, "side", "side")
+    git(repository, "checkout", "-q", "-")
+    commit(repository, "main", "main")
+    git(repository, "merge", "--no-ff", "-qm", "merge", "side")
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, baseline, git(repository, "rev-parse", "HEAD"))
+
+
+def test_lineage_rejects_duplicate_changed_path_projection(repository: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    head = commit(repository, "changed", "later")
+    original = source_bindings._git
+
+    def duplicate_paths(root: Path, *args: str, **kwargs: object) -> bytes:
+        if args[0] == "diff-tree":
+            return b"changed\0changed\0"
+        return original(root, *args, **kwargs)
+
+    monkeypatch.setattr(source_bindings, "_git", duplicate_paths)
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, baseline, head)
+
+
+def test_lineage_exports_remain_cold_lazy() -> None:
+    result = subprocess.check_output([
+        sys.executable, "-c",
+        "import json,sys; import orchestrator.retirement as r; print(json.dumps([r.__all__, [m for m in sys.modules if m.startswith('orchestrator.retirement.')]]))",
+    ], text=True)
+    exports, loaded = json.loads(result)
+    assert "derive_committed_predecessor_lineage" in exports
+    assert "validate_attempt_migration_incident" in exports
+    assert loaded == []
+
+
+def test_lineage_rejects_missing_changed_blob(repository: Path) -> None:
+    baseline = git(repository, "rev-parse", "HEAD")
+    head = commit(repository, "changed", "later")
+    blob = git(repository, "rev-parse", head + ":changed")
+    (repository / ".git" / "objects" / blob[:2] / blob[2:]).unlink()
+    with pytest.raises(source_bindings.SourceBindingError):
+        derive(repository, baseline, head)

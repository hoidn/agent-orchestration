+def _closed_first_task(repository: Path):
+    from tests.test_retirement_broad_evidence import (
+        _advance_bound_ledger, _ledger_binding,
+        _producer_bootstrap_subject_and_reviews,
+        _producer_task1_candidate_ledger_and_bootstrap,
+    )
+
+    candidate, binding, bootstrap = _producer_task1_candidate_ledger_and_bootstrap(repository)
+    for _ in range(2):
+        _, receipt = _advance_bound_ledger(repository, binding)
+        binding = _ledger_binding(receipt)
+    _, receipt = _advance_bound_ledger(repository, binding, future_paths=[
+        "evidence/implementation-commits/task-01-bootstrap/specification-review.json",
+        "evidence/implementation-commits/task-01-bootstrap/quality-review.json",
+    ])
+    binding = _ledger_binding(receipt)
+    subject_path, specification, quality = _producer_bootstrap_subject_and_reviews(
+        repository, candidate=candidate, ledger=binding, bootstrap=bootstrap,
+    )
+    paths = [subject_path, Path(specification["logical_path"]), Path(quality["logical_path"])]
+    evidence = [
+        {"path": path.as_posix(), "sha256": broad_evidence.file_sha256(repository / path)}
+        for path in sorted(paths)
+    ]
+    _, receipt = _advance_bound_ledger(repository, binding, evidence_bindings=evidence)
+    return receipt, paths, specification, quality

+
+def _projection_sets(projection: Mapping, rows: list) -> None:
+    controlled, uncovered = set(), set()
+    for row in rows:
+        target = uncovered if row["control_coordinates"] is None else controlled
+        target.update(row["changed_paths"])
+    for name, expected in (("changed", controlled | uncovered), ("controlled", controlled), ("uncovered", uncovered)):
+        paths = _projection_paths(projection[name + "_paths"])
+        if paths != sorted(expected) or projection[name + "_path_set_sha256"] != source_bindings._path_list_digest(paths):
+            raise ValueError
+    if type(projection["changed_path_count"]) is not int or projection["changed_path_count"] != len(controlled | uncovered):
+        raise ValueError
+
+
+def _structure_body(record: Mapping) -> None:
+    for name in BINDING_NAMES:
+        _binding_shape(name, record[name + "_binding"])
+    try:
+        source_root = migration._relative_path(record["source_root"])
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError("incident_structure_invalid", "source_root") from exc
+    predecessor = record["intended_predecessor"]
+    if not isinstance(predecessor, Mapping) or set(predecessor) != {"head", "tree"} or not all(migration._is_commit_identity(value) for value in predecessor.values()):
+        raise migration.AttemptMigrationError("incident_structure_invalid", "intended_predecessor")
+    paths = _rows_shape(record["attempt_rows"], source_root)
+    _row_digests(record, paths)
+    rows = migration._validate_repository_state_shape(record["pre_move_repository_state"], source_root)
+    if migration._status_paths(rows, source_root) != paths:
+        raise migration.AttemptMigrationError("source_status_coverage_mismatch")
+    _projection_shape(record["predecessor_projection"])
+    projection = record["predecessor_projection"]
+    if (projection["intended_predecessor_head"], projection["intended_predecessor_tree"]) != (predecessor["head"], predecessor["tree"]):
+        raise migration.AttemptMigrationError("incident_predecessor_projection_mismatch")
+    _adoption_shape(record["adoption_facts"])
+
+
+def _row_digests(record: Mapping, paths: list[str]) -> None:
+    if type(record["attempt_path_count"]) is not int or record["attempt_path_count"] != len(paths) or len(paths) != record["expected_paths_manifest_binding"]["row_count"]:
+        raise migration.AttemptMigrationError("incident_digest_mismatch", "attempt_path_count")
+    for field, value in (("attempt_path_set_sha256", paths), ("normalized_attempt_row_set_sha256", record["attempt_rows"])):
+        if record[field] != migration._canonical_digest(value):
+            raise migration.AttemptMigrationError("incident_digest_mismatch", field)
+
+
+def _adoption_shape(facts: Any) -> None:
+    if not isinstance(facts, Mapping) or set(facts) != set(ADOPTION_LITERALS) | set(ADOPTION_STRINGS):
+        raise migration.AttemptMigrationError("incident_structure_invalid", "adoption_facts")
+    if any(facts[key] != value for key, value in ADOPTION_LITERALS.items()) or any(not isinstance(facts[key], str) or not facts[key] for key in ADOPTION_STRINGS):
+        raise migration.AttemptMigrationError("incident_structure_invalid", "adoption_facts")
+
+
+def validate_incident_structure(record: Any) -> None:
+    try:
+        migration._require_keys(record, INCIDENT_KEYS, "incident_keys_mismatch")
+        if record["schema_version"] != INCIDENT_SCHEMA_VERSION:
+            raise migration.AttemptMigrationError("incident_schema_invalid")
+        if record["claims_not_made"] != INCIDENT_CLAIMS_NOT_MADE:
+            raise migration.AttemptMigrationError("incident_claims_invalid")
+        if record["normalized_incident_sha256"] != migration._canonical_digest(record, exclude="normalized_incident_sha256"):
+            raise migration.AttemptMigrationError("incident_digest_mismatch", "normalized_incident_sha256")
+        _structure_body(record)
+    except (KeyError, TypeError, ValueError) as exc:
+        raise migration.AttemptMigrationError("incident_structure_invalid", "exception") from exc
+
+
+def _committed_binding(root: Path, name: str, path: str) -> dict:
+    try:
+        return migration._require_committed_live(root, path)
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", exc.code) from exc
+
+
+def _bound_json(root: Path, bindings: Mapping, view: AttemptView, name: str) -> dict:
+    path = bindings[name + "_binding"]["path"]
+    try:
+        return migration._json_bytes(view.read(root, path), path)
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", "json_invalid") from exc
+
+
+def _lifecycle_mapping(record: Mapping, name: str, fields: tuple[str, ...], reason: str) -> Mapping:
+    value = record.get(name)
+    if not isinstance(value, Mapping) or any(not isinstance(value.get(key), str) for key in fields):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", reason)
+    return value
+
+
+def _owner_facts(record: Mapping) -> dict:
+    if record.get("schema_version") != "broad_failure_baseline_attestation.v1":
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "schema")
+    if record.get("evidence_status") != "owner_confirmed":
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "pending")
+    owner = _lifecycle_mapping(record, "owner", ("identity", "role"), "owner_missing")
+    if not owner["identity"] or not owner["role"]:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "owner_missing")
+    confirmation = _lifecycle_mapping(record, "owner_confirmations", ("confirmed_at",), "confirmation_missing")
+    adoption = _lifecycle_mapping(record, "owner_adoption", ("adopted_at",), "adoption_missing")
+    if adoption.get("identity") != owner["identity"]:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "adoption_identity_mismatch")
+    if broad_evidence.validate_record(record):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "record_invalid")
+    return {**ADOPTION_LITERALS, "owner_identity": owner["identity"], "owner_role": owner["role"], "confirmed_at": confirmation["confirmed_at"], "adopted_at": adoption["adopted_at"]}
+
+
+def _pending_identity(pending: Mapping, owner: Mapping) -> None:
+    if pending.get("schema_version") != "broad_failure_baseline_attestation.v1":
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid", "schema")
+    if pending.get("evidence_status") != "pending_owner_confirmation":
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid", "not_pending")
+    if broad_evidence.validate_record(pending):
+        raise migration.AttemptMigrationError("incident_pending_attestation_snapshot_binding_invalid", "record_invalid")
+    if set(pending) != set(owner) or any(pending[key] != owner[key] for key in pending if key not in LIFECYCLE_FIELDS):
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "non_lifecycle_field_changed")
+
+
+def _deep_record(root: Path, record: Mapping, name: str, view: AttemptView, state: Mapping) -> None:
+    historical = frozenset(
+        row[field] for row in state["status_projection"]["rows"]
+        for field in ("path", "source_path") if row[field] is not None
+    )
+    try:
+        issues = broad_evidence.validate_bound_record(record, root, bound_file_bytes=view.overlay(), require_committed_fallback=True, historical_status_paths=historical)
+    except (broad_evidence.ContractError, materialization.MaterializationError, source_bindings.SourceBindingError) as exc:
+        raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", str(exc)) from exc
+    if issues:
+        raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", ",".join(sorted({issue.code for issue in issues})))
+
+
+def _derive_semantics(
+    root: Path, *, bindings: Mapping, view: AttemptView, state: Mapping,
+    intended_predecessor_head: str,

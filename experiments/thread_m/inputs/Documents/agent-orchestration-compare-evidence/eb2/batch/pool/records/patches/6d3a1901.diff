+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import attempt_migration as migration
+from tests.retirement_adopted_attempt_fixture import make_adopted_attempt_repository
+from tests.test_retirement_attempt_migration import _canonical, _digest, _git, _review, _write
+
+
+def _capture(fixture: dict) -> dict:
+    options = {key: value for key, value in fixture.items() if key not in {
+        "root", "disposition_specification_review_path", "disposition_quality_review_path", "post_report_path",
+    }}
+    return migration.capture_invalidated_adopted(fixture["root"], **options)
+
+
+def test_capture_publishes_incident_then_disposition_with_closed_keys(tmp_path: Path) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    result = _capture(fixture)
+    assert set(result) == {"incident", "disposition"}
+    assert result["incident"]["schema_version"] == "attempt_migration_incident.v1"
+    disposition = result["disposition"]
+    assert disposition["schema_version"] == "attempt_migration_disposition.v2"
+    assert set(disposition) == {
+        "schema_version", "disposition", "governing_plan_binding", "migration_plan_binding",
+        "authority_review_bindings", "attempt_binding", "attempt_lifecycle", "pre_move_repository_state",
+        "protected_path_bindings", "ledger_lineage", "attempt_rows", "attempt_path_count",
+        "attempt_path_set_sha256", "archive_path_set_sha256", "normalized_row_set_sha256",
+        "normalized_disposition_sha256", "claims_not_made",
+    }
+    assert disposition["disposition"] == "archive_invalidated_owner_adopted_uncommitted_attempt_and_restore_tracked_files"
+    assert disposition["pre_move_repository_state"] == result["incident"]["pre_move_repository_state"]
+    assert set(disposition["attempt_binding"]["artifact_bindings"]) == {
+        "baseline", "baseline_specification_review", "baseline_quality_review", "workspace_baseline",
+        "attestation_request", "attestation_snapshot", "attestation_record",
+    }
+    lifecycle = disposition["attempt_lifecycle"]
+    assert {key: value for key, value in lifecycle.items() if key != "incident_binding"} == {
+        "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+        "invalidation_reason": "workspace_baseline_predecessor_mismatch",
+        "workspace_baseline_role": "workspace_baseline", "owner_attestation_role": "attestation_record",
+        "adoption_transfer": "forbidden",
+    }
+    assert disposition["claims_not_made"] == [
+        "The captured attempt was personally owner-adopted but remained uncommitted when its repository predecessor was invalidated.",
+        "Historical owner adoption remains bound only to the archived attempt and may not be transferred to or consumed by any later attestation, index, or completion claim.",
+        "Archival relocation preserves bytes but grants no mutation or completion authority.",
+        "A later attempt may begin only after the tracked live file equals its reviewed restoration binding.",
+    ]
+    for name in ("incident", "disposition"):
+        path = fixture["root"] / fixture[name + "_path"]
+        assert path.read_bytes() == _canonical(result[name]) + b"\n"
+        assert path.stat().st_mode & 0o777 == 0o644
+    assert (fixture["root"] / fixture["incident_path"]).stat().st_mtime_ns <= (fixture["root"] / fixture["disposition_path"]).stat().st_mtime_ns
+    assert migration.validate(fixture["root"], fixture["disposition_path"]) == disposition
+
+
+def _commit_reviews(fixture: dict) -> None:
+    root, path = fixture["root"], fixture["disposition_path"]
+    for kind, key in (("specification", "disposition_specification_review_path"), ("code_quality", "disposition_quality_review_path")):
+        _write(root, fixture[key], _review(kind, path, (root / path).read_bytes(), kind + "-reviewer", subject_kind="attempt_migration_disposition"))
+    _git(root, "add", "--", fixture["incident_path"], path, fixture["disposition_specification_review_path"], fixture["disposition_quality_review_path"])
+    _git(root, "commit", "-qm", "review exact adopted attempt disposition")
+
+
+def _apply(fixture: dict) -> dict:
+    return migration.apply(fixture["root"], fixture["disposition_path"], fixture["disposition_specification_review_path"], fixture["disposition_quality_review_path"])
+
+
+def _completed(fixture: dict) -> dict:
+    result = _capture(fixture)
+    _commit_reviews(fixture)
+    assert _apply(fixture) == result["disposition"]
+    return result
+
+
+def _status(root: Path) -> bytes:
+    return _git(root, "status", "--porcelain=v1", "-z", "--untracked-files=all")
+
+
+def _json(root: Path, path: str) -> dict:
+    return json.loads((root / path).read_bytes())
+
+
+def _redigest(record: dict, field: str) -> None:
+    record[field] = _digest(_canonical({key: value for key, value in record.items() if key != field}))
+
+
+def _save_disposition(fixture: dict, record: dict) -> None:
+    _redigest(record, "normalized_disposition_sha256")
+    _write(fixture["root"], fixture["disposition_path"], _canonical(record) + b"\n")
+
+
+def _rebind_archive(fixture: dict, result: dict, changes: dict[str, bytes], *, rebind_incident: bool = False) -> None:
+    incident, record = result["incident"], result["disposition"]
+    for path, data in changes.items():
+        row = next(row for row in record["attempt_rows"] if row["original_path"] == path)
+        _write(fixture["root"], row["archive_path"], data, row["lstat_mode"])
+        metadata = {"size": len(data), "sha256": _digest(data)}
+        row.update(metadata)
+        if rebind_incident:
+            next(row for row in incident["attempt_rows"] if row["path"] == path).update(metadata)
+        bindings = [*record["attempt_binding"]["artifact_bindings"].values(), *record["ledger_lineage"]["generation_11"].values()]
+        for binding in bindings:
+            if isinstance(binding, dict) and binding.get("path") == path:
+                binding.update(metadata)
+        for key, binding in incident.items():
+            if rebind_incident and key.endswith("_binding") and binding["path"] == path:
+                binding.update(metadata)
+    if rebind_incident:
+        incident["normalized_attempt_row_set_sha256"] = _digest(_canonical(incident["attempt_rows"]))
+        _redigest(incident, "normalized_incident_sha256")
+        data = _canonical(incident) + b"\n"
+        _write(fixture["root"], fixture["incident_path"], data)
+        record["attempt_lifecycle"]["incident_binding"].update(size=len(data), sha256=_digest(data))
+    record["normalized_row_set_sha256"] = _digest(_canonical(record["attempt_rows"]))
+    _save_disposition(fixture, record)
+
+
+def _assert_no_outputs(fixture: dict) -> None:
+    assert not (fixture["root"] / fixture["incident_path"]).exists()
+    assert not (fixture["root"] / fixture["disposition_path"]).exists()
+
+
+def test_capture_replay_returns_same_result_and_changes_nothing(tmp_path: Path) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    result = _capture(fixture)
+    before = [(fixture["root"] / fixture[name + "_path"]).read_bytes() for name in ("incident", "disposition")]
+    status = _status(fixture["root"])
+    assert _capture(fixture) == result
+    assert before == [(fixture["root"] / fixture[name + "_path"]).read_bytes() for name in ("incident", "disposition")]
+    assert _status(fixture["root"]) == status
+
+
+def test_capture_completes_after_crash_between_publications(tmp_path: Path) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    result = _capture(fixture)
+    (fixture["root"] / fixture["disposition_path"]).unlink()
+    assert _capture(fixture) == result
+
+
+def test_capture_rejects_one_byte_different_incident(tmp_path: Path) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    _capture(fixture)
+    (fixture["root"] / fixture["disposition_path"]).unlink()
+    path = fixture["root"] / fixture["incident_path"]
+    path.write_bytes(path.read_bytes() + b" ")
+    with pytest.raises(migration.AttemptMigrationError, match="incident_output_conflict"):
+        _capture(fixture)
+    assert not (fixture["root"] / fixture["disposition_path"]).exists()
+
+
+def test_capture_rejects_disposition_without_incident(tmp_path: Path) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    _write(fixture["root"], fixture["disposition_path"], b"{}\n")
+    with pytest.raises(migration.AttemptMigrationError, match="disposition_without_incident"):
+        _capture(fixture)
+
+
+@pytest.mark.parametrize("state", ["staged", "committed", "rename"])
+def test_capture_rejects_tracked_staged_or_renamed_incident_path(tmp_path: Path, state: str) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    _capture(fixture)

+
+def _manifest(root: Path, path: str, state: Mapping, source_root: str) -> tuple[dict, list[str]]:
+    snapshot = _committed_binding(root, "expected_paths_manifest", path)
+    paths = migration._manifest_paths(snapshot["data"], path)
+    if any(not migration._under(path, source_root) for path in paths):

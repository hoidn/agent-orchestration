+def _baseline_authority(root, outcome):
+    from tests.test_retirement_broad_evidence import (
+        _PRODUCER_FAILURE_NODE_IDS, _publish_producer_review_pair, _write_producer_json)
+    path = _write_producer_json(root, 'evidence/implementation-baseline/outcome.json', outcome)
+    baseline = broad.build_broad_known_failure_baseline(repository_root=root,
+        broad_outcome_path=path.relative_to(root), ownership_classifications=[
+            {'node_id': node, 'ownership_class': 'queue_owned', 'ownership_basis': ['source.py'],
+             'authorized_remediation_scope': ['source.py']} for node in _PRODUCER_FAILURE_NODE_IDS])
+    baseline_path = _write_producer_json(root, 'evidence/implementation-baseline/known-failure-baseline.json', baseline)
+    spec, quality = _publish_producer_review_pair(root, evidence_root=Path('evidence'),
+        subject_path=baseline_path.relative_to(root), subject_kind='implementation_failure_baseline',
+        specification_name='reviews/implementation-baseline-specification.json',
+        quality_name='reviews/implementation-baseline-quality.json')
+    from orchestrator.retirement.materialization import materialize_pending
+    receipt = materialize_pending(repository_root=root, evidence_root=Path('evidence'),
+        record_kind='broad-failure-baseline-attestation',
+        output_path=Path('evidence/attestations/pre-implementation/broad-failure-baseline.json'), generation=1,
+        input_paths={'baseline': baseline_path.relative_to(root),
+                     'specification_review': Path(spec['logical_path']), 'quality_review': Path(quality['logical_path'])},
+        parameters={'prepared_by': {'identity': 'fixture-writer'}, 'prepared_at': '2026-01-01T00:00:00+00:00'})
+    attestation_path = root / receipt.output_path
+    attestation = json.loads(attestation_path.read_bytes())
+    attestation['evidence_status'] = 'owner_confirmed'
+    attestation['owner'] = {'identity': 'Fixture Owner', 'role': 'owner'}
+    attestation['owner_confirmations'] = {key: '2026-01-01T00:00:00+00:00' if key == 'confirmed_at' else True
+                                         for key in attestation['owner_confirmations']}
+    attestation['owner_adoption'] = {'identity': 'Fixture Owner', 'adopted_at': '2026-01-01T00:00:00+00:00',
+                                    'statement': 'I personally adopt this exact baseline for comparison only.'}
+    attestation_path.write_bytes(_json(attestation))
+    def binding(p):
+        return {'path': p.relative_to(root).as_posix(), 'sha256': broad.file_sha256(p)}
+    return {'outcome': binding(path), 'record': binding(baseline_path),
+            'owner_attestation': binding(attestation_path), 'specification_review': spec, 'quality_review': quality}

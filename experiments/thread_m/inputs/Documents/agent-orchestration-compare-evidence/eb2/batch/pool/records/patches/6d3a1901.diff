+def _generation5_ancestor(root: Path, view: AttemptView, request_path: str, generation5: Mapping) -> bool:
+    expected = {
+        "request_path": generation5["request_binding"]["path"],
+        "request_sha256": generation5["request_binding"]["sha256"],
+        "snapshot_path": generation5["snapshot_binding"]["path"],
+        "snapshot_sha256": generation5["snapshot_binding"]["sha256"],
+    }
+    for generation in range(11, 5, -1):
+        request = migration._json_bytes(view.read(root, request_path), request_path)
+        if request.get("generation") != generation:
+            return False
+        prior = request["prior_generation_binding"]
+        if generation == 6:
+            return {key: prior[key] for key in expected} == expected
+        request_path = prior["request_path"]
+    return False

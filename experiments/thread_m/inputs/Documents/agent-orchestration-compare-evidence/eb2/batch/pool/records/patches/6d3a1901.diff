+    workspace = _bound_json(root, bindings, view, "workspace_baseline")
+    if workspace.get("schema_version") != "workspace_baseline.v1":
+        raise migration.AttemptMigrationError("incident_workspace_baseline_binding_invalid", "schema")
+    if source_bindings.validate_workspace_record_shape(workspace):
+        raise migration.AttemptMigrationError("incident_workspace_baseline_binding_invalid", "shape_invalid")
+    try:
+        projection = source_bindings.derive_committed_predecessor_lineage(root, baseline_head=workspace["head"], intended_predecessor_head=intended_predecessor_head, require_uncovered_paths=True)
+    except source_bindings.SourceBindingError as exc:
+        raise migration.AttemptMigrationError("incident_predecessor_lineage_invalid", str(exc)) from exc
+    owner = _bound_json(root, bindings, view, "owner_attestation")
+    facts = _owner_facts(owner)
+    _pending_identity(_bound_json(root, bindings, view, "pending_attestation_snapshot"), owner)
+    baseline_binding = bindings["known_failure_baseline_binding"]
+    if any(owner["baseline_binding"][key] != baseline_binding[key] for key in ("path", "sha256")):
+        raise migration.AttemptMigrationError("incident_owner_attestation_binding_invalid", "baseline_binding_mismatch")
+    baseline = _bound_json(root, bindings, view, "known_failure_baseline")
+    if baseline.get("schema_version") != "broad_known_failure_baseline.v1":
+        raise migration.AttemptMigrationError("incident_known_failure_baseline_binding_invalid", "schema")
+    _deep_record(root, baseline, "known_failure_baseline", view, state)
+    _deep_record(root, owner, "owner_attestation", view, state)
+    return projection, facts
+
+
+def _require_head_lineage(root: Path, state: Mapping, intended_predecessor_head: str) -> None:
+    tree = migration._git(root, "rev-parse", state["head"] + "^{tree}").decode("ascii").strip()
+    if tree != state["tree"]:
+        raise migration.AttemptMigrationError("capture_head_tree_mismatch")
+    if not migration._git_is_ancestor(root, state["head"], "HEAD"):
+        raise migration.AttemptMigrationError("capture_head_not_ancestor")
+    if not migration._git_is_ancestor(root, intended_predecessor_head, state["head"]):

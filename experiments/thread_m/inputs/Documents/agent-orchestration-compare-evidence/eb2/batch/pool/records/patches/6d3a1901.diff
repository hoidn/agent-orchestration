+def _completed(root):
+    candidate, binding, bootstrap = _producer_task1_candidate_ledger_and_bootstrap(root)
+    for _ in range(2):
+        _, receipt = _advance_bound_ledger(root, binding)
+        binding = _ledger_binding(receipt)
+    directory = Path('evidence/implementation-commits/task-01-bootstrap')
+    _, receipt = _advance_bound_ledger(root, binding, future_paths=[
+        (directory / 'specification-review.json').as_posix(),
+        (directory / 'quality-review.json').as_posix()])
+    binding = _ledger_binding(receipt)
+    subject, spec, quality = _producer_bootstrap_subject_and_reviews(
+        root, candidate=candidate, ledger=binding, bootstrap=bootstrap)
+    evidence = sorted([{'path': path.as_posix(), 'sha256': broad.file_sha256(root / path)}
+                       for path in (subject, Path(spec['logical_path']), Path(quality['logical_path']))],
+                      key=lambda row: row['path'])
+    _, receipt = _advance_bound_ledger(root, binding, evidence_bindings=evidence)
+    overlay = {path: (root / path).read_bytes() for path in (
+        subject.as_posix(), spec['logical_path'], quality['logical_path'],
+        spec['immutable_path'], quality['immutable_path'])}
+    for path in overlay:
+        (root / path).chmod(0o644)
+        (root / path).write_bytes(b'invalid live bytes\n')
+    return receipt, overlay, spec, quality

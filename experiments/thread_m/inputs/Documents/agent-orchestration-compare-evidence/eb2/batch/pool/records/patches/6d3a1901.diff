+"""Byte overlays preserve the production generation and evidence contracts."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import broad_evidence as broad
+from orchestrator.retirement.materialization import validate_generation, validate_generation_binding_current
+from tests.test_retirement_broad_evidence import (
+    _producer_task1_candidate_ledger_and_bootstrap, _advance_bound_ledger,
+    _ledger_binding, _producer_bootstrap_subject_and_reviews,
+    _materialize_first_ledger, _materialize_next_ledger,
+    _initialize_candidate_repository, _git_output,
+)
+
+
+def test_overlay_supplies_deleted_live_generation(tmp_path: Path) -> None:
+    _, _, receipt = _materialize_first_ledger(tmp_path)
+    overlay = {path.as_posix(): (tmp_path / path).read_bytes()
+               for path in (receipt.request_path, receipt.snapshot_path)}
+    for path in overlay:
+        (tmp_path / path).unlink()
+    assert validate_generation(tmp_path, receipt.request_path, receipt.snapshot_path,
+                               bound_file_bytes=overlay) == []
+
+
+def _digest(data: bytes) -> str:
+    return 'sha256:' + hashlib.sha256(data).hexdigest()
+
+
+def _json(data: object) -> bytes:
+    return json.dumps(data, sort_keys=True, indent=2, ensure_ascii=False).encode() + b'\n'
+
+
+def _chain(root: Path):
+    _initialize_candidate_repository(root)
+    _, record, first = _materialize_first_ledger(root)
+    record, second = _materialize_next_ledger(root, record, first)
+    _, third = _materialize_next_ledger(root, record, second)
+    overlay = {p.relative_to(root).as_posix(): p.read_bytes()
+               for p in (root / 'evidence').rglob('*') if p.is_file()}
+    for path in overlay:
+        (root / path).unlink()
+    return first, second, third, overlay
+
+
+def _check(root, receipt, overlay):
+    return validate_generation(root, receipt.request_path, receipt.snapshot_path,
+                               bound_file_bytes=overlay)
+
+
+def test_missing_overlay_ancestor_reports_prior_generation_changed(tmp_path: Path) -> None:
+    first, _, third, overlay = _chain(tmp_path)
+    del overlay[first.request_path.as_posix()]
+    assert broad.Issue('prior_generation_invalid', message='prior_generation_changed') in _check(tmp_path, third, overlay)
+
+
+def test_swapped_overlay_ancestor_reports_prior_generation_changed(tmp_path: Path) -> None:
+    first, _, third, overlay = _chain(tmp_path)
+    overlay[first.request_path.as_posix()], overlay[first.snapshot_path.as_posix()] = (
+        overlay[first.snapshot_path.as_posix()], overlay[first.request_path.as_posix()])
+    assert broad.Issue('prior_generation_invalid', message='prior_generation_changed') in _check(tmp_path, third, overlay)
+
+
+def _replace_request(overlay, old, request):
+    request['normalized_request_sha256'] = broad.canonical_sha256(request, exclude={'normalized_request_sha256'})
+    path = old.with_name(f"{request['generation']:08d}-{request['normalized_request_sha256'][7:]}.json")
+    del overlay[old.as_posix()]
+    overlay[path.as_posix()] = _json(request)
+    return path
+
+
+def _rebind_ancestor(root, mutation):
+    first, second, third, overlay = _chain(root)
+    ancestor = json.loads(overlay[second.request_path.as_posix()])
+    mutation(ancestor, overlay, first)
+    new_ancestor = _replace_request(overlay, second.request_path, ancestor)
+    return _rebind_child(root, third, overlay, new_ancestor, second.snapshot_path)
+
+
+def _rebind_child(root, third, overlay, ancestor_request, ancestor_snapshot):
+    request = json.loads(overlay[third.request_path.as_posix()])
+    prior = request['prior_generation_binding']
+    prior['request_path'] = ancestor_request.as_posix()
+    prior['request_sha256'] = _digest(overlay[ancestor_request.as_posix()])
+    prior['snapshot_path'] = ancestor_snapshot.as_posix()
+    prior['snapshot_sha256'] = _digest(overlay[ancestor_snapshot.as_posix()])
+    record = request['parameters']['record']
+    record['last_transition']['prior_generation_binding'] = dict(prior)
+    record['normalized_ledger_sha256'] = broad.canonical_sha256(record, exclude={'normalized_ledger_sha256'})
+    snapshot_bytes = _json(record)
+    snapshot = third.snapshot_path.with_name(f"{third.generation:08d}-{_digest(snapshot_bytes)[7:]}.json")
+    del overlay[third.snapshot_path.as_posix()]
+    overlay[snapshot.as_posix()] = snapshot_bytes
+    new_request = _replace_request(overlay, third.request_path, request)
+    return validate_generation(root, new_request, snapshot, bound_file_bytes=overlay)
+
+
+def test_noncontiguous_overlay_ancestor_reports_request_prior_generation_invalid(tmp_path: Path) -> None:
+    def mutate(request, overlay, first):
+        request['prior_generation_binding']['generation'] = 0
+    issues = _rebind_ancestor(tmp_path, mutate)
+    assert broad.Issue('prior_generation_invalid', message='request_prior_generation_invalid') in issues
+
+
+@pytest.mark.parametrize('coordinate,code', [('request', 'request_path_mismatch'), ('snapshot', 'snapshot_path_mismatch')])
+def test_wrong_parent_overlay_ancestor_reports_path_mismatch(tmp_path: Path, coordinate, code) -> None:
+    _, second, third, overlay = _chain(tmp_path)
+    old = second.request_path if coordinate == 'request' else second.snapshot_path
+    wrong = old.parent.with_name('0' * 64) / old.name
+    overlay[wrong.as_posix()] = overlay.pop(old.as_posix())
+    issues = _rebind_child(tmp_path, third, overlay,
+        wrong if coordinate == 'request' else second.request_path,
+        wrong if coordinate == 'snapshot' else second.snapshot_path)
+    assert broad.Issue('prior_generation_invalid', message=code) in issues
+

@@ -0,0 +1,400 @@
+"""Incident contract owned by artifacts/design/adopted-attempt-predecessor-recovery.md."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping
+
+from . import attempt_migration as migration, broad_evidence, materialization, source_bindings
+from .attempt_view import AttemptView, view_from_incident_rows
+
+
+INCIDENT_SCHEMA_VERSION = "attempt_migration_incident.v1"
+BINDING_NAMES = (
+    "governing_plan", "migration_plan", "expected_paths_manifest", "workspace_baseline",
+    "owner_attestation", "pending_attestation_snapshot", "known_failure_baseline",
+)
+ATTEMPT_FILE_BINDINGS = BINDING_NAMES[-4:]
+LIFECYCLE_FIELDS = ("evidence_status", "owner", "owner_confirmations", "owner_adoption")
+INCIDENT_ROW_KEYS = {"path", "file_type", "lstat_mode", "size", "sha256", "tracked_state"}
+INCIDENT_CLAIMS_NOT_MADE = [
+    "This incident makes no claim that the bound uncommitted attempt was sealed because its recorded workspace-baseline HEAD does not equal the intended commit predecessor."
+]
+INCIDENT_KEYS = {
+    "schema_version", *(name + "_binding" for name in BINDING_NAMES), "source_root",
+    "intended_predecessor", "predecessor_projection", "pre_move_repository_state",
+    "attempt_rows", "attempt_path_count", "attempt_path_set_sha256",
+    "normalized_attempt_row_set_sha256", "adoption_facts", "normalized_incident_sha256",
+    "claims_not_made",
+}
+ADOPTION_LITERALS = {
+    "adoption_state": "owner_adopted", "repository_commit_state": "uncommitted",
+    "evidence_status": "owner_confirmed",
+}
+ADOPTION_STRINGS = ("owner_identity", "owner_role", "confirmed_at", "adopted_at")
+PROJECTION_KEYS = {
+    "baseline_head", "intended_predecessor_head", "intended_predecessor_tree",
+    "first_parent_commits", "commit_count", "changed_paths", "changed_path_count",
+    "changed_path_set_sha256", "controlled_paths", "controlled_path_set_sha256",
+    "uncovered_paths", "uncovered_path_set_sha256", "normalized_projection_sha256",
+}
+PROJECTION_ROW_KEYS = {
+    "commit", "parent", "tree", "raw_message_sha256", "changed_paths",
+    "changed_path_set_sha256", "control_coordinates",
+}
+
+
+def _binding_shape(name: str, binding: Any) -> None:
+    try:
+        if name == "expected_paths_manifest":
+            if set(binding) != {"path", "size", "sha256", "row_count"}:
+                raise ValueError
+            if type(binding["row_count"]) is not int or binding["row_count"] < 1:
+                raise ValueError
+            binding = {key: binding[key] for key in ("path", "size", "sha256")}
+        migration._validate_file_binding(binding, full=False)
+    except (migration.AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+        raise migration.AttemptMigrationError("incident_structure_invalid", name + "_binding") from exc
+
+
+def _rows_shape(rows: Any, source_root: str) -> list[str]:
+    try:
+        if not isinstance(rows, list) or not rows:
+            raise ValueError
+        for row in rows:
+            _row_shape(row, source_root)
+        paths = [row["path"] for row in rows]
+        if paths != sorted(set(paths)):
+            raise ValueError
+        return paths
+    except (migration.AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+        raise migration.AttemptMigrationError("incident_structure_invalid", "attempt_rows") from exc
+
+
+def _row_shape(row: Any, source_root: str) -> None:
+    if not isinstance(row, Mapping) or set(row) != INCIDENT_ROW_KEYS:
+        raise ValueError
+    migration._validate_file_binding({key: row[key] for key in row if key != "tracked_state"})
+    if row["tracked_state"] not in {"modified", "untracked"}:
+        raise ValueError
+    if not migration._under(row["path"], source_root):
+        raise ValueError
+
+
+def _projection_paths(value: Any) -> list[str]:
+    if not isinstance(value, list) or value != sorted(set(value)):
+        raise ValueError
+    for path in value:
+        migration._relative_path(path)
+    return value
+
+
+def _projection_row(row: Any) -> None:
+    if not isinstance(row, Mapping) or set(row) != PROJECTION_ROW_KEYS:
+        raise ValueError
+    if not all(migration._is_commit_identity(row[key]) for key in ("commit", "parent", "tree")):
+        raise ValueError
+    if not migration._is_sha256(row["raw_message_sha256"]):
+        raise ValueError
+    paths = _projection_paths(row["changed_paths"])
+    if row["changed_path_set_sha256"] != source_bindings._path_list_digest(paths):
+        raise ValueError
+    coordinates = row["control_coordinates"]
+    if coordinates is not None:
+        migration._require_keys(coordinates, {"transaction_id", "normalized_control_sha256"}, "invalid")
+        if not migration._is_sha256("sha256:" + coordinates["transaction_id"]):
+            raise ValueError
+        if not migration._is_sha256(coordinates["normalized_control_sha256"]):
+            raise ValueError
+
+
+def _projection_shape(projection: Any) -> None:
+    try:
+        migration._require_keys(projection, PROJECTION_KEYS, "invalid")
+        if not all(migration._is_commit_identity(projection[key]) for key in (
+            "baseline_head", "intended_predecessor_head", "intended_predecessor_tree"
+        )):
+            raise ValueError
+        rows = projection["first_parent_commits"]
+        if not isinstance(rows, list) or type(projection["commit_count"]) is not int or projection["commit_count"] != len(rows):
+            raise ValueError
+        for row in rows:
+            _projection_row(row)

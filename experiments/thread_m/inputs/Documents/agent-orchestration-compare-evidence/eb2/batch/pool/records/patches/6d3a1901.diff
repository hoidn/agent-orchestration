+        if projection["normalized_projection_sha256"] != migration._canonical_digest(projection, exclude="normalized_projection_sha256"):
+            raise ValueError
+    except (migration.AttemptMigrationError, KeyError, TypeError, ValueError) as exc:
+        raise migration.AttemptMigrationError("incident_digest_mismatch", "predecessor_projection") from exc

+    record = {
+        "schema_version": INCIDENT_SCHEMA_VERSION, **bindings, "source_root": source_root,
+        "intended_predecessor": {"head": intended_predecessor_head, "tree": projection["intended_predecessor_tree"]},
+        "predecessor_projection": projection, "pre_move_repository_state": state, "attempt_rows": rows,
+        "attempt_path_count": len(rows), "attempt_path_set_sha256": migration._canonical_digest(expected),
+        "normalized_attempt_row_set_sha256": migration._canonical_digest(rows), "adoption_facts": facts,
+        "claims_not_made": list(INCIDENT_CLAIMS_NOT_MADE),
+    }
+    record["normalized_incident_sha256"] = migration._canonical_digest(record, exclude="normalized_incident_sha256")
+    validate_incident_structure(record)
+    return record
+
+
+def _build_bindings(root: Path, paths: Mapping, rows: list, manifest: Mapping) -> dict:
+    bindings = {}
+    by_path = {row["path"]: row for row in rows}
+    for name in BINDING_NAMES:
+        if name in ATTEMPT_FILE_BINDINGS:
+            if paths[name] not in by_path:
+                raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", "not_attempt_row")
+            snapshot = by_path[paths[name]]
+        else:
+            snapshot = manifest if name == "expected_paths_manifest" else _committed_binding(root, name, paths[name])
+        bindings[name + "_binding"] = migration._content_binding(snapshot)
+    bindings["expected_paths_manifest_binding"]["row_count"] = len(rows)
+    return bindings
+
+
+def _validate_live_bindings(root: Path, record: Mapping, view: AttemptView) -> None:
+    for name in BINDING_NAMES:
+        binding = record[name + "_binding"]
+        if name in ATTEMPT_FILE_BINDINGS:
+            entry = view.entry(binding["path"])
+            if entry is None:
+                raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", "row_unavailable")
+            if binding["path"] not in {row["path"] for row in record["attempt_rows"]}:
+                raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid", "not_attempt_row")
+            if (entry.size, entry.sha256) != (binding["size"], binding["sha256"]):
+                raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid")
+        else:
+            snapshot = _committed_binding(root, name, binding["path"])
+            if any(snapshot[key] != binding[key] for key in ("path", "size", "sha256")):
+                raise migration.AttemptMigrationError(f"incident_{name}_binding_invalid")
+            _manifest_rows_match(name, snapshot, binding, record["attempt_rows"])
+
+
+def _manifest_rows_match(name: str, snapshot: Mapping, binding: Mapping, rows: list) -> None:
+    if name == "expected_paths_manifest":
+        if migration._manifest_paths(snapshot["data"], binding["path"]) != [row["path"] for row in rows]:
+            raise migration.AttemptMigrationError("incident_expected_paths_manifest_binding_invalid", "rows_mismatch")
+
+
+def validate_incident_live(root: Path, record: Mapping, view: AttemptView) -> None:
+    _require_head_lineage(root, record["pre_move_repository_state"], record["intended_predecessor"]["head"])
+    _validate_live_bindings(root, record, view)
+    view.require_all()
+    projection, facts = _derive_semantics(root, bindings=record, view=view, state=record["pre_move_repository_state"], intended_predecessor_head=record["intended_predecessor"]["head"])
+    if projection != record["predecessor_projection"]:
+        raise migration.AttemptMigrationError("incident_predecessor_projection_mismatch")
+    if facts != record["adoption_facts"]:
+        raise migration.AttemptMigrationError("incident_owner_lifecycle_invalid", "adoption_facts_mismatch")
+
+
+def validate_incident(repository_root: Path | str, record: Mapping) -> Mapping:
+    validate_incident_structure(record)
+    root = migration._repository_root(repository_root)
+    validate_incident_live(root, record, view_from_incident_rows(root, record["attempt_rows"]))
+    return record

diff --git a/orchestrator/retirement/source_bindings.py b/orchestrator/retirement/source_bindings.py
index e98a799..9208cb4 100644
--- a/orchestrator/retirement/source_bindings.py
+++ b/orchestrator/retirement/source_bindings.py
@@ -2051,6 +2051,132 @@ def _trailer_coordinates(message: bytes) -> tuple[str, str] | None:
     return matches[0].group(1).decode("ascii"), "sha256:" + matches[0].group(2).decode("ascii")
 
 
+
+def _commit_object(root: Path, commit: str) -> tuple[str, list[str], bytes]:
+    try:
+        raw = _git(root, "cat-file", "commit", commit)
+        header, message = raw.split(b"\n\n", 1)
+        trees = [line[5:] for line in header.splitlines() if line.startswith(b"tree ")]
+        parents = [line[7:] for line in header.splitlines() if line.startswith(b"parent ")]
+        if len(trees) != 1 or any(
+            re.fullmatch(rb"[0-9a-f]{40}", oid) is None for oid in [*trees, *parents]
+        ):
+            raise ValueError("malformed commit header")
+        return trees[0].decode("ascii"), [oid.decode("ascii") for oid in parents], message
+    except (SourceBindingError, ValueError) as exc:
+        raise SourceBindingError(f"predecessor_object_missing:{commit}") from exc
+
+
+def _commit_changed_paths(root: Path, parent: str, commit: str) -> list[str]:
+    try:
+        raw = _git(root, "diff-tree", "-r", "-z", "--no-commit-id", "--name-only", "--no-renames", parent, commit)
+    except SourceBindingError as exc:
+        raise SourceBindingError(f"predecessor_object_missing:{commit}") from exc
+    paths = [_decode_path(field) for field in raw.removesuffix(b"\0").split(b"\0")] if raw else []
+    if len(paths) != len(set(paths)):
+        raise SourceBindingError(f"predecessor_changed_path_duplicate:{commit}")
+    return sorted(paths)
+
+
+def _control_coordinates(message: bytes, commit: str) -> dict[str, str] | None:
+    if b"Retirement-Control-" not in message:
+        return None
+    match = re.fullmatch(
+        rb"(?s)(.*\n)\nRetirement-Control-Schema: precommit_control\.v1\n"
+        rb"Retirement-Transaction-ID: ([0-9a-f]{64})\n"
+        rb"Retirement-Control-SHA256: ([0-9a-f]{64})\n",
+        message,
+    )
+    if match is None or not _base_message_bytes_valid(match.group(1)):
+        raise SourceBindingError(f"commit_control_trailer_invalid:{commit}")
+    return {
+        "transaction_id": match.group(2).decode("ascii"),
+        "normalized_control_sha256": "sha256:" + match.group(3).decode("ascii"),
+    }
+
+
+def _predecessor_commits(root: Path, baseline_head: str, intended_predecessor_head: str) -> list[str]:
+    for field, value in (("baseline_head", baseline_head), ("intended_predecessor_head", intended_predecessor_head)):
+        if not isinstance(value, str) or _HEX40_RE.fullmatch(value) is None:
+            raise SourceBindingError(f"predecessor_commit_invalid:{field}")
+        try:
+            kind = _git(root, "cat-file", "-t", value).strip()
+        except SourceBindingError as exc:
+            raise SourceBindingError(f"predecessor_commit_missing:{field}") from exc
+        if kind != b"commit":
+            raise SourceBindingError(f"predecessor_commit_missing:{field}")
+    ancestry = subprocess.run(
+        ["git", "merge-base", "--is-ancestor", baseline_head, intended_predecessor_head],
+        cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    if ancestry.returncode == 1:
+        raise SourceBindingError("predecessor_baseline_not_ancestor")
+    if ancestry.returncode != 0:
+        raise SourceBindingError("predecessor_object_missing:merge-base")
+    try:
+        commits = _git(root, "rev-list", "--first-parent", "--reverse", f"{baseline_head}..{intended_predecessor_head}").decode("ascii").splitlines()
+    except SourceBindingError as exc:
+        raise SourceBindingError(f"predecessor_object_missing:{intended_predecessor_head}") from exc
+    return commits
+
+
+def _predecessor_rows(
+    root: Path, commits: Sequence[str], baseline_head: str, intended_predecessor_head: str
+) -> tuple[list[dict[str, Any]], set[str], set[str]]:
+    previous = baseline_head
+    rows: list[dict[str, Any]] = []
+    controlled: set[str] = set()
+    uncovered: set[str] = set()
+    for commit in commits:
+        tree, parents, message = _commit_object(root, commit)
+        if len(parents) != 1:
+            raise SourceBindingError(f"predecessor_range_contains_merge:{commit}")
+        if parents[0] != previous:
+            raise SourceBindingError(f"predecessor_lineage_discontinuous:{commit}")
+        paths = _commit_changed_paths(root, parents[0], commit)
+        coordinates = _control_coordinates(message, commit)
+        rows.append({
+            "commit": commit, "parent": parents[0], "tree": tree,
+            "raw_message_sha256": _sha256_bytes(message), "changed_paths": paths,
+            "changed_path_set_sha256": _path_list_digest(paths), "control_coordinates": coordinates,
+        })
+        (controlled if coordinates is not None else uncovered).update(paths)
+        previous = commit
+    if commits and previous != intended_predecessor_head:
+        raise SourceBindingError(f"predecessor_lineage_discontinuous:{intended_predecessor_head}")
+    return rows, controlled, uncovered
+
+
+def derive_committed_predecessor_lineage(
+    repository_root: Path | str,
+    *,
+    baseline_head: str,
+    intended_predecessor_head: str,
+    require_uncovered_paths: bool = False,
+) -> dict[str, Any]:
+    """Project the closed first-parent range and its retirement-control coverage."""
+    root = _repository_root(repository_root)
+    commits = _predecessor_commits(root, baseline_head, intended_predecessor_head)
+    rows, controlled, uncovered = _predecessor_rows(root, commits, baseline_head, intended_predecessor_head)
+    try:
+        intended_tree = rows[-1]["tree"] if rows else _git(root, "rev-parse", intended_predecessor_head + "^{tree}").decode("ascii").strip()
+    except SourceBindingError as exc:
+        raise SourceBindingError(f"predecessor_object_missing:{intended_predecessor_head}") from exc
+    changed = sorted(controlled | uncovered)
+    projection = {
+        "baseline_head": baseline_head, "intended_predecessor_head": intended_predecessor_head,
+        "intended_predecessor_tree": intended_tree, "first_parent_commits": rows,
+        "commit_count": len(rows), "changed_paths": changed, "changed_path_count": len(changed),
+        "changed_path_set_sha256": _path_list_digest(changed),
+        "controlled_paths": sorted(controlled), "controlled_path_set_sha256": _path_list_digest(controlled),
+        "uncovered_paths": sorted(uncovered), "uncovered_path_set_sha256": _path_list_digest(uncovered),
+    }
+    projection["normalized_projection_sha256"] = _canonical_sha256(projection, exclude={"normalized_projection_sha256"})
+    if require_uncovered_paths and not uncovered:
+        raise SourceBindingError("predecessor_uncovered_paths_missing")
+    return projection
+
+
 def _prior_trailers(root: Path, baseline_head: str, base_head: str) -> list[dict[str, str]]:
     if baseline_head == base_head:
         return []

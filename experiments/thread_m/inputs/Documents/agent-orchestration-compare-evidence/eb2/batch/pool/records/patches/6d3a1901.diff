+    if state == "rename":
+        (fixture["root"] / fixture["incident_path"]).unlink()
+        _git(fixture["root"], "mv", "--", "authority/expected-paths.txt", fixture["incident_path"])
+    else:
+        _git(fixture["root"], "add", "--", fixture["incident_path"])
+        if state == "committed":
+            _git(fixture["root"], "commit", "-qm", "committed incident")
+    with pytest.raises(migration.AttemptMigrationError, match="incident_output_path_invalid"):
+        _capture(fixture)
+    assert not (fixture["root"] / fixture["disposition_path"]).exists()
+
+
+def test_capture_rejects_recovery_with_additional_untracked_path(tmp_path: Path) -> None:
+    fixture = make_adopted_attempt_repository(tmp_path)
+    _capture(fixture)
+    (fixture["root"] / fixture["disposition_path"]).unlink()
+    _write(fixture["root"], "extra.txt", b"additional untracked path\n")
+    with pytest.raises(migration.AttemptMigrationError, match="incident_recovery_state_invalid"):
+        _capture(fixture)
+    assert not (fixture["root"] / fixture["disposition_path"]).exists()

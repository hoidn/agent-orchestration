+"""Capture owned by artifacts/design/adopted-attempt-predecessor-recovery.md."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from . import attempt_incident, attempt_migration as migration, attempt_migration_v2 as v2
+from . import broad_evidence, materialization, source_bindings
+
+
+def _read_output(root: Path, path: str, code: str) -> Mapping | None:
+    try:
+        return migration._read_regular(root, path, missing_ok=True)
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError(code) from exc
+
+
+def _require_sole_untracked_output(root: Path, state: Mapping, path: str, code: str) -> None:
+    rows = [row for row in state["status_projection"]["rows"]
+            if path in (row["path"], row["source_path"])]
+    committed = subprocess.run(
+        ["git", "cat-file", "-e", f"HEAD:{path}"], cwd=root,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    if rows != [{"path": path, "source_path": None, "status": "??"}] or migration._is_tracked(root, path) or committed.returncode == 0:
+        raise migration.AttemptMigrationError(code)
+
+
+def _validate_output_paths(options: Mapping) -> None:
+    source, archive = options["source_root"], options["archive_root"]
+    if migration._under(source, archive) or migration._under(archive, source):
+        raise migration.AttemptMigrationError("source_archive_roots_overlap")
+    for key in ("incident_path", "disposition_path"):
+        migration._reject_output_overlap(options[key], source, archive)
+        if migration._under(source, options[key]) or migration._under(archive, options[key]):
+            raise migration.AttemptMigrationError("output_path_overlaps_migration", options[key])
+    if migration._under(options["incident_path"], options["disposition_path"]) or migration._under(options["disposition_path"], options["incident_path"]):
+        raise migration.AttemptMigrationError("output_paths_alias")
+
+
+def _capture_state(root: Path, options: Mapping) -> tuple[dict, Mapping | None, Mapping | None]:
+    _validate_output_paths(options)
+    archive = options["archive_root"]
+    if migration._scan_regular_files(root, archive):
+        raise migration.AttemptMigrationError("archive_not_empty", archive)
+    incident = _read_output(root, options["incident_path"], "incident_output_path_invalid")
+    disposition = _read_output(root, options["disposition_path"], "disposition_output_path_invalid")
+    if disposition is not None and incident is None:
+        raise migration.AttemptMigrationError("disposition_without_incident")
+    state = migration._repository_state(root)
+    ignored = []
+    for key, snapshot in (("incident_path", incident), ("disposition_path", disposition)):
+        if snapshot is not None:
+            path = options[key]
+            _require_sole_untracked_output(root, state, path, key.replace("_path", "_output_path_invalid"))
+            ignored.append(path)
+    return migration._state_without_paths(state, set(ignored)), incident, disposition
+
+
+def _require_recovery_state(state: Mapping, existing: Mapping | None, path: str) -> None:
+    if existing is None:
+        return
+    try:
+        incident = migration._json_bytes(existing["data"], path)
+        attempt_incident.validate_incident_structure(incident)
+    except migration.AttemptMigrationError as exc:
+        raise migration.AttemptMigrationError("incident_output_conflict") from exc
+    if state != incident["pre_move_repository_state"]:
+        raise migration.AttemptMigrationError("incident_recovery_state_invalid")
+
+
+def _require_output_equal(existing: Mapping | None, data: bytes, code: str) -> None:
+    if existing is not None and (existing["data"] != data or existing["lstat_mode"] != 0o644):
+        raise migration.AttemptMigrationError(code)
+
+
+def _build_incident(root: Path, options: Mapping, state: Mapping) -> dict:
+    return attempt_incident.build_incident(
+        root, **{key: options[key] for key in (
+            "governing_plan_path", "migration_plan_path", "workspace_baseline_path",
+            "expected_paths_manifest_path", "source_root", "intended_predecessor_head",
+        )}, owner_attestation_path=options["attestation_record_path"],
+        pending_attestation_snapshot_path=options["attestation_snapshot_path"],
+        known_failure_baseline_path=options["baseline_path"], repository_state=state,
+    )
+
+
+def _artifact_bindings(root: Path, options: Mapping, rows: Sequence[Mapping]) -> dict:
+    row_by_path = {row["original_path"]: row for row in rows}
+    role_paths = {role: options[role + "_path"] for role in v2.ARTIFACT_ROLES_V2}
+    if any(path not in row_by_path for path in role_paths.values()):
+        raise migration.AttemptMigrationError("attempt_artifact_coordinates_invalid")
+    artifacts = {
+        role: migration._binding_from_row(row_by_path[path], path_field="original_path")
+        for role, path in sorted(role_paths.items())
+    }
+    migration._validate_review_pair(
+        root, role_paths["baseline_specification_review"], role_paths["baseline_quality_review"],
+        require_committed=False, expected_subject_kind="implementation_failure_baseline",
+        expected_subject_path=role_paths["baseline"], expected_subject_sha256=artifacts["baseline"]["sha256"],
+    )
+    return artifacts
+
+
+def derive_disposition(root: Path, incident: Mapping, incident_bytes: bytes, options: Mapping) -> dict:
+    governing = migration._committed_binding(root, options["governing_plan_path"])
+    correction = migration._committed_binding(root, options["migration_plan_path"])
+    manifest_file = migration._require_committed_live(root, options["expected_paths_manifest_path"])
+    paths = migration._manifest_paths(manifest_file["data"], manifest_file["path"])
+    manifest = {**migration._content_binding(manifest_file), "row_count": len(paths),
+                "normalized_path_set_sha256": migration._canonical_digest(paths)}
+    state = incident["pre_move_repository_state"]
+    migration._require_source_commit(root, options["restoration_commit"], options["restoration_tree"], state["head"])
+    protected = migration._capture_protected_bindings(
+        root, options["protected_paths"], paths, options["archive_root"],
+        state["status_projection"]["rows"], options["source_root"],
+    )
+    specification, quality = migration._capture_authority_reviews(
+        root, subject_path=options["authority_subject_path"],
+        spec_path=options["authority_specification_review_path"], quality_path=options["authority_quality_review_path"],
+        governing_binding=governing, migration_binding=correction, manifest_binding=manifest, protected=protected,
+    )
+    rows = [{"original_path": row["path"], "archive_path": f'{options["archive_root"]}/{row["path"]}',
+             **{key: value for key, value in row.items() if key != "path"}} for row in incident["attempt_rows"]]
+    modified = [row for row in rows if row["tracked_state"] == "modified"]
+    if len(modified) != 1 or modified[0]["original_path"] != options["live_ledger_path"]:
+        raise migration.AttemptMigrationError("tracked_source_set_invalid")
+    artifacts = _artifact_bindings(root, options, rows)
+    lineage = migration._capture_ledger_lineage(
+        root, source_commit=options["restoration_commit"], source_tree=options["restoration_tree"],
+        live_path=options["live_ledger_path"], g5_request_path=options["generation5_request_path"],
+        g5_snapshot_path=options["generation5_snapshot_path"], g11_request_path=options["generation11_request_path"],
+        g11_snapshot_path=options["generation11_snapshot_path"],
+        row_by_path={row["original_path"]: row for row in rows},
+    )
+    record = {
+        "schema_version": migration.SCHEMA_VERSION_V2, "disposition": v2.DISPOSITION_V2,
+        "governing_plan_binding": governing, "migration_plan_binding": correction,
+        "authority_review_bindings": {"specification": migration._content_binding(specification),
+                                      "code_quality": migration._content_binding(quality)},
+        "attempt_binding": {"source_commit": options["restoration_commit"], "source_tree": options["restoration_tree"],
+                            "source_root": options["source_root"], "archive_root": options["archive_root"],
+                            "expected_paths_manifest_binding": manifest, "artifact_bindings": artifacts},
+        "attempt_lifecycle": {**v2.ATTEMPT_LIFECYCLE_LITERALS,
+                              "incident_binding": {"path": options["incident_path"], "size": len(incident_bytes),
+                                                   "sha256": migration._bytes_digest(incident_bytes)}},
+        "pre_move_repository_state": state, "protected_path_bindings": protected,
+        "ledger_lineage": lineage, "attempt_rows": rows, "attempt_path_count": len(rows),
+        "attempt_path_set_sha256": migration._canonical_digest(paths),
+        "archive_path_set_sha256": migration._canonical_digest([row["archive_path"] for row in rows]),
+        "normalized_row_set_sha256": migration._canonical_digest(rows),
+        "claims_not_made": v2.CLAIMS_NOT_MADE_V2,
+    }
+    record["normalized_disposition_sha256"] = migration._canonical_digest(record, exclude="normalized_disposition_sha256")
+    return v2.validate_disposition_structure(record, disposition_path=options["disposition_path"])
+
+
+def capture_invalidated_adopted(
+    repository_root: Path | str, *, incident_path: Path | str, disposition_path: Path | str,
+    source_root: Path | str, archive_root: Path | str,
+    governing_plan_path: Path | str, migration_plan_path: Path | str,
+    authority_subject_path: Path | str, authority_specification_review_path: Path | str,
+    authority_quality_review_path: Path | str, intended_predecessor_head: str,
+    restoration_commit: str, restoration_tree: str, expected_paths_manifest_path: Path | str,
+    protected_paths: Sequence[Path | str], generation5_request_path: Path | str,
+    generation5_snapshot_path: Path | str, generation11_request_path: Path | str,
+    generation11_snapshot_path: Path | str, live_ledger_path: Path | str,
+    baseline_path: Path | str, baseline_specification_review_path: Path | str,
+    baseline_quality_review_path: Path | str, workspace_baseline_path: Path | str,
+    attestation_request_path: Path | str, attestation_snapshot_path: Path | str,
+    attestation_record_path: Path | str,
+) -> dict[str, Any]:
+    """Publish an adopted attempt only after every capture and live check passes."""
+    options = dict(locals())
+    root = migration._repository_root(options.pop("repository_root"))
+    for key, value in options.items():
+        if key.endswith("_path") or key in ("source_root", "archive_root"):
+            options[key] = migration._relative_path(value, field=key)
+    try:
+        return _capture(root, options)
+    except (source_bindings.SourceBindingError, broad_evidence.ContractError, materialization.MaterializationError) as exc:
+        raise migration.AttemptMigrationError(str(exc)) from exc
+
+
+def _capture(root: Path, options: Mapping) -> dict[str, Any]:
+    state, existing_incident, existing_disposition = _capture_state(root, options)
+    _require_recovery_state(state, existing_incident, options["incident_path"])
+    incident = _build_incident(root, options, state)
+    incident_bytes = migration._canonical_json(incident) + b"\n"
+    _require_output_equal(existing_incident, incident_bytes, "incident_output_conflict")
+    disposition = derive_disposition(root, incident, incident_bytes, options)
+    disposition_bytes = migration._canonical_json(disposition) + b"\n"
+    _require_output_equal(existing_disposition, disposition_bytes, "disposition_output_conflict")
+    migration._validate_live_bindings(root, disposition)
+    v2.validate_live_against_incident(
+        root, disposition, incident, ignored_paths=(options["incident_path"], options["disposition_path"]),
+    )
+    if existing_incident is None:
+        migration._publish_exclusive(root, options["incident_path"], incident_bytes, 0o644)
+    if existing_disposition is None:
+        migration._publish_exclusive(root, options["disposition_path"], disposition_bytes, 0o644)
+    return {"incident": incident, "disposition": migration.validate(root, options["disposition_path"])}

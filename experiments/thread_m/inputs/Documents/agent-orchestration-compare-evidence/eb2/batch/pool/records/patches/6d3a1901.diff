+"""Logical attempt bytes owned by artifacts/design/adopted-attempt-predecessor-recovery.md."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from types import MappingProxyType
+from typing import Any, Mapping, Sequence
+
+from . import attempt_migration, broad_evidence
+
+
+@dataclass(frozen=True)
+class ViewEntry:
+    path: str
+    data: bytes
+    lstat_mode: int
+    size: int
+    sha256: str
+    origin: str
+
+
+@dataclass(frozen=True)
+class AttemptView:
+    entries: Mapping[str, ViewEntry | None]
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "entries", MappingProxyType(dict(self.entries)))
+
+    def entry(self, path: str) -> ViewEntry | None:
+        return self.entries.get(path)
+
+    def require_all(self) -> None:
+        for path in sorted(self.entries):
+            if self.entries[path] is None:
+                raise attempt_migration.AttemptMigrationError(
+                    "attempt_row_state_invalid", path
+                )
+
+    def overlay(self) -> dict[str, bytes]:
+        return {path: entry.data for path, entry in self.entries.items() if entry is not None}
+
+    def read(self, root: Path, path: str) -> bytes:
+        if path in self.entries:
+            entry = self.entries[path]
+            if entry is None:
+                raise attempt_migration.AttemptMigrationError(
+                    "attempt_row_state_invalid", path
+                )
+            return entry.data
+        data = broad_evidence._read_repository_file_no_follow(root, path)
+        if data is None or not broad_evidence._committed_blob_matches(root, path, data):
+            raise attempt_migration.AttemptMigrationError(
+                "logical_view_unmapped_unreadable", path
+            )
+        return data
+
+
+def _row_snapshot(root: Path, path: str) -> Mapping[str, Any] | None:
+    try:
+        return attempt_migration._read_regular(root, path, missing_ok=True)
+    except attempt_migration.AttemptMigrationError:
+        return None
+
+
+def _view_entry(path: str, snapshot: Mapping[str, Any], origin: str) -> ViewEntry:
+    return ViewEntry(
+        path=path,
+        data=snapshot["data"],
+        lstat_mode=snapshot["lstat_mode"],
+        size=snapshot["size"],
+        sha256=snapshot["sha256"],
+        origin=origin,
+    )
+
+
+def view_from_incident_rows(root: Path, rows: Sequence[Mapping[str, Any]]) -> AttemptView:
+    entries: dict[str, ViewEntry | None] = {}
+    for row in rows:
+        path = row["path"]
+        source = _row_snapshot(root, path)
+        entries[path] = (
+            _view_entry(path, source, "source")
+            if source is not None and attempt_migration._same_content(source, row)
+            else None
+        )
+    return AttemptView(entries)
+
+
+def view_from_disposition_rows(root: Path, rows: Sequence[Mapping[str, Any]]) -> AttemptView:
+    entries: dict[str, ViewEntry | None] = {}
+    for row in rows:
+        path, archive_path = row["original_path"], row["archive_path"]
+        source = _row_snapshot(root, path)
+        try:
+            archive = attempt_migration._read_regular(root, archive_path, missing_ok=True)
+        except attempt_migration.AttemptMigrationError as exc:
+            raise attempt_migration.AttemptMigrationError(
+                "archive_binding_mismatch", archive_path
+            ) from exc
+        if archive is not None and not attempt_migration._same_content(archive, row):
+            raise attempt_migration.AttemptMigrationError("archive_binding_mismatch", archive_path)
+        if source is not None and attempt_migration._same_content(source, row):
+            entries[path] = _view_entry(path, source, "source")
+        elif archive is not None:
+            entries[path] = _view_entry(path, archive, "archive")
+        else:
+            entries[path] = None
+    return AttemptView(entries)

+        collection_argv=['pytest', '--collect-only', '-q'],
+        broad_argv=['pytest', '-q', '-rs', '-n', '16', '--dist=worksteal'],
+        environment={'LC_ALL': 'C.UTF-8', 'PYTHONHASHSEED': '0', 'PYTEST_DEBUG_TEMPROOT': None},
+        run_root_snapshots=outcome['run_root_snapshots'], known_failure_baseline_binding=authority,
+        **raw)
+    assert later['baseline_comparison'] == comparison
+    paths = [authority[key]['path'] for key in ('outcome', 'record', 'owner_attestation')]
+    paths += [authority[key]['immutable_path'] for key in ('specification_review', 'quality_review')]
+    overlay = {path: (tmp_path / path).read_bytes() for path in paths}
+    for path in paths:
+        (tmp_path / path).chmod(0o644)
+        (tmp_path / path).unlink()
+    assert broad.validate_bound_record(later, tmp_path, bound_file_bytes=overlay) == []

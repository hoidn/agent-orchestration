@@ -0,0 +1,171 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from orchestrator.retirement import source_bindings as bindings
+
+
+TRAILER = (
+    b"\nRetirement-Control-Schema: precommit_control.v1\n"
+    + b"Retirement-Transaction-ID: " + b"a" * 64 + b"\n"
+    + b"Retirement-Control-SHA256: " + b"b" * 64 + b"\n"
+)
+
+
+def _git(root: Path, *args: str, data: bytes | None = None) -> bytes:
+    return subprocess.check_output(["git", *args], cwd=root, input=data).strip()
+
+
+@pytest.fixture
+def repository(tmp_path: Path) -> Path:
+    _git(tmp_path, "init", "-q")
+    _git(tmp_path, "config", "user.name", "Tests")
+    _git(tmp_path, "config", "user.email", "tests@example.invalid")
+    _git(tmp_path, "commit", "-q", "--allow-empty", "-m", "base")
+    return tmp_path
+
+
+def _commit(root: Path, paths: list[str], message: bytes = b"change\n") -> str:
+    for path in paths:
+        target = root / path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(path + "\n")
+    _git(root, "add", "--", *paths)
+    _git(root, "commit", "-q", "--allow-empty", "--cleanup=verbatim", "-F", "-", data=message)
+    return _git(root, "rev-parse", "HEAD").decode()
+
+
+def _derive(root: Path, baseline: str, intended: str, **kwargs: object) -> dict:
+    return bindings.derive_committed_predecessor_lineage(
+        root, baseline_head=baseline, intended_predecessor_head=intended, **kwargs
+    )
+
+
+def _digest(data: bytes) -> str:
+    return "sha256:" + hashlib.sha256(data).hexdigest()
+
+
+def _path_digest(paths: list[str]) -> str:
+    return _digest("".join(path + "\n" for path in sorted(paths)).encode())
+
+
+def test_projection_orders_first_parent_commits_and_partitions_paths(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode()
+    first = _commit(repository, ["z.txt", "shared.txt"], b"uncovered\n")
+    second = _commit(repository, ["a.txt", "shared.txt"], b"controlled\n" + TRAILER)
+    # Ensure the shared path changes in both commits.
+    (repository / "shared.txt").write_text("controlled\n")
+    _git(repository, "add", "shared.txt")
+    _git(repository, "commit", "--amend", "-q", "--cleanup=verbatim", "-F", "-", data=b"controlled\n" + TRAILER)
+    second = _git(repository, "rev-parse", "HEAD").decode()
+    projection = _derive(repository, baseline, second, require_uncovered_paths=True)
+    assert set(projection) == {
+        "baseline_head", "intended_predecessor_head", "intended_predecessor_tree",
+        "first_parent_commits", "commit_count", "changed_paths", "changed_path_count",
+        "changed_path_set_sha256", "controlled_paths", "controlled_path_set_sha256",
+        "uncovered_paths", "uncovered_path_set_sha256", "normalized_projection_sha256",
+    }
+    assert projection["baseline_head"] == baseline
+    assert projection["intended_predecessor_head"] == second
+    assert projection["intended_predecessor_tree"] == _git(repository, "rev-parse", second + "^{tree}").decode()
+    assert projection["commit_count"] == 2
+    for row, commit, parent, paths, message in zip(
+        projection["first_parent_commits"], [first, second], [baseline, first],
+        [["shared.txt", "z.txt"], ["a.txt", "shared.txt"]], [b"uncovered\n", b"controlled\n" + TRAILER],
+    ):
+        assert row == {
+            "commit": commit, "parent": parent,
+            "tree": _git(repository, "rev-parse", commit + "^{tree}").decode(),
+            "raw_message_sha256": _digest(message), "changed_paths": paths,
+            "changed_path_set_sha256": _path_digest(paths),
+            "control_coordinates": None if commit == first else {
+                "transaction_id": "a" * 64, "normalized_control_sha256": "sha256:" + "b" * 64,
+            },
+        }
+    for name, paths in (("changed", ["a.txt", "shared.txt", "z.txt"]),
+                        ("controlled", ["a.txt", "shared.txt"]),
+                        ("uncovered", ["shared.txt", "z.txt"])):
+        assert projection[name + "_paths"] == paths
+        assert projection[name + "_path_set_sha256"] == _path_digest(paths)
+    assert projection["changed_path_count"] == 3
+    normalized = {key: value for key, value in projection.items() if key != "normalized_projection_sha256"}
+    assert projection["normalized_projection_sha256"] == _digest(
+        json.dumps(normalized, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+    )
+
+
+def test_empty_range_is_allowed_without_requirement(repository: Path) -> None:
+    head = _git(repository, "rev-parse", "HEAD").decode()
+    result = _derive(repository, head, head)
+    assert result["commit_count"] == 0
+    assert result["first_parent_commits"] == []
+    assert result["uncovered_paths"] == result["controlled_paths"] == result["changed_paths"] == []
+    assert result["intended_predecessor_tree"] == _git(repository, "rev-parse", "HEAD^{tree}").decode()
+
+
+def test_empty_range_fails_when_uncovered_paths_required(repository: Path) -> None:
+    head = _git(repository, "rev-parse", "HEAD").decode()
+    with pytest.raises(bindings.SourceBindingError, match="^predecessor_uncovered_paths_missing$"):
+        _derive(repository, head, head, require_uncovered_paths=True)
+
+
+def test_fully_covered_range_is_not_eligible(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode()
+    head = _commit(repository, ["controlled.txt"], b"controlled\n" + TRAILER)
+    with pytest.raises(bindings.SourceBindingError, match="^predecessor_uncovered_paths_missing$"):
+        _derive(repository, baseline, head, require_uncovered_paths=True)
+
+
+def test_rejects_non_ancestor_baseline(repository: Path) -> None:
+    baseline = _commit(repository, ["first.txt"])
+    tree = _git(repository, "rev-parse", "HEAD^{tree}").decode()
+    sibling = _git(repository, "commit-tree", tree, "-m", "unrelated").decode()
+    with pytest.raises(bindings.SourceBindingError, match="^predecessor_baseline_not_ancestor$"):
+        _derive(repository, baseline, sibling)
+
+
+def test_rejects_merge_in_first_parent_range(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode()
+    main = _commit(repository, ["main.txt"])
+    tree = _git(repository, "rev-parse", "HEAD^{tree}").decode()
+    sibling = _git(repository, "commit-tree", tree, "-p", baseline, "-m", "sibling").decode()
+    merge = _git(repository, "commit-tree", tree, "-p", main, "-p", sibling, "-m", "merge").decode()
+    with pytest.raises(bindings.SourceBindingError, match="^predecessor_range_contains_merge:" + merge + "$"):
+        _derive(repository, baseline, merge)
+
+
+@pytest.mark.parametrize("field", ["baseline_head", "intended_predecessor_head"])
+@pytest.mark.parametrize("missing", ["0" * 40, "not-a-commit", None])
+def test_rejects_missing_commit(repository: Path, field: str, missing: str | None) -> None:
+    head = _git(repository, "rev-parse", "HEAD").decode()
+    options = {"baseline_head": head, "intended_predecessor_head": head, field: missing}
+    code = "predecessor_commit_missing" if missing == "0" * 40 else "predecessor_commit_invalid"
+    with pytest.raises(bindings.SourceBindingError, match="^" + code + ":" + field + "$"):
+        bindings.derive_committed_predecessor_lineage(repository, **options)
+
+
+@pytest.mark.parametrize("message", [
+    b"controlled\n" + TRAILER.replace(b"precommit_control.v1", b"precommit_control.v2"),
+    b"controlled\n" + TRAILER.replace(b"a" * 64, b"a" * 63),
+    b"controlled\n" + TRAILER + b"extra\n",
+    b"controlled" + TRAILER,
+])
+def test_rejects_malformed_trailer_block(repository: Path, message: bytes) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode()
+    head = _commit(repository, ["controlled.txt"], message)
+    with pytest.raises(bindings.SourceBindingError, match="^commit_control_trailer_invalid:" + head + "$"):
+        _derive(repository, baseline, head)
+
+
+def test_rejects_duplicate_changed_path(repository: Path) -> None:
+    baseline = _git(repository, "rev-parse", "HEAD").decode()
+    blob = _git(repository, "hash-object", "-w", "--stdin", data=b"duplicate\n").decode()
+    tree = _git(repository, "mktree", data=(f"100644 blob {blob}\tduplicate.txt\n" * 2).encode()).decode()
+    head = _git(repository, "commit-tree", tree, "-p", baseline, "-m", "duplicate tree").decode()
+    with pytest.raises(bindings.SourceBindingError, match="^predecessor_changed_path_duplicate:" + head + "$"):
+        _derive(repository, baseline, head)

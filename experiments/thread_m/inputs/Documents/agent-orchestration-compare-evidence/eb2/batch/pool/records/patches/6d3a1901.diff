+
+def _candidate(root: Path) -> dict:
+    rows = []
+    for path, data in (("source.py", b"candidate = True\n"), ("landed.py", b"landed = True\n")):
+        _write(root, path, data)
+        rows.append({"path": path, "size": len(data), "sha256": _digest(data), "state": "added"})
+    rows.sort(key=lambda row: row["path"])
+    candidate = {
+        "head": "",
+        "head_tree": "",
+        "index_sha256": "",

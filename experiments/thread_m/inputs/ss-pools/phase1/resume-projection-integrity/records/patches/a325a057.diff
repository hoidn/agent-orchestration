+def _sticky_graph(tmp_path: Path, *, cleanup_fails: bool):
+    import yaml
+
+    _write_projection_integrity_call_graph(tmp_path)
+    root = {
+        "version": "2.5",
+        "name": "projection-root",
+        "imports": {"middle": "imports/middle.yaml"},
+        "steps": [
+            {
+                "name": "InvokeMiddle",
+                "id": "invoke_middle",
+                "call": "middle",
+                "on": {"failure": {"goto": "Recover"}},
+            },
+            {
+                "name": "Recover",
+                "id": "recover",
+                "command": ["bash", "-lc", "touch recovered.txt"],
+            },
+        ],
+        "finally": {
+            "id": "cleanup",
+            "steps": [
+                {
+                    "name": "Cleanup",
+                    "id": "cleanup_step",
+                    "command": ["bash", "-lc", "test ! -f cleanup-fails.txt"],
+                }
+            ],
+        },
+    }
+    (tmp_path / "workflow.yaml").write_text(yaml.safe_dump(root, sort_keys=False), encoding="utf-8")
+    bundle = WorkflowLoader(tmp_path).load_bundle(tmp_path / "workflow.yaml")
+    manager = StateManager(tmp_path, run_id="sticky-e2e")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+
+    persisted = manager.load()
+    frame = next(iter(persisted.call_frames.values()))
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["current_step"] = {
+        "status": "running",
+        "name": "Removed",
+        "index": 0,
+        "step_id": "root.removed_local",
+    }
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    persisted.finalization = {}
+    persisted.steps.pop("Recover")
+    persisted.steps.pop("finally.Cleanup")
+    manager._write_state()
+    (tmp_path / "recovered.txt").unlink(missing_ok=True)
+    if cleanup_fails:
+        (tmp_path / "cleanup-fails.txt").write_text("x", encoding="utf-8")
+    return bundle, manager
+
+
+@pytest.mark.parametrize("cleanup_fails", [False, True])
+def test_projection_failure_is_not_routed_and_finalization_is_supplemental(
+    tmp_path: Path, cleanup_fails: bool
+):
+    bundle, manager = _sticky_graph(tmp_path, cleanup_fails=cleanup_fails)
+
+    resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    persisted = manager.load().to_dict()
+    error = persisted["error"]
+    assert resumed["status"] == "failed"
+    assert error["type"] == "resume_projection_integrity_error"
+    assert persisted["steps"]["InvokeMiddle"]["error"] == error
+    assert not (tmp_path / "recovered.txt").exists()
+    assert "Recover" not in persisted["steps"]
+    cleanup_row = persisted["steps"]["finally.Cleanup"]
+    assert cleanup_row["status"] == ("failed" if cleanup_fails else "completed")
+    if cleanup_fails:
+        assert persisted["finalization"]["status"] == "failed"
+        failure = persisted["finalization"]["failure"]
+        assert failure["step"] == "finally.Cleanup"
+        assert failure["error"] is None

+def test_lineage_orders_failed_predecessors_and_allocates_lowest_unused_ordinal():
+    items = _lineage_items(
+        ("B::retry::2", "failed"),
+        ("B", "failed"),
+        ("B::retry::1", "completed"),
+        ("B::retry::3", "running"),
+    )
+
+    lineage = index_retry_lineage("c", items, frontend_kind="workflow_lisp")
+
+    assert lineage.base_frame_id == "B"
+    assert [m.frame_id for m in lineage.failed_predecessors] == ["B", "B::retry::2"]
+    assert lineage.running_member is not None and lineage.running_member.frame_id == "B::retry::3"
+    assert [m.frame_id for m in lineage.completed_members] == ["B::retry::1"]
+    assert next_unused_retry_frame_id(lineage) == "B::retry::4"
+    assert next_unused_retry_frame_id(lineage) == "B::retry::4"
+    assert all(isinstance(m, RetryFrameMember) for m in lineage.failed_predecessors)
+

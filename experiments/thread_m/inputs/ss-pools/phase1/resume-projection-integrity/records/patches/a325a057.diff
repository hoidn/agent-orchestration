+"""Typed Workflow Lisp provenance: compiler-produced bundles carry frontend_kind."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow.loaded_bundle import workflow_provenance
+from orchestrator.workflow_lisp.build import FrontendBuildRequest, build_frontend_bundle
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+FIXTURES = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp"
+CLI_FIXTURES = FIXTURES / "cli"
+# Entry imports a Workflow Lisp helper module and calls a classic-YAML
+# workflow (`selector-run`) supplied through `imported_workflow_bundles`.
+SOURCE_ROOT = FIXTURES / "modules" / "valid" / "imported_bundle_mix"
+ENTRYPOINT = SOURCE_ROOT / "neurips" / "entry.orc"
+ROUTES = ("legacy", "wcc_m4")
+
+
+def _yaml_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(CLI_FIXTURES / "imported_selector.yaml")
+
+
+def _compile(tmp_path: Path, *, route: str, yaml_bundle):
+    return compile_stage3_entrypoint(
+        ENTRYPOINT,
+        source_roots=(SOURCE_ROOT,),
+        entry_workflow="orchestrate",
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={"prompts.implementation.execute": "prompts/implementation/execute.md"},
+        imported_workflow_bundles={"selector-run": yaml_bundle},
+        validate_shared=True,
+        workspace_root=tmp_path,
+        lowering_route=route,
+    )
+
+
+def _entry_bundle(compile_result):
+    (bundle,) = [
+        bundle
+        for name, bundle in compile_result.validated_bundles_by_name.items()
+        if name.endswith("orchestrate")
+    ]
+    return bundle
+
+
+def _lisp_import(entry_bundle, yaml_bundle):
+    (imported,) = [bundle for bundle in entry_bundle.imports.values() if bundle is not yaml_bundle]
+    return imported
+
+
+@pytest.mark.parametrize("route", ROUTES)
+def test_every_validated_bundle_is_typed_workflow_lisp(tmp_path: Path, route: str) -> None:
+    result = _compile(tmp_path, route=route, yaml_bundle=_yaml_bundle(tmp_path))
+
+    kinds = {workflow_provenance(b).frontend_kind for b in result.validated_bundles_by_name.values()}
+
+    assert kinds == {"workflow_lisp"}
+
+
+@pytest.mark.parametrize("route", ROUTES)
+def test_imported_lisp_bundle_is_typed_workflow_lisp(tmp_path: Path, route: str) -> None:
+    yaml_bundle = _yaml_bundle(tmp_path)
+    entry = _entry_bundle(_compile(tmp_path, route=route, yaml_bundle=yaml_bundle))
+
+    assert workflow_provenance(_lisp_import(entry, yaml_bundle)).frontend_kind == "workflow_lisp"
+
+
+@pytest.mark.parametrize("route", ROUTES)
+def test_yaml_import_is_linked_as_same_object(tmp_path: Path, route: str) -> None:
+    yaml_bundle = _yaml_bundle(tmp_path)
+    entry = _entry_bundle(_compile(tmp_path, route=route, yaml_bundle=yaml_bundle))
+
+    assert any(bundle is yaml_bundle for bundle in entry.imports.values())
+
+
+def test_yaml_import_keeps_untyped_provenance(tmp_path: Path) -> None:
+    yaml_bundle = _yaml_bundle(tmp_path)
+    _compile(tmp_path, route="legacy", yaml_bundle=yaml_bundle)
+
+    assert workflow_provenance(yaml_bundle).frontend_kind is None
+
+
+def test_build_frontend_bundle_keeps_compiler_frontend_kind(tmp_path: Path) -> None:
+    result = build_frontend_bundle(
+        FrontendBuildRequest(
+            source_path=ENTRYPOINT,
+            source_roots=(SOURCE_ROOT, tmp_path),
+            entry_workflow="orchestrate",
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            emit_debug_yaml=False,
+            workspace_root=tmp_path,
+        )
+    )
+
+    assert workflow_provenance(result.validated_bundle).frontend_kind == "workflow_lisp"

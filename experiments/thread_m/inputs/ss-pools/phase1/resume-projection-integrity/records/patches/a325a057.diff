new file mode 100644
index 0000000..ffa20ea
--- /dev/null
+++ b/tests/test_loader_duplicate_import_alias.py
@@ -0,0 +1,131 @@
+"""Duplicate classic-YAML import alias / imports section detection in WorkflowLoader.load."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Noop
+    command: ["true"]
+"""
+
+
+def _write(tmp_path: Path, caller: str) -> Path:
+    (tmp_path / "lib.yaml").write_text(LIBRARY)
+    (tmp_path / "other.yaml").write_text(LIBRARY.replace("name: lib", "name: other"))
+    path = tmp_path / "caller.yaml"
+    path.write_text(caller)
+    return path
+
+
+def _load_messages(tmp_path: Path, caller: str, monkeypatch) -> list[str]:
+    def _never(*args, **kwargs):
+        raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _never)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(tmp_path).load(_write(tmp_path, caller))
+    return [error.message for error in excinfo.value.errors]
+
+
+STEPS = """\
+steps:
+  - name: Noop
+    command: ["true"]
+"""
+
+
+def test_duplicate_keys_in_imports_mapping(tmp_path, monkeypatch):
+    caller = 'version: "2.5"\nimports:\n  lib: lib.yaml\n  lib: other.yaml\n' + STEPS
+    assert _load_messages(tmp_path, caller, monkeypatch) == [
+        "imports.lib: duplicate import alias (line 3, column 3; line 4, column 3)"
+    ]
+
+
+def test_merge_inside_imports_repeats_alias(tmp_path, monkeypatch):
+    caller = (
+        'version: "2.5"\n'
+        "base: &base\n"
+        "  lib: lib.yaml\n"
+        "imports:\n"
+        "  <<: *base\n"
+        "  lib: other.yaml\n" + STEPS
+    )
+    assert _load_messages(tmp_path, caller, monkeypatch) == [
+        "imports.lib: duplicate import alias (line 3, column 3; line 6, column 3)"
+    ]
+
+
+def test_repeated_top_level_sections_with_repeated_alias(tmp_path, monkeypatch):
+    caller = (
+        'version: "2.5"\n'
+        "imports:\n"
+        "  lib: lib.yaml\n" + STEPS + "imports:\n"
+        "  lib: other.yaml\n"
+    )
+    assert _load_messages(tmp_path, caller, monkeypatch) == [
+        "imports.lib: duplicate import alias (line 3, column 3; line 8, column 3)"
+    ]
+
+
+def test_top_level_merge_sources_each_carrying_imports(tmp_path, monkeypatch):
+    caller = (
+        "a: &a\n"
+        "  imports:\n"
+        "    lib: lib.yaml\n"
+        "b: &b\n"
+        "  imports:\n"
+        "    lib: other.yaml\n"
+        "<<: [*a, *b]\n"
+        'version: "2.5"\n' + STEPS
+    )
+    assert _load_messages(tmp_path, caller, monkeypatch) == [
+        "imports.lib: duplicate import alias (line 3, column 5; line 6, column 5)"
+    ]
+
+
+def test_repeated_sections_with_distinct_aliases(tmp_path, monkeypatch):
+    caller = (
+        'version: "2.5"\n'
+        "imports:\n"
+        "  lib: lib.yaml\n"
+        "imports:\n"
+        "  other: other.yaml\n" + STEPS
+    )
+    assert _load_messages(tmp_path, caller, monkeypatch) == [
+        "imports: duplicate top-level mapping (line 2, column 1; line 4, column 1)"
+    ]
+
+
+def test_merged_and_explicit_sections_with_distinct_aliases(tmp_path, monkeypatch):
+    caller = (
+        "base: &base\n"
+        "  imports:\n"
+        "    lib: lib.yaml\n"
+        "<<: *base\n"
+        'version: "2.5"\n'
+        "imports:\n"
+        "  other: other.yaml\n" + STEPS
+    )
+    assert _load_messages(tmp_path, caller, monkeypatch) == [
+        "imports: duplicate top-level mapping (line 2, column 3; line 6, column 1)"
+    ]
+
+
+def test_single_merged_imports_section_still_loads(tmp_path):
+    caller = (
+        "<<:\n"
+        "  imports:\n"
+        "    lib: lib.yaml\n"

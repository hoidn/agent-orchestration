+def test_projection_error_is_never_routed_or_continued(tmp_path: Path, bundle):
+    manager = _seed_run(tmp_path, bundle, "sticky")
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    diagnostic = {
+        "type": "resume_projection_integrity_error",
+        "message": "Resume projection integrity audit failed: out_of_scope_step_id",
+        "context": {},
+    }
+    wrapped = {"type": "call_failed", "message": "x", "context": {"error": diagnostic}}
+    for error in (diagnostic, wrapped):
+        state = {"steps": {"SetReady": {"status": "failed", "exit_code": 2, "error": error}}}
+        step = executor._runtime_step_for_node_id("root.set_ready")
+
+        outcome = executor._handle_control_flow(
+            step, state, "SetReady", 0, "continue", current_node_id="root.set_ready"
+        )
+
+        assert outcome == "_stop"
+    assert executor._sticky_projection_error == diagnostic
+

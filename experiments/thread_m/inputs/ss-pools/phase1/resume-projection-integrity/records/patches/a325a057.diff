+def test_auditor_module_reads_no_migration_evidence():
+    source = Path("orchestrator/workflow/resume_projection_integrity.py").read_text().lower()
+
+    for forbidden in (
+        "migration_parity",
+        "procedure_identity_retirement",
+        "load_parity_targets",
+        "load_retirement",
+        "validate_retirement_record",
+        "receipt",
+    ):
+        assert forbidden not in source
+    assert not ("cache" in source and ("audit" in source or "projection integrity" in source))
+

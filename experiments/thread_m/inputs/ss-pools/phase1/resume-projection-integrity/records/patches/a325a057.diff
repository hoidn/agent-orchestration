diff --git a/orchestrator/workflow/call_frame_retry_lineage.py b/orchestrator/workflow/call_frame_retry_lineage.py
new file mode 100644
index 0000000..6782cfd
--- /dev/null
+++ b/orchestrator/workflow/call_frame_retry_lineage.py
@@ -0,0 +1,172 @@
+"""Workflow Lisp call-frame retry lineage indexing.
+
+A Workflow Lisp call boundary may own a retry lineage: a base frame id ``B``
+(ordinal 0) and retries ``B::retry::<n>``. Non-Workflow-Lisp boundaries own at
+most one non-completed frame. This module is pure: it reads only the frame
+mappings it is handed.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Frames of one boundary do not form a valid resumable lineage."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    boundary_step_id: str
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[RetryFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+
+
+def _parse_frame_id(frame_id: str) -> tuple[str, int]:
+    """Split a frame id into ``(base, ordinal)`` or raise ``unsupported_shape``."""
+    base, marker, suffix = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return frame_id, 0
+    if not base or RETRY_MARKER in suffix:
+        raise CallFrameRetryLineageError("unsupported_shape", "malformed or nested retry marker")
+    if not (suffix.isascii() and suffix.isdecimal()) or str(int(suffix)) != suffix or int(suffix) < 1:
+        raise CallFrameRetryLineageError("unsupported_shape", "missing or malformed retry ordinal")
+    return base, int(suffix)
+
+
+def _validated_members(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+) -> list[tuple[CallFrameMember, Mapping[str, Any]]]:
+    members: list[tuple[CallFrameMember, Mapping[str, Any]]] = []
+    alias: Any = None
+    for index, (frame_id, frame) in enumerate(frame_items):
+        if not isinstance(frame_id, str) or not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame is not a mapping")
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", "call frame belongs to a different call boundary"
+            )
+        status = frame.get("status")
+        if status not in _STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", "unknown call frame status")
+        if index == 0:
+            alias = frame.get("import_alias")
+        elif frame.get("import_alias") != alias:
+            raise CallFrameRetryLineageError(
+                "persisted_import_alias_mismatch", "call frames disagree on the import alias"
+            )
+        members.append((CallFrameMember(frame_id, status), frame))
+    return members
+
+
+def _ambiguous(message: str) -> CallFrameRetryLineageError:
+    return CallFrameRetryLineageError("ambiguous_resumable_call_frame", message)
+
+
+def _index_plain_boundary(
+    boundary_step_id: str,
+    members: list[CallFrameMember],
+) -> CallFrameRetryLineage:
+    live = [member for member in members if member.status != "completed"]
+    if len(live) > 1:
+        raise _ambiguous("several non-completed frames for one call boundary")
+    return CallFrameRetryLineage(
+        boundary_step_id=boundary_step_id,
+        base_frame_id=live[0].frame_id if live else None,
+        completed_members=tuple(m for m in members if m.status == "completed"),
+        failed_predecessors=(),
+        running_member=live[0] if live else None,
+    )
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group the frames of one call boundary into its resumable lineage."""
+    members = [member for member, _frame in _validated_members(boundary_step_id, frame_items)]
+    if frontend_kind != "workflow_lisp":
+        return _index_plain_boundary(boundary_step_id, members)
+
+    live = [member for member in members if member.status != "completed"]
+    parsed = {member.frame_id: _parse_frame_id(member.frame_id) for member in live}
+    bases = {base for base, _ordinal in parsed.values()}
+    if len(bases) > 1:
+        raise _ambiguous("retry lineage mixes several base frames")
+    if len([m for m in live if m.status == "running"]) > 1:
+        raise _ambiguous("retry lineage has several running members")
+    base = next(iter(bases), None)
+
+    lineage_members: list[RetryFrameMember] = []
+    completed: list[CallFrameMember] = []
+    for member in members:
+        try:
+            member_base, ordinal = _parse_frame_id(member.frame_id)
+        except CallFrameRetryLineageError:
+            if member.status != "completed":
+                raise
+            completed.append(member)
+            continue
+        if member_base != base:
+            completed.append(member)
+            continue
+        lineage_member = RetryFrameMember(member.frame_id, member.status, ordinal)
+        lineage_members.append(lineage_member)
+        if member.status == "completed":
+            completed.append(lineage_member)
+    ordinals = [member.ordinal for member in lineage_members]
+    if len(set(ordinals)) != len(ordinals):
+        raise _ambiguous("retry lineage repeats an ordinal")
+    if base is not None and set(ordinals) != set(range(max(ordinals) + 1)):
+        raise CallFrameRetryLineageError("unsupported_shape", "retry lineage is missing an ordinal")
+
+    live_members = sorted(
+        (m for m in lineage_members if m.status != "completed"), key=lambda m: m.ordinal
+    )
+    return CallFrameRetryLineage(
+        boundary_step_id=boundary_step_id,
+        base_frame_id=base,
+        completed_members=tuple(completed),
+        failed_predecessors=tuple(m for m in live_members if m.status == "failed"),
+        running_member=next((m for m in live_members if m.status == "running"), None),
+    )
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<lowest unused positive ordinal>`` for ``lineage``."""
+    if lineage.base_frame_id is None:
+        raise ValueError("retry lineage has no base frame")
+    members = (
+        *lineage.completed_members,
+        *lineage.failed_predecessors,
+        *((lineage.running_member,) if lineage.running_member is not None else ()),
+    )
+    used = {m.ordinal for m in members if isinstance(m, RetryFrameMember)}
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

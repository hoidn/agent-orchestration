@@ -0,0 +1,38 @@
+"""Root workflow checksum recheck for structurally-root resumes."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+
+def root_checksum_mismatch(
+    state: Mapping[str, Any],
+    state_manager: Any,
+) -> Optional[dict[str, Optional[str]]]:
+    """Return the ``workflow_checksum_mismatch`` context when the root checksum fails, else None.
+
+    The current checksum is computed through ``state_manager.calculate_checksum`` for the
+    workflow file recorded in ``state``.
+    """
+    workflow_file = state.get("workflow_file")
+    persisted = state.get("workflow_checksum")
+    context: dict[str, Optional[str]] = {
+        "workflow_file": workflow_file if isinstance(workflow_file, str) else None,
+        "persisted_checksum": persisted if isinstance(persisted, str) else None,
+        "current_checksum": None,
+    }
+    if not isinstance(persisted, str) or not persisted.startswith("sha256:"):
+        return {**context, "reason": "missing_recorded_checksum"}
+    if not isinstance(workflow_file, str) or not workflow_file:
+        return {**context, "reason": "missing_workflow_path"}
+    path = Path(workflow_file)
+    if not path.is_absolute():
+        path = Path(state_manager.workspace) / path
+    try:
+        current = state_manager.calculate_checksum(path)
+    except OSError:
+        return {**context, "reason": "workflow_unavailable"}
+    if current != persisted:
+        return {**context, "current_checksum": current, "reason": "workflow_modified"}
+    return None

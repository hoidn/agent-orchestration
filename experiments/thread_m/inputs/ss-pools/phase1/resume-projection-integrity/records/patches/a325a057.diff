+def _state(**overrides) -> dict:
+    state = {
+        "workflow_checksum": "sha256:abc",
+        "steps": {},
+        "call_frames": {},
+        "for_each": {},
+        "repeat_until": {},
+    }
+    state.update(overrides)
+    return state

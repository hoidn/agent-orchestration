+@pytest.mark.parametrize(
+    ("specs", "reason"),
+    [
+        ((("B", "running"), ("B::retry::1", "running")), "ambiguous_resumable_call_frame"),
+        ((("B", "failed"), ("C", "failed")), "ambiguous_resumable_call_frame"),
+        ((("B", "failed"), ("B::retry::2", "failed")), "unsupported_shape"),
+        ((("B", "failed"), ("B::retry::x", "failed")), "unsupported_shape"),
+        ((("B", "failed"), ("B::retry::1::retry::1", "failed")), "unsupported_shape"),
+        ((("B", "weird"),), "unsupported_shape"),
+    ],
+)
+def test_lineage_failures(specs, reason):
+    with pytest.raises(CallFrameRetryLineageError) as exc_info:
+        index_retry_lineage("c", _lineage_items(*specs), frontend_kind="workflow_lisp")
+
+    assert exc_info.value.reason == reason
+
+
+def test_lineage_rejects_foreign_boundary_and_alias_drift_and_plain_ambiguity():
+    items = _lineage_items(("B", "failed"))
+    with pytest.raises(CallFrameRetryLineageError) as foreign:
+        index_retry_lineage("other", items, frontend_kind="workflow_lisp")
+    assert foreign.value.reason == "missing_call_boundary"
+
+    drift = [items[0], ("B::retry::1", {"call_step_id": "c", "import_alias": "z", "status": "failed"})]
+    with pytest.raises(CallFrameRetryLineageError) as alias:
+        index_retry_lineage("c", drift, frontend_kind="workflow_lisp")
+    assert alias.value.reason == "persisted_import_alias_mismatch"
+
+    with pytest.raises(CallFrameRetryLineageError) as plain:
+        index_retry_lineage("c", _lineage_items(("x", "running"), ("y", "failed")), frontend_kind=None)
+    assert plain.value.reason == "ambiguous_resumable_call_frame"
+
+    single = index_retry_lineage("c", _lineage_items(("x", "failed")), frontend_kind=None)
+    assert single.running_member is not None and single.running_member.frame_id == "x"

new file mode 100644
index 0000000..e6d1afc
--- /dev/null
+++ b/tests/test_observability_forensic_current_step.py
@@ -0,0 +1,107 @@
+"""A failed-closed resume leaves current_step as forensic data, not a live step."""
+
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import (
+    build_status_snapshot,
+    derive_status_projection,
+    render_status_markdown,
+)
+
+
+_WORKFLOW = {
+    "version": "1.3",
+    "name": "forensic-test",
+    "steps": [
+        {"name": "Prep", "command": ["bash", "-lc", "echo prep"]},
+        {"name": "DraftPlan", "provider": "codex"},
+    ],
+}
+_NOW = datetime(2026, 10, 18, 12, 0, tzinfo=timezone.utc)
+_STALE = (_NOW - timedelta(hours=2)).isoformat()
+
+
+def _state(error_type: str) -> dict:
+    return {
+        "run_id": "run-forensic",
+        "status": "failed",
+        "started_at": _STALE,
+        "updated_at": _NOW.isoformat(),
+        "workflow_file": "workflow.yaml",
+        "error": {"type": error_type, "message": "resume refused", "context": {"reason": "x"}},
+        "step_visits": {"DraftPlan": 1},
+        "current_step": {
+            "name": "DraftPlan",
+            "step_id": "root.draftplan",
+            "status": "running",
+            "visit_count": 1,
+            "started_at": _STALE,
+            "last_heartbeat_at": _STALE,
+        },
+        "steps": {"Prep": {"status": "completed", "exit_code": 0, "output": "prep"}},
+    }
+
+
+def _snapshot(tmp_path: Path, error_type: str) -> dict:
+    workflow_path = tmp_path / "workflow.yaml"
+    workflow_path.write_text(yaml.safe_dump(_WORKFLOW, sort_keys=False), encoding="utf-8")
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow_path)
+    run_root = tmp_path / ".orchestrate" / "runs" / "run-forensic"
+    (run_root / "logs").mkdir(parents=True)
+    # Prompt audit left behind by the interrupted run must not revive the step either.
+    (run_root / "logs" / "DraftPlan.prompt.txt").write_text("old prompt", encoding="utf-8")
+    return build_status_snapshot(bundle, _state(error_type), run_root, now=_NOW)
+
+
+def _draft(snapshot: dict) -> dict:
+    return {step["name"]: step for step in snapshot["steps"]}["DraftPlan"]
+
+
+_FORENSIC_TYPES = ["resume_projection_integrity_error", "workflow_checksum_mismatch"]
+
+
+@pytest.mark.parametrize("error_type", _FORENSIC_TYPES)
+def test_forensic_current_step_status_is_pending(tmp_path: Path, error_type: str):
+    assert _draft(_snapshot(tmp_path, error_type))["status"] == "pending"
+
+
+@pytest.mark.parametrize("error_type", _FORENSIC_TYPES)
+def test_forensic_current_step_summary_is_pending(tmp_path: Path, error_type: str):
+    assert _draft(_snapshot(tmp_path, error_type))["summary"] == "pending"
+
+
+@pytest.mark.parametrize("error_type", _FORENSIC_TYPES)
+def test_forensic_current_step_has_no_current_visit_count(tmp_path: Path, error_type: str):
+    assert _draft(_snapshot(tmp_path, error_type))["current_visit_count"] is None
+
+
+@pytest.mark.parametrize("error_type", _FORENSIC_TYPES)
+def test_forensic_current_step_counts_as_pending(tmp_path: Path, error_type: str):
+    progress = _snapshot(tmp_path, error_type)["progress"]
+    assert (progress["pending"], progress["running"]) == (1, 0)
+
+
+@pytest.mark.parametrize("error_type", _FORENSIC_TYPES)
+def test_forensic_current_step_markdown_is_not_in_progress(tmp_path: Path, error_type: str):
+    markdown = render_status_markdown(_snapshot(tmp_path, error_type))
+    assert "in progress" not in markdown and "### DraftPlan (pending)" in markdown
+
+
+@pytest.mark.parametrize("error_type", _FORENSIC_TYPES)
+def test_forensic_current_step_stale_heartbeat_is_not_classified(error_type: str):
+    projection = derive_status_projection(_state(error_type), [], now=_NOW)
+    assert (projection["display_status"], projection["display_status_reason"]) == ("failed", None)
+
+
+def test_plain_failed_run_keeps_current_step_running(tmp_path: Path):
+    draft = _draft(_snapshot(tmp_path, "step_failed"))
+    assert (draft["status"], draft["summary"], draft["current_visit_count"]) == (
+        "running",
+        "in progress",
+        1,
+    )

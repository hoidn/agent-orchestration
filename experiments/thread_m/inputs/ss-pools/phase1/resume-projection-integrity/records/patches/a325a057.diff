+def _seed_run(tmp_path: Path, bundle, run_id: str) -> StateManager:
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    return manager
+
+
+def test_state_manager_envelopes_change_only_status_error_updated_at(tmp_path: Path, bundle):
+    manager = _seed_run(tmp_path, bundle, "envelope")
+    data = json.loads(manager.state_file.read_text())
+    data["unknown_root_field"] = {"keep": True}
+    data["steps"] = {"X": {"status": "completed"}}
+    manager.state_file.write_text(json.dumps(data))
+    before = json.loads(manager.state_file.read_text())
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="workflow.yaml",
+        persisted_checksum="sha256:a",
+        current_checksum=None,
+        reason="workflow_unavailable",
+    )
+    after = json.loads(manager.state_file.read_text())
+
+    assert after["error"] == {
+        "type": "workflow_checksum_mismatch",
+        "message": "Workflow has been modified since the run started",
+        "context": {
+            "workflow_file": "workflow.yaml",
+            "persisted_checksum": "sha256:a",
+            "current_checksum": None,
+            "reason": "workflow_unavailable",
+        },
+    }
+    assert after["status"] == "failed"
+    for key in ("status", "error", "updated_at"):
+        before.pop(key, None)
+        after.pop(key)
+    assert after == before
+
+
+@pytest.mark.parametrize("reason", ["workflow_modified", "workflow_unavailable", "missing_recorded_checksum"])
+def test_root_executor_rechecks_checksum_before_audit_and_prologue(tmp_path: Path, bundle, reason, monkeypatch):
+    manager = _seed_run(tmp_path, bundle, f"checksum-{reason}")
+    workflow_path = tmp_path / "workflow.yaml"
+    if reason == "workflow_modified":
+        workflow_path.write_text(workflow_path.read_text() + "\n# edit\n")
+    elif reason == "workflow_unavailable":
+        workflow_path.unlink()
+    else:
+        data = json.loads(manager.state_file.read_text())
+        data["workflow_checksum"] = ""
+        manager.state_file.write_text(json.dumps(data))
+        manager.load()
+    audited: list[str] = []
+    monkeypatch.setattr(
+        "orchestrator.workflow.executor.audit_scope", lambda *args: audited.append("audit")
+    )
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    monkeypatch.setattr(
+        executor,
+        "_execute_prologue",
+        lambda *a, **k: pytest.fail("prologue reached after checksum mismatch"),
+    )
+
+    result = executor.execute(resume=True)
+
+    persisted = json.loads(manager.state_file.read_text())
+    assert result["status"] == "failed"
+    assert audited == []
+    assert persisted["status"] == "failed"
+    assert persisted["error"]["type"] == "workflow_checksum_mismatch"
+    assert persisted["error"]["context"]["reason"] == reason
+
+
+def test_root_executor_audits_root_scope_before_prologue(tmp_path: Path, bundle, monkeypatch):
+    manager = _seed_run(tmp_path, bundle, "audit-order")
+    events: list[str] = []
+    real_audit = audit_scope
+
+    def recording_audit(b, state, path):
+        events.append(f"audit:{path.projection_scope}")
+        return real_audit(b, state, path)
+
+    monkeypatch.setattr("orchestrator.workflow.executor.audit_scope", recording_audit)
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    real_prologue = executor._execute_prologue
+
+    def recording_prologue(*args, **kwargs):
+        events.append("prologue")
+        return real_prologue(*args, **kwargs)
+
+    monkeypatch.setattr(executor, "_execute_prologue", recording_prologue)
+
+    class StepsReached(Exception):
+        pass
+
+    def stop_at_steps(*_args, **_kwargs):
+        raise StepsReached
+
+    monkeypatch.setattr(executor, "_execute_step_loop", stop_at_steps)
+    with pytest.raises(StepsReached):
+        executor.execute(resume=True)
+
+    assert events == ["audit:root", "prologue"]
+

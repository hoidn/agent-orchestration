new file mode 100644
index 0000000..1ceb175
--- /dev/null
+++ b/orchestrator/workflow/resume_slot_index.py
@@ -0,0 +1,204 @@
+"""Resume slot enumeration over a ``WorkflowStateProjection``.
+
+Builds the candidate step identities and call boundaries a scope owns, using
+only projection-owned id constructors (no id parsing or normalization), and
+validates loop bookkeeping that bounds the loop-local candidates.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Mapping, Optional
+
+from .executable_ir import WorkflowRegion
+from .resume_loop_progress import (
+    ResumeProjectionValidationError,
+    validate_for_each_progress,
+    validate_repeat_until_progress,
+)
+from .surface_ast import empty_frozen_mapping
+
+if TYPE_CHECKING:  # pragma: no cover
+    from .state_projection import CallBoundaryProjection, WorkflowStateProjection
+
+__all__ = [
+    "ResumeCallBoundaryResolution",
+    "ResumeIdentityResolution",
+    "ResumeProjectionSlotIndex",
+    "ResumeProjectionValidationError",
+    "ResumeSlot",
+    "build_resume_slot_index",
+    "resolve_call_boundary",
+    "resolve_resume_step_id",
+]
+
+
+@dataclass(frozen=True)
+class ResumeSlot:
+    """One persisted step identity the current scope can own."""
+
+    step_id: str
+    node_id: str
+    presentation_key: str
+    region: WorkflowRegion
+    iteration_index: Optional[int] = None
+    loop_node_id: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class ResumeProjectionSlotIndex:
+    """Candidate identities and call boundaries owned by one projection scope."""
+
+    candidates_by_step_id: Mapping[str, tuple[ResumeSlot, ...]] = field(
+        default_factory=empty_frozen_mapping
+    )
+    call_boundaries_by_step_id: Mapping[str, tuple["CallBoundaryProjection", ...]] = field(
+        default_factory=empty_frozen_mapping
+    )
+    unclaimed_explicit_rows: tuple[tuple[str, Any], ...] = ()
+    presentation_keys: frozenset[str] = frozenset()
+
+
+@dataclass(frozen=True)
+class ResumeIdentityResolution:
+    slot: Optional[ResumeSlot]
+    candidate_count: int
+    exact_identity_candidate_count: int
+
+
+@dataclass(frozen=True)
+class ResumeCallBoundaryResolution:
+    boundary: Optional["CallBoundaryProjection"]
+    candidate_count: int
+
+
+def _loop_bounds(projection: "WorkflowStateProjection", state: Mapping[str, Any]) -> dict[str, int]:
+    """Validate loop bookkeeping and return the iteration count per loop node id."""
+    bounds: dict[str, int] = {}
+    steps = state.get("steps")
+    steps = steps if isinstance(steps, Mapping) else {}
+
+    for_each_state = state.get("for_each", {})
+    if not isinstance(for_each_state, Mapping):
+        raise ResumeProjectionValidationError(
+            "unsupported_shape", "for_each must be a mapping", field="for_each"
+        )
+    counts = {
+        name: validate_for_each_progress(str(name), progress)
+        for name, progress in for_each_state.items()
+    }
+    for node_id, loop in projection.for_each_nodes.items():
+        bounds[node_id] = counts.get(loop.frame_key, 0)
+
+    repeat_state = state.get("repeat_until", {})
+    if not isinstance(repeat_state, Mapping):
+        raise ResumeProjectionValidationError(
+            "unsupported_shape", "repeat_until must be a mapping", field="repeat_until"
+        )
+    max_by_name = {
+        loop.frame_key: projection.repeat_until_max_iterations.get(node_id)
+        for node_id, loop in projection.repeat_until_nodes.items()
+    }
+    reached: dict[str, int] = {}
+    for name, progress in repeat_state.items():
+        reached[name] = validate_repeat_until_progress(
+            str(name),
+            progress,
+            max_iterations=max_by_name.get(name),
+            loop_row=steps.get(name),
+        )
+    for node_id, loop in projection.repeat_until_nodes.items():
+        declared = projection.repeat_until_max_iterations.get(node_id)
+        bounds[node_id] = declared if declared is not None else reached.get(loop.frame_key, 0)
+    return bounds
+
+
+def _snapshot_identity(value: Any) -> Any:
+    return copy.deepcopy(value)
+
+
+def build_resume_slot_index(
+    projection: "WorkflowStateProjection",
+    state: Mapping[str, Any],
+) -> ResumeProjectionSlotIndex:
+    """Enumerate candidate slots for ``state`` without mutating it."""
+    bounds = _loop_bounds(projection, state)
+    candidates: dict[str, list[ResumeSlot]] = {}
+    keys: set[str] = set()
+
+    def add(slot: ResumeSlot) -> None:
+        candidates.setdefault(slot.step_id, []).append(slot)
+        keys.add(slot.presentation_key)
+
+    for node_id, entry in projection.entries_by_node_id.items():
+        if entry.compatibility_index is None and entry.finalization_index is None:
+            continue
+        add(ResumeSlot(entry.step_id, node_id, entry.presentation_key, entry.region))
+
+    loops = {**projection.repeat_until_nodes, **projection.for_each_nodes}
+    for loop_node_id, loop in loops.items():
+        for index in range(bounds.get(loop_node_id, 0)):
+            for nested_node_id in loop.nested_presentation_keys:
+                nested_entry = projection.entries_by_node_id.get(nested_node_id)
+                add(
+                    ResumeSlot(
+                        loop.runtime_step_id(index, nested_node_id),
+                        nested_node_id,
+                        loop.step_key(index, nested_node_id),
+                        nested_entry.region if nested_entry is not None else WorkflowRegion.BODY,
+                        iteration_index=index,
+                        loop_node_id=loop_node_id,
+                    )
+                )
+
+    boundaries: dict[str, list["CallBoundaryProjection"]] = {}
+    for boundary in projection.call_boundaries.values():
+        if boundary.iteration_owner_node_id is None:
+            boundaries.setdefault(boundary.step_id, []).append(boundary)
+            continue
+        for index in range(bounds.get(boundary.iteration_owner_node_id, 0)):
+            boundaries.setdefault(boundary.runtime_step_id(index), []).append(boundary)
+
+    steps = state.get("steps")
+    unclaimed = tuple(
+        (name, _snapshot_identity(row["step_id"]))
+        for name, row in (steps.items() if isinstance(steps, Mapping) else ())
+        if isinstance(row, Mapping) and "step_id" in row and name not in keys
+    )
+    return ResumeProjectionSlotIndex(
+        candidates_by_step_id={key: tuple(value) for key, value in candidates.items()},
+        call_boundaries_by_step_id={key: tuple(value) for key, value in boundaries.items()},
+        unclaimed_explicit_rows=unclaimed,
+        presentation_keys=frozenset(keys),
+    )
+
+
+def resolve_resume_step_id(
+    slot_index: ResumeProjectionSlotIndex,
+    step_id: Any,
+    presentation_key: Optional[str] = None,
+) -> ResumeIdentityResolution:
+    """Resolve one persisted step id against the scope's candidates."""
+    if not isinstance(step_id, str):
+        return ResumeIdentityResolution(None, 0, 0)
+    candidates = slot_index.candidates_by_step_id.get(step_id, ())
+    exact = [
+        slot
+        for slot in candidates
+        if presentation_key is None or slot.presentation_key == presentation_key
+    ]
+    return ResumeIdentityResolution(
+        exact[0] if len(exact) == 1 else None, len(candidates), len(exact)
+    )
+
+
+def resolve_call_boundary(
+    slot_index: ResumeProjectionSlotIndex,
+    call_step_id: Any,
+) -> ResumeCallBoundaryResolution:
+    """Resolve one persisted caller id to the unique current call boundary."""
+    if not isinstance(call_step_id, str):
+        return ResumeCallBoundaryResolution(None, 0)
+    owners = slot_index.call_boundaries_by_step_id.get(call_step_id, ())
+    return ResumeCallBoundaryResolution(owners[0] if len(owners) == 1 else None, len(owners))

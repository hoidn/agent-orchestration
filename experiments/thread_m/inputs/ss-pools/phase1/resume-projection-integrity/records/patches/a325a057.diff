diff --git a/orchestrator/workflow/resume_loop_progress.py b/orchestrator/workflow/resume_loop_progress.py
new file mode 100644
index 0000000..4db7977
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_progress.py
@@ -0,0 +1,197 @@
+"""Loop bookkeeping integrity checks used by resume slot enumeration.
+
+Pure functions over persisted ``for_each`` / ``repeat_until`` progress mappings.
+They read only the mappings they are handed and raise
+``ResumeProjectionValidationError`` on the first violation.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Invalid persisted resume bookkeeping detected while enumerating slots."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+        self.value = value
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _shape(message: str, field: str, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field=field, value=value)
+
+
+def _progress(message: str, field: str, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field=field, value=value)
+
+
+def validate_for_each_progress(name: str, progress: Any) -> int:
+    """Validate one ``for_each`` entry and return its item count."""
+    base = f"for_each.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(f"{base} must be a mapping", base)
+    items = progress.get("items")
+    if not isinstance(items, list):
+        raise _shape(f"{base}.items must be a list", f"{base}.items")
+    current = progress.get("current_index")
+    if current is not None and not _is_index(current):
+        raise _shape(
+            f"{base}.current_index must be null or a non-boolean integer",
+            f"{base}.current_index",
+            current if not isinstance(current, (list, dict)) else None,
+        )
+    completed = progress.get("completed_indices", [])
+    field = f"{base}.completed_indices"
+    if not isinstance(completed, list):
+        raise _progress(f"{field} contains an out-of-range index", field)
+    if len(set(repr(index) for index in completed)) != len(completed):
+        raise _progress(f"{field} must not contain duplicate indices", field)
+    for index in completed:
+        if not _is_index(index) or not 0 <= index < len(items):
+            raise _progress(
+                f"{field} contains an out-of-range index",
+                field,
+                index if not isinstance(index, (list, dict)) else None,
+            )
+    if current is not None:
+        if current in completed:
+            raise _progress(f"{base}.current_index is already completed", f"{base}.current_index", current)
+        if not 0 <= current < len(items):
+            raise _progress(f"{base}.current_index is out of range", f"{base}.current_index", current)
+    return len(items)
+
+
+def _validate_history(progress: Mapping[str, Any], base: str, max_iterations: Optional[int]) -> list[int]:
+    field = f"{base}.completed_iterations"
+    completed = progress.get("completed_iterations", [])
+    if not isinstance(completed, list) or not all(
+        _is_index(index) and index >= 0 for index in completed
+    ):
+        raise _progress(f"{field} is not valid prior history", field)
+    if len(set(completed)) != len(completed):
+        raise _progress(f"{field} must not contain duplicate indices", field)
+    if max_iterations is not None and any(index >= max_iterations for index in completed):
+        raise _progress(f"{field} is not valid prior history", field)
+    return completed
+
+
+def _conflict(base: str) -> ResumeProjectionValidationError:
+    return _progress(
+        f"{base}.condition result conflicts with evaluation state",
+        f"{base}.last_condition_result",
+    )
+
+
+def _validate_active(
+    progress: Mapping[str, Any],
+    base: str,
+    current: int,
+    completed: list[int],
+    max_iterations: Optional[int],
+) -> None:
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise _progress(f"{base}.current_iteration is out of range", f"{base}.current_iteration", current)
+    if sorted(completed) != list(range(current)):
+        raise _progress(
+            f"{base}.completed_iterations is not valid prior history",
+            f"{base}.completed_iterations",
+        )
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if progress.get("exhausted") is True:
+        raise _conflict(base)
+    if evaluated is None:
+        if result is not None:
+            raise _conflict(base)
+    elif evaluated != current or not isinstance(result, bool):
+        raise _conflict(base)
+
+
+def _validate_terminal(
+    progress: Mapping[str, Any],
+    base: str,
+    completed: list[int],
+    max_iterations: Optional[int],
+    loop_row: Any,
+) -> None:
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if (
+        not _is_index(evaluated)
+        or evaluated not in completed
+        or sorted(completed) != list(range(evaluated + 1))
+    ):
+        raise _progress(
+            f"{base}.terminal progress requires completed evaluated history",
+            f"{base}.condition_evaluated_for_iteration",
+        )
+    exhausted = progress.get("exhausted") is True
+    if result is True:
+        if exhausted:
+            raise _conflict(base)
+        return
+    if result is not False or (max_iterations is not None and evaluated != max_iterations - 1):
+        raise _conflict(base)
+    if loop_row is None:  # the loop frame row was dropped; resume re-runs the loop step
+        return
+    row = loop_row if isinstance(loop_row, Mapping) else {}
+    if exhausted:
+        if row.get("status") != "completed":
+            raise _progress(f"{base}.successful exhaustion requires a completed frame", f"{base}.exhausted")
+        return
+    error = row.get("error")
+    if (
+        row.get("status") != "failed"
+        or not isinstance(error, Mapping)
+        or error.get("type") != "repeat_until_iterations_exhausted"
+    ):
+        raise _progress(f"{base}.failed exhaustion requires the terminal exhaustion error", f"{base}.exhausted")
+
+
+def validate_repeat_until_progress(
+    name: str,
+    progress: Any,
+    *,
+    max_iterations: Optional[int],
+    loop_row: Any,
+) -> Optional[int]:
+    """Validate one ``repeat_until`` entry; return its active/terminal iteration bound."""
+    base = f"repeat_until.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(f"{base} must be a mapping", base)
+    current = progress.get("current_iteration")
+    if current is not None and not _is_index(current):
+        raise _shape(
+            f"{base}.current_iteration must be null or a non-boolean integer",
+            f"{base}.current_iteration",
+            current if not isinstance(current, (list, dict)) else None,
+        )
+    if progress.get("exhausted") is not None and not isinstance(progress["exhausted"], bool):
+        raise _shape(f"{base}.exhausted must be boolean when present", f"{base}.exhausted")
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if (evaluated is not None and not _is_index(evaluated)) or (
+        result is not None and not isinstance(result, bool)
+    ):
+        raise _conflict(base)
+    completed = _validate_history(progress, base, max_iterations)
+    if current is not None:
+        _validate_active(progress, base, current, completed, max_iterations)
+    else:
+        _validate_terminal(progress, base, completed, max_iterations, loop_row)
+    return max(completed + ([current] if current is not None else []), default=-1) + 1
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..8b85792
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,392 @@
+"""Checksum-compatible resume projection integrity audit.
+
+``audit_scope`` validates every persisted identity of one scope (steps,
+current step, loop progress, call frames) against the projection of the bundle
+that owns that scope. It reads only the bundle and state it is handed and never
+mutates them. Failures raise ``ResumeProjectionIntegrityError`` carrying one
+stable diagnostic.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping, Optional
+
+from .call_frame_retry_lineage import (
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_bundle, workflow_import_bundle, workflow_provenance
+from .resume_slot_index import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    resolve_call_boundary,
+    resolve_resume_step_id,
+)
+
+__all__ = [
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RESUME_PROJECTION_INTEGRITY_ERROR",
+    "ReachedCall",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "audit_nested_scopes",
+    "audit_scope",
+    "index_retry_lineage",
+    "next_unused_retry_frame_id",
+    "projection_error_in_chain",
+    "resolve_reached_call",
+]
+
+RESUME_PROJECTION_INTEGRITY_ERROR = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_FRAME_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through entered call frames."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Persisted identities do not match the current projection."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def projection_error_in_chain(error: Any) -> Optional[dict[str, Any]]:
+    """Return the projection diagnostic carried by ``error`` or its wrapped causes."""
+    seen = 0
+    while isinstance(error, Mapping) and seen < 16:
+        if error.get("type") == RESUME_PROJECTION_INTEGRITY_ERROR:
+            return error  # type: ignore[return-value]
+        context = error.get("context")
+        error = context.get("error") if isinstance(context, Mapping) else None
+        seen += 1
+    return None
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+class _Scope:
+    """Audit context for one bundle/state pair; builds diagnostics."""
+
+    def __init__(self, bundle: Any, state: Mapping[str, Any], path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.path = path
+        provenance = workflow_provenance(bundle)
+        self.workflow_file = str(getattr(provenance, "workflow_path", "") or "")
+
+    def fail(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+        candidate_count: Optional[int] = None,
+        call_boundary_step_id: Optional[str] = None,
+    ) -> ResumeProjectionIntegrityError:
+        return ResumeProjectionIntegrityError(
+            {
+                "type": RESUME_PROJECTION_INTEGRITY_ERROR,
+                "message": f"Resume projection integrity audit failed: {reason}",
+                "context": {
+                    "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                    "reason": reason,
+                    "scope_path": self.path.as_context(),
+                    "field": field,
+                    "offending_value": _scalar(value),
+                    "expected_owner": {
+                        "workflow_file": self.workflow_file,
+                        "workflow_checksum": self.state.get("workflow_checksum"),
+                        "projection_scope": self.path.projection_scope,
+                    },
+                    "candidate_count": candidate_count,
+                    "call_boundary_step_id": call_boundary_step_id,
+                },
+            }
+        )
+
+    def mapping(self, name: str) -> Mapping[str, Any]:
+        value = self.state.get(name)
+        if value is None:
+            return {}
+        if not isinstance(value, Mapping):
+            raise self.fail("unsupported_shape", field=name)
+        return value
+
+    def slot_index(self) -> ResumeProjectionSlotIndex:
+        try:
+            return self.bundle.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            raise self.fail(exc.reason, field=exc.field, value=exc.value) from exc
+
+    def identity(self, value: Any, field: str) -> str:
+        if not isinstance(value, str) or not value:
+            raise self.fail("unsupported_shape", field=field, value=value)
+        return value
+
+
+def _audit_step_rows(scope: _Scope, slots: ResumeProjectionSlotIndex) -> None:
+    for_each_keys = {loop.frame_key for loop in scope.bundle.projection.for_each_nodes.values()}
+    for name, row in scope.mapping("steps").items():
+        if isinstance(row, list) and name in for_each_keys:
+            continue
+        if not isinstance(row, Mapping):
+            raise scope.fail("unsupported_shape", field=f"steps.{name}")
+        if "step_id" not in row:
+            continue
+        field = f"steps.{name}.step_id"
+        step_id = scope.identity(row["step_id"], field)
+        resolution = resolve_resume_step_id(slots, step_id, name)
+        if resolution.slot is not None:
+            continue
+        if resolution.candidate_count == 0:
+            owned = name in slots.presentation_keys
+            reason = "unknown_explicit_step_id" if owned else "unclaimed_explicit_step_row"
+            raise scope.fail(reason, field=field, value=step_id, candidate_count=0)
+        raise scope.fail(
+            "presentation_slot_mismatch",
+            field=field,
+            value=step_id,
+            candidate_count=resolution.candidate_count,
+        )
+
+
+def _audit_current_step(scope: _Scope, slots: ResumeProjectionSlotIndex) -> None:
+    current = scope.state.get("current_step")
+    if current is None:
+        return
+    if not isinstance(current, Mapping):
+        raise scope.fail("unsupported_shape", field="current_step")
+    field = "current_step.step_id"
+    if "step_id" not in current:
+        raise scope.fail("missing_required_identity", field=field)
+    step_id = scope.identity(current["step_id"], field)
+    name = current.get("name")
+    resolution = resolve_resume_step_id(slots, step_id, name if isinstance(name, str) else None)
+    if resolution.candidate_count == 0:
+        raise scope.fail("out_of_scope_step_id", field=field, value=step_id, candidate_count=0)
+    if resolution.slot is None:
+        raise scope.fail(
+            "presentation_slot_mismatch",
+            field=field,
+            value=step_id,
+            candidate_count=resolution.candidate_count,
+        )
+
+
+def _frame_boundary(scope: _Scope, slots: ResumeProjectionSlotIndex, frame_id: str, frame: Any):
+    """Validate one frame's own identity fields and return ``(call_step_id, boundary)``."""
+    prefix = f"call_frames.{frame_id}"
+    if not isinstance(frame, Mapping):
+        raise scope.fail("unsupported_shape", field=prefix)
+    if "call_step_id" not in frame:
+        raise scope.fail("missing_required_identity", field=f"{prefix}.call_step_id")
+    call_step_id = scope.identity(frame["call_step_id"], f"{prefix}.call_step_id")
+    field = f"{prefix}.call_step_id"
+    if frame.get("status") not in _FRAME_STATUSES:
+        raise scope.fail(
+            "unsupported_shape",
+            field=f"{prefix}.status",
+            value=frame.get("status"),
+            call_boundary_step_id=call_step_id,
+        )
+    if resolve_resume_step_id(slots, call_step_id).candidate_count == 0:
+        raise scope.fail("out_of_scope_step_id", field=field, value=call_step_id, candidate_count=0)
+    resolution = resolve_call_boundary(slots, call_step_id)
+    if resolution.boundary is None:
+        reason = "missing_call_boundary" if resolution.candidate_count == 0 else "ambiguous_call_boundary"
+        raise scope.fail(
+            reason,
+            field=field,
+            value=call_step_id,
+            candidate_count=resolution.candidate_count,
+            call_boundary_step_id=call_step_id,
+        )
+    boundary = resolution.boundary
+    alias = boundary.import_alias
+    if "import_alias" not in frame:
+        raise scope.fail(
+            "missing_required_identity",
+            field=f"{prefix}.import_alias",
+            call_boundary_step_id=call_step_id,
+        )
+    if frame["import_alias"] != alias:
+        raise scope.fail(
+            "persisted_import_alias_mismatch",
+            field=f"{prefix}.import_alias",
+            value=frame["import_alias"],
+            candidate_count=1,
+            call_boundary_step_id=call_step_id,
+        )
+    if workflow_import_bundle(scope.bundle, alias) is None:
+        raise scope.fail(
+            "missing_imported_bundle",
+            field=f"imports.{alias}",
+            value=alias,
+            candidate_count=1,
+            call_boundary_step_id=call_step_id,
+        )
+    return call_step_id, boundary
+
+
+def frontend_kind_of(bundle: Any) -> Optional[str]:
+    return getattr(workflow_provenance(bundle), "frontend_kind", None)
+
+
+def audit_call_lineage(
+    scope: _Scope,
+    call_step_id: str,
+    frames: list[tuple[str, Any]],
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    try:
+        return index_retry_lineage(call_step_id, frames, frontend_kind=frontend_kind)
+    except CallFrameRetryLineageError as exc:
+        live = [item for item in frames if isinstance(item[1], Mapping) and item[1].get("status") != "completed"]
+        ambiguous = exc.reason == "ambiguous_resumable_call_frame"
+        raise scope.fail(
+            exc.reason,
+            field="call_frames",
+            value=len(live) if ambiguous else None,
+            candidate_count=len(live) if ambiguous else None,
+            call_boundary_step_id=call_step_id,
+        ) from exc
+
+
+def _audit_call_frames(scope: _Scope, slots: ResumeProjectionSlotIndex) -> None:
+    by_call: dict[str, list[tuple[str, Any]]] = {}
+    boundaries: dict[str, Any] = {}
+    for frame_id, frame in scope.mapping("call_frames").items():
+        call_step_id, boundary = _frame_boundary(scope, slots, frame_id, frame)
+        by_call.setdefault(call_step_id, []).append((frame_id, frame))
+        boundaries[call_step_id] = boundary
+    for call_step_id, frames in by_call.items():
+        imported = workflow_import_bundle(scope.bundle, boundaries[call_step_id].import_alias)
+        audit_call_lineage(scope, call_step_id, frames, frontend_kind_of(imported))
+
+
+def audit_scope(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against ``bundle``'s projection."""
+    if hasattr(state, "to_dict"):
+        state = state.to_dict()
+    if workflow_bundle(bundle) is None:  # no typed projection to audit against
+        return
+    scope = _Scope(bundle, state, scope_path)
+    scope.mapping("steps")
+    scope.mapping("call_frames")
+    slots = scope.slot_index()
+    _audit_step_rows(scope, slots)
+    _audit_current_step(scope, slots)
+    _audit_call_frames(scope, slots)
+
+
+def audit_nested_scopes(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit every non-completed nested call frame of an already audited scope."""
+    if hasattr(state, "to_dict"):
+        state = state.to_dict()
+    scope = _Scope(bundle, state, scope_path)
+    slots = scope.slot_index()
+    for frame_id, frame in scope.mapping("call_frames").items():
+        if frame.get("status") == "completed":
+            continue
+        boundary = _frame_boundary(scope, slots, frame_id, frame)[1]
+        child_bundle = workflow_import_bundle(bundle, boundary.import_alias)
+        child_state = frame.get("state")
+        if not isinstance(child_state, Mapping):
+            raise scope.fail("unsupported_shape", field=f"call_frames.{frame_id}.state")
+        child_path = scope_path.child(frame_id)
+        audit_scope(child_bundle, child_state, child_path)
+        audit_nested_scopes(child_bundle, child_state, child_path)
+
+
+@dataclass(frozen=True)
+class ReachedCall:
+    """The current boundary, selected callee bundle and retry lineage of a reached call."""
+
+    boundary: Any
+    imported_bundle: Any
+    lineage: CallFrameRetryLineage
+
+
+def resolve_reached_call(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    call_step_id: str,
+    *,
+    select_import: Callable[[Any, str], Any],
+    is_workflow_lisp: Callable[[Any], bool],
+) -> ReachedCall:
+    """Resolve a reached call's persisted caller identity against the parent projection.
+
+    ``select_import`` picks the callee bundle by the boundary's current import alias;
+    ``is_workflow_lisp`` decides whether that callee owns a retry lineage.
+    """
+    scope = _Scope(bundle, state, scope_path)
+    frames = scope.mapping("call_frames")
+    slots = scope.slot_index()
+    if resolve_resume_step_id(slots, call_step_id).candidate_count == 0:
+        raise scope.fail("out_of_scope_step_id", field="call_step_id", value=call_step_id, candidate_count=0)
+    resolution = bundle.projection.resolve_call_boundary(slots, call_step_id)
+    boundary = resolution.boundary
+    if boundary is None:
+        reason = "missing_call_boundary" if resolution.candidate_count == 0 else "ambiguous_call_boundary"
+        raise scope.fail(
+            reason,
+            field="call_step_id",
+            value=call_step_id,
+            candidate_count=resolution.candidate_count,
+            call_boundary_step_id=call_step_id,
+        )
+    imported = select_import(bundle, boundary.import_alias)
+    if imported is None:
+        raise scope.fail(
+            "missing_imported_bundle",
+            field=f"imports.{boundary.import_alias}",
+            value=boundary.import_alias,
+            candidate_count=1,
+            call_boundary_step_id=call_step_id,
+        )
+    owned: list[tuple[str, Any]] = []
+    for frame_id, frame in frames.items():
+        if not isinstance(frame, Mapping):
+            raise scope.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+        if frame.get("call_step_id") == call_step_id:
+            _frame_boundary(scope, slots, frame_id, frame)
+            owned.append((frame_id, frame))
+    frontend_kind = "workflow_lisp" if is_workflow_lisp(imported) else None
+    lineage = audit_call_lineage(scope, call_step_id, owned, frontend_kind)
+    return ReachedCall(boundary, imported, lineage)

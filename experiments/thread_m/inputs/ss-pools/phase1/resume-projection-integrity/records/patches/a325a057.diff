diff --git a/orchestrator/yaml_import_aliases.py b/orchestrator/yaml_import_aliases.py
new file mode 100644
index 0000000..f2501b5
--- /dev/null
+++ b/orchestrator/yaml_import_aliases.py
@@ -0,0 +1,54 @@
+"""Node-level detection of duplicate classic-YAML import aliases.
+
+A plain ``yaml.load`` silently collapses duplicate mapping keys and ``<<``
+merges, so duplicate ``imports`` aliases/sections are only visible on the
+composed node graph. ``find_import_duplicates`` composes the text with the
+given loader class and returns error messages (empty list when clean).
+"""
+
+from typing import Iterator, List, Tuple
+
+import yaml
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _pos(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _effective_pairs(node: yaml.Node) -> Iterator[Tuple[yaml.Node, yaml.Node]]:
+    """Yield (key, value) pairs of a mapping, expanding ``<<`` merge sources."""
+    if not isinstance(node, yaml.MappingNode):
+        return
+    for key, value in node.value:
+        if key.tag == _MERGE_TAG:
+            sources = value.value if isinstance(value, yaml.SequenceNode) else [value]
+            for source in sources:
+                yield from _effective_pairs(source)
+        else:
+            yield key, value
+
+
+def find_import_duplicates(text: str, loader: type) -> List[str]:
+    """Return duplicate import alias / duplicate top-level ``imports`` errors."""
+    root = yaml.compose(text, Loader=loader)
+    sections = [
+        (key, value) for key, value in _effective_pairs(root)
+        if isinstance(key, yaml.ScalarNode) and key.value == "imports"
+    ]
+    aliases: dict = {}
+    for _, section in sections:
+        for key, _ in _effective_pairs(section):
+            if isinstance(key, yaml.ScalarNode):
+                aliases.setdefault(key.value, []).append(key)
+    errors = [
+        f"imports.{alias}: duplicate import alias ({'; '.join(_pos(k) for k in keys)})"
+        for alias, keys in aliases.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(
+            f"imports: duplicate top-level mapping ({'; '.join(_pos(k) for k, _ in sections)})"
+        )
+    return errors

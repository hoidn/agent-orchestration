@@ -0,0 +1,109 @@
+"""Classic-YAML import alias duplicate detection happens before bundle construction."""
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Noop
+    command: ["true"]
+"""
+
+STEPS = """\
+steps:
+  - name: Noop
+    command: ["true"]
+"""
+
+
+@pytest.fixture
+def bundle_calls(monkeypatch):
+    calls = []
+    real = loader_module.build_loaded_workflow_bundle
+
+    def spy(surface, **kwargs):
+        calls.append(surface)
+        return real(surface, **kwargs)
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", spy)
+    return calls
+
+
+def _load_root(tmp_path, body: str):
+    for name in ("a", "b"):
+        (tmp_path / f"{name}.yaml").write_text(LIBRARY)
+    workflow = tmp_path / "root.yaml"
+    workflow.write_text(body + STEPS)
+    return WorkflowLoader(tmp_path).load(workflow)
+
+
+def _messages(excinfo) -> list[str]:
+    return [error.message for error in excinfo.value.errors]
+
+
+def _assert_rejected(tmp_path, bundle_calls, body: str) -> list[str]:
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        _load_root(tmp_path, body)
+    assert bundle_calls == []
+    return _messages(excinfo)
+
+
+def test_duplicate_keys_in_one_imports_mapping(tmp_path, bundle_calls):
+    body = 'version: "2.5"\nname: root\nimports:\n  a: a.yaml\n  a: b.yaml\n'
+    assert _assert_rejected(tmp_path, bundle_calls, body) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 5, column 3"
+    ]
+
+
+def test_merge_inside_imports_repeating_alias(tmp_path, bundle_calls):
+    body = (
+        'version: "2.5"\nname: root\nbase: &base\n  a: a.yaml\n'
+        "imports:\n  <<: *base\n  a: b.yaml\n"
+    )
+    assert _assert_rejected(tmp_path, bundle_calls, body) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 7, column 3"
+    ]
+
+
+def test_repeated_sections_with_repeated_alias_report_alias_only(tmp_path, bundle_calls):
+    body = 'version: "2.5"\nname: root\nimports:\n  a: a.yaml\nimports:\n  a: b.yaml\n'
+    assert _assert_rejected(tmp_path, bundle_calls, body) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 6, column 3"
+    ]
+
+
+def test_top_level_merge_sources_each_carrying_imports(tmp_path, bundle_calls):
+    body = (
+        'x: &x\n  imports:\n    a: a.yaml\ny: &y\n  imports:\n    a: b.yaml\n'
+        'version: "2.5"\nname: root\n<<: [*x, *y]\n'
+    )
+    messages = _assert_rejected(tmp_path, bundle_calls, body)
+    assert messages == ["imports.a: duplicate import alias at line 3, column 5; line 6, column 5"]
+
+
+def test_repeated_sections_with_distinct_aliases(tmp_path, bundle_calls):
+    body = 'version: "2.5"\nname: root\nimports:\n  a: a.yaml\nimports:\n  b: b.yaml\n'
+    assert _assert_rejected(tmp_path, bundle_calls, body) == [
+        "imports: duplicate top-level mapping at line 3, column 1; line 5, column 1"
+    ]
+
+
+def test_merged_and_explicit_sections_with_distinct_aliases(tmp_path, bundle_calls):
+    body = (
+        'base: &base\n  imports:\n    a: a.yaml\nversion: "2.5"\nname: root\n'
+        "<<: *base\nimports:\n  b: b.yaml\n"
+    )
+    assert _assert_rejected(tmp_path, bundle_calls, body) == [
+        "imports: duplicate top-level mapping at line 2, column 3; line 7, column 1"
+    ]
+
+
+def test_single_merged_imports_section_loads(tmp_path, bundle_calls):
+    body = 'version: "2.5"\nname: root\n<<: &base\n  imports:\n    a: a.yaml\n    b: b.yaml\n'
+    _load_root(tmp_path, body)
+    assert bundle_calls

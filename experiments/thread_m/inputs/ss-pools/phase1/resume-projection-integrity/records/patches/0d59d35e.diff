+    tmp_path: Path, cleanup: str, cleanup_status: str, failure_error
+) -> None:
+    bundle = WorkflowLoader(tmp_path).load_bundle(_sticky_root(tmp_path, cleanup=cleanup))
+    manager = StateManager(tmp_path, run_id="sticky-flow")
+    manager.initialize("sticky.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] in {"completed", "failed"}
+    for marker in ("recovered.txt", "cleaned.txt"):

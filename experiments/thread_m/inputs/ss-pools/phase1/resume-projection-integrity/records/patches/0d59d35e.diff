+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["steps"]["InvokeLeaf"]["step_id"] = "root.stale_local"
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    persisted.steps.pop("Recover", None)
+    persisted.finalization = {}
+    manager._write_state()
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert result["status"] == "failed"
+    assert not (tmp_path / "recovered.txt").exists()
+    assert result["error"]["type"] == "resume_projection_integrity_error"
+    assert result["steps"]["finally.Cleanup"]["status"] == cleanup_status
+    finalization = result["finalization"]
+    if failure_error == "absent":
+        assert "failure" not in finalization
+    else:
+        assert finalization["status"] == "failed"
+        assert finalization["failure"] == {
+            "step": "finally.Cleanup",
+            "step_id": result["steps"]["finally.Cleanup"]["step_id"],
+            "error": None,
+        }

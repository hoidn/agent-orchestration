index 0000000..0218159
--- /dev/null
+++ b/tests/test_failure_envelope_forensic_current_step.py
@@ -0,0 +1,194 @@
+"""Failure envelopes that leave current_step untouched: persistence and observability."""
+
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+import yaml
+
+from orchestrator.dashboard.projection import RunProjector
+from orchestrator.dashboard.scanner import RunScanner
+from orchestrator.loader import WorkflowLoader
+from orchestrator.monitor.classifier import classify_run
+from orchestrator.monitor.models import MonitorEventKind, MonitorRun, MonitorWorkspace
+from orchestrator.observability.report import (
+    build_status_snapshot,
+    derive_status_projection,
+    render_status_markdown,
+)
+from orchestrator.state import StateManager
+
+_WORKFLOW = {
+    "version": "1.3",
+    "name": "forensic",
+    "steps": [
+        {"name": "Prep", "command": ["bash", "-lc", "true"]},
+        {"name": "Draft", "provider": "codex"},
+    ],
+}
+
+
+def _started_manager(tmp_path: Path) -> StateManager:
+    (tmp_path / "wf.yaml").write_text(yaml.safe_dump(_WORKFLOW), encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="run1")
+    manager.initialize("wf.yaml")
+    manager.start_step("Draft", 0, "provider")
+    raw = json.loads(manager.state_file.read_text())
+    raw["unknown_root_field"] = {"keep": True}
+    manager.state_file.write_text(json.dumps(raw))
+    return manager
+
+
+def _record_mismatch(manager: StateManager) -> None:
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="wf.yaml",
+        persisted_checksum="sha256:old",
+        current_checksum="sha256:new",
+        reason="workflow_modified",
+    )
+
+
+def _without(payload: dict, *keys: str) -> dict:
+    return {k: v for k, v in payload.items() if k not in keys}
+
+
+def test_checksum_mismatch_changes_only_status_error_updated_at(tmp_path: Path):
+    manager = _started_manager(tmp_path)
+    before = json.loads(manager.state_file.read_text())
+
+    _record_mismatch(manager)
+
+    after = json.loads(manager.state_file.read_text())
+    assert _without(after, "status", "error", "updated_at") == _without(
+        before, "status", "error", "updated_at"
+    )
+
+
+def test_checksum_mismatch_persists_failed_envelope(tmp_path: Path):
+    manager = _started_manager(tmp_path)
+    _record_mismatch(manager)
+
+    after = json.loads(manager.state_file.read_text())
+    assert (after["status"], after["error"]) == (
+        "failed",
+        {
+            "type": "workflow_checksum_mismatch",
+            "message": "Workflow has been modified since the run started",
+            "context": {
+                "workflow_file": "wf.yaml",
+                "persisted_checksum": "sha256:old",
+                "current_checksum": "sha256:new",
+                "reason": "workflow_modified",
+            },
+        },
+    )
+
+
+def test_checksum_mismatch_refreshes_updated_at(tmp_path: Path):
+    manager = _started_manager(tmp_path)
+    before = json.loads(manager.state_file.read_text())["updated_at"]
+    _record_mismatch(manager)
+    assert json.loads(manager.state_file.read_text())["updated_at"] > before
+
+
+def test_checksum_mismatch_rejects_unknown_reason(tmp_path: Path):
+    manager = _started_manager(tmp_path)
+    with pytest.raises(ValueError):
+        manager.record_workflow_checksum_mismatch(
+            workflow_file=None, persisted_checksum=None, current_checksum=None, reason="nope"
+        )
+
+
+def test_checksum_mismatch_does_not_call_fail_run(tmp_path: Path, monkeypatch):
+    manager = _started_manager(tmp_path)
+    monkeypatch.setattr(manager, "fail_run", lambda *a, **k: pytest.fail("fail_run called"))
+    _record_mismatch(manager)
+
+
+def test_resume_projection_integrity_failure_changes_only_envelope(tmp_path: Path):
+    manager = _started_manager(tmp_path)
+    before = json.loads(manager.state_file.read_text())
+    error = {"type": "resume_projection_integrity_error", "message": "bad", "context": {"x": 1}}
+
+    manager.record_resume_projection_integrity_failure(error)
+
+    after = json.loads(manager.state_file.read_text())
+    assert (after["status"], after["error"], _without(after, "status", "error", "updated_at")) == (
+        "failed",
+        error,
+        _without(before, "status", "error", "updated_at"),
+    )
+
+
+def _forensic_state(tmp_path: Path, error_type: str) -> dict:
+    manager = _started_manager(tmp_path)
+    if error_type == "workflow_checksum_mismatch":
+        _record_mismatch(manager)
+    else:
+        manager.record_resume_projection_integrity_failure({"type": error_type, "message": "bad"})
+    return json.loads(manager.state_file.read_text())
+
+
+def _snapshot(tmp_path: Path, state: dict) -> dict:
+    bundle = WorkflowLoader(tmp_path).load_bundle(tmp_path / "wf.yaml")
+    return build_status_snapshot(bundle, state, tmp_path / ".orchestrate" / "runs" / "run1")
+
+
+@pytest.fixture(params=["workflow_checksum_mismatch", "resume_projection_integrity_error"])
+def forensic_state(request, tmp_path: Path) -> dict:
+    return _forensic_state(tmp_path, request.param)
+
+
+def _draft(snapshot: dict) -> dict:
+    return next(step for step in snapshot["steps"] if step["name"] == "Draft")
+
+
+def test_snapshot_shows_forensic_current_step_as_pending(tmp_path: Path, forensic_state):
+    draft = _draft(_snapshot(tmp_path, forensic_state))
+    assert (draft["status"], draft["summary"], draft["current_visit_count"]) == (
+        "pending",
+        "pending",
+        None,
+    )
+
+
+def test_snapshot_counts_forensic_current_step_as_pending(tmp_path: Path, forensic_state):
+    progress = _snapshot(tmp_path, forensic_state)["progress"]
+    assert (progress["running"], progress["pending"]) == (0, 2)
+
+
+def test_markdown_does_not_call_forensic_current_step_in_progress(tmp_path: Path, forensic_state):
+    markdown = render_status_markdown(_snapshot(tmp_path, forensic_state))
+    assert "in progress" not in markdown and "### Draft (pending)" in markdown
+
+
+def test_ordinary_failed_run_keeps_current_step_running(tmp_path: Path):
+    state = _forensic_state(tmp_path, "workflow_checksum_mismatch")
+    state["error"] = {"type": "step_failed", "message": "x"}
+    assert _draft(_snapshot(tmp_path, state))["status"] == "running"
+
+
+def test_status_projection_does_not_treat_forensic_step_as_stale_live(forensic_state):
+    projection = derive_status_projection(
+        forensic_state, [], now=datetime(2099, 1, 1, tzinfo=timezone.utc)
+    )
+    assert (projection["display_status"], projection["display_status_reason"]) == ("failed", None)
+
+
+def test_monitor_classifies_forensic_run_as_failed_not_stalled(tmp_path: Path, forensic_state):

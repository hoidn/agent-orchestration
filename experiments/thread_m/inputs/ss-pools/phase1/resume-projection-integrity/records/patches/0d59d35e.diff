new file mode 100644
index 0000000..bfcc37c
--- /dev/null
+++ b/orchestrator/yaml_import_duplicates.py
@@ -0,0 +1,64 @@
+"""Detect duplicate classic-YAML import aliases and repeated top-level `imports` sections.
+
+PyYAML's constructor silently keeps the last value for duplicate keys and
+resolves `<<` merges, so these checks run on the composed node graph
+(`yaml.compose`) where every key node still carries its source mark.
+"""
+
+from collections import defaultdict
+from typing import Dict, Iterator, List
+
+import yaml
+
+MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _merge_sources(value: yaml.Node) -> List[yaml.Node]:
+    nodes = value.value if isinstance(value, yaml.SequenceNode) else [value]
+    return [node for node in nodes if isinstance(node, yaml.MappingNode)]
+
+
+def _iter_pairs(mapping: yaml.MappingNode) -> Iterator[tuple]:
+    """Yield (key, value) pairs of a mapping, expanding `<<` merge sources recursively."""
+    for key, value in mapping.value:
+        if key.tag == MERGE_TAG:
+            for source in _merge_sources(value):
+                yield from _iter_pairs(source)
+        else:
+            yield key, value
+
+
+def find_import_duplicate_errors(root: yaml.Node) -> List[str]:
+    """Return error messages for repeated import aliases or repeated `imports` sections.
+
+    A repeated alias is reported once as `imports.<alias>: duplicate import alias`;
+    repeated sections are only reported (`imports: duplicate top-level mapping`)
+    when all aliases are distinct.
+    """
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    section_keys = []
+    alias_keys: Dict[str, List[yaml.Node]] = defaultdict(list)
+    for key, value in _iter_pairs(root):
+        if not (isinstance(key, yaml.ScalarNode) and key.value == "imports"):
+            continue
+        section_keys.append(key)
+        if isinstance(value, yaml.MappingNode):
+            for alias_key, _ in _iter_pairs(value):
+                if isinstance(alias_key, yaml.ScalarNode):
+                    alias_keys[alias_key.value].append(alias_key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias at " + "; ".join(_position(k) for k in keys)
+        for alias, keys in alias_keys.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(section_keys) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping at " + "; ".join(_position(k) for k in section_keys)
+        )
+    return errors

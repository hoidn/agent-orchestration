index 0000000..b29ee8c
--- /dev/null
+++ b/orchestrator/workflow/resume_slots.py
@@ -0,0 +1,178 @@
+"""Resume slot enumeration over a ``WorkflowStateProjection``.
+
+Candidate ids come only from projection-owned APIs (static step ids and the
+loop/call runtime-id builders); persisted ids are never split or normalized.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Mapping, Optional
+
+from .executable_ir import WorkflowRegion
+from .resume_loop_progress import (
+    ResumeProjectionValidationError,
+    validate_for_each_progress,
+    validate_repeat_until_progress,
+)
+
+if TYPE_CHECKING:
+    from .state_projection import CallBoundaryProjection, WorkflowStateProjection
+
+__all__ = [
+    "ResumeCallBoundaryResolution",
+    "ResumeIdentityResolution",
+    "ResumeProjectionSlotIndex",
+    "ResumeProjectionValidationError",
+    "ResumeSlot",
+    "enumerate_resume_slots",
+    "resolve_call_boundary",
+    "resolve_resume_step_id",
+]
+
+
+@dataclass(frozen=True)
+class ResumeSlot:
+    """One persisted-identity slot the current projection can own."""
+
+    node_id: str
+    region: WorkflowRegion
+    presentation_key: str
+    step_id: str
+    iteration_index: Optional[int] = None
+
+
+@dataclass(frozen=True)
+class ResumeProjectionSlotIndex:
+    """Candidate slots for one scope's persisted state."""
+
+    candidates_by_step_id: Mapping[str, tuple[ResumeSlot, ...]]
+    call_boundaries_by_step_id: Mapping[str, tuple["CallBoundaryProjection", ...]]
+    unclaimed_explicit_rows: tuple[tuple[str, Any], ...] = ()
+
+
+@dataclass(frozen=True)
+class ResumeIdentityResolution:
+    slot: Optional[ResumeSlot]
+    candidate_count: int
+    exact_identity_candidate_count: int
+
+
+@dataclass(frozen=True)
+class ResumeCallBoundaryResolution:
+    boundary: Optional["CallBoundaryProjection"]
+    candidate_count: int
+
+
+def _iteration_indices(state: Mapping[str, Any], kind: str, frame_key: str) -> tuple[int, ...]:
+    """Iteration indices that persisted loop bookkeeping says can exist."""
+    section = state.get(kind)
+    progress = section.get(frame_key) if isinstance(section, Mapping) else None
+    if not isinstance(progress, Mapping):
+        return ()
+    if kind == "for_each":
+        items = progress.get("items")
+        return tuple(range(len(items))) if isinstance(items, list) else ()
+    found = set(progress.get("completed_iterations", ()))
+    found.add(progress.get("current_iteration"))
+    found.add(progress.get("condition_evaluated_for_iteration"))
+    return tuple(sorted(i for i in found if isinstance(i, int) and not isinstance(i, bool)))
+
+
+def _loop_iterations(
+    projection: "WorkflowStateProjection", state: Mapping[str, Any]
+) -> dict[str, tuple[str, tuple[int, ...]]]:
+    """Map loop node id -> (frame key, existing iteration indices)."""
+    loops: dict[str, tuple[str, tuple[int, ...]]] = {}
+    for kind, nodes in (("for_each", projection.for_each_nodes), ("repeat_until", projection.repeat_until_nodes)):
+        for node_id, loop in nodes.items():
+            loops[node_id] = (loop.frame_key, _iteration_indices(state, kind, loop.frame_key))
+    return loops
+
+
+def enumerate_resume_slots(
+    projection: "WorkflowStateProjection",
+    state: Mapping[str, Any],
+    max_iterations_by_loop: Mapping[str, Optional[int]],
+) -> ResumeProjectionSlotIndex:
+    """Enumerate candidate slots for ``state`` without mutating or backfilling it."""
+    validate_for_each_progress(state)
+    validate_repeat_until_progress(state, max_iterations_by_loop)
+    loops = _loop_iterations(projection, state)
+    candidates: dict[str, list[ResumeSlot]] = {}
+    owned_names: set[str] = set()
+
+    def add(slot: ResumeSlot) -> None:
+        candidates.setdefault(slot.step_id, []).append(slot)
+        owned_names.add(slot.presentation_key)
+
+    for node_id, entry in projection.entries_by_node_id.items():
+        if entry.compatibility_index is not None or entry.finalization_index is not None:
+            add(ResumeSlot(node_id, entry.region, entry.presentation_key, entry.step_id))
+    for kind_nodes in (projection.for_each_nodes, projection.repeat_until_nodes):
+        for loop_id, loop in kind_nodes.items():
+            for iteration in loops[loop_id][1]:
+                for nested_id in loop.nested_presentation_keys:
+                    nested = projection.entries_by_node_id.get(nested_id)
+                    if nested is None:
+                        continue
+                    add(ResumeSlot(
+                        nested_id,
+                        nested.region,
+                        loop.step_key(iteration, nested_id),
+                        loop.runtime_step_id(iteration, nested_id),
+                        iteration,
+                    ))
+
+    boundaries: dict[str, list["CallBoundaryProjection"]] = {}
+    for node_id, boundary in projection.call_boundaries.items():
+        owner = boundary.iteration_owner_node_id
+        indices: tuple[Optional[int], ...] = (None,) if owner is None else loops.get(owner, ("", ()))[1]
+        for iteration in indices:
+            runtime_id = projection.call_boundary_runtime_step_id(node_id, iteration_index=iteration)
+            boundaries.setdefault(runtime_id, []).append(boundary)
+
+    steps = state.get("steps")
+    unclaimed = tuple(
+        (name, copy.deepcopy(row["step_id"]))
+        for name, row in (steps.items() if isinstance(steps, Mapping) else ())
+        if isinstance(row, Mapping) and "step_id" in row and name not in owned_names
+    )
+    return ResumeProjectionSlotIndex(
+        candidates_by_step_id={key: tuple(value) for key, value in candidates.items()},
+        call_boundaries_by_step_id={key: tuple(value) for key, value in boundaries.items()},
+        unclaimed_explicit_rows=unclaimed,
+    )
+
+
+def resolve_resume_step_id(
+    slot_index: ResumeProjectionSlotIndex,
+    step_id: Any,
+    presentation_key: Optional[str] = None,
+) -> ResumeIdentityResolution:
+    """Resolve one persisted step id to its unique candidate slot, if any."""
+    found = slot_index.candidates_by_step_id.get(step_id, ()) if isinstance(step_id, str) else ()
+    exact = tuple(
+        slot for slot in found if presentation_key is None or slot.presentation_key == presentation_key
+    )
+    return ResumeIdentityResolution(
+        slot=exact[0] if len(exact) == 1 else None,
+        candidate_count=len(found),
+        exact_identity_candidate_count=len(exact),
+    )
+
+
+def resolve_call_boundary(
+    slot_index: ResumeProjectionSlotIndex, call_step_id: Any
+) -> ResumeCallBoundaryResolution:
+    """Resolve one persisted caller identity to its unique current call boundary."""
+    found = (
+        slot_index.call_boundaries_by_step_id.get(call_step_id, ())
+        if isinstance(call_step_id, str)
+        else ()
+    )
+    return ResumeCallBoundaryResolution(
+        boundary=found[0] if len(found) == 1 else None,
+        candidate_count=len(found),
+    )

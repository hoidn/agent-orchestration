new file mode 100644
index 0000000..62d0b43
--- /dev/null
+++ b/tests/test_workflow_lisp_frontend_provenance.py
@@ -0,0 +1,84 @@
+"""Typed `provenance.frontend_kind` on Workflow Lisp compiled bundles."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow_lisp.build import FrontendBuildRequest, build_frontend_bundle
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.command_boundaries import ExternalToolBinding
+
+
+FIXTURES = Path(__file__).parent / "fixtures" / "workflow_lisp"
+CLI_FIXTURES = FIXTURES / "cli"
+SOURCE_ROOT = FIXTURES / "modules" / "valid" / "imported_bundle_mix"
+ENTRYPOINT = SOURCE_ROOT / "neurips" / "entry.orc"
+ROOT_NAME = "neurips/entry::orchestrate"
+HELPER_NAME = "neurips/helper::provider-attempt"
+
+
+@pytest.fixture
+def yaml_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(CLI_FIXTURES / "imported_selector.yaml")
+
+
+@pytest.fixture
+def compiled(tmp_path: Path, yaml_bundle):
+    return compile_stage3_entrypoint(
+        ENTRYPOINT,
+        source_roots=(SOURCE_ROOT,),
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={"prompts.implementation.execute": "prompts/implementation/execute.md"},
+        imported_workflow_bundles={"selector-run": yaml_bundle},
+        command_boundaries={
+            "run_checks": ExternalToolBinding(
+                name="run_checks",
+                stable_command=("python", "scripts/run_checks.py"),
+            )
+        },
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+
+
+def test_every_validated_bundle_is_marked_workflow_lisp(compiled) -> None:
+    kinds = {
+        name: bundle.provenance.frontend_kind
+        for name, bundle in compiled.validated_bundles_by_name.items()
+    }
+    assert kinds and set(kinds.values()) == {"workflow_lisp"}, kinds
+
+
+def test_imported_workflow_lisp_bundle_is_marked_workflow_lisp(compiled) -> None:
+    root = compiled.validated_bundles_by_name[ROOT_NAME]
+    assert root.imports[HELPER_NAME].provenance.frontend_kind == "workflow_lisp"
+
+
+def test_imported_yaml_bundle_keeps_classic_provenance(compiled, yaml_bundle) -> None:
+    root = compiled.validated_bundles_by_name[ROOT_NAME]
+    assert root.imports["selector-run"].provenance.frontend_kind is None
+
+
+def test_imported_yaml_bundle_is_linked_as_same_object(compiled, yaml_bundle) -> None:
+    root = compiled.validated_bundles_by_name[ROOT_NAME]
+    assert root.imports["selector-run"] is yaml_bundle
+
+
+def test_build_frontend_bundle_keeps_workflow_lisp_frontend_kind(tmp_path: Path) -> None:
+    result = build_frontend_bundle(
+        FrontendBuildRequest(
+            source_path=ENTRYPOINT,
+            source_roots=(SOURCE_ROOT, tmp_path),
+            entry_workflow="orchestrate",
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            emit_debug_yaml=False,
+            workspace_root=tmp_path,
+        )
+    )
+    assert result.validated_bundle.provenance.frontend_kind == "workflow_lisp"

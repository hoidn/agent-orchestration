diff --git a/tests/test_resume_projection_integrity.py b/tests/test_resume_projection_integrity.py
new file mode 100644
index 0000000..2d3495d
--- /dev/null
+++ b/tests/test_resume_projection_integrity.py
@@ -0,0 +1,532 @@
+"""Checksum-compatible resume projection integrity (specs/state.md)."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import replace
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.call_frame_retry_lineage import CallFrameRetryLineageError
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from orchestrator.workflow.state_projection import ResumeProjectionValidationError
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.test_workflow_state_projection import _write_projection_workflow
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+ROOT = ResumeScopePath.root("workflow.yaml")
+MIDDLE = "root.invoke_middle"
+
+
+@pytest.fixture
+def bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_workflow(tmp_path))
+
+
+@pytest.fixture
+def call_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+
+
+def _audit_reason(bundle, state, path=ROOT) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as excinfo:
+        audit_scope(bundle, state, path)
+    return excinfo.value.error["context"]
+
+
+def _frame(status="failed", step_id=MIDDLE, alias="middle", **extra) -> dict:
+    return {"status": status, "call_step_id": step_id, "import_alias": alias, **extra}
+
+
+def test_scope_path_snapshots_and_extends_without_mutation() -> None:
+    frames = ["a"]
+    path = ResumeScopePath("w.yaml", frames)
+    frames.append("b")
+    child = path.child("c")
+
+    assert path.call_frame_ids == ("a",)
+    assert (path.projection_scope, child.projection_scope) == ("call_frame", "call_frame")
+    assert ResumeScopePath.root("w.yaml").projection_scope == "root"
+    assert child.as_context() == [
+        {"kind": "root", "workflow_file": "w.yaml"},
+        {"kind": "call_frame", "frame_id": "a"},
+        {"kind": "call_frame", "frame_id": "c"},
+    ]
+
+
+def test_valid_state_and_absent_step_id_pass_without_backfill(bundle) -> None:
+    state = {"steps": {"SetReady": {"status": "completed", "step_id": "root.set_ready"}, "RouteReady": {"status": "skipped"}}}
+    snapshot = json.loads(json.dumps(state))
+
+    audit_scope(bundle, state, ROOT)
+
+    assert state == snapshot
+
+
+@pytest.mark.parametrize(
+    ("steps", "current_step", "reason", "field", "offending", "count"),
+    [
+        ({"SetReady": {"step_id": "root.gone"}}, None, "unknown_explicit_step_id", "steps.SetReady.step_id", "root.gone", 0),
+        ({"SetReady": {"step_id": "root.route_ready"}}, None, "presentation_slot_mismatch", "steps.SetReady.step_id", "root.route_ready", 1),
+        ({"Removed": {"step_id": "root.set_ready"}}, None, "unclaimed_explicit_step_row", "steps.Removed.step_id", "root.set_ready", 0),
+        ({}, {"name": "SetReady", "step_id": "root.gone"}, "out_of_scope_step_id", "current_step.step_id", "root.gone", 0),
+        ({}, {"name": "SetReady"}, "missing_required_identity", "current_step.step_id", None, None),
+        ({}, {"name": "SetReady", "step_id": "root.route_ready"}, "presentation_slot_mismatch", "current_step.step_id", "root.route_ready", 1),
+        ({"SetReady": {"step_id": ["x"]}}, None, "unsupported_shape", "steps.SetReady.step_id", None, None),
+        ({"SetReady": "oops"}, None, "unsupported_shape", "steps.SetReady", None, None),
+    ],
+)
+def test_explicit_identity_failures_carry_stable_diagnostics(
+    bundle, steps, current_step, reason, field, offending, count
+) -> None:
+    state = {"steps": steps, "workflow_checksum": "sha256:abc"}
+    if current_step is not None:
+        state["current_step"] = current_step
+
+    context = _audit_reason(bundle, state)
+
+    assert context["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    assert (context["reason"], context["field"], context["offending_value"], context["candidate_count"]) == (
+        reason,
+        field,
+        offending,
+        count,
+    )
+    assert context["scope_path"] == [{"kind": "root", "workflow_file": "workflow.yaml"}]
+    assert context["expected_owner"]["workflow_checksum"] == "sha256:abc"
+    assert context["expected_owner"]["projection_scope"] == "root"
+    assert context["call_boundary_step_id"] is None
+
+
+def test_container_shape_failures_never_expose_contents(bundle) -> None:
+    context = _audit_reason(bundle, {"steps": ["secret-value"]})
+
+    assert (context["reason"], context["field"], context["offending_value"]) == ("unsupported_shape", "steps", None)
+    assert "secret-value" not in json.dumps(context)
+
+
+@pytest.mark.parametrize(
+    ("progress", "message_reason"),
+    [
+        ({"items": ["a"], "completed_indices": [0, 0]}, "invalid_loop_progress"),
+        ({"items": ["a"], "completed_indices": [3]}, "invalid_loop_progress"),
+        ({"items": ["a"], "completed_indices": [0], "current_index": 0}, "invalid_loop_progress"),
+        ({"items": "x", "completed_indices": []}, "unsupported_shape"),
+        ({"items": ["a"], "completed_indices": [], "current_index": True}, "unsupported_shape"),
+    ],
+)
+def test_for_each_bookkeeping_is_validated(bundle, progress, message_reason) -> None:
+    with pytest.raises(ResumeProjectionValidationError) as excinfo:
+        bundle.projection.enumerate_resume_slots({"for_each": {"ProcessItems": progress}})
+
+    assert excinfo.value.reason == message_reason
+    assert str(excinfo.value) == excinfo.value.message
+
+
+@pytest.mark.parametrize(
+    ("progress", "step", "message"),
+    [
+        ({"current_iteration": 1, "completed_iterations": [1]}, None, "repeat_until.ReviewLoop.completed_iterations is not valid prior history"),
+        ({"current_iteration": 9, "completed_iterations": []}, None, "repeat_until.ReviewLoop.current_iteration is out of range"),
+        (
+            {"current_iteration": 0, "completed_iterations": [], "condition_evaluated_for_iteration": 0, "last_condition_result": None},
+            None,
+            "repeat_until.ReviewLoop.condition result conflicts with evaluation state",
+        ),
+        ({"current_iteration": None, "completed_iterations": []}, None, "repeat_until.ReviewLoop.terminal progress requires completed evaluated history"),
+        (
+            {"current_iteration": None, "completed_iterations": [0, 1, 2, 3], "condition_evaluated_for_iteration": 3, "last_condition_result": False, "exhausted": True},
+            {"status": "failed"},
+            "repeat_until.ReviewLoop.successful exhaustion requires a completed frame",
+        ),
+        (
+            {"current_iteration": None, "completed_iterations": [0, 1, 2, 3], "condition_evaluated_for_iteration": 3, "last_condition_result": False},
+            {"status": "failed", "error": {"type": "other"}},
+            "repeat_until.ReviewLoop.failed exhaustion requires the terminal exhaustion error",
+        ),
+    ],
+)
+def test_repeat_until_progress_is_validated_against_declared_maximum(bundle, progress, step, message) -> None:
+    state = {"repeat_until": {"ReviewLoop": progress}, "steps": {"ReviewLoop": step} if step else {}}
+
+    context = _audit_reason(bundle, state)
+
+    assert context["reason"] == "invalid_loop_progress"
+    assert context["field"].startswith(("repeat_until.ReviewLoop", "steps.ReviewLoop"))
+    with pytest.raises(ResumeProjectionValidationError, match="ReviewLoop"):
+        bundle.projection.enumerate_resume_slots(state, {"ReviewLoop": 4})
+    del message  # exact wording is pinned by the projection-level test below
+
+
+def test_repeat_until_messages_are_exact(bundle) -> None:
+    def message(progress, steps=None):
+        with pytest.raises(ResumeProjectionValidationError) as excinfo:
+            bundle.projection.enumerate_resume_slots(
+                {"repeat_until": {"ReviewLoop": progress}, "steps": steps or {}}, {"ReviewLoop": 4}
+            )
+        return str(excinfo.value)
+
+    assert message({"current_iteration": 1, "completed_iterations": [1]}) == (
+        "repeat_until.ReviewLoop.completed_iterations is not valid prior history"
+    )
+    assert message({"current_iteration": 4, "completed_iterations": []}) == (
+        "repeat_until.ReviewLoop.current_iteration is out of range"
+    )
+    assert message({"completed_iterations": [0, 1, 2, 3], "condition_evaluated_for_iteration": 3, "last_condition_result": False, "exhausted": True}, {"ReviewLoop": {"status": "failed"}}) == (
+        "repeat_until.ReviewLoop.successful exhaustion requires a completed frame"
+    )
+    assert message({"completed_iterations": [0, 1, 2, 3], "condition_evaluated_for_iteration": 3, "last_condition_result": False}, {"ReviewLoop": {"status": "failed"}}) == (
+        "repeat_until.ReviewLoop.failed exhaustion requires the terminal exhaustion error"
+    )
+
+
+def test_valid_terminal_forms_are_accepted(bundle) -> None:
+    success = {"completed_iterations": [0, 1], "condition_evaluated_for_iteration": 1, "last_condition_result": True}
+    exhausted_ok = {"completed_iterations": [0, 1, 2, 3], "condition_evaluated_for_iteration": 3, "last_condition_result": False, "exhausted": True}
+    exhausted_failed = {key: value for key, value in exhausted_ok.items() if key != "exhausted"}
+    failed_row = {"status": "failed", "error": {"type": "repeat_until_iterations_exhausted"}}
+
+    for progress, row in ((success, None), (exhausted_ok, {"status": "completed"}), (exhausted_failed, failed_row)):
+        audit_scope(bundle, {"repeat_until": {"ReviewLoop": progress}, "steps": {"ReviewLoop": row} if row else {}}, ROOT)
+
+
+def test_loop_local_ids_resolve_only_for_existing_iterations(bundle) -> None:
+    node = "root.review_loop.iteration_body.write_decision"
+    key = bundle.projection.repeat_until_step_key("root.review_loop", 1, node)
+    step_id = bundle.projection.repeat_until_runtime_step_id("root.review_loop", 1, node)
+    progress = {"current_iteration": 1, "completed_iterations": [0], "condition_evaluated_for_iteration": None, "last_condition_result": None}

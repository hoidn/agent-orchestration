diff --git a/orchestrator/workflow/resume_loop_progress.py b/orchestrator/workflow/resume_loop_progress.py
new file mode 100644
index 0000000..640fe99
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_progress.py
@@ -0,0 +1,159 @@
+"""Loop bookkeeping validation for checksum-compatible resume.
+
+Reads only a persisted state mapping and the loop maxima carried by a
+``WorkflowStateProjection``; it never mutates or backfills the state.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted resume bookkeeping is invalid; ``reason`` is a stable diagnostic reason."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+        self.value = value
+
+    def __str__(self) -> str:
+        return self.message
+
+
+def _shape(message: str, field: Optional[str] = None, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field=field, value=value)
+
+
+def _progress(message: str, field: Optional[str] = None, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field=field, value=value)
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _index_list(value: Any, label: str) -> list[int]:
+    if not isinstance(value, list) or not all(_is_index(v) for v in value):
+        raise _shape(f"{label} must be a list of non-boolean integers", label)
+    if len(set(value)) != len(value):
+        raise _progress(f"{label} must not contain duplicate indices", label)
+    return value
+
+
+def _optional_index(value: Any, label: str) -> Optional[int]:
+    if value is not None and not _is_index(value):
+        raise _shape(f"{label} must be null or a non-boolean integer", label, value)
+    return value
+
+
+def _entries(state: Mapping[str, Any], key: str) -> Mapping[str, Any]:
+    section = state.get(key)
+    if section is None:
+        return {}
+    if not isinstance(section, Mapping):
+        raise _shape(f"{key} must be a mapping", key)
+    return section
+
+
+def validate_for_each_progress(state: Mapping[str, Any]) -> None:
+    """Validate every ``for_each`` progress entry in ``state``."""
+    for name, progress in _entries(state, "for_each").items():
+        label = f"for_each.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{label} must be a mapping", label)
+        items = progress.get("items")
+        if not isinstance(items, list):
+            raise _shape(f"{label}.items must be a list", f"{label}.items")
+        current = _optional_index(progress.get("current_index"), f"{label}.current_index")
+        completed = _index_list(progress.get("completed_indices", []), f"{label}.completed_indices")
+        if any(index < 0 or index >= len(items) for index in completed):
+            raise _progress(f"{label}.completed_indices contains an out-of-range index", f"{label}.completed_indices")
+        if current is not None:
+            if current < 0 or current >= len(items):
+                raise _progress(f"{label}.current_index is out of range", f"{label}.current_index", current)
+            if current in completed:
+                raise _progress(f"{label}.current_index is already completed", f"{label}.current_index", current)
+
+
+def _loop_row(state: Mapping[str, Any], name: str) -> Mapping[str, Any]:
+    steps = state.get("steps")
+    row = steps.get(name) if isinstance(steps, Mapping) else None
+    return row if isinstance(row, Mapping) else {}
+
+
+def _validate_active(label: str, progress: Mapping[str, Any], current: int, completed: list[int],
+                     evaluated: Optional[int], result: Any, max_iterations: Optional[int]) -> None:
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise _progress(f"{label}.current_iteration is out of range", f"{label}.current_iteration", current)
+    if any(index < 0 or index >= current for index in completed):
+        raise _progress(f"{label}.completed_iterations is not valid prior history", f"{label}.completed_iterations")
+    consistent = (evaluated is None and result is None) or (
+        evaluated == current and isinstance(result, bool)
+    )
+    if not consistent or progress.get("exhausted") is True:
+        raise _progress(f"{label}.condition result conflicts with evaluation state", f"{label}.last_condition_result")
+
+
+def _validate_terminal(label: str, state: Mapping[str, Any], name: str, progress: Mapping[str, Any],
+                       completed: list[int], evaluated: Optional[int], result: Any,
+                       max_iterations: Optional[int]) -> None:
+    if any(index < 0 or (max_iterations is not None and index >= max_iterations) for index in completed):
+        raise _progress(f"{label}.completed_iterations is not valid prior history", f"{label}.completed_iterations")
+    if not completed or evaluated != max(completed) or not isinstance(result, bool):
+        raise _progress(f"{label}.terminal progress requires completed evaluated history", f"{label}.completed_iterations")
+    exhausted = progress.get("exhausted", False)
+    if result is True:
+        if exhausted:
+            raise _progress(f"{label}.condition result conflicts with evaluation state", f"{label}.last_condition_result")
+        return
+    if max_iterations is not None and set(completed) != set(range(max_iterations)):
+        raise _progress(f"{label}.terminal progress requires completed evaluated history", f"{label}.completed_iterations")
+    row = _loop_row(state, name)
+    if not row:
+        return  # the loop frame row may be absent (lexical restore regenerates it)
+    if exhausted:
+        if row.get("status") != "completed":
+            raise _progress(f"{label}.successful exhaustion requires a completed frame", f"steps.{name}.status")
+        return
+    error = row.get("error")
+    if row.get("status") != "failed" or not (
+        isinstance(error, Mapping) and error.get("type") == "repeat_until_iterations_exhausted"
+    ):
+        raise _progress(f"{label}.failed exhaustion requires the terminal exhaustion error", f"steps.{name}.error")
+
+
+def validate_repeat_until_progress(
+    state: Mapping[str, Any],
+    max_iterations_by_name: Mapping[str, Optional[int]],
+) -> None:
+    """Validate every ``repeat_until`` progress entry in ``state``."""
+    for name, progress in _entries(state, "repeat_until").items():
+        label = f"repeat_until.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{label} must be a mapping", label)
+        current = _optional_index(progress.get("current_iteration"), f"{label}.current_iteration")
+        if "exhausted" in progress and not isinstance(progress["exhausted"], bool):
+            raise _shape(f"{label}.exhausted must be boolean when present", f"{label}.exhausted")
+        completed = _index_list(progress.get("completed_iterations", []), f"{label}.completed_iterations")
+        evaluated = _optional_index(
+            progress.get("condition_evaluated_for_iteration"),
+            f"{label}.condition_evaluated_for_iteration",
+        )
+        result = progress.get("last_condition_result")
+        if result is not None and not isinstance(result, bool):
+            raise _shape(f"{label}.last_condition_result must be null or boolean", f"{label}.last_condition_result")
+        maximum = max_iterations_by_name.get(name)
+        if current is not None:
+            _validate_active(label, progress, current, completed, evaluated, result, maximum)
+        else:
+            _validate_terminal(label, state, name, progress, completed, evaluated, result, maximum)
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..59e971a
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,316 @@
+"""Checksum-compatible resume projection integrity audit (specs/state.md).
+
+``audit_scope`` checks every persisted durable identity of ONE scope (the root
+or one call frame's state) against the projection of the bundle that owns it.
+It reads only the bundle and state it is given and never mutates the state.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from .call_frame_retry_lineage import (
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_slots import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    resolve_call_boundary,
+    resolve_resume_step_id,
+)
+
+__all__ = [
+    "ReachedCall",
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RetryFrameMember",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "audit_reached_call_frames",
+    "audit_scope",
+    "select_reached_call",
+    "index_retry_lineage",
+    "next_unused_retry_frame_id",
+]
+
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+ERROR_TYPE = "resume_projection_integrity_error"
+_FRAME_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow to one audited scope."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [{"kind": "root", "workflow_file": self.root_workflow_file}] + [
+            {"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Audit failure; ``error`` is the stable persisted diagnostic."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    return value if value is None or isinstance(value, (str, int, float, bool)) else None
+
+
+class _Audit:
+    def __init__(self, bundle: Any, state: Mapping[str, Any], path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.path = path
+
+    def fail(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        offending: Any = None,
+        candidates: Optional[int] = None,
+        boundary: Optional[str] = None,
+    ) -> NoReturn:
+        provenance = workflow_provenance(self.bundle)
+        workflow_path = getattr(provenance, "workflow_path", None)
+        checksum = self.state.get("workflow_checksum") if isinstance(self.state, Mapping) else None
+        raise ResumeProjectionIntegrityError(
+            {
+                "type": ERROR_TYPE,
+                "message": f"Resume projection integrity audit failed: {reason}",
+                "context": {
+                    "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                    "reason": reason,
+                    "scope_path": self.path.as_context(),
+                    "field": field,
+                    "offending_value": _scalar(offending),
+                    "expected_owner": {
+                        "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                        "workflow_checksum": checksum if isinstance(checksum, str) else None,
+                        "projection_scope": self.path.projection_scope,
+                    },
+                    "candidate_count": candidates,
+                    "call_boundary_step_id": boundary,
+                },
+            }
+        )
+
+    def mapping(self, key: str) -> Mapping[str, Any]:
+        value = self.state.get(key)
+        if value is None:
+            return {}
+        if not isinstance(value, Mapping):
+            self.fail("unsupported_shape", field=key)
+        return value
+
+    def loop_maxima(self) -> dict[str, Optional[int]]:
+        """Declared ``max_iterations`` per repeat_until frame key, read from the bundle IR."""
+        nodes = self.bundle.ir.nodes
+        return {
+            loop.frame_key: getattr(nodes.get(node_id), "max_iterations", None)
+            for node_id, loop in self.bundle.projection.repeat_until_nodes.items()
+        }
+
+    def slot_index(self) -> ResumeProjectionSlotIndex:
+        try:
+            return self.bundle.projection.enumerate_resume_slots(self.state, self.loop_maxima())
+        except ResumeProjectionValidationError as exc:
+            self.fail(exc.reason, field=exc.field, offending=exc.value)
+
+    def audit_rows(self, index: ResumeProjectionSlotIndex) -> None:
+        unclaimed = {name for name, _ in index.unclaimed_explicit_rows}
+        for name, row in self.mapping("steps").items():
+            if isinstance(row, list):
+                continue  # for_each result list: its rows are the flat `Loop[i].Step` rows
+            field = f"steps.{name}.step_id"
+            if not isinstance(row, Mapping):
+                self.fail("unsupported_shape", field=f"steps.{name}")
+            if "step_id" not in row:
+                continue
+            step_id = row["step_id"]
+            if not isinstance(step_id, str) or not step_id:
+                self.fail("unsupported_shape", field=field, offending=step_id)
+            if name in unclaimed:
+                self.fail("unclaimed_explicit_step_row", field=field, offending=step_id, candidates=0)
+            found = resolve_resume_step_id(index, step_id, name)
+            if found.candidate_count == 0:
+                self.fail("unknown_explicit_step_id", field=field, offending=step_id, candidates=0)
+            if found.slot is None:
+                self.fail(
+                    "presentation_slot_mismatch",
+                    field=field,
+                    offending=step_id,
+                    candidates=found.candidate_count,
+                )
+
+    def audit_current_step(self, index: ResumeProjectionSlotIndex) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            self.fail("unsupported_shape", field="current_step")
+        field = "current_step.step_id"
+        step_id = current.get("step_id")
+        if step_id is None:
+            self.fail("missing_required_identity", field=field)
+        if not isinstance(step_id, str) or not step_id:
+            self.fail("unsupported_shape", field=field, offending=step_id)
+        name = current.get("name")
+        found = resolve_resume_step_id(index, step_id, name if isinstance(name, str) else None)
+        if found.candidate_count == 0:
+            self.fail("out_of_scope_step_id", field=field, offending=step_id, candidates=0)
+        if found.slot is None:
+            self.fail(
+                "presentation_slot_mismatch",
+                field=field,
+                offending=step_id,
+                candidates=found.candidate_count,
+            )
+
+    def audit_frame(self, index: ResumeProjectionSlotIndex, frame_id: str, frame: Any) -> tuple[str, Any]:
+        """Audit one frame's identity; returns ``(call_step_id, callee bundle)``."""
+        if not isinstance(frame, Mapping):
+            self.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+        prefix = f"call_frames.{frame_id}"
+        step_id = frame.get("call_step_id")
+        if step_id is None:
+            self.fail("missing_required_identity", field=f"{prefix}.call_step_id")
+        if not isinstance(step_id, str) or not step_id:
+            self.fail("unsupported_shape", field=f"{prefix}.call_step_id", offending=step_id)
+        where = {"field": f"{prefix}.call_step_id", "offending": step_id, "boundary": step_id}
+        if step_id not in index.candidates_by_step_id:
+            self.fail("out_of_scope_step_id", candidates=0, **where)
+        resolved = resolve_call_boundary(index, step_id)
+        if resolved.candidate_count == 0:
+            self.fail("missing_call_boundary", candidates=0, **where)
+        if resolved.boundary is None:
+            self.fail("ambiguous_call_boundary", candidates=resolved.candidate_count, **where)
+        alias = resolved.boundary.import_alias
+        if frame.get("import_alias") != alias:
+            self.fail(
+                "persisted_import_alias_mismatch",
+                field=f"{prefix}.import_alias",
+                offending=frame.get("import_alias"),
+                candidates=1,
+                boundary=step_id,
+            )
+        callee = workflow_import_bundle(self.bundle, alias) if isinstance(alias, str) else None
+        if callee is None:
+            self.fail("missing_imported_bundle", field=f"imports.{alias}", offending=alias, candidates=1, boundary=step_id)
+        if frame.get("status") not in _FRAME_STATUSES:
+            self.fail("unsupported_shape", field=f"{prefix}.status", offending=frame.get("status"), boundary=step_id)
+        return step_id, callee
+
+    def audit_frames(self, index: ResumeProjectionSlotIndex) -> None:
+        by_boundary: dict[str, tuple[Any, list[tuple[str, Any]]]] = {}
+        for frame_id, frame in self.mapping("call_frames").items():
+            step_id, callee = self.audit_frame(index, frame_id, frame)
+            by_boundary.setdefault(step_id, (callee, []))[1].append((frame_id, frame))
+        for step_id, (callee, items) in by_boundary.items():
+            kind = getattr(workflow_provenance(callee), "frontend_kind", None)
+            try:
+                index_retry_lineage(step_id, items, frontend_kind=kind)
+            except CallFrameRetryLineageError as exc:
+                self.lineage_failure(exc, step_id, items)
+
+    def lineage_failure(
+        self, exc: CallFrameRetryLineageError, step_id: str, items: list[tuple[str, Any]]
+    ) -> NoReturn:
+        if exc.reason == "ambiguous_resumable_call_frame":
+            live = sum(1 for _, frame in items if frame.get("status") != "completed")
+            self.fail(exc.reason, field="call_frames", offending=live, candidates=live, boundary=step_id)
+        field = f"call_frames.{exc.frame_id}" if exc.frame_id else "call_frames"
+        self.fail(exc.reason, field=field, boundary=step_id)
+
+
+def audit_scope(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities; raises ``ResumeProjectionIntegrityError``."""
+    audit = _Audit(bundle, state, scope_path)
+    audit.mapping("steps")
+    audit.mapping("call_frames")
+    index = audit.slot_index()
+    audit.audit_rows(index)
+    audit.audit_current_step(index)
+    audit.audit_frames(index)
+
+
+@dataclass(frozen=True)
+class ReachedCall:
+    """The current boundary, callee bundle and slot index selected for a reached call."""
+
+    slot_index: ResumeProjectionSlotIndex
+    boundary: Any
+    callee: Any
+
+
+def select_reached_call(
+    bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath, call_step_id: str
+) -> ReachedCall:
+    """Resolve a reached call's caller identity once; the boundary's alias selects the callee."""
+    audit = _Audit(bundle, state, scope_path)
+    index = audit.slot_index()
+    resolved = bundle.projection.resolve_call_boundary(index, call_step_id)
+    where = {"field": "call_step_id", "offending": call_step_id, "boundary": call_step_id}
+    if call_step_id not in index.candidates_by_step_id:
+        audit.fail("out_of_scope_step_id", candidates=0, **where)
+    if resolved.candidate_count == 0:
+        audit.fail("missing_call_boundary", candidates=0, **where)
+    if resolved.boundary is None:
+        audit.fail("ambiguous_call_boundary", candidates=resolved.candidate_count, **where)
+    alias = resolved.boundary.import_alias
+    callee = workflow_import_bundle(bundle, alias) if isinstance(alias, str) else None
+    if callee is None:
+        audit.fail("missing_imported_bundle", field=f"imports.{alias}", offending=alias, candidates=1, boundary=call_step_id)
+    return ReachedCall(index, resolved.boundary, callee)
+
+
+def audit_reached_call_frames(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    reached: ReachedCall,
+    call_step_id: str,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Revalidate the frames of one reached boundary and return their retry lineage."""
+    audit = _Audit(bundle, state, scope_path)
+    items: list[tuple[str, Any]] = []
+    for frame_id, frame in audit.mapping("call_frames").items():
+        if not isinstance(frame, Mapping):
+            audit.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+        if frame.get("call_step_id") == call_step_id:
+            audit.audit_frame(reached.slot_index, frame_id, frame)
+            items.append((frame_id, frame))
+    try:
+        return index_retry_lineage(call_step_id, items, frontend_kind=frontend_kind)
+    except CallFrameRetryLineageError as exc:
+        audit.lineage_failure(exc, call_step_id, items)

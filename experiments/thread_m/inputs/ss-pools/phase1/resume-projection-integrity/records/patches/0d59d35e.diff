index 0000000..2392167
--- /dev/null
+++ b/orchestrator/workflow/call_frame_retry_lineage.py
@@ -0,0 +1,144 @@
+"""Call-frame retry lineage for one call boundary.
+
+Pure functions over ``(frame_id, frame)`` pairs: no state, bundle or file is read.
+A Workflow Lisp boundary's non-completed frames form one lineage ``B``,
+``B::retry::1``, ``B::retry::2`` ...; any other boundary has at most one
+non-completed frame.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+_KNOWN_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Frames of one boundary cannot form a valid lineage; ``reason`` is a diagnostic reason."""
+
+    def __init__(self, reason: str, message: str, *, frame_id: Optional[str] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.frame_id = frame_id
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[CallFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+    used_ordinals: frozenset[int] = frozenset()
+
+
+def _fail(reason: str, message: str, frame_id: Optional[str] = None) -> CallFrameRetryLineageError:
+    return CallFrameRetryLineageError(reason, message, frame_id=frame_id)
+
+
+def _parse_retry_id(frame_id: str) -> tuple[str, int]:
+    """Split ``<base>[::retry::<n>]``; raises on malformed or nested markers."""
+    base, marker, tail = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return frame_id, 0
+    if not base or RETRY_MARKER in tail or not tail.isascii() or not tail.isdigit() or str(int(tail)) != tail or int(tail) < 1:
+        raise _fail("unsupported_shape", "malformed or nested retry marker", frame_id)
+    return base, int(tail)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[str, Any]]
+) -> list[tuple[str, str]]:
+    frames: list[tuple[str, str]] = []
+    alias_seen: list[Any] = []
+    for frame_id, frame in frame_items:
+        if not isinstance(frame_id, str) or not isinstance(frame, dict):
+            raise _fail("unsupported_shape", "call frame must be a mapping", frame_id if isinstance(frame_id, str) else None)
+        if frame.get("call_step_id") != boundary_step_id:
+            raise _fail("missing_call_boundary", "call frame belongs to another boundary", frame_id)
+        alias = frame.get("import_alias")
+        if alias_seen and alias != alias_seen[0]:
+            raise _fail("persisted_import_alias_mismatch", "call frames disagree on import alias", frame_id)
+        alias_seen.append(alias)
+        status = frame.get("status")
+        if status not in _KNOWN_STATUSES:
+            raise _fail("unsupported_shape", "unknown call frame status", frame_id)
+        frames.append((frame_id, status))
+    return frames
+
+
+def _plain_lineage(frames: list[tuple[str, str]]) -> CallFrameRetryLineage:
+    completed = tuple(CallFrameMember(i, s) for i, s in frames if s == "completed")
+    live = [CallFrameMember(i, s) for i, s in frames if s != "completed"]
+    if len(live) > 1:
+        raise _fail("ambiguous_resumable_call_frame", "several resumable call frames for one boundary")
+    return CallFrameRetryLineage(None, completed, (), live[0] if live else None)
+
+
+def _retry_lineage(frames: list[tuple[str, str]]) -> CallFrameRetryLineage:
+    live = [(i, s, *_parse_retry_id(i)) for i, s in frames if s != "completed"]
+    bases = {base for _, _, base, _ in live}
+    if len(bases) > 1:
+        raise _fail("ambiguous_resumable_call_frame", "mixed retry bases for one boundary")
+    base = next(iter(bases), None)
+    members: list[RetryFrameMember] = []
+    completed: list[CallFrameMember] = []
+    for frame_id, status in frames:
+        if status != "completed":
+            continue
+        completed.append(CallFrameMember(frame_id, status))
+        try:
+            frame_base, ordinal = _parse_retry_id(frame_id)
+        except CallFrameRetryLineageError:
+            continue  # historical frames outside the lineage family are ignored
+        if base is not None and frame_base == base:
+            members.append(RetryFrameMember(frame_id, status, ordinal))
+    members.extend(RetryFrameMember(i, s, ordinal) for i, s, _, ordinal in live)
+    ordinals = [member.ordinal for member in members]
+    if len(set(ordinals)) != len(ordinals):
+        raise _fail("ambiguous_resumable_call_frame", "duplicate retry ordinal")
+    if base is not None and sorted(ordinals) != list(range(len(ordinals))):
+        raise _fail("unsupported_shape", "missing retry ordinal")
+    running = [m for m in members if m.status == "running"]
+    if len(running) > 1:
+        raise _fail("ambiguous_resumable_call_frame", "several running call frames for one boundary")
+    failed = tuple(sorted((m for m in members if m.status == "failed"), key=lambda m: m.ordinal))
+    return CallFrameRetryLineage(
+        base, tuple(completed), failed, running[0] if running else None, frozenset(ordinals)
+    )
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group the frames of one boundary into a validated retry lineage."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    if frontend_kind == WORKFLOW_LISP_FRONTEND_KIND:
+        return _retry_lineage(frames)
+    return _plain_lineage(frames)
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<lowest unused positive ordinal>``."""
+    if lineage.base_frame_id is None:
+        raise ValueError("lineage has no retry base frame")
+    ordinal = 1
+    while ordinal in lineage.used_ordinals:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

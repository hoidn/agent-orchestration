new file mode 100644
index 0000000..bf8de06
--- /dev/null
+++ b/tests/test_resume_command_projection.py
@@ -0,0 +1,135 @@
+"""`orchestrator resume` audits the persisted root scope before any mutation or effect."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+import orchestrator.cli.commands.resume as resume_command
+from orchestrator.cli.commands.resume import resume_workflow
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+
+SUMMARY_OVERRIDE = {"summary_mode": "sync", "summary_provider": "projection-summary"}
+
+
+def _seed(workspace: Path, *, stale_step_id: bool) -> StateManager:
+    (workspace / "workflow.yaml").write_text(
+        yaml.safe_dump(
+            {
+                "version": "2.0",
+                "name": "cli-audit",
+                "steps": [
+                    {"name": "Work", "id": "work", "command": ["bash", "-lc", "echo ran >> state-effect.txt"]}
+                ],
+            }
+        ),
+        encoding="utf-8",
+    )
+    manager = StateManager(workspace, run_id="cli-audit")
+    state = manager.initialize("workflow.yaml")
+    state.status = "failed"
+    state.steps = {
+        "Work": {
+            "status": "completed",
+            "name": "Work",
+            "step_id": "root.removed" if stale_step_id else "root.work",
+        }
+    }
+    manager._write_state()
+    return manager
+
+
+def _recorders(events: list[str]):
+    names = {
+        "audit": ("audit_scope", None),
+        "session": ("open_executor_session", None),
+        "metadata": ("write_process_metadata", None),
+    }
+    patches = []
+    for label, (attribute, _) in names.items():
+        original = getattr(resume_command, attribute)
+
+        def recording(*args, _label=label, _original=original, **kwargs):
+            events.append(_label)
+            return _original(*args, **kwargs)
+
+        patches.append(patch.object(resume_command, attribute, recording))
+    original_init = WorkflowExecutor.__init__
+
+    def init(executor, *args, **kwargs):
+        events.append("executor")
+        original_init(executor, *args, **kwargs)
+
+    patches.append(patch.object(WorkflowExecutor, "__init__", init))
+    return patches
+
+
+def test_valid_state_audits_before_observability_session_and_executor(tmp_path):
+    manager = _seed(tmp_path, stale_step_id=False)
+    events: list[str] = []
+    original_write = StateManager._write_state
+
+    def write(state_manager):
+        if state_manager.state.observability and "observability" not in events:
+            events.append("observability")

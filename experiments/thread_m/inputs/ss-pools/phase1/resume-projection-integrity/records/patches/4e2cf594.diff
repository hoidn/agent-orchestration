+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow_lisp.build import FrontendBuildRequest, build_frontend_bundle
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.lowering.core import validate_lowered_workflows
+
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+FIXTURES = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp"
+CLI_FIXTURES = FIXTURES / "cli"
+SOURCE_ROOT = FIXTURES / "modules" / "valid" / "imported_bundle_mix"
+ENTRYPOINT = SOURCE_ROOT / "neurips" / "entry.orc"
+PROVIDERS = {"providers.execute": "test-provider"}
+PROMPTS = {"prompts.implementation.execute": "prompts/implementation/execute.md"}
+
+
+def _classic_selector_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(CLI_FIXTURES / "imported_selector.yaml")
+
+
+def _compile(tmp_path: Path, classic_bundle):
+    return compile_stage3_entrypoint(
+        ENTRYPOINT,
+        source_roots=(SOURCE_ROOT,),
+        provider_externs=PROVIDERS,
+        prompt_externs=PROMPTS,
+        imported_workflow_bundles={"selector-run": classic_bundle},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+
+
+def test_compiled_entry_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result = _compile(tmp_path, _classic_selector_bundle(tmp_path))
+
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+    assert entry.provenance.frontend_kind == "workflow_lisp"
+
+
+def test_every_compiled_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result = _compile(tmp_path, _classic_selector_bundle(tmp_path))
+
+    kinds = {name: bundle.provenance.frontend_kind for name, bundle in result.validated_bundles_by_name.items()}
+    assert set(kinds.values()) == {"workflow_lisp"}
+
+
+def test_imported_workflow_lisp_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result = _compile(tmp_path, _classic_selector_bundle(tmp_path))
+
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+    assert entry.imports["neurips/helper::provider-attempt"].provenance.frontend_kind == "workflow_lisp"
+
+
+def test_classic_imported_bundle_keeps_its_provenance(tmp_path: Path) -> None:
+    classic = _classic_selector_bundle(tmp_path)
+    result = _compile(tmp_path, classic)
+
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+    assert entry.imports["selector-run"].provenance.frontend_kind is None
+
+
+def test_classic_imported_bundle_is_linked_as_same_object(tmp_path: Path) -> None:
+    classic = _classic_selector_bundle(tmp_path)
+    result = _compile(tmp_path, classic)
+
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+    assert entry.imports["selector-run"] is classic
+
+
+def test_lowered_bundles_are_workflow_lisp(tmp_path: Path) -> None:
+    classic = _classic_selector_bundle(tmp_path)
+    compiled = _compile(tmp_path, classic)
+    lowered = compiled.entry_result.lowered_workflows
+
+    bundles = validate_lowered_workflows(
+        lowered,
+        workspace_root=tmp_path,
+        imported_workflow_bundles=compiled.entry_result.workflow_catalog.imported_bundles_by_name,
+    )
+
+    assert {bundle.provenance.frontend_kind for bundle in bundles.values()} == {"workflow_lisp"}
+
+
+def test_build_frontend_bundle_preserves_compiler_frontend_kind(tmp_path: Path) -> None:
+    result = build_frontend_bundle(
+        FrontendBuildRequest(
+            source_path=ENTRYPOINT,
+            source_roots=(SOURCE_ROOT, tmp_path),
+            entry_workflow="orchestrate",
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            emit_debug_yaml=False,
+            workspace_root=tmp_path,
+        )
+    )
+
+    bundle = result.validated_bundle
+    assert (bundle.provenance.frontend_kind, bundle.imports["selector-run"].provenance.frontend_kind) == (
+        "workflow_lisp",
+        None,
+    )

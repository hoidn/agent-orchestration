@@ -0,0 +1,439 @@
+"""Root resume guard, sticky projection failures, finalization and child-executor behaviour."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from typing import Any, Optional
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.runtime_observability import open_executor_session
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    build_integrity_error,
+    ResumeScopePath,
+)
+
+LOG = "state/log.txt"
+CORRUPT_STEP = {"status": "running", "name": "SetReady", "index": 0, "step_id": "root.gone", "visit_count": 1}
+
+
+def _write_yaml(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _log_step(name: str, text: str, **extra: Any) -> dict:
+    return {
+        "name": name,
+        "id": name.lower(),
+        "command": ["bash", "-lc", f"mkdir -p state && echo {text} >> {LOG}"],
+        **extra,
+    }
+
+
+def _write_child(workspace: Path) -> None:
+    _write_yaml(
+        workspace / "lib" / "child.yaml",
+        {
+            "version": "2.7",
+            "name": "child",
+            "artifacts": {"ready": {"kind": "scalar", "type": "bool"}},
+            "outputs": {
+                "ready": {
+                    "kind": "scalar",
+                    "type": "bool",
+                    "from": {"ref": "root.steps.SetReady.artifacts.ready"},
+                }
+            },
+            "steps": [
+                {
+                    "name": "SetReady",
+                    "id": "set_ready",
+                    "set_scalar": {"artifact": "ready", "value": True},
+                }
+            ],
+        },
+    )
+
+
+def _setup(workspace: Path, steps: list, **workflow_extra: Any):
+    _write_child(workspace)
+    path = _write_yaml(
+        workspace / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "sticky-root",
+            "imports": {"child": "lib/child.yaml"},
+            "steps": steps,
+            **workflow_extra,
+        },
+    )
+    bundle = WorkflowLoader(workspace).load_bundle(path)
+    manager = StateManager(workspace, run_id="sticky")
+    manager.initialize("workflow.yaml")
+    return bundle, manager
+
+
+def _log(workspace: Path) -> list[str]:
+    path = workspace / LOG
+    return path.read_text(encoding="utf-8").splitlines() if path.exists() else []
+
+
+def _corrupt_callee(manager: StateManager, frame_id: Optional[str] = None) -> str:
+    """Make the persisted call frame resumable with a stale callee-local current step."""
+    state = manager.load()
+    frame_id = frame_id or next(iter(state.call_frames))
+    frame = state.call_frames[frame_id]
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["current_step"] = dict(CORRUPT_STEP)
+    frame["current_step"] = dict(CORRUPT_STEP)
+    state.status = "failed"
+    manager._write_state()
+    return frame_id
+
+
+def _fail_row(manager: StateManager, name: str) -> None:
+    state = manager.load()
+    state.steps[name]["status"] = "failed"
+    state.steps[name].pop("exit_code", None)
+    state.status = "failed"
+    manager._write_state()
+
+
+def _persisted(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _assert_projection_error(state: dict, reason: str) -> dict:
+    error = state["error"]
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["context"]["reason"] == reason
+    return error
+
+
+# ---- root checksum recheck -------------------------------------------------------------
+
+
+def _checksum_case(tmp_path, reason):
+    bundle, manager = _setup(tmp_path, [_log_step("Work", "work")])
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load()
+    state.status = "failed"
+    state.steps["Work"]["status"] = "failed"
+    if reason == "missing_recorded_checksum":
+        state.workflow_checksum = ""
+    manager._write_state()
+    if reason == "workflow_modified":
+        (tmp_path / "workflow.yaml").write_text("# changed\n" + (tmp_path / "workflow.yaml").read_text())
+    elif reason == "workflow_unavailable":
+        (tmp_path / "workflow.yaml").unlink()
+    elif reason == "missing_workflow_path":
+        provenance = bundle.provenance
+        object.__setattr__(bundle, "provenance", type(provenance)(**{**provenance.__dict__, "workflow_path": None}))
+    return bundle, manager
+
+
+@pytest.mark.parametrize(
+    "reason",
+    ["workflow_modified", "missing_recorded_checksum", "missing_workflow_path", "workflow_unavailable"],
+)
+def test_structural_root_rechecks_the_checksum_before_the_prologue(tmp_path, reason):
+    bundle, manager = _checksum_case(tmp_path, reason)
+    before = _persisted(manager)
+    log_before = _log(tmp_path)
+
+    with patch.object(WorkflowExecutor, "_execute_prologue", side_effect=AssertionError("prologue ran")), patch(
+        "orchestrator.workflow.executor.audit_scope", side_effect=AssertionError("audit ran")
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    error = after["error"]
+    assert result["status"] == "failed"
+    assert error["type"] == "workflow_checksum_mismatch"
+    assert error["message"] == "Workflow has been modified since the run started"
+    assert set(error["context"]) == {"workflow_file", "persisted_checksum", "current_checksum", "reason"}
+    assert error["context"]["reason"] == reason
+    changed = {key for key in set(before) | set(after) if before.get(key) != after.get(key)}
+    assert changed == {"error", "updated_at"}
+    assert _log(tmp_path) == log_before
+
+
+def test_root_audit_failure_after_a_passing_cli_audit_keeps_session_metadata(tmp_path):
+    bundle, manager = _setup(tmp_path, [_log_step("Work", "work")])
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load()
+    state.status = "failed"
+    state.steps["Work"]["status"] = "failed"
+    session_id = open_executor_session(state, entrypoint="resume", process_start_time="t0")
+    manager._write_state()
+    before = _persisted(manager)
+    diagnostic = build_integrity_error(
+        bundle, before, ResumeScopePath.root("workflow.yaml"), "unknown_explicit_step_id", field="steps.Work.step_id"
+    )
+
+    with patch("orchestrator.workflow.executor.audit_scope", side_effect=ResumeProjectionIntegrityError(diagnostic)), patch.object(
+        WorkflowExecutor, "_execute_prologue", side_effect=AssertionError("prologue ran")
+    ):
+        WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    assert after["error"] == diagnostic
+    assert after["runtime_observability"] == before["runtime_observability"]
+    assert any(s["session_id"] == session_id for s in after["runtime_observability"]["executor_sessions"])
+    changed = {key for key in set(before) | set(after) if before.get(key) != after.get(key)}
+    assert changed == {"error", "updated_at"}
+
+
+def test_child_call_frame_executor_does_not_repeat_the_root_guard(tmp_path):
+    bundle, manager = _setup(tmp_path, [{"name": "Call", "id": "call", "call": "child"}])
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load()
+    frame = next(iter(state.call_frames.values()))
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["steps"]["SetReady"]["status"] = "failed"
+    state.status = "failed"
+    state.steps["Call"]["status"] = "failed"
+    manager._write_state()
+    original = WorkflowExecutor._guard_structural_root_resume
+    calls: list[Any] = []
+
+    def counting(executor, state):
+        calls.append(executor.state_manager)
+        return original(executor, state)
+
+    with patch.object(WorkflowExecutor, "_guard_structural_root_resume", counting):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert result["status"] == "completed"
+    assert calls == [manager]
+
+
+# ---- sticky projection failure -------------------------------------------------------------
+
+
+def _routed_workflow(tmp_path, call_extra):
+    bundle, manager = _setup(
+        tmp_path,
+        [
+            {"name": "Call", "id": "call", "call": "child", **call_extra},
+            _log_step("Skipped", "skipped"),
+            _log_step("Marker", "marker"),
+        ],
+    )
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    _corrupt_callee(manager)
+    _fail_row(manager, "Call")
+    state = manager.load()
+    state.steps.pop("Marker", None)
+    manager._write_state()
+    return bundle, manager
+
+
+@pytest.mark.parametrize(
+    ("call_extra", "on_error"),
+    [
+        ({"on": {"success": {"goto": "Marker"}}}, "stop"),
+        ({"on": {"failure": {"goto": "Marker"}}}, "stop"),
+        ({"on": {"always": {"goto": "Marker"}}}, "stop"),
+        ({"on": {"success": {"goto": "Marker"}}}, "continue"),
+    ],
+    ids=["success", "failure", "always", "on_error_continue"],
+)
+def test_projection_failure_cannot_be_routed_or_continued(tmp_path, call_extra, on_error):
+    bundle, manager = _routed_workflow(tmp_path, call_extra)
+    log_before = _log(tmp_path)
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, on_error=on_error)
+
+    after = _persisted(manager)
+    assert result["status"] == "failed"
+    assert after["status"] == "failed"
+    error = _assert_projection_error(after, "out_of_scope_step_id")
+    assert after["steps"]["Call"]["error"] == error
+    assert _log(tmp_path) == log_before
+
+
+def test_failed_reached_call_leaves_the_callee_frame_untouched(tmp_path):
+    bundle, manager = _routed_workflow(tmp_path, {})
+    frame_id = next(iter(manager.load().call_frames))
+    before_frame = json.loads(json.dumps(_persisted(manager)["call_frames"][frame_id]))
+
+    WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    assert after["call_frames"][frame_id] == before_frame
+    assert after["error"]["context"]["scope_path"][-1] == {"kind": "call_frame", "frame_id": frame_id}
+    assert after["error"]["type"] != "call_failed"
+
+
+def test_for_each_stops_without_starting_the_next_iteration(tmp_path):
+    bundle, manager = _setup(
+        tmp_path,
+        [
+            {
+                "name": "Each",
+                "id": "each",
+                "for_each": {
+                    "items": ["a", "b"],
+                    "steps": [{"name": "Call", "id": "call", "call": "child"}],
+                },
+            }
+        ],
+    )
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load()
+    first_frame = "root.each#0.call::visit::1"
+    assert first_frame in state.call_frames
+    state.call_frames.pop("root.each#1.call::visit::1")
+    for key in [k for k in state.steps if k.startswith("Each")]:
+        state.steps.pop(key)
+    state.for_each["Each"] = {"items": ["a", "b"], "completed_indices": [], "current_index": 0}
+    state.status = "failed"
+    manager._write_state()
+    _corrupt_callee(manager, first_frame)
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    assert result["status"] == "failed"
+    _assert_projection_error(after, "out_of_scope_step_id")
+    assert set(after["call_frames"]) == {first_frame}
+    assert after["for_each"]["Each"]["completed_indices"] == []
+    assert after["for_each"]["Each"]["current_index"] == 0
+
+
+def test_repeat_until_stops_without_a_next_iteration(tmp_path):
+    decision = {"kind": "scalar", "type": "bool", "from": {"ref": "self.steps.Call.artifacts.ready"}}
+    bundle, manager = _setup(
+        tmp_path,
+        [
+            {
+                "name": "Loop",
+                "id": "loop",
+                "repeat_until": {
+                    "id": "body",
+                    "outputs": {"ready": decision},
+                    "condition": {
+                        "compare": {"left": {"ref": "self.outputs.ready"}, "op": "eq", "right": False}
+                    },
+                    "max_iterations": 3,
+                    "steps": [{"name": "Call", "id": "call", "call": "child"}],
+                },
+            }
+        ],
+    )
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load()
+    frame_id = "root.loop#0.body.call::visit::1"
+    assert frame_id in state.call_frames
+    for later in ("root.loop#1.body.call::visit::1", "root.loop#2.body.call::visit::1"):
+        state.call_frames.pop(later)
+    for key in [k for k in state.steps if k.startswith("Loop")]:
+        state.steps.pop(key)
+    state.steps["Loop"] = {
+        "status": "running",
+        "name": "Loop",
+        "step_id": "root.loop",
+        "exit_code": 0,
+    }
+    state.repeat_until["Loop"] = {
+        "current_iteration": 0,
+        "completed_iterations": [],
+        "condition_evaluated_for_iteration": None,
+        "last_condition_result": None,
+    }
+    state.status = "failed"
+    manager._write_state()
+    _corrupt_callee(manager, frame_id)
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    assert result["status"] == "failed"
+    _assert_projection_error(after, "out_of_scope_step_id")
+    assert after["repeat_until"]["Loop"]["current_iteration"] == 0
+    assert set(after["call_frames"]) == {frame_id}
+
+
+# ---- finalization --------------------------------------------------------------------------
+
+
+def _finalized(tmp_path, cleanup_steps):
+    bundle, manager = _setup(
+        tmp_path,
+        [{"name": "Call", "id": "call", "call": "child"}],
+        **{"finally": {"id": "cleanup", "steps": cleanup_steps}},
+    )
+    return bundle, manager
+
+
+def _prepare_finalized_resume(bundle, manager):
+    WorkflowExecutor(bundle, manager.workspace, manager).execute()
+    state = manager.load()
+    state.finalization = {}
+    state.steps = {k: v for k, v in state.steps.items() if k == "Call"}
+    manager._write_state()
+    _corrupt_callee(manager)
+    _fail_row(manager, "Call")
+
+
+def test_finalization_runs_after_a_projection_failure_and_keeps_the_diagnostic(tmp_path):
+    bundle, manager = _finalized(tmp_path, [_log_step("Cleanup", "cleanup")])
+    _prepare_finalized_resume(bundle, manager)
+    before_log = _log(tmp_path)
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    assert result["status"] == "failed"
+    _assert_projection_error(after, "out_of_scope_step_id")
+    assert _log(tmp_path) == before_log + ["cleanup"]
+    assert after["finalization"]["status"] == "completed"
+
+
+def test_cleanup_failure_is_supplemental_to_the_projection_diagnostic(tmp_path):
+    cleanup = {"name": "Cleanup", "id": "cleanup_step", "command": ["bash", "-lc", "exit 3"]}
+    bundle, manager = _finalized(tmp_path, [cleanup])
+    _prepare_finalized_resume(bundle, manager)
+
+    WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _persisted(manager)
+    _assert_projection_error(after, "out_of_scope_step_id")
+    assert after["finalization"]["status"] == "failed"
+    failure = after["finalization"]["failure"]
+    assert set(failure) == {"step", "step_id", "error"}
+    assert failure["step"].endswith("Cleanup")
+    assert failure["error"] is None
+
+
+def test_projection_failure_inside_finalization_becomes_the_run_error(tmp_path):
+    bundle, manager = _finalized(tmp_path, [_log_step("Cleanup", "cleanup")])
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    node_id = bundle.projection.finalization_node_id_by_index[0]
+    step_name = bundle.projection.entries_by_node_id[node_id].presentation_key
+    diagnostic = build_integrity_error(
+        bundle, {}, ResumeScopePath.root("workflow.yaml"), "out_of_scope_step_id", field="current_step.step_id"
+    )
+    state = manager.load().to_dict()
+    state["steps"][step_name] = {"status": "failed", "step_id": node_id, "error": diagnostic}
+
+    executor.finalization_controller.record_settled_result(
+        state, None, step_name, "completed", step_node_id=node_id
+    )
+
+    assert state["error"] == diagnostic
+    assert state["finalization"]["status"] == "failed"
+    assert state["finalization"]["failure"] == {"step": step_name, "step_id": node_id, "error": diagnostic}

+
+def _reason(bundle, state) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        _audit(bundle, state)
+    return exc_info.value.error["context"]
+
+
+def _mutated(state, mutate):
+    candidate = copy.deepcopy(state)
+    mutate(candidate)
+    return candidate

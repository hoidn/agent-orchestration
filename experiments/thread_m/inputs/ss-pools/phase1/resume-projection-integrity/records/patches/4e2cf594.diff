+def _write_yaml(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _write_workflow(workspace: Path) -> Path:
+    _write_yaml(
+        workspace / "lib" / "review.yaml",
+        {
+            "version": "2.7",
+            "name": "review",
+            "artifacts": {
+                "decision": {"kind": "scalar", "type": "enum", "allowed": ["APPROVE", "REVISE"]}
+            },
+            "outputs": {
+                "decision": {
+                    "kind": "scalar",
+                    "type": "enum",
+                    "allowed": ["APPROVE", "REVISE"],
+                    "from": {"ref": "root.steps.Decide.artifacts.decision"},
+                }
+            },
+            "steps": [
+                {
+                    "name": "Decide",
+                    "id": "decide",
+                    "set_scalar": {"artifact": "decision", "value": "APPROVE"},
+                }
+            ],
+        },
+    )
+    return _write_yaml(
+        workspace / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "integrity-root",
+            "imports": {"review": "lib/review.yaml"},
+            "steps": [
+                {
+                    "name": "ReviewLoop",
+                    "id": "review_loop",
+                    "repeat_until": {

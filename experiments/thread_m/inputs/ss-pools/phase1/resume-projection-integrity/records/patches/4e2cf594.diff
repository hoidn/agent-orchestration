@@ -0,0 +1,249 @@
+"""Reached-call revalidation: boundary resolution, retry lineage and validation ordering."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from typing import Any
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.state_projection import WorkflowStateProjection
+from tests.workflow_bundle_helpers import materialize_projection_body_steps
+
+BAD_STEP = {"status": "running", "name": "SetReady", "index": 0, "step_id": "root.gone", "visit_count": 1}
+
+
+def _write_yaml(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _write_graph(workspace: Path) -> Path:
+    _write_yaml(
+        workspace / "lib" / "leaf.yaml",
+        {
+            "version": "2.7",
+            "name": "leaf",
+            "artifacts": {"ready": {"kind": "scalar", "type": "bool"}},
+            "outputs": {
+                "ready": {
+                    "kind": "scalar",
+                    "type": "bool",
+                    "from": {"ref": "root.steps.SetReady.artifacts.ready"},
+                }
+            },
+            "steps": [
+                {"name": "SetReady", "id": "set_ready", "set_scalar": {"artifact": "ready", "value": True}}
+            ],
+        },
+    )
+    return _write_yaml(
+        workspace / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "lineage-root",
+            "imports": {"leaf": "lib/leaf.yaml", "leaf_twin": "lib/leaf.yaml"},
+            "steps": [{"name": "Invoke", "id": "invoke", "call": "leaf"}],
+        },
+    )
+
+
+@pytest.fixture()
+def graph(tmp_path):
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id="lineage")
+    manager.initialize("workflow.yaml")
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load().to_dict()
+    frame_id = next(iter(state["call_frames"]))
+    return bundle, manager, state, frame_id, tmp_path
+
+
+def _executor(bundle, tmp_path, manager) -> WorkflowExecutor:
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    executor.resume_mode = True
+    return executor
+
+
+def _frame_copy(state, frame_id, new_id, *, status, corrupt=False):
+    frame = copy.deepcopy(state["call_frames"][frame_id])
+    frame["status"] = status
+    frame["call_frame_id"] = new_id
+    if corrupt:
+        frame["state"]["current_step"] = dict(BAD_STEP)
+    state["call_frames"][new_id] = frame
+    return frame
+
+
+def _execute(executor, bundle, state):
+    return executor.call_executor.execute_call(materialize_projection_body_steps(bundle)[0], state)
+
+
+def _no_child():
+    return patch(
+        "orchestrator.workflow.call_frame_state._CallFrameStateManager",
+        side_effect=AssertionError("callee state was created"),
+    )
+
+
+def test_each_reached_call_resolves_its_boundary_exactly_once(graph):
+    bundle, manager, state, frame_id, tmp_path = graph
+    state["call_frames"][frame_id]["status"] = "running"
+    original = WorkflowStateProjection.resolve_call_boundary
+    calls: list[tuple] = []
+
+    def spy(projection, slot_index, call_step_id):
+        calls.append((call_step_id,))
+        return original(projection, slot_index, call_step_id)
+
+    with patch.object(WorkflowStateProjection, "resolve_call_boundary", spy):
+        result = _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    assert result["status"] == "completed"
+    assert calls == [("root.invoke",)]
+
+
+def test_boundary_alias_selects_the_callee_and_persisted_alias_is_only_checked(graph):
+    bundle, manager, state, frame_id, tmp_path = graph
+    state["call_frames"][frame_id]["status"] = "running"
+    state["call_frames"][frame_id]["import_alias"] = "leaf_twin"
+
+    with _no_child():
+        result = _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    assert result["error"]["type"] == "resume_projection_integrity_error"
+    assert result["error"]["context"]["reason"] == "persisted_import_alias_mismatch"
+    assert result["error"]["context"]["field"] == f"call_frames.{frame_id}.import_alias"
+
+
+@pytest.mark.parametrize("stale_call_step_id", ["root.invoke", "root.removed", None])
+def test_completed_frame_colliding_with_the_resumed_frame_id_is_rejected_first(graph, stale_call_step_id):
+    bundle, manager, state, frame_id, tmp_path = graph
+    frame = state["call_frames"][frame_id]
+    if stale_call_step_id is None:
+        frame.pop("call_step_id")
+    else:
+        frame["call_step_id"] = stale_call_step_id
+    before = json.loads(json.dumps(state["call_frames"]))
+
+    with _no_child(), patch(
+        "orchestrator.workflow.executor.WorkflowExecutor", side_effect=AssertionError("child executor")
+    ):
+        result = _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    assert result["error"]["type"] == "contract_violation"
+    assert result["error"]["context"] == {
+        "step": "Invoke",
+        "call": "leaf",
+        "call_frame_id": frame_id,
+        "reason": "call_resume_state_invalid",
+        "detail": "completed_call_frame_id_collision",
+    }
+    assert state["call_frames"] == before
+
+
+def _lisp_lineage_state(graph, *, running: bool):
+    bundle, manager, state, frame_id, tmp_path = graph
+    base = f"{frame_id}-base"
+    template = state["call_frames"].pop(frame_id)
+    for new_id, status in ((base, "failed"), (f"{base}::retry::1", "running" if running else "failed")):
+        frame = copy.deepcopy(template)
+        frame["status"] = status
+        frame["call_frame_id"] = new_id
+        state["call_frames"][new_id] = frame
+    return bundle, manager, state, base, tmp_path
+
+
+def test_validation_order_running_member_first_then_predecessors_then_running_scope(graph):
+    bundle, manager, state, base, tmp_path = _lisp_lineage_state(graph, running=True)
+    events: list[tuple[str, str]] = []
+    original_checksum = CallExecutor.validate_resume_checksum
+    original_inputs = CallExecutor.validate_resume_bound_inputs
+
+    def checksum(call_executor, **kwargs):
+        events.append(("checksum", kwargs["frame_id"]))
+        return original_checksum(call_executor, **kwargs)
+
+    def inputs(call_executor, **kwargs):
+        events.append(("inputs", kwargs["frame_id"]))
+        return original_inputs(call_executor, **kwargs)
+
+    def audit(_bundle, _state, scope_path):
+        events.append(("audit", scope_path.call_frame_ids[-1]))
+
+    with patch.object(CallExecutor, "_is_workflow_lisp_target", return_value=True), patch.object(
+        CallExecutor, "validate_resume_checksum", checksum
+    ), patch.object(CallExecutor, "validate_resume_bound_inputs", inputs), patch(
+        "orchestrator.workflow.calls.audit_scope", audit
+    ), _no_child():
+        with pytest.raises(AssertionError, match="callee state was created"):
+            _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    running = f"{base}::retry::1"
+    assert events == [
+        ("checksum", running),
+        ("inputs", running),
+        ("checksum", base),
+        ("audit", base),
+        ("audit", running),
+    ]
+
+
+def test_running_member_checksum_failure_wins_over_predecessor_corruption(graph):
+    bundle, manager, state, base, tmp_path = _lisp_lineage_state(graph, running=True)
+    state["call_frames"][base]["state"]["current_step"] = dict(BAD_STEP)
+    state["call_frames"][f"{base}::retry::1"]["state"]["workflow_checksum"] = "sha256:" + "0" * 64
+
+    with patch.object(CallExecutor, "_is_workflow_lisp_target", return_value=True), _no_child():
+        result = _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    assert result["error"]["type"] == "call_resume_checksum_mismatch"
+
+
+def test_failed_predecessor_is_audited_before_a_fresh_retry_is_allocated(graph):
+    bundle, manager, state, base, tmp_path = _lisp_lineage_state(graph, running=False)
+    state["call_frames"][f"{base}::retry::1"]["state"]["current_step"] = dict(BAD_STEP)
+    before = json.loads(json.dumps(state["call_frames"]))
+
+    with patch.object(CallExecutor, "_is_workflow_lisp_target", return_value=True), _no_child():
+        result = _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    assert result["error"]["type"] == "resume_projection_integrity_error"
+    assert result["error"]["context"]["scope_path"][-1] == {
+        "kind": "call_frame",
+        "frame_id": f"{base}::retry::1",
+    }
+    assert state["call_frames"] == before
+    assert state["error"] == result["error"]
+
+
+def test_fresh_retry_uses_the_lowest_unused_ordinal(graph):
+    bundle, manager, state, base, tmp_path = _lisp_lineage_state(graph, running=False)
+    executor = _executor(bundle, tmp_path, manager)
+
+    with patch.object(CallExecutor, "_is_workflow_lisp_target", return_value=True):
+        result = _execute(executor, bundle, state)
+
+    assert result["status"] == "completed"
+    assert f"{base}::retry::2" in state["call_frames"]
+
+
+def test_ambiguous_open_frames_never_select_by_mapping_order(graph):
+    bundle, manager, state, frame_id, tmp_path = graph
+    state["call_frames"][frame_id]["status"] = "running"
+    _frame_copy(state, frame_id, f"{frame_id}-second", status="failed")
+
+    with _no_child():
+        result = _execute(_executor(bundle, tmp_path, manager), bundle, state)
+
+    assert result["error"]["context"]["reason"] == "ambiguous_resumable_call_frame"
+    assert result["error"]["context"]["candidate_count"] == 2

+    wrong_slot = projection.resolve_resume_step_id(index, LOOP_CALL_ID, "ProcessItems")
+    prefix = projection.resolve_resume_step_id(index, "root.review_loop#0")
+    unhashable = projection.resolve_resume_step_id(index, {"a": 1})
+
+    assert exact.slot is not None and exact.slot.iteration_index == 0
+    assert (wrong_slot.slot, wrong_slot.candidate_count, wrong_slot.exact_identity_candidate_count) == (
+        None,
+        1,
+        0,
+    )
+    assert (prefix.slot, prefix.candidate_count) == (None, 0)
+    assert (unhashable.slot, unhashable.candidate_count) == (None, 0)
+    assert projection.resolve_call_boundary(index, FOR_EACH_CALL_ID).boundary.import_alias == "review"
+    assert projection.resolve_call_boundary(index, "root.review_loop").candidate_count == 0
+
+
+def test_unclaimed_rows_snapshot_unhashable_ids(completed):
+    bundle, state = completed
+    candidate = _mutated(state, lambda s: s["steps"].update(Ghost={"step_id": ["x"]}))
+
+    index = bundle.projection.enumerate_resume_slots(candidate)
+    candidate["steps"]["Ghost"]["step_id"].append("y")
+
+    assert index.unclaimed_explicit_rows == (("Ghost", ["x"]),)
+
+
+# ---- retry lineage ------------------------------------------------------------------------
+
+
+def _frames(*specs, boundary="B", alias="a"):
+    return [
+        (frame_id, {"status": status, "call_step_id": boundary, "import_alias": alias})
+        for frame_id, status in specs
+    ]
+
+
+def _lineage(*specs, kind: str | None = "workflow_lisp"):
+    return index_retry_lineage("B", _frames(*specs), frontend_kind=kind)
+
+
+def test_workflow_lisp_lineage_orders_failed_predecessors_and_finds_running_member():
+    lineage = _lineage(
+        ("F::retry::2", "running"),
+        ("F::retry::1", "failed"),
+        ("F", "failed"),
+        ("F::retry::5", "completed"),
+    )
+
+    assert lineage.base_frame_id == "F"
+    assert [member.ordinal for member in lineage.failed_predecessors] == [0, 1]
+    assert lineage.running_member.frame_id == "F::retry::2"
+    assert [member.frame_id for member in lineage.completed_members] == ["F::retry::5"]
+
+
+def test_next_retry_id_is_lowest_unused_positive_ordinal_and_idempotent():
+    lineage = _lineage(("F", "failed"), ("F::retry::2", "failed"), ("F::retry::1", "completed"))
+
+    assert next_unused_retry_frame_id(lineage) == "F::retry::3"
+    assert next_unused_retry_frame_id(lineage) == "F::retry::3"
+    gap = _lineage(("F", "failed"), ("F::retry::2", "failed"))
+    assert next_unused_retry_frame_id(gap) == "F::retry::1"
+
+
+@pytest.mark.parametrize(
+    ("specs", "reason"),
+    [
+        ((("F", "running"), ("F::retry::1", "running")), "ambiguous_resumable_call_frame"),
+        ((("F", "failed"), ("G::retry::1", "failed")), "ambiguous_resumable_call_frame"),
+        ((("F", "failed"), ("F::retry::", "failed")), "unsupported_shape"),
+        ((("F", "failed"), ("F::retry::x", "failed")), "unsupported_shape"),
+        ((("F", "failed"), ("F::retry::0", "failed")), "unsupported_shape"),
+        ((("F", "failed"), ("F::retry::1::retry::2", "failed")), "unsupported_shape"),
+        ((("F", "paused"),), "unsupported_shape"),
+    ],
+)
+def test_invalid_lineages_fail_closed(specs, reason):
+    with pytest.raises(CallFrameRetryLineageError) as exc_info:
+        _lineage(*specs)
+
+    assert exc_info.value.reason == reason
+
+
+def test_lineage_rejects_foreign_boundary_and_alias_disagreement():
+    foreign = [("F", {"status": "failed", "call_step_id": "other", "import_alias": "a"})]
+    mixed = _frames(("F", "failed")) + [
+        ("F::retry::1", {"status": "failed", "call_step_id": "B", "import_alias": "b"})
+    ]
+
+    with pytest.raises(CallFrameRetryLineageError) as foreign_error:
+        index_retry_lineage("B", foreign, frontend_kind="workflow_lisp")
+    with pytest.raises(CallFrameRetryLineageError) as alias_error:
+        index_retry_lineage("B", mixed, frontend_kind="workflow_lisp")
+
+    assert foreign_error.value.reason == "missing_call_boundary"
+    assert alias_error.value.reason == "persisted_import_alias_mismatch"
+
+
+def test_non_workflow_lisp_boundary_allows_one_open_frame():
+    single = _lineage(("F", "failed"), ("G", "completed"), kind=None)
+
+    assert single.running_member.frame_id == "F"
+    with pytest.raises(CallFrameRetryLineageError) as exc_info:
+        _lineage(("F", "failed"), ("G", "running"), kind=None)
+    assert exc_info.value.reason == "ambiguous_resumable_call_frame"
+
+
+def test_scope_path_snapshots_and_describes_frames():
+    frames = ["f1"]
+    path = ResumeScopePath("w.yaml", frames).child("f2")
+    frames.append("late")
+
+    assert path.call_frame_ids == ("f1", "f2")
+    assert path.projection_scope == "call_frame"
+    assert ResumeScopePath.root("w.yaml").projection_scope == "root"
+    assert path.as_context() == [
+        {"kind": "root", "workflow_file": "w.yaml"},
+        {"kind": "call_frame", "frame_id": "f1"},
+        {"kind": "call_frame", "frame_id": "f2"},
+    ]
+
+
+def test_auditor_stays_independent_of_migration_evidence():
+    source = Path(integrity_module.__file__).read_text(encoding="utf-8")
+    lineage_source = Path(integrity_module.index_retry_lineage.__code__.co_filename).read_text(
+        encoding="utf-8"
+    )
+    projection_source = Path(projection_module.__file__).read_text(encoding="utf-8")
+
+    for text in (source, lineage_source):
+        for forbidden in (
+            "migration_parity",
+            "procedure_identity_retirement",
+            "load_parity_targets",
+            "load_retirement_evidence",
+            "load_retirement_record",
+            "validate_retirement_record",
+        ):
+            assert forbidden not in text
+        assert "receipt" not in text.lower()
+        assert not re.search(r"cache.*(audit|projection integrity|resume projection)", text, re.I)
+    assert "receipt" not in projection_source.lower()

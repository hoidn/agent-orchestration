--- /dev/null
+++ b/orchestrator/workflow/resume_call_lineage.py
@@ -0,0 +1,178 @@
+"""Retry lineage of persisted call frames for one call boundary.
+
+Pure functions over ``(frame_id, frame)`` pairs: no state is read besides the pairs and
+nothing is mutated.  A Workflow Lisp boundary groups its non-completed frames into one
+retry lineage (``B`` is ordinal 0, ``B::retry::<n>`` are retries); any other boundary
+may have at most one non-completed frame.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND = "workflow_lisp"
+_KNOWN_STATUSES = frozenset({"completed", "running", "failed"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """The persisted frames of one boundary cannot form a valid lineage."""
+
+    def __init__(self, reason: str, message: str, count: Optional[int] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.count = count
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    """One persisted call frame of a boundary."""
+
+    frame_id: str
+    frame: Mapping[str, Any] = field(compare=False, repr=False)
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    """A lineage member with its retry ordinal (0 is the base frame)."""
+
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    """Classified frames of one boundary."""
+
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...] = ()
+    failed_predecessors: tuple[CallFrameMember, ...] = ()
+    running_member: Optional[CallFrameMember] = None
+    used_ordinals: frozenset[int] = frozenset()
+
+
+def _marker_tail(frame_id: str) -> Optional[tuple[str, str]]:
+    """Split a trailing retry marker; ids with a marker mid-id (child frames) have none."""
+    head, sep, tail = frame_id.rpartition(RETRY_MARKER)
+    if not sep or "." in tail or "::" in tail:
+        return None
+    return head, tail
+
+
+def split_retry_frame_id(frame_id: str) -> tuple[str, int]:
+    """Return ``(base, ordinal)``; raise ``unsupported_shape`` on a bad or nested marker."""
+    split = _marker_tail(frame_id)
+    if split is None:
+        return frame_id, 0
+    head, tail = split
+    if not (tail.isascii() and tail.isdigit()) or tail.startswith("0"):
+        raise CallFrameRetryLineageError("unsupported_shape", "malformed retry ordinal")
+    if _marker_tail(head) is not None:
+        raise CallFrameRetryLineageError("unsupported_shape", "nested retry marker")
+    return head, int(tail)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[str, Any]]
+) -> list[tuple[str, Mapping[str, Any]]]:
+    frames: list[tuple[str, Mapping[str, Any]]] = []
+    aliases: set[Any] = set()
+    for frame_id, frame in frame_items:
+        if not isinstance(frame_id, str) or not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError("unsupported_shape", "malformed call frame")
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError("missing_call_boundary", "frame is not owned by the boundary")
+        if frame.get("status") not in _KNOWN_STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", "unknown call frame status")
+        aliases.add(frame.get("import_alias"))
+        frames.append((frame_id, frame))
+    if len(aliases) > 1:
+        raise CallFrameRetryLineageError("persisted_import_alias_mismatch", "frames disagree on import alias")
+    return frames
+
+
+def _single_resumable(frames: list[tuple[str, Mapping[str, Any]]]) -> CallFrameRetryLineage:
+    completed = tuple(CallFrameMember(fid, f) for fid, f in frames if f["status"] == "completed")
+    open_frames = [(fid, f) for fid, f in frames if f["status"] != "completed"]
+    if len(open_frames) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "several non-completed frames", len(open_frames)
+        )
+    running = CallFrameMember(*open_frames[0]) if open_frames else None
+    return CallFrameRetryLineage(
+        base_frame_id=running.frame_id if running else None,
+        completed_members=completed,
+        running_member=running,
+    )
+
+
+def _workflow_lisp_lineage(frames: list[tuple[str, Mapping[str, Any]]]) -> CallFrameRetryLineage:
+    open_members: list[RetryFrameMember] = []
+    bases: set[str] = set()
+    for frame_id, frame in frames:
+        if frame["status"] == "completed":
+            continue
+        base, ordinal = split_retry_frame_id(frame_id)
+        bases.add(base)
+        open_members.append(RetryFrameMember(frame_id, frame, ordinal))
+    if len(bases) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "mixed retry bases", len(open_members)
+        )
+    base = next(iter(bases), None)
+    ordinals = [member.ordinal for member in open_members]
+    if len(set(ordinals)) != len(ordinals):
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "duplicate retry ordinal", len(open_members)
+        )
+    running = [member for member in open_members if member.frame["status"] == "running"]
+    if len(running) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "several running members", len(running)
+        )
+    completed: list[CallFrameMember] = []
+    used = set(ordinals)
+    for frame_id, frame in frames:
+        if frame["status"] != "completed":
+            continue
+        completed.append(CallFrameMember(frame_id, frame))
+        try:
+            completed_base, ordinal = split_retry_frame_id(frame_id)
+        except CallFrameRetryLineageError:
+            continue  # completed frames are historical records, never resumable
+        if completed_base == base:
+            used.add(ordinal)
+    failed = sorted(
+        (member for member in open_members if member.frame["status"] == "failed"),
+        key=lambda member: member.ordinal,
+    )
+    return CallFrameRetryLineage(
+        base_frame_id=base,
+        completed_members=tuple(completed),
+        failed_predecessors=tuple(failed),
+        running_member=running[0] if running else None,
+        used_ordinals=frozenset(used),
+    )
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Classify the persisted frames of one boundary or raise ``CallFrameRetryLineageError``."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    if frontend_kind == WORKFLOW_LISP_FRONTEND:
+        return _workflow_lisp_lineage(frames)
+    return _single_resumable(frames)
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<n>`` for the lowest unused positive ordinal."""
+    if lineage.base_frame_id is None:
+        raise ValueError("lineage has no base frame")
+    ordinal = 1
+    while ordinal in lineage.used_ordinals:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"
diff --git a/orchestrator/workflow/resume_loop_progress.py b/orchestrator/workflow/resume_loop_progress.py
new file mode 100644
index 0000000..4c922a6
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_progress.py
@@ -0,0 +1,164 @@
+"""Read-only validation of persisted loop bookkeeping for checksum-compatible resume.
+
+Depends only on the persisted state mapping and the declared repeat_until bounds
+supplied by the caller; it never mutates, backfills or loads anything.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+REPEAT_UNTIL_EXHAUSTED = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted bookkeeping or identity violates the current projection."""
+
+    def __init__(self, reason: str, message: str, field: Optional[str] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+
+    def __str__(self) -> str:
+        return self.message
+
+
+def _shape(field: str, rest: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", f"{field} {rest}", field)
+
+
+def _progress(field: str, rest: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", f"{field} {rest}", field)
+
+
+def _loop_progress(prefix: str, text: str, field: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", f"{prefix}.{text}", field)
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_index(value: Any) -> bool:
+    return _is_int(value) and value >= 0
+
+
+def _loop_section(state: Mapping[str, Any], section: str) -> Mapping[str, Any]:
+    value = state.get(section)
+    if value is None:
+        return {}
+    if not isinstance(value, Mapping):
+        raise _shape(section, "must be a mapping")
+    return value
+
+
+def validate_for_each_progress(state: Mapping[str, Any]) -> dict[str, int]:
+    """Validate ``for_each`` bookkeeping; return the item count per loop name."""
+    counts: dict[str, int] = {}
+    for name, progress in _loop_section(state, "for_each").items():
+        prefix = f"for_each.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(prefix, "must be a mapping")
+        items = progress.get("items")
+        if not isinstance(items, list):
+            raise _shape(f"{prefix}.items", "must be a list")
+        current = progress.get("current_index")
+        if current is not None and not _is_int(current):
+            raise _shape(f"{prefix}.current_index", "must be null or a non-boolean integer")
+        completed = progress.get("completed_indices", [])
+        if not isinstance(completed, list):
+            raise _shape(f"{prefix}.completed_indices", "must be a list")
+        if len(set(map(repr, completed))) != len(completed):
+            raise _progress(f"{prefix}.completed_indices", "must not contain duplicate indices")
+        if any(not _is_index(index) or index >= len(items) for index in completed):
+            raise _progress(f"{prefix}.completed_indices", "contains an out-of-range index")
+        if current is not None and not 0 <= current < len(items):
+            raise _progress(f"{prefix}.current_index", "is out of range")
+        if current is not None and current in completed:
+            raise _progress(f"{prefix}.current_index", "is already completed")
+        counts[name] = len(items)
+    return counts
+
+
+def _validate_active(
+    prefix: str, progress: Mapping[str, Any], current: int, completed: list, maximum: Optional[int]
+) -> None:
+    if maximum is not None and current >= maximum:
+        raise _progress(f"{prefix}.current_iteration", "is out of range")
+    if current in completed or any(index >= current for index in completed):
+        raise _progress(f"{prefix}.completed_iterations", "is not valid prior history")
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if evaluated is None:
+        consistent = result is None
+    else:
+        consistent = evaluated == current and isinstance(result, bool)
+    if not consistent or progress.get("exhausted") is True:
+        raise _loop_progress(prefix, "condition result conflicts with evaluation state", f"{prefix}.last_condition_result")
+
+
+def _validate_terminal(
+    prefix: str,
+    progress: Mapping[str, Any],
+    completed: list,
+    maximum: Optional[int],
+    row: Any,
+) -> None:
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if not completed or not _is_index(evaluated) or evaluated != max(completed) or not isinstance(result, bool):
+        raise _loop_progress(prefix, "terminal progress requires completed evaluated history", f"{prefix}.completed_iterations")
+    exhausted = progress.get("exhausted") is True
+    if result is True:
+        if exhausted:
+            raise _loop_progress(prefix, "condition result conflicts with evaluation state", f"{prefix}.last_condition_result")
+        return
+    if maximum is not None and sorted(completed) != list(range(maximum)):
+        raise _loop_progress(prefix, "terminal progress requires completed evaluated history", f"{prefix}.completed_iterations")
+    if row is None:
+        return  # loop step not recorded (yet): resume re-derives it from the bookkeeping
+    status = row.get("status") if isinstance(row, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _loop_progress(prefix, "successful exhaustion requires a completed frame", f"{prefix}.exhausted")
+        return
+    error = row.get("error") if isinstance(row, Mapping) else None
+    error_type = error.get("type") if isinstance(error, Mapping) else None
+    if status != "failed" or error_type != REPEAT_UNTIL_EXHAUSTED:
+        raise _loop_progress(prefix, "failed exhaustion requires the terminal exhaustion error", f"{prefix}.exhausted")
+
+
+def validate_repeat_until_progress(
+    state: Mapping[str, Any], maximum_by_name: Mapping[str, Optional[int]]
+) -> dict[str, tuple[int, ...]]:
+    """Validate ``repeat_until`` bookkeeping; return known iteration indices per loop name."""
+    steps = state.get("steps")
+    iterations: dict[str, tuple[int, ...]] = {}
+    for name, progress in _loop_section(state, "repeat_until").items():
+        prefix = f"repeat_until.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(prefix, "must be a mapping")
+        current = progress.get("current_iteration")
+        if current is not None and not _is_int(current):
+            raise _shape(f"{prefix}.current_iteration", "must be null or a non-boolean integer")
+        exhausted = progress.get("exhausted")
+        if exhausted is not None and not isinstance(exhausted, bool):
+            raise _shape(f"{prefix}.exhausted", "must be boolean when present")
+        completed = progress.get("completed_iterations", [])
+        if not isinstance(completed, list):
+            raise _shape(f"{prefix}.completed_iterations", "must be a list")
+        if len(set(map(repr, completed))) != len(completed):
+            raise _progress(f"{prefix}.completed_iterations", "must not contain duplicate indices")
+        maximum = maximum_by_name.get(name)
+        if any(not _is_index(index) or (maximum is not None and index >= maximum) for index in completed):
+            raise _progress(f"{prefix}.completed_iterations", "is not valid prior history")
+        if current is not None and (current < 0):
+            raise _progress(f"{prefix}.current_iteration", "is out of range")
+        if current is not None:
+            _validate_active(prefix, progress, current, completed, maximum)
+        else:
+            row = steps.get(name) if isinstance(steps, Mapping) else None
+            _validate_terminal(prefix, progress, completed, maximum, row)
+        iterations[name] = tuple(completed) + ((current,) if current is not None else ())
+    return iterations
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..cf96412
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,289 @@
+"""Checksum-compatible resume projection integrity audit.
+
+``audit_scope(bundle, state, scope_path)`` checks every persisted durable identity of ONE
+scope (steps, current step, loop bookkeeping, call frames) against the projection of the
+bundle that owns that scope.  It reads only its arguments, never mutates the state and
+fails closed with one stable ``resume_projection_integrity_error`` diagnostic.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from .resume_call_lineage import (
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .state_projection import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    explicit_step_rows,
+)
+
+__all__ = [
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RESUME_PROJECTION_INTEGRITY_ERROR",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "RetryFrameMember",
+    "audit_scope",
+    "build_integrity_error",
+    "index_retry_lineage",
+    "is_sticky_projection_failure",
+    "next_unused_retry_frame_id",
+]
+
+RESUME_PROJECTION_INTEGRITY_ERROR = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_KNOWN_FRAME_STATUSES = frozenset({"completed", "running", "failed"})
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through the call frames entered."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        path = [{"kind": "root", "workflow_file": self.root_workflow_file}]
+        path.extend({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids)
+        return path
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """A persisted identity is not owned by the current projection."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def is_sticky_projection_failure(result: Any) -> bool:
+    """True for a step result or run state carrying the non-routable projection diagnostic."""
+    error = result.get("error") if isinstance(result, Mapping) else None
+    return isinstance(error, Mapping) and error.get("type") == RESUME_PROJECTION_INTEGRITY_ERROR
+
+
+def _scalar(value: Any) -> Any:
+    return value if value is None or isinstance(value, (str, int, float, bool)) else None
+
+
+class _ScopeAudit:
+    def __init__(self, bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.projection = bundle.projection
+
+    def fail(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        offending: Any = None,
+        count: Optional[int] = None,
+        boundary_step_id: Optional[str] = None,
+    ) -> NoReturn:
+        workflow_path = getattr(getattr(self.bundle, "provenance", None), "workflow_path", None)
+        checksum = self.state.get("workflow_checksum") if isinstance(self.state, Mapping) else None
+        raise ResumeProjectionIntegrityError(
+            {
+                "type": RESUME_PROJECTION_INTEGRITY_ERROR,
+                "message": f"Resume projection integrity audit failed: {reason}",
+                "context": {
+                    "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                    "reason": reason,
+                    "scope_path": self.scope_path.as_context(),
+                    "field": field,
+                    "offending_value": _scalar(offending),
+                    "expected_owner": {
+                        "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                        "workflow_checksum": _scalar(checksum),
+                        "projection_scope": self.scope_path.projection_scope,
+                    },
+                    "candidate_count": count,
+                    "call_boundary_step_id": _scalar(boundary_step_id),
+                },
+            }
+        )
+
+    def run(self) -> None:
+        frames = self._check_shapes()
+        try:
+            slot_index = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            self.fail(exc.reason, field=exc.field)
+        self._audit_step_rows(slot_index)
+        self._audit_current_step(slot_index)
+        self._audit_call_frames(slot_index, frames)
+
+    def _check_shapes(self) -> Mapping[str, Any]:
+        if not isinstance(self.state, Mapping):
+            self.fail("unsupported_shape")
+        steps = self.state.get("steps", {})
+        if not isinstance(steps, Mapping):
+            self.fail("unsupported_shape", field="steps")
+        frames = self.state.get("call_frames", {})
+        if not isinstance(frames, Mapping):
+            self.fail("unsupported_shape", field="call_frames")
+        for frame_id, frame in frames.items():
+            if not isinstance(frame, Mapping):
+                self.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+        for name, row in steps.items():
+            if not isinstance(row, (Mapping, list)):
+                self.fail("unsupported_shape", field=f"steps.{name}")
+            if isinstance(row, list) and not all(isinstance(item, Mapping) for item in row):
+                self.fail("unsupported_shape", field=f"steps.{name}")
+        return frames
+
+    def _audit_step_rows(self, slot_index: ResumeProjectionSlotIndex) -> None:
+        unclaimed = {name for name, _ in slot_index.unclaimed_explicit_rows}
+        for name, step_id in explicit_step_rows(self.state.get("steps", {})):
+            field = f"steps.{name}.step_id"
+            if not isinstance(step_id, str) or not step_id:
+                self.fail("unsupported_shape", field=field, offending=step_id)
+            resolution = self.projection.resolve_resume_step_id(slot_index, step_id, name)
+            if resolution.candidate_count == 0:
+                reason = "unclaimed_explicit_step_row" if name in unclaimed else "unknown_explicit_step_id"
+                self.fail(reason, field=field, offending=step_id, count=0)
+            if resolution.candidate_count > 1:
+                self.fail("unsupported_shape", field=field, offending=step_id, count=resolution.candidate_count)
+            if resolution.slot is None:
+                self.fail("presentation_slot_mismatch", field=field, offending=step_id, count=1)
+
+    def _audit_current_step(self, slot_index: ResumeProjectionSlotIndex) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        field = "current_step.step_id"
+        if not isinstance(current, Mapping):
+            self.fail("unsupported_shape", field="current_step")
+        if current.get("step_id") is None:
+            self.fail("missing_required_identity", field=field)
+        step_id = current["step_id"]
+        if not isinstance(step_id, str) or not step_id:
+            self.fail("unsupported_shape", field=field, offending=step_id)
+        resolution = self.projection.resolve_resume_step_id(slot_index, step_id)
+        if resolution.candidate_count == 0:
+            self.fail("out_of_scope_step_id", field=field, offending=step_id, count=0)
+        if resolution.candidate_count > 1:
+            self.fail("unsupported_shape", field=field, offending=step_id, count=resolution.candidate_count)
+        slot = resolution.slot
+        name = current.get("name")
+        if slot is not None and slot.iteration_index is None and isinstance(name, str) and name:
+            if name != slot.presentation_key:
+                self.fail("presentation_slot_mismatch", field=field, offending=step_id, count=1)
+
+    def _audit_call_frames(self, slot_index: ResumeProjectionSlotIndex, frames: Mapping[str, Any]) -> None:
+        by_boundary: dict[str, list[tuple[str, Mapping[str, Any]]]] = {}
+        frontend_by_boundary: dict[str, Optional[str]] = {}
+        for frame_id, frame in frames.items():
+            call_step_id = frame.get("call_step_id")
+            field = f"call_frames.{frame_id}.call_step_id"
+            if call_step_id is None:
+                self.fail("missing_required_identity", field=field)
+            if not isinstance(call_step_id, str) or not call_step_id:
+                self.fail("unsupported_shape", field=field, offending=call_step_id)
+            if frame.get("status") not in _KNOWN_FRAME_STATUSES:
+                self.fail(
+                    "unsupported_shape",
+                    field=f"call_frames.{frame_id}.status",
+                    offending=frame.get("status"),
+                    boundary_step_id=call_step_id,
+                )
+            boundary = self._resolve_boundary(slot_index, frame_id, call_step_id)
+            alias = frame.get("import_alias")
+            if alias != boundary.import_alias:
+                self.fail(
+                    "persisted_import_alias_mismatch",
+                    field=f"call_frames.{frame_id}.import_alias",
+                    offending=alias,
+                    count=1,
+                    boundary_step_id=call_step_id,
+                )
+            imported = self.bundle.imports.get(boundary.import_alias)
+            if imported is None:
+                self.fail(
+                    "missing_imported_bundle",
+                    field=f"imports.{boundary.import_alias}",
+                    offending=boundary.import_alias,
+                    count=1,
+                    boundary_step_id=call_step_id,
+                )
+            by_boundary.setdefault(call_step_id, []).append((frame_id, frame))
+            frontend_by_boundary[call_step_id] = getattr(

diff --git a/orchestrator/loader_imports.py b/orchestrator/loader_imports.py
new file mode 100644
index 0000000..ce415a4
--- /dev/null
+++ b/orchestrator/loader_imports.py
@@ -0,0 +1,60 @@
+"""Source-level `imports` alias checks that plain `yaml.load` cannot see.
+
+PyYAML silently keeps the last of duplicate mapping keys and folds `<<` merges,
+so repeated import aliases or repeated top-level `imports` sections vanish from
+the loaded dict. These checks walk the composed node graph (with marks) instead.
+"""
+
+from typing import Dict, Iterator, List, Tuple
+
+import yaml
+from yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _pairs(node: MappingNode) -> Iterator[Tuple[Node, Node]]:
+    """Yield the (key, value) node pairs of a mapping, expanding `<<` merge sources."""
+    for key, value in node.value:
+        if key.tag == MERGE_TAG:
+            sources = value.value if isinstance(value, SequenceNode) else [value]
+            for source in sources:
+                if isinstance(source, MappingNode):
+                    yield from _pairs(source)
+        else:
+            yield key, value
+
+
+def _position(node: Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _positions(nodes: List[Node]) -> str:
+    return "; ".join(_position(node) for node in nodes)
+
+
+def import_alias_errors(text: str, loader: type) -> List[str]:
+    """Return error messages for duplicate import aliases / top-level `imports` sections."""
+    root = yaml.compose(text, Loader=loader)
+    if not isinstance(root, MappingNode):
+        return []
+
+    section_keys: List[Node] = []
+    alias_keys: Dict[str, List[Node]] = {}
+    for key, value in _pairs(root):
+        if not (isinstance(key, ScalarNode) and key.value == "imports"):
+            continue
+        section_keys.append(key)
+        if isinstance(value, MappingNode):
+            for alias_key, _ in _pairs(value):
+                if isinstance(alias_key, ScalarNode):
+                    alias_keys.setdefault(alias_key.value, []).append(alias_key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias at {_positions(nodes)}"
+        for alias, nodes in alias_keys.items()
+        if len(nodes) > 1
+    ]
+    if not errors and len(section_keys) > 1:
+        errors.append(f"imports: duplicate top-level mapping at {_positions(section_keys)}")
+    return errors

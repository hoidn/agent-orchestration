+    assert error["context"]["scope_path"] == [{"kind": "root", "workflow_file": "workflow.yaml"}]
+    assert error["context"]["expected_owner"]["projection_scope"] == "root"
+    assert error["context"]["expected_owner"]["workflow_checksum"] == state["workflow_checksum"]

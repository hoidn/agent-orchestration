+                                "from": {"ref": "self.steps.RunReviewLoop.artifacts.decision"},
+                            }
+                        },
+                        "condition": {
+                            "compare": {
+                                "left": {"ref": "self.outputs.decision"},
+                                "op": "eq",
+                                "right": "APPROVE",
+                            }
+                        },
+                        "max_iterations": 3,
+                        "steps": [

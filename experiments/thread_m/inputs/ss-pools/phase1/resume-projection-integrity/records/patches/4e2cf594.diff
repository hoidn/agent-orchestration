+"""A current_step left by a resume failure envelope is forensic, never live."""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import build_status_snapshot, derive_status_projection, render_status_markdown
+
+
+@pytest.fixture()
+def bundle(tmp_path):
+    path = tmp_path / "workflow.yaml"
+    path.write_text(
+        yaml.safe_dump(
+            {
+                "version": "2.7",
+                "name": "forensic",
+                "steps": [{"name": "Work", "id": "work", "command": ["true"]}],
+            }
+        ),
+        encoding="utf-8",
+    )
+    return WorkflowLoader(tmp_path).load_bundle(path)
+
+
+def _state(error_type: str, *, status: str = "failed") -> dict:
+    return {
+        "run_id": "r",
+        "status": status,
+        "started_at": "2026-01-01T00:00:00+00:00",
+        "updated_at": "2026-01-01T00:00:01+00:00",
+        "workflow_file": "workflow.yaml",
+        "steps": {},
+        "current_step": {
+            "name": "Work",
+            "step_id": "root.work",
+            "status": "running",
+            "visit_count": 3,
+            "started_at": "2026-01-01T00:00:00+00:00",
+        },
+        "error": {"type": error_type, "message": "m", "context": {}},
+    }
+
+
+@pytest.mark.parametrize("error_type", ["resume_projection_integrity_error", "workflow_checksum_mismatch"])
+def test_unchanged_current_step_after_an_envelope_is_reported_pending(bundle, tmp_path, error_type):
+    snapshot = build_status_snapshot(bundle, _state(error_type), tmp_path)
+
+    step = snapshot["steps"][0]
+    assert snapshot["run"]["status"] == "failed"
+    assert snapshot["run"]["error"]["type"] == error_type
+    assert (step["status"], step["summary"], step["current_visit_count"]) == ("pending", "pending", None)
+    assert snapshot["progress"]["pending"] == 1
+    assert snapshot["progress"]["running"] == 0
+    assert "in progress" not in render_status_markdown(snapshot)
+
+
+def test_ordinary_failed_run_keeps_reporting_its_running_step(bundle, tmp_path):
+    snapshot = build_status_snapshot(bundle, _state("call_failed"), tmp_path)
+
+    assert snapshot["steps"][0]["status"] == "running"
+
+
+def test_forensic_current_step_is_not_interpreted_as_a_live_heartbeat(bundle, tmp_path):
+    state = _state("resume_projection_integrity_error")
+    far_future = datetime.now(timezone.utc) + timedelta(days=1)
+
+    projection = derive_status_projection(state, [], now=far_future)
+
+    assert projection["display_status"] == "failed"
+    assert projection["display_status_reason"] is None

@@ -0,0 +1,125 @@
+"""Classic-YAML import alias checks that plain yaml.load would silently collapse."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LEAF = """\
+version: "2.5"
+name: leaf
+steps:
+  - name: Noop
+    command: ["true"]
+"""
+
+STEPS = """\
+steps:
+  - name: Noop
+    command: ["true"]
+"""
+
+
+def _workspace(tmp_path: Path, caller: str) -> Path:
+    (tmp_path / "lib").mkdir()
+    for name in ("a.yaml", "b.yaml", "c.yaml"):
+        (tmp_path / "lib" / name).write_text(LEAF, encoding="utf-8")
+    workflow = tmp_path / "workflow.yaml"
+    workflow.write_text(caller, encoding="utf-8")
+    return workflow
+
+
+def _bundle_not_reached(monkeypatch):
+    def _fail(*_args, **_kwargs):
+        raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _fail)
+
+
+def _messages(tmp_path: Path, caller: str, monkeypatch) -> list[str]:
+    _bundle_not_reached(monkeypatch)
+    workflow = _workspace(tmp_path, caller)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(tmp_path).load(workflow)
+    return [error.message for error in excinfo.value.errors]
+
+
+def test_duplicate_alias_within_one_mapping(tmp_path, monkeypatch):
+    caller = 'version: "2.5"\nname: c\nimports:\n  a: lib/a.yaml\n  a: lib/b.yaml\n' + STEPS
+    assert _messages(tmp_path, caller, monkeypatch) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 5, column 3"
+    ]
+
+
+def test_duplicate_alias_via_merge_inside_imports(tmp_path, monkeypatch):
+    caller = (
+        'version: "2.5"\nname: c\n'
+        "x-base: &base\n  a: lib/a.yaml\n"
+        "imports:\n  <<: *base\n  a: lib/b.yaml\n" + STEPS
+    )
+    assert _messages(tmp_path, caller, monkeypatch) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 7, column 3"
+    ]
+
+
+def test_duplicate_alias_across_repeated_sections_reported_once(tmp_path, monkeypatch):
+    caller = (
+        'version: "2.5"\nname: c\n'
+        "imports:\n  a: lib/a.yaml\n"
+        "imports:\n  a: lib/b.yaml\n  b: lib/b.yaml\n" + STEPS
+    )
+    assert _messages(tmp_path, caller, monkeypatch) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 6, column 3"
+    ]
+
+
+def test_duplicate_alias_across_top_level_merge_sources(tmp_path, monkeypatch):
+    caller = (
+        "x-one: &one\n  imports:\n    a: lib/a.yaml\n"
+        "x-two: &two\n  imports:\n    a: lib/b.yaml\n"
+        '<<: [*one, *two]\nversion: "2.5"\nname: c\n' + STEPS
+    )
+    assert _messages(tmp_path, caller, monkeypatch) == [
+        "imports.a: duplicate import alias at line 3, column 5; line 6, column 5"
+    ]
+
+
+def test_repeated_sections_with_distinct_aliases(tmp_path, monkeypatch):
+    caller = (
+        'version: "2.5"\nname: c\n'
+        "imports:\n  a: lib/a.yaml\n"
+        "imports:\n  b: lib/b.yaml\n" + STEPS
+    )
+    assert _messages(tmp_path, caller, monkeypatch) == [
+        "imports: duplicate top-level mapping at line 3, column 1; line 5, column 1"
+    ]
+
+
+def test_merged_and_explicit_sections_with_distinct_aliases(tmp_path, monkeypatch):
+    caller = (
+        "x-base: &base\n  imports:\n    a: lib/a.yaml\n"
+        '<<: *base\nversion: "2.5"\nname: c\n'
+        "imports:\n  b: lib/b.yaml\n" + STEPS
+    )
+    assert _messages(tmp_path, caller, monkeypatch) == [
+        "imports: duplicate top-level mapping at line 2, column 3; line 7, column 1"
+    ]
+
+
+@pytest.mark.parametrize(
+    "caller",
+    [
+        'version: "2.5"\nname: c\n'
+        "imports:\n  <<: {a: lib/a.yaml}\n  b: lib/b.yaml\n" + STEPS,
+        "<<:\n  imports:\n    a: lib/a.yaml\n    b: lib/b.yaml\n"
+        'version: "2.5"\nname: c\n' + STEPS,
+    ],
+    ids=["merge-inside-imports", "top-level-merge"],
+)
+def test_single_merged_section_still_loads(tmp_path, caller):
+    workflow = _workspace(tmp_path, caller)
+    bundle = WorkflowLoader(tmp_path).load(workflow)
+    assert set(bundle.imports) == {"a", "b"}

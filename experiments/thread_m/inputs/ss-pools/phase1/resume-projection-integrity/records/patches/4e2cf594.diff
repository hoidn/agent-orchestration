+def test_diagnostic_has_the_stable_schema(completed):
+    bundle, state = completed
+    corrupted = _mutated(state, lambda s: s["steps"]["ReviewLoop"].update(step_id="root.gone"))
+
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        _audit(bundle, corrupted)

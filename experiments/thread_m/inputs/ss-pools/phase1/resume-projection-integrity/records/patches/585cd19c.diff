new file mode 100644
index 0000000..8b2dc69
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_progress.py
@@ -0,0 +1,160 @@
+"""Loop bookkeeping validation for checksum-compatible resume.
+
+Pure functions over persisted ``for_each`` / ``repeat_until`` progress and the
+persisted loop-frame row. They read only their arguments and never mutate them.
+Reasons are ``unsupported_shape`` or ``invalid_loop_progress``.
+"""
+
+from __future__ import annotations
+
+import copy
+from typing import Any, Mapping, Optional
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted resume bookkeeping is invalid for the current projection."""
+
+    def __init__(self, reason: str, message: str, field: Optional[str] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        # Dotted path of the offending bookkeeping field (loop level when not field-specific).
+        self.field = field if field is not None else message.split(" ", 1)[0]
+
+
+def snapshot(value: Any) -> Any:
+    """Return an isolated copy of a persisted value (best effort for odd objects)."""
+    try:
+        return copy.deepcopy(value)
+    except Exception:  # noqa: BLE001 - arbitrary persisted objects must never crash an audit
+        return repr(type(value))
+
+
+def _shape(message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message)
+
+
+def _progress(message: str, field: Optional[str] = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field)
+
+
+def is_plain_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _int_list(value: Any, label: str) -> list[int]:
+    if not isinstance(value, list) or not all(is_plain_int(item) and item >= 0 for item in value):
+        raise _shape(f"{label} must be a list of non-negative non-boolean integers")
+    return value
+
+
+def _optional_index(progress: Mapping[str, Any], key: str, label: str) -> Optional[int]:
+    value = progress.get(key)
+    if value is not None and not is_plain_int(value):
+        raise _shape(f"{label}.{key} must be null or a non-boolean integer")
+    return value
+
+
+def validate_for_each_progress(name: str, progress: Any) -> Optional[list]:
+    """Validate one ``for_each`` entry; return its items list."""
+    label = f"for_each.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(f"{label} must be a mapping")
+    items = progress.get("items")
+    if not isinstance(items, list):
+        raise _shape(f"{label}.items must be a list")
+    current = _optional_index(progress, "current_index", label)
+    completed = _int_list(progress.get("completed_indices", []), f"{label}.completed_indices")
+    if len(set(completed)) != len(completed):
+        raise _progress(f"{label}.completed_indices must not contain duplicate indices")
+    if any(index >= len(items) for index in completed):
+        raise _progress(f"{label}.completed_indices contains an out-of-range index")
+    if current is not None:
+        if current < 0 or current >= len(items):
+            raise _progress(f"{label}.current_index is out of range")
+        if current in completed:
+            raise _progress(f"{label}.current_index is already completed")
+    return items
+
+
+def _validate_active(label: str, progress: Mapping[str, Any], current: int, completed: list[int], maximum: Optional[int]) -> None:
+    if maximum is not None and current >= maximum:
+        raise _progress(f"{label}.current_iteration is out of range")
+    if any(index >= current for index in completed):
+        raise _progress(f"{label}.completed_iterations is not valid prior history")
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if evaluated is None:
+        consistent = result is None
+    else:
+        consistent = evaluated == current and is_plain_int(evaluated) and isinstance(result, bool)
+    if not consistent or progress.get("exhausted") is True:
+        raise _progress(f"{label}.condition result conflicts with evaluation state", label)
+
+
+def _validate_terminal(
+    label: str,
+    progress: Mapping[str, Any],
+    completed: list[int],
+    maximum: Optional[int],
+    frame: Any,
+) -> None:
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    if (
+        not completed
+        or not is_plain_int(evaluated)
+        or evaluated != max(completed)
+        or (maximum is not None and evaluated >= maximum)
+    ):
+        raise _progress(f"{label}.terminal progress requires completed evaluated history", label)
+    result = progress.get("last_condition_result")
+    exhausted = progress.get("exhausted", False)
+    if result is True:
+        if exhausted:
+            raise _progress(f"{label}.condition result conflicts with evaluation state", label)
+        return
+    if result is not False:
+        raise _progress(f"{label}.condition result conflicts with evaluation state", label)
+    if maximum is not None and sorted(completed) != list(range(maximum)):
+        raise _progress(f"{label}.terminal progress requires completed evaluated history", label)
+    if frame is None:
+        # A missing loop-frame row is a supported crash/restore shape: the planner re-enters
+        # the loop. Only a present row that contradicts the terminal form is invalid.
+        return
+    status = frame.get("status") if isinstance(frame, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _progress(f"{label}.successful exhaustion requires a completed frame", label)
+        return
+    error = frame.get("error") if isinstance(frame, Mapping) else None
+    error_type = error.get("type") if isinstance(error, Mapping) else None
+    if status != "failed" or error_type != "repeat_until_iterations_exhausted":
+        raise _progress(f"{label}.failed exhaustion requires the terminal exhaustion error", label)
+
+
+def validate_repeat_until_progress(
+    name: str,
+    progress: Any,
+    *,
+    maximum: Optional[int],
+    frame: Any,
+) -> list[int]:
+    """Validate one ``repeat_until`` entry; return the indices it may occupy."""
+    label = f"repeat_until.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(f"{label} must be a mapping")
+    current = _optional_index(progress, "current_iteration", label)
+    if current is not None and current < 0:
+        raise _progress(f"{label}.current_iteration is out of range")
+    if "exhausted" in progress and not isinstance(progress["exhausted"], bool):
+        raise _shape(f"{label}.exhausted must be boolean when present")
+    completed = _int_list(progress.get("completed_iterations", []), f"{label}.completed_iterations")
+    if len(set(completed)) != len(completed):
+        raise _progress(f"{label}.completed_iterations must not contain duplicate indices")
+    if current is not None:
+        _validate_active(label, progress, current, completed, maximum)
+    elif progress:
+        _validate_terminal(label, progress, completed, maximum, frame)
+    if maximum is not None:
+        return list(range(maximum))
+    return sorted(set(completed) | ({current} if current is not None else set()))

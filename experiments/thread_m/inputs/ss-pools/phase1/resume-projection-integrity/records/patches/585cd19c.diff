+"""Reached-call revalidation for resumed call steps.
+
+When a resumed run reaches a call step, the persisted caller identity is resolved
+against the *current* parent projection (exactly one call boundary must own it),
+that boundary's current import alias selects the callee bundle, and the frames the
+boundary owns are indexed into one retry lineage. Reads only its arguments; never
+mutates ``state``; raises ``ResumeProjectionIntegrityError``.
+
+Dependencies: the parent bundle/projection, the parent scope state, and the
+caller-supplied Workflow Lisp predicate (typed ``provenance.frontend_kind``).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping
+
+from .call_frame_retry_lineage import (
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+)
+from .loaded_bundle import workflow_import_bundle
+from .resume_projection_integrity import (
+    ResumeScopePath,
+    integrity_error,
+    lineage_integrity_error,
+)
+from .resume_slots import ResumeProjectionValidationError
+
+
+@dataclass(frozen=True)
+class ReachedCallPlan:
+    boundary: Any
+    imported_bundle: Any
+    lineage: CallFrameRetryLineage
+
+
+def _boundary_for(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath, step_id: str) -> Any:
+    projection = bundle.projection
+    try:
+        slot_index = projection.enumerate_resume_slots(state)
+    except ResumeProjectionValidationError as exc:
+        raise integrity_error(exc.reason, bundle, state, scope_path, field=exc.field) from exc
+    resolution = projection.resolve_call_boundary(slot_index, step_id)
+    if resolution.candidate_count > 1:
+        raise integrity_error(
+            "ambiguous_call_boundary", bundle, state, scope_path, field="call_step_id",
+            offending_value=step_id, candidate_count=resolution.candidate_count,
+            call_boundary_step_id=step_id,
+        )
+    if resolution.boundary is None:
+        reason = "missing_call_boundary" if step_id in slot_index.candidates_by_step_id else "out_of_scope_step_id"
+        raise integrity_error(
+            reason, bundle, state, scope_path, field="call_step_id", offending_value=step_id,
+            candidate_count=0, call_boundary_step_id=step_id,
+        )
+    return resolution.boundary
+
+
+def plan_reached_call(
+    *,
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    step_id: str,
+    is_workflow_lisp: Callable[[Any], bool],
+) -> ReachedCallPlan:
+    """Revalidate frame shape, caller boundary, import alias and lineage for one reached call."""
+    frames = state.get("call_frames")
+    frames = {} if frames is None else frames
+    if not isinstance(frames, Mapping):
+        raise integrity_error("unsupported_shape", bundle, state, scope_path, field="call_frames")
+    boundary = _boundary_for(bundle, state, scope_path, step_id)
+    alias = boundary.import_alias
+    imported = workflow_import_bundle(bundle, alias) if isinstance(alias, str) else None
+    if imported is None:
+        raise integrity_error(
+            "missing_imported_bundle", bundle, state, scope_path, field=f"imports.{alias}",
+            offending_value=alias, candidate_count=1, call_boundary_step_id=step_id,
+        )
+    owned = [
+        (frame_id, frame)
+        for frame_id, frame in frames.items()
+        if isinstance(frame, Mapping) and frame.get("call_step_id") == step_id
+    ]
+    for frame_id, frame in owned:
+        persisted = frame.get("import_alias")
+        if persisted != alias:
+            raise integrity_error(
+                "persisted_import_alias_mismatch" if "import_alias" in frame else "missing_required_identity",
+                bundle, state, scope_path, field=f"call_frames.{frame_id}.import_alias",
+                offending_value=persisted, candidate_count=1 if "import_alias" in frame else None,
+                call_boundary_step_id=step_id,
+            )
+    try:
+        lineage = index_retry_lineage(
+            step_id,
+            owned,
+            frontend_kind="workflow_lisp" if is_workflow_lisp(imported) else None,
+        )
+    except CallFrameRetryLineageError as exc:
+        raise lineage_integrity_error(exc, bundle, state, scope_path, step_id) from exc
+    return ReachedCallPlan(boundary=boundary, imported_bundle=imported, lineage=lineage)

diff --git a/orchestrator/workflow/call_frame_retry_lineage.py b/orchestrator/workflow/call_frame_retry_lineage.py
new file mode 100644
index 0000000..9d05d2f
--- /dev/null
+++ b/orchestrator/workflow/call_frame_retry_lineage.py
@@ -0,0 +1,202 @@
+"""Call-frame retry lineage for checksum-compatible resume.
+
+Pure indexing of the frames one call boundary owns. A Workflow Lisp boundary
+(typed ``provenance.frontend_kind == "workflow_lisp"``, passed in by the caller)
+groups its non-completed frames into one retry lineage: base frame ``B``
+(ordinal 0) and retries ``B::retry::<n>``. Any other boundary has at most one
+non-completed frame. Completed frames are unlimited historical records.
+
+Reads only its arguments; never mutates frames and never selects by mapping
+order: lineage members are ordered by ordinal.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+_CANONICAL_ORDINAL = re.compile(r"[1-9][0-9]*")
+_KNOWN_STATUSES = frozenset({"running", "failed", "completed"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """The frames of one boundary do not form a valid retry lineage."""
+
+    def __init__(self, reason: str, message: str, *, count: Optional[int] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.count = count
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    ordinal: int
+    status: str
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...] = ()
+    failed_predecessors: tuple[RetryFrameMember, ...] = ()
+    running_member: Optional[RetryFrameMember] = None
+    used_retry_ordinals: tuple[int, ...] = ()
+
+    @property
+    def resumable_count(self) -> int:
+        return len(self.failed_predecessors) + (1 if self.running_member is not None else 0)
+
+
+def _frame_field(frame: Any, key: str) -> Any:
+    """Read a frame field from a persisted mapping or an attribute-style record."""
+    if isinstance(frame, Mapping):
+        return frame.get(key)
+    return getattr(frame, key, None)
+
+
+def _split_retry_id(frame_id: Any) -> tuple[str, int]:
+    """Return ``(base, ordinal)``; ordinal 0 for an unmarked id."""
+    if not isinstance(frame_id, str) or not frame_id:
+        raise CallFrameRetryLineageError("unsupported_shape", "call frame id must be a non-empty string")
+    base, marker, suffix = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return frame_id, 0
+    if not base or RETRY_MARKER in suffix or not _CANONICAL_ORDINAL.fullmatch(suffix):
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "call frame id has a malformed retry marker"
+        )
+    return base, int(suffix)
+
+
+def _validate_frames(
+    boundary_step_id: str,
+    frames: list[tuple[Any, Any]],
+) -> None:
+    alias_seen = False
+    alias: Any = None
+    for _frame_id, frame in frames:
+        if not isinstance(frame, Mapping) and not hasattr(frame, "status"):
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame must be a mapping")
+        status = _frame_field(frame, "status")
+        if not isinstance(status, str) or status not in _KNOWN_STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame has an unknown status")
+        if _frame_field(frame, "call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", "call frame is not owned by this call boundary"
+            )
+        frame_alias = _frame_field(frame, "import_alias")
+        if alias_seen and frame_alias != alias:
+            raise CallFrameRetryLineageError(
+                "persisted_import_alias_mismatch", "call frames disagree on the import alias"
+            )
+        alias, alias_seen = frame_alias, True
+
+
+def _index_single_resumable(
+    non_completed: list[tuple[Any, Any]],
+    completed: tuple[CallFrameMember, ...],
+) -> CallFrameRetryLineage:
+    if len(non_completed) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "more than one resumable call frame for one call boundary",
+            count=len(non_completed),
+        )
+    if not non_completed:

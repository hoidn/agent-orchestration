index 0000000..25a815c
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,313 @@
+"""Checksum-compatible resume projection integrity audit.
+
+``audit_scope(bundle, state, scope_path)`` validates every persisted identity of
+one scope (step rows, current step, loop bookkeeping, call frames and their
+retry lineage) against the projection of the bundle that owns that scope, and
+raises ``ResumeProjectionIntegrityError`` carrying one stable diagnostic.
+
+Dependencies: only its arguments. It loads no workflow or bundle, computes no
+checksum, reads no file and never mutates ``state``. Nested scopes are audited
+by the caller (call executor) with the callee bundle and the frame's state.
+
+Diagnostic contract: ``specs/state.md`` (checksum-compatible resume projection
+integrity).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+from .call_frame_retry_lineage import (
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_slots import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    resolve_call_boundary,
+    resolve_resume_step_id,
+)
+
+__all__ = [
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RetryFrameMember",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "audit_scope",
+    "index_retry_lineage",
+    "integrity_error",
+    "lineage_integrity_error",
+    "is_sticky_projection_error",
+    "next_unused_retry_frame_id",
+]
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+
+
+def is_sticky_projection_error(error: Any) -> bool:
+    """True for the non-routable terminal projection diagnostic (never wrapped or downgraded)."""
+    return isinstance(error, Mapping) and error.get("type") == ERROR_TYPE
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root scope to the audited scope."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(root_workflow_file=workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        path = [{"kind": "root", "workflow_file": self.root_workflow_file}]
+        path.extend({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids)
+        return path
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """A checksum-compatible resume found a persisted identity the program no longer owns."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    """Return ``value`` when it is a plain scalar; containers and objects are never exposed."""
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def integrity_error(
+    reason: str,
+    bundle: Any,
+    state: Any,
+    scope_path: ResumeScopePath,
+    *,
+    field: Optional[str] = None,
+    offending_value: Any = None,
+    candidate_count: Optional[int] = None,
+    call_boundary_step_id: Optional[str] = None,
+) -> ResumeProjectionIntegrityError:
+    """Build the stable diagnostic for one failed audit."""
+    provenance = workflow_provenance(bundle)
+    workflow_path = getattr(provenance, "workflow_path", None)
+    checksum = state.get("workflow_checksum") if isinstance(state, Mapping) else None
+    return ResumeProjectionIntegrityError(
+        {
+            "type": ERROR_TYPE,
+            "message": f"Resume projection integrity audit failed: {reason}",
+            "context": {
+                "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                "reason": reason,
+                "scope_path": scope_path.as_context(),
+                "field": field,
+                "offending_value": _scalar(offending_value),
+                "expected_owner": {
+                    "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                    "workflow_checksum": checksum if isinstance(checksum, str) else None,
+                    "projection_scope": scope_path.projection_scope,
+                },
+                "candidate_count": candidate_count,
+                "call_boundary_step_id": call_boundary_step_id if isinstance(call_boundary_step_id, str) else None,
+            },
+        }
+    )
+
+
+def lineage_integrity_error(
+    exc: CallFrameRetryLineageError,
+    bundle: Any,
+    state: Any,
+    scope_path: ResumeScopePath,
+    call_step_id: str,
+) -> ResumeProjectionIntegrityError:
+    """Map a retry-lineage failure to the stable diagnostic."""
+    if exc.reason == "ambiguous_resumable_call_frame":
+        count = exc.count
+        return integrity_error(
+            exc.reason, bundle, state, scope_path, field="call_frames",
+            offending_value=count, candidate_count=count, call_boundary_step_id=call_step_id,
+        )
+    return integrity_error(
+        exc.reason, bundle, state, scope_path, field="call_frames",
+        call_boundary_step_id=call_step_id,
+    )
+
+
+class _Audit:
+    """One scope audit: shared context for the per-surface checks."""
+
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.index: ResumeProjectionSlotIndex
+
+    def fail(self, reason: str, field: Optional[str] = None, offending_value: Any = None,
+             candidate_count: Optional[int] = None, call_boundary_step_id: Optional[str] = None):
+        return integrity_error(
+            reason, self.bundle, self.state, self.scope_path, field=field,
+            offending_value=offending_value, candidate_count=candidate_count,
+            call_boundary_step_id=call_boundary_step_id,
+        )
+
+    def mapping_section(self, key: str) -> Mapping[str, Any]:
+        section = self.state.get(key)
+        if section is None:
+            return {}
+        if not isinstance(section, Mapping):
+            raise self.fail("unsupported_shape", key)
+        return section
+
+    # -- steps -------------------------------------------------------------------------------
+
+    def iter_rows(self, steps: Mapping[str, Any]) -> Iterable[tuple[str, Mapping[str, Any]]]:
+        for name, row in steps.items():
+            if isinstance(row, Mapping):
+                yield name, row
+            elif isinstance(row, list):
+                for position, iteration in enumerate(row):
+                    if not isinstance(iteration, Mapping):
+                        continue
+                    for nested_name, result in iteration.items():
+                        if isinstance(result, Mapping):
+                            yield f"{name}[{position}].{nested_name}", result
+            else:
+                raise self.fail("unsupported_shape", f"steps.{name}")
+
+    def audit_steps(self) -> None:
+        steps = self.mapping_section("steps")
+        unclaimed = {name for name, _ in self.index.unclaimed_explicit_rows}
+        for name, row in self.iter_rows(steps):
+            if "step_id" not in row:
+                continue
+            field = f"steps.{name}.step_id"
+            step_id = row["step_id"]
+            if not isinstance(step_id, str) or not step_id:
+                raise self.fail("unsupported_shape", field, step_id)
+            if name in unclaimed:
+                raise self.fail("unclaimed_explicit_step_row", field, step_id, 0)
+            resolution = resolve_resume_step_id(self.index, step_id, name)
+            if resolution.slot is not None:
+                continue
+            reason = "unknown_explicit_step_id" if resolution.candidate_count == 0 else "presentation_slot_mismatch"
+            raise self.fail(reason, field, step_id, resolution.candidate_count)
+
+    # -- current step ------------------------------------------------------------------------
+
+    def audit_current_step(self, current: Any, prefix: str = "current_step") -> None:
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            raise self.fail("unsupported_shape", prefix)
+        field = f"{prefix}.step_id"
+        if "step_id" not in current:
+            raise self.fail("missing_required_identity", field)
+        step_id = current["step_id"]
+        if not isinstance(step_id, str) or not step_id:
+            raise self.fail("unsupported_shape", field, step_id)
+        name = current.get("name")
+        resolution = resolve_resume_step_id(self.index, step_id, name if isinstance(name, str) else None)
+        if resolution.slot is not None:
+            return
+        reason = "out_of_scope_step_id" if resolution.candidate_count == 0 else "presentation_slot_mismatch"
+        raise self.fail(reason, field, step_id, resolution.candidate_count)
+
+    # -- call frames -------------------------------------------------------------------------
+
+    def audit_frame(self, frame_id: str, frame: Any) -> tuple[str, Any]:
+        """Validate one frame's own identities; return ``(call_step_id, boundary)``."""
+        prefix = f"call_frames.{frame_id}"
+        if not isinstance(frame, Mapping):
+            raise self.fail("unsupported_shape", prefix)
+        status = frame.get("status")
+        if status not in ("running", "failed", "completed"):
+            raise self.fail("unsupported_shape", f"{prefix}.status", status)
+        field = f"{prefix}.call_step_id"
+        if "call_step_id" not in frame:
+            raise self.fail("missing_required_identity", field)
+        call_step_id = frame["call_step_id"]
+        if not isinstance(call_step_id, str) or not call_step_id:
+            raise self.fail("unsupported_shape", field, call_step_id)
+        resolution = resolve_call_boundary(self.index, call_step_id)
+        if resolution.candidate_count > 1:
+            raise self.fail("ambiguous_call_boundary", field, call_step_id, resolution.candidate_count, call_step_id)
+        boundary = resolution.boundary
+        if boundary is None:
+            reason = "missing_call_boundary" if call_step_id in self.index.candidates_by_step_id else "out_of_scope_step_id"
+            raise self.fail(reason, field, call_step_id, 0, call_step_id)
+        self.audit_frame_alias(prefix, frame, boundary, call_step_id)
+        return call_step_id, boundary
+
+    def audit_frame_alias(self, prefix: str, frame: Mapping[str, Any], boundary: Any, call_step_id: str) -> None:
+        alias_field = f"{prefix}.import_alias"
+        persisted = frame.get("import_alias")
+        if "import_alias" not in frame:
+            raise self.fail("missing_required_identity", alias_field, None, None, call_step_id)
+        if not isinstance(persisted, str) or not persisted:
+            raise self.fail("unsupported_shape", alias_field, persisted, None, call_step_id)
+        current_alias = boundary.import_alias
+        if persisted != current_alias:
+            raise self.fail("persisted_import_alias_mismatch", alias_field, persisted, 1, call_step_id)
+        if workflow_import_bundle(self.bundle, current_alias) is None:
+            raise self.fail("missing_imported_bundle", f"imports.{current_alias}", current_alias, 1, call_step_id)
+
+    def audit_call_frames(self) -> None:
+        frames = self.mapping_section("call_frames")
+        by_boundary: dict[str, tuple[Any, list[tuple[str, Any]]]] = {}
+        for frame_id, frame in frames.items():
+            call_step_id, boundary = self.audit_frame(frame_id, frame)
+            by_boundary.setdefault(call_step_id, (boundary, []))[1].append((frame_id, frame))
+        for call_step_id, (boundary, items) in by_boundary.items():
+            self.audit_lineage(call_step_id, boundary, items)
+
+    def audit_lineage(self, call_step_id: str, boundary: Any, items: list[tuple[str, Any]]) -> None:
+        imported = workflow_import_bundle(self.bundle, boundary.import_alias)
+        provenance = workflow_provenance(imported)
+        try:
+            index_retry_lineage(
+                call_step_id,
+                items,
+                frontend_kind=getattr(provenance, "frontend_kind", None),
+            )
+        except CallFrameRetryLineageError as exc:
+            raise lineage_integrity_error(
+                exc, self.bundle, self.state, self.scope_path, call_step_id
+            ) from exc
+
+
+def audit_scope(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against ``bundle``'s projection."""
+    if getattr(bundle, "projection", None) is None:
+        return  # not a loaded workflow bundle (test doubles); production bundles always have one
+    if not isinstance(state, Mapping):
+        raise integrity_error("unsupported_shape", bundle, state, scope_path, field="state")
+    audit = _Audit(bundle, state, scope_path)
+    audit.mapping_section("steps")
+    audit.mapping_section("call_frames")
+    try:
+        audit.index = bundle.projection.enumerate_resume_slots(state)
+    except ResumeProjectionValidationError as exc:
+        raise audit.fail(exc.reason, exc.field) from exc
+    audit.audit_steps()
+    audit.audit_current_step(state.get("current_step"))
+    audit.audit_call_frames()

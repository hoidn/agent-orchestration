+def test_reached_callee_failure_is_unwrapped_through_ancestor_frames(tmp_path):
+    bundle, manager = _completed_call_run(tmp_path, "unwrapped")
+    persisted = manager.load()
+    root_frame_id, root_frame = next(iter(persisted.call_frames.items()))
+    nested_frame_id, nested_frame = next(iter(root_frame["state"]["call_frames"].items()))
+    nested_frame["status"] = "running"
+    nested_frame["state"]["current_step"] = {"name": "Gone", "step_id": "root.gone", "status": "running"}
+    nested_frame["state"]["status"] = "failed"

+    assert state == before
+    qualified = projection.for_each_runtime_step_id(
+        "root.process_items", 2, next(iter(projection.for_each_nodes["root.process_items"].nested_presentation_keys))
+    )
+    resolution = projection.resolve_resume_step_id(index, qualified, "ProcessItems[2].Inner")
+    assert resolution.slot is not None
+    assert resolution.slot.iteration_index == 2
+    assert resolution.candidate_count == resolution.exact_identity_candidate_count == 1
+    out_of_range = projection.for_each_runtime_step_id("root.process_items", 3, "root.process_items.inner")
+    assert projection.resolve_resume_step_id(index, out_of_range).slot is None
+    unhashable = projection.resolve_resume_step_id(index, ["root.first"])
+    assert (unhashable.slot, unhashable.candidate_count) == (None, 0)

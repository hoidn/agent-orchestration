+def test_audit_reasons_carry_field_offending_value_and_candidate_count(linear_bundle, state, expected):
+    error = _audit_failure(linear_bundle, state)
+
+    assert _reason(error) == expected
+    context = error.error["context"]
+    assert error.error["type"] == "resume_projection_integrity_error"
+    assert error.error["message"] == f"Resume projection integrity audit failed: {expected[0]}"
+    assert context["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    assert context["scope_path"] == [{"kind": "root", "workflow_file": "workflow.yaml"}]
+    assert set(context["expected_owner"]) == {"workflow_file", "workflow_checksum", "projection_scope"}
+    assert context["expected_owner"]["projection_scope"] == "root"
+    assert "call_boundary_step_id" in context

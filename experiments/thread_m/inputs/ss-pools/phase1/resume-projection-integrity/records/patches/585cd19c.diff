index 0000000..a01d0e4
--- /dev/null
+++ b/orchestrator/yaml_import_aliases.py
@@ -0,0 +1,67 @@
+"""Position-aware duplicate detection for classic-YAML `imports` aliases.
+
+`yaml.load` silently keeps the last of repeated mapping keys and flattens `<<`
+merges, so duplicate import aliases and repeated top-level `imports` sections
+are invisible after construction. This pass walks the composed node graph
+(before construction) and reports them with 1-based `line L, column C` positions.
+"""
+
+from typing import Dict, List, Tuple
+
+import yaml
+
+MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _merge_sources(value: yaml.Node) -> List[yaml.MappingNode]:
+    """Mappings contributed by a `<<` value (single mapping or sequence of mappings)."""
+    if isinstance(value, yaml.MappingNode):
+        return [value]
+    if isinstance(value, yaml.SequenceNode):
+        return [item for item in value.value if isinstance(item, yaml.MappingNode)]
+    return []
+
+
+def _effective_keys(mapping: yaml.MappingNode) -> List[Tuple[yaml.Node, yaml.Node]]:
+    """All (key, value) pairs of a mapping, with `<<` merge sources expanded in place."""
+    pairs: List[Tuple[yaml.Node, yaml.Node]] = []
+    for key, value in mapping.value:
+        if key.tag == MERGE_TAG:
+            for source in _merge_sources(value):
+                pairs.extend(_effective_keys(source))
+        else:
+            pairs.append((key, value))
+    return pairs
+
+
+def find_import_alias_errors(root: yaml.Node) -> List[str]:
+    """Return duplicate-alias / duplicate-section messages for a composed workflow document."""
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [
+        (key, value)
+        for key, value in _effective_keys(root)
+        if isinstance(key, yaml.ScalarNode) and key.value == "imports"
+    ]
+    occurrences: Dict[str, List[yaml.Node]] = {}
+    for _, value in sections:
+        if isinstance(value, yaml.MappingNode):
+            for alias_key, _ in _effective_keys(value):
+                if isinstance(alias_key, yaml.ScalarNode):
+                    occurrences.setdefault(alias_key.value, []).append(alias_key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias ({'; '.join(_position(n) for n in nodes)})"
+        for alias, nodes in occurrences.items()
+        if len(nodes) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping "
+            f"({'; '.join(_position(key) for key, _ in sections)})"
+        )
+    return errors

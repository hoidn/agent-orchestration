+def _delta(before: dict, after: dict) -> set:
+    return {key for key in set(before) | set(after) if before.get(key) != after.get(key)}
+
+
+@pytest.mark.parametrize("reason", ["workflow_modified", "missing_recorded_checksum", "workflow_unavailable", "missing_workflow_path"])
+def test_structural_root_executor_rechecks_checksum_before_audit_and_prologue(simple_run, tmp_path, reason):
+    workflow, bundle, manager = simple_run
+    persisted_checksum = manager.load().workflow_checksum
+    if reason == "workflow_modified":
+        workflow.write_text(workflow.read_text() + "\n# changed\n", encoding="utf-8")
+    elif reason == "missing_recorded_checksum":
+        persisted = manager.load()
+        persisted.workflow_checksum = ""
+        manager._write_state()
+        persisted_checksum = ""
+    elif reason == "workflow_unavailable":
+        workflow.unlink()
+    else:
+        bundle = replace(bundle, provenance=replace(bundle.provenance, workflow_path=None))
+    before = json.loads(manager.state_file.read_text())
+
+    with patch("orchestrator.workflow.executor.audit_scope") as audit, patch.object(
+        WorkflowExecutor, "_execute_prologue", side_effect=AssertionError("prologue ran")
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = json.loads(manager.state_file.read_text())
+    error = after["error"]
+    assert result["status"] == "failed"
+    audit.assert_not_called()
+    assert error["type"] == "workflow_checksum_mismatch"
+    assert error["message"] == "Workflow has been modified since the run started"
+    assert set(error["context"]) == {"workflow_file", "persisted_checksum", "current_checksum", "reason"}
+    assert error["context"]["reason"] == reason
+    assert error["context"]["persisted_checksum"] == (persisted_checksum or None) or persisted_checksum == ""
+    assert _delta(before, after) <= {"status", "error", "updated_at"}
+

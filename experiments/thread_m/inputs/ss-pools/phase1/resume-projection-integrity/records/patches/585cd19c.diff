@@ -0,0 +1,220 @@
+"""Projection-owned resume slot enumeration and identity resolution.
+
+Behaviour of ``WorkflowStateProjection.enumerate_resume_slots`` and the two
+``resolve_*`` methods. The functions read a projection and a persisted state
+mapping, never mutate either, and never parse, split or reconstruct ids: every
+candidate id comes from a projection API.
+
+Dependencies: the projection (duck-typed to avoid an import cycle), persisted
+``for_each`` / ``repeat_until`` bookkeeping and loop-frame rows in ``state``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from .executable_ir import WorkflowRegion
+from .resume_loop_progress import (
+    ResumeProjectionValidationError,
+    snapshot,
+    validate_for_each_progress,
+    validate_repeat_until_progress,
+)
+
+__all__ = [
+    "ResumeCallBoundaryResolution",
+    "ResumeIdentityResolution",
+    "ResumeProjectionSlotIndex",
+    "ResumeProjectionValidationError",
+    "ResumeStepSlot",
+    "enumerate_resume_slots",
+    "resolve_call_boundary",
+    "resolve_resume_step_id",
+]
+
+
+@dataclass(frozen=True)
+class ResumeStepSlot:
+    """One persisted-identity slot the current projection owns."""
+
+    step_id: str
+    node_id: str
+    presentation_key: str
+    region: WorkflowRegion
+    iteration_index: Optional[int] = None
+    loop_node_id: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class ResumeProjectionSlotIndex:
+    """Candidate identities for one scope, derived from projection plus loop bookkeeping."""
+
+    candidates_by_step_id: Mapping[str, tuple[ResumeStepSlot, ...]]
+    call_boundaries_by_step_id: Mapping[str, tuple[Any, ...]]
+    unclaimed_explicit_rows: tuple[tuple[str, Any], ...] = ()
+
+
+@dataclass(frozen=True)
+class ResumeIdentityResolution:
+    slot: Optional[ResumeStepSlot]
+    candidate_count: int
+    exact_identity_candidate_count: int
+
+
+@dataclass(frozen=True)
+class ResumeCallBoundaryResolution:
+    boundary: Optional[Any]
+    candidate_count: int
+
+
+def _mapping_section(state: Mapping[str, Any], key: str) -> Mapping[str, Any]:
+    section = state.get(key)
+    if section is None:
+        return {}
+    if not isinstance(section, Mapping):
+        raise ResumeProjectionValidationError("unsupported_shape", f"{key} must be a mapping")
+    return section
+
+
+def _loop_iterations(projection: Any, state: Mapping[str, Any]) -> dict[str, list[int]]:
+    """Validate loop bookkeeping and return the iteration indices each loop node may occupy."""
+    iterations: dict[str, list[int]] = {}
+    for_each_state = _mapping_section(state, "for_each")
+    repeat_state = _mapping_section(state, "repeat_until")
+    steps = state.get("steps")
+    steps = steps if isinstance(steps, Mapping) else {}
+    for node_id, loop in projection.for_each_nodes.items():
+        if loop.frame_key in for_each_state:
+            items = validate_for_each_progress(loop.frame_key, for_each_state[loop.frame_key])
+            iterations[node_id] = list(range(len(items or [])))
+    for node_id, loop in projection.repeat_until_nodes.items():
+        maximum = getattr(loop, "declared_max_iterations", None)
+        maximum = maximum if isinstance(maximum, int) and not isinstance(maximum, bool) else None
+        if loop.frame_key in repeat_state:
+            iterations[node_id] = validate_repeat_until_progress(
+                loop.frame_key,
+                repeat_state[loop.frame_key],
+                maximum=maximum,
+                frame=steps.get(loop.frame_key),
+            )
+        elif maximum is not None:
+            iterations[node_id] = list(range(maximum))
+    return iterations
+
+
+def _top_level_slots(projection: Any, loop_body_nodes: set[str]) -> list[ResumeStepSlot]:
+    return [
+        ResumeStepSlot(
+            step_id=entry.step_id,
+            node_id=node_id,
+            presentation_key=entry.presentation_key,
+            region=entry.region,
+        )
+        for node_id, entry in projection.entries_by_node_id.items()
+        if node_id not in loop_body_nodes
+    ]
+
+
+def _iteration_slots(projection: Any, iterations: Mapping[str, list[int]]) -> list[ResumeStepSlot]:
+    slots: list[ResumeStepSlot] = []
+    for nodes in (projection.for_each_nodes, projection.repeat_until_nodes):
+        for loop_node_id, loop in nodes.items():
+            for index in iterations.get(loop_node_id, ()):
+                for nested_node_id in loop.nested_presentation_keys:
+                    entry = projection.entries_by_node_id.get(nested_node_id)
+                    slots.append(
+                        ResumeStepSlot(
+                            step_id=loop.runtime_step_id(index, nested_node_id),
+                            node_id=nested_node_id,
+                            presentation_key=loop.step_key(index, nested_node_id),
+                            region=entry.region if entry is not None else WorkflowRegion.BODY,
+                            iteration_index=index,
+                            loop_node_id=loop_node_id,
+                        )
+                    )
+    return slots
+
+
+def _call_boundaries(projection: Any, iterations: Mapping[str, list[int]]) -> dict[str, list[Any]]:
+    boundaries: dict[str, list[Any]] = {}
+    for node_id, boundary in projection.call_boundaries.items():
+        owner = boundary.iteration_owner_node_id
+        indices: list[Optional[int]] = [None] if owner is None else list(iterations.get(owner, ()))
+        for index in indices:
+            runtime_id = projection.call_boundary_runtime_step_id(node_id, iteration_index=index)
+            boundaries.setdefault(runtime_id, []).append(boundary)
+    return boundaries
+
+
+def _unclaimed_rows(state: Mapping[str, Any], owned_names: set[str]) -> tuple[tuple[str, Any], ...]:
+    steps = state.get("steps")
+    if not isinstance(steps, Mapping):
+        return ()
+    return tuple(
+        (name, snapshot(row["step_id"]))
+        for name, row in steps.items()
+        if isinstance(row, Mapping)
+        and "step_id" in row
+        and not (isinstance(name, str) and name in owned_names)
+    )
+
+
+def enumerate_resume_slots(projection: Any, state: Mapping[str, Any]) -> ResumeProjectionSlotIndex:
+    """Enumerate every identity the projection owns for ``state``'s loop bookkeeping."""
+    iterations = _loop_iterations(projection, state)
+    loop_body_nodes = {
+        node_id
+        for nodes in (projection.for_each_nodes, projection.repeat_until_nodes)
+        for loop in nodes.values()
+        for node_id in loop.nested_presentation_keys
+    }
+    slots = _top_level_slots(projection, loop_body_nodes) + _iteration_slots(projection, iterations)
+    candidates: dict[str, list[ResumeStepSlot]] = {}
+    for slot in slots:
+        candidates.setdefault(slot.step_id, []).append(slot)
+    owned_names = {slot.presentation_key for slot in slots}
+    owned_names.update(loop.frame_key for loop in projection.for_each_nodes.values())
+    owned_names.update(loop.frame_key for loop in projection.repeat_until_nodes.values())
+    return ResumeProjectionSlotIndex(
+        candidates_by_step_id={key: tuple(value) for key, value in candidates.items()},
+        call_boundaries_by_step_id={
+            key: tuple(value) for key, value in _call_boundaries(projection, iterations).items()
+        },
+        unclaimed_explicit_rows=_unclaimed_rows(state, owned_names),
+    )
+
+
+def resolve_resume_step_id(
+    slot_index: ResumeProjectionSlotIndex,
+    step_id: Any,
+    presentation_key: Optional[str] = None,
+) -> ResumeIdentityResolution:
+    """Resolve one persisted id to its unique candidate; malformed ids resolve to nothing."""
+    if not isinstance(step_id, str):
+        return ResumeIdentityResolution(None, 0, 0)
+    candidates = slot_index.candidates_by_step_id.get(step_id, ())
+    exact = [
+        slot
+        for slot in candidates
+        if presentation_key is None or slot.presentation_key == presentation_key
+    ]
+    return ResumeIdentityResolution(
+        slot=exact[0] if len(exact) == 1 else None,
+        candidate_count=len(candidates),
+        exact_identity_candidate_count=len(exact),
+    )
+
+
+def resolve_call_boundary(
+    slot_index: ResumeProjectionSlotIndex,
+    call_step_id: Any,
+) -> ResumeCallBoundaryResolution:
+    """Resolve one persisted caller id to the unique current call boundary."""
+    if not isinstance(call_step_id, str):
+        return ResumeCallBoundaryResolution(None, 0)
+    boundaries = slot_index.call_boundaries_by_step_id.get(call_step_id, ())
+    return ResumeCallBoundaryResolution(
+        boundary=boundaries[0] if len(boundaries) == 1 else None,
+        candidate_count=len(boundaries),
+    )

+def _workflow_lisp_retry_state(bundle, manager, *, predecessor_mutation=None):
+    """Failed predecessor frame (from a real run) so a Workflow Lisp resume must retry."""
+    frame_id = _reopen_call_frame(manager, frame_status="failed", mutate=predecessor_mutation)
+    return frame_id
+

+def test_running_member_checksum_failure_wins_over_failed_predecessors(tmp_path):
+    bundle, manager = _completed_call_run(tmp_path, "lineage-running")
+    frame_id = _reopen_call_frame(manager, frame_status="failed")
+    persisted = manager.load()

+"""Classic-YAML import aliases are validated, with source positions, before bundle construction."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Echo
+    command: ["true"]
+"""
+
+STEPS = """\
+steps:
+  - name: Root
+    command: ["true"]
+"""
+
+
+@pytest.fixture
+def workspace(tmp_path: Path) -> Path:
+    (tmp_path / "lib").mkdir()
+    for name in ("a", "b", "c"):
+        (tmp_path / "lib" / f"{name}.yaml").write_text(LIBRARY)
+    return tmp_path
+
+
+@pytest.fixture
+def bundle_calls(monkeypatch) -> list:
+    calls: list = []
+    real = loader_module.build_loaded_workflow_bundle
+
+    def spy(*args, **kwargs):
+        calls.append(args)
+        return real(*args, **kwargs)
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", spy)
+    return calls
+
+
+def _load_errors(workspace: Path, body: str) -> list[str]:
+    path = workspace / "workflow.yaml"
+    path.write_text(body + STEPS)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(workspace).load(path)
+    return [error.message for error in excinfo.value.errors]
+
+
+def test_duplicate_keys_in_one_imports_mapping(workspace, bundle_calls):
+    errors = _load_errors(workspace, """\
+version: "2.5"
+name: root
+imports:
+  a: lib/a.yaml
+  a: lib/b.yaml
+""")
+    assert errors == [
+        "imports.a: duplicate import alias (line 4, column 3; line 5, column 3)"
+    ]
+    assert bundle_calls == []
+
+
+def test_merge_inside_imports_repeats_alias(workspace, bundle_calls):
+    errors = _load_errors(workspace, """\
+version: "2.5"
+name: root
+x-base: &base
+  a: lib/a.yaml
+imports:
+  <<: *base
+  a: lib/b.yaml
+""")
+    assert errors == [
+        "imports.a: duplicate import alias (line 4, column 3; line 7, column 3)"
+    ]
+    assert bundle_calls == []
+
+
+def test_repeated_top_level_sections_repeat_alias(workspace, bundle_calls):
+    errors = _load_errors(workspace, """\
+version: "2.5"
+name: root
+imports:
+  a: lib/a.yaml
+imports:
+  a: lib/b.yaml
+""")
+    assert errors == [
+        "imports.a: duplicate import alias (line 4, column 3; line 6, column 3)"
+    ]
+    assert bundle_calls == []
+
+
+def test_top_level_merge_sources_each_carrying_imports(workspace, bundle_calls):
+    errors = _load_errors(workspace, """\
+x-one: &one
+  imports:
+    a: lib/a.yaml
+x-two: &two
+  imports:
+    a: lib/b.yaml
+<<: [*one, *two]
+version: "2.5"
+name: root
+""")
+    assert errors == [
+        "imports.a: duplicate import alias (line 3, column 5; line 6, column 5)"
+    ]
+    assert bundle_calls == []
+
+
+def test_repeated_sections_with_distinct_aliases(workspace, bundle_calls):
+    errors = _load_errors(workspace, """\
+version: "2.5"
+name: root
+imports:
+  a: lib/a.yaml
+imports:
+  b: lib/b.yaml
+""")
+    assert errors == [
+        "imports: duplicate top-level mapping (line 3, column 1; line 5, column 1)"
+    ]
+    assert bundle_calls == []
+
+
+def test_merged_and_explicit_sections_with_distinct_aliases(workspace, bundle_calls):
+    errors = _load_errors(workspace, """\
+x-base: &base
+  imports:
+    a: lib/a.yaml
+<<: *base
+version: "2.5"
+name: root
+imports:
+  b: lib/b.yaml
+""")
+    assert errors == [
+        "imports: duplicate top-level mapping (line 2, column 3; line 7, column 1)"
+    ]
+    assert bundle_calls == []
+
+
+def test_single_merged_imports_section_loads(workspace, bundle_calls):
+    path = workspace / "workflow.yaml"
+    path.write_text("""\
+<<: &base
+  imports:
+    a: lib/a.yaml
+    b: lib/b.yaml
+version: "2.5"
+name: root
+""" + STEPS)
+    WorkflowLoader(workspace).load(path)
+    assert bundle_calls

+
+def _reason(error: ResumeProjectionIntegrityError) -> tuple:
+    context = error.error["context"]
+    return (
+        context["reason"],
+        context["field"],
+        context["offending_value"],
+        context["candidate_count"],
+    )
+
+
+def _audit_failure(bundle, state, scope=ROOT) -> ResumeProjectionIntegrityError:
+    with pytest.raises(ResumeProjectionIntegrityError) as caught:
+        audit_scope(bundle, state, scope)
+    return caught.value
+
+
+def test_scope_path_is_frozen_snapshot_with_identity_only_context():
+    frames = ["frame-a"]
+    path = ResumeScopePath("w.yaml", frames)
+    frames.append("mutated")
+    child = path.child("frame-b")
+
+    assert path.call_frame_ids == ("frame-a",)
+    assert path.projection_scope == "call_frame"
+    assert ResumeScopePath.root("w.yaml").projection_scope == "root"
+    assert child.as_context() == [
+        {"kind": "root", "workflow_file": "w.yaml"},
+        {"kind": "call_frame", "frame_id": "frame-a"},
+        {"kind": "call_frame", "frame_id": "frame-b"},
+    ]
+    with pytest.raises(Exception):
+        path.root_workflow_file = "other"  # frozen

+def test_enumerate_resume_slots_resolves_loop_local_ids_through_projection(loop_bundle):
+    projection = loop_bundle.projection
+    state = {
+        "for_each": {"ProcessItems": {"items": ["a", "b", "c"], "completed_indices": [0], "current_index": 1}},
+        "repeat_until": {},

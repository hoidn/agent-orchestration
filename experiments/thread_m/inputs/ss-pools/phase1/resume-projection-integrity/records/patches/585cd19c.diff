+) -> CallFrameRetryLineage:
+    """Index the frames of one call boundary into a retry lineage."""
+    frames = list(frame_items)
+    _validate_frames(boundary_step_id, frames)
+    completed = tuple(
+        CallFrameMember(frame_id) for frame_id, frame in frames if _frame_field(frame, "status") == "completed"
+    )
+    non_completed = [(frame_id, frame) for frame_id, frame in frames if _frame_field(frame, "status") != "completed"]

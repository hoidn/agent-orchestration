+def _index_workflow_lisp(
+    non_completed: list[tuple[Any, Any]],
+    completed: tuple[CallFrameMember, ...],
+) -> CallFrameRetryLineage:
+    if not non_completed:
+        return CallFrameRetryLineage(base_frame_id=None, completed_members=completed)
+    members: list[RetryFrameMember] = []
+    bases: set[str] = set()
+    for frame_id, frame in non_completed:
+        base, ordinal = _split_retry_id(frame_id)
+        bases.add(base)

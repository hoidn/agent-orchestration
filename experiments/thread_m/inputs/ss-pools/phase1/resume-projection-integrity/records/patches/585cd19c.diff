+"""Runtime ordering, envelopes and sticky-failure behaviour of resume projection integrity."""
+
+from __future__ import annotations
+
+import copy
+import json
+from dataclasses import replace
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from orchestrator.cli.commands import resume as resume_command
+from orchestrator.cli.commands.resume import resume_workflow
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.state_projection import WorkflowStateProjection
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.workflow_bundle_helpers import bundle_context_dict, materialize_projection_body_steps
+
+
+def _write(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _completed_call_run(tmp_path: Path, run_id: str):
+    """Run root -> middle -> leaf to completion; return (bundle, manager)."""
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    return bundle, manager
+
+
+def _reopen_call_frame(manager: StateManager, *, frame_status: str = "running", mutate=None):
+    """Turn the completed run into a failed root with one resumable middle frame."""
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    frame["status"] = frame_status
+    frame["state"]["status"] = "failed"
+    if mutate is not None:
+        mutate(frame)
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    return frame_id
+
+
+def _as_workflow_lisp(bundle):
+    """Mark every imported callee as a Workflow Lisp bundle through the typed capability."""
+    imports = {
+        alias: replace(
+            imported,
+            provenance=replace(imported.provenance, frontend_kind="workflow_lisp"),
+        )
+        for alias, imported in bundle.imports.items()
+    }
+    return replace(bundle, imports=imports)
+
+
+def _first_step(bundle):
+    return materialize_projection_body_steps(bundle)[0]
+
+
+# ---------------------------------------------------------------------------------------------
+# Reached call ordering
+# ---------------------------------------------------------------------------------------------
+
+
+def test_reached_call_resolves_each_caller_once_and_audits_callee_before_construction(tmp_path):
+    bundle, manager = _completed_call_run(tmp_path, "reached-order")
+    frame_id = _reopen_call_frame(manager)
+    events: list = []
+    original_resolve = WorkflowStateProjection.resolve_call_boundary
+
+    def record_resolve(projection, slot_index, call_step_id):
+        events.append(("resolve", call_step_id))
+        return original_resolve(projection, slot_index, call_step_id)
+
+    def record_audit(audited_bundle, state, scope_path):
+        events.append(("audit", audited_bundle.surface.name, scope_path.as_context()[-1]))
+
+    import orchestrator.workflow.call_frame_state as call_frame_state
+
+    original_manager = call_frame_state._CallFrameStateManager
+
+    def record_construct(*args, **kwargs):
+        events.append(("construct", kwargs["frame_id"]))
+        return original_manager(*args, **kwargs)
+
+    with patch.object(WorkflowStateProjection, "resolve_call_boundary", record_resolve), patch(
+        "orchestrator.workflow.calls.audit_scope", record_audit
+    ), patch.object(call_frame_state, "_CallFrameStateManager", record_construct):
+        resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert resumed["status"] == "completed"
+    assert events[0] == ("resolve", "root.invoke_middle")
+    audit_index = next(i for i, event in enumerate(events) if event[0] == "audit")
+    construct_index = next(i for i, event in enumerate(events) if event[0] == "construct")
+    assert audit_index < construct_index
+    assert events[audit_index] == (
+        "audit",
+        "projection-middle",
+        {"kind": "call_frame", "frame_id": frame_id},
+    )
+    resolved = [event[1] for event in events if event[0] == "resolve"]
+    assert resolved[0] == "root.invoke_middle"
+    assert len(resolved) == len(set(resolved))
+
+
+@pytest.mark.parametrize("persisted_call_step", ["matching", "stale", "missing"])
+def test_completed_frame_on_the_occupied_id_is_rejected_before_any_child(tmp_path, persisted_call_step):
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id="collision")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    executor.resume_mode = True
+    frame = {"status": "completed", "import_alias": "middle"}
+    if persisted_call_step == "matching":
+        frame["call_step_id"] = "root.invoke_middle"
+    elif persisted_call_step == "stale":
+        frame["call_step_id"] = "root.removed"
+    state = {"call_frames": {"root.invoke_middle::visit::1": frame}, "step_visits": {"InvokeMiddle": 1}}
+    before = copy.deepcopy(state)
+
+    with patch(
+        "orchestrator.workflow.call_frame_state._CallFrameStateManager",
+        side_effect=AssertionError("child state manager created"),
+    ), patch(
+        "orchestrator.workflow.executor.WorkflowExecutor",
+        side_effect=AssertionError("child executor created"),
+    ):
+        result = executor.call_executor.execute_call(_first_step(bundle), state)
+
+    assert result["error"]["context"] == {
+        "step": "InvokeMiddle",
+        "call": "middle",
+        "call_frame_id": "root.invoke_middle::visit::1",
+        "reason": "call_resume_state_invalid",
+        "detail": "completed_call_frame_id_collision",
+    }
+    assert state == before
+

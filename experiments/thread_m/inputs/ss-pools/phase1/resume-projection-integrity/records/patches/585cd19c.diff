+ROOT = ResumeScopePath.root("workflow.yaml")
+
+
+def _write(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _command(name: str, step_id: str) -> dict:
+    return {"name": name, "id": step_id, "command": ["true"]}
+
+
+@pytest.fixture
+def linear_bundle(tmp_path: Path):
+    path = _write(
+        tmp_path / "workflow.yaml",
+        {
+            "version": "2.0",
+            "name": "linear",
+            "steps": [_command("First", "first"), _command("Second", "second")],
+        },
+    )
+    return WorkflowLoader(tmp_path).load_bundle(path)
+
+
+@pytest.fixture
+def loop_bundle(tmp_path: Path):
+    path = _write(
+        tmp_path / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "loops",
+            "steps": [
+                {
+                    "name": "ProcessItems",
+                    "id": "process_items",
+                    "for_each": {
+                        "items": ["a", "b", "c"],
+                        "steps": [_command("Inner", "inner")],
+                    },
+                },
+                {
+                    "name": "ReviewLoop",
+                    "id": "review_loop",
+                    "repeat_until": {
+                        "id": "review_body",
+                        "max_iterations": 3,
+                        "outputs": {
+                            "decision": {
+                                "kind": "scalar",
+                                "type": "enum",
+                                "allowed": ["APPROVE", "REVISE"],
+                                "from": {"ref": "self.steps.Decide.artifacts.decision"},
+                            }
+                        },
+                        "condition": {
+                            "compare": {
+                                "left": {"ref": "self.outputs.decision"},
+                                "op": "eq",
+                                "right": "APPROVE",
+                            }
+                        },
+                        "steps": [
+                            {
+                                "name": "Decide",
+                                "id": "decide",
+                                "command": ["true"],
+                                "expected_outputs": [
+                                    {
+                                        "name": "decision",
+                                        "path": "state/decision.txt",
+                                        "type": "enum",
+                                        "allowed": ["APPROVE", "REVISE"],
+                                    }
+                                ],
+                            }
+                        ],
+                    },
+                },
+            ],
+        },
+    )
+    return WorkflowLoader(tmp_path).load_bundle(path)

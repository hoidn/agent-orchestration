+        # ordinary cleanup failure after a projection failure is supplemental
+        ({"type": "boom"}, True, "failed", _DIAGNOSTIC, None),
+        # ordinary cleanup failure after a clean body keeps the existing wrapper
+        ({"type": "boom"}, False, "completed", {"type": "finalization_failed", "step": "Cleanup"}, {"type": "boom"}),
+    ],

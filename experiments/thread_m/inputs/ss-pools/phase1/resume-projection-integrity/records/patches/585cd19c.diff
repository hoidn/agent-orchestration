+def test_projection_diagnostic_stops_run_runs_finalization_and_is_never_replaced(tmp_path):
+    bundle, manager = _completed_call_run(tmp_path, "sticky-e2e")
+    # Rebuild a caller with routes and finalization around the same stale-callee scenario.
+    caller = _write(
+        tmp_path / "caller.yaml",
+        {
+            "version": "2.5",
+            "name": "sticky-caller",
+            "imports": {"middle": "imports/middle.yaml"},
+            "steps": [
+                {
+                    "name": "InvokeMiddle",
+                    "id": "invoke_middle",
+                    "call": "middle",
+                    "on": {"failure": {"goto": "Recover"}, "always": {"goto": "Recover"}},
+                },
+                {"name": "Recover", "id": "recover", "command": ["bash", "-lc", "touch recovered.txt"]},
+            ],
+            "finally": {
+                "id": "cleanup_block",
+                "steps": [
+                    {"name": "Cleanup", "id": "cleanup", "command": ["bash", "-lc", "touch cleaned.txt; exit 3"]},
+                ],
+            },
+        },
+    )
+    caller_bundle = WorkflowLoader(tmp_path).load_bundle(caller)
+    caller_manager = StateManager(tmp_path, run_id="sticky-caller")
+    caller_manager.initialize("caller.yaml", context=bundle_context_dict(caller_bundle))
+    assert WorkflowExecutor(caller_bundle, tmp_path, caller_manager).execute()["status"] in {"failed", "completed"}
+    # Corrupt the persisted callee scope, then resume.
+    persisted = caller_manager.load()
+    persisted.call_frames = persisted.call_frames or {}
+    if persisted.call_frames:
+        frame = next(iter(persisted.call_frames.values()))
+        frame["status"] = "running"
+        frame["state"]["status"] = "failed"
+        frame["state"]["current_step"] = {"name": "Gone", "step_id": "root.gone", "status": "running"}
+    persisted.status = "failed"
+    persisted.steps.pop("Recover", None)
+    persisted.steps["InvokeMiddle"] = {**persisted.steps.get("InvokeMiddle", {}), "status": "failed", "exit_code": 2}
+    caller_manager._write_state()
+    for marker in ("recovered.txt", "cleaned.txt"):
+        (tmp_path / marker).unlink(missing_ok=True)
+
+    resumed = WorkflowExecutor(caller_bundle, tmp_path, caller_manager).execute(resume=True)
+
+    after = caller_manager.load().to_dict()
+    diagnostic = after["steps"]["InvokeMiddle"]["error"]
+    assert resumed["status"] == "failed"
+    assert diagnostic["type"] == "resume_projection_integrity_error"
+    assert after["error"] == diagnostic
+    assert "Recover" not in after["steps"]
+    assert not (tmp_path / "recovered.txt").exists()
+    assert (tmp_path / "cleaned.txt").exists()
+    assert after["finalization"]["status"] == "failed"
+    assert after["finalization"]["failure"]["step"].endswith("Cleanup")
+    assert after["finalization"]["failure"]["error"] is None

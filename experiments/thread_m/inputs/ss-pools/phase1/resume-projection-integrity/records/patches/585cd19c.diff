+def test_workflow_lisp_retry_audits_failed_predecessor_then_allocates_lowest_retry(tmp_path):
+    bundle, manager = _completed_call_run(tmp_path, "lineage-retry")
+    frame_id = _workflow_lisp_retry_state(bundle, manager)
+
+    resumed = WorkflowExecutor(_as_workflow_lisp(bundle), tmp_path, manager).execute(resume=True)
+
+    assert resumed["status"] == "completed"
+    assert f"{frame_id}::retry::1" in resumed["call_frames"]
+    assert resumed["call_frames"][frame_id]["status"] == "failed"

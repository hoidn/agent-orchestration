diff --git a/tests/test_workflow_lisp_frontend_kind_provenance.py b/tests/test_workflow_lisp_frontend_kind_provenance.py
new file mode 100644
index 0000000..79b8ec4
--- /dev/null
+++ b/tests/test_workflow_lisp_frontend_kind_provenance.py
@@ -0,0 +1,80 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow_lisp.build import FrontendBuildRequest, build_frontend_bundle
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+FIXTURES = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp"
+CLI_FIXTURES = FIXTURES / "cli"
+SOURCE_ROOT = FIXTURES / "modules" / "valid" / "imported_bundle_mix"
+ENTRYPOINT = SOURCE_ROOT / "neurips" / "entry.orc"
+ENTRY_NAME = "neurips/entry::orchestrate"
+IMPORTED_LISP_NAME = "neurips/helper::provider-attempt"
+
+
+def _compile(tmp_path: Path):
+    classic_bundle = WorkflowLoader(REPO_ROOT).load_bundle(CLI_FIXTURES / "imported_selector.yaml")
+    result = compile_stage3_entrypoint(
+        ENTRYPOINT,
+        source_roots=(SOURCE_ROOT,),
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={"prompts.implementation.execute": "prompts/implementation/execute.md"},
+        imported_workflow_bundles={"selector-run": classic_bundle},
+        validate_shared=True,
+        workspace_root=tmp_path,
+        lowering_route="legacy",
+    )
+    return result, classic_bundle
+
+
+def test_entry_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result, _ = _compile(tmp_path)
+    assert result.validated_bundles_by_name[ENTRY_NAME].provenance.frontend_kind == "workflow_lisp"
+
+
+def test_imported_workflow_lisp_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result, _ = _compile(tmp_path)
+    assert result.validated_bundles_by_name[IMPORTED_LISP_NAME].provenance.frontend_kind == "workflow_lisp"
+
+
+def test_every_lowered_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result, _ = _compile(tmp_path)
+    kinds = {
+        name: bundle.provenance.frontend_kind
+        for name, bundle in result.entry_result.validated_bundles.items()
+    }
+    assert kinds and set(kinds.values()) == {"workflow_lisp"}
+
+
+def test_imported_lisp_bundle_linked_into_entry_is_workflow_lisp(tmp_path: Path) -> None:
+    result, _ = _compile(tmp_path)
+    entry = result.validated_bundles_by_name[ENTRY_NAME]
+    lisp_imports = [bundle for alias, bundle in entry.imports.items() if alias != "selector-run"]
+    assert lisp_imports and all(b.provenance.frontend_kind == "workflow_lisp" for b in lisp_imports)
+
+
+def test_classic_imported_bundle_is_linked_unchanged(tmp_path: Path) -> None:
+    result, classic_bundle = _compile(tmp_path)
+    linked = result.validated_bundles_by_name[ENTRY_NAME].imports["selector-run"]
+    assert linked is classic_bundle and linked.provenance.frontend_kind is None
+
+
+def test_build_frontend_bundle_keeps_compiler_frontend_kind(tmp_path: Path) -> None:
+    result = build_frontend_bundle(
+        FrontendBuildRequest(
+            source_path=ENTRYPOINT,
+            source_roots=(SOURCE_ROOT, tmp_path),
+            entry_workflow="orchestrate",
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            emit_debug_yaml=False,
+            workspace_root=tmp_path,
+        )
+    )
+    assert result.validated_bundle.provenance.frontend_kind == "workflow_lisp"

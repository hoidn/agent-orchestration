@@ -0,0 +1,144 @@
+"""Resume-time boundary resolution, frame selection and callee validation for reached calls.
+
+During a resumed run a reached call selects its callee by the *current* boundary
+that owns the persisted caller id (never by name, suffix or mapping order), picks
+the one resumable frame from the boundary's retry lineage, and audits every frame
+scope it will execute before any callee state is created or any effect runs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Dict, Mapping, Optional
+
+from .call_frame_retry_lineage import CallFrameRetryLineage, next_unused_retry_frame_id
+from .resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_boundary_frames,
+    resolve_reached_boundary,
+)
+from .state_projection import CallBoundaryProjection
+
+
+def projection_failure_result(error: Dict[str, Any]) -> Dict[str, Any]:
+    """Wrap a projection diagnostic as a failed call-step result, unchanged."""
+    return {"status": "failed", "exit_code": 2, "duration_ms": 0, "error": error}
+
+
+@dataclass(frozen=True)
+class ResumedFrameSelection:
+    """Which persisted frame (if any) a reached call resumes, and its lineage."""
+
+    frame_id: str
+    existing_frame: Optional[Dict[str, Any]]
+    lineage: Optional[CallFrameRetryLineage]
+    deferred_error: Optional[Dict[str, Any]] = None
+
+    @property
+    def exempt_frame_ids(self) -> frozenset[str]:
+        if self.lineage is None:
+            return frozenset()
+        return frozenset(member.frame_id for member in self.lineage.failed_predecessors)
+
+
+class ResumedCall:
+    """Resume-mode helper owned by one ``CallExecutor``."""
+
+    def __init__(self, executor: Any) -> None:
+        self.executor = executor
+
+    def scope_path(self) -> ResumeScopePath:
+        path = getattr(self.executor, "resume_scope_path", None)
+        if path is None:
+            path = ResumeScopePath.root(self.executor.state_manager.load().workflow_file)
+        return path
+
+    def resolve_boundary(
+        self, state: Mapping[str, Any], step_id: str
+    ) -> tuple[Optional[CallBoundaryProjection], Any, Optional[Dict[str, Any]]]:
+        """Return ``(boundary, callee bundle, None)`` or ``(None, None, failure result)``."""
+        try:
+            boundary, callee = resolve_reached_boundary(
+                self.executor.loaded_bundle, state, self.scope_path(), step_id
+            )
+        except ResumeProjectionIntegrityError as exc:
+            return None, None, projection_failure_result(exc.error)
+        return boundary, callee, None
+
+    def select_frame(
+        self,
+        state: Mapping[str, Any],
+        *,
+        step_id: str,
+        default_frame_id: str,
+        boundary: CallBoundaryProjection,
+        frontend_kind: Optional[str],
+    ) -> ResumedFrameSelection:
+        """Pick the frame this reached call occupies; lineage errors are deferred."""
+        call_frames = state.get("call_frames", {})
+        try:
+            lineage = audit_boundary_frames(
+                self.executor.loaded_bundle,
+                state,
+                self.scope_path(),
+                boundary,
+                step_id,
+                frontend_kind=frontend_kind,
+            )
+        except ResumeProjectionIntegrityError as exc:
+            return ResumedFrameSelection(default_frame_id, None, None, exc.error)
+        running = lineage.running_member
+        if running is not None:
+            return ResumedFrameSelection(running.frame_id, call_frames[running.frame_id], lineage)
+        if lineage.failed_predecessors:
+            return ResumedFrameSelection(next_unused_retry_frame_id(lineage), None, lineage)
+        return ResumedFrameSelection(default_frame_id, None, lineage)
+
+    def validate_callee(
+        self,
+        selection: ResumedFrameSelection,
+        state: Mapping[str, Any],
+        *,
+        step_name: str,
+        call_alias: Any,
+        callee: Any,
+        calls: Any,
+        audit: Any,
+    ) -> Optional[Dict[str, Any]]:
+        """Checksum-validate and audit the failed predecessors, then the running member.
+
+        ``audit`` is the caller's ``audit_scope`` binding. The running member's own checksum and bound-input validation already ran.
+        """
+        if selection.deferred_error is not None:
+            return projection_failure_result(selection.deferred_error)
+        lineage = selection.lineage
+        assert lineage is not None
+        call_frames = state["call_frames"]
+        for member in lineage.failed_predecessors:
+            frame = call_frames[member.frame_id]
+            checksum_error = calls.validate_resume_checksum(
+                step_name=step_name,
+                call_alias=call_alias,
+                frame_id=member.frame_id,
+                imported_workflow=callee,
+                existing_frame=frame,
+            )
+            if checksum_error is not None:
+                return checksum_error
+            audit_error = self._audit_frame_scope(audit, callee, frame, member.frame_id)
+            if audit_error is not None:
+                return audit_error
+        running = lineage.running_member
+        if running is None:
+            return None
+        return self._audit_frame_scope(audit, callee, call_frames[running.frame_id], running.frame_id)
+
+    def _audit_frame_scope(
+        self, audit: Any, callee: Any, frame: Mapping[str, Any], frame_id: str
+    ) -> Optional[Dict[str, Any]]:
+        try:
+            audit(callee, frame.get("state"), self.scope_path().child(frame_id))
+        except ResumeProjectionIntegrityError as exc:
+            return projection_failure_result(exc.error)
+        return None

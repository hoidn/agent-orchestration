+def _corrupt_callee_resume(tmp_path: Path, run_id: str, extra_steps: list[dict], on: dict | None = None):
+    _write_projection_integrity_call_graph(tmp_path)
+    call_step = {"name": "InvokeMiddle", "id": "invoke_middle", "call": "middle"}
+    if on:
+        call_step["on"] = on
+    workflow = _write_yaml(
+        tmp_path / "sticky.yaml",
+        {
+            "version": "2.5",
+            "name": "sticky-root",
+            "imports": {"middle": "imports/middle.yaml"},
+            "steps": [call_step, *extra_steps],
+        },
+    )
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow)
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("sticky.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["current_step"] = {"name": "Gone", "step_id": "root.gone", "status": "running"}
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    for step in extra_steps:
+        persisted.steps.pop(step["name"], None)
+    manager._write_state()
+    return bundle, manager, frame_id

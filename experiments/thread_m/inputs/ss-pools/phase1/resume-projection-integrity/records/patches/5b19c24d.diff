+def _failed_simple_run(workspace: Path, run_id: str):
+    path = _simple_workflow(workspace)
+    manager = StateManager(workspace, run_id=run_id)
+    state = manager.initialize(path.name)
+    state.status = "failed"
+    state.current_step = {"name": "Work", "index": 0, "step_id": "root.work", "status": "running", "visit_count": 1}
+    state.steps = {}
+    manager._write_state()
+    manager.run_root.joinpath("unknown.txt").write_text("keep", encoding="utf-8")
+    return path, manager

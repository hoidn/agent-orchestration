new file mode 100644
index 0000000..a819b9c
--- /dev/null
+++ b/tests/test_loader_duplicate_import_alias.py
@@ -0,0 +1,167 @@
+"""Duplicate classic-YAML import aliases/sections are rejected before bundle lowering."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Hello
+    id: hello
+    command: ["echo", "hi"]
+"""
+
+
+@pytest.fixture
+def workspace(tmp_path: Path) -> Path:
+    (tmp_path / "lib.yaml").write_text(LIBRARY)
+    (tmp_path / "other.yaml").write_text(LIBRARY.replace("name: lib", "name: other"))
+    return tmp_path
+
+
+@pytest.fixture
+def lowering_calls(monkeypatch) -> list:
+    calls: list = []
+    real = loader_module.build_loaded_workflow_bundle
+
+    def recording(*args, **kwargs):
+        calls.append(args)
+        return real(*args, **kwargs)
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", recording)
+    return calls
+
+
+def _load_messages(workspace: Path, text: str) -> list[str]:
+    path = workspace / "main.yaml"
+    path.write_text(text)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(workspace).load(path)
+    return [error.message for error in excinfo.value.errors]
+
+
+STEPS = """\
+steps:
+  - name: Call
+    id: call
+    call: lib
+"""
+
+DUPLICATE_KEY_IN_MAPPING = """\
+version: "2.5"
+imports:
+  lib: lib.yaml
+  other: other.yaml
+  lib: other.yaml
+""" + STEPS
+
+MERGE_INSIDE_IMPORTS = """\
+version: "2.5"
+x-base: &base
+  lib: lib.yaml
+imports:
+  <<: *base
+  lib: other.yaml
+""" + STEPS
+
+REPEATED_SECTIONS_SAME_ALIAS = """\
+version: "2.5"
+imports:
+  lib: lib.yaml
+imports:
+  lib: other.yaml
+""" + STEPS
+
+TOP_LEVEL_MERGE_SOURCES = """\
+a: &a
+  imports:
+    lib: lib.yaml
+b: &b
+  imports:
+    lib: other.yaml
+<<: [*a, *b]
+version: "2.5"
+""" + STEPS
+
+
+@pytest.mark.parametrize(
+    ("text", "positions"),
+    [
+        (DUPLICATE_KEY_IN_MAPPING, ["line 3, column 3", "line 5, column 3"]),
+        (MERGE_INSIDE_IMPORTS, ["line 3, column 3", "line 6, column 3"]),
+        (REPEATED_SECTIONS_SAME_ALIAS, ["line 3, column 3", "line 5, column 3"]),
+        (TOP_LEVEL_MERGE_SOURCES, ["line 3, column 5", "line 6, column 5"]),
+    ],
+    ids=["mapping_keys", "merge_in_imports", "repeated_sections", "top_level_merges"],
+)
+def test_duplicate_alias_reported_once_with_each_position(workspace, lowering_calls, text, positions):
+    messages = _load_messages(workspace, text)
+    assert (
+        [m for m in messages if "imports" in m],
+        all(p in messages[0] for p in positions),
+        lowering_calls,
+    ) == ([messages[0]], True, [])
+    assert "imports.lib: duplicate import alias" in messages[0]
+
+
+REPEATED_SECTIONS_DISTINCT = """\
+version: "2.5"
+imports:
+  lib: lib.yaml
+imports:
+  other: other.yaml
+""" + STEPS
+
+MERGED_AND_EXPLICIT_SECTIONS_DISTINCT = """\
+base: &base
+  imports:
+    lib: lib.yaml
+<<: *base
+version: "2.5"
+imports:
+  other: other.yaml
+""" + STEPS
+
+
+@pytest.mark.parametrize(
+    ("text", "positions"),
+    [
+        (REPEATED_SECTIONS_DISTINCT, ["line 2, column 1", "line 4, column 1"]),
+        (MERGED_AND_EXPLICIT_SECTIONS_DISTINCT, ["line 2, column 3", "line 6, column 1"]),
+    ],
+    ids=["direct", "merged_and_explicit"],
+)
+def test_repeated_sections_with_distinct_aliases_reported_as_duplicate_mapping(
+    workspace, lowering_calls, text, positions
+):
+    messages = _load_messages(workspace, text)
+    import_messages = [m for m in messages if "imports" in m]
+    assert (
+        len(import_messages),
+        import_messages[0].startswith("imports: duplicate top-level mapping"),
+        all(p in import_messages[0] for p in positions),
+        "duplicate import alias" in import_messages[0],
+        lowering_calls,
+    ) == (1, True, True, False, [])
+
+
+def test_single_merged_imports_section_loads(workspace):
+    path = workspace / "main.yaml"
+    path.write_text(
+        """\
+<<: &base
+  imports:
+    lib: lib.yaml
+version: "2.5"
+name: main
+"""
+        + STEPS
+    )
+    bundle = WorkflowLoader(workspace).load(path)
+    assert "lib" in bundle.imports

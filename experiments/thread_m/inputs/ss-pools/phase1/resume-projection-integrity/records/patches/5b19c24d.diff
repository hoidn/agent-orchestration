--- /dev/null
+++ b/tests/test_workflow_lisp_frontend_kind_provenance.py
@@ -0,0 +1,99 @@
+"""Workflow Lisp compiler bundles are typed by `provenance.frontend_kind`."""
+
+from pathlib import Path
+
+from orchestrator.workflow_lisp.build import (
+    FrontendBuildRequest,
+    build_frontend_bundle,
+    load_imported_workflow_bundle_manifest,
+)
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+
+
+FIXTURES = Path(__file__).parent / "fixtures" / "workflow_lisp"
+CLI_FIXTURES = FIXTURES / "cli"
+SOURCE_ROOT = FIXTURES / "modules" / "valid" / "imported_bundle_mix"
+ENTRY = SOURCE_ROOT / "neurips" / "entry.orc"
+
+
+def _yaml_bundles(tmp_path: Path) -> dict[str, object]:
+    bindings = load_imported_workflow_bundle_manifest(
+        CLI_FIXTURES / "imported_workflow_bundles.json",
+        workspace_root=tmp_path,
+        source_roots=(SOURCE_ROOT,),
+        provider_externs_path=CLI_FIXTURES / "providers.json",
+        prompt_externs_path=CLI_FIXTURES / "prompts.json",
+        command_boundaries_path=CLI_FIXTURES / "commands.json",
+    )
+    return {binding.canonical_key: binding.bundle for binding in bindings}
+
+
+def _compile(tmp_path: Path, yaml_bundles: dict[str, object]):
+    return compile_stage3_entrypoint(
+        ENTRY,
+        source_roots=(SOURCE_ROOT,),
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={"prompts.implementation.execute": "prompts/implementation/execute.md"},
+        imported_workflow_bundles=yaml_bundles,
+        command_boundaries={
+            "run_checks": ExternalToolBinding(
+                name="run_checks",
+                stable_command=("python", "scripts/run_checks.py"),
+            )
+        },
+        validate_shared=True,
+        workspace_root=tmp_path,
+        lowering_route="legacy",
+    )
+
+
+def test_every_validated_bundle_is_typed_workflow_lisp(tmp_path: Path) -> None:
+    result = _compile(tmp_path, _yaml_bundles(tmp_path))
+
+    kinds = {
+        name: bundle.provenance.frontend_kind
+        for name, bundle in result.validated_bundles_by_name.items()
+    }
+
+    assert kinds and set(kinds.values()) == {"workflow_lisp"}, kinds
+
+
+def test_imported_workflow_lisp_module_bundle_is_typed_workflow_lisp(tmp_path: Path) -> None:
+    result = _compile(tmp_path, _yaml_bundles(tmp_path))
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+
+    helper = next(
+        bundle for alias, bundle in entry.imports.items() if "provider-attempt" in alias
+    )
+
+    assert helper.provenance.frontend_kind == "workflow_lisp"
+
+
+def test_imported_yaml_bundle_is_linked_by_identity_with_own_provenance(tmp_path: Path) -> None:
+    yaml_bundles = _yaml_bundles(tmp_path)
+    yaml_bundle = yaml_bundles["selector-run"]
+    result = _compile(tmp_path, yaml_bundles)
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+
+    assert entry.imports["selector-run"] is yaml_bundle
+    assert yaml_bundle.provenance.frontend_kind is None
+
+
+def test_build_frontend_bundle_keeps_compiler_frontend_kind(tmp_path: Path) -> None:
+    result = build_frontend_bundle(
+        FrontendBuildRequest(
+            source_path=ENTRY,
+            source_roots=(SOURCE_ROOT,),
+            entry_workflow="orchestrate",
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            emit_debug_yaml=False,
+            workspace_root=tmp_path,
+            lowering_route="legacy",
+        )
+    )
+
+    assert result.validated_bundle.provenance.frontend_kind == "workflow_lisp"

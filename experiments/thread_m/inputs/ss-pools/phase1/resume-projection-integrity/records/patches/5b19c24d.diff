+def _as_workflow_lisp_callee(bundle, alias: str = "middle"):
+    """Return ``bundle`` with its ``alias`` import typed as a Workflow Lisp bundle."""
+    callee = bundle.imports[alias]
+    typed = dataclasses.replace(
+        callee, provenance=dataclasses.replace(callee.provenance, frontend_kind="workflow_lisp")
+    )
+    return dataclasses.replace(bundle, imports={**bundle.imports, alias: typed})

diff --git a/orchestrator/loader_import_aliases.py b/orchestrator/loader_import_aliases.py
new file mode 100644
index 0000000..a9983a0
--- /dev/null
+++ b/orchestrator/loader_import_aliases.py
@@ -0,0 +1,60 @@
+"""Detect duplicate `imports` aliases/sections in a composed classic-YAML workflow.
+
+`yaml.load` silently keeps the last duplicate key and lets `<<` merges shadow
+keys, so duplicate import aliases must be found on the composed node tree,
+before the dict is built. Positions are 1-based `line L, column C` of each key.
+"""
+
+from typing import Dict, List, Tuple
+
+import yaml
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _effective_pairs(node: yaml.MappingNode) -> List[Tuple[yaml.Node, yaml.Node]]:
+    """Return every key/value pair of a mapping, expanding `<<` merge sources recursively."""
+    pairs: List[Tuple[yaml.Node, yaml.Node]] = []
+    for key, value in node.value:
+        if key.tag != _MERGE_TAG:
+            pairs.append((key, value))
+            continue
+        sources = value.value if isinstance(value, yaml.SequenceNode) else [value]
+        for source in sources:
+            if isinstance(source, yaml.MappingNode):
+                pairs.extend(_effective_pairs(source))
+    return pairs
+
+
+def _position(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def duplicate_import_errors(root: yaml.Node) -> List[str]:
+    """Return error messages for duplicate import aliases, else for duplicate `imports` sections.
+
+    A repeated alias is reported once per alias; repeated `imports` sections are only
+    reported as `imports: duplicate top-level mapping` when no alias repeats.
+    """
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [
+        (key, value)
+        for key, value in _effective_pairs(root)
+        if isinstance(key, yaml.ScalarNode) and key.value == "imports"
+    ]
+    aliases: Dict[str, List[yaml.Node]] = {}
+    for _, value in sections:
+        if isinstance(value, yaml.MappingNode):
+            for key, _ in _effective_pairs(value):
+                if isinstance(key, yaml.ScalarNode):
+                    aliases.setdefault(key.value, []).append(key)
+    errors = [
+        f"imports.{alias}: duplicate import alias ({'; '.join(_position(k) for k in keys)})"
+        for alias, keys in aliases.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(sections) > 1:
+        positions = "; ".join(_position(key) for key, _ in sections)
+        errors.append(f"imports: duplicate top-level mapping ({positions})")
+    return errors

+"""Loop-bookkeeping validation for checksum-compatible resume projection integrity.
+
+Pure functions over a persisted state mapping: they never mutate it and read
+nothing else. Each raises ``ResumeProjectionValidationError`` carrying one of the
+audit reasons ``unsupported_shape`` or ``invalid_loop_progress`` and a stable
+message, and otherwise return the iteration indices the bookkeeping admits.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Raised when persisted resume bookkeeping violates the projection contract."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        field: Optional[str] = None,
+        offending: Any = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+        self.offending = offending
+
+    def __str__(self) -> str:
+        return self.message
+
+
+_FIELD_BY_MESSAGE_WORD = {
+    "condition": "last_condition_result",
+    "terminal": "completed_iterations",
+    "successful": "completed_iterations",
+    "failed": "completed_iterations",
+}
+
+
+def _field_of(message: str) -> str:
+    """Return the dotted field a bookkeeping message names (its leading path)."""
+    path = message.split(" ", 1)[0]
+    head, _, last = path.rpartition(".")
+    return f"{head}.{_FIELD_BY_MESSAGE_WORD[last]}" if last in _FIELD_BY_MESSAGE_WORD else path
+
+
+def _shape(message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field=_field_of(message))
+
+
+def _progress(message: str, offending: Any = None) -> ResumeProjectionValidationError:
+    scalar = offending if isinstance(offending, (str, int, float, bool)) else None
+    return ResumeProjectionValidationError(
+        "invalid_loop_progress", message, field=_field_of(message), offending=scalar
+    )
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _section(state: Mapping[str, Any], key: str) -> Mapping[str, Any]:
+    if key not in state:
+        return {}
+    section = state[key]
+    if not isinstance(section, Mapping):
+        raise _shape(f"{key} must be a mapping")
+    return section
+
+
+def _has_duplicates(values: list[Any]) -> bool:
+    return len(set(values)) != len(values)
+
+
+def _completed_indices(label: str, progress: Mapping[str, Any], size: int) -> list:
+    completed = progress.get("completed_indices", [])
+    if not isinstance(completed, list):
+        raise _shape(f"{label}.completed_indices must be a list")
+    if any(not _is_index(i) or not 0 <= i < size for i in completed):
+        raise _progress(f"{label}.completed_indices contains an out-of-range index")
+    if _has_duplicates(completed):
+        raise _progress(f"{label}.completed_indices must not contain duplicate indices")
+    return completed
+
+
+def for_each_iterations(name: str, progress: Any) -> tuple[int, ...]:
+    """Validate one ``for_each`` bookkeeping entry and return its iteration indices."""
+    label = f"for_each.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(f"{label} must be a mapping")
+    items = progress.get("items")
+    if not isinstance(items, list):
+        raise _shape(f"{label}.items must be a list")
+    current = progress.get("current_index")
+    if current is not None and not _is_index(current):
+        raise _shape(f"{label}.current_index must be null or a non-boolean integer")
+    completed = _completed_indices(label, progress, len(items))
+    if current is not None:
+        if not 0 <= current < len(items):
+            raise _progress(f"{label}.current_index is out of range", current)
+        if current in completed:
+            raise _progress(f"{label}.current_index is already completed", current)
+    return tuple(range(len(items)))
+
+
+def _completed_iterations(label: str, progress: Mapping[str, Any], maximum: Optional[int]) -> list:
+    completed = progress.get("completed_iterations", [])
+    if not isinstance(completed, list) or any(
+        not _is_index(i) or i < 0 or (maximum is not None and i >= maximum) for i in completed
+    ):
+        raise _progress(f"{label}.completed_iterations is not valid prior history")
+    if _has_duplicates(completed):
+        raise _progress(f"{label}.completed_iterations must not contain duplicate indices")
+    return completed
+
+
+def _repeat_until_fields(label: str, progress: Mapping[str, Any], maximum: Optional[int]):
+    current = progress.get("current_iteration")
+    if current is not None and not _is_index(current):
+        raise _shape(f"{label}.current_iteration must be null or a non-boolean integer")
+    exhausted = progress.get("exhausted", False)
+    if not isinstance(exhausted, bool):
+        raise _shape(f"{label}.exhausted must be boolean when present")
+    completed = _completed_iterations(label, progress, maximum)
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if (evaluated is not None and not _is_index(evaluated)) or (
+        result is not None and not isinstance(result, bool)
+    ):
+        raise _progress(f"{label}.condition result conflicts with evaluation state")
+    return current, exhausted, completed, evaluated, result
+
+
+def _check_active(label, current, exhausted, completed, evaluated, result, maximum) -> None:
+    if current < 0 or (maximum is not None and current >= maximum):
+        raise _progress(f"{label}.current_iteration is out of range", current)
+    if sorted(completed) != list(range(current)):
+        raise _progress(f"{label}.completed_iterations is not valid prior history")
+    consistent = (evaluated is None and result is None) or (evaluated == current and result is not None)
+    if exhausted or not consistent:
+        raise _progress(f"{label}.condition result conflicts with evaluation state")
+
+
+def _check_exhaustion(label: str, exhausted: bool, frame: Any) -> None:
+    """A terminal exhaustion needs the loop frame to agree with the bookkeeping."""
+    if frame is None:  # the loop row was never persisted: nothing to contradict yet
+        return
+    status = frame.get("status") if isinstance(frame, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _progress(f"{label}.successful exhaustion requires a completed frame")
+        return
+    error = frame.get("error") if isinstance(frame, Mapping) else None
+    error_type = error.get("type") if isinstance(error, Mapping) else None
+    if status != "failed" or error_type != EXHAUSTION_ERROR_TYPE:
+        raise _progress(f"{label}.failed exhaustion requires the terminal exhaustion error")
+
+
+def _check_terminal(label, exhausted, completed, evaluated, result, maximum, frame) -> None:
+    if not completed or evaluated is None or evaluated not in completed or result is None:
+        raise _progress(f"{label}.terminal progress requires completed evaluated history")
+    if sorted(completed) != list(range(evaluated + 1)):
+        raise _progress(f"{label}.completed_iterations is not valid prior history")
+    if result is True:
+        if exhausted:
+            raise _progress(f"{label}.condition result conflicts with evaluation state")
+        return
+    if maximum is None:
+        return
+    if evaluated != maximum - 1:
+        raise _progress(f"{label}.terminal progress requires completed evaluated history")
+    _check_exhaustion(label, exhausted, frame)
+
+
+def repeat_until_iterations(
+    name: str,
+    progress: Any,
+    maximum: Optional[int],
+    frame: Any,
+) -> tuple[int, ...]:
+    """Validate one ``repeat_until`` bookkeeping entry; return the iterations it admits."""
+    label = f"repeat_until.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(f"{label} must be a mapping")
+    current, exhausted, completed, evaluated, result = _repeat_until_fields(label, progress, maximum)
+    if current is not None:
+        _check_active(label, current, exhausted, completed, evaluated, result, maximum)
+        return tuple(sorted({*completed, current}))
+    _check_terminal(label, exhausted, completed, evaluated, result, maximum, frame)
+    return tuple(sorted(completed))
+
+
+def validate_loop_bookkeeping(
+    state: Mapping[str, Any],
+    for_each_frames: Mapping[str, str],
+    repeat_until_frames: Mapping[str, tuple[str, Optional[int]]],
+) -> dict[str, tuple[int, ...]]:
+    """Validate all loop bookkeeping in ``state``; return admitted iterations per loop node.
+
+    ``for_each_frames`` maps frame key -> loop node id; ``repeat_until_frames`` maps
+    frame key -> (loop node id, declared maximum). Entries no loop owns keep only
+    the container-shape checks.
+    """
+    iterations: dict[str, tuple[int, ...]] = {}
+    for name, progress in _section(state, "for_each").items():
+        admitted = for_each_iterations(name, progress)
+        if name in for_each_frames:
+            iterations[for_each_frames[name]] = admitted
+    steps = state.get("steps")
+    for name, progress in _section(state, "repeat_until").items():
+        owner = repeat_until_frames.get(name)
+        frame = steps.get(name) if isinstance(steps, Mapping) else None
+        admitted = repeat_until_iterations(name, progress, owner[1] if owner else None, frame)
+        if owner is not None:
+            iterations[owner[0]] = admitted
+    return iterations

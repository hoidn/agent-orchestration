+@pytest.mark.parametrize("reason", ["workflow_modified", "missing_recorded_checksum", "workflow_unavailable"])
+def test_structural_root_checksum_recheck_persists_only_the_envelope(tmp_path: Path, reason: str):
+    path, manager = _failed_simple_run(tmp_path, f"checksum-{reason}")
+    bundle = WorkflowLoader(tmp_path).load_bundle(path)
+    persisted_checksum = manager.load().workflow_checksum
+    raw = _read(manager)
+    raw["unknown_root_field"] = {"keep": True}
+    manager.state_file.write_text(json.dumps(raw), encoding="utf-8")
+    before = _read(manager)
+    if reason == "workflow_modified":
+        path.write_text(path.read_text(encoding="utf-8") + "# edit\n", encoding="utf-8")
+    elif reason == "missing_recorded_checksum":
+        raw["workflow_checksum"] = ""
+        manager.state_file.write_text(json.dumps(raw), encoding="utf-8")
+        before = _read(manager)
+    else:
+        path.unlink()
+
+    with patch.object(WorkflowExecutor, "_execute_prologue", side_effect=AssertionError("prologue ran")), patch(
+        "orchestrator.workflow.executor.audit_scope", side_effect=AssertionError("audited before checksum")
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _read(manager)
+    error = after["error"]
+    assert result["error"] == error
+    assert error["type"] == "workflow_checksum_mismatch"
+    assert error["message"] == "Workflow has been modified since the run started"
+    context = error["context"]
+    assert set(context) == {"workflow_file", "persisted_checksum", "current_checksum", "reason"}
+    assert context["reason"] == reason
+    assert context["workflow_file"] == "simple.yaml"
+    assert context["persisted_checksum"] == (persisted_checksum if reason != "missing_recorded_checksum" else "")
+    assert (context["current_checksum"] is None) == (reason != "workflow_modified")
+    assert after["status"] == "failed"
+    assert _delta(before, after) <= ENVELOPE
+    assert after["unknown_root_field"] == {"keep": True}
+    assert after["current_step"] == before["current_step"]
+    assert not (tmp_path / "ran.txt").exists()
+

+"""Checksum-compatible resume projection-integrity audit.
+
+``audit_scope`` checks every persisted identity of one workflow scope (step rows,
+``current_step``, loop bookkeeping, call frames and their retry lineage) against
+the projection of the bundle that owns that scope, and raises
+``ResumeProjectionIntegrityError`` when any identity is stale, foreign, missing or
+ambiguous. It reads nothing but the bundle and state it is given and never mutates
+the state.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from .call_frame_retry_lineage import (  # noqa: F401  (re-exported public interface)
+    KNOWN_FRAME_STATUSES,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    FrameMember,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .state_projection import (
+    CallBoundaryProjection,
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    WorkflowStateProjection,
+)
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_SCALARS = (str, int, float, bool)
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the structural root to one audited scope."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Raised when a persisted scope disagrees with the projection that owns it."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def frontend_kind_of(bundle: Any) -> Optional[str]:
+    provenance = workflow_provenance(bundle)
+    return getattr(provenance, "frontend_kind", None)
+
+
+class _ScopeAudit:
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.slots: Optional[ResumeProjectionSlotIndex] = None
+        self.projection: WorkflowStateProjection = bundle.projection
+
+    def fail(
+        self,
+        reason: str,
+        field: Optional[str] = None,
+        offending: Any = None,
+        candidate_count: Optional[int] = None,
+        call_boundary_step_id: Optional[str] = None,
+    ) -> NoReturn:
+        provenance = workflow_provenance(self.bundle)
+        workflow_path = getattr(provenance, "workflow_path", None)
+        checksum = self.state.get("workflow_checksum") if isinstance(self.state, Mapping) else None
+        raise ResumeProjectionIntegrityError(
+            {
+                "type": ERROR_TYPE,
+                "message": f"Resume projection integrity audit failed: {reason}",
+                "context": {
+                    "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                    "reason": reason,
+                    "scope_path": self.scope_path.as_context(),
+                    "field": field,
+                    "offending_value": offending if isinstance(offending, _SCALARS) else None,
+                    "expected_owner": {
+                        "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                        "workflow_checksum": checksum if isinstance(checksum, _SCALARS) else None,
+                        "projection_scope": self.scope_path.projection_scope,
+                    },
+                    "candidate_count": candidate_count,
+                    "call_boundary_step_id": call_boundary_step_id,
+                },
+            }
+        )
+
+    def mapping_section(self, key: str) -> Mapping[str, Any]:
+        if key not in self.state:
+            return {}
+        value = self.state[key]
+        if not isinstance(value, Mapping):
+            self.fail("unsupported_shape", key)
+        return value
+
+    def run(self) -> None:
+        if not isinstance(self.state, Mapping):
+            self.fail("unsupported_shape")
+        steps = self.mapping_section("steps")
+        frames = self.mapping_section("call_frames")
+        projection = self.projection
+        self.prepare_slots()
+        self.audit_step_rows(steps, projection)
+        self.audit_current_step()
+        self.audit_call_frames(frames)
+
+    def prepare_slots(self) -> None:
+        try:
+            self.slots = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            self.fail(exc.reason, exc.field, exc.offending)
+
+    def audit_step_rows(self, steps: Mapping[str, Any], projection: WorkflowStateProjection) -> None:
+        assert self.slots is not None
+        unclaimed = {name for name, _ in self.slots.unclaimed_explicit_rows}
+        loop_frame_keys = {node.frame_key for node in projection.for_each_nodes.values()}
+        for name, row in steps.items():
+            if isinstance(row, list) and name in loop_frame_keys:
+                self.audit_loop_result_list(name, row)
+                continue
+            if not isinstance(row, Mapping):
+                self.fail("unsupported_shape", f"steps.{name}")
+            if "step_id" in row:
+                self.audit_step_row(name, row["step_id"], name in unclaimed)
+
+    def audit_loop_result_list(self, loop_name: str, results: list[Any]) -> None:
+        """Audit explicit ids in per-iteration result entries (``steps.<loop>[i].<nested>``)."""
+        for index, iteration in enumerate(results):
+            if not isinstance(iteration, Mapping):
+                self.fail("unsupported_shape", f"steps.{loop_name}[{index}]")
+            for nested, row in iteration.items():
+                key = f"{loop_name}[{index}].{nested}"
+                if not isinstance(row, Mapping):
+                    self.fail("unsupported_shape", f"steps.{key}")
+                if "step_id" in row:
+                    self.audit_step_row(key, row["step_id"], False)
+
+    def audit_step_row(self, name: str, step_id: Any, unclaimed: bool) -> None:
+        """Resolve one explicit row identity; an absent ``step_id`` is never audited."""
+        assert self.slots is not None
+        field = f"steps.{name}.step_id"
+        if not isinstance(step_id, str) or not step_id:
+            self.fail("unsupported_shape", field, step_id)
+        if unclaimed:
+            self.fail("unclaimed_explicit_step_row", field, step_id, 0)
+        resolution = self.projection.resolve_resume_step_id(self.slots, step_id, name)
+        if resolution.candidate_count == 0:
+            self.fail("unknown_explicit_step_id", field, step_id, 0)
+        if resolution.exact_identity_candidate_count != 1:
+            self.fail("presentation_slot_mismatch", field, step_id, resolution.candidate_count)
+
+    def audit_current_step(self) -> None:
+        assert self.slots is not None
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            self.fail("unsupported_shape", "current_step")
+        field = "current_step.step_id"
+        if "step_id" not in current:
+            self.fail("missing_required_identity", field)
+        step_id = current["step_id"]
+        if not isinstance(step_id, str) or not step_id:
+            self.fail("unsupported_shape", field, step_id)
+        name = current.get("name")
+        resolution = self.projection.resolve_resume_step_id(
+            self.slots, step_id, name if isinstance(name, str) else None
+        )
+        if resolution.candidate_count == 0:
+            self.fail("out_of_scope_step_id", field, step_id, 0)
+        if resolution.exact_identity_candidate_count != 1:
+            self.fail("presentation_slot_mismatch", field, step_id, resolution.candidate_count)
+
+    def audit_call_frames(self, frames: Mapping[str, Any]) -> None:
+        owners: dict[str, CallBoundaryProjection] = {}
+        by_boundary: dict[str, list[tuple[str, Any]]] = {}
+        for frame_id, frame in frames.items():
+            call_step_id = self.frame_caller_id(frame_id, frame)
+            owners[call_step_id] = self.boundary_for(call_step_id, f"call_frames.{frame_id}.call_step_id")
+            by_boundary.setdefault(call_step_id, []).append((frame_id, frame))
+        for call_step_id, items in by_boundary.items():
+            callee = self.callee_for(owners[call_step_id], call_step_id)
+            try:
+                index_retry_lineage(call_step_id, items, frontend_kind=frontend_kind_of(callee))
+            except CallFrameRetryLineageError as exc:
+                self.fail_lineage(exc, call_step_id)
+            for frame_id, frame in items:
+                self.check_frame_alias(frame_id, frame, owners[call_step_id])
+
+    def fail_lineage(self, exc: CallFrameRetryLineageError, call_step_id: str) -> NoReturn:
+        if exc.reason == "ambiguous_resumable_call_frame":
+            self.fail(exc.reason, "call_frames", exc.count, exc.count, call_step_id)
+        suffix = {"missing_call_boundary": "call_step_id", "persisted_import_alias_mismatch": "import_alias"}
+        field = f"call_frames.{exc.frame_id}" + (f".{suffix[exc.reason]}" if exc.reason in suffix else "")
+        self.fail(exc.reason, field, None, None, call_step_id)
+
+    def frame_caller_id(self, frame_id: str, frame: Any) -> str:
+        """Validate one frame's shape, caller id and status; return its caller id."""
+        label = f"call_frames.{frame_id}"
+        if not isinstance(frame, Mapping):
+            self.fail("unsupported_shape", label)
+        field = f"{label}.call_step_id"
+        if "call_step_id" not in frame:
+            self.fail("missing_required_identity", field)
+        call_step_id = frame["call_step_id"]
+        if not isinstance(call_step_id, str) or not call_step_id:
+            self.fail("unsupported_shape", field, call_step_id)
+        if frame.get("call_frame_id", frame_id) != frame_id:
+            self.fail("unsupported_shape", f"{label}.call_frame_id", frame["call_frame_id"], None, call_step_id)
+        if frame.get("status") not in KNOWN_FRAME_STATUSES:
+            self.fail("unsupported_shape", f"{label}.status", frame.get("status"), None, call_step_id)
+        return call_step_id
+
+    def boundary_for(self, call_step_id: str, field: Optional[str]) -> CallBoundaryProjection:
+        """Resolve the one current boundary owning ``call_step_id`` (one resolver call)."""
+        assert self.slots is not None
+        resolution = self.projection.resolve_call_boundary(self.slots, call_step_id)
+        if resolution.candidate_count > 1:
+            self.fail("ambiguous_call_boundary", field, call_step_id, resolution.candidate_count, call_step_id)
+        if resolution.boundary is None:
+            reason = (
+                "missing_call_boundary"
+                if call_step_id in self.slots.candidates_by_step_id
+                else "out_of_scope_step_id"
+            )
+            self.fail(reason, field, call_step_id, 0, call_step_id)
+        return resolution.boundary
+
+    def callee_for(self, boundary: CallBoundaryProjection, call_step_id: str) -> Any:
+        """Return the loaded callee bundle the boundary's current alias selects."""
+        callee = workflow_import_bundle(self.bundle, boundary.import_alias or "")
+        if callee is None:
+            self.fail(
+                "missing_imported_bundle",
+                f"imports.{boundary.import_alias}",
+                boundary.import_alias,
+                1,
+                call_step_id,
+            )
+        return callee
+
+    def check_frame_alias(
+        self, frame_id: str, frame: Mapping[str, Any], boundary: CallBoundaryProjection
+    ) -> None:
+        persisted_alias = frame.get("import_alias")
+        if boundary.import_alias is not None and persisted_alias != boundary.import_alias:
+            self.fail(
+                "persisted_import_alias_mismatch",
+                f"call_frames.{frame_id}.import_alias",
+                persisted_alias,
+                1,
+                frame["call_step_id"],
+            )
+
+
+def resolve_reached_boundary(
+    bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath, call_step_id: str
+) -> tuple[CallBoundaryProjection, Any]:
+    """Resolve the one current boundary (and its callee bundle) a reached call executes.
+
+    Raises ``ResumeProjectionIntegrityError``; calls ``resolve_call_boundary`` once.
+    """
+    audit = _ScopeAudit(bundle, plain_state(state), scope_path)
+    audit.prepare_slots()
+    boundary = audit.boundary_for(call_step_id, None)
+    return boundary, audit.callee_for(boundary, call_step_id)
+
+
+def audit_boundary_frames(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    boundary: CallBoundaryProjection,
+    call_step_id: str,
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Revalidate the persisted frames of one reached boundary; return their lineage."""
+    audit = _ScopeAudit(bundle, plain_state(state), scope_path)
+    frames = audit.mapping_section("call_frames")
+    owned = [
+        (frame_id, frame)
+        for frame_id, frame in frames.items()
+        if isinstance(frame, Mapping) and frame.get("call_step_id") == call_step_id
+    ]
+    for frame_id, frame in owned:
+        audit.frame_caller_id(frame_id, frame)
+    try:
+        lineage = index_retry_lineage(call_step_id, owned, frontend_kind=frontend_kind)
+    except CallFrameRetryLineageError as exc:
+        audit.fail_lineage(exc, call_step_id)
+    for frame_id, frame in owned:
+        audit.check_frame_alias(frame_id, frame, boundary)
+    return lineage
+
+
+def plain_state(state: Any) -> Any:
+    """Return a read-only mapping view of ``state`` (a mapping or a ``RunState``)."""
+    if not hasattr(state, "to_dict"):
+        return state
+    try:
+        return state.to_dict()
+    except (AttributeError, TypeError):  # malformed container: audit the raw fields instead
+        return {f.name: getattr(state, f.name) for f in dataclasses.fields(state)}
+
+
+def is_projection_error(error: Any) -> bool:
+    """Return True for a sticky, non-routable resume projection-integrity diagnostic."""
+    return isinstance(error, Mapping) and error.get("type") == ERROR_TYPE
+
+
+def audit_scope(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against ``bundle``'s projection."""
+    snapshot = plain_state(state)
+    _ScopeAudit(bundle, snapshot, scope_path).run()

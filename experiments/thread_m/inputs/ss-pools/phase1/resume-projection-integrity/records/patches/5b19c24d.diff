+++ b/orchestrator/workflow/call_frame_retry_lineage.py
@@ -0,0 +1,175 @@
+"""Retry-lineage indexing for persisted reusable-call frames.
+
+A call boundary owns zero or more persisted frames. Completed frames are
+historical and never resumable. For a Workflow Lisp callee the non-completed
+frames form one retry lineage ``B`` (ordinal 0), ``B::retry::1``, ... with at
+most one running member and any number of failed predecessors; for any other
+callee at most one non-completed frame may exist. Pure functions over the given
+``(frame_id, frame)`` pairs: nothing is read, mutated or allocated.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+KNOWN_FRAME_STATUSES = ("completed", "failed", "running")
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Raised when the frames of one call boundary cannot form a valid lineage."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        frame_id: Optional[str] = None,
+        count: Optional[int] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.frame_id = frame_id
+        self.count = count
+
+
+@dataclass(frozen=True)
+class FrameMember:
+    """One persisted frame of a call boundary."""
+
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(FrameMember):
+    """A frame of a Workflow Lisp retry lineage; ordinal 0 is the base frame."""
+
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    """The frames of one call boundary, grouped by resumability."""
+
+    base_frame_id: Optional[str]
+    completed_members: tuple[FrameMember, ...] = ()
+    failed_predecessors: tuple[RetryFrameMember, ...] = ()
+    running_member: Optional[FrameMember] = None
+    used_ordinals: frozenset[int] = frozenset()
+
+
+def _parse_member(frame_id: Any, status: str) -> tuple[str, RetryFrameMember]:
+    if not isinstance(frame_id, str) or not frame_id:
+        raise CallFrameRetryLineageError("unsupported_shape", "frame id must be a non-empty string")
+    base, marker, tail = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return base, RetryFrameMember(frame_id, status, 0)
+    if not base or RETRY_MARKER in tail or not tail.isascii() or not tail.isdecimal() or int(tail) < 1:
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "malformed retry marker", frame_id=frame_id
+        )
+    return base, RetryFrameMember(frame_id, status, int(tail))
+
+
+def _normalise(boundary_step_id: str, frame_items: Iterable[tuple[Any, Any]]) -> list[tuple[Any, str]]:
+    frames: list[tuple[Any, str]] = []
+    alias_seen: list[Any] = []
+    for frame_id, frame in frame_items:
+        if not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError(
+                "unsupported_shape", "frame must be a mapping", frame_id=frame_id
+            )
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", "frame is not owned by the boundary", frame_id=frame_id
+            )
+        status = frame.get("status")
+        if status not in KNOWN_FRAME_STATUSES:
+            raise CallFrameRetryLineageError(
+                "unsupported_shape", "unknown frame status", frame_id=frame_id
+            )
+        alias = frame.get("import_alias")
+        if alias_seen and alias != alias_seen[0]:
+            raise CallFrameRetryLineageError(
+                "persisted_import_alias_mismatch", "frames disagree on import alias", frame_id=frame_id
+            )
+        alias_seen.append(alias)
+        frames.append((frame_id, status))
+    return frames
+
+
+def _lineage_members(parsed: list[tuple[str, RetryFrameMember]]) -> tuple[Optional[str], list[RetryFrameMember]]:
+    """Return the lineage base and its members; mixed bases among open frames are ambiguous."""
+    open_bases = {base for base, m in parsed if m.status != "completed"}
+    if len(open_bases) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "mixed retry lineages",
+            count=sum(1 for _, m in parsed if m.status != "completed"),
+        )
+    bases = open_bases or {base for base, _ in parsed}
+    base_frame_id = min(bases) if bases else None
+    return base_frame_id, [m for base, m in parsed if base == base_frame_id]
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[Any, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group the frames of one call boundary into a validated retry lineage."""
+    frames = _normalise(boundary_step_id, frame_items)
+    if frontend_kind != "workflow_lisp":
+        return _index_single_frame(frames)
+    parsed = [_parse_member(frame_id, status) for frame_id, status in frames]
+    base_frame_id, members = _lineage_members(parsed)
+    ordinals = [m.ordinal for m in members]
+    open_count = sum(1 for _, m in parsed if m.status != "completed")
+    if len(set(ordinals)) != len(ordinals):
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "duplicate retry ordinal", count=open_count
+        )
+    running = [m for m in members if m.status == "running"]
+    if len(running) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "several running members", count=len(running)
+        )
+    if any(m.status != "completed" for m in members) and set(ordinals) != set(range(max(ordinals) + 1)):
+        raise CallFrameRetryLineageError("unsupported_shape", "retry lineage has a missing ordinal")
+    return CallFrameRetryLineage(
+        base_frame_id=base_frame_id,
+        completed_members=tuple(m for _, m in parsed if m.status == "completed"),
+        failed_predecessors=tuple(
+            sorted((m for m in members if m.status == "failed"), key=lambda m: m.ordinal)
+        ),
+        running_member=running[0] if running else None,
+        used_ordinals=frozenset(ordinals),
+    )
+
+
+def _index_single_frame(frames: list[tuple[Any, str]]) -> CallFrameRetryLineage:
+    open_frames = [(fid, status) for fid, status in frames if status != "completed"]
+    if len(open_frames) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "several resumable frames for one boundary",
+            count=len(open_frames),
+        )
+    return CallFrameRetryLineage(
+        base_frame_id=open_frames[0][0] if open_frames else None,
+        completed_members=tuple(FrameMember(fid, s) for fid, s in frames if s == "completed"),
+        running_member=FrameMember(*open_frames[0]) if open_frames else None,
+    )
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<n>`` for the lowest unused positive ordinal ``n``."""
+    if lineage.base_frame_id is None:
+        raise ValueError("a retry lineage without a base frame cannot allocate a retry id")
+    ordinal = 1
+    while ordinal in lineage.used_ordinals:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

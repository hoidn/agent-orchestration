+def _row(name: str, step_id=None, **extra) -> dict:
+    row = {"status": "completed", "name": name, **extra}
+    if step_id is not None:
+        row["step_id"] = step_id
+    return row
+
+
+def _failure(bundle, state, scope=ROOT) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as caught:
+        audit_scope(bundle, state, scope)
+    return caught.value.error
+
+
+def _context(error: dict) -> dict:
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == f"Resume projection integrity audit failed: {error['context']['reason']}"
+    return error["context"]
+

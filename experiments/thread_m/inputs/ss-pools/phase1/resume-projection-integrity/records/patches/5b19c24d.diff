+def test_reached_call_validates_checksum_then_audits_before_constructing_the_callee(tmp_path: Path):
+    bundle, manager, frame_id = _prepare_call_resume(tmp_path, "call-order")
+    events: list[str] = []
+    original_checksum = CallExecutor.validate_resume_checksum
+    original_resolve = WorkflowStateProjection.resolve_call_boundary
+    import orchestrator.workflow.calls as calls_module
+    import orchestrator.workflow.call_frame_state as frame_state
+
+    def checksum(self, **kwargs):
+        events.append(f"checksum:{kwargs['frame_id']}")
+        return original_checksum(self, **kwargs)
+
+    def audit(callee_bundle, state, scope_path):
+        events.append(f"audit:{[item.get('frame_id') for item in scope_path.as_context()[1:]]}")
+        return audit_scope(callee_bundle, state, scope_path)
+
+    def resolve(self, slot_index, call_step_id):
+        events.append(f"resolve:{call_step_id}")
+        return original_resolve(self, slot_index, call_step_id)
+
+    original_manager = frame_state._CallFrameStateManager
+
+    def construct(*args, **kwargs):
+        events.append(f"construct:{kwargs['frame_id']}")
+        return original_manager(*args, **kwargs)
+
+    with patch.object(CallExecutor, "validate_resume_checksum", checksum), patch.object(
+        calls_module, "audit_scope", audit
+    ), patch("orchestrator.workflow.executor.audit_scope"), patch.object(
+        WorkflowStateProjection, "resolve_call_boundary", resolve
+    ), patch.object(frame_state, "_CallFrameStateManager", construct):
+        resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert resumed["status"] == "completed"
+    audit_event = f"audit:['{frame_id}']"
+    assert events.count("resolve:root.invoke_middle") == 1
+    assert [events[0], events[1], events[2]] == [
+        "resolve:root.invoke_middle",
+        f"checksum:{frame_id}",
+        audit_event,
+    ]
+    assert events.index(f"construct:{frame_id}") > events.index(audit_event)

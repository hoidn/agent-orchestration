diff --git a/tests/test_workflow_lisp_frontend_kind_provenance.py b/tests/test_workflow_lisp_frontend_kind_provenance.py
new file mode 100644
index 0000000..d04bd5b
--- /dev/null
+++ b/tests/test_workflow_lisp_frontend_kind_provenance.py
@@ -0,0 +1,112 @@
+"""Workflow Lisp compiler bundles carry typed `frontend_kind` provenance."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from orchestrator.workflow_lisp import build
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+
+FIXTURES = Path(__file__).resolve().parent / "fixtures" / "workflow_lisp"
+CLI_FIXTURES = FIXTURES / "cli"
+SOURCE_ROOT = FIXTURES / "modules" / "valid" / "imported_bundle_mix"
+ENTRYPOINT = SOURCE_ROOT / "neurips" / "entry.orc"
+YAML_ALIAS = "selector-run"
+HELPER = "neurips/helper::provider-attempt"
+ENTRY = "neurips/entry::orchestrate"
+
+
+def _compile_mixed_imports(tmp_path: Path):
+    """Compile the Lisp entry that imports a Lisp module and a classic-YAML bundle."""
+
+    yaml_bundles = {
+        binding.canonical_key: binding.bundle
+        for binding in build.load_imported_workflow_bundle_manifest(
+            CLI_FIXTURES / "imported_workflow_bundles.json",
+            workspace_root=tmp_path,
+            source_roots=(SOURCE_ROOT,),
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            lowering_route=None,
+        )
+    }
+    commands_path = CLI_FIXTURES / "commands.json"
+    result = compile_stage3_entrypoint(
+        ENTRYPOINT,
+        source_roots=(SOURCE_ROOT,),
+        entry_workflow="orchestrate",
+        provider_externs=json.loads((CLI_FIXTURES / "providers.json").read_text(encoding="utf-8")),
+        prompt_externs=json.loads((CLI_FIXTURES / "prompts.json").read_text(encoding="utf-8")),
+        imported_workflow_bundles=yaml_bundles,
+        command_boundaries=build._parse_command_boundaries_manifest(
+            build._load_command_boundaries_manifest_payload(commands_path),
+            manifest_path=commands_path,
+        ),
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return result, yaml_bundles[YAML_ALIAS]
+
+
+def test_every_validated_compiler_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result, _ = _compile_mixed_imports(tmp_path)
+
+    kinds = {name: bundle.provenance.frontend_kind for name, bundle in result.validated_bundles_by_name.items()}
+
+    assert kinds == {HELPER: "workflow_lisp", ENTRY: "workflow_lisp"}
+
+
+def test_imported_workflow_lisp_bundle_reached_through_imports_is_workflow_lisp(tmp_path: Path) -> None:
+    result, _ = _compile_mixed_imports(tmp_path)
+
+    imported_helper = result.validated_bundles_by_name[ENTRY].imports[HELPER]
+
+    assert imported_helper.provenance.frontend_kind == "workflow_lisp"
+
+
+def test_lowered_bundle_derived_surfaces_share_workflow_lisp_provenance(tmp_path: Path) -> None:
+    result, _ = _compile_mixed_imports(tmp_path)
+    bundle = result.validated_bundles_by_name[ENTRY]
+
+    kinds = {
+        bundle.surface.provenance.frontend_kind,
+        bundle.core_workflow_ast.provenance.frontend_kind,
+        bundle.ir.provenance.frontend_kind,
+    }
+
+    assert kinds == {"workflow_lisp"}
+
+
+def test_classic_yaml_import_keeps_its_own_provenance(tmp_path: Path) -> None:
+    result, yaml_bundle = _compile_mixed_imports(tmp_path)
+
+    linked = result.validated_bundles_by_name[ENTRY].imports[YAML_ALIAS]
+
+    assert linked.provenance.frontend_kind is None
+
+
+def test_classic_yaml_import_is_linked_as_the_same_object(tmp_path: Path) -> None:
+    result, yaml_bundle = _compile_mixed_imports(tmp_path)
+
+    assert result.validated_bundles_by_name[ENTRY].imports[YAML_ALIAS] is yaml_bundle
+
+
+def test_build_frontend_bundle_keeps_compiler_frontend_kind(tmp_path: Path) -> None:
+    request = build.FrontendBuildRequest(
+        source_path=ENTRYPOINT,
+        source_roots=(SOURCE_ROOT, tmp_path),
+        entry_workflow="orchestrate",
+        provider_externs_path=CLI_FIXTURES / "providers.json",
+        prompt_externs_path=CLI_FIXTURES / "prompts.json",
+        imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+        command_boundaries_path=CLI_FIXTURES / "commands.json",
+        emit_debug_yaml=False,
+        workspace_root=tmp_path,
+    )
+
+    result = build.build_frontend_bundle(request)
+
+    assert result.validated_bundle.provenance.frontend_kind == "workflow_lisp"

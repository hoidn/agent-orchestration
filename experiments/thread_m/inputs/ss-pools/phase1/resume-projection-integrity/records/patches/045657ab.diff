+def _terminal(**overrides) -> dict:
+    progress = {
+        "current_iteration": None,
+        "completed_iterations": [0],
+        "condition_evaluated_for_iteration": 0,
+        "last_condition_result": True,
+    }
+    progress.update(overrides)
+    return progress
+
+
+@pytest.mark.parametrize(
+    ("progress", "frame", "message"),
+    [
+        (_terminal(), {"status": "completed"}, None),
+        (_terminal(exhausted=True), {"status": "completed"}, "condition result conflicts"),
+        (
+            _terminal(completed_iterations=[0, 1, 2, 3], condition_evaluated_for_iteration=3, last_condition_result=False, exhausted=True),
+            {"status": "completed"},
+            None,
+        ),
+        (
+            _terminal(completed_iterations=[0, 1, 2, 3], condition_evaluated_for_iteration=3, last_condition_result=False, exhausted=True),
+            {"status": "failed"},
+            "successful exhaustion requires a completed frame",
+        ),
+        (
+            _terminal(completed_iterations=[0, 1, 2, 3], condition_evaluated_for_iteration=3, last_condition_result=False),
+            {"status": "failed", "error": {"type": "repeat_until_iterations_exhausted"}},
+            None,
+        ),
+        (
+            _terminal(completed_iterations=[0, 1, 2, 3], condition_evaluated_for_iteration=3, last_condition_result=False),
+            {"status": "failed", "error": {"type": "other"}},
+            "failed exhaustion requires the terminal exhaustion error",
+        ),
+    ],
+)
+def test_repeat_until_terminal_forms(bundle, progress, frame, message) -> None:
+    state = {"repeat_until": {"ReviewLoop": progress}, "steps": {"ReviewLoop": frame}}
+
+    if message is None:
+        audit_scope(bundle, state, SCOPE)
+        return
+    error = _audit_error(bundle, state)
+    assert error["context"]["reason"] == "invalid_loop_progress"
+    assert error["context"]["field"] == "repeat_until.ReviewLoop"
+    assert error["context"]["offending_value"] is None
+

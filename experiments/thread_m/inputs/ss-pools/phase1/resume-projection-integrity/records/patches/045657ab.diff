diff --git a/orchestrator/workflow/call_frame_lineage.py b/orchestrator/workflow/call_frame_lineage.py
new file mode 100644
index 0000000..6907151
--- /dev/null
+++ b/orchestrator/workflow/call_frame_lineage.py
@@ -0,0 +1,184 @@
+"""Retry-lineage indexing for the call frames of one call boundary.
+
+Pure functions over persisted ``call_frames`` items; no state, bundle or file access.
+A Workflow Lisp boundary's non-completed frames form one lineage: a base frame id ``B``
+(ordinal 0) and retries ``B::retry::<n>``. Any other boundary has at most one
+non-completed frame. Completed frames are unlimited historical records.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+_KNOWN_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Raised when the frames of one boundary cannot form a consistent lineage."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        frame_id: Optional[str] = None,
+        resumable_count: Optional[int] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.frame_id = frame_id
+        self.resumable_count = resumable_count
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+    frame: Mapping[str, Any]
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    base_frame_id: str = ""
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[CallFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+
+
+def _parse_retry_id(frame_id: str) -> tuple[str, int]:
+    """Return ``(base, ordinal)`` for a lineage member id or raise ``ValueError``."""
+    base, marker, suffix = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return frame_id, 0
+    if not base or RETRY_MARKER in suffix or not suffix.isascii() or not suffix.isdecimal():
+        raise ValueError(frame_id)
+    ordinal = int(suffix)
+    if ordinal < 1 or str(ordinal) != suffix:
+        raise ValueError(frame_id)
+    return base, ordinal
+
+
+def _validated_frames(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+) -> list[tuple[str, Mapping[str, Any]]]:
+    frames: list[tuple[str, Mapping[str, Any]]] = []
+    aliases: set[Any] = set()
+    for frame_id, frame in frame_items:
+        if not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError(
+                "unsupported_shape", f"call frame '{frame_id}' must be a mapping", frame_id=frame_id
+            )
+        if frame.get("status") not in _KNOWN_STATUSES:
+            raise CallFrameRetryLineageError(
+                "unsupported_shape", f"call frame '{frame_id}' has an unknown status", frame_id=frame_id
+            )
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary",
+                f"call frame '{frame_id}' does not belong to the boundary",
+                frame_id=frame_id,
+            )
+        aliases.add(frame.get("import_alias"))
+        frames.append((frame_id, frame))
+    if len(aliases) > 1:
+        raise CallFrameRetryLineageError(
+            "persisted_import_alias_mismatch", "call frames of one boundary use different import aliases"
+        )
+    return frames
+
+
+def _index_plain_boundary(frames: list[tuple[str, Mapping[str, Any]]]) -> CallFrameRetryLineage:
+    completed = tuple(CallFrameMember(i, f) for i, f in frames if f["status"] == "completed")
+    open_frames = [CallFrameMember(i, f) for i, f in frames if f["status"] != "completed"]
+    if len(open_frames) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "boundary has more than one resumable call frame",
+            resumable_count=len(open_frames),
+        )
+    running = open_frames[0] if open_frames else None
+    return CallFrameRetryLineage(running.frame_id if running else None, completed, (), running)
+
+
+def _retry_member(frame_id: str, frame: Mapping[str, Any]) -> RetryFrameMember:
+    try:
+        base, ordinal = _parse_retry_id(frame_id)
+    except ValueError:
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", f"call frame '{frame_id}' has a malformed retry marker", frame_id=frame_id
+        ) from None
+    return RetryFrameMember(frame_id, frame, base_frame_id=base, ordinal=ordinal)
+
+
+def _historical_member(frame_id: str, frame: Mapping[str, Any]) -> CallFrameMember:
+    try:
+        return _retry_member(frame_id, frame)
+    except CallFrameRetryLineageError:
+        return CallFrameMember(frame_id, frame)
+
+
+def _index_retry_boundary(frames: list[tuple[str, Mapping[str, Any]]]) -> CallFrameRetryLineage:
+    completed = tuple(_historical_member(i, f) for i, f in frames if f["status"] == "completed")
+    open_members = [_retry_member(i, f) for i, f in frames if f["status"] != "completed"]
+    if not open_members:
+        return CallFrameRetryLineage(None, completed, (), None)
+    bases = {m.base_frame_id for m in open_members}
+    ordinals = [m.ordinal for m in open_members]
+    running = [m for m in open_members if m.frame["status"] == "running"]
+    if len(bases) > 1 or len(set(ordinals)) != len(ordinals) or len(running) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "boundary retry frames do not form one lineage",
+            resumable_count=len(running) if len(running) > 1 else len(open_members),
+        )
+    base = bases.pop()
+    same_base = {m.ordinal for m in (*open_members, *completed) if getattr(m, "base_frame_id", None) == base}
+    if same_base != set(range(max(same_base) + 1)):
+        raise CallFrameRetryLineageError("unsupported_shape", "boundary retry lineage is missing an ordinal")
+    ordered = sorted(open_members, key=lambda m: m.ordinal)
+    if running and running[0] is not ordered[-1]:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "running retry frame is not the newest member",
+            resumable_count=len(open_members),
+        )
+    failed = tuple(m for m in ordered if m.frame["status"] != "running")
+    return CallFrameRetryLineage(base, completed, failed, running[0] if running else None)
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group the frames of one boundary into a retry lineage; raise on inconsistent input."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    if frontend_kind != WORKFLOW_LISP_FRONTEND_KIND:
+        return _index_plain_boundary(frames)
+    return _index_retry_boundary(frames)
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<n>`` for the lowest unused positive ordinal."""
+    base = lineage.base_frame_id
+    if base is None:
+        raise ValueError("lineage has no base frame id")
+    used = {
+        m.ordinal
+        for m in (*lineage.completed_members, *lineage.failed_predecessors, lineage.running_member)
+        if isinstance(m, RetryFrameMember) and m.base_frame_id == base
+    }
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{base}{RETRY_MARKER}{ordinal}"
diff --git a/orchestrator/workflow/call_resume_selection.py b/orchestrator/workflow/call_resume_selection.py
new file mode 100644
index 0000000..aca502e
--- /dev/null
+++ b/orchestrator/workflow/call_resume_selection.py
@@ -0,0 +1,109 @@
+"""Frame selection for a resumed call step.
+
+Resolves the persisted caller identity against the current parent projection (one
+``resolve_call_boundary`` call), selects the callee bundle by the boundary's current import
+alias, and groups the boundary's frames into a retry lineage. Pure over the bundle and the
+state mapping it is given: no frame, state manager or executor is created here.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping, Optional
+
+from .call_frame_lineage import (
+    WORKFLOW_LISP_FRONTEND_KIND,
+    CallFrameMember,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_import_bundle
+from .resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    integrity_error,
+    lineage_diagnostic,
+    loop_diagnostic_field,
+)
+from .state_projection import ResumeProjectionValidationError
+
+
+class CompletedFrameCollision(Exception):
+    """A completed call frame already occupies the id a resumed call would use."""
+
+
+@dataclass(frozen=True)
+class ResumeCallSelection:
+    callee: Any
+    frame_id: str
+    running: Optional[CallFrameMember]
+    predecessors: tuple[CallFrameMember, ...]
+
+
+def select_resume_call(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    *,
+    step_id: str,
+    visit_frame_id: str,
+    is_workflow_lisp: Callable[[Any], bool],
+) -> ResumeCallSelection:
+    """Select the callee bundle, frame id and lineage for one reached call identity."""
+
+    def fail(reason: str, **kwargs: Any) -> ResumeProjectionIntegrityError:
+        return ResumeProjectionIntegrityError(integrity_error(bundle, state, scope_path, reason, **kwargs))
+
+    projection = bundle.projection
+    try:
+        slot_index = projection.enumerate_resume_slots(state)
+    except ResumeProjectionValidationError as exc:
+        raise fail(exc.reason, field=loop_diagnostic_field(exc.message)) from None
+    resolution = projection.resolve_call_boundary(slot_index, step_id)
+    if resolution.boundary is None:
+        reason = "ambiguous_call_boundary" if resolution.candidate_count > 1 else "missing_call_boundary"
+        raise fail(
+            reason,
+            offending_value=step_id,
+            candidate_count=resolution.candidate_count,
+            call_boundary_step_id=step_id,
+        )
+    alias = resolution.boundary.import_alias
+    callee = workflow_import_bundle(bundle, alias) if isinstance(alias, str) else None
+    if callee is None:

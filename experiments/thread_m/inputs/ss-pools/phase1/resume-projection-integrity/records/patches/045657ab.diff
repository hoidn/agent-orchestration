@@ -0,0 +1,296 @@
+"""Checksum-compatible resume projection-integrity audit.
+
+``audit_scope(bundle, state, scope_path)`` validates every persisted identity of one scope
+(step rows, ``current_step``, loop bookkeeping, call-frame headers and retry lineage) against
+the projection of the bundle that owns that scope, and raises
+``ResumeProjectionIntegrityError`` on the first violation.
+
+Dependencies: only the bundle and state it is given. It loads no workflow or bundle, computes
+no checksum, reads no file and never mutates ``state``. Child call-frame scopes are audited by
+the caller (the call executor) once the callee bundle is selected, not recursively here.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from .call_frame_lineage import (  # noqa: F401  (public re-exports)
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_loop_progress import validate_repeat_until_progress
+from .state_projection import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    WorkflowStateProjection,
+)
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_LOOP_FIELDS = frozenset(
+    {"items", "completed_indices", "current_index", "current_iteration", "completed_iterations", "exhausted"}
+)
+_FRAME_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through the call frames entered."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """A persisted identity is not owned by the current projection; ``.error`` is the diagnostic."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def integrity_error(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    reason: str,
+    *,
+    field: Optional[str] = None,
+    offending_value: Any = None,
+    candidate_count: Optional[int] = None,
+    call_boundary_step_id: Optional[str] = None,
+) -> dict[str, Any]:
+    """Build the stable diagnostic dict; never embeds containers or state contents."""
+    provenance = workflow_provenance(bundle)
+    workflow_path = getattr(provenance, "workflow_path", None)
+    return {
+        "type": ERROR_TYPE,
+        "message": f"Resume projection integrity audit failed: {reason}",
+        "context": {
+            "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+            "reason": reason,
+            "scope_path": scope_path.as_context(),
+            "field": field,
+            "offending_value": _scalar(offending_value),
+            "expected_owner": {
+                "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                "workflow_checksum": state.get("workflow_checksum"),
+                "projection_scope": scope_path.projection_scope,
+            },
+            "candidate_count": candidate_count,
+            "call_boundary_step_id": call_boundary_step_id,
+        },
+    }
+
+
+class _Auditor:
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+
+    def fail(self, reason: str, **kwargs: Any) -> ResumeProjectionIntegrityError:
+        return ResumeProjectionIntegrityError(
+            integrity_error(self.bundle, self.state, self.scope_path, reason, **kwargs)
+        )
+
+    def run(self) -> None:
+        projection = getattr(self.bundle, "projection", None)
+        if not isinstance(projection, WorkflowStateProjection):
+            return  # not a loaded bundle: there is no projection to own any identity
+        for key in ("steps", "call_frames"):
+            if key in self.state and not isinstance(self.state[key], Mapping):
+                raise self.fail("unsupported_shape", field=key)
+        try:
+            slot_index = projection.enumerate_resume_slots(self.state)
+            validate_repeat_until_progress(self.state, self.declared_max_iterations(projection))
+        except ResumeProjectionValidationError as exc:
+            raise self.fail(exc.reason, field=loop_diagnostic_field(exc.message)) from None
+        self.projection = projection
+        self.slot_index = slot_index
+        self.audit_steps()
+        self.audit_current_step()
+        self.audit_call_frames()
+
+    def declared_max_iterations(self, projection: WorkflowStateProjection) -> dict[str, Optional[int]]:
+        """Map each repeat_until frame key to the declared ``max_iterations`` of the bundle's IR."""
+        nodes = getattr(getattr(self.bundle, "ir", None), "nodes", {})
+        return {
+            loop.frame_key: getattr(nodes.get(node_id), "max_iterations", None)
+            for node_id, loop in projection.repeat_until_nodes.items()
+        }
+
+    def step_id_value(self, field: str, value: Any) -> str:
+        if not isinstance(value, str) or not value:
+            raise self.fail("unsupported_shape", field=field, offending_value=value)
+        return value
+
+    def audit_steps(self) -> None:
+        for name, row in (self.state.get("steps") or {}).items():
+            if isinstance(row, list):
+                continue
+            field = f"steps.{name}.step_id"
+            if not isinstance(row, Mapping):
+                raise self.fail("unsupported_shape", field=f"steps.{name}")
+            if "step_id" not in row:
+                continue
+            step_id = self.step_id_value(field, row["step_id"])
+            if name not in self.slot_index.owned_presentation_keys:
+                raise self.fail("unclaimed_explicit_step_row", field=field, offending_value=step_id, candidate_count=0)
+            resolution = self.projection.resolve_resume_step_id(self.slot_index, step_id, name)
+            if resolution.candidate_count == 0:
+                raise self.fail("unknown_explicit_step_id", field=field, offending_value=step_id, candidate_count=0)
+            if resolution.slot is None:
+                raise self.fail(
+                    "presentation_slot_mismatch",
+                    field=field,
+                    offending_value=step_id,
+                    candidate_count=resolution.candidate_count,
+                )
+
+    def audit_current_step(self) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            raise self.fail("unsupported_shape", field="current_step")
+        field = "current_step.step_id"
+        if current.get("step_id") is None:
+            raise self.fail("missing_required_identity", field=field)
+        step_id = self.step_id_value(field, current["step_id"])
+        name = current.get("name")
+        resolution = self.projection.resolve_resume_step_id(
+            self.slot_index, step_id, name if isinstance(name, str) else None
+        )
+        if resolution.candidate_count == 0:
+            raise self.fail("out_of_scope_step_id", field=field, offending_value=step_id, candidate_count=0)
+        if resolution.slot is None:
+            raise self.fail(
+                "presentation_slot_mismatch",
+                field=field,
+                offending_value=step_id,
+                candidate_count=resolution.candidate_count,
+            )
+
+    def audit_call_frames(self) -> None:
+        frames = self.state.get("call_frames") or {}
+        by_boundary: dict[str, list[tuple[str, Mapping[str, Any]]]] = {}
+        for frame_id, frame in frames.items():
+            if not isinstance(frame, Mapping):
+                raise self.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+            if frame.get("status") not in _FRAME_STATUSES:
+                raise self.fail(
+                    "unsupported_shape", field=f"call_frames.{frame_id}.status", offending_value=frame.get("status")
+                )
+            boundary_id = self.audit_frame_header(frame_id, frame)
+            by_boundary.setdefault(boundary_id, []).append((frame_id, frame))
+        for boundary_id, items in by_boundary.items():
+            self.audit_lineage(boundary_id, items)
+
+    def audit_frame_header(self, frame_id: str, frame: Mapping[str, Any]) -> str:
+        field = f"call_frames.{frame_id}.call_step_id"
+        if frame.get("call_step_id") is None:
+            raise self.fail("missing_required_identity", field=field)
+        call_step_id = self.step_id_value(field, frame["call_step_id"])
+        if self.projection.resolve_resume_step_id(self.slot_index, call_step_id).candidate_count == 0:
+            raise self.fail("out_of_scope_step_id", field=field, offending_value=call_step_id, candidate_count=0)
+        owners = self.slot_index.call_boundaries_by_step_id.get(call_step_id, ())
+        if len(owners) != 1:
+            reason = "missing_call_boundary" if not owners else "ambiguous_call_boundary"
+            raise self.fail(
+                reason,
+                field=field,
+                offending_value=call_step_id,
+                candidate_count=len(owners),
+                call_boundary_step_id=call_step_id,
+            )
+        self.audit_frame_alias(frame_id, frame, owners[0].import_alias)
+        return call_step_id
+
+    def audit_frame_alias(self, frame_id: str, frame: Mapping[str, Any], alias: Optional[str]) -> None:
+        persisted = frame.get("import_alias")
+        if persisted != alias or not isinstance(alias, str):
+            raise self.fail(
+                "persisted_import_alias_mismatch",
+                field=f"call_frames.{frame_id}.import_alias",
+                offending_value=persisted,
+                candidate_count=1,
+                call_boundary_step_id=frame.get("call_step_id") if isinstance(frame.get("call_step_id"), str) else None,
+            )
+        if workflow_import_bundle(self.bundle, alias) is None:
+            raise self.fail("missing_imported_bundle", field=f"imports.{alias}", offending_value=alias, candidate_count=1)
+
+    def audit_lineage(self, boundary_id: str, items: list[tuple[str, Mapping[str, Any]]]) -> None:
+        alias = items[0][1].get("import_alias")
+        provenance = workflow_provenance(workflow_import_bundle(self.bundle, alias))
+        try:
+            index_retry_lineage(
+                boundary_id, items, frontend_kind=getattr(provenance, "frontend_kind", None)
+            )
+        except CallFrameRetryLineageError as exc:
+            diagnostic = lineage_diagnostic(self.bundle, self.state, self.scope_path, exc, boundary_id)
+            raise ResumeProjectionIntegrityError(diagnostic) from None
+
+
+def lineage_diagnostic(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    exc: CallFrameRetryLineageError,
+    boundary_id: str,
+) -> dict[str, Any]:
+    """Map a lineage error to the stable diagnostic."""
+    if exc.reason == "ambiguous_resumable_call_frame":
+        return integrity_error(
+            bundle,
+            state,
+            scope_path,
+            exc.reason,
+            field="call_frames",
+            offending_value=exc.resumable_count,
+            candidate_count=exc.resumable_count,
+            call_boundary_step_id=boundary_id,
+        )
+    field = f"call_frames.{exc.frame_id}" if exc.frame_id else "call_frames"
+    return integrity_error(bundle, state, scope_path, exc.reason, field=field, call_boundary_step_id=boundary_id)
+
+
+def loop_diagnostic_field(message: str) -> str:
+    parts = message.split(" ", 1)[0].split(".")
+    keep = 3 if len(parts) >= 3 and parts[2] in _LOOP_FIELDS else min(len(parts), 2)
+    return ".".join(parts[:keep])
+
+
+def audit_scope(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against ``bundle``'s projection."""
+    _Auditor(bundle, state, scope_path).run()

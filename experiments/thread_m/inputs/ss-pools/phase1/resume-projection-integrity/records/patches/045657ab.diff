index 0000000..71feb12
--- /dev/null
+++ b/tests/test_loader_import_aliases.py
@@ -0,0 +1,150 @@
+"""Duplicate classic-YAML import aliases are rejected before bundle construction."""
+
+from pathlib import Path
+import textwrap
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Echo
+    id: echo
+    command: ["bash", "-lc", "true"]
+"""
+
+STEPS = """\
+steps:
+  - name: Hello
+    id: hello
+    command: ["bash", "-lc", "true"]
+"""
+
+
+def _write(tmp_path: Path, body: str) -> Path:
+    (tmp_path / "lib").mkdir(exist_ok=True)
+    for name in ("a", "b"):
+        (tmp_path / "lib" / f"{name}.yaml").write_text(LIBRARY)
+    path = tmp_path / "workflow.yaml"
+    path.write_text('version: "2.5"\nname: caller\n' + textwrap.dedent(body) + STEPS)
+    return path
+
+
+def _load_errors(tmp_path: Path, body: str, monkeypatch: pytest.MonkeyPatch) -> list[str]:
+    def _unreachable(*args, **kwargs):
+        raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _unreachable)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(tmp_path).load(_write(tmp_path, body))
+    return [str(err.message) for err in excinfo.value.errors]
+
+
+# Lines: 1 version, 2 name, body starts at line 3.
+DUPLICATE_ALIAS_CASES = {
+    "same_mapping": (
+        """\
+        imports:
+          a: lib/a.yaml
+          a: lib/b.yaml
+        """,
+        "imports.a: duplicate import alias at line 4, column 3; line 5, column 3",
+    ),
+    "merge_inside_imports": (
+        """\
+        base: &base
+          a: lib/a.yaml
+        imports:
+          <<: *base
+          a: lib/b.yaml
+        """,
+        "imports.a: duplicate import alias at line 4, column 3; line 7, column 3",
+    ),
+    "repeated_sections": (
+        """\
+        imports:
+          a: lib/a.yaml
+        imports:
+          a: lib/b.yaml
+        """,
+        "imports.a: duplicate import alias at line 4, column 3; line 6, column 3",
+    ),
+    "top_level_merge_sources": (
+        """\
+        x: &x
+          imports:
+            a: lib/a.yaml
+        y: &y
+          imports:
+            a: lib/b.yaml
+        <<: [*x, *y]
+        """,
+        "imports.a: duplicate import alias at line 5, column 5; line 8, column 5",
+    ),
+}
+
+
+@pytest.mark.parametrize("case", sorted(DUPLICATE_ALIAS_CASES))
+def test_duplicate_import_alias_reported_once_with_positions(tmp_path, monkeypatch, case):
+    body, expected = DUPLICATE_ALIAS_CASES[case]
+    errors = _load_errors(tmp_path, body, monkeypatch)
+    assert [e for e in errors if e.startswith("imports")] == [expected]
+
+
+DUPLICATE_SECTION_CASES = {
+    "direct": (
+        """\
+        imports:
+          a: lib/a.yaml
+        imports:
+          b: lib/b.yaml
+        """,
+        "imports: duplicate top-level mapping at line 3, column 1; line 5, column 1",
+    ),
+    "merged_and_explicit": (
+        """\
+        x: &x
+          imports:
+            a: lib/a.yaml
+        <<: *x
+        imports:
+          b: lib/b.yaml
+        """,
+        "imports: duplicate top-level mapping at line 4, column 3; line 7, column 1",
+    ),
+}
+
+
+@pytest.mark.parametrize("case", sorted(DUPLICATE_SECTION_CASES))
+def test_distinct_aliases_in_repeated_sections_reported_as_duplicate_mapping(
+    tmp_path, monkeypatch, case
+):
+    body, expected = DUPLICATE_SECTION_CASES[case]
+    errors = _load_errors(tmp_path, body, monkeypatch)
+    assert [e for e in errors if e.startswith("imports")] == [expected]
+
+
+SINGLE_MERGED_CASES = {
+    "merge_inside_imports": """\
+        imports:
+          <<: {a: lib/a.yaml}
+          b: lib/b.yaml
+        """,
+    "top_level_merge_source": """\

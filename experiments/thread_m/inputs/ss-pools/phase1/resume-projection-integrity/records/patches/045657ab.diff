+++ b/orchestrator/observability/forensic_state.py
@@ -0,0 +1,21 @@
+"""Forensic interpretation of a ``current_step`` left behind by a resume failure envelope."""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+FORENSIC_ERROR_TYPES = frozenset({"resume_projection_integrity_error", "workflow_checksum_mismatch"})
+
+
+def has_forensic_current_step(state: Mapping[str, Any]) -> bool:
+    """True when ``current_step`` is unchanged forensic data, not a live step.
+
+    The resume failure envelopes change only status, error and updated_at, so the
+    step that was running when the previous executor died stays recorded.
+    """
+    error = state.get("error")
+    return (
+        isinstance(state.get("current_step"), Mapping)
+        and isinstance(error, Mapping)
+        and error.get("type") in FORENSIC_ERROR_TYPES
+    )

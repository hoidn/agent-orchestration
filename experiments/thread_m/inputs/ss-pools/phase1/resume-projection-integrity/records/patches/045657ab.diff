+"""Loop bookkeeping integrity checks for checksum-compatible resume.
+
+Pure functions over persisted ``for_each`` / ``repeat_until`` progress mappings.
+Dependencies: none beyond the standard library; callers pass the persisted state
+mapping and, optionally, the declared ``max_iterations`` per repeat_until frame key.
+Nothing here mutates its input.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Raised when persisted resume bookkeeping violates the projection contract."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _shape(message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message)
+
+
+def _progress(message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message)
+
+
+def _section(state: Mapping[str, Any], key: str) -> Mapping[str, Any]:
+    section = state.get(key)
+    if section is None and key not in state:
+        return {}
+    if not isinstance(section, Mapping):
+        raise _shape(f"{key} must be a mapping")
+    return section
+
+
+def validate_for_each_progress(state: Mapping[str, Any]) -> dict[str, tuple[int, ...]]:
+    """Validate ``for_each`` bookkeeping; return the valid iteration indices per loop name."""
+    indices: dict[str, tuple[int, ...]] = {}
+    for name, progress in _section(state, "for_each").items():
+        label = f"for_each.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{label} must be a mapping")
+        items = progress.get("items")
+        if not isinstance(items, list):
+            raise _shape(f"{label}.items must be a list")
+        current = progress.get("current_index")
+        if current is not None and not _is_int(current):
+            raise _shape(f"{label}.current_index must be null or a non-boolean integer")
+        completed = progress.get("completed_indices", [])
+        if not isinstance(completed, list):
+            raise _shape(f"{label}.completed_indices must be a list")
+        if len(set(map(repr, completed))) != len(completed):
+            raise _progress(f"{label}.completed_indices must not contain duplicate indices")
+        if not all(_is_index(i) and i < len(items) for i in completed):
+            raise _progress(f"{label}.completed_indices contains an out-of-range index")
+        if current is not None:
+            if not 0 <= current < len(items):
+                raise _progress(f"{label}.current_index is out of range")
+            if current in completed:
+                raise _progress(f"{label}.current_index is already completed")
+        indices[str(name)] = tuple(range(len(items)))
+    return indices
+
+
+def _check_active(label: str, progress: Mapping[str, Any], current: int, completed: list[int]) -> None:
+    if current < 0:
+        raise _progress(f"{label}.current_iteration is out of range")
+    if any(i >= current for i in completed):
+        raise _progress(f"{label}.completed_iterations is not valid prior history")
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if evaluated is None:
+        consistent = result is None
+    else:
+        consistent = evaluated == current and _is_int(evaluated) and isinstance(result, bool)
+    if not consistent:
+        raise _progress(f"{label}.condition result conflicts with evaluation state")
+
+
+def _check_terminal(
+    label: str,
+    progress: Mapping[str, Any],
+    completed: list[int],
+    frame: Any,
+    max_iterations: Optional[int],
+) -> None:
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if not completed or not _is_int(evaluated) or evaluated != max(completed):
+        raise _progress(f"{label}.terminal progress requires completed evaluated history")
+    exhausted = progress.get("exhausted", False)
+    if result is True:
+        if exhausted:
+            raise _progress(f"{label}.condition result conflicts with evaluation state")
+        return
+    if result is not False:
+        raise _progress(f"{label}.condition result conflicts with evaluation state")
+    if max_iterations is not None and sorted(completed) != list(range(max_iterations)):
+        raise _progress(f"{label}.terminal progress requires completed evaluated history")
+    frame = frame if isinstance(frame, Mapping) else {}
+    if exhausted:
+        if frame.get("status") != "completed":
+            raise _progress(f"{label}.successful exhaustion requires a completed frame")
+        return
+    error = frame.get("error")
+    if (
+        frame.get("status") != "failed"
+        or not isinstance(error, Mapping)
+        or error.get("type") != EXHAUSTION_ERROR_TYPE
+    ):
+        raise _progress(f"{label}.failed exhaustion requires the terminal exhaustion error")
+
+
+def validate_repeat_until_progress(
+    state: Mapping[str, Any],
+    max_iterations_by_frame_key: Mapping[str, Optional[int]],
+) -> dict[str, tuple[int, ...]]:
+    """Validate ``repeat_until`` bookkeeping; return the valid iteration indices per frame key."""
+    steps = state.get("steps")
+    steps = steps if isinstance(steps, Mapping) else {}
+    indices: dict[str, tuple[int, ...]] = {}
+    for name, progress in _section(state, "repeat_until").items():
+        label = f"repeat_until.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{label} must be a mapping")
+        current = progress.get("current_iteration")
+        if current is not None and not _is_int(current):
+            raise _shape(f"{label}.current_iteration must be null or a non-boolean integer")
+        if "exhausted" in progress and not isinstance(progress["exhausted"], bool):
+            raise _shape(f"{label}.exhausted must be boolean when present")
+        completed = progress.get("completed_iterations", [])
+        if not isinstance(completed, list):
+            raise _progress(f"{label}.completed_iterations is not valid prior history")
+        if len(set(map(repr, completed))) != len(completed):
+            raise _progress(f"{label}.completed_iterations must not contain duplicate indices")
+        if not all(_is_index(i) for i in completed):
+            raise _progress(f"{label}.completed_iterations is not valid prior history")
+        max_iterations = max_iterations_by_frame_key.get(str(name))
+        if current is not None and max_iterations is not None and current >= max_iterations:
+            raise _progress(f"{label}.current_iteration is out of range")
+        if current is None:
+            _check_terminal(label, progress, completed, steps.get(name), max_iterations)
+        else:
+            _check_active(label, progress, current, completed)
+        known = set(completed)
+        if current is not None:
+            known.add(current)
+        indices[str(name)] = tuple(sorted(known))
+    return indices

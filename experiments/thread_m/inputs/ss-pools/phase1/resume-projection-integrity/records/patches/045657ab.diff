--- /dev/null
+++ b/orchestrator/workflow/resume_root_checksum.py
@@ -0,0 +1,39 @@
+"""Authoritative root checksum recheck for a structurally root resumed executor."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+from .call_frame_state import _display_workflow_path
+from .loaded_bundle import workflow_provenance
+
+
+def root_checksum_mismatch(
+    bundle: Any,
+    state: Mapping[str, Any],
+    state_manager: Any,
+    workspace: Path,
+) -> Optional[dict[str, Optional[str]]]:
+    """Return ``record_workflow_checksum_mismatch`` kwargs when the checksum no longer matches.
+
+    The current checksum is computed through ``state_manager.calculate_checksum``.
+    Returns None when the recorded checksum still matches the bundle's workflow file.
+    """
+    provenance = workflow_provenance(bundle)
+    workflow_path = getattr(provenance, "workflow_path", None)
+    persisted = state.get("workflow_checksum")
+    persisted = persisted if isinstance(persisted, str) else None
+    workflow_file = _display_workflow_path(workspace, workflow_path) if workflow_path is not None else None
+    envelope = {"workflow_file": workflow_file, "persisted_checksum": persisted, "current_checksum": None}
+    if persisted is None or not persisted.startswith("sha256:"):
+        return {**envelope, "reason": "missing_recorded_checksum"}
+    if workflow_path is None:
+        return {**envelope, "reason": "missing_workflow_path"}
+    try:
+        current = state_manager.calculate_checksum(Path(workflow_path))
+    except FileNotFoundError:
+        return {**envelope, "reason": "workflow_unavailable"}
+    if current != persisted:
+        return {**envelope, "current_checksum": current, "reason": "workflow_modified"}
+    return None

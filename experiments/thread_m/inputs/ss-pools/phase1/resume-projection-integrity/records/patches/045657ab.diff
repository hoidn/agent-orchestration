+"""Behavioural tests for checksum-compatible resume projection-integrity auditing."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+from orchestrator.state import StateManager
+from orchestrator.workflow.call_frame_lineage import (
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.finalization import FinalizationController
+from orchestrator.workflow.resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+)
+from orchestrator.workflow.state_projection import ResumeProjectionValidationError
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.test_workflow_state_projection import _write_projection_call_workflow, _write_projection_workflow
+from tests.workflow_bundle_helpers import bundle_context_dict, materialize_projection_body_steps
+
+SCOPE = ResumeScopePath.root("workflow.yaml")
+PROJECTION_ERROR = "resume_projection_integrity_error"
+
+
+@pytest.fixture
+def bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_workflow(tmp_path))
+
+
+def _audit_error(bundle, state, scope=SCOPE) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        audit_scope(bundle, state, scope)
+    return exc_info.value.error
+
+
+def _row(name: str, step_id: str | None) -> dict:
+    row = {"status": "completed", "name": name}
+    if step_id is not None:
+        row["step_id"] = step_id
+    return row
+
+
+# --- explicit identities -----------------------------------------------------------------
+
+
+def test_valid_state_passes_and_is_not_mutated(bundle) -> None:
+    state = {
+        "workflow_checksum": "sha256:x",
+        "steps": {"SetReady": _row("SetReady", "root.set_ready")},
+        "current_step": {"name": "SetReady", "step_id": "root.set_ready", "status": "running"},
+    }
+    before = copy.deepcopy(state)
+
+    audit_scope(bundle, state, SCOPE)
+
+    assert state == before
+
+
+def test_absent_step_id_stays_compatible_for_every_status(bundle) -> None:
+    state = {
+        "steps": {
+            "SetReady": {"status": "failed", "name": "SetReady"},
+            "RouteReady": {"status": "running", "name": "RouteReady"},
+            "ProcessItems": [{"status": "completed"}],
+        }
+    }
+
+    audit_scope(bundle, state, SCOPE)
+
+    assert "step_id" not in state["steps"]["SetReady"]
+
+
+@pytest.mark.parametrize(
+    ("row_name", "step_id", "reason", "count"),
+    [
+        ("SetReady", "root.removed", "unknown_explicit_step_id", 0),
+        ("SetReady", "root.route_ready", "presentation_slot_mismatch", 1),
+        ("RenamedAway", "root.set_ready", "unclaimed_explicit_step_row", 0),
+    ],
+)
+def test_step_row_identity_failures(bundle, row_name, step_id, reason, count) -> None:
+    error = _audit_error(bundle, {"steps": {row_name: _row(row_name, step_id)}})
+
+    context = error["context"]
+    assert error["type"] == PROJECTION_ERROR
+    assert error["message"] == f"Resume projection integrity audit failed: {reason}"
+    assert context["reason"] == reason
+    assert context["field"] == f"steps.{row_name}.step_id"

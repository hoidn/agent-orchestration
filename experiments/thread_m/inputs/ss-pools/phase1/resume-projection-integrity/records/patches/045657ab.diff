diff --git a/orchestrator/import_alias_checks.py b/orchestrator/import_alias_checks.py
new file mode 100644
index 0000000..023dec0
--- /dev/null
+++ b/orchestrator/import_alias_checks.py
@@ -0,0 +1,86 @@
+"""Detect duplicate classic-YAML import aliases on the composed YAML node graph.
+
+PyYAML construction silently keeps the last value for repeated keys and merges
+``<<`` sources, so duplicates must be found on ``yaml.compose`` output where
+key positions (``start_mark``) are still available.
+"""
+
+from typing import Dict, List
+
+import yaml
+from yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+
+def _position(node: Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _merge_sources(value: Node) -> List[MappingNode]:
+    if isinstance(value, MappingNode):
+        return [value]
+    if isinstance(value, SequenceNode):
+        return [item for item in value.value if isinstance(item, MappingNode)]
+    return []
+
+
+def _keys_named(mapping: MappingNode, name: str) -> List[tuple]:
+    """Return (key_node, value_node) pairs for ``name``, following ``<<`` merges."""
+    found = []
+    for key, value in mapping.value:
+        if not isinstance(key, ScalarNode):
+            continue
+        if key.value == "<<":
+            for source in _merge_sources(value):
+                found.extend(_keys_named(source, name))
+        elif key.value == name:
+            found.append((key, value))
+    return found
+
+
+def _alias_keys(section: Node) -> List[ScalarNode]:
+    """Return every alias key node of one imports mapping, following ``<<`` merges."""
+    if not isinstance(section, MappingNode):
+        return []
+    keys: List[ScalarNode] = []
+    for key, value in section.value:
+        if not isinstance(key, ScalarNode):
+            continue
+        if key.value == "<<":
+            for source in _merge_sources(value):
+                keys.extend(_alias_keys(source))
+        else:
+            keys.append(key)
+    return keys
+
+
+def duplicate_import_errors(text: str, loader_cls: type) -> List[str]:
+    """Return duplicate-alias / duplicate-section messages for workflow ``text``.
+
+    Returns ``[]`` when the document does not compose into a mapping; YAML
+    syntax errors are left for the regular load path to report.
+    """
+    try:
+        root = yaml.compose(text, Loader=loader_cls)
+    except yaml.YAMLError:
+        return []
+    if not isinstance(root, MappingNode):
+        return []
+
+    sections = _keys_named(root, "imports")
+    occurrences: Dict[str, List[ScalarNode]] = {}
+    for _, section in sections:
+        for key in _alias_keys(section):
+            occurrences.setdefault(key.value, []).append(key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias at "
+        + "; ".join(_position(key) for key in keys)
+        for alias, keys in occurrences.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping at "
+            + "; ".join(_position(key) for key, _ in sections)
+        )
+    return errors

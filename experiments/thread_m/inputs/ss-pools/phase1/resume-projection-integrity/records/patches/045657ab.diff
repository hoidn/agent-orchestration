+def _slots(bundle, state):
+    return bundle.projection.enumerate_resume_slots(state)
+
+
+@pytest.mark.parametrize(
+    ("state", "reason", "message"),
+    [
+        ({"for_each": []}, "unsupported_shape", "for_each must be a mapping"),
+        ({"for_each": {"ProcessItems": []}}, "unsupported_shape", "for_each.ProcessItems must be a mapping"),
+        (
+            {"for_each": {"ProcessItems": {"items": "x"}}},
+            "unsupported_shape",
+            "for_each.ProcessItems.items must be a list",
+        ),
+        (
+            {"for_each": {"ProcessItems": {"items": [1], "current_index": True}}},
+            "unsupported_shape",
+            "for_each.ProcessItems.current_index must be null or a non-boolean integer",
+        ),
+        (
+            {"for_each": {"ProcessItems": {"items": [1, 2], "completed_indices": [0, 0]}}},
+            "invalid_loop_progress",
+            "for_each.ProcessItems.completed_indices must not contain duplicate indices",
+        ),
+        (
+            {"for_each": {"ProcessItems": {"items": [1], "completed_indices": [True]}}},
+            "invalid_loop_progress",
+            "for_each.ProcessItems.completed_indices contains an out-of-range index",
+        ),
+        (
+            {"for_each": {"ProcessItems": {"items": [1, 2], "completed_indices": [0], "current_index": 0}}},
+            "invalid_loop_progress",
+            "for_each.ProcessItems.current_index is already completed",
+        ),
+        ({"repeat_until": []}, "unsupported_shape", "repeat_until must be a mapping"),
+        (
+            {"repeat_until": {"ReviewLoop": {"current_iteration": "1"}}},
+            "unsupported_shape",
+            "repeat_until.ReviewLoop.current_iteration must be null or a non-boolean integer",
+        ),
+        (
+            {"repeat_until": {"ReviewLoop": {"current_iteration": 0, "exhausted": 1}}},
+            "unsupported_shape",
+            "repeat_until.ReviewLoop.exhausted must be boolean when present",
+        ),
+        (
+            {"repeat_until": {"ReviewLoop": {"current_iteration": 0, "completed_iterations": [0]}}},
+            "invalid_loop_progress",
+            "repeat_until.ReviewLoop.completed_iterations is not valid prior history",
+        ),
+        (
+            {"repeat_until": {"ReviewLoop": {"current_iteration": 0, "last_condition_result": True}}},
+            "invalid_loop_progress",
+            "repeat_until.ReviewLoop.condition result conflicts with evaluation state",
+        ),
+        (
+            {"repeat_until": {"ReviewLoop": {"current_iteration": None, "completed_iterations": []}}},
+            "invalid_loop_progress",
+            "repeat_until.ReviewLoop.terminal progress requires completed evaluated history",
+        ),
+    ],
+)
+def test_enumerate_resume_slots_rejects_invalid_loop_bookkeeping(bundle, state, reason, message) -> None:
+    with pytest.raises(ResumeProjectionValidationError) as exc_info:
+        _slots(bundle, state)
+
+    assert exc_info.value.reason == reason
+    assert exc_info.value.message == message
+    assert str(exc_info.value) == message

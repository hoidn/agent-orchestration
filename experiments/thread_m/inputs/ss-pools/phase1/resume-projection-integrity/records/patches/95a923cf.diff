diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..bc0d549
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,192 @@
+"""Audit one persisted resume scope against the current workflow projection.
+
+``audit_scope(bundle, state, scope_path)`` reads nothing but the bundle and the raw state dict it
+is given: it loads no workflow or bundle, computes no checksum, reads no file and never mutates the
+state. A failure raises ``ResumeProjectionIntegrityError`` whose ``.error`` is the stable
+``resume_projection_integrity_error`` diagnostic (schema v1); only identities, scalar offending
+values and counts appear in it, never state contents.
+
+Every persisted identity field must be registered here (and in the design) to be audited.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Mapping, NoReturn, Optional
+
+from .call_frame_lineage import (  # re-exported for callers
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .executable_ir import RepeatUntilFrameNode
+from .loaded_bundle import workflow_provenance
+from .resume_slots import ResumeProjectionValidationError
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_LOOP_FIELDS = frozenset(
+    {"items", "current_index", "completed_indices", "current_iteration", "completed_iterations", "exhausted"}
+)
+
+__all__ = [
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "audit_scope",
+    "has_forensic_current_step",
+    "index_retry_lineage",
+    "next_unused_retry_frame_id",
+    "projection_error_of",
+    "repeat_until_maximums",
+]
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through the call frames entered."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = field(default=())
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, Any]]:
+        return [{"kind": "root", "workflow_file": self.root_workflow_file}] + [
+            {"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Audit failure; ``.error`` is the persisted-diagnostic dict."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+FORENSIC_ERROR_TYPES = frozenset({ERROR_TYPE, "workflow_checksum_mismatch"})
+
+
+def has_forensic_current_step(state: Any) -> bool:
+    """True for a failed run whose resume envelope left ``current_step`` unchanged.
+
+    That step never started running in the failed attempt, so reports and monitors must not
+    show it as live or heartbeating.
+    """
+    if not isinstance(state, Mapping) or state.get("status") != "failed":
+        return False
+    error = state.get("error")
+    return (
+        isinstance(error, Mapping)
+        and error.get("type") in FORENSIC_ERROR_TYPES
+        and isinstance(state.get("current_step"), Mapping)
+    )
+
+
+def projection_error_of(result: Any) -> Optional[dict[str, Any]]:
+    """Return the diagnostic dict when ``result`` failed with a projection integrity error."""
+    error = result.get("error") if isinstance(result, Mapping) else None
+    if isinstance(error, Mapping) and error.get("type") == ERROR_TYPE:
+        return error  # type: ignore[return-value]
+    return None
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def _lookup(state: Mapping[str, Any], dotted: str) -> Any:
+    node: Any = state
+    for part in dotted.split("."):
+        node = node.get(part) if isinstance(node, Mapping) else None
+    return node
+
+
+def repeat_until_maximums(bundle: Any) -> dict[str, int]:
+    """Declared ``max_iterations`` by loop frame key, from the bundle's executable IR."""
+    nodes = getattr(bundle.ir, "nodes", {})
+    return {
+        node.presentation_name: node.max_iterations
+        for node in nodes.values()
+        if isinstance(node, RepeatUntilFrameNode) and isinstance(node.max_iterations, int)
+    }
+
+
+class ScopeAudit:
+    """One scope's audit context: builds diagnostics and raises them."""
+
+    def __init__(self, bundle: Any, state: Any, path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state if isinstance(state, Mapping) else {}
+        self.path = path
+        self.projection = bundle.projection
+        self.raw_state = state
+
+    def fail(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+        count: Optional[int] = None,
+        boundary: Optional[str] = None,
+    ) -> NoReturn:
+        provenance = workflow_provenance(self.bundle)
+        workflow_path = getattr(provenance, "workflow_path", None)
+        checksum = self.state.get("workflow_checksum")
+        raise ResumeProjectionIntegrityError(
+            {
+                "type": ERROR_TYPE,
+                "message": f"Resume projection integrity audit failed: {reason}",
+                "context": {
+                    "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                    "reason": reason,
+                    "scope_path": self.path.as_context(),
+                    "field": field,
+                    "offending_value": _scalar(value),
+                    "expected_owner": {
+                        "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                        "workflow_checksum": checksum if isinstance(checksum, str) else None,
+                        "projection_scope": self.path.projection_scope,
+                    },
+                    "candidate_count": count,
+                    "call_boundary_step_id": boundary if isinstance(boundary, str) else None,
+                },
+            }
+        )
+
+    def repeat_until_maximums(self) -> dict[str, int]:
+        return repeat_until_maximums(self.bundle)
+
+    def slot_index(self):
+        try:
+            return self.projection.enumerate_resume_slots(
+                self.state, repeat_until_maximums=self.repeat_until_maximums()
+            )
+        except ResumeProjectionValidationError as exc:
+            dotted = exc.field
+            head, _, last = dotted.rpartition(".")
+            dotted = dotted if last in _LOOP_FIELDS or not head or "." not in head else head
+            self.fail(exc.reason, field=dotted, value=_lookup(self.state, dotted))
+
+
+def audit_scope(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against ``bundle``'s projection; raise on failure."""
+    from .resume_scope_checks import check_scope
+
+    check_scope(ScopeAudit(bundle, state, scope_path))
diff --git a/orchestrator/workflow/resume_root_guard.py b/orchestrator/workflow/resume_root_guard.py
new file mode 100644
index 0000000..6f5163a
--- /dev/null
+++ b/orchestrator/workflow/resume_root_guard.py
@@ -0,0 +1,37 @@
+"""Root checksum recheck for a structurally-root resumed executor.
+
+Dependencies: ``StateManager.calculate_checksum`` (reads the workflow file), the raw persisted
+state dict and the current entry bundle's provenance. It writes nothing.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+from .loaded_bundle import workflow_provenance
+
+
+def classify_root_checksum(
+    state_manager: Any, raw_state: Mapping[str, Any], bundle: Any
+) -> Optional[dict[str, Optional[str]]]:
+    """Return the checksum-mismatch context, or None when the recorded checksum still matches."""
+    workflow_file = raw_state.get("workflow_file")
+    persisted = raw_state.get("workflow_checksum")
+    context: dict[str, Optional[str]] = {
+        "workflow_file": workflow_file if isinstance(workflow_file, str) else None,
+        "persisted_checksum": persisted if isinstance(persisted, str) else None,
+        "current_checksum": None,
+    }
+    if not isinstance(persisted, str) or not persisted.startswith("sha256:"):
+        return {**context, "reason": "missing_recorded_checksum"}
+    workflow_path = getattr(workflow_provenance(bundle), "workflow_path", None)
+    if workflow_path is None:
+        return {**context, "reason": "missing_workflow_path"}
+    try:
+        current = state_manager.calculate_checksum(Path(workflow_path))
+    except FileNotFoundError:
+        return {**context, "reason": "workflow_unavailable"}
+    if current != persisted:
+        return {**context, "current_checksum": current, "reason": "workflow_modified"}
+    return None
diff --git a/orchestrator/workflow/resume_scope_checks.py b/orchestrator/workflow/resume_scope_checks.py
new file mode 100644
index 0000000..ab895bc
--- /dev/null
+++ b/orchestrator/workflow/resume_scope_checks.py
@@ -0,0 +1,197 @@
+"""Ordered identity checks for one audited scope (see ``resume_projection_integrity``)."""
+
+from __future__ import annotations
+
+from pathlib import PurePath
+from types import SimpleNamespace
+from typing import Any, Mapping
+
+from .call_frame_lineage import FRAME_STATUSES
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_projection_integrity import (
+    CallFrameRetryLineageError,
+    ScopeAudit,
+    index_retry_lineage,
+)
+
+
+def check_scope(audit: ScopeAudit) -> None:
+    state = audit.raw_state
+    if not isinstance(state, Mapping):
+        audit.fail("unsupported_shape", field="state")
+    steps = state.get("steps", {})
+    if not isinstance(steps, Mapping):
+        audit.fail("unsupported_shape", field="steps")
+    frames = state.get("call_frames", {})
+    if not isinstance(frames, Mapping):
+        audit.fail("unsupported_shape", field="call_frames")
+    for frame_id, frame in frames.items():
+        if not isinstance(frame, Mapping):
+            audit.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+
+    index = audit.slot_index()
+    _check_step_rows(audit, steps, index)
+    _check_list_summaries(audit, steps, index)
+    _check_current_step(audit, state.get("current_step"), index)
+    check_call_frames(audit, frames, index)
+
+
+def _check_identity(audit, index, field: str, step_id: Any, presentation_key: Any) -> None:
+    resolution = audit.projection.resolve_resume_step_id(
+        index, step_id, presentation_key if isinstance(presentation_key, str) else None
+    )
+    if resolution.candidate_count == 0:
+        audit.fail("unknown_explicit_step_id", field=field, value=step_id, count=0)
+    if resolution.slot is None:
+        audit.fail("presentation_slot_mismatch", field=field, value=step_id, count=resolution.candidate_count)
+
+
+def _check_step_rows(audit: ScopeAudit, steps: Mapping[str, Any], index) -> None:
+    unclaimed = {name for name, _ in index.unclaimed_explicit_rows}
+    loop_keys = {lp.frame_key for lp in audit.projection.for_each_nodes.values()}
+    for name, row in steps.items():
+        field = f"steps.{name}.step_id"
+        if isinstance(row, list) and name in loop_keys:
+            continue
+        if not isinstance(row, Mapping):
+            audit.fail("unsupported_shape", field=f"steps.{name}")
+        if "step_id" not in row:
+            continue
+        step_id = row["step_id"]
+        if not isinstance(step_id, str) or not step_id:
+            audit.fail("unsupported_shape", field=field, value=step_id)
+        if name in unclaimed:
+            audit.fail("unclaimed_explicit_step_row", field=field, value=step_id, count=0)
+        _check_identity(audit, index, field, step_id, name)
+
+
+def _check_list_summaries(audit: ScopeAudit, steps: Mapping[str, Any], index) -> None:
+    for projection in audit.projection.for_each_nodes.values():
+        summary = steps.get(projection.frame_key)
+        if not isinstance(summary, list):
+            continue
+        by_name = {key: node for node, key in projection.nested_presentation_keys.items()}
+        for position, element in enumerate(summary):
+            base = f"steps.{projection.frame_key}[{position}]"
+            if not isinstance(element, Mapping):
+                audit.fail("unsupported_shape", field=base)
+            for nested_name, result in element.items():
+                field = f"{base}.{nested_name}.step_id"
+                if not isinstance(result, Mapping) or "step_id" not in result:
+                    continue
+                step_id = result["step_id"]
+                if not isinstance(step_id, str) or not step_id:
+                    audit.fail("unsupported_shape", field=field, value=step_id)
+                if nested_name not in by_name:
+                    audit.fail("unclaimed_explicit_step_row", field=field, value=step_id, count=0)
+                row_key = projection.step_key(position, by_name[nested_name])
+                _check_identity(audit, index, field, step_id, row_key)
+
+
+def _check_current_step(audit: ScopeAudit, current: Any, index) -> None:
+    if current is None:
+        return
+    if not isinstance(current, Mapping):
+        audit.fail("unsupported_shape", field="current_step")
+    step_id = current.get("step_id")
+    if step_id is None:
+        audit.fail("missing_required_identity", field="current_step.step_id")
+    if not isinstance(step_id, str) or not step_id:
+        audit.fail("unsupported_shape", field="current_step.step_id", value=step_id)
+    resolution = audit.projection.resolve_resume_step_id(index, step_id, current.get("name") if isinstance(current.get("name"), str) else None)
+    if resolution.candidate_count == 0:
+        audit.fail("out_of_scope_step_id", field="current_step.step_id", value=step_id, count=0)
+    if resolution.slot is None:
+        audit.fail("presentation_slot_mismatch", field="current_step.step_id", value=step_id, count=resolution.candidate_count)
+
+
+def _path_matches(persisted: Any, bundle: Any) -> bool:
+    """An absolute persisted path must equal the bundle's recorded path exactly.
+
+    Relative display paths cannot be resolved without the workspace (the auditor reads none), so
+    they are only required to be non-empty strings here; the frame and nested-state copies are
+    compared with each other exactly in ``_check_frame_mirrors``.
+    """
+    workflow_path = getattr(workflow_provenance(bundle), "workflow_path", None)
+    if workflow_path is None:
+        return True
+    if not isinstance(persisted, str) or not persisted:
+        return False
+    given = PurePath(persisted)
+    return not given.is_absolute() or given.as_posix() == PurePath(workflow_path).as_posix()
+
+
+def _check_frame_mirrors(audit: ScopeAudit, frame_id: str, frame: Mapping[str, Any], callee: Any, boundary: str) -> None:
+    prefix = f"call_frames.{frame_id}"
+    mirror = frame.get("call_frame_id")
+    if "call_frame_id" in frame and mirror != frame_id:
+        audit.fail("unsupported_shape", field=f"{prefix}.call_frame_id", value=mirror, boundary=boundary)
+    nested = frame.get("state")
+    if not isinstance(nested, Mapping):
+        audit.fail("unsupported_shape", field=f"{prefix}.state", boundary=boundary)
+    for field, value in ((f"{prefix}.workflow_file", frame.get("workflow_file")), (f"{prefix}.state.workflow_file", nested.get("workflow_file"))):
+        if not _path_matches(value, callee):
+            audit.fail("unsupported_shape", field=field, value=value, boundary=boundary)
+    if frame.get("workflow_file") != nested.get("workflow_file"):
+        audit.fail("unsupported_shape", field=f"{prefix}.state.workflow_file", value=nested.get("workflow_file"), boundary=boundary)
+    outer, inner = frame.get("current_step"), nested.get("current_step")
+    if isinstance(outer, Mapping):
+        for key in ("name", "step_id"):
+            if not isinstance(inner, Mapping) or outer.get(key) != inner.get(key):
+                audit.fail("unsupported_shape", field=f"{prefix}.current_step.{key}", value=outer.get(key), boundary=boundary)
+
+
+def check_call_frames(
+    audit: ScopeAudit, frames: Mapping[str, Any], index, frontend_kind: Any = None, boundary: Any = None
+) -> None:
+    groups: dict[str, list[tuple[str, Mapping[str, Any]]]] = {}
+    callees: dict[str, Any] = {}
+    for frame_id, frame in frames.items():
+        prefix = f"call_frames.{frame_id}"
+        call_step_id = frame.get("call_step_id")
+        if call_step_id is None:
+            audit.fail("missing_required_identity", field=f"{prefix}.call_step_id")
+        if not isinstance(call_step_id, str) or not call_step_id:
+            audit.fail("unsupported_shape", field=f"{prefix}.call_step_id", value=call_step_id)
+        # A reached call has already resolved its boundary once; do not resolve it again.
+        resolution = (
+            SimpleNamespace(boundary=boundary, candidate_count=1)
+            if boundary is not None
+            else audit.projection.resolve_call_boundary(index, call_step_id)
+        )
+        if resolution.candidate_count > 1:
+            audit.fail("ambiguous_call_boundary", field=f"{prefix}.call_step_id", value=call_step_id, count=resolution.candidate_count)
+        if resolution.boundary is None:
+            known = audit.projection.resolve_resume_step_id(index, call_step_id).candidate_count > 0
+            audit.fail(
+                "missing_call_boundary" if known else "out_of_scope_step_id",
+                field=f"{prefix}.call_step_id", value=call_step_id, count=0, boundary=call_step_id if known else None,
+            )
+        alias = resolution.boundary.import_alias
+        if frame.get("import_alias") != alias:
+            audit.fail("persisted_import_alias_mismatch", field=f"{prefix}.import_alias", value=frame.get("import_alias"), count=1, boundary=call_step_id)
+        callee = workflow_import_bundle(audit.bundle, alias)
+        if callee is None:
+            audit.fail("missing_imported_bundle", field=f"imports.{alias}", value=alias, count=1, boundary=call_step_id)
+        if frame.get("status") not in FRAME_STATUSES:
+            audit.fail("unsupported_shape", field=f"{prefix}.status", value=frame.get("status"), boundary=call_step_id)
+        _check_frame_mirrors(audit, frame_id, frame, callee, call_step_id)
+        groups.setdefault(call_step_id, []).append((frame_id, frame))
+        callees[call_step_id] = callee
+
+    for call_step_id, items in groups.items():
+        kind = frontend_kind or getattr(workflow_provenance(callees[call_step_id]), "frontend_kind", None)
+        check_boundary_lineage(audit, call_step_id, items, kind)
+
+
+def check_boundary_lineage(audit: ScopeAudit, call_step_id: str, items, frontend_kind) -> Any:
+    """Group one boundary's frames into a lineage; raise the audit diagnostic when invalid."""
+    try:
+        return index_retry_lineage(call_step_id, items, frontend_kind=frontend_kind)
+    except CallFrameRetryLineageError as exc:
+        open_count = sum(1 for _, frame in items if frame.get("status") != "completed")
+        ambiguous = exc.reason == "ambiguous_resumable_call_frame"
+        audit.fail(
+            exc.reason, field="call_frames", count=open_count if ambiguous else None,
+            value=open_count if ambiguous else None, boundary=call_step_id,
+        )

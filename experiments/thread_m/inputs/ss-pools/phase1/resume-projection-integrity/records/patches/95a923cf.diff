+    return FinalizationController(
+        finalization={"block_id": "fin"},
+        finalization_start_index=1,
+        finalization_step_count=1,
+        finalization_node_ids=["root.fin.cleanup"],
+        has_workflow_outputs=False,
+        persist_state=lambda state: persisted.append(1),
+        finalization_failure_error=lambda result, name: {"type": "finalization_failed", "step": name},
+    )

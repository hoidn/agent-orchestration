+def test_workflow_lisp_lineage_validates_failed_predecessors_before_allocating_the_retry(tmp_path: Path) -> None:
+    base = "root.invoke_middle::visit::1"
+    executor, step, state = _lisp_lineage_state(tmp_path, {base: "failed", f"{base}::retry::1": "failed"})
+    state["call_frames"][base]["state"]["current_step"] = {
+        "name": "X", "step_id": "root.stale", "status": "running"
+    }
+    with patch.object(CallExecutor, "_is_workflow_lisp_target", return_value=True), patch(
+        "orchestrator.workflow.call_frame_state._CallFrameStateManager",
+        side_effect=AssertionError("fresh retry frame allocated before predecessors were audited"),
+    ):
+        result = executor.call_executor.execute_call(step, state)
+
+    context = result["error"]["context"]
+    assert result["error"]["type"] == "resume_projection_integrity_error"
+    assert (context["reason"], context["field"]) == ("out_of_scope_step_id", "current_step.step_id")
+    assert context["scope_path"][-1] == {"kind": "call_frame", "frame_id": base}
+

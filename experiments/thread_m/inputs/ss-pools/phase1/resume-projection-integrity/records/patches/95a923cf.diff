@@ -0,0 +1,79 @@
+"""Reached-call helpers: frame selection by retry lineage and callee scope audits.
+
+Dependencies: the call boundary's frames in the parent's state dict, the current callee bundles
+(``workflow_import_bundle``) and the ``audit_scope`` function the caller passes in (so the
+caller's module-level name stays the observable seam). Nothing here writes state.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Callable, Mapping, Optional
+
+from .call_frame_lineage import CallFrameRetryLineage, next_unused_retry_frame_id
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_scope_checks import check_boundary_lineage, check_call_frames
+from .resume_projection_integrity import ResumeScopePath, ScopeAudit
+
+def failed_call_result(error: Mapping[str, Any]) -> dict[str, Any]:
+    """The caller's failed call-step result carrying a diagnostic unchanged."""
+    return {"status": "failed", "exit_code": 2, "duration_ms": 0, "error": error}
+
+
+def boundary_frame_items(call_frames: Mapping[str, Any], step_id: str) -> list[tuple[str, Mapping[str, Any]]]:
+    """This boundary's frames, selected only by the exact persisted ``call_step_id``."""
+    return [
+        (frame_id, frame)
+        for frame_id, frame in call_frames.items()
+        if isinstance(frame, Mapping) and frame.get("call_step_id") == step_id
+    ]
+
+
+def frontend_kind_of(bundle: Any) -> Optional[str]:
+    return getattr(workflow_provenance(bundle), "frontend_kind", None)
+
+
+def lineage_for_boundary(
+    parent_audit: ScopeAudit, step_id: str, call_frames: Mapping[str, Any], frontend_kind: Optional[str]
+) -> CallFrameRetryLineage:
+    """Index the boundary's lineage; raises ``ResumeProjectionIntegrityError`` when invalid."""
+    return check_boundary_lineage(
+        parent_audit, step_id, boundary_frame_items(call_frames, step_id), frontend_kind
+    )
+
+

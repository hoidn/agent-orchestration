+def _failed_loop_run(tmp_path: Path, loop: dict) -> tuple:
+    """Run a workflow whose callee fails on its first run, leaving an organic failed state."""
+    _write(
+        tmp_path / "child.yaml",
+        {
+            "version": "2.7",
+            "name": "child",
+            "steps": [
+                {"name": "Gate", "id": "gate", "command": ["bash", "-lc", "test -f ready.txt"]},
+                {"name": "ChildStep", "id": "child_step", **_marker("child")},
+            ],
+        },
+    )
+    _write(
+        tmp_path / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "root",
+            "imports": {"child": "child.yaml"},
+            "artifacts": {"ok": {"kind": "scalar", "type": "bool"}},
+            "steps": [loop],
+        },
+    )
+    bundle = WorkflowLoader(tmp_path).load_bundle(tmp_path / "workflow.yaml")
+    manager = StateManager(tmp_path, run_id="run")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    return bundle, manager
+
+
+def _repeat_until(*body: dict) -> dict:
+    return {
+        "name": "Loop",
+        "id": "loop",
+        "repeat_until": {
+            "id": "body",
+            "max_iterations": 3,
+            "outputs": {
+                "ok": {"kind": "scalar", "type": "bool", "from": {"ref": "self.steps.Flip.artifacts.ok"}}
+            },
+            "condition": {"compare": {"left": {"ref": "self.outputs.ok"}, "op": "eq", "right": True}},
+            "steps": [*body, {"name": "Flip", "id": "flip", "set_scalar": {"artifact": "ok", "value": True}}],
+        },
+    }
+
+
+def _for_each(*body: dict, items=("a", "b")) -> dict:
+    return {"name": "Each", "id": "each", "for_each": {"items": list(items), "steps": list(body)}}
+
+
+CALL = {"name": "CallIt", "id": "call_it", "call": "child"}
+
+
+def _corrupt_callee(manager) -> str:
+    data = _raw(manager)
+    (frame_id,) = data["call_frames"]
+    frame = data["call_frames"][frame_id]
+    assert frame["status"] == "failed"
+    frame["state"]["current_step"] = dict(STALE)
+    frame["current_step"] = dict(STALE)
+    manager.state_file.write_text(json.dumps(data), encoding="utf-8")
+    return frame_id
+
+
+def test_stale_callee_id_reached_through_a_call_in_repeat_until_is_not_wrapped(tmp_path) -> None:
+    bundle, manager = _failed_loop_run(tmp_path, _repeat_until(CALL))
+    frame_id = _corrupt_callee(manager)
+    before_frame = _raw(manager)["call_frames"][frame_id]
+
+    result = _resume(bundle, tmp_path, manager)
+    after = _raw(manager)
+
+    assert result["status"] == "failed"
+    _assert_projection_error(after["error"])
+    assert after["call_frames"][frame_id] == before_frame
+    assert after["steps"]["Loop"]["error"] == after["error"]  # not repeat_until_body_step_failed
+    assert after["steps"]["Loop[0].CallIt"]["error"] == after["error"]
+    assert not any(key.startswith("Loop[1]") for key in after["steps"])
+    assert after["repeat_until"]["Loop"]["current_iteration"] == 0
+    assert _marks(tmp_path) == set()
+
+
+def test_stale_callee_id_reached_through_a_call_in_for_each_stops_the_loop(tmp_path) -> None:
+    bundle, manager = _failed_loop_run(tmp_path, _for_each(CALL, items=("a",)))
+    frame_id = _corrupt_callee(manager)
+    # A for_each settles a failed iteration, so model a crash inside the call instead.
+    data = _raw(manager)
+    data["status"] = "failed"
+    data["for_each"]["Each"].update(completed_indices=[], current_index=0)
+    data["steps"]["Each"] = []
+    data["steps"].pop("Each[0].CallIt")
+    data["call_frames"][frame_id]["status"] = "running"
+    manager.state_file.write_text(json.dumps(data), encoding="utf-8")
+    before_frame = _raw(manager)["call_frames"][frame_id]
+
+    result = _resume(bundle, tmp_path, manager)
+    after = _raw(manager)
+
+    assert result["status"] == "failed"
+    _assert_projection_error(after["error"])
+    assert after["call_frames"][frame_id] == before_frame
+    assert after["steps"]["Each"]["status"] == "failed"  # a failed result, not a list summary
+    assert after["steps"]["Each"]["error"] == after["error"]
+    assert not any(key.startswith("Each[1]") for key in after["steps"])
+    assert after["for_each"]["Each"]["current_index"] == 0
+    assert _marks(tmp_path) == set()

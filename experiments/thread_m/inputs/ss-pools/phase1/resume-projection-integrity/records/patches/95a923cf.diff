+def _projection_diagnostic(field: str = "steps.X.step_id") -> dict:
+    return {
+        "type": "resume_projection_integrity_error",
+        "message": "Resume projection integrity audit failed: unknown_explicit_step_id",
+        "context": {"diagnostic_schema": "resume_projection_integrity_error.v1", "field": field},
+    }

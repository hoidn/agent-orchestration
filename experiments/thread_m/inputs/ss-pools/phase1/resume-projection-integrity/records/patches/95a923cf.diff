+# --- resume projection integrity: CLI/executor envelopes and stickiness ------------------
+
+
+def _seed_valid_failed_root(workspace: Path, *, run_id: str) -> StateManager:
+    """A checksum-compatible failed run whose persisted identities are all valid."""
+    (workspace / "valid_root.yaml").write_text(
+        yaml.safe_dump(
+            {
+                "version": "2.0",
+                "name": "valid-root",
+                "steps": [
+                    {
+                        "name": "WriteMarker",
+                        "id": "write_marker",
+                        "command": ["bash", "-lc", "mkdir -p state && printf 'ran\\n' > state/marker.txt"],
+                    }
+                ],
+            },
+            sort_keys=False,
+        ),
+        encoding="utf-8",
+    )
+    manager = StateManager(workspace, run_id=run_id)
+    state = manager.initialize("valid_root.yaml")
+    state.status = "failed"
+    manager._write_state()
+    return manager
+
+
+def _raw_state(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _write_raw_state(manager: StateManager, data: dict) -> None:
+    manager.state_file.write_text(json.dumps(data, indent=2), encoding="utf-8")
+
+
+def _resume_cli(workspace: Path, run_id: str, **kwargs) -> int:
+    with patch("os.getcwd", return_value=str(workspace)):
+        return resume_workflow(run_id=run_id, repair=False, force_restart=False, **kwargs)
+
+
+def test_cli_resume_of_valid_run_passes_the_audit_and_runs(temp_workspace):
+    manager = _seed_valid_failed_root(temp_workspace, run_id="audit-positive")
+    assert _resume_cli(temp_workspace, "audit-positive") == 0
+    assert (temp_workspace / "state" / "marker.txt").read_text() == "ran\n"
+
+
+def test_cli_audit_failure_preserves_unknown_root_keys_and_reports_malformed_for_each(
+    temp_workspace, capsys
+):
+    manager = _seed_valid_failed_root(temp_workspace, run_id="audit-malformed-for-each")
+    data = _raw_state(manager)
+    data["operator_note"] = {"keep": True}
+    data["for_each"] = {"Loop": "not-a-mapping"}
+    _write_raw_state(manager, data)
+
+    assert _resume_cli(temp_workspace, "audit-malformed-for-each") == 1
+
+    after = _raw_state(manager)
+    changed = {k for k in set(data) | set(after) if data.get(k) != after.get(k)}
+    assert changed == {"error", "updated_at"} and after["operator_note"] == {"keep": True}
+    assert after["error"]["context"]["reason"] == "unsupported_shape"
+    assert after["error"]["context"]["field"] == "for_each.Loop"
+    assert after["error"]["message"] in capsys.readouterr().err
+    assert not (temp_workspace / "state" / "marker.txt").exists()
+
+
+def test_cli_checksum_mismatch_still_writes_nothing(temp_workspace):
+    manager = _seed_valid_failed_root(temp_workspace, run_id="audit-checksum-first")
+    data = _raw_state(manager)
+    data["steps"] = {"Ghost": {"step_id": "root.ghost"}}  # would fail the audit
+    _write_raw_state(manager, data)
+    (temp_workspace / "valid_root.yaml").write_text("# changed\n" + (temp_workspace / "valid_root.yaml").read_text())
+    before = manager.state_file.read_bytes()
+
+    assert _resume_cli(temp_workspace, "audit-checksum-first") == 1
+    assert manager.state_file.read_bytes() == before
+
+
+def test_cli_second_resume_of_a_recorded_integrity_failure_is_sticky(temp_workspace):
+    manager = _seed_valid_failed_root(temp_workspace, run_id="audit-sticky")
+    data = _raw_state(manager)
+    data["steps"] = {"Ghost": {"step_id": "root.ghost"}}
+    _write_raw_state(manager, data)
+    assert _resume_cli(temp_workspace, "audit-sticky") == 1
+
+    fixed = _raw_state(manager)
+    fixed["steps"] = {}  # the identities are repaired by hand: still must not be downgraded
+    _write_raw_state(manager, fixed)
+    before = manager.state_file.read_bytes()
+    with patch("orchestrator.cli.commands.resume.WorkflowExecutor") as executor:
+        assert _resume_cli(temp_workspace, "audit-sticky") == 1
+    executor.assert_not_called()
+    assert manager.state_file.read_bytes() == before
+
+
+def test_direct_executor_resume_of_a_recorded_integrity_failure_leaves_state_byte_identical(

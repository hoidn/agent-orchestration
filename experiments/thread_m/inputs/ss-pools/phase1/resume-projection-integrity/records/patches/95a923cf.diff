+def test_resume_slot_call_boundary_exposes_current_alias(slot_projection) -> None:
+    index = _enumerate(slot_projection, _slot_state())
+    resolution = slot_projection.resolve_call_boundary(index, "root.process_items#0.call_it")
+    assert isinstance(resolution.boundary, CallBoundaryProjection)
+    assert resolution.boundary.import_alias == "child" and resolution.candidate_count == 1

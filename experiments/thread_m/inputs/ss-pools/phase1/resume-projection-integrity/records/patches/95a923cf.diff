+def test_resume_slots_unclaimed_rows_snapshot_and_list_summary_is_not_unclaimed(slot_projection) -> None:
+    state = _slot_state()
+    state["steps"]["ProcessItems"] = [{"Inner": {"step_id": "root.process_items#0.inner"}}]
+    state["steps"]["Ghost"] = {"step_id": ["unhashable"]}
+    state["steps"]["ProcessItems[5].Inner"] = {"step_id": "root.process_items#5.inner"}
+    state["steps"]["NoId"] = {"status": "completed"}
+
+    index = _enumerate(slot_projection, state)
+
+    assert set(index.unclaimed_explicit_rows) == {
+        ("Ghost", ("unhashable",)),
+        ("ProcessItems[5].Inner", "root.process_items#5.inner"),
+    }
+
+
+def test_resume_slots_do_not_mutate_state(slot_projection) -> None:
+    state = _slot_state()
+    snapshot = copy.deepcopy(state)
+    _enumerate(slot_projection, state)
+    assert state == snapshot

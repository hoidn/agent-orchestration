+@pytest.fixture
+def slot_projection(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load(_write_slot_workflow(tmp_path)).projection
+
+
+def _enumerate(projection, state):
+    return projection.enumerate_resume_slots(state, repeat_until_maximums={"ReviewLoop": 2})
+
+
+def _slot_state(**overrides) -> dict:
+    state = {
+        "steps": {
+            "Setup": {"status": "completed", "name": "Setup", "step_id": "root.setup"},
+            "ProcessItems[0].Inner": {"status": "completed", "step_id": "root.process_items#0.inner"},
+            "ReviewLoop[0].Flip": {"status": "completed", "step_id": "root.review_loop#0.body.flip"},
+        },
+        "for_each": {
+            "ProcessItems": {"items": ["a", "b"], "completed_indices": [0], "current_index": 1}
+        },
+        "repeat_until": {
+            "ReviewLoop": {
+                "current_iteration": 0,
+                "completed_iterations": [],
+                "condition_evaluated_for_iteration": None,
+                "last_condition_result": None,
+            }
+        },
+    }
+    state.update(overrides)
+    return state
+
+
+def test_resume_slots_resolve_top_level_loop_local_and_finalization_ids(slot_projection) -> None:
+    index = _enumerate(slot_projection, _slot_state())
+
+    setup = slot_projection.resolve_resume_step_id(index, "root.setup", "Setup")
+    assert setup.slot.node_id == "root.setup" and setup.slot.iteration_index is None
+    local = slot_projection.resolve_resume_step_id(index, "root.process_items#1.inner")
+    assert local.slot.iteration_index == 1 and local.candidate_count == 1
+    cleanup = slot_projection.resolve_resume_step_id(index, "root.finally.fin.cleanup")
+    assert cleanup.slot.region.value == "finalization"
+    assert "root.process_items#0.call_it" in index.call_boundaries_by_step_id
+    assert "root.review_loop#1.body.flip" in index.candidates_by_step_id
+    assert "root.review_loop#2.body.flip" not in index.candidates_by_step_id
+
+
+def test_resume_slots_report_presentation_mismatch_unknown_and_unhashable(slot_projection) -> None:
+    index = _enumerate(slot_projection, _slot_state())
+
+    other = slot_projection.resolve_resume_step_id(index, "root.setup", "ProcessItems")
+    assert (other.slot, other.candidate_count, other.exact_identity_candidate_count) == (None, 1, 0)
+    for stale in ("root.nope", ["x"], {"a": 1}, None, 3):
+        resolved = slot_projection.resolve_resume_step_id(index, stale)
+        assert (resolved.slot, resolved.candidate_count) == (None, 0)
+    assert slot_projection.resolve_call_boundary(index, ["x"]).candidate_count == 0
+

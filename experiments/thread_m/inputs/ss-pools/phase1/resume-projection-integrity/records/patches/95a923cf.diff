+def _load_alias_doc(tmp_path: Path, text: str, monkeypatch: pytest.MonkeyPatch | None = None):
+    for name in ("a.yaml", "b.yaml"):
+        (tmp_path / name).write_text(_CHILD_WORKFLOW, encoding="utf-8")

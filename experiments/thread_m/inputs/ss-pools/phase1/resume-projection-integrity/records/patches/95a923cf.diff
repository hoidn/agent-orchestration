+) -> None:
+    reached = []
+    import orchestrator.loader as loader_module
+
+    real = loader_module.build_loaded_workflow_bundle
+    monkeypatch.setattr(
+        loader_module,
+        "build_loaded_workflow_bundle",
+        lambda *a, **k: reached.append(1) or real(*a, **k),
+    )
+    text = f"version: '2.7'\nname: main\n{imports_text}{_ROOT_TAIL}"

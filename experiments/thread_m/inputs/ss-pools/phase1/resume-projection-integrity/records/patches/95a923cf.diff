diff --git a/orchestrator/loader_import_aliases.py b/orchestrator/loader_import_aliases.py
new file mode 100644
index 0000000..7cebba4
--- /dev/null
+++ b/orchestrator/loader_import_aliases.py
@@ -0,0 +1,74 @@
+"""Pre-construction duplicate detection for classic-YAML ``imports`` aliases.
+
+PyYAML's constructor silently collapses duplicate keys, repeated top-level
+sections and ``<<`` merges, so this works on the composed node tree, where
+every occurrence and its source position is still visible.
+
+Dependencies: ``yaml.compose`` with the caller's loader class; reads only the text it is given.
+"""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+import yaml
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: yaml.Node) -> str:
+    mark = node.start_mark
+    return f"line {mark.line + 1}, column {mark.column + 1}"
+
+
+def _merge_sources(value: yaml.Node) -> list[yaml.MappingNode]:
+    if isinstance(value, yaml.MappingNode):
+        return [value]
+    if isinstance(value, yaml.SequenceNode):
+        return [n for n in value.value if isinstance(n, yaml.MappingNode)]
+    return []
+
+
+def _entries(mapping: yaml.MappingNode, seen: frozenset[int] = frozenset()):
+    """Yield (key_node, value_node) for explicit keys and, recursively, merged keys."""
+    if id(mapping) in seen:
+        return
+    seen = seen | {id(mapping)}
+    for key, value in mapping.value:
+        if key.tag == _MERGE_TAG:
+            for source in _merge_sources(value):
+                yield from _entries(source, seen)
+        else:
+            yield key, value
+
+
+def _is_key(node: yaml.Node, name: str) -> bool:
+    return isinstance(node, yaml.ScalarNode) and node.value == name
+
+
+def duplicate_import_alias_errors(text: str, loader: type) -> list[str]:
+    """Return duplicate-alias / duplicate-section messages for a workflow document."""
+    try:
+        root = yaml.compose(text, Loader=loader)
+    except yaml.YAMLError:
+        return []  # the ordinary load reports the syntax error
+    if not isinstance(root, yaml.MappingNode):
+        return []
+
+    sections = [(k, v) for k, v in _entries(root) if _is_key(k, "imports")]
+    aliases: dict[str, list[yaml.Node]] = defaultdict(list)
+    for _, value in sections:
+        if isinstance(value, yaml.MappingNode):
+            for key, _ in _entries(value):
+                if isinstance(key, yaml.ScalarNode):
+                    aliases[key.value].append(key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias ({'; '.join(_position(k) for k in keys)})"
+        for alias, keys in aliases.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(sections) > 1:
+        positions = "; ".join(_position(k) for k, _ in sections)
+        errors.append(f"imports: duplicate top-level mapping ({positions})")
+    return errors

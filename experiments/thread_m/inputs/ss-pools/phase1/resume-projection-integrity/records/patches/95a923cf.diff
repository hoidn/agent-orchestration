+"""Resume projection integrity: call-frame retry lineage and the scope auditor."""
+
+import itertools
+
+import pytest
+
+from orchestrator.workflow.call_frame_lineage import (
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+
+LISP = "workflow_lisp"
+
+
+def _frame(status, **overrides):
+    return {"call_step_id": "root.call", "import_alias": "child", "status": status, **overrides}
+
+
+def _lineage(items, kind=LISP):
+    return index_retry_lineage("root.call", items, frontend_kind=kind)
+
+
+def _reason(items, kind=LISP):
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        _lineage(items, kind)
+    return excinfo.value.reason
+
+
+def test_lineage_with_running_member_and_failed_predecessors() -> None:
+    lineage = _lineage(
+        [
+            ("B::retry::2", _frame("running")),
+            ("B", _frame("failed")),
+            ("B::retry::1", _frame("failed")),
+            ("C", _frame("completed")),
+        ]
+    )
+    assert lineage.base_frame_id == "B"
+    assert [(m.frame_id, m.ordinal) for m in lineage.failed_predecessors] == [("B", 0), ("B::retry::1", 1)]
+    assert (lineage.running_member.frame_id, lineage.running_member.ordinal) == ("B::retry::2", 2)
+    assert [m.frame_id for m in lineage.completed_members] == ["C"]
+
+
+def test_lineage_result_is_independent_of_mapping_order() -> None:
+    items = [("B", _frame("failed")), ("B::retry::1", _frame("failed")), ("B::retry::2", _frame("running"))]
+    results = {repr(_lineage(list(order))) for order in itertools.permutations(items)}
+    assert len(results) == 1
+
+
+@pytest.mark.parametrize(
+    "items, reason",
+    [
+        ([("B", _frame("running")), ("B::retry::1", _frame("running"))], "ambiguous_resumable_call_frame"),
+        ([("B", _frame("failed")), ("X::retry::1", _frame("running"))], "ambiguous_resumable_call_frame"),
+        ([("B", _frame("failed")), ("B", _frame("running"))], "ambiguous_resumable_call_frame"),
+        ([("B", _frame("failed")), ("B::retry::2", _frame("running"))], "unsupported_shape"),
+        ([("B::retry::x", _frame("running"))], "unsupported_shape"),
+        ([("B::retry::01", _frame("running"))], "unsupported_shape"),
+        ([("B::retry::0", _frame("running"))], "unsupported_shape"),
+        ([("B::retry::1::retry::1", _frame("running"))], "unsupported_shape"),
+        ([("B", _frame("paused"))], "unsupported_shape"),
+        ([("B", "not-a-mapping")], "unsupported_shape"),
+        ([("B", _frame("failed", call_step_id="root.other"))], "missing_call_boundary"),
+        ([("B", _frame("failed")), ("B::retry::1", _frame("running", import_alias="other"))], "persisted_import_alias_mismatch"),
+    ],
+)
+def test_lisp_lineage_rejects_invalid_input(items, reason) -> None:
+    assert _reason(items) == reason
+
+
+def test_non_lisp_boundary_allows_one_non_completed_frame_and_unlimited_completed() -> None:
+    lineage = _lineage(
+        [("a", _frame("completed")), ("b", _frame("completed")), ("c", _frame("failed"))], kind=None
+    )
+    assert lineage.running_member.frame_id == "c" and len(lineage.completed_members) == 2
+    assert _reason([("c", _frame("failed")), ("d", _frame("running"))], kind=None) == "ambiguous_resumable_call_frame"
+
+
+@pytest.mark.parametrize(
+    "items, expected",
+    [
+        ([("B", _frame("failed"))], "B::retry::1"),
+        ([("B", _frame("failed")), ("B::retry::1", _frame("failed"))], "B::retry::2"),
+        ([("B", _frame("failed")), ("B::retry::1", _frame("completed"))], "B::retry::2"),
+        ([("B", _frame("failed")), ("B::retry::1", _frame("failed")), ("B::retry::2", _frame("running"))], "B::retry::3"),
+    ],
+)
+def test_next_unused_retry_frame_id_is_lowest_unused_and_idempotent(items, expected) -> None:
+    lineage = _lineage(items)
+    assert next_unused_retry_frame_id(lineage) == expected
+    assert next_unused_retry_frame_id(lineage) == expected

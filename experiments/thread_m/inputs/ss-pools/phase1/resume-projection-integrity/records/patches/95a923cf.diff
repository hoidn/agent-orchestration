diff --git a/orchestrator/workflow/call_frame_lineage.py b/orchestrator/workflow/call_frame_lineage.py
new file mode 100644
index 0000000..86d74d7
--- /dev/null
+++ b/orchestrator/workflow/call_frame_lineage.py
@@ -0,0 +1,139 @@
+"""Call-frame retry lineage for one call boundary.
+
+Pure functions over ``(frame_id, frame)`` pairs: no state manager, no files, no mutation.
+A Workflow Lisp boundary's non-completed frames form a lineage ``B`` (ordinal 0),
+``B::retry::1``, ``B::retry::2`` ...; any other boundary may have at most one non-completed frame.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+FRAME_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Invalid lineage input; ``reason`` is a resume projection integrity reason."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class FrameMember:
+    frame_id: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(FrameMember):
+    ordinal: int
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    base_frame_id: Optional[str]
+    completed_members: tuple[FrameMember, ...] = ()
+    failed_predecessors: tuple[RetryFrameMember, ...] = ()
+    running_member: Optional[RetryFrameMember] = None
+
+
+def _parse_frame_id(frame_id: str) -> tuple[str, int]:
+    """Split ``<base>`` / ``<base>::retry::<n>`` exactly once; reject anything else."""
+    count = frame_id.count(RETRY_MARKER)
+    if count == 0:
+        return frame_id, 0
+    base, _, tail = frame_id.partition(RETRY_MARKER)
+    if count > 1 or not base or not tail.isascii() or not tail.isdecimal() or str(int(tail)) != tail or int(tail) < 1:
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "call frame id has a malformed or nested retry marker"
+        )
+    return base, int(tail)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[Any, Any]]
+) -> list[tuple[str, Mapping[str, Any]]]:
+    frames: list[tuple[str, Mapping[str, Any]]] = []
+    aliases: set[Any] = set()
+    seen: set[str] = set()
+    for frame_id, frame in frame_items:
+        if not isinstance(frame_id, str) or not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame entry is malformed")
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", "call frame does not belong to the call boundary"
+            )
+        if frame.get("status") not in FRAME_STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame status is unknown")
+        if frame_id in seen:
+            raise CallFrameRetryLineageError(
+                "ambiguous_resumable_call_frame", "call frame id occurs more than once"
+            )
+        seen.add(frame_id)
+        aliases.add(frame.get("import_alias"))
+        frames.append((frame_id, frame))
+    if len(aliases) > 1:
+        raise CallFrameRetryLineageError(
+            "persisted_import_alias_mismatch", "call frames of one boundary disagree on the import alias"
+        )
+    return frames
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Mapping[str, Any]]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group one boundary's frames into completed history and its resumable lineage."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    completed = tuple(FrameMember(i) for i, f in frames if f["status"] == "completed")
+    open_frames = [(i, f) for i, f in frames if f["status"] != "completed"]
+
+    if frontend_kind != "workflow_lisp":
+        if len(open_frames) > 1:
+            raise CallFrameRetryLineageError(
+                "ambiguous_resumable_call_frame", "boundary has more than one non-completed call frame"
+            )
+        running = RetryFrameMember(open_frames[0][0], 0) if open_frames else None
+        return CallFrameRetryLineage(open_frames[0][0] if open_frames else None, completed, (), running)
+
+    parsed = [(i, f, *_parse_frame_id(i)) for i, f in open_frames]
+    bases = {base for _, _, base, _ in parsed}
+    if len(bases) > 1:
+        raise CallFrameRetryLineageError("ambiguous_resumable_call_frame", "retry lineage has mixed bases")
+    base = next(iter(bases), None)
+    ordinals = [ordinal for _, _, _, ordinal in parsed]
+    if len(set(ordinals)) != len(ordinals):
+        raise CallFrameRetryLineageError("ambiguous_resumable_call_frame", "retry lineage repeats an ordinal")
+    completed_ids = {m.frame_id for m in completed}
+    used = set(ordinals) | {n for n in range(1, len(frames) + 1) if f"{base}{RETRY_MARKER}{n}" in completed_ids}
+    if base is not None and used != set(range(len(used))):
+        raise CallFrameRetryLineageError("unsupported_shape", "retry lineage is missing an ordinal")
+
+    members = sorted((RetryFrameMember(i, ordinal) for i, _, _, ordinal in parsed), key=lambda m: m.ordinal)
+    by_id = dict(open_frames)
+    running = [m for m in members if by_id[m.frame_id]["status"] == "running"]
+    if len(running) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "retry lineage has more than one running member"
+        )
+    failed = tuple(m for m in members if by_id[m.frame_id]["status"] == "failed")
+    return CallFrameRetryLineage(base, completed, failed, running[0] if running else None)
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<n>`` for the lowest unused positive ordinal over all members."""
+    if lineage.base_frame_id is None:
+        raise ValueError("lineage has no base frame")
+    taken = {m.frame_id for m in lineage.completed_members}
+    taken |= {m.frame_id for m in lineage.failed_predecessors}
+    if lineage.running_member is not None:
+        taken.add(lineage.running_member.frame_id)
+    ordinal = 1
+    while f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}" in taken:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

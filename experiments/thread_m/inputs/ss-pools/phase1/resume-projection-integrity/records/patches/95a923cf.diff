+def _lisp_lineage_state(tmp_path: Path, statuses: dict, *, extra=None):
+    """A reached-call state whose boundary frames have the given {frame_id: status}."""
+    root_bundle, executor, step = _call_executor_fixture(tmp_path, "projection-lineage")
+    WorkflowExecutor(root_bundle, tmp_path, executor.state_manager).execute()
+    persisted = executor.state_manager.load()
+    template = json.loads(json.dumps(next(iter(persisted.call_frames.values()))))
+    frames = {}
+    for frame_id, status in statuses.items():
+        frame = json.loads(json.dumps(template))
+        frame["call_frame_id"] = frame_id
+        frame["status"] = status
+        frame["state"]["status"] = "failed" if status != "completed" else "completed"
+        frames[frame_id] = frame
+    state = executor.state_manager.load().to_dict()
+    state["call_frames"] = {**frames, **(extra or {})}
+    state["step_visits"] = {"InvokeMiddle": 1}
+    return executor, step, state
+

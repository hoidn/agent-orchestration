+"""Sticky, non-routable resume projection failures through calls, loops and finalization."""
+
+import json
+from pathlib import Path
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+STALE = {"name": "Gone", "index": 0, "step_id": "root.gone", "status": "running", "visit_count": 1}
+
+
+def _write(path: Path, payload: dict) -> None:
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+
+
+def _marker(name: str) -> dict:
+    return {"command": ["bash", "-lc", f"mkdir -p marks && echo ran > marks/{name}.txt"]}
+
+
+def _build(tmp_path: Path, body: list, *, finally_steps=None, extra=None) -> tuple:
+    _write(
+        tmp_path / "child.yaml",
+        {"version": "2.5", "name": "child", "steps": [{"name": "ChildStep", "id": "child_step", **_marker("child")}]},
+    )
+    workflow = {"version": "2.5", "name": "root", "imports": {"child": "child.yaml"}, "steps": body, **(extra or {})}
+    if finally_steps is not None:
+        workflow["finally"] = {"id": "fin", "steps": finally_steps}
+    _write(tmp_path / "workflow.yaml", workflow)
+    bundle = WorkflowLoader(tmp_path).load_bundle(tmp_path / "workflow.yaml")
+    manager = StateManager(tmp_path, run_id="run")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    return bundle, manager
+
+
+def _raw(manager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _rewind_to_failed_call(manager, *, drop_rows=(), keep_frame=None, call_row="Call") -> str:
+    """Make the finished run resumable at its call step and corrupt the callee's current id."""
+    data = _raw(manager)
+    frame_id = keep_frame or next(iter(data["call_frames"]))
+    frame = data["call_frames"][frame_id]
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["current_step"] = dict(STALE)
+    frame["current_step"] = dict(STALE)
+    data["status"] = "failed"
+    data["steps"][call_row]["status"] = "failed"
+    for name in drop_rows:
+        data["steps"].pop(name, None)
+    data["finalization"] = {}
+    data["steps"] = {k: v for k, v in data["steps"].items() if not k.startswith("finally.")}
+    manager.state_file.write_text(json.dumps(data), encoding="utf-8")
+    return frame_id
+
+
+def _resume(bundle, tmp_path, manager, **kwargs) -> dict:
+    marks = tmp_path / "marks"
+    if marks.exists():
+        for file in marks.iterdir():
+            file.unlink()
+    return WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, **kwargs)
+
+
+def _marks(tmp_path: Path) -> set:
+    marks = tmp_path / "marks"
+    return {p.stem for p in marks.iterdir()} if marks.exists() else set()
+
+
+def _assert_projection_error(error: dict, *, reason="out_of_scope_step_id") -> None:
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["context"]["reason"] == reason
+
+
+@pytest.mark.parametrize("on_error", ["stop", "continue"])
+def test_authored_routes_and_on_error_continue_cannot_consume_the_failure(tmp_path, on_error) -> None:
+    bundle, manager = _build(
+        tmp_path,
+        [
+            {"name": "Call", "id": "call_step", "call": "child",
+             "on": {"failure": {"goto": "Recover"}, "always": {"goto": "Recover"}}},
+            {"name": "Next", "id": "next_step", **_marker("next")},
+            {"name": "Recover", "id": "recover", **_marker("recover")},
+        ],
+    )
+    _rewind_to_failed_call(manager, drop_rows=("Next", "Recover"))
+
+    result = _resume(bundle, tmp_path, manager, on_error=on_error)
+
+    assert result["status"] == "failed"
+    _assert_projection_error(_raw(manager)["error"])
+    assert _marks(tmp_path) == set()  # no route target, fallthrough or callee effect ran
+
+
+def test_without_finalization_nothing_further_runs_and_no_finalization_is_persisted(tmp_path) -> None:
+    bundle, manager = _build(tmp_path, [{"name": "Call", "id": "call_step", "call": "child"}])
+    _rewind_to_failed_call(manager)
+    _resume(bundle, tmp_path, manager)
+    assert "finalization" not in _raw(manager) or _raw(manager)["finalization"] in ({}, None)
+

+def test_resume_slots_reject_invalid_loop_bookkeeping(
+    slot_projection, overrides, reason, message
+) -> None:
+    with pytest.raises(ResumeProjectionValidationError) as excinfo:
+        _enumerate(slot_projection, _slot_state(**overrides))
+    assert (excinfo.value.reason, excinfo.value.message, str(excinfo.value)) == (reason, message, message)
+
+
+@pytest.mark.parametrize(
+    "progress, frame",
+    [
+        (_REPEAT_ACTIVE, None),
+        (_SUCCESS, {"status": "completed"}),
+        ({**_EXHAUSTED, "exhausted": True}, {"status": "completed"}),
+        (
+            _EXHAUSTED,
+            {"status": "failed", "error": {"type": "repeat_until_iterations_exhausted"}},
+        ),
+    ],
+)
+def test_resume_slots_accept_the_four_repeat_until_progress_forms(slot_projection, progress, frame) -> None:
+    state = _slot_state(repeat_until={"ReviewLoop": progress})
+    if frame is not None:
+        state["steps"]["ReviewLoop"] = frame
+    assert _enumerate(slot_projection, state).candidates_by_step_id

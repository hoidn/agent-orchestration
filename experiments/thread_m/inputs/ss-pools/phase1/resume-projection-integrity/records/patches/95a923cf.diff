+def _settle(state: dict, result: dict, body_status: str) -> dict:
+    state.setdefault("steps", {})["finally.Cleanup"] = {"step_id": "root.fin.cleanup", **result}
+    _controller([]).record_settled_result(
+        state, 1, "finally.Cleanup", body_status, step_node_id="root.fin.cleanup"
+    )

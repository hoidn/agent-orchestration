+++ b/orchestrator/workflow/resume_slots.py
@@ -0,0 +1,299 @@
+"""Resume slot index: which persisted identities the current projection owns.
+
+Pure functions over a ``WorkflowStateProjection`` and a plain persisted-state dict.
+Dependencies: ``state_projection`` (types only, duck-typed) and the given state; it reads no
+file and never mutates the state. Loop-local candidates come only from the projection's
+``runtime_step_id`` / ``step_key`` formatters, so no persisted id is ever split or prefix-matched.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Mapping, Optional
+
+from .executable_ir import WorkflowRegion
+
+if TYPE_CHECKING:  # pragma: no cover
+    from .state_projection import CallBoundaryProjection, WorkflowStateProjection
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Invalid persisted loop bookkeeping; ``reason`` is ``unsupported_shape`` or ``invalid_loop_progress``."""
+
+    def __init__(self, reason: str, message: str, field: str = "") -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field or message.split(" ", 1)[0]
+
+    def __str__(self) -> str:
+        return self.message
+
+
+@dataclass(frozen=True)
+class ResumeSlot:
+    """One current projection owner for a persisted step identity."""
+
+    node_id: str
+    region: WorkflowRegion
+    iteration_index: Optional[int] = None
+    presentation_key: Optional[str] = field(default=None, compare=False)
+
+
+@dataclass(frozen=True)
+class ResumeProjectionSlotIndex:
+    candidates_by_step_id: Mapping[str, tuple[ResumeSlot, ...]]
+    call_boundaries_by_step_id: Mapping[str, tuple[Any, ...]]
+    unclaimed_explicit_rows: tuple[tuple[str, Any], ...] = ()
+
+
+@dataclass(frozen=True)
+class ResumeIdentityResolution:
+    slot: Optional[ResumeSlot]
+    candidate_count: int
+    exact_identity_candidate_count: int
+
+
+@dataclass(frozen=True)
+class ResumeCallBoundaryResolution:
+    boundary: Optional[Any]
+    candidate_count: int
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _freeze(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return tuple((_freeze(k), _freeze(v)) for k, v in value.items())
+    if isinstance(value, (list, tuple, set, frozenset)):
+        return tuple(_freeze(v) for v in value)
+    return value
+
+
+def _shape(message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message)
+
+
+def _progress(message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message)
+
+
+# --- loop bookkeeping -------------------------------------------------------------------
+
+
+def validate_for_each_bookkeeping(for_each: Any) -> dict[str, int]:
+    """Validate ``state['for_each']``; return item counts by loop name."""
+    if for_each is None:
+        return {}
+    if not isinstance(for_each, Mapping):
+        raise _shape("for_each must be a mapping")
+    counts: dict[str, int] = {}
+    for name, entry in for_each.items():
+        prefix = f"for_each.{name}"
+        if not isinstance(entry, Mapping):
+            raise _shape(f"{prefix} must be a mapping")
+        items = entry.get("items")
+        if not isinstance(items, list):
+            raise _shape(f"{prefix}.items must be a list")
+        current = entry.get("current_index")
+        if current is not None and not _is_int(current):
+            raise _shape(f"{prefix}.current_index must be null or a non-boolean integer")
+        completed = entry.get("completed_indices", [])
+        if not isinstance(completed, list):
+            raise _shape(f"{prefix}.completed_indices must be a list")
+        if len(set(map(repr, completed))) != len(completed):
+            raise _progress(f"{prefix}.completed_indices must not contain duplicate indices")
+        if any(not _is_int(i) or not 0 <= i < len(items) for i in completed):
+            raise _progress(f"{prefix}.completed_indices contains an out-of-range index")
+        if current is not None:
+            if not 0 <= current < len(items):
+                raise _progress(f"{prefix}.current_index is out of range")
+            if current in completed:
+                raise _progress(f"{prefix}.current_index is already completed")
+        counts[str(name)] = len(items)
+    return counts
+
+
+def _history_set(prefix: str, entry: Mapping[str, Any]) -> set[int]:
+    completed = entry.get("completed_iterations", [])
+    if not isinstance(completed, list):
+        raise _shape(f"{prefix}.completed_iterations must be a list")
+    if len(set(map(repr, completed))) != len(completed):
+        raise _progress(f"{prefix}.completed_iterations must not contain duplicate indices")
+    if any(not _is_int(i) or i < 0 for i in completed):
+        raise _progress(f"{prefix}.completed_iterations is not valid prior history")
+    return set(completed)
+
+
+def _validate_active(prefix: str, current: int, entry: Mapping[str, Any], done: set[int]) -> None:
+    if done != set(range(current)):
+        raise _progress(f"{prefix}.completed_iterations is not valid prior history")
+    evaluated = entry.get("condition_evaluated_for_iteration")
+    result = entry.get("last_condition_result")
+    consistent = (evaluated is None and result is None) or (
+        evaluated == current and _is_int(evaluated) and isinstance(result, bool)
+    )
+    if not consistent or entry.get("exhausted") is True:
+        raise _progress(f"{prefix}.condition result conflicts with evaluation state")
+
+
+def _validate_terminal(
+    prefix: str,
+    entry: Mapping[str, Any],
+    done: set[int],
+    maximum: Optional[int],
+    loop_row: Any,
+) -> None:
+    evaluated = entry.get("condition_evaluated_for_iteration")
+    result = entry.get("last_condition_result")
+    if not isinstance(result, bool):
+        raise _progress(f"{prefix}.condition result conflicts with evaluation state")
+    if not _is_int(evaluated) or not done or done != set(range(evaluated + 1)):
+        raise _progress(f"{prefix}.terminal progress requires completed evaluated history")
+    exhausted = entry.get("exhausted") is True
+    row = loop_row if isinstance(loop_row, Mapping) else {}
+    if result:
+        if exhausted:
+            raise _progress(f"{prefix}.condition result conflicts with evaluation state")
+        if maximum is not None and evaluated >= maximum:
+            raise _progress(f"{prefix}.terminal progress requires completed evaluated history")
+        if row and row.get("status") != "completed":
+            raise _progress(f"{prefix}.terminal progress requires completed evaluated history")
+        return
+    if maximum is not None and evaluated != maximum - 1:
+        raise _progress(f"{prefix}.terminal progress requires completed evaluated history")
+    if loop_row is None:
+        # The loop row can be absent (restore flows drop it); only a present, wrong row contradicts.
+        return
+    if exhausted:
+        if row.get("status") != "completed":
+            raise _progress(f"{prefix}.successful exhaustion requires a completed frame")
+        return
+    error = row.get("error")
+    if row.get("status") != "failed" or not (
+        isinstance(error, Mapping) and error.get("type") == EXHAUSTION_ERROR_TYPE
+    ):
+        raise _progress(f"{prefix}.failed exhaustion requires the terminal exhaustion error")
+
+
+def validate_repeat_until_bookkeeping(
+    repeat_until: Any,
+    steps: Any,
+    maximum_by_name: Mapping[str, int],
+) -> dict[str, set[int]]:
+    """Validate ``state['repeat_until']``; return reached iteration indices by loop name."""
+    if repeat_until is None:
+        return {}
+    if not isinstance(repeat_until, Mapping):
+        raise _shape("repeat_until must be a mapping")
+    reached: dict[str, set[int]] = {}
+    rows = steps if isinstance(steps, Mapping) else {}
+    for name, entry in repeat_until.items():
+        prefix = f"repeat_until.{name}"
+        if not isinstance(entry, Mapping):
+            raise _shape(f"{prefix} must be a mapping")
+        current = entry.get("current_iteration")
+        if current is not None and not _is_int(current):
+            raise _shape(f"{prefix}.current_iteration must be null or a non-boolean integer")
+        if "exhausted" in entry and not isinstance(entry["exhausted"], bool):
+            raise _shape(f"{prefix}.exhausted must be boolean when present")
+        done = _history_set(prefix, entry)
+        maximum = maximum_by_name.get(str(name))
+        if current is not None:
+            if current < 0 or (maximum is not None and current >= maximum):
+                raise _progress(f"{prefix}.current_iteration is out of range")
+            _validate_active(prefix, current, entry, done)
+            reached[str(name)] = done | {current}
+        else:
+            _validate_terminal(prefix, entry, done, maximum, rows.get(name))
+            reached[str(name)] = done
+    return reached
+
+
+# --- slot enumeration -------------------------------------------------------------------
+
+
+def enumerate_resume_slots(
+    projection: "WorkflowStateProjection",
+    state: Mapping[str, Any],
+    repeat_until_maximums: Optional[Mapping[str, int]] = None,
+) -> ResumeProjectionSlotIndex:
+    """Index every identity the projection can own for this persisted state."""
+    item_counts = validate_for_each_bookkeeping(state.get("for_each"))
+    frame_max = dict(repeat_until_maximums or {})
+    reached = validate_repeat_until_bookkeeping(state.get("repeat_until"), state.get("steps"), frame_max)
+
+    iterations: dict[str, range] = {}
+    loops: list[Any] = []
+    for lp in projection.for_each_nodes.values():
+        iterations[lp.node_id] = range(item_counts.get(lp.frame_key, 0))
+        loops.append(lp)
+    for lp in projection.repeat_until_nodes.values():
+        known = reached.get(lp.frame_key, set())
+        declared = frame_max.get(lp.frame_key)
+        bound = declared if declared is not None else max(known, default=-1) + 1
+        iterations[lp.node_id] = range(bound)
+        loops.append(lp)
+
+    candidates: dict[str, list[ResumeSlot]] = {}
+    loop_body_nodes = {n for lp in loops for n in lp.nested_presentation_keys}
+    for node_id, entry in projection.entries_by_node_id.items():
+        if node_id not in loop_body_nodes:
+            candidates.setdefault(entry.step_id, []).append(
+                ResumeSlot(node_id, entry.region, None, entry.presentation_key)
+            )
+    for lp in loops:
+        for index in iterations[lp.node_id]:
+            for nested in lp.nested_presentation_keys:
+                entry = projection.entries_by_node_id.get(nested)
+                region = entry.region if entry is not None else WorkflowRegion.BODY
+                candidates.setdefault(lp.runtime_step_id(index, nested), []).append(
+                    ResumeSlot(nested, region, index, lp.step_key(index, nested))
+                )
+
+    boundaries: dict[str, list[Any]] = {}
+    for boundary in projection.call_boundaries.values():
+        owner = boundary.iteration_owner_node_id
+        if owner is None:
+            boundaries.setdefault(boundary.step_id, []).append(boundary)
+            continue
+        for index in iterations.get(owner, range(0)):
+            boundaries.setdefault(boundary.runtime_step_id(index), []).append(boundary)
+
+    claimed = {slot.presentation_key for slots in candidates.values() for slot in slots}
+    steps = state.get("steps")
+    unclaimed = tuple(
+        (str(name), _freeze(row["step_id"]))
+        for name, row in (steps.items() if isinstance(steps, Mapping) else ())
+        if isinstance(row, Mapping) and "step_id" in row and name not in claimed
+    )
+    return ResumeProjectionSlotIndex(
+        candidates_by_step_id={k: tuple(v) for k, v in candidates.items()},
+        call_boundaries_by_step_id={k: tuple(v) for k, v in boundaries.items()},
+        unclaimed_explicit_rows=unclaimed,
+    )
+
+
+def resolve_resume_step_id(
+    index: ResumeProjectionSlotIndex, step_id: Any, presentation_key: Optional[str] = None
+) -> ResumeIdentityResolution:
+    """Resolve one persisted id to its unique current slot; malformed ids resolve to nothing."""
+    if not isinstance(step_id, str):
+        return ResumeIdentityResolution(None, 0, 0)
+    slots = index.candidates_by_step_id.get(step_id, ())
+    exact = [s for s in slots if presentation_key is None or s.presentation_key == presentation_key]
+    return ResumeIdentityResolution(
+        exact[0] if len(exact) == 1 else None, len(slots), len(exact)
+    )
+
+
+def resolve_call_boundary(index: ResumeProjectionSlotIndex, call_step_id: Any) -> ResumeCallBoundaryResolution:
+    """Resolve a persisted caller id to the unique current call boundary."""
+    if not isinstance(call_step_id, str):
+        return ResumeCallBoundaryResolution(None, 0)
+    owners = index.call_boundaries_by_step_id.get(call_step_id, ())
+    return ResumeCallBoundaryResolution(owners[0] if len(owners) == 1 else None, len(owners))

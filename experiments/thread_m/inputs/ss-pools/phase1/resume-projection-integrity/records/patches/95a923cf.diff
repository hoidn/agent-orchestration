+
+_ROOT_TAIL = "steps:\n  - name: S\n    command: ['true']\n"
+
+
+@pytest.mark.parametrize(
+    "imports_text, expected",
+    [
+        # duplicate keys
+        ("imports:\n  x: a.yaml\n  x: b.yaml\n", ["imports.x: duplicate import alias", "line 4, column 3", "line 5, column 3"]),
+        # merge inside imports
+        (
+            "imports:\n  <<: {x: a.yaml}\n  x: b.yaml\n",
+            ["imports.x: duplicate import alias", "line 4, column 8", "line 5, column 3"],
+        ),
+        # repeated sections, same alias
+        (
+            "imports:\n  x: a.yaml\nimports:\n  x: b.yaml\n",
+            ["imports.x: duplicate import alias", "line 4, column 3", "line 6, column 3"],
+        ),
+        # top-level merge sources each carrying imports
+        (
+            "<<:\n  - {imports: {x: a.yaml}}\n  - {imports: {x: b.yaml}}\n",

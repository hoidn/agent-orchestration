+    assert result["status"] == "failed" and result["error"]["type"] == "resume_projection_integrity_error"
+    assert manager.state_file.read_bytes() == before
+    assert not (temp_workspace / "state" / "marker.txt").exists()
+
+
+def test_direct_executor_checksum_recheck_records_the_checksum_envelope(temp_workspace):
+    manager = _seed_valid_failed_root(temp_workspace, run_id="audit-checksum-direct")
+    bundle = WorkflowLoader(temp_workspace).load_bundle(temp_workspace / "valid_root.yaml")

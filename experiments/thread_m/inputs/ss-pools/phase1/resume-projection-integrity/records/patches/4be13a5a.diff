index 0000000..aa72049
--- /dev/null
+++ b/tests/test_workflow_lisp_frontend_kind_provenance.py
@@ -0,0 +1,89 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+
+SOURCE_ROOT = (
+    Path(__file__).parent / "fixtures" / "workflow_lisp" / "modules" / "valid" / "imported_bundle_mix"
+)
+
+SELECTOR_RUN_YAML = """\
+version: "2.14"
+name: selector-run
+inputs:
+  input__status:
+    kind: scalar
+    type: string
+  input__report:
+    kind: relpath
+    type: relpath
+    under: artifacts/work
+    must_exist_target: true
+  report_path:
+    kind: relpath
+    type: relpath
+    under: artifacts/work
+    must_exist_target: true
+outputs:
+  return__report:
+    kind: relpath
+    type: relpath
+    under: artifacts/work
+    must_exist_target: true
+    from:
+      ref: root.steps.Select.artifacts.report
+steps:
+  - name: Select
+    id: select
+    command: ["python", "scripts/select.py"]
+    output_bundle:
+      path: state/select.json
+      fields:
+        - name: report
+          json_pointer: /report
+          type: relpath
+          under: artifacts/work
+          must_exist_target: true
+"""
+
+
+def _compile(tmp_path: Path):
+    yaml_path = tmp_path / "selector_run.yaml"
+    yaml_path.write_text(SELECTOR_RUN_YAML, encoding="utf-8")
+    yaml_bundle = WorkflowLoader(tmp_path).load_bundle(yaml_path)
+    result = compile_stage3_entrypoint(
+        SOURCE_ROOT / "neurips" / "entry.orc",
+        source_roots=(SOURCE_ROOT,),
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={"prompts.implementation.execute": "prompts/implementation/execute.md"},
+        imported_workflow_bundles={"selector-run": yaml_bundle},
+        validate_shared=True,
+        workspace_root=tmp_path,
+        lowering_route="legacy",
+    )
+    return result, yaml_bundle
+
+
+def test_compiler_bundles_carry_workflow_lisp_frontend_kind(tmp_path: Path) -> None:
+    result, _ = _compile(tmp_path)
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+    helper = result.validated_bundles_by_name["neurips/helper::provider-attempt"]
+    lowered = result.entry_result.validated_bundles["neurips/entry::orchestrate"]
+
+    kinds = {
+        bundle.provenance.frontend_kind
+        for bundle in (entry, helper, lowered, *result.validated_bundles_by_name.values())
+    }
+    assert kinds == {"workflow_lisp"}
+
+
+def test_yaml_imported_bundle_keeps_its_provenance_and_identity(tmp_path: Path) -> None:
+    result, yaml_bundle = _compile(tmp_path)
+    entry = result.validated_bundles_by_name["neurips/entry::orchestrate"]
+
+    linked = entry.imports["selector-run"]
+    assert linked is yaml_bundle
+    assert linked.provenance.frontend_kind is None

+    def _loop_iteration_counts(self, state: Mapping[str, Any]) -> dict[str, int]:
+        """Return the possible iteration count per loop node id for one persisted state."""
+        for_each_state = state.get("for_each")
+        counts: dict[str, int] = {}
+        for node_id, projection in self.for_each_nodes.items():
+            progress = for_each_state.get(projection.frame_key) if isinstance(for_each_state, Mapping) else None
+            items = progress.get("items") if isinstance(progress, Mapping) else None
+            counts[node_id] = len(items) if isinstance(items, list) else 0
+        repeat_state = state.get("repeat_until")
+        for node_id, projection in self.repeat_until_nodes.items():
+            if isinstance(projection.max_iterations, int):
+                counts[node_id] = projection.max_iterations
+                continue
+            progress = repeat_state.get(projection.frame_key) if isinstance(repeat_state, Mapping) else None
+            seen = [] if not isinstance(progress, Mapping) else list(progress.get("completed_iterations") or [])
+            current = progress.get("current_iteration") if isinstance(progress, Mapping) else None
+            seen.extend([current] if isinstance(current, int) else [])
+            counts[node_id] = max((i for i in seen if isinstance(i, int)), default=-1) + 1
+        return counts
+
+    def _validate_loop_bookkeeping(self, state: Mapping[str, Any]) -> None:
+        if "for_each" in state:
+            validate_for_each_section(state["for_each"], {p.frame_key for p in self.for_each_nodes.values()})
+        if "repeat_until" in state:
+            validate_repeat_until_section(
+                state["repeat_until"],
+                state.get("steps"),
+                {
+                    projection.frame_key: projection.max_iterations
+                    for projection in self.repeat_until_nodes.values()
+                },
+            )
+
+    def enumerate_resume_slots(self, state: Mapping[str, Any]) -> ResumeProjectionSlotIndex:
+        """Enumerate every projection-owned persisted identity candidate for `state`.
+
+        Reads `state` only; never mutates or backfills it. Raises
+        `ResumeProjectionValidationError` for invalid loop bookkeeping.
+        """
+        self._validate_loop_bookkeeping(state)
+        counts = self._loop_iteration_counts(state)
+        loops = {**self.for_each_nodes, **self.repeat_until_nodes}
+        loop_local_node_ids = {
+            nested for projection in loops.values() for nested in projection.nested_presentation_keys
+        }
+        candidates: dict[str, list[ResumeStepSlot]] = {}
+
+        def add(slot: ResumeStepSlot) -> None:
+            candidates.setdefault(slot.step_id, []).append(slot)
+
+        for node_id, entry in self.entries_by_node_id.items():
+            if node_id not in loop_local_node_ids:
+                add(ResumeStepSlot(entry.step_id, node_id, entry.presentation_key, entry.region))
+        for loop_node_id, projection in loops.items():
+            is_for_each = loop_node_id in self.for_each_nodes
+            for iteration in range(counts.get(loop_node_id, 0)):
+                for nested in projection.nested_presentation_keys:
+                    entry = self.entries_by_node_id.get(nested)
+                    if entry is None:
+                        continue
+                    runtime_id = (
+                        self.for_each_runtime_step_id(loop_node_id, iteration, nested)
+                        if is_for_each
+                        else self.repeat_until_runtime_step_id(loop_node_id, iteration, nested)
+                    )
+                    add(
+                        ResumeStepSlot(
+                            runtime_id,
+                            nested,
+                            projection.step_key(iteration, nested),
+                            entry.region,
+                            iteration_index=iteration,
+                            loop_node_id=loop_node_id,
+                        )
+                    )
+
+        boundaries: dict[str, list[CallBoundaryProjection]] = {}
+        for node_id, boundary in self.call_boundaries.items():
+            owner = boundary.iteration_owner_node_id
+            for iteration in range(counts.get(owner, 0)) if owner is not None else (None,):
+                runtime_id = self.call_boundary_runtime_step_id(node_id, iteration_index=iteration)
+                boundaries.setdefault(runtime_id, []).append(boundary)
+
+        owned = frozenset(slot.presentation_key for slots in candidates.values() for slot in slots)
+        steps = state.get("steps")
+        unclaimed = tuple(
+            (name, deepcopy(row["step_id"]))
+            for name, row in (steps.items() if isinstance(steps, Mapping) else ())
+            if isinstance(row, Mapping) and "step_id" in row and name not in owned
+        )
+        return ResumeProjectionSlotIndex(
+            candidates_by_step_id={key: tuple(value) for key, value in candidates.items()},
+            call_boundaries_by_step_id={key: tuple(value) for key, value in boundaries.items()},
+            unclaimed_explicit_rows=unclaimed,
+            owned_presentation_keys=owned,
+        )
+
+    def resolve_resume_step_id(
+        self,
+        slot_index: ResumeProjectionSlotIndex,
+        step_id: Any,
+        presentation_key: Optional[str] = None,
+    ) -> ResumeIdentityResolution:
+        """Resolve one persisted step id to its unique candidate slot, if any."""
+        candidates = slot_index.candidates_by_step_id.get(step_id, ()) if isinstance(step_id, str) else ()
+        exact = tuple(
+            slot for slot in candidates if presentation_key is None or slot.presentation_key == presentation_key
+        )
+        return ResumeIdentityResolution(
+            slot=exact[0] if len(exact) == 1 else None,
+            candidate_count=len(candidates),
+            exact_identity_candidate_count=len(exact),
+        )
+
+    def resolve_call_boundary(
+        self,
+        slot_index: ResumeProjectionSlotIndex,
+        call_step_id: Any,
+    ) -> ResumeCallBoundaryResolution:
+        """Resolve one persisted caller id to the unique current call boundary, if any."""
+        found = slot_index.call_boundaries_by_step_id.get(call_step_id, ()) if isinstance(call_step_id, str) else ()
+        return ResumeCallBoundaryResolution(
+            boundary=found[0] if len(found) == 1 else None,
+            candidate_count=len(found),
+        )

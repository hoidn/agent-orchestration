+@pytest.mark.parametrize("stored_call_step_id", ["root.invoke_middle", "root.removed", None])
+def test_completed_frame_colliding_with_the_resumed_frame_id_is_rejected_before_any_child(
+    tmp_path: Path, stored_call_step_id
+):
+    bundle, manager = _completed_graph_run(tmp_path, "collision")
+    persisted = manager.load()
+    _, frame = next(iter(persisted.call_frames.items()))
+    # Resume re-enters the call step as visit 2, so this completed frame occupies the id it would take.
+    frame_id = "root.invoke_middle::visit::2"
+    persisted.call_frames = {frame_id: frame}
+    if stored_call_step_id is None:
+        frame.pop("call_step_id")
+    else:
+        frame["call_step_id"] = stored_call_step_id
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    frames_before = copy.deepcopy(manager.load().call_frames)
+
+    def unexpected(*_args, **_kwargs):
+        raise AssertionError("collision reached child construction")
+
+    with patch("orchestrator.workflow.executor.audit_scope"), patch(
+        "orchestrator.workflow.call_frame_state._CallFrameStateManager", side_effect=unexpected
+    ), patch("orchestrator.workflow.executor.WorkflowExecutor", side_effect=unexpected):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    error = result["steps"]["InvokeMiddle"]["error"]
+    assert error["type"] == "contract_violation"
+    assert error["context"] == {
+        "step": "InvokeMiddle",
+        "call": "middle",
+        "call_frame_id": frame_id,
+        "reason": "call_resume_state_invalid",
+        "detail": "completed_call_frame_id_collision",
+    }
+    assert manager.load().call_frames == frames_before

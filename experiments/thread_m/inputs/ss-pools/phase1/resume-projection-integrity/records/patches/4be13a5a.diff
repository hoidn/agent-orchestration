+def _state(**overrides: Any) -> dict[str, Any]:
+    state: dict[str, Any] = {"workflow_checksum": "sha256:abc", "steps": {}, "call_frames": {}}
+    state.update(overrides)
+    return state
+
+
+def _audit_error(bundle, state, scope=None) -> dict[str, Any]:
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        audit_scope(bundle, state, scope or ResumeScopePath.root("workflow.yaml"))
+    assert isinstance(exc_info.value, ValueError)
+    return exc_info.value.error
+
+
+def _frame(call_step_id="root.invoke_middle", status="running", alias="middle") -> dict[str, Any]:
+    return {"call_step_id": call_step_id, "import_alias": alias, "status": status, "state": {}}
+

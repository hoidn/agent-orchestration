+def test_call_frame_caller_alias_and_boundary_are_audited(call_bundle):
+    ok = _state(call_frames={"f": _frame()})
+    audit_scope(call_bundle, ok, ResumeScopePath.root("workflow.yaml"))
+
+    stale = _audit_error(call_bundle, _state(call_frames={"f": _frame(call_step_id="root.removed")}))["context"]
+    missing = _audit_error(call_bundle, _state(call_frames={"f": {"status": "running", "import_alias": "middle"}}))[
+        "context"
+    ]
+    alias = _audit_error(call_bundle, _state(call_frames={"f": _frame(alias="middle_duplicate_alias")}))["context"]
+    status = _audit_error(call_bundle, _state(call_frames={"f": _frame(status="weird")}))["context"]
+
+    assert (stale["reason"], stale["field"], stale["offending_value"], stale["candidate_count"]) == (
+        "out_of_scope_step_id",
+        "call_frames.f.call_step_id",
+        "root.removed",
+        0,
+    )
+    assert (missing["reason"], missing["field"]) == ("missing_required_identity", "call_frames.f.call_step_id")
+    assert (alias["reason"], alias["field"], alias["offending_value"], alias["candidate_count"]) == (
+        "persisted_import_alias_mismatch",
+        "call_frames.f.import_alias",
+        "middle_duplicate_alias",
+        1,
+    )
+    assert alias["call_boundary_step_id"] == "root.invoke_middle"
+    assert (status["reason"], status["field"]) == ("unsupported_shape", "call_frames.f.status")

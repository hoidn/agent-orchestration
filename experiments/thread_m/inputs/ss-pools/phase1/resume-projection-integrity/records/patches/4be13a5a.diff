diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..4f725bf
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,344 @@
+"""Checksum-compatible resume projection-integrity audit for one workflow scope.
+
+`audit_scope(bundle, state, scope_path)` compares every persisted durable identity of
+one scope (step rows, current step, loop bookkeeping, call frames) with the projection
+of the bundle that owns the scope, and raises `ResumeProjectionIntegrityError` before
+any resume mutation or effect can happen.
+
+Dependencies: only the bundle and state passed in. Nothing is loaded, hashed, read
+from disk, or mutated.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from .loaded_bundle import workflow_bundle, workflow_import_bundle, workflow_provenance
+from .resume_retry_lineage import (
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .resume_slots import ResumeProjectionValidationError, ResumeProjectionSlotIndex
+
+__all__ = [
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RESUME_PROJECTION_ERROR_TYPE",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "RetryFrameMember",
+    "audit_scope",
+    "index_retry_lineage",
+    "projection_error_in_result",
+    "next_unused_retry_frame_id",
+    "projection_integrity_error",
+]
+
+RESUME_PROJECTION_ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_FRAME_STATUSES = frozenset({"running", "failed", "completed"})
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow to the audited scope."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Raised when a persisted scope disagrees with the projection that owns it."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def projection_integrity_error(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    reason: str,
+    *,
+    field: Optional[str] = None,
+    offending_value: Any = None,
+    candidate_count: Optional[int] = None,
+    call_boundary_step_id: Optional[str] = None,
+) -> ResumeProjectionIntegrityError:
+    """Build the stable diagnostic for one failed audit of `bundle`'s scope."""
+    provenance = workflow_provenance(bundle)
+    workflow_path = getattr(provenance, "workflow_path", None)
+    checksum = state.get("workflow_checksum") if isinstance(state, Mapping) else None
+    return ResumeProjectionIntegrityError(
+        {
+            "type": RESUME_PROJECTION_ERROR_TYPE,
+            "message": f"Resume projection integrity audit failed: {reason}",
+            "context": {
+                "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                "reason": reason,
+                "scope_path": scope_path.as_context(),
+                "field": field,
+                "offending_value": _scalar(offending_value),
+                "expected_owner": {
+                    "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                    "workflow_checksum": checksum if isinstance(checksum, str) else None,
+                    "projection_scope": scope_path.projection_scope,
+                },
+                "candidate_count": candidate_count,
+                "call_boundary_step_id": call_boundary_step_id if isinstance(call_boundary_step_id, str) else None,
+            },
+        }
+    )
+
+
+class _ScopeAudit:
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        loaded = workflow_bundle(bundle)
+        if loaded is None:
+            raise TypeError("audit_scope requires a LoadedWorkflowBundle")
+        self.bundle = loaded
+        self.projection = loaded.projection
+        self.state = state
+        self.scope_path = scope_path
+        self.slot_index: ResumeProjectionSlotIndex
+
+    def fail(self, reason: str, **details: Any) -> NoReturn:
+        raise projection_integrity_error(self.bundle, self.state, self.scope_path, reason, **details)
+
+    def container(self, key: str) -> Mapping[str, Any]:
+        value = self.state.get(key, {})
+        if not isinstance(value, Mapping):
+            self.fail("unsupported_shape", field=key)
+        return value
+
+    def run(self) -> None:
+        steps = self.container("steps")
+        frames = self.container("call_frames")
+        try:
+            self.slot_index = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            self.fail(exc.reason, field=exc.field, offending_value=exc.value)
+        self.audit_current_step()
+        self.audit_step_rows(steps)
+        self.audit_call_frames(frames)
+
+    def explicit_id(self, value: Any, field: str) -> str:
+        if not isinstance(value, str) or not value:
+            self.fail("unsupported_shape", field=field, offending_value=value)
+        return value
+
+    def audit_current_step(self) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            self.fail("unsupported_shape", field="current_step")
+        field = "current_step.step_id"
+        if current.get("step_id") is None:
+            self.fail("missing_required_identity", field=field)
+        step_id = self.explicit_id(current["step_id"], field)
+        name = current.get("name")
+        resolution = self.projection.resolve_resume_step_id(
+            self.slot_index, step_id, name if isinstance(name, str) and name else None
+        )
+        if resolution.candidate_count == 0:
+            self.fail("out_of_scope_step_id", field=field, offending_value=step_id, candidate_count=0)
+        if resolution.slot is None:
+            self.fail(
+                "presentation_slot_mismatch",
+                field=field,
+                offending_value=step_id,
+                candidate_count=resolution.candidate_count,
+            )
+        expected_index = self.projection.execution_index_for_step_id(step_id)
+        index = current.get("index")
+        if isinstance(index, int) and isinstance(expected_index, int) and index != expected_index:
+            self.fail(
+                "presentation_slot_mismatch",
+                field="current_step.index",
+                offending_value=index,
+                candidate_count=1,
+            )
+
+    def audit_step_rows(self, steps: Mapping[str, Any]) -> None:
+        for name, row in steps.items():
+            if isinstance(row, list):
+                self.audit_loop_result_rows(name, row)
+                continue
+            if not isinstance(row, Mapping):
+                self.fail("unsupported_shape", field=f"steps.{name}")
+            self.audit_row_identity(f"steps.{name}", name, row)
+
+    def audit_loop_result_rows(self, loop_name: str, results: list[Any]) -> None:
+        for_each = next((p for p in self.projection.for_each_nodes.values() if p.frame_key == loop_name), None)
+        if for_each is None:
+            self.fail("unsupported_shape", field=f"steps.{loop_name}")
+        progress = (self.state.get("for_each") or {}).get(loop_name)
+        items = progress.get("items") if isinstance(progress, Mapping) else None
+        if len(results) > (len(items) if isinstance(items, list) else 0):
+            self.fail("invalid_loop_progress", field=f"steps.{loop_name}")
+        for index, iteration in enumerate(results):
+            if not isinstance(iteration, Mapping):
+                self.fail("unsupported_shape", field=f"steps.{loop_name}")
+            for nested_name, row in iteration.items():
+                path = f"steps.{loop_name}[{index}].{nested_name}"
+                if not isinstance(row, Mapping):
+                    self.fail("unsupported_shape", field=path)
+                self.audit_row_identity(path, f"{loop_name}[{index}].{nested_name}", row)
+
+    def audit_row_identity(self, path: str, key: str, row: Mapping[str, Any]) -> None:
+        if "step_id" not in row:
+            return
+        field = f"{path}.step_id"
+        step_id = self.explicit_id(row["step_id"], field)
+        if key not in self.slot_index.owned_presentation_keys:
+            self.fail("unclaimed_explicit_step_row", field=field, offending_value=step_id, candidate_count=0)
+        resolution = self.projection.resolve_resume_step_id(self.slot_index, step_id, key)
+        if resolution.slot is not None:
+            return
+        reason = "unknown_explicit_step_id" if resolution.candidate_count == 0 else "presentation_slot_mismatch"
+        self.fail(
+            reason,
+            field=field,
+            offending_value=step_id,
+            candidate_count=resolution.candidate_count if reason == "presentation_slot_mismatch" else 0,
+        )
+
+    def audit_call_frames(self, frames: Mapping[str, Any]) -> None:
+        by_boundary: dict[str, list[tuple[str, Mapping[str, Any]]]] = {}
+        frontend_kinds: dict[str, Optional[str]] = {}
+        for frame_id, frame in frames.items():
+            call_step_id, frontend_kind = self.audit_frame(frame_id, frame)
+            by_boundary.setdefault(call_step_id, []).append((frame_id, frame))
+            frontend_kinds[call_step_id] = frontend_kind
+        for call_step_id, items in by_boundary.items():
+            try:
+                index_retry_lineage(call_step_id, items, frontend_kind=frontend_kinds[call_step_id])
+            except CallFrameRetryLineageError as exc:
+                self.fail_lineage(exc, call_step_id, items)
+
+    def fail_lineage(
+        self,
+        exc: CallFrameRetryLineageError,
+        call_step_id: str,
+        items: list[tuple[str, Mapping[str, Any]]],
+    ) -> NoReturn:
+        if exc.reason == "ambiguous_resumable_call_frame":
+            resumable = sum(1 for _, frame in items if frame.get("status") != "completed")
+            self.fail(
+                exc.reason,
+                field="call_frames",
+                offending_value=resumable,
+                candidate_count=resumable,
+                call_boundary_step_id=call_step_id,
+            )
+        field = f"call_frames.{exc.frame_id}" if exc.frame_id else "call_frames"
+        self.fail(exc.reason, field=field, call_boundary_step_id=call_step_id)
+
+    def audit_frame(self, frame_id: str, frame: Any) -> tuple[str, Optional[str]]:
+        base = f"call_frames.{frame_id}"
+        if not isinstance(frame, Mapping):
+            self.fail("unsupported_shape", field=base)
+        field = f"{base}.call_step_id"
+        if frame.get("call_step_id") is None:
+            self.fail("missing_required_identity", field=field)
+        call_step_id = self.explicit_id(frame["call_step_id"], field)
+        boundaries = self.slot_index.call_boundaries_by_step_id.get(call_step_id, ())
+        if len(boundaries) > 1:
+            self.fail(
+                "ambiguous_call_boundary",
+                field=field,
+                offending_value=call_step_id,
+                candidate_count=len(boundaries),
+                call_boundary_step_id=call_step_id,
+            )
+        if not boundaries:
+            local = call_step_id in self.slot_index.candidates_by_step_id
+            self.fail(
+                "missing_call_boundary" if local else "out_of_scope_step_id",
+                field=field,
+                offending_value=call_step_id,
+                candidate_count=0,
+                call_boundary_step_id=call_step_id,
+            )
+        alias = boundaries[0].import_alias
+        frontend_kind = None
+        if alias is not None:
+            if frame.get("import_alias") != alias:
+                self.fail(
+                    "persisted_import_alias_mismatch",
+                    field=f"{base}.import_alias",
+                    offending_value=frame.get("import_alias"),
+                    candidate_count=1,
+                    call_boundary_step_id=call_step_id,
+                )
+            imported = workflow_import_bundle(self.bundle, alias)
+            if imported is None:
+                self.fail(
+                    "missing_imported_bundle",
+                    field=f"imports.{alias}",
+                    offending_value=alias,
+                    candidate_count=1,
+                    call_boundary_step_id=call_step_id,
+                )
+            imported_provenance = workflow_provenance(imported)
+            frontend_kind = getattr(imported_provenance, "frontend_kind", None)
+        if frame.get("status") not in _FRAME_STATUSES:
+            self.fail(
+                "unsupported_shape",
+                field=f"{base}.status",
+                offending_value=frame.get("status"),
+                call_boundary_step_id=call_step_id,
+            )
+        return call_step_id, frontend_kind
+
+
+def audit_scope(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against `bundle`'s current projection."""
+    if not isinstance(state, Mapping) and hasattr(state, "to_dict"):
+        state = state.to_dict()
+    if not isinstance(state, Mapping):
+        raise TypeError("audit_scope requires a mapping state")
+    _ScopeAudit(bundle, state, scope_path).run()
+
+
+def projection_error_in_result(result: Any) -> Optional[dict[str, Any]]:
+    """Return the projection diagnostic carried by a step result (directly or as a nested cause)."""
+    error = result.get("error") if isinstance(result, Mapping) else None
+    while isinstance(error, Mapping):
+        if error.get("type") == RESUME_PROJECTION_ERROR_TYPE:
+            return error  # type: ignore[return-value]
+        context = error.get("context")
+        error = context.get("error") if isinstance(context, Mapping) else None
+    return None

@@ -0,0 +1,38 @@
+"""Root-workflow checksum recheck for a structurally-root resumed executor."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+
+def root_checksum_mismatch(
+    *,
+    state: Mapping[str, Any],
+    state_manager: Any,
+    workspace: Path,
+) -> Optional[dict[str, Optional[str]]]:
+    """Return `record_workflow_checksum_mismatch` kwargs when the root checksum no longer holds.
+
+    Compares the checksum recorded in `state` with the current checksum of the file named by
+    `state["workflow_file"]`, computed through `state_manager.calculate_checksum`; returns None
+    when they agree.
+    """
+    persisted = state.get("workflow_checksum")
+    workflow_file = state.get("workflow_file")
+    details: dict[str, Optional[str]] = {
+        "workflow_file": workflow_file if isinstance(workflow_file, str) else None,
+        "persisted_checksum": persisted if isinstance(persisted, str) else None,
+        "current_checksum": None,
+    }
+    if not isinstance(persisted, str) or not persisted.startswith("sha256:"):
+        return {**details, "reason": "missing_recorded_checksum"}
+    if not isinstance(workflow_file, str) or not workflow_file:
+        return {**details, "reason": "missing_workflow_path"}
+    try:
+        current = state_manager.calculate_checksum(workspace / workflow_file)
+    except FileNotFoundError:
+        return {**details, "reason": "workflow_unavailable"}
+    if current == persisted:
+        return None
+    return {**details, "current_checksum": current, "reason": "workflow_modified"}

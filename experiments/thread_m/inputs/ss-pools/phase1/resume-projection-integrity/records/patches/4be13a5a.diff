+def test_reached_call_resolves_each_caller_identity_with_one_positional_boundary_lookup(tmp_path: Path):
+    bundle, manager = _completed_graph_run(tmp_path, "boundary-lookup")
+    _reopen(manager)
+    calls: list[tuple[tuple, dict]] = []
+    original = WorkflowStateProjection.resolve_call_boundary
+
+    def counting(self, *args, **kwargs):
+        calls.append((args[1:], kwargs))
+        return original(self, *args, **kwargs)
+
+    with patch.object(WorkflowStateProjection, "resolve_call_boundary", counting):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert result["status"] == "completed"
+    assert [identity for identity, _ in calls] == [("root.invoke_middle",), ("root.invoke_leaf",)]
+    assert all(kwargs == {} for _, kwargs in calls)

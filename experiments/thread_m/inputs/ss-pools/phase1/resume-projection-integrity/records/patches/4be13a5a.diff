diff --git a/orchestrator/loader_imports.py b/orchestrator/loader_imports.py
new file mode 100644
index 0000000..e63bbcd
--- /dev/null
+++ b/orchestrator/loader_imports.py
@@ -0,0 +1,65 @@
+"""Composed-YAML checks for duplicate workflow `imports` aliases and sections.
+
+PyYAML construction silently collapses duplicate mapping keys and `<<` merges,
+so these checks walk the composed node graph before construction.
+"""
+
+from typing import Dict, Iterator, List, Tuple
+
+import yaml
+
+MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _merge_sources(value: yaml.Node) -> List[yaml.Node]:
+    if isinstance(value, yaml.SequenceNode):
+        return [item for item in value.value if isinstance(item, yaml.MappingNode)]
+    return [value] if isinstance(value, yaml.MappingNode) else []
+
+
+def _effective_entries(node: yaml.MappingNode, seen: frozenset = frozenset()) -> Iterator[Tuple[yaml.Node, yaml.Node]]:
+    """Yield every (key, value) pair of a mapping, expanding `<<` merge sources in place."""
+    if id(node) in seen:
+        return
+    seen = seen | {id(node)}
+    for key, value in node.value:
+        if key.tag == MERGE_TAG:
+            for source in _merge_sources(value):
+                yield from _effective_entries(source, seen)
+        else:
+            yield key, value
+
+
+def _scalar_key(node: yaml.Node):
+    return node.value if isinstance(node, yaml.ScalarNode) else None
+
+
+def find_import_duplicate_errors(root: yaml.Node) -> List[str]:
+    """Return messages for repeated import aliases or repeated top-level `imports` sections."""
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [(key, value) for key, value in _effective_entries(root) if _scalar_key(key) == "imports"]
+    occurrences: Dict[str, List[yaml.Node]] = {}
+    for _, section in sections:
+        if isinstance(section, yaml.MappingNode):
+            for key, _ in _effective_entries(section):
+                alias = _scalar_key(key)
+                if alias is not None:
+                    occurrences.setdefault(alias, []).append(key)
+
+    def describe(nodes: List[yaml.Node]) -> str:
+        ordered = sorted(nodes, key=lambda n: (n.start_mark.line, n.start_mark.column))
+        return "; ".join(_position(n) for n in ordered)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias ({describe(nodes)})"
+        for alias, nodes in occurrences.items()
+        if len(nodes) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(f"imports: duplicate top-level mapping ({describe([key for key, _ in sections])})")
+    return errors

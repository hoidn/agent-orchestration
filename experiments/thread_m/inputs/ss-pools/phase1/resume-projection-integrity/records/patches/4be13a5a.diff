@@ -0,0 +1,250 @@
+"""Resume identity slots and loop-bookkeeping validation for projection-owned resume audits.
+
+Dependencies: `executable_ir.WorkflowRegion` only. All inputs are plain persisted
+state mappings; nothing here mutates, backfills, or loads anything.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any, Collection, Mapping, Optional
+
+from .executable_ir import WorkflowRegion
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Raised when persisted resume bookkeeping cannot be interpreted against a projection."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+        self.value = value
+
+    def __str__(self) -> str:
+        return self.message
+
+
+@dataclass(frozen=True)
+class ResumeStepSlot:
+    """One projection-owned persisted step identity candidate."""
+
+    step_id: str
+    node_id: str
+    presentation_key: str
+    region: WorkflowRegion
+    iteration_index: Optional[int] = None
+    loop_node_id: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class ResumeProjectionSlotIndex:
+    """Candidate identities enumerated from one projection and one persisted state."""
+
+    candidates_by_step_id: Mapping[str, tuple[ResumeStepSlot, ...]]
+    call_boundaries_by_step_id: Mapping[str, tuple[Any, ...]]
+    unclaimed_explicit_rows: tuple[tuple[str, Any], ...] = ()
+    owned_presentation_keys: frozenset[str] = frozenset()
+
+
+@dataclass(frozen=True)
+class ResumeIdentityResolution:
+    """Outcome of resolving one persisted step id against the candidate index."""
+
+    slot: Optional[ResumeStepSlot]
+    candidate_count: int
+    exact_identity_candidate_count: int
+
+
+@dataclass(frozen=True)
+class ResumeCallBoundaryResolution:
+    """Outcome of resolving one persisted caller id against current call boundaries."""
+
+    boundary: Optional[Any]
+    candidate_count: int
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def _shape(message: str, field: Optional[str] = None, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field=field, value=_scalar(value))
+
+
+def _progress(message: str, field: Optional[str] = None, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field=field, value=_scalar(value))
+
+
+def _index_list(progress: Mapping[str, Any], key: str, path: str) -> list[int]:
+    raw = progress.get(key, [])
+    if not isinstance(raw, list):
+        raise _shape(f"{path}.{key} must be a list", f"{path}.{key}")
+    if any(not _is_int(item) for item in raw):
+        raise _shape(f"{path}.{key} must contain only non-boolean integers", f"{path}.{key}")
+    return list(raw)
+
+
+def validate_for_each_section(section: Any, known_names: Collection[str]) -> None:
+    """Validate every persisted `for_each` bookkeeping entry; names must be owned by the projection."""
+    if not isinstance(section, Mapping):
+        raise _shape("for_each must be a mapping", "for_each")
+    for name, progress in section.items():
+        path = f"for_each.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{path} must be a mapping", path)
+        items = progress.get("items")
+        if not isinstance(items, list):
+            raise _shape(f"{path}.items must be a list", f"{path}.items")
+        current = progress.get("current_index")
+        if current is not None and not _is_int(current):
+            raise _shape(
+                f"{path}.current_index must be null or a non-boolean integer",
+                f"{path}.current_index",
+                current,
+            )
+        completed = _index_list(progress, "completed_indices", path)
+        field = f"{path}.completed_indices"
+        if len(set(completed)) != len(completed):
+            raise _progress(f"{field} must not contain duplicate indices", field)
+        if any(not 0 <= index < len(items) for index in completed):
+            raise _progress(f"{field} contains an out-of-range index", field)
+        if current is not None and not 0 <= current < len(items):
+            raise _progress(f"{path}.current_index is out of range", f"{path}.current_index", current)
+        if current in completed:
+            raise _progress(f"{path}.current_index is already completed", f"{path}.current_index", current)
+        if name not in known_names:
+            raise _progress(f"{path} is not a loop of the current workflow", path)
+
+
+def _validate_active_repeat_until(
+    progress: Mapping[str, Any],
+    path: str,
+    current: int,
+    completed: list[int],
+    maximum: Optional[int],
+) -> None:
+    if current < 0 or (maximum is not None and current >= maximum):
+        raise _progress(f"{path}.current_iteration is out of range", f"{path}.current_iteration", current)
+    field = f"{path}.completed_iterations"
+    if sorted(completed) != list(range(current)):
+        raise _progress(f"{field} is not valid prior history", field)
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    consistent = (
+        (evaluated is None and result is None)
+        or (_is_int(evaluated) and evaluated == current and isinstance(result, bool))
+    )
+    if not consistent or progress.get("exhausted") is True:
+        raise _progress(
+            f"{path}.condition result conflicts with evaluation state",
+            f"{path}.last_condition_result",
+            result,
+        )
+
+
+def _validate_terminal_repeat_until(
+    progress: Mapping[str, Any],
+    path: str,
+    completed: list[int],
+    maximum: Optional[int],
+    row: Any,
+) -> None:
+    field = f"{path}.completed_iterations"
+    if (maximum is not None and any(index < 0 or index >= maximum for index in completed)) or (
+        completed and sorted(completed) != list(range(max(completed) + 1))
+    ):
+        raise _progress(f"{field} is not valid prior history", field)
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    if not _is_int(evaluated) or not completed or evaluated != max(completed):
+        raise _progress(
+            f"{path}.terminal progress requires completed evaluated history",
+            f"{path}.condition_evaluated_for_iteration",
+            evaluated,
+        )
+    result = progress.get("last_condition_result")
+    exhausted = progress.get("exhausted") is True
+    conflict = _progress(
+        f"{path}.condition result conflicts with evaluation state",
+        f"{path}.last_condition_result",
+        result,
+    )
+    if not isinstance(result, bool) or (result and exhausted):
+        raise conflict
+    if result:
+        return
+    if maximum is not None and sorted(completed) != list(range(maximum)):
+        raise _progress(
+            f"{path}.terminal progress requires completed evaluated history",
+            field,
+        )
+    status = row.get("status") if isinstance(row, Mapping) else None
+    if exhausted and status != "completed":
+        raise _progress(f"{path}.successful exhaustion requires a completed frame", f"{path}.exhausted")
+    error = row.get("error") if isinstance(row, Mapping) else None
+    error_type = error.get("type") if isinstance(error, Mapping) else None
+    if not exhausted and (status != "failed" or error_type != EXHAUSTION_ERROR_TYPE):
+        raise _progress(f"{path}.failed exhaustion requires the terminal exhaustion error", f"{path}.exhausted")
+
+
+def _validate_no_future_rows(name: str, steps: Any, last_iteration: int) -> None:
+    """Reject persisted iteration rows beyond the loop's last started iteration."""
+    prefix = re.compile(rf"{re.escape(name)}\[(\d+)\]\.")
+    for key in steps if isinstance(steps, Mapping) else ():
+        match = prefix.match(key) if isinstance(key, str) else None
+        if match and int(match.group(1)) > last_iteration:
+            raise _progress(f"repeat_until.{name} has step rows beyond its progress", f"steps.{key}")
+
+
+def validate_repeat_until_section(
+    section: Any,
+    steps: Any,
+    max_iterations_by_name: Mapping[str, Optional[int]],
+) -> None:
+    """Validate every persisted `repeat_until` bookkeeping entry."""
+    if not isinstance(section, Mapping):
+        raise _shape("repeat_until must be a mapping", "repeat_until")
+    for name, progress in section.items():
+        path = f"repeat_until.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{path} must be a mapping", path)
+        current = progress.get("current_iteration")
+        if current is not None and not _is_int(current):
+            raise _shape(
+                f"{path}.current_iteration must be null or a non-boolean integer",
+                f"{path}.current_iteration",
+                current,
+            )
+        if "exhausted" in progress and not isinstance(progress["exhausted"], bool):
+            raise _shape(f"{path}.exhausted must be boolean when present", f"{path}.exhausted", progress["exhausted"])
+        completed = _index_list(progress, "completed_iterations", path)
+        if len(set(completed)) != len(completed):
+            raise _progress(
+                f"{path}.completed_iterations must not contain duplicate indices",
+                f"{path}.completed_iterations",
+            )
+        maximum = max_iterations_by_name.get(name)
+        if current is not None:
+            _validate_active_repeat_until(progress, path, current, completed, maximum)
+            _validate_no_future_rows(name, steps, current)
+        else:
+            row = steps.get(name) if isinstance(steps, Mapping) else None
+            _validate_terminal_repeat_until(progress, path, completed, maximum, row)
+            _validate_no_future_rows(name, steps, max(completed))
+        if name not in max_iterations_by_name:
+            raise _progress(f"{path} is not a loop of the current workflow", path)

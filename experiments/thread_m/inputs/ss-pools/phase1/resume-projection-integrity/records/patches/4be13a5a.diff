@@ -0,0 +1,157 @@
+"""Call-frame retry lineage indexing for one call boundary.
+
+Pure functions over `(frame_id, frame)` pairs; reads nothing else. A Workflow Lisp
+boundary's non-completed frames form one lineage `B`, `B::retry::1`, `B::retry::2`...
+with at most one running member; any other boundary has at most one non-completed
+frame.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+_STATUSES = frozenset({"running", "failed", "completed"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Raised when the frames of one call boundary do not form a valid lineage."""
+
+    def __init__(self, reason: str, message: str, *, frame_id: Optional[str] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.frame_id = frame_id
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    """One persisted call frame of a boundary."""
+
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    """One lineage member with its retry ordinal (0 for the base frame)."""
+
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    """Classified frames of one call boundary."""
+
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...] = ()
+    failed_predecessors: tuple[CallFrameMember, ...] = ()
+    running_member: Optional[CallFrameMember] = None
+
+
+def _error(reason: str, message: str, frame_id: Optional[str] = None) -> CallFrameRetryLineageError:
+    return CallFrameRetryLineageError(reason, message, frame_id=frame_id)
+
+
+def _split_frame_id(frame_id: Any) -> tuple[str, int]:
+    """Return `(base, ordinal)` for a frame id, rejecting malformed retry markers."""
+    if not isinstance(frame_id, str) or not frame_id:
+        raise _error("unsupported_shape", "call frame id must be a non-empty string")
+    if RETRY_MARKER not in frame_id:
+        return frame_id, 0
+    base, _, tail = frame_id.partition(RETRY_MARKER)
+    if RETRY_MARKER in tail or not base:
+        raise _error("unsupported_shape", f"call frame '{frame_id}' has a nested or empty retry marker", frame_id)
+    if not (tail.isascii() and tail.isdigit()) or int(tail) < 1 or str(int(tail)) != tail:
+        raise _error("unsupported_shape", f"call frame '{frame_id}' has a malformed retry ordinal", frame_id)
+    return base, int(tail)
+
+
+def _check_frame(boundary_step_id: str, frame_id: Any, frame: Any) -> str:
+    if not isinstance(frame, Mapping):
+        raise _error("unsupported_shape", "call frame must be a mapping", frame_id)
+    if frame.get("call_step_id") != boundary_step_id:
+        raise _error("missing_call_boundary", "call frame is not owned by this call boundary", frame_id)
+    status = frame.get("status")
+    if status not in _STATUSES:
+        raise _error("unsupported_shape", "call frame has an unknown status", frame_id)
+    return status
+
+
+def _unique_alias(frames: list[tuple[Any, Mapping[str, Any]]]) -> None:
+    aliases = {frame.get("import_alias") for _, frame in frames}
+    if len(aliases) > 1:
+        raise _error("persisted_import_alias_mismatch", "call frames of one boundary use different import aliases")
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Mapping[str, Any]]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Classify the frames of one boundary into completed, failed and running members."""
+    pairs = list(frame_items)
+    statuses = [_check_frame(boundary_step_id, frame_id, frame) for frame_id, frame in pairs]
+    _unique_alias(pairs)
+    members = [CallFrameMember(frame_id, status) for (frame_id, _), status in zip(pairs, statuses)]
+    resumable = [member for member in members if member.status != "completed"]
+    completed = tuple(member for member in members if member.status == "completed")
+    if frontend_kind != WORKFLOW_LISP_FRONTEND_KIND:
+        if len(resumable) > 1:
+            raise _error("ambiguous_resumable_call_frame", "more than one resumable call frame for one boundary")
+        return CallFrameRetryLineage(
+            base_frame_id=resumable[0].frame_id if resumable else None,
+            completed_members=completed,
+            running_member=resumable[0] if resumable else None,
+        )
+    return _workflow_lisp_lineage(resumable, completed)
+
+
+def _workflow_lisp_lineage(
+    resumable: list[CallFrameMember],
+    completed: tuple[CallFrameMember, ...],
+) -> CallFrameRetryLineage:
+    split = [(member, *_split_frame_id(member.frame_id)) for member in resumable]
+    bases = {base for _, base, _ in split}
+    if len(bases) > 1:
+        raise _error("ambiguous_resumable_call_frame", "retry lineage mixes frame bases")
+    base = next(iter(bases), None)
+    members = [RetryFrameMember(member.frame_id, member.status, ordinal) for member, _, ordinal in split]
+    if len({member.ordinal for member in members}) != len(members):
+        raise _error("ambiguous_resumable_call_frame", "retry lineage repeats an ordinal")
+    running = [member for member in members if member.status == "running"]
+    if len(running) > 1:
+        raise _error("ambiguous_resumable_call_frame", "retry lineage has more than one running member")
+    historical = []
+    for member in completed:
+        try:
+            member_base, ordinal = _split_frame_id(member.frame_id)
+        except CallFrameRetryLineageError:
+            historical.append(member)
+            continue
+        same_lineage = base is not None and member_base == base
+        historical.append(RetryFrameMember(member.frame_id, member.status, ordinal) if same_lineage else member)
+    failed = sorted((m for m in members if m.status == "failed"), key=lambda m: m.ordinal)
+    return CallFrameRetryLineage(
+        base_frame_id=base,
+        completed_members=tuple(historical),
+        failed_predecessors=tuple(failed),
+        running_member=running[0] if running else None,
+    )
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return `<base>::retry::<n>` for the lowest unused positive ordinal."""
+    if lineage.base_frame_id is None:
+        raise ValueError("retry lineage has no base frame id")
+    used = {
+        member.ordinal
+        for member in (*lineage.completed_members, *lineage.failed_predecessors, lineage.running_member)
+        if isinstance(member, RetryFrameMember)
+    }
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

+"""Runtime ordering and envelope tests for checksum-compatible resume projection integrity."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.loaded_bundle import workflow_import_bundle
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow.state_projection import WorkflowStateProjection
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+ENVELOPE_KEYS = {"status", "error", "updated_at"}
+
+
+def _completed_graph_run(tmp_path: Path, run_id: str):
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    return bundle, manager
+
+
+def _reopen(manager: StateManager, *, leaf_current_step: dict | None = None):
+    """Mark the completed run failed with a running middle frame, optionally corrupting the leaf scope."""
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["steps"]["InvokeLeaf"]["status"] = "failed"
+    if leaf_current_step is not None:
+        _, leaf_frame = next(iter(frame["state"]["call_frames"].items()))
+        leaf_frame["status"] = "running"
+        leaf_frame["state"]["status"] = "failed"
+        leaf_frame["state"]["current_step"] = leaf_current_step
+    manager._write_state()
+    return frame_id
+
+
+def _non_envelope(state: dict) -> dict:
+    return {key: value for key, value in state.items() if key not in ENVELOPE_KEYS}
+
+
+def test_state_manager_records_envelopes_changing_only_status_error_and_updated_at(tmp_path: Path):
+    manager = StateManager(tmp_path, run_id="envelope")
+    (tmp_path / "workflow.yaml").write_text("version: '2.0'\n", encoding="utf-8")
+    manager.initialize("workflow.yaml")
+    raw = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    raw["unknown_root_field"] = {"keep": True}
+    raw["current_step"] = {"name": "X", "status": "running", "step_id": "root.x"}
+    manager.state_file.write_text(json.dumps(raw), encoding="utf-8")
+    before = json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="workflow.yaml",
+        persisted_checksum="sha256:a",
+        current_checksum=None,
+        reason="workflow_unavailable",
+    )
+    after_checksum = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    diagnostic = {"type": "resume_projection_integrity_error", "message": "m", "context": {}}
+    manager.record_resume_projection_integrity_failure(diagnostic)
+    after_integrity = json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+    assert after_checksum["error"] == {
+        "type": "workflow_checksum_mismatch",
+        "message": "Workflow has been modified since the run started",
+        "context": {
+            "workflow_file": "workflow.yaml",
+            "persisted_checksum": "sha256:a",
+            "current_checksum": None,
+            "reason": "workflow_unavailable",
+        },
+    }
+    assert after_integrity["error"] == diagnostic
+    for after in (after_checksum, after_integrity):
+        assert after["status"] == "failed"
+        assert _non_envelope(after) == _non_envelope(before)
+        assert after["current_step"]["status"] == "running"
+    assert after_integrity["updated_at"] != before["updated_at"]
+
+
+@pytest.mark.parametrize(
+    "reason",
+    ["workflow_modified", "missing_recorded_checksum", "missing_workflow_path", "workflow_unavailable"],
+)
+def test_structural_root_executor_checksum_failure_stops_before_audit_and_prologue(tmp_path: Path, reason: str):
+    bundle, manager = _completed_graph_run(tmp_path, f"checksum-{reason}")
+    _reopen(manager)
+    persisted = manager.load()
+    recorded = persisted.workflow_checksum
+    if reason == "workflow_modified":
+        (tmp_path / "workflow.yaml").write_text(
+            (tmp_path / "workflow.yaml").read_text(encoding="utf-8") + "\n# edited\n", encoding="utf-8"
+        )
+    elif reason == "missing_recorded_checksum":
+        persisted.workflow_checksum = ""
+    elif reason == "missing_workflow_path":
+        persisted.workflow_file = ""
+    else:
+        (tmp_path / "workflow.yaml").unlink()
+    manager._write_state()
+    before = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    events: list[str] = []
+
+    with patch("orchestrator.workflow.executor.audit_scope", side_effect=lambda *a: events.append("audit")), patch.object(
+        WorkflowExecutor, "_execute_prologue", side_effect=lambda *a, **k: events.append("prologue")
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert events == []
+    assert result["status"] == "failed"
+    assert after["error"]["type"] == "workflow_checksum_mismatch"
+    assert after["error"]["message"] == "Workflow has been modified since the run started"
+    context = after["error"]["context"]
+    assert context["reason"] == reason
+    assert set(context) == {"workflow_file", "persisted_checksum", "current_checksum", "reason"}
+    assert context["persisted_checksum"] == (recorded if reason != "missing_recorded_checksum" else "")
+    assert (context["current_checksum"] is None) == (reason != "workflow_modified")
+    assert after["status"] == "failed"
+    assert _non_envelope(after) == _non_envelope(before)
+

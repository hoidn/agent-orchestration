+def _workflow_lisp_lineage(tmp_path: Path, run_id: str):
+    """A failed base frame plus a running retry frame for the Workflow Lisp-typed middle boundary."""
+    bundle, manager = _completed_graph_run(tmp_path, run_id)
+    frame_id = _reopen(manager)
+    persisted = manager.load()
+    base = persisted.call_frames[frame_id]
+    base["status"] = "failed"
+    retry = copy.deepcopy(base)
+    retry["status"] = "running"
+    persisted.call_frames[f"{frame_id}::retry::1"] = retry
+    manager._write_state()
+    return bundle, manager, frame_id
+
+
+def _resume_as_workflow_lisp(bundle, tmp_path: Path, manager):
+    with patch.object(CallExecutor, "_is_workflow_lisp_target", return_value=True), patch(
+        "orchestrator.workflow.executor.audit_scope"
+    ):
+        return WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+
+def _corrupt_checksum(manager: StateManager, frame_id: str) -> str:
+    persisted = manager.load()
+    persisted.call_frames[frame_id]["state"]["workflow_checksum"] = "sha256:" + "0" * 64
+    manager._write_state()
+    return frame_id
+

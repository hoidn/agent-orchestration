@@ -0,0 +1,354 @@
+"""Sticky non-routable projection failures, finalization, status views, and CLI envelopes."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+import orchestrator.cli.commands.resume as resume_command
+from orchestrator.cli.commands.resume import resume_workflow
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+STALE_CURRENT = {"status": "running", "name": "Gone", "index": 0, "step_id": "root.gone", "visit_count": 1}
+LEAF = {
+    "version": "2.7",
+    "name": "leaf",
+    "artifacts": {"ready": {"kind": "scalar", "type": "bool"}},
+    "outputs": {
+        "ready": {"kind": "scalar", "type": "bool", "from": {"ref": "root.steps.SetReady.artifacts.ready"}}
+    },
+    "steps": [{"name": "SetReady", "id": "set_ready", "set_scalar": {"artifact": "ready", "value": True}}],
+}
+
+
+def _write(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _touch(name: str) -> dict:
+    return {"command": ["bash", "-lc", f"touch {name}"]}
+
+
+def _routed_workflow(tmp_path: Path, *, call_extra: dict | None = None, finally_steps=None, steps=None) -> Path:
+    _write(tmp_path / "imports" / "leaf.yaml", LEAF)
+    document = {
+        "version": "2.7",
+        "name": "routed",
+        "imports": {"leaf": "imports/leaf.yaml"},
+        "steps": steps
+        or [
+            {"name": "InvokeLeaf", "id": "invoke_leaf", "call": "leaf", **(call_extra or {})},
+            {"name": "Recover", "id": "recover", **_touch("recovered.txt")},
+        ],
+    }
+    if finally_steps:
+        document["finally"] = {"id": "cleanup", "steps": finally_steps}
+    return _write(tmp_path / "workflow.yaml", document)
+
+
+def _run_then_corrupt_leaf_frame(tmp_path: Path, workflow: Path, *, run_id: str, incomplete: tuple[str, ...] = ()):
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow)
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    persisted = manager.load()
+    frame = persisted.call_frames[sorted(persisted.call_frames)[0]]
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["current_step"] = dict(STALE_CURRENT)
+    persisted.status = "failed"
+    persisted.finalization = {}
+    for name in incomplete:
+        persisted.steps[name]["status"] = "failed"
+    for marker in ("recovered.txt", "cleaned.txt", "after.txt"):
+        (tmp_path / marker).unlink(missing_ok=True)
+    manager._write_state()
+    return bundle, manager
+
+
+@pytest.mark.parametrize("on_error", ["stop", "continue"])
+def test_projection_failure_is_not_consumed_by_routes_or_on_error_continue(tmp_path: Path, on_error: str):
+    workflow = _routed_workflow(
+        tmp_path, call_extra={"on": {"failure": {"goto": "Recover"}, "always": {"goto": "Recover"}}}
+    )
+    bundle, manager = _run_then_corrupt_leaf_frame(tmp_path, workflow, run_id=f"sticky-{on_error}", incomplete=["InvokeLeaf"])
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(on_error=on_error, resume=True)
+
+    persisted = manager.load().to_dict()
+    assert result["status"] == persisted["status"] == "failed"
+    assert not (tmp_path / "recovered.txt").exists()
+    error = persisted["error"]
+    assert error["type"] == "resume_projection_integrity_error"
+    assert persisted["steps"]["InvokeLeaf"]["error"] == error
+
+
+def test_finalization_runs_after_a_projection_failure_and_cleanup_failure_is_supplemental(tmp_path: Path):
+    workflow = _routed_workflow(
+        tmp_path,
+        finally_steps=[
+            {"name": "Cleanup", "id": "cleanup_step", **_touch("cleaned.txt")},
+            {"name": "BrokenCleanup", "id": "broken_cleanup", "command": ["bash", "-lc", "test ! -f broken.flag"]},
+        ],
+    )
+    bundle, manager = _run_then_corrupt_leaf_frame(tmp_path, workflow, run_id="sticky-finalization")
+    persisted = manager.load()
+    persisted.steps["InvokeLeaf"]["status"] = "failed"
+    persisted.steps.pop("finally.BrokenCleanup", None)
+    manager._write_state()
+    (tmp_path / "broken.flag").write_text("x", encoding="utf-8")
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = manager.load().to_dict()
+    assert result["status"] == "failed"
+    assert (tmp_path / "cleaned.txt").exists()
+    assert after["error"]["type"] == "resume_projection_integrity_error"
+    finalization = after["finalization"]
+    assert finalization["status"] == "failed"
+    assert finalization["failure"]["step"] == "finally.BrokenCleanup"
+    assert finalization["failure"]["step_id"]
+    assert finalization["failure"]["error"] is None
+    assert after["error"]["context"]["reason"] == "out_of_scope_step_id"
+
+
+def test_projection_error_arising_only_inside_finalization_becomes_the_run_error(tmp_path: Path):
+    workflow = _routed_workflow(
+        tmp_path,
+        steps=[{"name": "Body", "id": "body", **_touch("body.txt")}],
+        finally_steps=[{"name": "Cleanup", "id": "cleanup_step", **_touch("cleaned.txt")}],
+    )
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow)
+    manager = StateManager(tmp_path, run_id="sticky-finalization-only")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    diagnostic = {
+        "type": "resume_projection_integrity_error",
+        "message": "Resume projection integrity audit failed: out_of_scope_step_id",
+        "context": {"reason": "out_of_scope_step_id"},
+    }
+    original = WorkflowExecutor._execute_command
+
+    def cleanup_projection_failure(executor, step, state):
+        if step.get("name") == "finally.Cleanup":
+            return {"status": "failed", "exit_code": 2, "duration_ms": 0, "error": diagnostic}
+        return original(executor, step, state)
+
+    with patch.object(WorkflowExecutor, "_execute_command", cleanup_projection_failure):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute()
+
+    after = manager.load().to_dict()
+    assert result["status"] == "failed"
+    assert after["error"] == diagnostic
+    assert after["finalization"]["status"] == "failed"
+    assert after["finalization"]["failure"]["error"] == diagnostic
+    assert after["finalization"]["failure"]["step"] == "finally.Cleanup"
+
+
+@pytest.mark.parametrize("loop_kind", ["for_each", "repeat_until"])
+def test_loops_stop_on_a_projection_failure_instead_of_continuing(tmp_path: Path, loop_kind: str):
+    _write(tmp_path / "imports" / "leaf.yaml", LEAF)
+    call = {"name": "Inner", "id": "inner", "call": "leaf"}
+    if loop_kind == "for_each":
+        loop = {"name": "Loop", "id": "loop", "for_each": {"items": ["a", "b"], "steps": [call]}}
+    else:
+        loop = {
+            "name": "Loop",
+            "id": "loop",
+            "repeat_until": {
+                "id": "body",
+                "max_iterations": 3,
+                "outputs": {
+                    "ready": {"kind": "scalar", "type": "bool", "from": {"ref": "self.steps.Inner.artifacts.ready"}}
+                },
+                "condition": {"compare": {"left": {"ref": "self.outputs.ready"}, "op": "eq", "right": False}},
+                "steps": [call],
+            },
+        }
+    workflow = _write(
+        tmp_path / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "looped",
+            "imports": {"leaf": "imports/leaf.yaml"},
+            "steps": [loop, {"name": "After", "id": "after", **_touch("after.txt")}],
+        },
+    )
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow)
+    manager = StateManager(tmp_path, run_id=f"sticky-{loop_kind}")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    persisted = manager.load()
+    first_frame = persisted.call_frames[sorted(persisted.call_frames)[0]]
+    first_frame["status"] = "running"
+    first_frame["state"]["status"] = "failed"
+    first_frame["state"]["current_step"] = dict(STALE_CURRENT)
+    persisted.status = "failed"
+    persisted.steps["Loop[0].Inner"]["status"] = "running"
+    persisted.steps.pop("Loop", None)
+    if loop_kind == "for_each":
+        persisted.for_each["Loop"].completed_indices = []
+        persisted.for_each["Loop"].current_index = 0
+    else:
+        persisted.repeat_until["Loop"] = {
+            "current_iteration": 0,
+            "completed_iterations": [],
+            "condition_evaluated_for_iteration": None,
+            "last_condition_result": None,
+        }
+        persisted.steps["Loop"] = {"status": "running", "step_id": "root.loop", "name": "Loop"}
+        for key in [k for k in persisted.steps if k.startswith("Loop[") and not k.startswith("Loop[0]")]:
+            del persisted.steps[key]
+    (tmp_path / "after.txt").unlink(missing_ok=True)
+    manager._write_state()
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = manager.load().to_dict()
+    assert result["status"] == "failed"
+    assert not (tmp_path / "after.txt").exists()
+    assert after["error"]["type"] == "resume_projection_integrity_error"
+    assert after["error"]["context"]["reason"] == "out_of_scope_step_id"
+
+
+def test_nested_projection_failure_is_promoted_unchanged_through_every_ancestor(tmp_path: Path):
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id="nested-promotion")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    persisted = manager.load()
+    middle_id, middle_frame = next(iter(persisted.call_frames.items()))
+    leaf_id, leaf_frame = next(iter(middle_frame["state"]["call_frames"].items()))
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    middle_frame["status"] = "running"
+    middle_frame["state"]["status"] = "failed"
+    middle_frame["state"]["steps"]["InvokeLeaf"]["status"] = "failed"
+    leaf_frame["status"] = "running"
+    leaf_frame["state"]["status"] = "failed"
+    leaf_frame["state"]["current_step"] = dict(STALE_CURRENT)
+    manager._write_state()
+    leaf_before = json.loads(json.dumps(leaf_frame))
+
+    WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = manager.load().to_dict()
+    root_error = after["error"]
+    assert root_error["type"] == "resume_projection_integrity_error"
+    assert root_error["context"]["scope_path"] == [
+        {"kind": "root", "workflow_file": "workflow.yaml"},
+        {"kind": "call_frame", "frame_id": middle_id},
+        {"kind": "call_frame", "frame_id": leaf_id},
+    ]
+    assert after["steps"]["InvokeMiddle"]["error"] == root_error
+    middle_after = after["call_frames"][middle_id]
+    assert middle_after["state"]["error"] == root_error
+    assert middle_after["state"]["steps"]["InvokeLeaf"]["error"] == root_error
+    assert middle_after["state"]["call_frames"][leaf_id] == leaf_before
+    assert "call_failed" not in json.dumps(after)
+
+
+def test_forensic_current_step_is_pending_in_status_views(tmp_path: Path):
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id="forensic")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    persisted = manager.load()
+    persisted.status = "running"
+    persisted.current_step = {
+        "status": "running",
+        "name": "InvokeMiddle",
+        "step_id": "root.invoke_middle",
+        "visit_count": 1,
+        "started_at": "2024-01-01T00:00:00Z",
+    }
+    manager._write_state()
+    (tmp_path / "workflow.yaml").write_text(
+        (tmp_path / "workflow.yaml").read_text(encoding="utf-8") + "\n# edited\n", encoding="utf-8"
+    )
+
+    WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    state = manager.load().to_dict()
+    snapshot = build_status_snapshot(bundle, state, manager.run_root)
+    step = next(entry for entry in snapshot["steps"] if entry["name"] == "InvokeMiddle")
+    assert state["error"]["type"] == "workflow_checksum_mismatch"
+    assert state["current_step"]["status"] == "running"
+    assert snapshot["run"]["status"] == "failed"
+    assert (step["status"], step["summary"], step["current_visit_count"]) == ("pending", "pending", None)
+    assert snapshot["progress"]["running"] == 0
+    assert snapshot["progress"]["pending"] == 1
+    assert "in progress" not in render_status_markdown(snapshot)
+
+
+def _seed_cli_run(tmp_path: Path, run_id: str):
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    persisted = manager.load()
+    persisted.status = "failed"
+    persisted.current_step = {"status": "running", "name": "InvokeMiddle", "index": 0, "step_id": "root.stale"}
+    manager._write_state()
+    return manager
+
+
+def test_cli_audit_failure_exits_one_before_overrides_session_and_executor(tmp_path: Path, capsys):
+    manager = _seed_cli_run(tmp_path, "cli-audit")
+    before = json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+    with patch("os.getcwd", return_value=str(tmp_path)), patch.object(
+        WorkflowExecutor, "__init__", side_effect=AssertionError("executor constructed")
+    ):
+        result = resume_workflow(run_id="cli-audit", summary_mode="sync", summary_provider="override")
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert result == 1
+    assert "resume_projection_integrity_error" in after["error"]["type"]
+    assert "out_of_scope_step_id" in capsys.readouterr().err
+    assert after["status"] == "failed"
+    assert {k: v for k, v in after.items() if k not in {"status", "error", "updated_at"}} == {
+        k: v for k, v in before.items() if k not in {"status", "error", "updated_at"}
+    }
+    assert "observability" not in after and "runtime_observability" not in after
+    assert not (manager.run_root / "monitor_process.json").exists()
+
+
+def test_second_root_audit_failure_keeps_session_metadata_and_survives_a_failing_session_close(tmp_path: Path):
+    manager = _seed_cli_run(tmp_path, "cli-second-audit")
+
+    def failing_close(*_args, **_kwargs):
+        raise RuntimeError("close failed")
+
+    with patch("os.getcwd", return_value=str(tmp_path)), patch.object(
+        resume_command, "audit_scope"
+    ), patch.object(resume_command, "close_executor_session", failing_close):
+        result = resume_workflow(run_id="cli-second-audit")
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert result == 1
+    assert after["error"]["type"] == "resume_projection_integrity_error"
+    sessions = after["runtime_observability"]["executor_sessions"]
+    assert len(sessions) == 1 and sessions[0]["entrypoint"] == "resume"
+    assert (manager.run_root / "monitor_process.json").is_file()
+
+
+def test_second_root_audit_failure_closes_the_executor_session_as_failed(tmp_path: Path):
+    manager = _seed_cli_run(tmp_path, "cli-session-closed")
+
+    with patch("os.getcwd", return_value=str(tmp_path)), patch.object(resume_command, "audit_scope"):
+        result = resume_workflow(run_id="cli-session-closed")
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    session = after["runtime_observability"]["executor_sessions"][0]
+    assert result == 1
+    assert (session["status"], bool(session["ended_at"])) == ("failed", True)
+    assert after["error"]["context"]["reason"] == "out_of_scope_step_id"

index 0000000..42c6eb5
--- /dev/null
+++ b/orchestrator/workflow/call_resume.py
@@ -0,0 +1,67 @@
+"""Resume-time call-frame selection for one reached call boundary.
+
+Pure planning over the parent's persisted `call_frames`; it validates nothing against
+a projection (that is `audit_scope`'s job) and never mutates the frames it reads.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from .resume_retry_lineage import (
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+
+
+@dataclass(frozen=True)
+class ResumeFramePlan:
+    """The frame a reached call will occupy, plus the lineage that selected it."""
+
+    frame_id: str
+    existing_frame: Optional[Mapping[str, Any]] = None
+    items: tuple[tuple[str, Mapping[str, Any]], ...] = ()
+    lineage: Optional[CallFrameRetryLineage] = None
+    lineage_error: Optional[CallFrameRetryLineageError] = None
+    invalid_detail: Optional[str] = None
+    foreign_occupant: Optional[str] = None
+
+    def items_by_id(self) -> dict[str, Mapping[str, Any]]:
+        return dict(self.items)
+
+
+def plan_resume_frame(
+    *,
+    step_id: str,
+    fresh_frame_id: str,
+    call_frames: Any,
+    frontend_kind: Optional[str],
+) -> ResumeFramePlan:
+    """Select the resumable frame (or the fresh/retry frame id) for one reached call identity."""
+    if not isinstance(call_frames, Mapping):
+        return ResumeFramePlan(fresh_frame_id, invalid_detail="call_frames_not_mapping")
+    occupant = call_frames.get(fresh_frame_id)
+    if fresh_frame_id in call_frames and not isinstance(occupant, Mapping):
+        return ResumeFramePlan(fresh_frame_id, invalid_detail="call_frame_not_mapping")
+    if isinstance(occupant, Mapping) and occupant.get("status") == "completed":
+        return ResumeFramePlan(fresh_frame_id, invalid_detail="completed_call_frame_id_collision")
+    items = tuple(
+        (frame_id, frame)
+        for frame_id, frame in call_frames.items()
+        if isinstance(frame, Mapping) and frame.get("call_step_id") == step_id
+    )
+    if isinstance(occupant, Mapping) and not any(frame_id == fresh_frame_id for frame_id, _ in items):
+        return ResumeFramePlan(fresh_frame_id, items=items, foreign_occupant=fresh_frame_id)
+    try:
+        lineage = index_retry_lineage(step_id, items, frontend_kind=frontend_kind)
+    except CallFrameRetryLineageError as exc:
+        return ResumeFramePlan(fresh_frame_id, items=items, lineage_error=exc)
+    running = lineage.running_member
+    if running is not None:
+        return ResumeFramePlan(running.frame_id, call_frames[running.frame_id], items, lineage)
+    if lineage.failed_predecessors:
+        return ResumeFramePlan(next_unused_retry_frame_id(lineage), None, items, lineage)
+    return ResumeFramePlan(fresh_frame_id, None, items, lineage)

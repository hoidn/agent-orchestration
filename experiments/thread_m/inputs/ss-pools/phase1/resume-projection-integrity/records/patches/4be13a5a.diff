new file mode 100644
index 0000000..a335de1
--- /dev/null
+++ b/orchestrator/observability/forensic.py
@@ -0,0 +1,22 @@
+"""Forensic interpretation of a `current_step` left behind by a resume failure envelope."""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+FORENSIC_ERROR_TYPES = frozenset({"resume_projection_integrity_error", "workflow_checksum_mismatch"})
+
+
+def current_step_is_forensic(state: Mapping[str, Any]) -> bool:
+    """Return True when `state.current_step` is a stale record, not a live step.
+
+    A failed run whose error is a resume projection or checksum envelope never executed
+    the recorded step in this session, so heartbeat and live-status readers must ignore it.
+    """
+    error = state.get("error")
+    return (
+        state.get("status") == "failed"
+        and isinstance(state.get("current_step"), Mapping)
+        and isinstance(error, Mapping)
+        and error.get("type") in FORENSIC_ERROR_TYPES
+    )

+    assert CallExecutor._is_workflow_lisp_target(middle) is False
+    typed = copy.copy(middle)
+    object.__setattr__(typed, "provenance", type(middle.provenance)(**{
+        **{name: getattr(middle.provenance, name) for name in middle.provenance.__dataclass_fields__},
+        "frontend_kind": "workflow_lisp",

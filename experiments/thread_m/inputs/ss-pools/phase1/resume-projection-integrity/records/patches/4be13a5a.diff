+def test_scope_path_is_an_identity_only_value_object():
+    root = ResumeScopePath.root("workflow.yaml")
+    child = root.child("frame-a").child("frame-b")
+
+    assert root.projection_scope == "root"
+    assert child.projection_scope == "call_frame"
+    assert child.as_context() == [
+        {"kind": "root", "workflow_file": "workflow.yaml"},
+        {"kind": "call_frame", "frame_id": "frame-a"},
+        {"kind": "call_frame", "frame_id": "frame-b"},
+    ]
+    assert ResumeScopePath("w", ["x"]).call_frame_ids == ("x",)
+    assert root.call_frame_ids == ()
+

+def test_root_audit_runs_once_for_the_structural_root_before_the_prologue(tmp_path: Path):
+    bundle, manager = _completed_graph_run(tmp_path, "root-audit-order")
+    _reopen(manager)
+    events: list[object] = []
+    original_prologue = WorkflowExecutor._execute_prologue
+
+    def record_prologue(executor, state, **kwargs):
+        events.append("prologue")
+        return original_prologue(executor, state, **kwargs)
+
+    def record_root_audit(audited_bundle, state, scope_path):
+        events.append(("root-audit", scope_path))
+
+    with patch("orchestrator.workflow.executor.audit_scope", side_effect=record_root_audit), patch.object(
+        WorkflowExecutor, "_execute_prologue", record_prologue
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert result["status"] == "completed"
+    assert events[0] == ("root-audit", ResumeScopePath.root("workflow.yaml"))
+    assert events.count("prologue") == 3  # root, middle and leaf executors each run a prologue
+    assert [event for event in events if isinstance(event, tuple)] == [events[0]]
+    assert events.index("prologue") == 1

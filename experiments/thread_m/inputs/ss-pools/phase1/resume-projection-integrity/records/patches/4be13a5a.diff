+def test_reached_calls_audit_each_callee_scope_with_its_frame_path(tmp_path: Path):
+    bundle, manager = _completed_graph_run(tmp_path, "reached-call-scopes")
+    frame_id = _reopen(manager)
+    seen: list[tuple[str, tuple[str, ...]]] = []
+    from orchestrator.workflow import calls as calls_module
+
+    original_audit = calls_module.audit_scope
+
+    def record_audit(audited_bundle, state, scope_path):
+        seen.append((audited_bundle.surface.name, scope_path.call_frame_ids))
+        return original_audit(audited_bundle, state, scope_path)
+
+    with patch.object(calls_module, "audit_scope", record_audit):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert result["status"] == "completed"
+    assert seen[0] == ("projection-middle", (frame_id,))

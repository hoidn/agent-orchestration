+    _corrupt_checksum(manager, base_id)
+    running_id = _corrupt_checksum(manager, f"{base_id}::retry::1")
+
+    result = _resume_as_workflow_lisp(bundle, tmp_path, manager)
+
+    error = result["steps"]["InvokeMiddle"]["error"]
+    assert error["type"] == "call_resume_checksum_mismatch"
+    assert error["context"]["call_frame_id"] == running_id
+

diff --git a/tests/test_workflow_import_alias_duplicates.py b/tests/test_workflow_import_alias_duplicates.py
new file mode 100644
index 0000000..d1bd33a
--- /dev/null
+++ b/tests/test_workflow_import_alias_duplicates.py
@@ -0,0 +1,150 @@
+"""Duplicate import alias / imports-section detection in classic YAML workflows."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIB = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Hello
+    command: ["echo", "hi"]
+"""
+
+STEPS = """\
+steps:
+  - name: Call
+    id: call
+    call: lib
+"""
+
+
+def _write(tmp_path: Path, body: str) -> Path:
+    (tmp_path / "lib.yaml").write_text(LIB)
+    (tmp_path / "lib2.yaml").write_text(LIB.replace("name: lib", "name: lib2"))
+    path = tmp_path / "workflow.yaml"
+    path.write_text(body + STEPS)
+    return path
+
+
+def _load_errors(tmp_path: Path, body: str, monkeypatch) -> list[str]:
+    def _unreachable(*_args, **_kwargs):
+        raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _unreachable)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(tmp_path).load(_write(tmp_path, body))
+    return [error.message for error in excinfo.value.errors]
+
+
+FAILURE_CASES = {
+    "duplicate_key": (
+        """\
+version: "2.5"
+name: root
+imports:
+  lib: lib.yaml
+  other: lib2.yaml
+  lib: lib2.yaml
+""",
+        "imports.lib: duplicate import alias (line 4, column 3; line 6, column 3)",
+    ),
+    "merge_inside_imports": (
+        """\
+version: "2.5"
+name: root
+x-base: &base
+  lib: lib.yaml
+imports:
+  <<: *base
+  lib: lib2.yaml
+""",
+        "imports.lib: duplicate import alias (line 4, column 3; line 7, column 3)",
+    ),
+    "two_merge_sources_inside_imports": (
+        """\
+version: "2.5"
+name: root
+x-a: &a
+  lib: lib.yaml
+x-b: &b
+  lib: lib2.yaml
+imports:
+  <<: [*a, *b]
+""",
+        "imports.lib: duplicate import alias (line 4, column 3; line 6, column 3)",
+    ),
+    "repeated_sections_duplicate_alias": (
+        """\
+version: "2.5"
+name: root
+imports:
+  lib: lib.yaml
+imports:
+  lib: lib2.yaml
+""",
+        "imports.lib: duplicate import alias (line 4, column 3; line 6, column 3)",
+    ),
+    "repeated_sections_distinct_aliases": (
+        """\
+version: "2.5"
+name: root
+imports:
+  lib: lib.yaml
+imports:
+  lib2: lib2.yaml
+""",
+        "imports: duplicate top-level mapping (line 3, column 1; line 5, column 1)",
+    ),
+    "merged_and_explicit_sections_distinct_aliases": (
+        """\
+x-base: &base
+  imports:
+    lib2: lib2.yaml
+<<: *base
+version: "2.5"
+name: root
+imports:
+  lib: lib.yaml
+""",
+        "imports: duplicate top-level mapping (line 2, column 3; line 7, column 1)",
+    ),
+    "top_level_merge_sources_both_carry_imports": (
+        """\
+x-a: &a
+  imports:
+    lib: lib.yaml
+x-b: &b
+  imports:
+    lib: lib2.yaml
+<<: [*a, *b]
+version: "2.5"
+name: root
+""",
+        "imports.lib: duplicate import alias (line 3, column 5; line 6, column 5)",
+    ),
+}
+
+
+@pytest.mark.parametrize("case", sorted(FAILURE_CASES))
+def test_duplicate_imports_reported_once_before_bundle(tmp_path, monkeypatch, case):
+    body, expected = FAILURE_CASES[case]
+    assert _load_errors(tmp_path, body, monkeypatch) == [expected]
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        'version: "2.5"\nname: root\nimports:\n  lib: lib.yaml\n',
+        'context: &base\n  imports:\n    lib: lib.yaml\n<<: *base\nversion: "2.5"\nname: root\n',
+    ],
+    ids=["plain_unique", "single_merged_section"],
+)
+def test_unique_imports_load(tmp_path, body):
+    loaded = WorkflowLoader(tmp_path).load(_write(tmp_path, body))
+    assert "lib" in loaded.imports

+def test_explicit_step_row_identities_fail_closed_with_stable_diagnostics(bundle, steps, reason, field, value, count):
+    error = _audit_error(bundle, _state(steps=steps))
+
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == f"Resume projection integrity audit failed: {reason}"
+    context = error["context"]
+    assert context["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    assert (context["reason"], context["field"], context["offending_value"], context["candidate_count"]) == (
+        reason,
+        field,
+        value,
+        count,
+    )
+    assert context["scope_path"] == [{"kind": "root", "workflow_file": "workflow.yaml"}]
+    assert context["expected_owner"]["workflow_checksum"] == "sha256:abc"
+    assert context["expected_owner"]["projection_scope"] == "root"
+    assert context["expected_owner"]["workflow_file"].endswith("workflow.yaml")
+    assert context["call_boundary_step_id"] is None

diff --git a/orchestrator/import_alias_audit.py b/orchestrator/import_alias_audit.py
new file mode 100644
index 0000000..33ee7e2
--- /dev/null
+++ b/orchestrator/import_alias_audit.py
@@ -0,0 +1,72 @@
+"""Duplicate classic-YAML import alias detection over the composed YAML node graph.
+
+Depends on: PyYAML node marks only. Reads no files and loads no workflow.
+Behavior: collects the effective ``imports`` entries of a root mapping node
+(direct keys, ``<<`` merges inside ``imports``, repeated top-level ``imports``
+sections and top-level ``<<`` merge sources) and reports repeated aliases or
+repeated sections with 1-based key positions.
+"""
+
+from __future__ import annotations
+
+from typing import Iterator
+
+import yaml
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: yaml.Node) -> str:
+    mark = node.start_mark
+    return f"line {mark.line + 1}, column {mark.column + 1}"
+
+
+def _merge_sources(value: yaml.Node) -> Iterator[yaml.MappingNode]:
+    if isinstance(value, yaml.MappingNode):
+        yield value
+    elif isinstance(value, yaml.SequenceNode):
+        for item in value.value:
+            if isinstance(item, yaml.MappingNode):
+                yield item
+
+
+def _effective_keys(mapping: yaml.MappingNode, seen: frozenset[int] = frozenset()):
+    """Yield (key node, value node) pairs of a mapping including ``<<`` merge sources."""
+    if id(mapping) in seen:
+        return
+    seen = seen | {id(mapping)}
+    for key, value in mapping.value:
+        if key.tag == _MERGE_TAG:
+            for source in _merge_sources(value):
+                yield from _effective_keys(source, seen)
+        else:
+            yield key, value
+
+
+def duplicate_import_alias_errors(root: yaml.Node | None) -> list[str]:
+    """Return duplicate-alias or duplicate-section errors for a composed workflow root."""
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [
+        (key, value)
+        for key, value in _effective_keys(root)
+        if isinstance(key, yaml.ScalarNode) and key.value == "imports"
+    ]
+    occurrences: dict[str, list[yaml.Node]] = {}
+    for _, section in sections:
+        if not isinstance(section, yaml.MappingNode):
+            continue
+        for alias_key, _ in _effective_keys(section):
+            if isinstance(alias_key, yaml.ScalarNode):
+                occurrences.setdefault(alias_key.value, []).append(alias_key)
+    errors = [
+        f"imports.{alias}: duplicate import alias ({'; '.join(_position(n) for n in nodes)})"
+        for alias, nodes in occurrences.items()
+        if len(nodes) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping "
+            f"({'; '.join(_position(key) for key, _ in sections)})"
+        )
+    return errors

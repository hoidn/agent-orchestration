+        """Persist the interrupted for_each without completing the failed iteration."""
+        state["steps"][step_name] = loop_results
+        for i, iteration in enumerate(loop_results):
+            for nested_name, result in iteration.items():
+                state["steps"][f"{step_name}[{i}].{nested_name}"] = result
+        self.persist_for_each_progress(
+            state, step_name, items, completed_indices, index, loop_results
+        )
+
     def build_loop_parent_scope_steps(
         self,
         loop_step: RuntimeStepInput,

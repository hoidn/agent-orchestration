+def test_enumerate_resume_slots_reports_loop_bookkeeping_errors(tmp_path: Path):
+    _workflow_path, manager = _seed_repeat_until_failure(tmp_path, run_id="loops")
+    bundle = WorkflowLoader(tmp_path).load_bundle(tmp_path / "repeat_until_resume.yaml")
+    base = manager.load().to_dict()
+    projection = bundle.projection
+
+    index = projection.enumerate_resume_slots(base)
+    assert "root.review_loop#1.iteration_body.resume_gate" in index.candidates_by_step_id
+    assert "root.review_loop#2.iteration_body.resume_gate" not in index.candidates_by_step_id
+
+    cases = {
+        "completed_iterations must not contain duplicate indices": {"completed_iterations": [0, 0]},
+        "completed_iterations is not valid prior history": {"completed_iterations": [0, 1]},
+        "current_iteration is out of range": {"current_iteration": 99},
+        "condition result conflicts with evaluation state": {"condition_evaluated_for_iteration": 1},
+        "current_iteration must be null or a non-boolean integer": {"current_iteration": True},
+        "terminal progress requires completed evaluated history": {"current_iteration": None},
+        "exhausted must be boolean when present": {"exhausted": "yes"},
+    }
+    for suffix, patch_progress in cases.items():
+        state = copy.deepcopy(base)
+        state["repeat_until"]["ReviewLoop"].update(patch_progress)
+        with pytest.raises(ResumeProjectionValidationError) as exc_info:
+            projection.enumerate_resume_slots(state)
+        assert str(exc_info.value) == f"repeat_until.ReviewLoop.{suffix}"
+        assert exc_info.value.message == str(exc_info.value)
+
+    exhausted = copy.deepcopy(base)
+    exhausted["repeat_until"]["ReviewLoop"] = {
+        "current_iteration": None,
+        "completed_iterations": [0, 1, 2, 3],
+        "condition_evaluated_for_iteration": 3,
+        "last_condition_result": False,
+        "exhausted": True,
+    }
+    with pytest.raises(ResumeProjectionValidationError) as exc_info:
+        projection.enumerate_resume_slots(exhausted)
+    assert str(exc_info.value) == "repeat_until.ReviewLoop.successful exhaustion requires a completed frame"
+    exhausted["repeat_until"]["ReviewLoop"].pop("exhausted")
+    with pytest.raises(ResumeProjectionValidationError) as exc_info:
+        projection.enumerate_resume_slots(exhausted)
+    assert str(exc_info.value) == "repeat_until.ReviewLoop.failed exhaustion requires the terminal exhaustion error"
+

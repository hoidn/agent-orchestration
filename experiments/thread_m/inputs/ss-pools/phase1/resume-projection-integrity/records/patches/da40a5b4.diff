diff --git a/orchestrator/workflow/resume_loop_progress.py b/orchestrator/workflow/resume_loop_progress.py
new file mode 100644
index 0000000..b676f23
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_progress.py
@@ -0,0 +1,183 @@
+"""Loop-bookkeeping integrity checks for checksum-compatible resume.
+
+Depends on: persisted ``for_each`` / ``repeat_until`` / ``steps`` mappings of one
+run-state scope and, optionally, the declared ``repeat_until`` maximum per frame
+key. Reads no files and never mutates the state it is given.
+Behavior: raises ``ResumeProjectionValidationError`` for malformed or
+inconsistent bookkeeping, otherwise returns the iteration indices that exist per
+loop frame key so the projection can enumerate loop-local candidates.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted resume bookkeeping disagrees with the projection contract."""
+
+    def __init__(self, reason: str, message: str, *, field: Optional[str] = None, value: Any = None):
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+        self.value = value
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _shape(message: str, field: str, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field=field, value=value)
+
+
+def _progress(message: str, field: str, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field=field, value=value)
+
+
+def _section(state: Mapping[str, Any], kind: str) -> Mapping[str, Any]:
+    section = state.get(kind, {})
+    if not isinstance(section, Mapping):
+        raise _shape(f"{kind} must be a mapping", kind)
+    return section
+
+
+def _for_each_iterations(state: Mapping[str, Any]) -> dict[str, tuple[int, ...]]:
+    iterations: dict[str, tuple[int, ...]] = {}
+    for name, progress in _section(state, "for_each").items():
+        base = f"for_each.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{base} must be a mapping", base)
+        items = progress.get("items")
+        if not isinstance(items, list):
+            raise _shape(f"{base}.items must be a list", f"{base}.items")
+        current = progress.get("current_index")
+        if current is not None and not _is_index(current):
+            raise _shape(
+                f"{base}.current_index must be null or a non-boolean integer",
+                f"{base}.current_index",
+                current if not isinstance(current, (dict, list)) else None,
+            )
+        completed = progress.get("completed_indices", [])
+        field = f"{base}.completed_indices"
+        if not isinstance(completed, list):
+            raise _progress(f"{field} contains an out-of-range index", field)
+        if len(set(map(repr, completed))) != len(completed):
+            raise _progress(f"{field} must not contain duplicate indices", field)
+        for index in completed:
+            if not _is_index(index) or not 0 <= index < len(items):
+                raise _progress(
+                    f"{field} contains an out-of-range index",
+                    field,
+                    index if not isinstance(index, (dict, list)) else None,
+                )
+        if current is not None:
+            if not 0 <= current < len(items):
+                raise _progress(f"{base}.current_index is out of range", f"{base}.current_index", current)
+            if current in completed:
+                raise _progress(f"{base}.current_index is already completed", f"{base}.current_index", current)
+        iterations[str(name)] = tuple(range(len(items)))
+    return iterations
+
+
+def _check_terminal(
+    base: str,
+    progress: Mapping[str, Any],
+    completed: list[int],
+    row: Any,
+    maximum: Optional[int],
+) -> tuple[int, ...]:
+    field = f"{base}.completed_iterations"
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    if not completed or not _is_index(evaluated) or evaluated != max(completed):
+        raise _progress(f"{base}.terminal progress requires completed evaluated history", field)
+    result = progress.get("last_condition_result")
+    exhausted = progress.get("exhausted", False)
+    if not isinstance(result, bool) or (result and exhausted):
+        raise _progress(f"{base}.condition result conflicts with evaluation state", f"{base}.last_condition_result")
+    if result:
+        return tuple(completed)
+    if maximum is not None and sorted(completed) != list(range(maximum)):
+        raise _progress(f"{base}.terminal progress requires completed evaluated history", field)
+    if row is None:
+        # The frame row may be absent (restore/replay); only a present row must agree.
+        return tuple(completed)
+    status = row.get("status") if isinstance(row, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _progress(f"{base}.successful exhaustion requires a completed frame", f"{base}.exhausted")
+    else:
+        error = row.get("error") if isinstance(row, Mapping) else None
+        error_type = error.get("type") if isinstance(error, Mapping) else None
+        if status != "failed" or error_type != EXHAUSTION_ERROR_TYPE:
+            raise _progress(f"{base}.failed exhaustion requires the terminal exhaustion error", f"{base}.exhausted")
+    return tuple(completed)
+
+
+def _repeat_until_entry(
+    base: str,
+    progress: Mapping[str, Any],
+    row: Any,
+    maximum: Optional[int],
+) -> tuple[int, ...]:
+    current = progress.get("current_iteration")
+    if current is not None and not _is_index(current):
+        raise _shape(
+            f"{base}.current_iteration must be null or a non-boolean integer",
+            f"{base}.current_iteration",
+            current if not isinstance(current, (dict, list)) else None,
+        )
+    if "exhausted" in progress and not isinstance(progress["exhausted"], bool):
+        raise _shape(f"{base}.exhausted must be boolean when present", f"{base}.exhausted")
+    field = f"{base}.completed_iterations"
+    completed = progress.get("completed_iterations", [])
+    if not isinstance(completed, list):
+        raise _progress(f"{field} is not valid prior history", field)
+    if len(set(map(repr, completed))) != len(completed):
+        raise _progress(f"{field} must not contain duplicate indices", field)
+    if any(not _is_index(index) or index < 0 for index in completed):
+        raise _progress(f"{field} is not valid prior history", field)
+    if current is None:
+        return _check_terminal(base, progress, completed, row, maximum)
+    if current < 0 or (maximum is not None and current >= maximum):
+        raise _progress(f"{base}.current_iteration is out of range", f"{base}.current_iteration", current)
+    if any(index >= current for index in completed):
+        raise _progress(f"{field} is not valid prior history", field)
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    consistent = (
+        (evaluated is None and result is None)
+        or (_is_index(evaluated) and evaluated == current and isinstance(result, bool))
+    )
+    if not consistent or progress.get("exhausted", False):
+        raise _progress(f"{base}.condition result conflicts with evaluation state", f"{base}.last_condition_result")
+    return (*completed, current)
+
+
+def _repeat_until_iterations(
+    state: Mapping[str, Any],
+    maximum_by_frame: Mapping[str, Optional[int]],
+) -> dict[str, tuple[int, ...]]:
+    steps = state.get("steps")
+    steps = steps if isinstance(steps, Mapping) else {}
+    iterations: dict[str, tuple[int, ...]] = {}
+    for name, progress in _section(state, "repeat_until").items():
+        base = f"repeat_until.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(f"{base} must be a mapping", base)
+        iterations[str(name)] = _repeat_until_entry(
+            base, progress, steps.get(name), maximum_by_frame.get(str(name))
+        )
+    return iterations
+
+
+def loop_iterations_by_frame(
+    state: Mapping[str, Any],
+    *,
+    repeat_until_maximums: Mapping[str, Optional[int]],
+) -> tuple[dict[str, tuple[int, ...]], dict[str, tuple[int, ...]]]:
+    """Validate loop bookkeeping and return (for_each, repeat_until) iteration indices per frame key."""
+    return _for_each_iterations(state), _repeat_until_iterations(state, repeat_until_maximums)
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..263d25d
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,281 @@
+"""Checksum-compatible resume projection-integrity audit for one state scope.
+
+Depends on: a loaded workflow bundle (projection, imports, provenance) and the
+persisted state mapping of exactly one scope (root run state or one call
+frame's ``state``). Loads no workflow or bundle, computes no checksum, reads no
+file and never mutates the state it audits.
+Behavior: ``audit_scope`` raises ``ResumeProjectionIntegrityError`` carrying the
+stable ``resume_projection_integrity_error`` diagnostic when any explicit
+durable identity in the scope disagrees with the current projection.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+from .call_frame_lineage import (
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .state_projection import ResumeProjectionValidationError
+
+__all__ = [
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RetryFrameMember",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "audit_scope",
+    "index_retry_lineage",
+    "next_unused_retry_frame_id",
+    "projection_integrity_error",
+]
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_FRAME_STATUSES = ("completed", "failed", "running")
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through entered call frames."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """A persisted identity is not owned by the current projection; ``error`` is the diagnostic."""
+
+    def __init__(self, error: dict[str, Any]):
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def projection_integrity_error(
+    reason: str,
+    *,
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    field: Optional[str] = None,
+    offending_value: Any = None,
+    candidate_count: Optional[int] = None,
+    call_boundary_step_id: Optional[str] = None,
+) -> ResumeProjectionIntegrityError:
+    """Build the stable diagnostic; containers and secrets never enter the context."""
+    provenance = workflow_provenance(bundle)
+    workflow_path = getattr(provenance, "workflow_path", None)
+    checksum = state.get("workflow_checksum") if isinstance(state, Mapping) else None
+    return ResumeProjectionIntegrityError(
+        {
+            "type": ERROR_TYPE,
+            "message": f"Resume projection integrity audit failed: {reason}",
+            "context": {
+                "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                "reason": reason,
+                "scope_path": scope_path.as_context(),
+                "field": field,
+                "offending_value": _scalar(offending_value),
+                "expected_owner": {
+                    "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                    "workflow_checksum": checksum if isinstance(checksum, str) else None,
+                    "projection_scope": scope_path.projection_scope,
+                },
+                "candidate_count": candidate_count,
+                "call_boundary_step_id": call_boundary_step_id,
+            },
+        }
+    )
+
+
+class _Audit:
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath):
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.projection = bundle.projection
+
+    def fail(self, reason: str, **kwargs: Any) -> ResumeProjectionIntegrityError:
+        return projection_integrity_error(
+            reason, bundle=self.bundle, state=self.state, scope_path=self.scope_path, **kwargs
+        )
+
+    def run(self) -> None:
+        steps = self.state.get("steps", {})
+        if not isinstance(steps, Mapping):
+            raise self.fail("unsupported_shape", field="steps")
+        frames = self.state.get("call_frames", {})
+        if not isinstance(frames, Mapping):
+            raise self.fail("unsupported_shape", field="call_frames")
+        try:
+            self.slots = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            raise self.fail(exc.reason, field=exc.field, offending_value=exc.value) from exc
+        self._steps(steps)
+        self._current_step()
+        self._call_frames(frames)
+
+    def _explicit_id(self, row: Mapping[str, Any], field: str) -> str:
+        step_id = row["step_id"]
+        if not isinstance(step_id, str) or not step_id:
+            raise self.fail("unsupported_shape", field=field, offending_value=step_id)
+        return step_id
+
+    def _steps(self, steps: Mapping[str, Any]) -> None:
+        unclaimed = set(self.slots.unclaimed_explicit_rows)
+        for name, row in steps.items():
+            field = f"steps.{name}.step_id"
+            if isinstance(row, list):
+                rows: Iterable[Any] = (item for item in row if isinstance(item, Mapping))
+                presentation = None
+            elif isinstance(row, Mapping):
+                rows, presentation = (row,), str(name)
+            else:
+                raise self.fail("unsupported_shape", field=f"steps.{name}")
+            for item in rows:
+                if "step_id" not in item:
+                    continue
+                step_id = self._explicit_id(item, field)
+                if (str(name), step_id) in unclaimed:
+                    raise self.fail(
+                        "unclaimed_explicit_step_row", field=field, offending_value=step_id, candidate_count=0
+                    )
+                self._resolve_step(step_id, presentation, field, "unknown_explicit_step_id")
+
+    def _resolve_step(self, step_id: str, presentation: Optional[str], field: str, unknown: str) -> None:
+        resolution = self.projection.resolve_resume_step_id(self.slots, step_id, presentation)
+        if resolution.slot is not None:
+            return
+        reason = unknown if resolution.candidate_count != 1 else "presentation_slot_mismatch"
+        raise self.fail(
+            reason, field=field, offending_value=step_id, candidate_count=resolution.candidate_count
+        )
+
+    def _current_step(self) -> None:
+        current = self.state.get("current_step")
+        if current is None or current == {}:
+            return
+        if not isinstance(current, Mapping):
+            raise self.fail("unsupported_shape", field="current_step")
+        if "step_id" not in current:
+            raise self.fail("missing_required_identity", field="current_step.step_id")
+        step_id = self._explicit_id(current, "current_step.step_id")
+        name = current.get("name")
+        self._resolve_step(
+            step_id, name if isinstance(name, str) else None, "current_step.step_id", "out_of_scope_step_id"
+        )
+
+    def _frame_boundary(self, frame_id: str, frame: Mapping[str, Any]) -> Any:
+        field = f"call_frames.{frame_id}.call_step_id"
+        if "call_step_id" not in frame:
+            raise self.fail("missing_required_identity", field=field)
+        call_step_id = frame["call_step_id"]
+        if not isinstance(call_step_id, str) or not call_step_id:
+            raise self.fail("unsupported_shape", field=field, offending_value=call_step_id)
+        resolution = self.projection.resolve_call_boundary(self.slots, call_step_id)
+        if resolution.boundary is not None:
+            return resolution.boundary
+        details = dict(field=field, offending_value=call_step_id, candidate_count=resolution.candidate_count)
+        if resolution.candidate_count > 1:
+            raise self.fail("ambiguous_call_boundary", call_boundary_step_id=call_step_id, **details)
+        if call_step_id in self.slots.candidates_by_step_id:
+            raise self.fail("missing_call_boundary", call_boundary_step_id=call_step_id, **details)
+        raise self.fail("out_of_scope_step_id", call_boundary_step_id=call_step_id, **details)
+
+    def _frame(self, frame_id: str, frame: Any) -> Optional[str]:
+        """Validate one frame; return its imported bundle's frontend kind."""
+        if not isinstance(frame, Mapping):
+            raise self.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+        boundary = self._frame_boundary(frame_id, frame)
+        call_step_id = frame["call_step_id"]
+        alias = frame.get("import_alias")
+        if boundary.import_alias is None:
+            return None
+        if alias != boundary.import_alias:
+            raise self.fail(
+                "persisted_import_alias_mismatch",
+                field=f"call_frames.{frame_id}.import_alias",
+                offending_value=alias,
+                candidate_count=1,
+                call_boundary_step_id=call_step_id,
+            )
+        imported = workflow_import_bundle(self.bundle, alias)
+        if imported is None:
+            raise self.fail(
+                "missing_imported_bundle",
+                field=f"imports.{alias}",
+                offending_value=alias,
+                candidate_count=1,
+                call_boundary_step_id=call_step_id,
+            )
+        if frame.get("status") not in _FRAME_STATUSES:
+            raise self.fail(
+                "unsupported_shape",
+                field=f"call_frames.{frame_id}.status",
+                offending_value=frame.get("status"),
+                call_boundary_step_id=call_step_id,
+            )
+        return getattr(workflow_provenance(imported), "frontend_kind", None)
+
+    def _call_frames(self, frames: Mapping[str, Any]) -> None:
+        kinds: dict[str, Optional[str]] = {}
+        for frame_id, frame in frames.items():
+            kinds[frame["call_step_id"] if isinstance(frame, Mapping) and "call_step_id" in frame else frame_id] = (
+                self._frame(str(frame_id), frame)
+            )
+        for boundary_id, kind in kinds.items():
+            items = [
+                (str(frame_id), frame)
+                for frame_id, frame in frames.items()
+                if isinstance(frame, Mapping) and frame.get("call_step_id") == boundary_id
+            ]
+            try:
+                index_retry_lineage(boundary_id, items, frontend_kind=kind)
+            except CallFrameRetryLineageError as exc:
+                resumable = sum(1 for _, frame in items if frame.get("status") != "completed")
+                ambiguous = exc.reason == "ambiguous_resumable_call_frame"
+                raise self.fail(
+                    exc.reason,
+                    field="call_frames",
+                    offending_value=resumable if ambiguous else None,
+                    candidate_count=resumable if ambiguous else None,
+                    call_boundary_step_id=boundary_id,
+                ) from exc
+
+

diff --git a/orchestrator/workflow/call_frame_lineage.py b/orchestrator/workflow/call_frame_lineage.py
new file mode 100644
index 0000000..59ea990
--- /dev/null
+++ b/orchestrator/workflow/call_frame_lineage.py
@@ -0,0 +1,157 @@
+"""Call-frame retry lineage indexing for resume.
+
+Depends on: persisted ``call_frames`` items (frame id, mapping with ``status``,
+``call_step_id`` and ``import_alias``) and the typed ``frontend_kind`` of the
+callee bundle. Reads no files and never mutates frames.
+Behavior: a Workflow Lisp boundary's non-completed frames form one retry
+lineage ``B`` (ordinal 0), ``B::retry::<n>``; any other boundary may own at most
+one non-completed frame. Invalid input raises ``CallFrameRetryLineageError``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND = "workflow_lisp"
+_STATUSES = ("completed", "failed", "running")
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Persisted call frames of one boundary cannot form a valid lineage."""
+
+    def __init__(self, reason: str, message: str):
+        super().__init__(message)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    """One persisted frame of a boundary."""
+
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    """One frame of a Workflow Lisp retry lineage."""
+
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    """Frames of one boundary grouped by resumability."""
+
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[RetryFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+
+
+def _split_retry_id(frame_id: str) -> tuple[str, int]:
+    """Return (base id, ordinal) for a lineage frame id, raising on malformed markers."""
+    base, marker, tail = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return frame_id, 0
+    if not base or RETRY_MARKER in tail or not tail.isascii() or not tail.isdecimal() or tail != str(int(tail)) or int(tail) < 1:
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", f"call frame '{frame_id}' has a malformed retry marker"
+        )
+    return base, int(tail)
+
+
+def _validated_members(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+) -> list[CallFrameMember]:
+    members: list[CallFrameMember] = []
+    aliases: set[Any] = set()
+    for frame_id, frame in frame_items:
+        if not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError("unsupported_shape", f"call frame '{frame_id}' is not a mapping")
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", f"call frame '{frame_id}' is not owned by the boundary"
+            )
+        status = frame.get("status")
+        if status not in _STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", f"call frame '{frame_id}' has an unknown status")
+        aliases.add(frame.get("import_alias"))
+        members.append(CallFrameMember(frame_id, status))
+    if len(aliases) > 1:
+        raise CallFrameRetryLineageError(
+            "persisted_import_alias_mismatch", "call frames of one boundary persist different import aliases"
+        )
+    return members
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group one boundary's frames into completed history, failed predecessors and the running member."""
+    members = _validated_members(boundary_step_id, frame_items)
+    completed = tuple(m for m in members if m.status == "completed")
+    open_members = [m for m in members if m.status != "completed"]
+    if frontend_kind != WORKFLOW_LISP_FRONTEND:
+        if len(open_members) > 1:
+            raise CallFrameRetryLineageError(
+                "ambiguous_resumable_call_frame", "boundary has more than one non-completed call frame"
+            )
+        only = open_members[0] if open_members else None
+        return CallFrameRetryLineage(only.frame_id if only else None, completed, (), only)
+    if not open_members:
+        return CallFrameRetryLineage(None, completed, (), None)
+
+    parsed = [(m, *_split_retry_id(m.frame_id)) for m in open_members]
+    bases = {base for _, base, _ in parsed}
+    if len(bases) > 1:
+        raise CallFrameRetryLineageError("ambiguous_resumable_call_frame", "retry lineage mixes base frames")
+    base_id = bases.pop()
+    lineage: list[RetryFrameMember] = [
+        RetryFrameMember(m.frame_id, m.status, ordinal) for m, _, ordinal in parsed
+    ]
+    completed_lineage = []
+    for member in completed:
+        try:
+            member_base, ordinal = _split_retry_id(member.frame_id)
+        except CallFrameRetryLineageError:
+            continue
+        if member_base == base_id:
+            completed_lineage.append(RetryFrameMember(member.frame_id, member.status, ordinal))
+    ordinals = [m.ordinal for m in (*lineage, *completed_lineage)]
+    if len(set(ordinals)) != len(ordinals):
+        raise CallFrameRetryLineageError("ambiguous_resumable_call_frame", "retry lineage repeats an ordinal")
+    if sorted(ordinals) != list(range(len(ordinals))):
+        raise CallFrameRetryLineageError("unsupported_shape", "retry lineage is missing an ordinal")
+    running = [m for m in lineage if m.status == "running"]
+    if len(running) > 1:
+        raise CallFrameRetryLineageError("ambiguous_resumable_call_frame", "retry lineage has several running members")
+    failed = tuple(sorted((m for m in lineage if m.status == "failed"), key=lambda m: m.ordinal))
+    other_completed = tuple(m for m in completed if m.frame_id not in {c.frame_id for c in completed_lineage})
+    return CallFrameRetryLineage(
+        base_id,
+        (*sorted(completed_lineage, key=lambda m: m.ordinal), *other_completed),
+        failed,
+        running[0] if running else None,
+    )
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<lowest unused positive ordinal>`` over every lineage member."""
+    if lineage.base_frame_id is None:
+        raise ValueError("retry lineage has no base frame")
+    used = {
+        member.ordinal
+        for member in (*lineage.completed_members, *lineage.failed_predecessors, lineage.running_member)
+        if isinstance(member, RetryFrameMember)
+    }
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

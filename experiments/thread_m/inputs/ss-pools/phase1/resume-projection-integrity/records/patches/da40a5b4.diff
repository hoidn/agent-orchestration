@@ -0,0 +1,20 @@
+"""Detect a ``current_step`` left behind by a resume failure envelope.
+
+Depends on: a persisted run-state mapping only. Behavior: a failed run whose
+error is a resume failure envelope never started its ``current_step`` in this
+resume, so that step is forensic evidence and must not be reported as live.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+FORENSIC_ERROR_TYPES = frozenset({"resume_projection_integrity_error", "workflow_checksum_mismatch"})
+
+
+def current_step_is_forensic(state: Any) -> bool:
+    """Return True when ``state['current_step']`` was left by a resume failure envelope."""
+    if not isinstance(state, Mapping) or state.get("status") != "failed":
+        return False
+    error = state.get("error")
+    return isinstance(error, Mapping) and error.get("type") in FORENSIC_ERROR_TYPES

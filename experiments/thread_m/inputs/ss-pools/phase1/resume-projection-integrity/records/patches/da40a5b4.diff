+def test_retry_lineage_orders_failed_predecessors_and_allocates_lowest_unused_ordinal():
+    base = "root.call::visit::1"
+
+    def frame(status, alias="a"):
+        return {"status": status, "call_step_id": "root.call", "import_alias": alias}
+
+    items = [
+        (f"{base}::retry::2", frame("failed")),
+        (base, frame("failed")),
+        (f"{base}::retry::1", frame("completed")),
+        (f"{base}::retry::3", frame("running")),
+    ]
+    lineage = index_retry_lineage("root.call", items, frontend_kind="workflow_lisp")
+
+    assert lineage.base_frame_id == base
+    assert [m.frame_id for m in lineage.failed_predecessors] == [base, f"{base}::retry::2"]
+    assert [m.ordinal for m in lineage.failed_predecessors] == [0, 2]
+    assert lineage.running_member.frame_id == f"{base}::retry::3"
+    assert [m.frame_id for m in lineage.completed_members] == [f"{base}::retry::1"]
+    assert next_unused_retry_frame_id(lineage) == f"{base}::retry::4"
+    assert next_unused_retry_frame_id(lineage) == next_unused_retry_frame_id(lineage)
+
+    settled = index_retry_lineage("root.call", [(base, frame("failed"))], frontend_kind="workflow_lisp")
+    assert settled.running_member is None
+    assert next_unused_retry_frame_id(settled) == f"{base}::retry::1"

+"""Behavioural coverage for checksum-compatible resume projection integrity."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+from orchestrator.state import StateManager
+from orchestrator.workflow.call_frame_lineage import CallFrameRetryLineageError
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from orchestrator.workflow.state_projection import ResumeProjectionValidationError
+from tests.test_resume_command import _seed_repeat_until_failure
+from tests.workflow_bundle_helpers import bundle_context_dict, materialize_projection_body_steps
+
+ROOT_SCOPE = ResumeScopePath.root("workflow.yaml")
+
+
+def _write_yaml(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def _call_graph_workflow(workspace: Path) -> Path:
+    _write_yaml(
+        workspace / "child.yaml",
+        {
+            "version": "2.7",
+            "name": "child",
+            "steps": [{"name": "ChildStep", "id": "child_step", "command": ["bash", "-lc", "true"]}],
+        },
+    )
+    return _write_yaml(
+        workspace / "workflow.yaml",
+        {
+            "version": "2.7",
+            "name": "root",
+            "imports": {"kid": "child.yaml"},
+            "steps": [
+                {"name": "First", "id": "first", "command": ["bash", "-lc", "true"]},
+                {
+                    "name": "Each",
+                    "id": "each",
+                    "for_each": {
+                        "items": ["a", "b"],
+                        "steps": [
+                            {"name": "Inner", "id": "inner", "command": ["bash", "-lc", "true"]},
+                            {"name": "CallIt", "id": "callit", "call": "kid"},
+                        ],
+                    },
+                },
+                {"name": "Callme", "id": "callme", "call": "kid"},
+            ],
+            "finally": {
+                "steps": [{"name": "Fin", "id": "fin", "command": ["bash", "-lc", "true"]}]
+            },
+        },
+    )
+
+
+@pytest.fixture
+def completed_run(tmp_path: Path):
+    workflow_path = _call_graph_workflow(tmp_path)
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow_path)
+    manager = StateManager(tmp_path, run_id="completed-run")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    assert result["status"] == "completed"
+    return bundle, manager, manager.load().to_dict()
+
+
+def _audit_reason(bundle, state, scope=ROOT_SCOPE) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        audit_scope(bundle, state, scope)
+    return exc_info.value.error["context"]
+
+
+def test_audit_accepts_a_persisted_run_with_loops_calls_and_finalization(completed_run):
+    bundle, _manager, state = completed_run
+    before = copy.deepcopy(state)
+
+    audit_scope(bundle, state, ROOT_SCOPE)
+
+    assert state == before
+
+
+def test_audit_diagnostic_has_the_stable_envelope(completed_run):
+    bundle, _manager, state = completed_run
+    state["steps"]["First"]["step_id"] = "root.gone"
+
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        audit_scope(bundle, state, ROOT_SCOPE)
+
+    error = exc_info.value.error
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == "Resume projection integrity audit failed: unknown_explicit_step_id"
+    assert error["context"] == {
+        "diagnostic_schema": "resume_projection_integrity_error.v1",
+        "reason": "unknown_explicit_step_id",
+        "scope_path": [{"kind": "root", "workflow_file": "workflow.yaml"}],
+        "field": "steps.First.step_id",
+        "offending_value": "root.gone",
+        "expected_owner": {
+            "workflow_file": str(bundle.provenance.workflow_path),
+            "workflow_checksum": state["workflow_checksum"],
+            "projection_scope": "root",
+        },
+        "candidate_count": 0,
+        "call_boundary_step_id": None,
+    }
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason", "field", "count"),
+    [
+        (lambda s: s["steps"]["First"].update(step_id="root.callme"), "presentation_slot_mismatch", "steps.First.step_id", 1),
+        (
+            lambda s: s["steps"].update(Ghost={"status": "completed", "step_id": "root.first"}),
+            "unclaimed_explicit_step_row",
+            "steps.Ghost.step_id",
+            0,
+        ),
+        (
+            lambda s: s["steps"]["Each[0].Inner"].update(step_id="root.each#7.inner"),
+            "unknown_explicit_step_id",
+            "steps.Each[0].Inner.step_id",
+            0,
+        ),
+        (
+            lambda s: s["steps"]["Each[0].Inner"].update(step_id="root.each#1.inner"),
+            "presentation_slot_mismatch",
+            "steps.Each[0].Inner.step_id",
+            1,
+        ),
+        (lambda s: s.update(current_step={"name": "First", "status": "running"}), "missing_required_identity", "current_step.step_id", None),
+        (
+            lambda s: s.update(current_step={"name": "First", "status": "running", "step_id": "root.nope"}),
+            "out_of_scope_step_id",
+            "current_step.step_id",
+            0,
+        ),
+        (lambda s: s.update(steps=["not", "a", "mapping"]), "unsupported_shape", "steps", None),
+        (lambda s: s.update(call_frames="oops"), "unsupported_shape", "call_frames", None),
+        (lambda s: s["steps"]["First"].update(step_id=["x"]), "unsupported_shape", "steps.First.step_id", None),
+    ],
+)
+def test_audit_fails_closed_for_unowned_explicit_identities(completed_run, mutate, reason, field, count):
+    bundle, _manager, state = completed_run
+    mutate(state)
+
+    context = _audit_reason(bundle, state)
+
+    assert context["reason"] == reason
+    assert context["field"] == field
+    assert context["candidate_count"] == count
+    assert not isinstance(context["offending_value"], (list, dict))
+
+
+def test_audit_keeps_absent_step_ids_compatible_without_backfilling(completed_run):
+    bundle, _manager, state = completed_run
+    for row in state["steps"].values():
+        if isinstance(row, dict):
+            row.pop("step_id", None)
+    before = copy.deepcopy(state)
+
+    audit_scope(bundle, state, ROOT_SCOPE)
+
+    assert state == before
+    assert all("step_id" not in row for row in state["steps"].values() if isinstance(row, dict))
+
+
+def test_audit_validates_call_frame_identity_alias_and_ownership(completed_run):
+    bundle, _manager, state = completed_run
+    frame_id, frame = next(iter(state["call_frames"].items()))
+
+    stale = copy.deepcopy(state)
+    stale["call_frames"][frame_id]["call_step_id"] = "root.gone"
+    assert _audit_reason(bundle, stale)["reason"] == "out_of_scope_step_id"
+
+    not_a_call = copy.deepcopy(state)
+    not_a_call["call_frames"][frame_id]["call_step_id"] = "root.first"
+    context = _audit_reason(bundle, not_a_call)
+    assert context["reason"] == "missing_call_boundary"
+    assert context["call_boundary_step_id"] == "root.first"
+
+    renamed = copy.deepcopy(state)
+    renamed["call_frames"][frame_id]["import_alias"] = "elsewhere"
+    context = _audit_reason(bundle, renamed)
+    assert context["reason"] == "persisted_import_alias_mismatch"
+    assert context["offending_value"] == "elsewhere"
+    assert context["field"] == f"call_frames.{frame_id}.import_alias"
+
+    missing = copy.deepcopy(state)
+    del missing["call_frames"][frame_id]["call_step_id"]
+    assert _audit_reason(bundle, missing)["reason"] == "missing_required_identity"
+
+    malformed = copy.deepcopy(state)
+    malformed["call_frames"][frame_id] = "frame"
+    assert _audit_reason(bundle, malformed)["field"] == f"call_frames.{frame_id}"
+

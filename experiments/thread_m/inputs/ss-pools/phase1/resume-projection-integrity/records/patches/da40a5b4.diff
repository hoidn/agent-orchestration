+def test_structural_root_executor_records_checksum_mismatch_envelope(tmp_path: Path):
+    workflow_path = _call_graph_workflow(tmp_path)
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow_path)
+    manager = StateManager(tmp_path, run_id="checksum-envelope")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    manager.state.status = "failed"
+    manager._write_state()
+    before = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    workflow_path.write_text(workflow_path.read_text(encoding="utf-8") + "# edited\n", encoding="utf-8")
+
+    with patch("orchestrator.workflow.executor.audit_scope") as audit, patch.object(
+        WorkflowExecutor, "_execute_prologue", side_effect=AssertionError("prologue ran")
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    audit.assert_not_called()
+    assert result["status"] == "failed"
+    error = after["error"]
+    assert error["type"] == "workflow_checksum_mismatch"
+    assert error["message"] == "Workflow has been modified since the run started"
+    assert error["context"]["reason"] == "workflow_modified"
+    assert error["context"]["persisted_checksum"] == before["workflow_checksum"]
+    assert error["context"]["current_checksum"] != before["workflow_checksum"]
+    assert set(error["context"]) == {"workflow_file", "persisted_checksum", "current_checksum", "reason"}
+    envelope = ("status", "error", "updated_at")
+    assert {k: v for k, v in after.items() if k not in envelope} == {
+        k: v for k, v in before.items() if k not in envelope
+    }

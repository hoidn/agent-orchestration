+"""Detection of the sticky, non-routable resume projection-integrity failure.
+
+Depends on: step-result mappings only. Reads no state manager and mutates nothing.
+Behavior: ``resume_projection_integrity_error`` can never be consumed by authored
+routes, ``on_error=continue`` or loop continuation, so executors stop on it.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+from .resume_projection_integrity import ERROR_TYPE
+
+
+def error_is_sticky(error: Any) -> bool:
+    return isinstance(error, Mapping) and error.get("type") == ERROR_TYPE
+
+
+def result_sticky_error(result: Any) -> Optional[Any]:
+    """Return the projection diagnostic carried by one step result, if any."""
+    error = result.get("error") if isinstance(result, Mapping) else None
+    return error if error_is_sticky(error) else None
+
+
+def iteration_sticky_error(iteration_state: Any) -> Optional[Any]:
+    """Return the first projection diagnostic among one loop iteration's step results."""
+    if not isinstance(iteration_state, Mapping):
+        return None
+    for result in iteration_state.values():
+        error = result_sticky_error(result)
+        if error is not None:
+            return error
+    return None
+
+
+def loop_results_sticky_error(loop_results: Any) -> Optional[Any]:
+    """Return the first projection diagnostic among a for_each loop's iteration results."""
+    if not isinstance(loop_results, list):
+        return None
+    for iteration in loop_results:
+        error = iteration_sticky_error(iteration)
+        if error is not None:
+            return error
+    return None

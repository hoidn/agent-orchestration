+def test_audit_rejects_two_resumable_frames_for_one_non_workflow_lisp_boundary(completed_run):
+    bundle, _manager, state = completed_run
+    frame_id, frame = next(iter(state["call_frames"].items()))
+    for suffix, status in (("a", "running"), ("b", "failed")):
+        clone = copy.deepcopy(frame)
+        clone["status"] = status
+        state["call_frames"][f"{frame_id}-{suffix}"] = clone
+
+    context = _audit_reason(bundle, state)
+
+    assert context["reason"] == "ambiguous_resumable_call_frame"
+    assert (context["field"], context["offending_value"], context["candidate_count"]) == ("call_frames", 2, 2)
+

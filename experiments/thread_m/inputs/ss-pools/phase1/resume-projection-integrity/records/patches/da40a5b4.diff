+    assert (tmp_path / "recovered.txt").read_text(encoding="utf-8") == "cleanup\n"
+    assert persisted["finalization"]["status"] == "failed"
+    failure = persisted["finalization"]["failure"]
+    assert failure["step"] == "finally.Cleanup"

+                },
+                {"name": "Next", "id": "next", "command": ["bash", "-lc", f"echo next >> {marker}"]},
+                {"name": "Recover", "id": "recover", "command": ["bash", "-lc", f"echo recovered >> {marker}"]},
+            ],
+            "finally": {
+                "steps": [
+                    {"name": "Cleanup", "id": "cleanup", "command": ["bash", "-lc", f"echo cleanup >> {marker}; exit 1"]}
+                ]
+            },
+        },

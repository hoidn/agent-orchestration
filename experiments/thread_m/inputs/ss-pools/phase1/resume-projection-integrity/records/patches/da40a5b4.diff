+def test_enumerate_resume_slots_reports_for_each_bookkeeping_errors(completed_run):
+    bundle, _manager, base = completed_run
+    cases = {
+        "for_each.Each.completed_indices must not contain duplicate indices": {"completed_indices": [0, 0]},
+        "for_each.Each.completed_indices contains an out-of-range index": {"completed_indices": [0, 5]},
+        "for_each.Each.current_index is already completed": {"current_index": 0},
+        "for_each.Each.items must be a list": {"items": "ab"},
+        "for_each.Each.current_index must be null or a non-boolean integer": {"current_index": "1"},
+    }
+    for message, patch_progress in cases.items():
+        state = copy.deepcopy(base)
+        state["for_each"]["Each"].update(patch_progress)
+        with pytest.raises(ResumeProjectionValidationError, match=message.replace("[", r"\[")):
+            bundle.projection.enumerate_resume_slots(state)

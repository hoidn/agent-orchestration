+def test_reached_call_uses_the_boundary_alias_once_and_audits_the_callee_scope(tmp_path: Path):
+    bundle, manager = _failed_call_run(tmp_path)
+    persisted = manager.load()
+    frame_id = "root.callme::visit::1"
+    persisted.status = "failed"
+    persisted.steps["Callme"]["status"] = "failed"
+    persisted.call_frames[frame_id]["status"] = "running"
+    persisted.call_frames[frame_id]["state"]["steps"]["ChildStep"]["step_id"] = "root.removed_child"
+    manager._write_state()
+    projection_cls = type(bundle.projection)
+    real = projection_cls.resolve_call_boundary
+    resolved: list[str] = []
+
+    def counting(self, slots, call_step_id):
+        resolved.append(call_step_id)
+        return real(self, slots, call_step_id)
+
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    executor.resume_mode = True
+    state = manager.load().to_dict()
+    state["step_visits"] = {"Callme": 0}
+
+    with patch.object(projection_cls, "resolve_call_boundary", counting):
+        result = executor.call_executor.execute_call(
+            _step_named(bundle, "Callme"), state, runtime_step_id="root.callme"
+        )
+
+    error = result["error"]
+    assert result["status"] == "failed"
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["context"]["reason"] == "unknown_explicit_step_id"
+    assert error["context"]["scope_path"][-1] == {"kind": "call_frame", "frame_id": frame_id}
+    assert resolved == ["root.callme"]
+    assert manager.load().call_frames[frame_id]["state"]["steps"]["ChildStep"]["step_id"] == "root.removed_child"

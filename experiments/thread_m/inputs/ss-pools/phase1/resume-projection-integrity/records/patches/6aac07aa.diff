+                "exit_code": 2,
+                "step_id": CLEANUP_NODE,
+                **({"error": cleanup_error} if cleanup_error else {}),
+            }
+        },
+        **({"error": run_error} if run_error else {}),
+    }
+    executor._ensure_finalization_state(state)
+    step_index = executor._execution_index_for_node_id(CLEANUP_NODE)
+    executor._handle_control_flow(
+        {"name": CLEANUP_NAME}, state, CLEANUP_NAME, step_index, "stop", current_node_id=CLEANUP_NODE
+    )
+    executor._record_finalization_settled_result(
+        state, step_index, CLEANUP_NAME, "completed", step_node_id=CLEANUP_NODE
+    )
+    return state

+@pytest.mark.parametrize("loop", ["repeat_until", "for_each"])
+def test_loop_contained_call_diagnostic_stops_the_loop_and_is_never_wrapped(tmp_path: Path, loop: str) -> None:
+    path = _write_loop_call_workflow(tmp_path, loop=loop)
+    bundle = WorkflowLoader(tmp_path).load_bundle(path)
+    manager = StateManager(tmp_path, run_id=f"loop-{loop}")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    state = manager.load()
+    state.status = "failed"
+    resumed_frame = "root.loop#1.body.invoke_lib::visit::1" if loop == "repeat_until" else "root.loop#1.invoke_lib::visit::1"
+    if loop == "repeat_until":
+        state.repeat_until["Loop"] = {
+            "current_iteration": 1,
+            "completed_iterations": [0],
+            "condition_evaluated_for_iteration": None,
+            "last_condition_result": None,
+        }
+        state.steps["Loop"] = {"status": "running", "name": "Loop", "step_id": "root.loop"}
+        state.steps.pop("Loop[2].InvokeLib")
+        state.call_frames.pop("root.loop#2.body.invoke_lib::visit::1")
+    else:
+        state.for_each["Loop"].completed_indices = [0]
+        state.for_each["Loop"].current_index = 1
+        state.steps["Loop"] = state.steps["Loop"][:1]
+    state.steps.pop("Loop[1].InvokeLib")
+    frame = state.call_frames[resumed_frame]
+    frame["status"] = "running"
+    frame["state"]["status"] = "running"
+    frame["state"]["current_step"] = {"status": "running", "name": "Gone", "step_id": "root.gone"}
+    manager._write_state()
+    before_frame = copy.deepcopy(_raw(manager)["call_frames"][resumed_frame])
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, on_error="continue")
+
+    after = _raw(manager)
+    assert result["status"] == "failed"

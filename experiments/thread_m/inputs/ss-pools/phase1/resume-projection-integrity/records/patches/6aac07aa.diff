+def _write_loop_call_workflow(workspace: Path, *, loop: str) -> Path:
+    library = {
+        "version": "2.7",
+        "name": "lib",
+        "outputs": {
+            "ready": {"kind": "scalar", "type": "bool", "from": {"ref": "root.steps.SetReady.artifacts.ready"}}
+        },
+        "artifacts": {"ready": {"kind": "scalar", "type": "bool"}},
+        "steps": [
+            {"name": "SetReady", "id": "set_ready", "set_scalar": {"artifact": "ready", "value": True}}
+        ],
+    }
+    (workspace / "lib.yaml").write_text(yaml.safe_dump(library, sort_keys=False), encoding="utf-8")
+    call = {"name": "InvokeLib", "id": "invoke_lib", "call": "lib"}
+    if loop == "repeat_until":
+        step = {
+            "name": "Loop",
+            "id": "loop",
+            "repeat_until": {
+                "id": "body",
+                "outputs": {
+                    "ready": {
+                        "kind": "scalar",
+                        "type": "bool",
+                        "from": {"ref": "self.steps.InvokeLib.artifacts.ready"},
+                    }
+                },
+                "condition": {
+                    "compare": {"left": {"ref": "self.outputs.ready"}, "op": "eq", "right": False}
+                },
+                "max_iterations": 3,
+                "steps": [call],
+            },
+        }
+    else:
+        step = {"name": "Loop", "id": "loop", "for_each": {"items": ["a", "b"], "steps": [call]}}
+    workflow = {"version": "2.7", "name": "loop-call", "imports": {"lib": "lib.yaml"}, "steps": [step]}
+    path = workspace / "workflow.yaml"
+    path.write_text(yaml.safe_dump(workflow, sort_keys=False), encoding="utf-8")
+    return path
+

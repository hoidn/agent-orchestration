+def _seed_run(workspace: Path, run_id: str, *, mutate=None):
+    workflow_path = _write_projection_workflow(workspace)
+    loaded = WorkflowLoader(workspace).load_bundle(workflow_path)
+    manager = StateManager(workspace, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(loaded))
+    state = manager.load()
+    state.status = "failed"
+    if mutate is not None:
+        mutate(state)
+    manager._write_state()
+    return loaded, manager
+
+
+def _raw(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _changed_keys(before: dict, after: dict) -> set[str]:
+    return {key for key in set(before) | set(after) if before.get(key) != after.get(key)}
+
+
+def test_state_manager_envelopes_change_only_status_error_and_updated_at(tmp_path: Path) -> None:
+    _loaded, manager = _seed_run(tmp_path, "envelope")
+    document = _raw(manager)
+    document["x_unknown_root_field"] = {"kept": True}
+    document["status"] = "running"
+    manager.state_file.write_text(json.dumps(document), encoding="utf-8")
+    manager.load()
+    before = _raw(manager)
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="workflow.yaml",
+        persisted_checksum=CHECKSUM,
+        current_checksum=None,
+        reason="workflow_unavailable",
+    )
+    after = _raw(manager)
+
+    assert _changed_keys(before, after) == {"status", "error", "updated_at"}
+    assert after["x_unknown_root_field"] == {"kept": True}
+    assert after["status"] == "failed"
+    assert after["error"] == {
+        "type": "workflow_checksum_mismatch",
+        "message": "Workflow has been modified since the run started",
+        "context": {
+            "workflow_file": "workflow.yaml",
+            "persisted_checksum": CHECKSUM,
+            "current_checksum": None,
+            "reason": "workflow_unavailable",
+        },
+    }
+    with pytest.raises(ValueError):
+        manager.record_workflow_checksum_mismatch(
+            workflow_file=None, persisted_checksum=None, current_checksum=None, reason="other"
+        )
+
+    diagnostic = {"type": "resume_projection_integrity_error", "message": "m", "context": {}}
+    manager.record_resume_projection_integrity_failure(diagnostic)
+    assert _raw(manager)["error"] == diagnostic
+    assert _changed_keys(after, _raw(manager)) == {"error", "updated_at"}
+

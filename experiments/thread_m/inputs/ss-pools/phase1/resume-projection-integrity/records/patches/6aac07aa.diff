+    next(iter(persisted.call_frames.values()))["status"] = "running"
+    manager._write_state()
+    type(bundle.projection)
+    calls: list[tuple] = []
+    original = type(bundle.projection).resolve_call_boundary
+
+    def spy(projection, *args, **kwargs):
+        calls.append((args, kwargs))
+        return original(projection, *args, **kwargs)
+
+    audited: list[tuple[str, ...]] = []
+
+    def record_audit(bundle_arg, state_arg, scope_path):
+        audited.append(scope_path.call_frame_ids)
+
+    with patch.object(type(bundle.projection), "resolve_call_boundary", spy), patch(
+        "orchestrator.workflow.executor.audit_scope"
+    ) as root_audit, patch("orchestrator.workflow.calls.audit_scope", record_audit):
+        WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    root_audit.assert_called_once()
+    assert [args for args, _ in calls][:1] == [(calls[0][0][0], "root.invoke_middle")]
+    assert len([c for c in calls if c[0][1] == "root.invoke_middle"]) == 1
+    assert calls[0][1] == {}
+    assert len(audited) == 1 and len(audited[0]) == 1
+    # The child executor does not repeat the root guard: the executor-level audit ran once.

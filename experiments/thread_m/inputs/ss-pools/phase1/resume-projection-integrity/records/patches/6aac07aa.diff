--- /dev/null
+++ b/orchestrator/workflow/yaml_import_aliases.py
@@ -0,0 +1,67 @@
+"""Node-level duplicate checks for classic-YAML workflow `imports`.
+
+PyYAML's constructor silently keeps the last of repeated mapping keys and
+flattens `<<` merges, so repeated import aliases or repeated top-level
+`imports` sections vanish before validation. This module inspects the composed
+node graph (with source marks) instead.
+
+Dependencies: PyYAML node API only. Pure function; no I/O.
+"""
+
+from typing import List, Tuple
+
+import yaml
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _effective_pairs(node: yaml.MappingNode) -> List[Tuple[yaml.Node, yaml.Node]]:
+    """Return every (key, value) pair of a mapping, expanding `<<` merge sources in place."""
+    pairs: List[Tuple[yaml.Node, yaml.Node]] = []
+    for key, value in node.value:
+        if key.tag != _MERGE_TAG:
+            pairs.append((key, value))
+            continue
+        sources = value.value if isinstance(value, yaml.SequenceNode) else [value]
+        for source in sources:
+            if isinstance(source, yaml.MappingNode):
+                pairs.extend(_effective_pairs(source))
+    return pairs
+
+
+def _position(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def duplicate_import_errors(root: yaml.Node) -> List[str]:
+    """Return error messages for repeated import aliases or repeated top-level `imports` sections.
+
+    A repeated alias is reported once per alias (naming every occurrence) and
+    suppresses the duplicate-section report; distinct-alias repeated sections
+    are reported once as a duplicate top-level mapping.
+    """
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [
+        (key, value)
+        for key, value in _effective_pairs(root)
+        if isinstance(key, yaml.ScalarNode) and key.value == "imports"
+    ]
+    alias_keys: dict[str, List[yaml.Node]] = {}
+    for _, value in sections:
+        if isinstance(value, yaml.MappingNode):
+            for key, _ in _effective_pairs(value):
+                if isinstance(key, yaml.ScalarNode):
+                    alias_keys.setdefault(key.value, []).append(key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias at " + "; ".join(_position(k) for k in keys)
+        for alias, keys in alias_keys.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping at "
+            + "; ".join(_position(key) for key, _ in sections)
+        )
+    return errors

@@ -0,0 +1,1179 @@
+"""Checksum-compatible resume projection integrity: audit, lineage and ordering."""
+
+import ast
+import copy
+import json
+from dataclasses import replace
+from pathlib import Path
+from types import MappingProxyType
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow import resume_call_lineage, resume_projection_integrity, resume_slots
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.loaded_bundle import workflow_import_bundle
+from orchestrator.workflow.resume_projection_integrity import (
+    CallFrameRetryLineageError,
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from orchestrator.workflow.state_projection import (
+    CallBoundaryProjection,
+    ResumeProjectionValidationError,
+)
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.test_workflow_state_projection import _write_projection_workflow
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+LOOP_BODY = "root.review_loop.iteration_body.write_decision"
+CHECKSUM = "sha256:" + "a" * 64
+
+
+@pytest.fixture
+def bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_workflow(tmp_path))
+
+
+def _row(step_id: str | None, name: str, status: str = "completed") -> dict:
+    row = {"status": status, "name": name}
+    if step_id is not None:
+        row["step_id"] = step_id
+    return row
+
+
+def _valid_state() -> dict:
+    return {
+        "workflow_checksum": CHECKSUM,
+        "steps": {
+            "SetReady": _row("root.set_ready", "SetReady"),
+            "ReviewLoop[1].WriteDecision": _row(
+                "root.review_loop#1.iteration_body.write_decision", "WriteDecision"
+            ),
+            "ProcessItems[0].InitializeCount": _row(
+                "root.process_items#0.initialize_count", "InitializeCount"
+            ),
+        },
+        "current_step": {
+            "status": "running",
+            "name": "RouteReady",
+            "step_id": "root.route_ready",
+        },
+        "repeat_until": {
+            "ReviewLoop": {
+                "current_iteration": 1,
+                "completed_iterations": [0],
+                "condition_evaluated_for_iteration": None,
+                "last_condition_result": None,
+            }
+        },
+        "for_each": {
+            "ProcessItems": {"items": ["alpha"], "completed_indices": [], "current_index": 0}
+        },
+        "call_frames": {},
+    }
+
+
+def _audit(bundle, state, scope=None) -> dict:
+    scope = scope or ResumeScopePath.root("workflow.yaml")
+    with pytest.raises(ResumeProjectionIntegrityError) as exc_info:
+        audit_scope(bundle, state, scope)
+    return exc_info.value.error
+
+
+def _context(error: dict) -> dict:
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == (
+        f"Resume projection integrity audit failed: {error['context']['reason']}"
+    )
+    return error["context"]
+
+
+def test_scope_path_is_an_identity_only_value() -> None:
+    root = ResumeScopePath.root("workflow.yaml")
+    child = root.child("frame-a").child("frame-b")
+
+    assert root.projection_scope == "root"
+    assert child.projection_scope == "call_frame"
+    assert child.as_context() == [
+        {"kind": "root", "workflow_file": "workflow.yaml"},
+        {"kind": "call_frame", "frame_id": "frame-a"},
+        {"kind": "call_frame", "frame_id": "frame-b"},
+    ]
+    frames = ["x"]
+    snapshot = ResumeScopePath("workflow.yaml", frames)
+    frames.append("y")
+    assert snapshot.call_frame_ids == ("x",)
+    assert root.call_frame_ids == ()
+
+
+def test_audit_accepts_a_consistent_scope_and_never_mutates_it(bundle) -> None:
+    state = _valid_state()
+    before = copy.deepcopy(state)
+
+    assert audit_scope(bundle, state, ResumeScopePath.root("workflow.yaml")) is None
+    assert state == before
+
+
+def test_rows_without_step_id_stay_compatible_and_are_not_backfilled(bundle) -> None:
+    state = _valid_state()
+    state["steps"] = {
+        "SetReady": {"status": "failed"},
+        "Removed": {"status": "completed"},
+        "ReviewLoop[3].WriteDecision": {"status": "running"},
+    }
+    before = copy.deepcopy(state)
+
+    audit_scope(bundle, state, ResumeScopePath.root("workflow.yaml"))
+
+    assert state == before
+    assert "step_id" not in state["steps"]["SetReady"]
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason", "field", "value", "count"),
+    [
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id="root.removed"),
+            "unknown_explicit_step_id",
+            "steps.SetReady.step_id",
+            "root.removed",
+            0,
+        ),
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id="root.route_ready"),
+            "presentation_slot_mismatch",
+            "steps.SetReady.step_id",
+            "root.route_ready",
+            1,
+        ),
+        (
+            lambda s: s["steps"].update(Ghost=_row("root.ghost", "Ghost")),
+            "unclaimed_explicit_step_row",
+            "steps.Ghost.step_id",
+            "root.ghost",
+            0,
+        ),
+        (
+            lambda s: s["steps"]["ReviewLoop[1].WriteDecision"].update(step_id="root.review_loop#2.stale"),
+            "unknown_explicit_step_id",
+            "steps.ReviewLoop[1].WriteDecision.step_id",
+            "root.review_loop#2.stale",
+            0,
+        ),
+        (
+            lambda s: s["steps"].update({"ReviewLoop[9].WriteDecision": _row("root.review_loop#9.iteration_body.write_decision", "WriteDecision")}),
+            "unclaimed_explicit_step_row",
+            "steps.ReviewLoop[9].WriteDecision.step_id",
+            "root.review_loop#9.iteration_body.write_decision",
+            0,
+        ),
+        (
+            lambda s: s["current_step"].update(step_id="root.removed_step"),
+            "out_of_scope_step_id",
+            "current_step.step_id",
+            "root.removed_step",
+            0,
+        ),
+        (
+            lambda s: s["current_step"].update(name="SetReady"),
+            "presentation_slot_mismatch",
+            "current_step.step_id",
+            "root.route_ready",
+            1,
+        ),
+        (
+            lambda s: s["current_step"].pop("step_id"),
+            "missing_required_identity",
+            "current_step.step_id",
+            None,
+            None,
+        ),
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id=""),
+            "unsupported_shape",
+            "steps.SetReady.step_id",
+            "",
+            None,
+        ),
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id=["root.set_ready"]),
+            "unsupported_shape",
+            "steps.SetReady.step_id",
+            None,
+            None,
+        ),
+        (lambda s: s.update(steps=["x"]), "unsupported_shape", "steps", None, None),
+        (lambda s: s.update(call_frames=["x"]), "unsupported_shape", "call_frames", None, None),
+        (
+            lambda s: s["call_frames"].update(frame="junk"),
+            "unsupported_shape",

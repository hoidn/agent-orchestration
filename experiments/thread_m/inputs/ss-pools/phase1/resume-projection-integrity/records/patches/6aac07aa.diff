+            "last_heartbeat_at": HEARTBEAT,
+        },
+        "steps": {"Prep": {"status": "completed", "exit_code": 0}},
+    }
+
+
+def _snapshot(tmp_path: Path, error_type: str) -> dict:
+    path = tmp_path / "workflows" / "flow.yaml"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(WORKFLOW, sort_keys=False), encoding="utf-8")
+    bundle = WorkflowLoader(tmp_path).load_bundle(path)
+    return build_status_snapshot(bundle, _state(error_type), tmp_path / "run")
+
+
+def _draft(snapshot: dict) -> dict:
+    return next(step for step in snapshot["steps"] if step["name"] == "Draft")
+
+
+@pytest.mark.parametrize("error_type", FORENSIC_TYPES)
+def test_forensic_current_step_is_reported_pending(tmp_path: Path, error_type: str):
+    snapshot = _snapshot(tmp_path, error_type)
+    draft = _draft(snapshot)
+    assert (
+        snapshot["run"]["status"],
+        snapshot["run"]["error"]["type"],
+        draft["status"],
+        draft["summary"],
+        draft["current_visit_count"],
+        snapshot["progress"]["running"],
+        snapshot["progress"]["pending"],
+    ) == ("failed", error_type, "pending", "pending", None, 0, 1)
+
+
+@pytest.mark.parametrize("error_type", FORENSIC_TYPES)
+def test_forensic_current_step_is_not_rendered_in_progress(tmp_path: Path, error_type: str):
+    assert "in progress" not in render_status_markdown(_snapshot(tmp_path, error_type))
+
+
+def test_ordinary_failed_run_keeps_current_step_running(tmp_path: Path):
+    draft = _draft(_snapshot(tmp_path, "command_failed"))
+    assert (draft["status"], draft["summary"], draft["current_visit_count"]) == (
+        "running",
+        "in progress",
+        2,
+    )
+
+
+def _project_row(tmp_path: Path, error_type: str):
+    path = tmp_path / "workflows" / "flow.yaml"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(WORKFLOW, sort_keys=False), encoding="utf-8")
+    run_dir = tmp_path / ".orchestrate" / "runs" / "run1"
+    run_dir.mkdir(parents=True)
+    (run_dir / "state.json").write_text(json.dumps(_state(error_type)), encoding="utf-8")
+    run = RunScanner([tmp_path]).scan().runs[0]
+    return RunProjector(now=datetime(2026, 4, 28, 12, 0, tzinfo=timezone.utc)).project_detail(run)
+
+
+@pytest.mark.parametrize("error_type", FORENSIC_TYPES)
+def test_dashboard_does_not_expose_forensic_heartbeat(tmp_path: Path, error_type: str):
+    detail = _project_row(tmp_path, error_type)
+    assert (
+        detail.row.display_status,
+        detail.row.heartbeat_at,
+        detail.row.heartbeat_age_seconds,
+        detail.row.current_step_started_at,
+        next(step.status for step in detail.steps if step.name == "Draft"),
+    ) == ("failed", None, None, None, "pending")
+
+
+def test_dashboard_keeps_heartbeat_for_ordinary_failed_run(tmp_path: Path):
+    assert _project_row(tmp_path, "command_failed").row.heartbeat_at == HEARTBEAT
+
+
+def _monitor_run(tmp_path: Path, error_type: str) -> MonitorRun:
+    run_root = tmp_path / ".orchestrate" / "runs" / "run1"
+    run_root.mkdir(parents=True, exist_ok=True)
+    return MonitorRun(
+        workspace=MonitorWorkspace(name="repo", path=tmp_path),
+        run_dir_id="run1",
+        run_root=run_root,
+        state_path=run_root / "state.json",
+        state=_state(error_type),
+    )
+
+
+def _email_body(tmp_path: Path, error_type: str) -> str:
+    config = MonitorConfig(
+        workspaces=(MonitorWorkspace(name="repo", path=tmp_path),),
+        monitor=MonitorTiming(),
+        email=EmailConfig(backend="smtp", from_address="m@example.com", to=("u@example.com",), smtp_host="smtp.example.com"),
+    )
+    event = MonitorEvent(
+        kind=MonitorEventKind.FAILED,
+        run=_monitor_run(tmp_path, error_type),
+        reason="state_failed",
+        observed_at="2026-04-28T12:00:00+00:00",
+    )
+    return render_event_email(event, config).get_content()
+
+
+@pytest.mark.parametrize("error_type", FORENSIC_TYPES)
+def test_monitor_classifies_forensic_run_as_failed_not_stalled(tmp_path: Path, error_type: str):
+    event = classify_run(
+        _monitor_run(tmp_path, error_type),
+        now=datetime(2030, 1, 1, tzinfo=timezone.utc),
+        stale_after_seconds=60,
+    )
+    assert event.kind == MonitorEventKind.FAILED
+
+
+@pytest.mark.parametrize("error_type", FORENSIC_TYPES)
+def test_monitor_email_omits_forensic_heartbeat(tmp_path: Path, error_type: str):
+    assert HEARTBEAT not in _email_body(tmp_path, error_type)
+
+
+def test_monitor_email_keeps_heartbeat_for_ordinary_failure(tmp_path: Path):
+    assert f"Heartbeat at: {HEARTBEAT}" in _email_body(tmp_path, "command_failed")

+++ b/tests/test_loader_duplicate_imports.py
@@ -0,0 +1,104 @@
+"""Classic-YAML duplicate import alias / duplicate `imports` section detection."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+CHILD = """\
+version: "2.5"
+name: child
+steps:
+  - name: Hello
+    command: ["echo", "hi"]
+"""
+
+
+def _bundle_builder_forbidden(*_args, **_kwargs):
+    raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+
+def _load_errors(tmp_path: Path, monkeypatch, text: str) -> list[str]:
+    (tmp_path / "child.yaml").write_text(CHILD)
+    (tmp_path / "other.yaml").write_text(CHILD)
+    workflow = tmp_path / "workflow.yaml"
+    workflow.write_text(text)
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _bundle_builder_forbidden)
+    with pytest.raises(WorkflowValidationError) as exc_info:
+        WorkflowLoader(tmp_path).load(workflow)
+    return [error.message for error in exc_info.value.errors]
+
+
+STEPS = """\
+steps:
+  - name: Run
+    id: run
+    call: a
+"""
+
+
+def test_duplicate_key_within_one_imports_mapping(tmp_path, monkeypatch):
+    text = 'version: "2.5"\nname: p\nimports:\n  a: child.yaml\n  a: other.yaml\n' + STEPS
+    assert _load_errors(tmp_path, monkeypatch, text) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 5, column 3"
+    ]
+
+
+def test_merge_inside_imports_repeating_alias(tmp_path, monkeypatch):
+    text = (
+        'version: "2.5"\nname: p\nbase: &base\n  a: child.yaml\n'
+        "imports:\n  <<: *base\n  a: other.yaml\n" + STEPS
+    )
+    assert _load_errors(tmp_path, monkeypatch, text) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 7, column 3"
+    ]
+
+
+def test_repeated_imports_sections_with_repeated_alias_reports_alias_only(tmp_path, monkeypatch):
+    text = 'version: "2.5"\nname: p\nimports:\n  a: child.yaml\nimports:\n  a: other.yaml\n' + STEPS
+    assert _load_errors(tmp_path, monkeypatch, text) == [
+        "imports.a: duplicate import alias at line 4, column 3; line 6, column 3"
+    ]
+
+
+def test_top_level_merge_sources_each_carrying_imports(tmp_path, monkeypatch):
+    text = (
+        'version: "2.5"\nname: p\n'
+        "x: &x\n  imports:\n    a: child.yaml\n"
+        "y: &y\n  imports:\n    a: other.yaml\n"
+        "<<: [*x, *y]\n" + STEPS
+    )
+    assert _load_errors(tmp_path, monkeypatch, text) == [
+        "imports.a: duplicate import alias at line 5, column 5; line 8, column 5"
+    ]
+
+
+def test_repeated_sections_with_distinct_aliases(tmp_path, monkeypatch):
+    text = 'version: "2.5"\nname: p\nimports:\n  a: child.yaml\nimports:\n  b: other.yaml\n' + STEPS
+    assert _load_errors(tmp_path, monkeypatch, text) == [
+        "imports: duplicate top-level mapping at line 3, column 1; line 5, column 1"
+    ]
+
+
+def test_merged_and_explicit_sections_with_distinct_aliases(tmp_path, monkeypatch):
+    text = (
+        'version: "2.5"\nname: p\nx: &x\n  imports:\n    a: child.yaml\n'
+        "<<: *x\nimports:\n  b: other.yaml\n" + STEPS
+    )
+    assert _load_errors(tmp_path, monkeypatch, text) == [
+        "imports: duplicate top-level mapping at line 4, column 3; line 7, column 1"
+    ]
+
+
+def test_single_merged_imports_section_with_unique_aliases_loads(tmp_path):
+    (tmp_path / "child.yaml").write_text(CHILD)
+    (tmp_path / "other.yaml").write_text(CHILD)
+    workflow = tmp_path / "workflow.yaml"
+    workflow.write_text(
+        'version: "2.5"\nname: p\n<<:\n  imports:\n    a: child.yaml\n    b: other.yaml\n' + STEPS
+    )
+    bundle = WorkflowLoader(tmp_path).load(workflow)
+    assert set(bundle.imports) == {"a", "b"}

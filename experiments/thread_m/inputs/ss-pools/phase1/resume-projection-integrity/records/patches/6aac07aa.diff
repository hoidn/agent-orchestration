diff --git a/orchestrator/workflow/resume_call_lineage.py b/orchestrator/workflow/resume_call_lineage.py
new file mode 100644
index 0000000..9c746ae
--- /dev/null
+++ b/orchestrator/workflow/resume_call_lineage.py
@@ -0,0 +1,199 @@
+"""Call-frame retry lineage for one call boundary.
+
+A Workflow Lisp boundary retries a failed frame into a fresh ``<base>::retry::<n>``
+frame; every other boundary has at most one resumable (non-completed) frame. The
+lineage is a pure function of the persisted frame mapping: no state is read or
+written, and member order never depends on mapping order.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, NamedTuple, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+_KNOWN_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Raised when one boundary's persisted frames do not form a valid lineage."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        frame_id: Optional[str] = None,
+        resumable_count: Optional[int] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.frame_id = frame_id
+        self.resumable_count = resumable_count
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    """One persisted frame of a boundary."""
+
+    frame_id: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    """A frame that belongs to a retry lineage (ordinal 0 is the base frame)."""
+
+    ordinal: int
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...] = ()
+    failed_predecessors: tuple[RetryFrameMember, ...] = ()
+    running_member: Optional[CallFrameMember] = None
+
+
+def _parse_member(frame_id: str) -> Optional[tuple[str, int]]:
+    """Return ``(base, ordinal)`` for a well-formed frame id, ``None`` when malformed."""
+    base, marker, suffix = frame_id.partition(RETRY_MARKER)
+    if not marker:
+        return frame_id, 0
+    if not base or RETRY_MARKER in suffix or not (suffix.isascii() and suffix.isdigit()):
+        return None
+    return (base, int(suffix)) if int(suffix) > 0 else None
+
+
+def _error(reason: str, message: str, frame_id: Optional[str], count: Optional[int] = None):
+    return CallFrameRetryLineageError(reason, message, frame_id=frame_id, resumable_count=count)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[str, Any]]
+) -> list[tuple[str, str]]:
+    """Return ``(frame_id, status)`` pairs after checking shape, caller and alias."""
+    frames: list[tuple[str, str]] = []
+    alias_seen: Any = None
+    for position, (frame_id, frame) in enumerate(frame_items):
+        if not isinstance(frame_id, str) or not isinstance(frame, Mapping):
+            raise _error("unsupported_shape", "call frame must be a mapping", frame_id)
+        status = frame.get("status")
+        if status not in _KNOWN_STATUSES:
+            raise _error("unsupported_shape", "call frame has an unknown status", frame_id)
+        if frame.get("call_step_id") != boundary_step_id:
+            raise _error("missing_call_boundary", "call frame belongs to another boundary", frame_id)
+        alias = frame.get("import_alias")
+        if position and alias != alias_seen:
+            raise _error("persisted_import_alias_mismatch", "call frames disagree on import alias", frame_id)
+        alias_seen = alias
+        frames.append((frame_id, status))
+    return frames
+
+
+def _plain_lineage(frames: list[tuple[str, str]]) -> CallFrameRetryLineage:
+    resumable = [frame_id for frame_id, status in frames if status != "completed"]
+    if len(resumable) > 1:
+        raise _error(
+            "ambiguous_resumable_call_frame",
+            "more than one resumable call frame for one boundary",
+            None,
+            len(resumable),
+        )
+    return CallFrameRetryLineage(
+        base_frame_id=resumable[0] if resumable else None,
+        completed_members=tuple(
+            CallFrameMember(frame_id) for frame_id, status in frames if status == "completed"
+        ),
+        running_member=CallFrameMember(resumable[0]) if resumable else None,
+    )
+
+
+class _Parsed(NamedTuple):
+    frame_id: str
+    status: str
+    base: str
+    ordinal: int
+
+    def as_member(self) -> RetryFrameMember:
+        return RetryFrameMember(self.frame_id, self.ordinal)
+
+
+def _parse_frames(frames: list[tuple[str, str]]) -> list[_Parsed]:
+    """Parse retry markers; a malformed marker is fatal only on a non-completed frame."""
+    parsed: list[_Parsed] = []
+    for frame_id, status in frames:
+        member = _parse_member(frame_id)
+        if member is not None:
+            parsed.append(_Parsed(frame_id, status, *member))
+        elif status != "completed":
+            raise _error("unsupported_shape", "malformed or nested retry marker", frame_id)
+    return parsed
+
+
+def _check_lineage(live: list[_Parsed], members: list[_Parsed], resumable_count: int) -> None:
+    if len({item.base for item in live}) > 1:
+        raise _error("ambiguous_resumable_call_frame", "mixed retry lineage bases", None, resumable_count)
+    ordinals = [item.ordinal for item in members]
+    if len(set(ordinals)) != len(ordinals):
+        raise _error("ambiguous_resumable_call_frame", "duplicate retry ordinal", None, resumable_count)
+    if live and sorted(ordinals) != list(range(len(ordinals))):
+        raise _error("unsupported_shape", "retry ordinals are not contiguous", None)
+    if sum(item.status == "running" for item in live) > 1:
+        raise _error(
+            "ambiguous_resumable_call_frame", "more than one running retry member", None, resumable_count
+        )
+
+
+def _lisp_lineage(frames: list[tuple[str, str]]) -> CallFrameRetryLineage:
+    parsed = _parse_frames(frames)
+    live = [item for item in parsed if item.status != "completed"]
+    base = live[0].base if live else None
+    members = [item for item in parsed if item.base == base]
+    _check_lineage(live, members, sum(status != "completed" for _, status in frames))
+    by_id = {item.frame_id: item for item in members}
+    running = [item for item in live if item.status == "running"]
+    return CallFrameRetryLineage(
+        base_frame_id=base,
+        completed_members=tuple(
+            by_id[frame_id].as_member() if frame_id in by_id else CallFrameMember(frame_id)
+            for frame_id, status in frames
+            if status == "completed"
+        ),
+        failed_predecessors=tuple(
+            sorted(
+                (item.as_member() for item in live if item.status == "failed"),
+                key=lambda member: member.ordinal,
+            )
+        ),
+        running_member=running[0].as_member() if running else None,
+    )
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group one boundary's persisted frames into a retry lineage or fail closed."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    if frontend_kind != WORKFLOW_LISP_FRONTEND_KIND:
+        return _plain_lineage(frames)
+    return _lisp_lineage(frames)
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<lowest unused positive ordinal>`` for the lineage."""
+    if lineage.base_frame_id is None:
+        raise ValueError("retry lineage has no base frame")
+    members = (
+        *lineage.completed_members,
+        *lineage.failed_predecessors,
+        *([lineage.running_member] if lineage.running_member is not None else []),
+    )
+    used = {member.ordinal for member in members if isinstance(member, RetryFrameMember)}
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py
new file mode 100644
index 0000000..98114a5
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,339 @@
+"""Checksum-compatible resume projection integrity.
+
+``audit_scope`` checks every persisted identity of ONE scope (the root run state or
+one call frame's state) against the projection of the bundle that owns that scope.
+It reads nothing but the bundle and state it is given, never mutates them, and
+raises ``ResumeProjectionIntegrityError`` carrying the stable diagnostic of
+``specs/state.md`` before any resume effect can run.
+
+Depends on: ``WorkflowStateProjection`` (slot enumeration and resolution),
+``loaded_bundle`` accessors (imports/provenance), and ``resume_call_lineage``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_call_lineage import (
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .state_projection import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+)
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+
+__all__ = [
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "audit_scope",
+    "build_diagnostic",
+    "index_retry_lineage",
+    "lineage_failure_diagnostic",
+    "next_unused_retry_frame_id",
+    "sticky_projection_error",
+]
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the run root to the scope being audited."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """A persisted identity is not owned by the current workflow projection."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    return value if value is None or isinstance(value, (str, int, float, bool)) else None
+
+
+def _workflow_file(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> Optional[str]:
+    if not scope_path.call_frame_ids:
+        return scope_path.root_workflow_file
+    recorded = state.get("workflow_file")
+    if isinstance(recorded, str) and recorded:
+        return recorded
+    path = getattr(workflow_provenance(bundle), "workflow_path", None)
+    return str(path) if path is not None else None
+
+
+def build_diagnostic(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    reason: str,
+    *,
+    field: Optional[str] = None,
+    value: Any = None,
+    count: Optional[int] = None,
+    call_step_id: Optional[str] = None,
+) -> dict[str, Any]:
+    """Build the stable diagnostic; never embeds containers, only identity scalars."""
+    return {
+        "type": ERROR_TYPE,
+        "message": f"Resume projection integrity audit failed: {reason}",
+        "context": {
+            "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+            "reason": reason,
+            "scope_path": scope_path.as_context(),
+            "field": field,
+            "offending_value": _scalar(value),
+            "expected_owner": {
+                "workflow_file": _workflow_file(bundle, state, scope_path),
+                "workflow_checksum": _scalar(state.get("workflow_checksum")),
+                "projection_scope": scope_path.projection_scope,
+            },
+            "candidate_count": count,
+            "call_boundary_step_id": call_step_id if isinstance(call_step_id, str) else None,
+        },
+    }
+
+
+def sticky_projection_error(error: Any) -> Optional[dict[str, Any]]:
+    """Return ``error`` when it is a resume projection diagnostic (never routable)."""
+    if isinstance(error, Mapping) and error.get("type") == ERROR_TYPE:
+        return error  # type: ignore[return-value]
+    return None
+
+
+def lineage_failure_diagnostic(
+    exc: CallFrameRetryLineageError,
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    call_step_id: str,
+) -> dict[str, Any]:
+    """Map a retry-lineage failure of one boundary to the stable diagnostic."""
+    if exc.reason == "ambiguous_resumable_call_frame":
+        return build_diagnostic(
+            bundle,
+            state,
+            scope_path,
+            exc.reason,
+            field="call_frames",
+            value=exc.resumable_count,
+            count=exc.resumable_count,
+            call_step_id=call_step_id,
+        )
+    field = f"call_frames.{exc.frame_id}" if exc.frame_id else "call_frames"
+    return build_diagnostic(bundle, state, scope_path, exc.reason, field=field, call_step_id=call_step_id)
+
+
+class _ScopeAudit:
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.projection = bundle.projection
+        self._for_each_frame_keys = {
+            loop.frame_key for loop in self.projection.for_each_nodes.values()
+        }
+
+    def fail(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+        count: Optional[int] = None,
+        call_step_id: Optional[str] = None,
+    ) -> ResumeProjectionIntegrityError:
+        return ResumeProjectionIntegrityError(
+            build_diagnostic(
+                self.bundle,
+                self.state,
+                self.scope_path,
+                reason,
+                field=field,
+                value=value,
+                count=count,
+                call_step_id=call_step_id,
+            )
+        )
+
+    def _section(self, key: str) -> Mapping[str, Any]:
+        section = self.state.get(key, {})
+        if not isinstance(section, Mapping):
+            raise self.fail("unsupported_shape", field=key)
+        return section
+
+    def run(self) -> None:
+        steps = self._section("steps")
+        call_frames = self._section("call_frames")
+        try:
+            slot_index = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            raise self.fail(exc.reason, field=exc.field) from None
+        for name, row in steps.items():
+            self._audit_step_row(slot_index, name, row)
+        self._audit_current_step(slot_index)
+        self._audit_call_frames(slot_index, call_frames)
+
+    def _explicit_id(self, field: str, container: Mapping[str, Any]) -> str:
+        value = container.get("step_id")
+        if not isinstance(value, str) or not value:
+            raise self.fail("unsupported_shape", field=field, value=value)
+        return value
+
+    def _audit_step_row(self, slot_index: ResumeProjectionSlotIndex, name: str, row: Any) -> None:
+        field = f"steps.{name}.step_id"
+        if isinstance(row, list) and name in self._for_each_frame_keys:
+            return
+        if not isinstance(row, Mapping):
+            raise self.fail("unsupported_shape", field=f"steps.{name}")
+        if "step_id" not in row:
+            return
+        step_id = self._explicit_id(field, row)
+        if any(name == unclaimed for unclaimed, _ in slot_index.unclaimed_explicit_rows):
+            raise self.fail("unclaimed_explicit_step_row", field=field, value=step_id, count=0)
+        resolution = self.projection.resolve_resume_step_id(slot_index, step_id, name)
+        if resolution.slot is not None:
+            return
+        if resolution.exact_identity_candidate_count == 0:
+            raise self.fail("unknown_explicit_step_id", field=field, value=step_id, count=0)
+        raise self.fail(
+            "presentation_slot_mismatch",
+            field=field,
+            value=step_id,
+            count=resolution.exact_identity_candidate_count,
+        )
+
+    def _audit_current_step(self, slot_index: ResumeProjectionSlotIndex) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            raise self.fail("unsupported_shape", field="current_step")
+        field = "current_step.step_id"
+        if "step_id" not in current:
+            raise self.fail("missing_required_identity", field=field)
+        step_id = self._explicit_id(field, current)
+        resolution = self.projection.resolve_resume_step_id(slot_index, step_id)
+        if resolution.exact_identity_candidate_count == 0:
+            raise self.fail("out_of_scope_step_id", field=field, value=step_id, count=0)
+        name = current.get("name")
+        if resolution.exact_identity_candidate_count > 1 or (
+            isinstance(name, str)
+            and name
+            and slot_index.candidates_by_step_id[step_id][0].presentation_key != name
+        ):
+            raise self.fail(
+                "presentation_slot_mismatch",
+                field=field,
+                value=step_id,
+                count=resolution.exact_identity_candidate_count,
+            )
+
+    def _frame_boundary(self, slot_index: ResumeProjectionSlotIndex, frame_id: str, frame: Any):
+        field = f"call_frames.{frame_id}"
+        if not isinstance(frame, Mapping):
+            raise self.fail("unsupported_shape", field=field)
+        id_field = f"{field}.call_step_id"
+        if "call_step_id" not in frame:
+            raise self.fail("missing_required_identity", field=id_field)
+        call_step_id = frame["call_step_id"]
+        if not isinstance(call_step_id, str) or not call_step_id:
+            raise self.fail("unsupported_shape", field=id_field, value=call_step_id)
+        resolution = self.projection.resolve_call_boundary(slot_index, call_step_id)
+        if resolution.candidate_count > 1:
+            raise self.fail(
+                "ambiguous_call_boundary",
+                field=id_field,
+                value=call_step_id,
+                count=resolution.candidate_count,
+                call_step_id=call_step_id,
+            )
+        if resolution.boundary is None:
+            reason = (
+                "missing_call_boundary"
+                if call_step_id in slot_index.candidates_by_step_id
+                else "out_of_scope_step_id"
+            )
+            raise self.fail(reason, field=id_field, value=call_step_id, count=0, call_step_id=call_step_id)
+        alias = frame.get("import_alias")
+        if alias != resolution.boundary.import_alias:
+            raise self.fail(
+                "persisted_import_alias_mismatch",
+                field=f"{field}.import_alias",
+                value=alias,
+                count=1,
+                call_step_id=call_step_id,
+            )
+        if frame.get("status") not in ("running", "failed", "completed"):
+            raise self.fail(
+                "unsupported_shape",
+                field=f"{field}.status",
+                value=frame.get("status"),
+                call_step_id=call_step_id,
+            )
+        return call_step_id, resolution.boundary
+
+    def _audit_call_frames(
+        self, slot_index: ResumeProjectionSlotIndex, call_frames: Mapping[str, Any]
+    ) -> None:
+        groups: dict[str, list[tuple[str, Any]]] = {}
+        aliases: dict[str, Any] = {}
+        for frame_id, frame in call_frames.items():
+            call_step_id, boundary = self._frame_boundary(slot_index, frame_id, frame)
+            groups.setdefault(call_step_id, []).append((frame_id, frame))
+            aliases[call_step_id] = boundary.import_alias
+        for call_step_id in sorted(groups):
+            alias = aliases[call_step_id]
+            imported = workflow_import_bundle(self.bundle, alias) if isinstance(alias, str) else None
+            if imported is None:
+                raise self.fail(
+                    "missing_imported_bundle",
+                    field=f"imports.{alias}",
+                    value=alias,
+                    count=1,
+                    call_step_id=call_step_id,
+                )
+            frontend_kind = getattr(workflow_provenance(imported), "frontend_kind", None)
+            try:
+                index_retry_lineage(call_step_id, groups[call_step_id], frontend_kind=frontend_kind)
+            except CallFrameRetryLineageError as exc:
+                raise ResumeProjectionIntegrityError(
+                    lineage_failure_diagnostic(exc, self.bundle, self.state, self.scope_path, call_step_id)
+                ) from None
+
+
+def audit_scope(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities; raise ``ResumeProjectionIntegrityError``."""
+    _ScopeAudit(bundle, state, scope_path).run()

+def test_audit_modules_stay_independent_of_migration_evidence() -> None:
+    forbidden_modules = (
+        "orchestrator.workflow_lisp.migration_parity",
+        "orchestrator.workflow_lisp.procedure_identity_retirement",
+    )
+    forbidden_names = {
+        "load_parity_targets",
+        "load_retirement_evidence",
+        "load_retirement_record",
+        "validate_retirement_record",
+    }
+    for module in (resume_projection_integrity, resume_slots, resume_call_lineage):
+        source = Path(module.__file__).read_text(encoding="utf-8")
+        tree = ast.parse(source)
+        for node in ast.walk(tree):
+            if isinstance(node, ast.ImportFrom):
+                assert (node.module or "") not in forbidden_modules
+            if isinstance(node, ast.Import):
+                assert not {alias.name for alias in node.names} & set(forbidden_modules)
+            text = None
+            if isinstance(node, ast.Name):
+                text = node.id
+            elif isinstance(node, ast.Attribute):
+                text = node.attr
+            elif isinstance(node, ast.Constant) and isinstance(node.value, str):
+                text = node.value
+            if text is None:
+                continue
+            lowered = text.lower()
+            assert text not in forbidden_names
+            assert "receipt" not in lowered
+            if "cache" in lowered:
+                assert not any(
+                    word in lowered for word in ("audit", "resume projection", "projection integrity")
+                )

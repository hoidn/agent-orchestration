+    assert after["call_frames"][resumed_frame] == before_frame
+    assert not any(key.startswith("Loop[2]") for key in after["steps"])
+    if loop == "repeat_until":
+        assert after["steps"]["Loop"]["error"] == diagnostic
+        assert after["repeat_until"]["Loop"]["current_iteration"] == 1
+    else:
+        assert after["for_each"]["Loop"]["completed_indices"] == [0]

+"""Resume slot enumeration and loop-bookkeeping validation for projection integrity.
+
+Reads only the projection and the persisted state it is given; never mutates or
+backfills either. Qualified loop ids come from the projection's own
+runtime-step-id formatters, never from parsing id strings.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from .state_projection import (
+    CallBoundaryProjection,
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    ResumeSlot,
+    WorkflowStateProjection,
+)
+
+_SHAPE = "unsupported_shape"
+_LOOP = "invalid_loop_progress"
+_EXHAUSTION_ERROR = "repeat_until_iterations_exhausted"
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _fail(reason: str, message: str, field: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError(reason, message, field=field)
+
+
+def _for_each_fields(prefix: str, progress: Any) -> tuple[list, Optional[int], list]:
+    """Return ``(items, current_index, completed_indices)`` after shape checks."""
+    if not isinstance(progress, Mapping):
+        raise _fail(_SHAPE, f"{prefix} must be a mapping", prefix)
+    items = progress.get("items")
+    if not isinstance(items, list):
+        raise _fail(_SHAPE, f"{prefix}.items must be a list", f"{prefix}.items")
+    current = progress.get("current_index")
+    if current is not None and not _is_int(current):
+        raise _fail(
+            _SHAPE,
+            f"{prefix}.current_index must be null or a non-boolean integer",
+            f"{prefix}.current_index",
+        )
+    completed = progress.get("completed_indices", [])
+    if not isinstance(completed, list):
+        raise _fail(_SHAPE, f"{prefix}.completed_indices must be a list", f"{prefix}.completed_indices")
+    return items, current, completed
+
+
+def _validate_for_each(name: str, progress: Any) -> int:
+    """Validate one ``for_each`` progress record; return its item count."""
+    prefix = f"for_each.{name}"
+    items, current, completed = _for_each_fields(prefix, progress)
+    field = f"{prefix}.completed_indices"
+    if len(set(map(repr, completed))) != len(completed):
+        raise _fail(_LOOP, f"{field} must not contain duplicate indices", field)
+    if any(not _is_int(index) or not 0 <= index < len(items) for index in completed):
+        raise _fail(_LOOP, f"{field} contains an out-of-range index", field)
+    if current is not None and not 0 <= current < len(items):
+        raise _fail(_LOOP, f"{prefix}.current_index is out of range", f"{prefix}.current_index")
+    if current is not None and current in completed:
+        raise _fail(_LOOP, f"{prefix}.current_index is already completed", f"{prefix}.current_index")
+    return len(items)
+
+
+@dataclass(frozen=True)
+class _RepeatUntilProgress:
+    prefix: str
+    current: Optional[int]
+    completed: list
+    evaluated: Optional[int]
+    result: Optional[bool]
+    exhausted: bool
+
+    def fail(self, reason: str, message: str, field: str) -> ResumeProjectionValidationError:
+        return _fail(reason, f"{self.prefix}.{message}", f"{self.prefix}.{field}")
+
+    def conflict(self) -> ResumeProjectionValidationError:
+        return self.fail(
+            _LOOP, "condition result conflicts with evaluation state", "last_condition_result"
+        )
+
+    def history(self, message: str = "completed_iterations is not valid prior history"):
+        return self.fail(_LOOP, message, "completed_iterations")
+
+
+def _repeat_until_shape(prefix: str, progress: Any) -> tuple[Optional[int], bool, list]:
+    """Return ``(current_iteration, exhausted, completed_iterations)`` after shape checks."""
+    if not isinstance(progress, Mapping):
+        raise _fail(_SHAPE, f"{prefix} must be a mapping", prefix)
+    current = progress.get("current_iteration", False)
+    if not (current is None or _is_int(current)):
+        raise _fail(
+            _SHAPE,
+            f"{prefix}.current_iteration must be null or a non-boolean integer",
+            f"{prefix}.current_iteration",
+        )
+    exhausted = progress.get("exhausted")
+    if exhausted is not None and not isinstance(exhausted, bool):
+        raise _fail(_SHAPE, f"{prefix}.exhausted must be boolean when present", f"{prefix}.exhausted")
+    completed = progress.get("completed_iterations", [])
+    if not isinstance(completed, list):
+        field = f"{prefix}.completed_iterations"
+        raise _fail(_SHAPE, f"{field} must be a list", field)
+    return current, bool(exhausted), completed
+
+
+def _repeat_until_fields(prefix: str, progress: Any) -> _RepeatUntilProgress:
+    current, exhausted, completed = _repeat_until_shape(prefix, progress)
+    parsed = _RepeatUntilProgress(
+        prefix,
+        current,
+        completed,
+        progress.get("condition_evaluated_for_iteration"),
+        progress.get("last_condition_result"),
+        exhausted,
+    )
+    if len(set(map(repr, completed))) != len(completed):
+        raise parsed.history("completed_iterations must not contain duplicate indices")
+    if any(not _is_int(index) or index < 0 for index in completed):
+        raise parsed.history()
+    evaluated_ok = parsed.evaluated is None or _is_int(parsed.evaluated)
+    result_ok = parsed.result is None or isinstance(parsed.result, bool)
+    if not (evaluated_ok and result_ok):
+        raise parsed.conflict()
+    return parsed
+
+
+def _validate_active_repeat_until(progress: _RepeatUntilProgress, max_iterations: Optional[int]) -> None:
+    current = progress.current
+    assert current is not None
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise progress.fail(_LOOP, "current_iteration is out of range", "current_iteration")
+    if any(index >= current for index in progress.completed):
+        raise progress.history()
+    consistent = (progress.evaluated is None) == (progress.result is None) and (
+        progress.evaluated in (None, current)
+    )
+    if not consistent or progress.exhausted:
+        raise progress.conflict()
+
+
+def _check_exhaustion_frame(progress: _RepeatUntilProgress, frame: Any) -> None:
+    status = frame.get("status") if isinstance(frame, Mapping) else None
+    error = frame.get("error") if isinstance(frame, Mapping) else None
+    if progress.exhausted:
+        if status != "completed":
+            raise progress.fail(_LOOP, "successful exhaustion requires a completed frame", "exhausted")
+        return
+    terminal_error = isinstance(error, Mapping) and error.get("type") == _EXHAUSTION_ERROR
+    if status != "failed" or not terminal_error:
+        raise progress.fail(_LOOP, "failed exhaustion requires the terminal exhaustion error", "exhausted")
+
+
+def _validate_terminal_repeat_until(
+    progress: _RepeatUntilProgress, max_iterations: Optional[int], frame: Any
+) -> None:
+    completed, evaluated = progress.completed, progress.evaluated
+    needs_history = "terminal progress requires completed evaluated history"
+    if evaluated is None or evaluated not in completed or max(completed) != evaluated:
+        raise progress.history(needs_history)
+    if progress.result is None or (progress.result is True and progress.exhausted):
+        raise progress.conflict()
+    if progress.result is True:
+        return
+    if max_iterations is not None and sorted(completed) != list(range(max_iterations)):
+        raise progress.history(needs_history)
+    _check_exhaustion_frame(progress, frame)
+
+
+def _validate_repeat_until(
+    name: str,
+    progress: Any,
+    *,
+    max_iterations: Optional[int],
+    frame: Any,
+) -> tuple[int, ...]:
+    """Validate one ``repeat_until`` progress record; return the iterations that may exist."""
+    parsed = _repeat_until_fields(f"repeat_until.{name}", progress)
+    if parsed.current is not None:
+        _validate_active_repeat_until(parsed, max_iterations)
+        return (*parsed.completed, parsed.current)
+    _validate_terminal_repeat_until(parsed, max_iterations, frame)
+    return tuple(parsed.completed)
+
+
+def _mapping_section(state: Mapping[str, Any], key: str) -> Mapping[str, Any]:
+    section = state.get(key, {})
+    if not isinstance(section, Mapping):
+        raise _fail(_SHAPE, f"{key} must be a mapping", key)
+    return section
+
+
+def _loop_iterations(
+    projection: WorkflowStateProjection, state: Mapping[str, Any]
+) -> dict[str, tuple[int, ...]]:
+    """Validate loop bookkeeping and return the iteration indices each loop node may own."""
+    for_each_state = _mapping_section(state, "for_each")
+    repeat_state = _mapping_section(state, "repeat_until")
+    steps = state.get("steps")
+    steps = steps if isinstance(steps, Mapping) else {}
+    iterations: dict[str, tuple[int, ...]] = {}
+    for name, progress in for_each_state.items():
+        count = _validate_for_each(name, progress)
+        for node_id, loop in projection.for_each_nodes.items():
+            if loop.frame_key == name:
+                iterations[node_id] = tuple(range(count or 0))
+    for name, progress in repeat_state.items():
+        loop_nodes = [(n, p) for n, p in projection.repeat_until_nodes.items() if p.frame_key == name]
+        limit = loop_nodes[0][1].max_iterations if loop_nodes else None
+        history = _validate_repeat_until(name, progress, max_iterations=limit, frame=steps.get(name))
+        for node_id, loop in loop_nodes:
+            iterations[node_id] = (
+                tuple(range(loop.max_iterations)) if loop.max_iterations is not None else history
+            )
+    return iterations
+
+
+def _top_level_slots(projection: WorkflowStateProjection) -> list[ResumeSlot]:
+    return [
+        ResumeSlot(
+            step_id=entry.step_id,
+            node_id=entry.node_id,
+            presentation_key=entry.presentation_key,
+            region=entry.region,
+        )
+        for entry in projection.entries_by_node_id.values()
+        if entry.compatibility_index is not None or entry.finalization_index is not None
+    ]
+
+
+def _loop_slots(
+    projection: WorkflowStateProjection, iterations: Mapping[str, tuple[int, ...]]
+) -> list[ResumeSlot]:
+    slots: list[ResumeSlot] = []
+    for loops in (projection.repeat_until_nodes, projection.for_each_nodes):
+        for loop_node_id, loop in loops.items():
+            for nested_node_id in loop.nested_presentation_keys:
+                entry = projection.entries_by_node_id.get(nested_node_id)
+                if entry is None:
+                    continue
+                for index in iterations.get(loop_node_id, ()):
+                    slots.append(
+                        ResumeSlot(
+                            step_id=loop.runtime_step_id(index, nested_node_id),
+                            node_id=nested_node_id,
+                            presentation_key=loop.step_key(index, nested_node_id),
+                            region=entry.region,
+                            iteration_index=index,
+                            loop_node_id=loop_node_id,
+                        )
+                    )
+    return slots
+
+
+def _call_boundaries(
+    projection: WorkflowStateProjection, iterations: Mapping[str, tuple[int, ...]]
+) -> dict[str, list[CallBoundaryProjection]]:
+    boundaries: dict[str, list[CallBoundaryProjection]] = {}
+    for boundary in projection.call_boundaries.values():
+        if boundary.iteration_owner_node_id is None:
+            ids = [boundary.step_id]
+        else:
+            ids = [
+                boundary.runtime_step_id(index)
+                for index in iterations.get(boundary.iteration_owner_node_id, ())
+            ]
+        for step_id in ids:
+            boundaries.setdefault(step_id, []).append(boundary)
+    return boundaries
+
+
+def enumerate_resume_slots(
+    projection: WorkflowStateProjection, state: Mapping[str, Any]
+) -> ResumeProjectionSlotIndex:
+    """Build the candidate tables for one scope (see ``WorkflowStateProjection``)."""
+    iterations = _loop_iterations(projection, state)
+    candidates: dict[str, list[ResumeSlot]] = {}
+    for slot in (*_top_level_slots(projection), *_loop_slots(projection, iterations)):
+        candidates.setdefault(slot.step_id, []).append(slot)
+    keys = frozenset(slot.presentation_key for group in candidates.values() for slot in group)
+    steps = state.get("steps")
+    unclaimed = tuple(
+        (name, deepcopy(row["step_id"]))
+        for name, row in (steps.items() if isinstance(steps, Mapping) else ())
+        if isinstance(row, Mapping) and "step_id" in row and name not in keys
+    )
+    return ResumeProjectionSlotIndex(
+        candidates_by_step_id={key: tuple(group) for key, group in candidates.items()},
+        call_boundaries_by_step_id={
+            key: tuple(group) for key, group in _call_boundaries(projection, iterations).items()
+        },
+        unclaimed_explicit_rows=unclaimed,
+        presentation_keys=keys,
+    )

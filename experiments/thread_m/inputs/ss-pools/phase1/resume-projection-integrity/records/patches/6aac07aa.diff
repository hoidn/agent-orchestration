@@ -0,0 +1,86 @@
+"""Workflow Lisp bundles carry typed `frontend_kind` provenance; classic YAML imports do not."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow_lisp.build import FrontendBuildRequest, build_frontend_bundle
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+CLI_FIXTURES = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp" / "cli"
+SOURCE_ROOT = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp" / "modules" / "valid" / "imported_bundle_mix"
+ENTRYPOINT = SOURCE_ROOT / "neurips" / "entry.orc"
+ENTRY_NAME = "neurips/entry::orchestrate"
+HELPER_NAME = "neurips/helper::provider-attempt"
+
+
+@pytest.fixture
+def classic_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(CLI_FIXTURES / "imported_selector.yaml")
+
+
+@pytest.fixture
+def compiled(tmp_path: Path, classic_bundle):
+    return compile_stage3_entrypoint(
+        ENTRYPOINT,
+        source_roots=(SOURCE_ROOT,),
+        entry_workflow="orchestrate",
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={
+            "prompts.implementation.execute": "tests/fixtures/workflow_lisp/valid/prompts/implementation/execute.md"
+        },
+        imported_workflow_bundles={"selector-run": classic_bundle},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+
+
+def test_every_compiled_bundle_is_tagged_workflow_lisp(compiled) -> None:
+    kinds = {name: bundle.provenance.frontend_kind for name, bundle in compiled.validated_bundles_by_name.items()}
+    assert kinds == {ENTRY_NAME: "workflow_lisp", HELPER_NAME: "workflow_lisp"}
+
+
+def test_imported_orc_bundle_linked_into_entry_is_tagged_workflow_lisp(compiled) -> None:
+    entry = compiled.validated_bundles_by_name[ENTRY_NAME]
+    assert entry.imports[HELPER_NAME].provenance.frontend_kind == "workflow_lisp"
+
+
+def test_classic_yaml_import_is_linked_by_identity(compiled, classic_bundle) -> None:
+    entry = compiled.validated_bundles_by_name[ENTRY_NAME]
+    assert entry.imports["selector-run"] is classic_bundle
+
+
+def test_classic_yaml_import_keeps_unset_frontend_kind(compiled, classic_bundle) -> None:
+    entry = compiled.validated_bundles_by_name[ENTRY_NAME]
+    assert entry.imports["selector-run"].provenance.frontend_kind is None
+
+
+def test_build_frontend_bundle_keeps_compiler_frontend_kind(tmp_path: Path) -> None:
+    result = build_frontend_bundle(
+        FrontendBuildRequest(
+            source_path=ENTRYPOINT,
+            source_roots=(SOURCE_ROOT,),
+            entry_workflow="orchestrate",
+            provider_externs_path=CLI_FIXTURES / "providers.json",
+            prompt_externs_path=CLI_FIXTURES / "prompts.json",
+            imported_workflow_bundles_path=CLI_FIXTURES / "imported_workflow_bundles.json",
+            command_boundaries_path=CLI_FIXTURES / "commands.json",
+            emit_debug_yaml=False,
+            workspace_root=tmp_path,
+        )
+    )
+    assert result.validated_bundle.provenance.frontend_kind == "workflow_lisp"
+
+
+def test_call_target_classification_follows_frontend_kind(compiled, classic_bundle) -> None:
+    entry = compiled.validated_bundles_by_name[ENTRY_NAME]
+    assert (
+        CallExecutor._is_workflow_lisp_target(entry),
+        CallExecutor._is_workflow_lisp_target(classic_bundle),
+    ) == (True, False)

+def _rewrite_root_with_route_and_cleanup(workspace: Path, *, cleanup_command: str) -> None:
+    path = workspace / "workflow.yaml"
+    workflow = yaml.safe_load(path.read_text(encoding="utf-8"))
+    workflow["steps"][0]["on"] = {"failure": {"goto": "Recover"}, "always": {"goto": "Recover"}}
+    workflow["steps"].append(
+        {
+            "name": "Recover",
+            "id": "recover",
+            "command": ["bash", "-lc", "mkdir -p state && echo routed > state/routed.txt"],
+        }
+    )
+    workflow["finally"] = {
+        "id": "cleanup",
+        "steps": [{"name": "Cleanup", "id": "cleanup_step", "command": ["bash", "-lc", cleanup_command]}],
+    }
+    path.write_text(yaml.safe_dump(workflow, sort_keys=False), encoding="utf-8")
+
+
+def _corrupt_callee(manager: StateManager, run_id: str) -> str:
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    frame["state"]["current_step"] = {
+        "status": "running",
+        "name": "Gone",
+        "step_id": "root.gone",
+    }
+    frame["state"]["status"] = "failed"
+    frame["status"] = "running"
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    return frame_id
+
+
+@pytest.mark.parametrize(
+    ("cleanup_command", "cleanup_error_is_null"),
+    [("echo cleaned > state/cleaned.txt", None), ("mkdir -p state && echo x > state/cleaned.txt && exit 3", True)],
+)
+def test_projection_failure_is_sticky_and_finalization_is_supplemental(
+    tmp_path: Path, cleanup_command: str, cleanup_error_is_null
+) -> None:
+    _write_projection_integrity_call_graph(tmp_path)
+    _rewrite_root_with_route_and_cleanup(tmp_path, cleanup_command="mkdir -p state && " + cleanup_command)
+    bundle = WorkflowLoader(tmp_path).load_bundle(tmp_path / "workflow.yaml")
+    manager = StateManager(tmp_path, run_id="sticky")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    first = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    assert first["status"] in {"completed", "failed"}
+    (tmp_path / "state" / "routed.txt").unlink(missing_ok=True)
+    (tmp_path / "state" / "cleaned.txt").unlink(missing_ok=True)
+    _corrupt_callee(manager, "sticky")
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, on_error="continue")
+
+    persisted = _raw(manager)
+    diagnostic = persisted["error"]
+    assert result["status"] == "failed"
+    assert diagnostic["type"] == "resume_projection_integrity_error"
+    assert diagnostic["context"]["reason"] == "out_of_scope_step_id"
+    assert persisted["steps"]["InvokeMiddle"]["error"] == diagnostic
+    assert persisted["steps"]["InvokeMiddle"]["error"]["type"] != "call_failed"
+    assert not (tmp_path / "state" / "routed.txt").exists()
+    assert (tmp_path / "state" / "cleaned.txt").exists()
+    finalization = persisted["finalization"]
+    if cleanup_error_is_null:
+        assert finalization["status"] == "failed"
+        assert finalization["failure"] == {
+            "step": "finally.Cleanup",
+            "step_id": "root.finally.cleanup.cleanup_step",
+            "error": None,
+        }
+    else:
+        assert finalization["status"] == "completed"

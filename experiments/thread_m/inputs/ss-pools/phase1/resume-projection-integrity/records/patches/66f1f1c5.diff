+"""Typed Workflow Lisp provenance (`provenance.frontend_kind`) on compiled bundles."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from pathlib import Path
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint, compile_stage3_module
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+
+FIXTURES = Path(__file__).parent / "fixtures" / "workflow_lisp" / "modules" / "valid" / "workflow_refs"
+ROOT = Path(__file__).parent.parent
+
+
+def _compile(tmp_path: Path, **kwargs):
+    return compile_stage3_entrypoint(
+        FIXTURES / "workflow_refs" / "imported_entry.orc",
+        source_roots=(FIXTURES,),
+        command_boundaries={
+            "run_checks": ExternalToolBinding(
+                name="run_checks", stable_command=("python", "scripts/run_checks.py")
+            )
+        },
+        lowering_route="legacy",
+        validate_shared=True,
+        workspace_root=tmp_path,
+        **kwargs,
+    )
+
+
+def test_every_validated_bundle_is_workflow_lisp(tmp_path: Path) -> None:
+    result = _compile(tmp_path)
+    assert result.validated_bundles_by_name
+    kinds = {name: b.provenance.frontend_kind for name, b in result.validated_bundles_by_name.items()}
+    assert set(kinds.values()) == {"workflow_lisp"}
+    assert "workflow_refs/imported_helper::echo-helper" in kinds
+
+
+def test_nested_provenance_copies_agree(tmp_path: Path) -> None:
+    bundle = next(iter(_compile(tmp_path).validated_bundles_by_name.values()))
+    assert bundle.surface.provenance.frontend_kind == "workflow_lisp"
+    assert bundle.ir.provenance.frontend_kind == "workflow_lisp"
+
+
+def test_non_lisp_imported_bundle_is_linked_as_same_object(tmp_path: Path) -> None:
+    source = tmp_path / "selector_run.orc"
+    source.write_text(
+        "\n".join(
+            [
+                "(workflow-lisp",
+                '  (:language "0.1")',
+                '  (:target-dsl "2.14")',
+                "  (defpath WorkReport",
+                "    :kind relpath",
+                '    :under "artifacts/work"',
+                "    :must-exist true)",
+                "  (defrecord ChecksResult",
+                "    (status String)",
+                "    (report WorkReport))",
+                "  (defrecord ImplementationSummary",
+                "    (report WorkReport))",
+                "  (defworkflow selector-run",
+                "    ((input ChecksResult)",
+                "     (report_path WorkReport))",
+                "    -> ImplementationSummary",
+                "    (provider-result providers.execute",
+                "      :prompt prompts.implementation.execute",
+                "      :inputs (input report_path)",
+                "      :returns ImplementationSummary)))",
+            ]
+        ),
+        encoding="utf-8",
+    )
+    externs = dict(
+        provider_externs={"providers.execute": "test-provider"},
+        prompt_externs={"prompts.implementation.execute": "prompts/implementation/execute.md"},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    lisp = compile_stage3_module(source, **externs).validated_bundles["selector-run"]
+    foreign = replace(lisp, provenance=replace(lisp.provenance, frontend_kind=None))
+    mix = Path(__file__).parent / "fixtures/workflow_lisp/modules/valid/imported_bundle_mix"
+    result = compile_stage3_entrypoint(
+        mix / "neurips" / "entry.orc",
+        source_roots=(mix,),
+        imported_workflow_bundles={"selector-run": foreign},
+        **externs,
+    )
+    linked = [b.imports["selector-run"] for b in result.validated_bundles_by_name.values() if "selector-run" in b.imports]
+    assert linked and all(b is foreign for b in linked)
+    assert foreign.provenance.frontend_kind is None
+

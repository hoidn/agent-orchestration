+class TestDuplicateImportAliases:
+    """Duplicate import aliases / sections are rejected before bundle construction."""
+
+    CALLEE = "version: '2.5'\nname: callee\nsteps:\n  - name: S\n    command: ['true']\n"
+
+    def _load(self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, body: str) -> list[str]:
+        import orchestrator.loader as loader_module
+
+        (tmp_path / "a.yaml").write_text(self.CALLEE)
+        (tmp_path / "b.yaml").write_text(self.CALLEE)
+        wf = tmp_path / "wf.yaml"
+        wf.write_text(body)
+
+        def boom(*args, **kwargs):
+            raise AssertionError("build_loaded_workflow_bundle reached")
+
+        monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", boom)
+        with pytest.raises(WorkflowValidationError) as excinfo:
+            WorkflowLoader(tmp_path).load(wf)
+        return [str(e) for e in excinfo.value.errors]
+
+    TAIL = "steps:\n  - name: C\n    command: ['true']\n"
+
+    def test_duplicate_alias_key(self, tmp_path, monkeypatch):
+        errors = self._load(
+            tmp_path,
+            monkeypatch,
+            "version: '2.5'\nname: x\nimports:\n  lib: a.yaml\n  lib: b.yaml\n" + self.TAIL,
+        )
+        hits = [e for e in errors if "duplicate import alias" in e]
+        assert len(hits) == 1
+        assert "imports.lib: duplicate import alias" in hits[0]
+        assert "line 4, column 3" in hits[0] and "line 5, column 3" in hits[0]
+        assert not any("duplicate top-level mapping" in e for e in errors)
+
+    def test_merge_inside_imports_repeating_alias(self, tmp_path, monkeypatch):
+        errors = self._load(
+            tmp_path,
+            monkeypatch,
+            "version: '2.5'\nname: x\ncontext:\n  base: &b\n    lib: a.yaml\nimports:\n  <<: *b\n  lib: b.yaml\n" + self.TAIL,
+        )
+        hits = [e for e in errors if "duplicate import alias" in e]
+        assert len(hits) == 1 and "line 5, column 5" in hits[0] and "line 8, column 3" in hits[0]
+
+    def test_two_top_level_sections_sharing_alias(self, tmp_path, monkeypatch):
+        errors = self._load(
+            tmp_path,
+            monkeypatch,
+            "version: '2.5'\nname: x\nimports:\n  lib: a.yaml\nimports:\n  lib: b.yaml\n" + self.TAIL,
+        )
+        assert len([e for e in errors if "imports.lib: duplicate import alias" in e]) == 1
+        assert not any("duplicate top-level mapping" in e for e in errors)
+
+    def test_top_level_merge_sources_each_carry_imports(self, tmp_path, monkeypatch):
+        errors = self._load(
+            tmp_path,
+            monkeypatch,
+            "version: '2.5'\nname: x\ncontext:\n  m1: &m1\n    imports:\n      lib: a.yaml\n  m2: &m2\n    imports:\n      lib: b.yaml\n<<: [*m1, *m2]\n"
+            + self.TAIL,
+        )
+        hits = [e for e in errors if "imports.lib: duplicate import alias" in e]
+        assert len(hits) == 1 and "line 6, column 7" in hits[0] and "line 9, column 7" in hits[0]
+
+    def test_distinct_alias_sections_report_duplicate_section_once(self, tmp_path, monkeypatch):
+        errors = self._load(
+            tmp_path,
+            monkeypatch,
+            "version: '2.5'\nname: x\nimports:\n  one: a.yaml\nimports:\n  two: b.yaml\n" + self.TAIL,
+        )
+        hits = [e for e in errors if "imports: duplicate top-level mapping" in e]
+        assert len(hits) == 1 and "line 3, column 1" in hits[0] and "line 5, column 1" in hits[0]
+        assert not any("duplicate import alias" in e for e in errors)
+
+    def test_merged_and_explicit_distinct_sections(self, tmp_path, monkeypatch):
+        errors = self._load(
+            tmp_path,
+            monkeypatch,
+            "version: '2.5'\nname: x\ncontext:\n  m1: &m1\n    imports:\n      one: a.yaml\n<<: *m1\nimports:\n  two: b.yaml\n" + self.TAIL,
+        )
+        assert len([e for e in errors if "imports: duplicate top-level mapping" in e]) == 1
+
+    def test_single_merged_imports_with_unique_aliases_loads(self, tmp_path):
+        (tmp_path / "a.yaml").write_text(self.CALLEE)
+        (tmp_path / "b.yaml").write_text(self.CALLEE)
+        wf = tmp_path / "wf.yaml"
+        wf.write_text(
+            "version: '2.5'\nname: x\ncontext:\n  base: &b\n    one: a.yaml\nimports:\n  <<: *b\n  two: b.yaml\n" + self.TAIL
+        )
+        bundle = WorkflowLoader(tmp_path).load(wf)
+        assert set(bundle.imports) == {"one", "two"}

@@ -0,0 +1,61 @@
+"""Structural-root resume guard: authoritative checksum recheck, then root scope audit.
+
+Runs inside `WorkflowExecutor.execute(resume=True)` before the typed state load and the
+execution prologue. A child call-frame executor never runs it. Failures persist only the
+root `status`/`error`/`updated_at` envelope (raw patch; unknown root fields are preserved).
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Callable, Mapping, Optional
+
+from .executor_runtime import CallFrameStateManager
+from .resume_projection_integrity import ResumeProjectionIntegrityError, ResumeScopePath
+
+
+def _checksum_failure(state_manager: Any, raw: Mapping[str, Any]) -> Optional[dict[str, Optional[str]]]:
+    """Return the checksum envelope arguments when the root checksum recheck fails."""
+    workflow_file = raw.get("workflow_file")
+    persisted = raw.get("workflow_checksum")
+    persisted = persisted if isinstance(persisted, str) else None
+    file_name = workflow_file if isinstance(workflow_file, str) else None
+
+    def failure(reason: str, current: Optional[str] = None) -> dict[str, Optional[str]]:
+        return {
+            "workflow_file": file_name,
+            "persisted_checksum": persisted,
+            "current_checksum": current,
+            "reason": reason,
+        }
+
+    if file_name is None:
+        return failure("missing_workflow_path")
+    if persisted is None:
+        return failure("missing_recorded_checksum")
+    workflow_path = Path(state_manager.workspace) / file_name
+    try:
+        current = state_manager.calculate_checksum(workflow_path)
+    except OSError:
+        return failure("workflow_unavailable")
+    return failure("workflow_modified", current) if current != persisted else None
+
+
+def run_root_resume_guard(
+    executor: Any, audit: Callable[[Any, Mapping[str, Any], ResumeScopePath], None]
+) -> Optional[dict[str, Any]]:
+    """Return the failed persisted state when the guard rejects this resume, else None."""
+    state_manager = executor.state_manager
+    if isinstance(state_manager, CallFrameStateManager):
+        return None
+    raw = state_manager.read_persisted_state()
+    envelope = _checksum_failure(state_manager, raw)
+    if envelope is not None:
+        state_manager.record_workflow_checksum_mismatch(**envelope)
+        return state_manager.read_persisted_state()
+    try:
+        audit(executor.loaded_bundle, raw, ResumeScopePath.root(raw["workflow_file"]))
+    except ResumeProjectionIntegrityError as exc:
+        state_manager.record_resume_projection_integrity_failure(exc.error)
+        return state_manager.read_persisted_state()
+    return None
diff --git a/orchestrator/workflow/resume_slots.py b/orchestrator/workflow/resume_slots.py
new file mode 100644
index 0000000..373a2a2
--- /dev/null
+++ b/orchestrator/workflow/resume_slots.py
@@ -0,0 +1,353 @@
+"""Resume-slot enumeration and loop-bookkeeping validation over a workflow projection.
+
+Inputs: a `WorkflowStateProjection` and a raw persisted state mapping (never mutated).
+Candidates are generated forward from the projection (`IterationStepKeyProjection` /
+`CallBoundaryProjection` runtime-id builders) and compared exactly; no persisted id is
+split, normalized, prefix-matched or backfilled.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import TYPE_CHECKING, Any, Mapping, Optional
+
+from .executable_ir import WorkflowRegion
+
+if TYPE_CHECKING:
+    from .state_projection import CallBoundaryProjection, WorkflowStateProjection
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted resume bookkeeping that the current projection cannot own."""
+
+    def __init__(self, reason: str, message: str, field: Optional[str] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+
+    def __str__(self) -> str:
+        return self.message
+
+
+@dataclass(frozen=True)
+class ResumeSlot:
+    """One persisted step row the current projection could own."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    region: WorkflowRegion
+    iteration_index: Optional[int] = None
+    loop_node_id: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class ResumeProjectionSlotIndex:
+    """Candidate tables derived from one projection and one raw state."""
+
+    candidates_by_step_id: Mapping[str, tuple[ResumeSlot, ...]]
+    call_boundaries_by_step_id: Mapping[str, tuple["CallBoundaryProjection", ...]]
+    slots_by_row_name: Mapping[str, tuple[ResumeSlot, ...]]
+    unclaimed_explicit_rows: tuple[tuple[str, Any], ...] = ()
+
+
+@dataclass(frozen=True)
+class ResumeIdentityResolution:
+    slot: Optional[ResumeSlot]
+    candidate_count: int
+    exact_identity_candidate_count: int
+
+
+@dataclass(frozen=True)
+class ResumeCallBoundaryResolution:
+    boundary: Optional["CallBoundaryProjection"]
+    candidate_count: int
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+_FIELD_BY_SUBJECT = {
+    "condition": "last_condition_result",
+    "terminal": "completed_iterations",
+    "successful": "exhausted",
+    "failed": "exhausted",
+}
+
+
+def _fail(reason: str, message: str) -> ResumeProjectionValidationError:
+    """Build the error; `field` is the dotted persisted path the message names."""
+    path = message.split(" ", 1)[0]
+    head, _, last = path.rpartition(".")
+    field = f"{head}.{_FIELD_BY_SUBJECT[last]}" if last in _FIELD_BY_SUBJECT else path
+    return ResumeProjectionValidationError(reason, message, field)
+
+
+def _mapping_section(state: Mapping[str, Any], name: str) -> Mapping[str, Any]:
+    section = state.get(name, {})
+    if not isinstance(section, Mapping):
+        raise _fail("unsupported_shape", f"{name} must be a mapping")
+    return section
+
+
+def _int_list(entry: Mapping[str, Any], key: str, prefix: str) -> list[Any]:
+    value = entry.get(key, [])
+    if not isinstance(value, list):
+        raise _fail("unsupported_shape", f"{prefix}.{key} must be a list")
+    return value
+
+
+def _optional_index(entry: Mapping[str, Any], key: str, prefix: str) -> Optional[int]:
+    value = entry.get(key)
+    if value is not None and not _is_index(value):
+        raise _fail("unsupported_shape", f"{prefix}.{key} must be null or a non-boolean integer")
+    return value
+
+
+def validate_for_each_progress(name: str, entry: Any) -> tuple[int, ...]:
+    """Validate one `for_each` bookkeeping entry; return the admitted iteration indices."""
+    prefix = f"for_each.{name}"
+    if not isinstance(entry, Mapping):
+        raise _fail("unsupported_shape", f"{prefix} must be a mapping")
+    items = entry.get("items")
+    if not isinstance(items, list):
+        raise _fail("unsupported_shape", f"{prefix}.items must be a list")
+    current = _optional_index(entry, "current_index", prefix)
+    completed = _int_list(entry, "completed_indices", prefix)
+    if len(set(map(repr, completed))) != len(completed):
+        raise _fail("invalid_loop_progress", f"{prefix}.completed_indices must not contain duplicate indices")
+    if not all(_is_index(i) and 0 <= i < len(items) for i in completed):
+        raise _fail("invalid_loop_progress", f"{prefix}.completed_indices contains an out-of-range index")
+    if current is not None:
+        if not 0 <= current < len(items):
+            raise _fail("invalid_loop_progress", f"{prefix}.current_index is out of range")
+        if current in completed:
+            raise _fail("invalid_loop_progress", f"{prefix}.current_index is already completed")
+    return tuple(sorted(set(completed) | ({current} if current is not None else set())))
+
+
+def _repeat_until_fields(name: str, entry: Any) -> dict[str, Any]:
+    prefix = f"repeat_until.{name}"
+    if not isinstance(entry, Mapping):
+        raise _fail("unsupported_shape", f"{prefix} must be a mapping")
+    current = _optional_index(entry, "current_iteration", prefix)
+    completed = _int_list(entry, "completed_iterations", prefix)
+    evaluated = entry.get("condition_evaluated_for_iteration")
+    if evaluated is not None and not _is_index(evaluated):
+        raise _fail("unsupported_shape", f"{prefix}.condition_evaluated_for_iteration must be null or a non-boolean integer")
+    result = entry.get("last_condition_result")
+    if result is not None and not isinstance(result, bool):
+        raise _fail("unsupported_shape", f"{prefix}.last_condition_result must be null or boolean")
+    exhausted = entry.get("exhausted")
+    if exhausted is not None and not isinstance(exhausted, bool):
+        raise _fail("unsupported_shape", f"{prefix}.exhausted must be boolean when present")
+    if len(set(map(repr, completed))) != len(completed):
+        raise _fail("invalid_loop_progress", f"{prefix}.completed_iterations must not contain duplicate indices")
+    if not all(_is_index(i) and i >= 0 for i in completed):
+        raise _fail("invalid_loop_progress", f"{prefix}.completed_iterations is not valid prior history")
+    return {
+        "current": current,
+        "completed": sorted(completed),
+        "evaluated": evaluated,
+        "result": result,
+        "exhausted": exhausted is True,
+    }
+
+
+def _validate_active(prefix: str, f: dict[str, Any], max_iterations: Optional[int]) -> None:
+    current, evaluated, result = f["current"], f["evaluated"], f["result"]
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise _fail("invalid_loop_progress", f"{prefix}.current_iteration is out of range")
+    if f["completed"] != list(range(current)):
+        raise _fail("invalid_loop_progress", f"{prefix}.completed_iterations is not valid prior history")
+    consistent = (evaluated is None and result is None) or (evaluated == current and result is not None)
+    if f["exhausted"] or not consistent:
+        raise _fail("invalid_loop_progress", f"{prefix}.condition result conflicts with evaluation state")
+
+
+def _check_exhaustion_row(prefix: str, f: dict[str, Any], loop_row: Any) -> None:
+    """Terminal exhaustion needs the matching loop-frame row (absent rows are tolerated)."""
+    if loop_row is None:
+        return  # the loop frame row may legitimately be absent (restore boundaries drop it)
+    row = loop_row if isinstance(loop_row, Mapping) else {}
+    if f["exhausted"]:
+        if row.get("status") != "completed":
+            raise _fail("invalid_loop_progress", f"{prefix}.successful exhaustion requires a completed frame")
+        return
+    error = row.get("error")
+    if row.get("status") != "failed" or not (
+        isinstance(error, Mapping) and error.get("type") == EXHAUSTION_ERROR_TYPE
+    ):
+        raise _fail("invalid_loop_progress", f"{prefix}.failed exhaustion requires the terminal exhaustion error")
+
+
+def _validate_terminal(
+    prefix: str, f: dict[str, Any], max_iterations: Optional[int], loop_row: Any
+) -> None:
+    completed, evaluated, result = f["completed"], f["evaluated"], f["result"]
+    if evaluated is None or not completed or completed != list(range(evaluated + 1)):
+        raise _fail("invalid_loop_progress", f"{prefix}.terminal progress requires completed evaluated history")
+    if result is None or (result is True and f["exhausted"]):
+        raise _fail("invalid_loop_progress", f"{prefix}.condition result conflicts with evaluation state")
+    if result is True:
+        return
+    if max_iterations is not None and evaluated != max_iterations - 1:
+        raise _fail("invalid_loop_progress", f"{prefix}.terminal progress requires completed evaluated history")
+    _check_exhaustion_row(prefix, f, loop_row)
+
+
+def validate_repeat_until_progress(
+    name: str, entry: Any, *, max_iterations: Optional[int], loop_row: Any
+) -> tuple[int, ...]:
+    """Validate one `repeat_until` entry (four admitted forms); return admitted iterations."""
+    f = _repeat_until_fields(name, entry)
+    prefix = f"repeat_until.{name}"
+    if f["current"] is not None:
+        _validate_active(prefix, f, max_iterations)
+        return tuple(f["completed"] + [f["current"]])
+    _validate_terminal(prefix, f, max_iterations, loop_row)
+    return tuple(f["completed"])
+
+
+def _loop_max_iterations(projection: "WorkflowStateProjection", frame_key: str) -> Optional[int]:
+    for node_id, loop in projection.repeat_until_nodes.items():
+        if loop.frame_key == frame_key:
+            entry = projection.entries_by_node_id.get(node_id)
+            return entry.step_definition.max_iterations if entry is not None else None
+    return None
+
+
+def _admitted_iterations(
+    projection: "WorkflowStateProjection", state: Mapping[str, Any]
+) -> dict[str, tuple[int, ...]]:
+    """Validate all loop bookkeeping; map loop frame key -> admitted iteration indices."""
+    admitted: dict[str, tuple[int, ...]] = {}
+    for name, entry in _mapping_section(state, "for_each").items():
+        admitted[str(name)] = validate_for_each_progress(str(name), entry)
+    steps = state.get("steps")
+    steps = steps if isinstance(steps, Mapping) else {}
+    for name, entry in _mapping_section(state, "repeat_until").items():
+        admitted[str(name)] = validate_repeat_until_progress(
+            str(name),
+            entry,
+            max_iterations=_loop_max_iterations(projection, str(name)),
+            loop_row=steps.get(name),
+        )
+    return admitted
+
+
+def _root_slots(projection: "WorkflowStateProjection") -> list[ResumeSlot]:
+    return [
+        ResumeSlot(entry.node_id, entry.step_id, entry.presentation_key, entry.region)
+        for entry in projection.entries_by_node_id.values()
+        if entry.compatibility_index is not None or entry.finalization_index is not None
+    ]
+
+
+def _loop_slots(
+    projection: "WorkflowStateProjection", admitted: Mapping[str, tuple[int, ...]]
+) -> list[ResumeSlot]:
+    slots: list[ResumeSlot] = []
+    for loops in (projection.for_each_nodes, projection.repeat_until_nodes):
+        for loop_node_id, loop in loops.items():
+            entry = projection.entries_by_node_id.get(loop_node_id)
+            region = entry.region if entry is not None else WorkflowRegion.BODY
+            for index in admitted.get(loop.frame_key, ()):
+                for nested_node_id in loop.nested_presentation_keys:
+                    slots.append(
+                        ResumeSlot(
+                            nested_node_id,
+                            loop.runtime_step_id(index, nested_node_id),
+                            loop.step_key(index, nested_node_id),
+                            region,
+                            iteration_index=index,
+                            loop_node_id=loop_node_id,
+                        )
+                    )
+    return slots
+
+
+def _boundary_table(
+    projection: "WorkflowStateProjection", admitted: Mapping[str, tuple[int, ...]]
+) -> dict[str, list["CallBoundaryProjection"]]:
+    loop_keys = {
+        node_id: loop.frame_key
+        for loops in (projection.for_each_nodes, projection.repeat_until_nodes)
+        for node_id, loop in loops.items()
+    }
+    table: dict[str, list["CallBoundaryProjection"]] = {}
+    for boundary in projection.call_boundaries.values():
+        owner = boundary.iteration_owner_node_id
+        if owner is None:
+            table.setdefault(boundary.runtime_step_id(), []).append(boundary)
+            continue
+        for index in admitted.get(loop_keys.get(owner, ""), ()):
+            table.setdefault(boundary.runtime_step_id(index), []).append(boundary)
+    return table
+
+
+def _unclaimed_rows(
+    state: Mapping[str, Any], claimed: Mapping[str, Any]
+) -> tuple[tuple[str, Any], ...]:
+    steps = state.get("steps")
+    if not isinstance(steps, Mapping):
+        return ()
+    return tuple(
+        (str(name), deepcopy(row["step_id"]))
+        for name, row in steps.items()
+        if isinstance(row, Mapping) and "step_id" in row and name not in claimed
+    )
+
+
+def enumerate_resume_slots(
+    projection: "WorkflowStateProjection", state: Mapping[str, Any]
+) -> ResumeProjectionSlotIndex:
+    """Build candidate tables for one raw state; never mutates or backfills `state`."""
+    admitted = _admitted_iterations(projection, state)
+    slots = _root_slots(projection) + _loop_slots(projection, admitted)
+    by_id: dict[str, list[ResumeSlot]] = {}
+    by_row: dict[str, list[ResumeSlot]] = {}
+    for slot in slots:
+        by_id.setdefault(slot.step_id, []).append(slot)
+        by_row.setdefault(slot.presentation_key, []).append(slot)
+    boundaries = _boundary_table(projection, admitted)
+    return ResumeProjectionSlotIndex(
+        candidates_by_step_id=MappingProxyType({k: tuple(v) for k, v in by_id.items()}),
+        call_boundaries_by_step_id=MappingProxyType({k: tuple(v) for k, v in boundaries.items()}),
+        slots_by_row_name=MappingProxyType({k: tuple(v) for k, v in by_row.items()}),
+        unclaimed_explicit_rows=_unclaimed_rows(state, by_row),
+    )
+
+
+def resolve_resume_step_id(
+    slot_index: ResumeProjectionSlotIndex, step_id: Any, presentation_key: Optional[str] = None
+) -> ResumeIdentityResolution:
+    candidates = slot_index.candidates_by_step_id.get(step_id, ()) if isinstance(step_id, str) else ()
+    exact = (
+        candidates
+        if presentation_key is None
+        else tuple(c for c in candidates if c.presentation_key == presentation_key)
+    )
+    return ResumeIdentityResolution(
+        slot=exact[0] if len(exact) == 1 else None,
+        candidate_count=len(candidates),
+        exact_identity_candidate_count=len(exact),
+    )
+
+
+def resolve_call_boundary(
+    slot_index: ResumeProjectionSlotIndex, call_step_id: Any
+) -> ResumeCallBoundaryResolution:
+    candidates = (
+        slot_index.call_boundaries_by_step_id.get(call_step_id, ()) if isinstance(call_step_id, str) else ()
+    )
+    return ResumeCallBoundaryResolution(
+        boundary=candidates[0] if len(candidates) == 1 else None,
+        candidate_count=len(candidates),
+    )

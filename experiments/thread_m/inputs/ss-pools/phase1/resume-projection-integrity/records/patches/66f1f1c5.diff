+            "RouteReady": {"status": "skipped"},
+            "ReviewLoop": {"status": "running"},
+            "ReviewLoop[0].WriteDecision": {"status": "completed",
+                                            "step_id": "root.review_loop#0.iteration_body.write_decision"},
+            "finally.WriteCleanupMarker": {"status": "failed",
+                                           "step_id": "root.finally.cleanup.write_cleanup_marker"},
+        },
+        "current_step": {"name": "SetReady", "step_id": "root.set_ready", "status": "running"},
+        "repeat_until": {"ReviewLoop": {"current_iteration": 0, "completed_iterations": [],
+                                        "condition_evaluated_for_iteration": None,
+                                        "last_condition_result": None}},
+    }
+    before = copy.deepcopy(state)
+    audit_scope(pbundle, state, ROOT_PATH)
+    assert state == before
+
+
+def test_absent_step_id_is_compatible_for_every_status(pbundle):

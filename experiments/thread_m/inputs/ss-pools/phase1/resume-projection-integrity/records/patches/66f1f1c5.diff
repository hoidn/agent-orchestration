@@ -0,0 +1,177 @@
+"""Structural-root executor guard: checksum recheck, root audit, failure-safe session close."""
+
+from __future__ import annotations
+
+import json
+import stat
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+import orchestrator.workflow.executor as executor_module
+from orchestrator.cli.commands.resume import resume_workflow
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+ENVELOPE_KEYS = {"status", "error", "updated_at"}
+
+
+def _seed(tmp_path: Path, run_id="guard-run", **state_edits):
+    workflow = {
+        "version": "2.0",
+        "name": "guard",
+        "steps": [{"name": "Effect", "id": "effect", "command": ["bash", "-lc", "touch effect.txt"]}],
+    }
+    path = tmp_path / "guard.yaml"
+    path.write_text(yaml.safe_dump(workflow, sort_keys=False))
+    bundle = WorkflowLoader(tmp_path).load_bundle(path)
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("guard.yaml", context=bundle_context_dict(bundle))
+    raw = json.loads(manager.state_file.read_text())
+    raw["status"] = "failed"
+    raw["unknown_root_field"] = {"keep": True}
+    raw.update(state_edits)
+    manager.state_file.write_text(json.dumps(raw, indent=2))
+    return path, bundle, StateManager(tmp_path, run_id=run_id)
+
+
+def _delta(before, after):
+    assert [k for k in after if k in before] == list(before)
+    return {k for k in after if before.get(k, object()) != after[k]}
+
+
+def _run(bundle, tmp_path, manager, recorder=None):
+    events = []
+    original = executor_module.audit_scope
+
+    def record(*args):
+        events.append("audit")
+        return original(*args)
+
+    with patch.object(executor_module, "audit_scope", record), patch.object(
+        WorkflowExecutor, "_execute_prologue", side_effect=lambda *a, **k: events.append("prologue")
+    ):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+    return result, events
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason"),
+    [
+        ("modify", "workflow_modified"),
+        ("delete", "workflow_unavailable"),
+        ("unreadable", "workflow_unavailable"),
+        ("no_checksum", "missing_recorded_checksum"),
+        ("no_file", "missing_workflow_path"),
+    ],
+)
+def test_checksum_failures_persist_envelope_and_stop_before_audit_and_prologue(tmp_path, mutate, reason):
+    path, bundle, manager = _seed(tmp_path)
+    raw = json.loads(manager.state_file.read_text())
+    if mutate == "modify":
+        path.write_text(path.read_text() + "# changed\n")
+    elif mutate == "delete":
+        path.unlink()
+    elif mutate == "unreadable":
+        path.chmod(0)
+    elif mutate == "no_checksum":
+        raw.pop("workflow_checksum")
+        manager.state_file.write_text(json.dumps(raw))
+    else:
+        raw.pop("workflow_file")
+        manager.state_file.write_text(json.dumps(raw))
+    before = json.loads(manager.state_file.read_text())
+    try:
+        result, events = _run(bundle, tmp_path, manager)
+    finally:
+        path.exists() and path.chmod(stat.S_IRUSR | stat.S_IWUSR)
+    after = json.loads(manager.state_file.read_text())
+    if mutate == "unreadable" and path.exists() and path.read_bytes() and result["status"] != "failed":
+        pytest.skip("running as a user that ignores file modes")
+    assert events == []

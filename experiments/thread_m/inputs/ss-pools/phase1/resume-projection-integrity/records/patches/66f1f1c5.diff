@@ -0,0 +1,108 @@
+"""Call-frame retry lineage and frame-family indexing."""
+
+from __future__ import annotations
+
+import itertools
+
+import pytest
+
+from orchestrator.workflow.resume_retry_lineage import (
+    CallFrameRetryLineageError,
+    group_frame_families,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+
+B = "S::visit::1"
+STEP = "root.call"
+
+
+def _f(status="failed", step=STEP, alias="lib"):
+    return {"status": status, "call_step_id": step, "import_alias": alias}
+
+
+def _lisp(items):
+    return index_retry_lineage(STEP, items, frontend_kind="workflow_lisp")
+
+
+def test_lineage_orders_failed_predecessors_and_finds_running_member():
+    items = [(f"{B}::retry::2", _f("running")), (B, _f()), (f"{B}::retry::1", _f())]
+    lineage = _lisp(items)
+    assert [m.frame_id for m in lineage.failed_predecessors] == [B, f"{B}::retry::1"]
+    assert [m.ordinal for m in lineage.failed_predecessors] == [0, 1]
+    assert lineage.running_member.frame_id == f"{B}::retry::2"
+    assert lineage.base_frame_id == B
+
+
+def test_mapping_order_never_changes_result():
+    items = [(B, _f()), (f"{B}::retry::1", _f()), (f"{B}::retry::2", _f("running"))]
+    results = {repr(_lisp(list(p))) for p in itertools.permutations(items)}
+    assert len(results) == 1
+
+
+def test_completed_members_unlimited_and_count_toward_next_ordinal():
+    items = [(B, _f()), (f"{B}::retry::1", _f("completed")), ("S::visit::2", _f("completed"))]
+    lineage = _lisp(items)
+    assert len(lineage.completed_members) == 2 and lineage.running_member is None
+    assert next_unused_retry_frame_id(lineage) == f"{B}::retry::2"
+    assert next_unused_retry_frame_id(lineage) == next_unused_retry_frame_id(lineage)
+
+
+def test_child_under_retried_parent_keeps_inherited_marker():
+    base = "P::visit::1::retry::1.C::visit::1"
+    lineage = _lisp([(base, _f()), (f"{base}::retry::1", _f("running"))])
+    assert lineage.base_frame_id == base
+    assert next_unused_retry_frame_id(_lisp([(base, _f())])) == f"{base}::retry::1"
+
+
+@pytest.mark.parametrize(
+    ("items", "reason"),
+    [
+        ([(B, _f("running")), (f"{B}::retry::1", _f("running"))], "ambiguous_resumable_call_frame"),
+        ([(B, _f()), ("S::visit::2", _f())], "ambiguous_resumable_call_frame"),
+        ([(B, _f()), (f"{B}::retry::2", _f())], "unsupported_shape"),
+        ([(f"{B}::retry::0", _f())], "unsupported_shape"),
+        ([(f"{B}::retry::x", _f())], "unsupported_shape"),
+        ([(f"{B}::retry::1::retry::2", _f())], "unsupported_shape"),
+        ([("no-visit-marker", _f())], "unsupported_shape"),
+        ([(B, _f("weird"))], "unsupported_shape"),
+        ([(B, _f(step="other"))], "missing_call_boundary"),
+        ([(B, _f()), (f"{B}::retry::1", _f(alias="other"))], "persisted_import_alias_mismatch"),
+    ],
+)
+def test_lisp_lineage_errors(items, reason):
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        _lisp(items)
+    assert excinfo.value.reason == reason
+
+
+def test_duplicate_ordinal_is_ambiguous():
+    items = [(B, _f()), (f"{B}::retry::1", _f()), (f"{B}::retry::1", _f("running"))]
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        _lisp(items)
+    assert excinfo.value.reason == "ambiguous_resumable_call_frame"
+
+
+def test_non_lisp_boundary_has_single_resumable_member():
+    one = index_retry_lineage(STEP, [("a", _f("completed")), ("b", _f("failed"))], frontend_kind=None)
+    assert one.running_member.frame_id == "b" and len(one.completed_members) == 1
+    none = index_retry_lineage(STEP, [("a", _f("completed"))], frontend_kind=None)
+    assert none.running_member is None
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage(STEP, [("a", _f("failed")), ("b", _f("running"))], frontend_kind=None)
+    assert excinfo.value.reason == "ambiguous_resumable_call_frame"
+
+
+def test_group_frame_families_separates_visits():
+    items = [("S::visit::1", _f()), ("S::visit::2", _f("running")), ("S::visit::1::retry::1", _f())]
+    families = group_frame_families(items)
+    assert set(families) == {"S::visit::1", "S::visit::2"}
+    assert [fid for fid, _ in families["S::visit::1"]] == ["S::visit::1", "S::visit::1::retry::1"]
+
+
+def test_unparseable_frame_ids_share_one_family_so_ambiguity_stays_visible():
+    families = group_frame_families([("frame-a", _f("running")), ("frame-b", _f("failed"))])
+    assert list(families) == [""] and len(families[""]) == 2
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage(STEP, families[""], frontend_kind=None)
+    assert excinfo.value.reason == "ambiguous_resumable_call_frame"

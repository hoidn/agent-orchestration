index 0000000..c0fad13
--- /dev/null
+++ b/orchestrator/workflow/call_resume_validation.py
@@ -0,0 +1,194 @@
+"""Reached-call resume validation: boundary ownership, frame families and retry lineage.
+
+Used by `CallExecutor.execute_call` when a call step executes during resume. Pure planning:
+nothing here creates or changes a callee frame or state. Failures are returned as ordinary
+failed call-step results whose `error` is the stable projection diagnostic (never wrapped).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping, Optional
+
+from .resume_projection_integrity import (
+    ResumeScopePath,
+    build_diagnostic,
+)
+from .resume_retry_lineage import (
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    group_frame_families,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .resume_slots import ResumeProjectionValidationError
+
+
+@dataclass(frozen=True)
+class ResumedFramePlan:
+    """Which frame a reached call occupies and which prior frames must be validated first."""
+
+    frame_id: str
+    running: Optional[tuple[str, Mapping[str, Any]]] = None
+    failed_predecessors: tuple[tuple[str, Mapping[str, Any]], ...] = ()
+
+
+def failed_result(error: dict[str, Any]) -> dict[str, Any]:
+    """Wrap a diagnostic as a failed call-step result (the error stays unwrapped)."""
+    return {"status": "failed", "exit_code": 2, "duration_ms": 0, "error": error}
+
+
+def scope_path_for(executor: Any, state: Mapping[str, Any]) -> ResumeScopePath:
+    """Return the audited scope path of the executor owning the reached call."""
+    path = getattr(executor, "resume_scope_path", None)
+    if isinstance(path, ResumeScopePath):
+        return path
+    workflow_file = state.get("workflow_file")
+    return ResumeScopePath.root(workflow_file if isinstance(workflow_file, str) else "")
+
+
+def diagnostic_result(
+    executor: Any, state: Mapping[str, Any], reason: str, **fields: Any
+) -> dict[str, Any]:
+    """Build the failed result for a diagnostic raised in the caller's own scope."""
+    bundle = executor.loaded_bundle
+    return failed_result(build_diagnostic(bundle, state, scope_path_for(executor, state), reason, **fields))
+
+
+def resolve_reached_boundary(
+    executor: Any, state: Mapping[str, Any], step_id: str
+) -> tuple[Any, Optional[dict[str, Any]]]:
+    """Resolve the reached call identity to exactly one current boundary (one call, positional)."""
+    projection = executor.loaded_bundle.projection
+    try:
+        slot_index = projection.enumerate_resume_slots(state)
+    except ResumeProjectionValidationError as exc:
+        return None, diagnostic_result(executor, state, exc.reason, field=exc.field)
+    resolution = projection.resolve_call_boundary(slot_index, step_id)
+    if resolution.boundary is not None:
+        return resolution.boundary, None
+    field = "call_step_id"
+    if resolution.candidate_count > 1:
+        return None, diagnostic_result(
+            executor, state, "ambiguous_call_boundary", field=field, offending=step_id,
+            candidate_count=resolution.candidate_count, call_boundary_step_id=step_id,
+        )
+    local = projection.resolve_resume_step_id(slot_index, step_id)
+    reason = "missing_call_boundary" if local.candidate_count else "out_of_scope_step_id"
+    return None, diagnostic_result(
+        executor, state, reason, field=field, offending=step_id, candidate_count=0,
+        call_boundary_step_id=step_id if reason == "missing_call_boundary" else None,
+    )
+
+
+def _lineage_failure(
+    executor: Any, state: Mapping[str, Any], exc: CallFrameRetryLineageError, step_id: str, open_count: int
+) -> dict[str, Any]:
+    if exc.reason == "ambiguous_resumable_call_frame":
+        return diagnostic_result(
+            executor, state, exc.reason, field="call_frames", offending=open_count,
+            candidate_count=open_count, call_boundary_step_id=step_id,
+        )
+    return diagnostic_result(executor, state, exc.reason, field="call_frames", call_boundary_step_id=step_id)
+
+
+def _index_families(
+    executor: Any, state: Mapping[str, Any], step_id: str, items: list[tuple[str, Any]], kind: Any
+) -> tuple[dict[str, CallFrameRetryLineage], Optional[dict[str, Any]]]:
+    lineages: dict[str, CallFrameRetryLineage] = {}
+    running = 0
+    for key, family in group_frame_families(items).items():
+        try:
+            lineages[key] = index_retry_lineage(step_id, family, frontend_kind=kind)
+        except CallFrameRetryLineageError as exc:
+            open_count = sum(1 for _, f in family if f.get("status") != "completed")
+            return lineages, _lineage_failure(executor, state, exc, step_id, open_count)
+        running += sum(1 for _, f in family if f.get("status") == "running")
+    if running > 1:
+        error = CallFrameRetryLineageError("ambiguous_resumable_call_frame", "several running frames")
+        return lineages, _lineage_failure(executor, state, error, step_id, running)
+    return lineages, None
+
+
+def _alias_failure(
+    executor: Any, state: Mapping[str, Any], boundary: Any, step_id: str, items: list[tuple[str, Any]]
+) -> Optional[dict[str, Any]]:
+    for frame_id, frame in items:
+        if frame.get("import_alias") != boundary.import_alias:
+            return diagnostic_result(
+                executor, state, "persisted_import_alias_mismatch",
+                field=f"call_frames.{frame_id}.import_alias", offending=frame.get("import_alias"),
+                candidate_count=1, call_boundary_step_id=step_id,
+            )
+    return None
+
+
+def _target_frame_problem(call_frames: Mapping[str, Any], target_frame_id: str) -> Optional[str]:
+    """Detail code when the frame id this call would occupy is already held unusably."""
+    if target_frame_id not in call_frames:
+        return None
+    existing = call_frames[target_frame_id]
+    if not isinstance(existing, Mapping):
+        return "call_frame_not_mapping"
+    return "completed_call_frame_id_collision" if existing.get("status") == "completed" else None
+
+
+def _is_open(lineage: CallFrameRetryLineage) -> bool:
+    """A family is open while no member completed and a running or failed member remains."""
+    return not lineage.completed_members and bool(lineage.running_member or lineage.failed_predecessors)
+
+
+def _select_open_lineage(
+    executor: Any, state: Mapping[str, Any], step_id: str, lineages: dict[str, CallFrameRetryLineage]
+) -> tuple[Optional[CallFrameRetryLineage], Optional[dict[str, Any]]]:
+    """Pick the one open family a resumed call continues; several open families fail closed.
+
+    Re-entering a call step on resume bumps its visit counter, so the interrupted frame is
+    found by its lineage, never by recomputing its id. Older settled families are history.
+    """
+    open_keys = [key for key, lineage in lineages.items() if _is_open(lineage)]
+    if len(open_keys) > 1:
+        running = [k for k in open_keys if getattr(lineages[k].running_member, "status", None) == "running"]
+        if len(running) != 1:
+            error = CallFrameRetryLineageError("ambiguous_resumable_call_frame", "several open families")
+            return None, _lineage_failure(executor, state, error, step_id, len(open_keys))
+        open_keys = running
+    return (lineages[open_keys[0]] if open_keys else None), None
+
+
+def plan_resumed_frame(
+    executor: Any,
+    state: Mapping[str, Any],
+    *,
+    boundary: Any,
+    frontend_kind: Optional[str],
+    step_id: str,
+    target_frame_id: str,
+    invalid_state: Callable[[str], dict[str, Any]],
+) -> tuple[Optional[ResumedFramePlan], Optional[dict[str, Any]]]:
+    """Choose the frame a resumed call occupies; fail closed on any inconsistent frame set."""
+    call_frames = state["call_frames"]
+    invalid = _target_frame_problem(call_frames, target_frame_id)
+    if invalid is not None:
+        return None, invalid_state(invalid)
+    items = [
+        (fid, frame)
+        for fid, frame in call_frames.items()
+        if isinstance(frame, Mapping) and frame.get("call_step_id") == step_id
+    ]
+    lineages, failure = _index_families(executor, state, step_id, items, frontend_kind)
+    failure = failure or _alias_failure(executor, state, boundary, step_id, items)
+    if failure is not None:
+        return None, failure
+    lineage, failure = _select_open_lineage(executor, state, step_id, lineages)
+    if failure is not None:
+        return None, failure
+    if lineage is None:
+        return ResumedFramePlan(target_frame_id), None
+    running = lineage.running_member
+    failed = tuple((m.frame_id, call_frames[m.frame_id]) for m in lineage.failed_predecessors)
+    if running is not None:
+        return ResumedFramePlan(running.frame_id, (running.frame_id, call_frames[running.frame_id]), failed), None
+    frame_id = next_unused_retry_frame_id(lineage) if failed else target_frame_id
+    return ResumedFramePlan(frame_id, None, failed), None
+

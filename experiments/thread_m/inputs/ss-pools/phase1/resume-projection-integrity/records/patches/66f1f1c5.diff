+def test_child_call_frame_executor_never_runs_the_root_guard(tmp_path):
+    from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id="child-guard")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    with patch.object(executor_module, "run_root_resume_guard", wraps=executor_module.run_root_resume_guard) as guard:
+        WorkflowExecutor(bundle, tmp_path, manager).execute(resume=False)
+        assert guard.call_count == 0

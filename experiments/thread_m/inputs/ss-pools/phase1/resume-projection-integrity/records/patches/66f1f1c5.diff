+def test_resolve_resume_step_id_outcomes(tmp_path: Path) -> None:
+    projection = _projection_bundle(tmp_path).projection
+    index = projection.enumerate_resume_slots({})
+    ok = projection.resolve_resume_step_id(index, "root.set_ready", "SetReady")
+    assert (ok.slot.node_id, ok.candidate_count, ok.exact_identity_candidate_count) == ("root.set_ready", 1, 1)
+    mismatch = projection.resolve_resume_step_id(index, "root.set_ready", "RouteReady")
+    assert (mismatch.slot, mismatch.candidate_count, mismatch.exact_identity_candidate_count) == (None, 1, 0)
+    for bad in ("nope", ["x"], None, 7, {"a": 1}):
+        r = projection.resolve_resume_step_id(index, bad)
+        assert (r.slot, r.candidate_count) == (None, 0)

+def _completed_graph_run(tmp_path: Path, run_id: str):
+    root_bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(root_bundle))
+    assert WorkflowExecutor(root_bundle, tmp_path, manager).execute()["status"] == "completed"
+    return root_bundle, manager
+
+
+def _interrupt_call(manager: StateManager, *, frame_status: str = "running") -> str:
+    """Rewind the completed run so resume re-enters the root call and its frame."""
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    frame["status"] = frame_status
+    frame["state"]["status"] = frame_status
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    return frame_id
+
+
+def test_reached_call_validates_in_required_order_and_resolves_boundary_once(tmp_path: Path):
+    from orchestrator.workflow.state_projection import WorkflowStateProjection
+
+    root_bundle, manager = _completed_graph_run(tmp_path, "reached-order")
+    frame_id = _interrupt_call(manager)
+    events: list = []
+    original_resolve = WorkflowStateProjection.resolve_call_boundary
+    original_manager = __import__("orchestrator.workflow.call_frame_state", fromlist=["x"])._CallFrameStateManager
+
+    def spy_resolve(projection, slot_index, call_step_id):
+        events.append(("resolve", call_step_id))
+        return original_resolve(projection, slot_index, call_step_id)
+
+    def spy_audit(bundle, state, path):
+        events.append(("audit", tuple(path.call_frame_ids)))
+        return audit_scope_original(bundle, state, path)
+
+    def spy_manager(*args, **kwargs):
+        events.append(("child_manager", kwargs["frame_id"]))
+        return original_manager(*args, **kwargs)
+
+    from orchestrator.workflow import calls as calls_module
+
+    audit_scope_original = calls_module.audit_scope
+    executor = WorkflowExecutor(root_bundle, tmp_path, manager)
+    executor.resume_mode = True
+    state = manager.load().to_dict()
+    with patch.object(WorkflowStateProjection, "resolve_call_boundary", spy_resolve), patch.object(
+        calls_module, "audit_scope", spy_audit
+    ), patch("orchestrator.workflow.call_frame_state._CallFrameStateManager", spy_manager), patch(
+        "orchestrator.workflow.executor.WorkflowExecutor.execute", return_value={"status": "completed"}
+    ):
+        executor.call_executor.execute_call(materialize_projection_body_steps(root_bundle)[0], state)
+
+    assert events == [
+        ("resolve", "root.invoke_middle"),  # exactly one boundary resolution for the reached identity
+        ("audit", (frame_id,)),
+        ("resolve", "root.invoke_leaf"),  # the callee audit resolves the callee's own frames
+        ("child_manager", frame_id),
+    ]
+
+

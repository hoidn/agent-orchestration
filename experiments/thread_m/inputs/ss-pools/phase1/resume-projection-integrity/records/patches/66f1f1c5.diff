@@ -0,0 +1,201 @@
+"""Call-frame retry lineage and frame-family indexing for resume.
+
+Frame ids are `<call step id>::visit::<n>` optionally followed by `::retry::<k>`, and
+nested frames prefix the parent frame id (`<parent>.<local>`). Only the frame's own
+trailing suffix (the text after the last `::visit::`) is parsed; text before it, which
+may hold an inherited parent retry marker, is never inspected. Parsing applies to frame
+ids only, never to step identities.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+_VISIT = "::visit::"
+_OWN_TAIL = re.compile(r"(?P<visit>[1-9][0-9]*)(?:::retry::(?P<retry>[1-9][0-9]*))?")
+_KNOWN_STATUSES = frozenset({"completed", "failed", "running"})
+
+AMBIGUOUS = "ambiguous_resumable_call_frame"
+UNSUPPORTED = "unsupported_shape"
+MISSING_BOUNDARY = "missing_call_boundary"
+ALIAS_MISMATCH = "persisted_import_alias_mismatch"
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Invalid frame set for one call boundary; `.reason` is a diagnostic reason."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    boundary_step_id: str
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[CallFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+
+
+def parse_own_frame_suffix(frame_id: Any) -> Optional[tuple[str, int]]:
+    """Return (family key, ordinal) for a frame id, or None when its own tail is malformed."""
+    if not isinstance(frame_id, str) or _VISIT not in frame_id:
+        return None
+    head, _, tail = frame_id.rpartition(_VISIT)
+    match = _OWN_TAIL.fullmatch(tail)
+    if match is None:
+        return None
+    retry = match.group("retry")
+    family = f"{head}{_VISIT}{match.group('visit')}"
+    return family, int(retry) if retry else 0
+
+
+def group_frame_families(
+    frame_items: Iterable[tuple[str, Any]],
+) -> dict[str, list[tuple[str, Any]]]:
+    """Group frames by family key (frame id without its own retry suffix); order-stable.
+
+    Frames whose id has no valid own suffix share the family key `""`, so several unparseable
+    frames of one boundary stay visible to the ambiguity checks instead of hiding in singletons.
+    """
+    families: dict[str, list[tuple[str, Any]]] = {}
+    for frame_id, frame in frame_items:
+        parsed = parse_own_frame_suffix(frame_id)
+        families.setdefault(parsed[0] if parsed else "", []).append((frame_id, frame))
+    return families
+
+
+def _fail(reason: str, message: str) -> CallFrameRetryLineageError:
+    return CallFrameRetryLineageError(reason, message)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[str, Any]]
+) -> list[tuple[str, str, Mapping[str, Any]]]:
+    frames: list[tuple[str, str, Mapping[str, Any]]] = []
+    for frame_id, frame in frame_items:
+        if not isinstance(frame, Mapping):
+            raise _fail(UNSUPPORTED, f"call frame {frame_id!r} must be a mapping")
+        status = frame.get("status")
+        if status not in _KNOWN_STATUSES:
+            raise _fail(UNSUPPORTED, f"call frame {frame_id!r} has an unknown status")
+        if frame.get("call_step_id") != boundary_step_id:
+            raise _fail(MISSING_BOUNDARY, f"call frame {frame_id!r} does not belong to the boundary")
+        frames.append((frame_id, status, frame))
+    aliases = {frame.get("import_alias") for _, _, frame in frames}
+    if len(aliases) > 1:
+        raise _fail(ALIAS_MISMATCH, "call frames of one boundary persist different import aliases")
+    return frames
+
+
+def _member(frame_id: str, status: str) -> CallFrameMember:
+    parsed = parse_own_frame_suffix(frame_id)
+    if parsed is None:
+        return CallFrameMember(frame_id, status)
+    return RetryFrameMember(frame_id, status, ordinal=parsed[1])
+
+
+def _single_resumable(
+    completed: list[CallFrameMember], open_frames: list[tuple[str, str]]
+) -> CallFrameRetryLineage:
+    if len(open_frames) > 1:
+        raise _fail(AMBIGUOUS, "a non-Workflow-Lisp boundary has more than one resumable frame")
+    running = _member(*open_frames[0]) if open_frames else None
+    return CallFrameRetryLineage("", None, tuple(completed), (), running)
+
+
+def _parsed_open_members(open_frames: list[tuple[str, str]]) -> list[RetryFrameMember]:
+    parsed: list[RetryFrameMember] = []
+    for frame_id, status in open_frames:
+        if parse_own_frame_suffix(frame_id) is None:
+            raise _fail(UNSUPPORTED, f"call frame {frame_id!r} has a malformed or nested retry marker")
+        parsed.append(_member(frame_id, status))  # type: ignore[arg-type]
+    return parsed
+
+
+def _check_ordinals(members: list[RetryFrameMember]) -> None:
+    ordinals = [m.ordinal for m in members]
+    if len(set(ordinals)) != len(ordinals):
+        raise _fail(AMBIGUOUS, "call frame retry lineage repeats an ordinal")
+    if ordinals and ordinals != list(range(len(ordinals))):
+        raise _fail(UNSUPPORTED, "call frame retry lineage is missing an ordinal")
+
+
+def _lisp_lineage(
+    completed: list[CallFrameMember], open_frames: list[tuple[str, str]]
+) -> CallFrameRetryLineage:
+    parsed = _parsed_open_members(open_frames)
+    bases = {parse_own_frame_suffix(m.frame_id)[0] for m in parsed}  # type: ignore[index]
+    if len(bases) > 1:
+        raise _fail(AMBIGUOUS, "non-completed call frames span mixed bases")
+    base = next(iter(bases)) if bases else _completed_base(completed)
+    family_completed = [m for m in completed if _family_of(m) == base and isinstance(m, RetryFrameMember)]
+    _check_ordinals(sorted(parsed + family_completed, key=lambda m: m.ordinal))
+    running = [m for m in parsed if m.status == "running"]
+    if len(running) > 1:
+        raise _fail(AMBIGUOUS, "call frame retry lineage has more than one running member")
+    failed = sorted((m for m in parsed if m.status == "failed"), key=lambda m: m.ordinal)
+    return CallFrameRetryLineage("", base, tuple(completed), tuple(failed), running[0] if running else None)
+
+
+def _family_of(member: CallFrameMember) -> Optional[str]:
+    parsed = parse_own_frame_suffix(member.frame_id)
+    return parsed[0] if parsed else None
+
+
+def _completed_base(completed: list[CallFrameMember]) -> Optional[str]:
+    families = {_family_of(m) for m in completed}
+    return next(iter(families)) if len(families) == 1 else None
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Index the frames of one call boundary into completed / failed / running members."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    completed = [_member(fid, status) for fid, status, _ in frames if status == "completed"]
+    open_frames = [(fid, status) for fid, status, _ in frames if status != "completed"]
+    build = _lisp_lineage if frontend_kind == "workflow_lisp" else _single_resumable
+    lineage = build(completed, open_frames)
+    return CallFrameRetryLineage(
+        boundary_step_id,
+        lineage.base_frame_id,
+        lineage.completed_members,
+        lineage.failed_predecessors,
+        lineage.running_member,
+    )
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return `<base>::retry::<lowest unused positive ordinal>` over all members."""
+    if lineage.base_frame_id is None:
+        raise ValueError("retry lineage has no base frame id")
+    members = list(lineage.completed_members) + list(lineage.failed_predecessors)
+    if lineage.running_member is not None:
+        members.append(lineage.running_member)
+    used = {
+        parsed[1]
+        for m in members
+        if (parsed := parse_own_frame_suffix(m.frame_id)) and parsed[0] == lineage.base_frame_id
+    }
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}::retry::{ordinal}"

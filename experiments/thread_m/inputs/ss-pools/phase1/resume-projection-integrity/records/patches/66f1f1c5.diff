+# --- resume-slot enumeration (checksum-compatible resume projection integrity) ---
+
+import copy  # noqa: E402
+
+from orchestrator.workflow.state_projection import ResumeProjectionValidationError  # noqa: E402
+
+
+def _projection_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_workflow(tmp_path))
+
+
+def _fe(**overrides):
+    base = {"items": ["a", "b"], "completed_indices": [], "current_index": 0}
+    base.update(overrides)
+    return {"for_each": {"ProcessItems": base}}
+
+
+def _ru(loop_row=None, **overrides):
+    base = {
+        "current_iteration": 1,
+        "completed_iterations": [0],
+        "condition_evaluated_for_iteration": None,
+        "last_condition_result": None,
+    }
+    base.update(overrides)
+    state = {"repeat_until": {"ReviewLoop": base}}
+    if loop_row is not None:
+        state["steps"] = {"ReviewLoop": loop_row}
+    return state
+
+
+EXHAUSTED_FULL = {
+    "current_iteration": None,
+    "completed_iterations": [0, 1, 2, 3],
+    "condition_evaluated_for_iteration": 3,
+    "last_condition_result": False,
+}
+
+
+def test_call_boundary_projection_carries_current_import_alias(tmp_path: Path) -> None:
+    projection = WorkflowLoader(tmp_path).load_bundle(_write_projection_call_workflow(tmp_path)).projection
+    aliases = {b.import_alias for b in projection.call_boundaries.values()}
+    assert aliases == {"review_loop"}
+
+
+def test_resume_projection_validation_error_str_is_message() -> None:
+    exc = ResumeProjectionValidationError("unsupported_shape", "for_each must be a mapping")
+    assert (exc.reason, exc.message, str(exc)) == ("unsupported_shape", "for_each must be a mapping", "for_each must be a mapping")
+
+
+def test_enumerate_resume_slots_candidates_and_no_mutation(tmp_path: Path) -> None:
+    projection = _projection_bundle(tmp_path).projection
+    state = {
+        **_fe(completed_indices=[0], current_index=1),
+        "steps": {"Orphan": {"status": "completed", "step_id": ["not", "hashable"]}},
+    }
+    before = copy.deepcopy(state)
+    index = projection.enumerate_resume_slots(state)
+    assert state == before
+    root = index.candidates_by_step_id["root.set_ready"]
+    assert [(s.region.value, s.iteration_index) for s in root] == [("body", None)]
+    assert index.candidates_by_step_id["root.finally.cleanup.write_cleanup_marker"][0].region.value == "finalization"
+    local = index.candidates_by_step_id["root.process_items#1.increment_count"]
+    assert local[0].iteration_index == 1
+    assert "root.process_items#2.increment_count" not in index.candidates_by_step_id
+    assert index.unclaimed_explicit_rows == (("Orphan", ["not", "hashable"]),)
+    assert index.unclaimed_explicit_rows[0][1] is not state["steps"]["Orphan"]["step_id"]
+
+
+def test_enumerate_resume_slots_loop_contained_call_boundaries(tmp_path: Path) -> None:
+    projection = WorkflowLoader(tmp_path).load_bundle(_write_projection_call_workflow(tmp_path)).projection
+    state = {
+        "repeat_until": {"ReviewLoop": {"current_iteration": 1, "completed_iterations": [0],
+                                        "condition_evaluated_for_iteration": None, "last_condition_result": None}},
+        "for_each": {"ProcessItems": {"items": ["x"], "completed_indices": [], "current_index": 0}},
+    }
+    index = projection.enumerate_resume_slots(state)
+    assert set(index.call_boundaries_by_step_id) == {
+        "root.review_loop#0.iteration_body.run_review_loop",
+        "root.review_loop#1.iteration_body.run_review_loop",
+        "root.process_items#0.run_review_loop_from_for_each",
+    }
+
+
+@pytest.mark.parametrize(
+    ("state", "reason", "message"),
+    [
+        ({"for_each": []}, "unsupported_shape", "for_each must be a mapping"),
+        ({"for_each": {"ProcessItems": []}}, "unsupported_shape", "for_each.ProcessItems must be a mapping"),
+        (_fe(items="ab"), "unsupported_shape", "for_each.ProcessItems.items must be a list"),
+        (_fe(current_index=True), "unsupported_shape", "for_each.ProcessItems.current_index must be null or a non-boolean integer"),
+        ({"repeat_until": []}, "unsupported_shape", "repeat_until must be a mapping"),
+        ({"repeat_until": {"ReviewLoop": 3}}, "unsupported_shape", "repeat_until.ReviewLoop must be a mapping"),
+        (_ru(current_iteration=False), "unsupported_shape", "repeat_until.ReviewLoop.current_iteration must be null or a non-boolean integer"),
+        (_ru(exhausted="yes"), "unsupported_shape", "repeat_until.ReviewLoop.exhausted must be boolean when present"),
+        (_fe(completed_indices=[0, 0], current_index=None), "invalid_loop_progress", "for_each.ProcessItems.completed_indices must not contain duplicate indices"),
+        (_fe(completed_indices=[5], current_index=None), "invalid_loop_progress", "for_each.ProcessItems.completed_indices contains an out-of-range index"),
+        (_fe(completed_indices=[True], current_index=None), "invalid_loop_progress", "for_each.ProcessItems.completed_indices contains an out-of-range index"),
+        (_fe(completed_indices=[0], current_index=0), "invalid_loop_progress", "for_each.ProcessItems.current_index is already completed"),
+        (_ru(completed_iterations=[0, 0]), "invalid_loop_progress", "repeat_until.ReviewLoop.completed_iterations must not contain duplicate indices"),
+        (_ru(current_iteration=9, completed_iterations=[]), "invalid_loop_progress", "repeat_until.ReviewLoop.current_iteration is out of range"),
+        (_ru(completed_iterations=[0, 1]), "invalid_loop_progress", "repeat_until.ReviewLoop.completed_iterations is not valid prior history"),
+        (_ru(last_condition_result=True), "invalid_loop_progress", "repeat_until.ReviewLoop.condition result conflicts with evaluation state"),
+        (_ru(current_iteration=None, completed_iterations=[0, 1], condition_evaluated_for_iteration=None, last_condition_result=True),
+         "invalid_loop_progress", "repeat_until.ReviewLoop.terminal progress requires completed evaluated history"),
+        (_ru({"status": "failed"}, exhausted=True, **EXHAUSTED_FULL), "invalid_loop_progress", "repeat_until.ReviewLoop.successful exhaustion requires a completed frame"),
+        (_ru({"status": "failed", "error": {"type": "other"}}, **EXHAUSTED_FULL), "invalid_loop_progress", "repeat_until.ReviewLoop.failed exhaustion requires the terminal exhaustion error"),
+    ],
+)
+def test_enumerate_resume_slots_rejects_invalid_loop_bookkeeping(tmp_path: Path, state, reason, message) -> None:
+    projection = _projection_bundle(tmp_path).projection
+    with pytest.raises(ResumeProjectionValidationError) as excinfo:
+        projection.enumerate_resume_slots(state)
+    assert (excinfo.value.reason, excinfo.value.message) == (reason, message)
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _ru(),
+        _ru(condition_evaluated_for_iteration=1, last_condition_result=False),
+        _ru(current_iteration=None, completed_iterations=[0, 1],
+            condition_evaluated_for_iteration=1, last_condition_result=True),
+        _ru({"status": "completed"}, exhausted=True, **EXHAUSTED_FULL),
+        _ru({"status": "failed", "error": {"type": "repeat_until_iterations_exhausted"}}, **EXHAUSTED_FULL),
+        _ru({"status": "failed", "error": {"type": "repeat_until_iterations_exhausted"}}, exhausted=False, **EXHAUSTED_FULL),
+    ],
+)
+def test_enumerate_resume_slots_accepts_four_repeat_until_forms(tmp_path: Path, state) -> None:
+    _projection_bundle(tmp_path).projection.enumerate_resume_slots(state)
+

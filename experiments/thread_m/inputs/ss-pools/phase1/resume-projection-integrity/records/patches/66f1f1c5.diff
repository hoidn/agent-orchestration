+    "version": "2.7",
+    "name": "leaf",
+    "artifacts": {"ready": {"kind": "scalar", "type": "bool"}},
+    "outputs": {"ready": {"kind": "scalar", "type": "bool", "from": {"ref": "root.steps.SetReady.artifacts.ready"}}},
+    "steps": [{"name": "SetReady", "id": "set_ready", "set_scalar": {"artifact": "ready", "value": True}}],
+}
+
+
+def _marker(name: str) -> dict:
+    return {"name": name, "id": name.lower(), "command": ["bash", "-lc", f"touch {name}.marker"]}
+
+
+def _setup(tmp_path: Path, steps: list, finally_steps: list | None = None):
+    (tmp_path / "leaf.yaml").write_text(yaml.safe_dump(LEAF, sort_keys=False))
+    workflow = {"version": "2.7", "name": "sticky", "imports": {"leaf": "leaf.yaml"}, "steps": steps}
+    if finally_steps:
+        workflow["finally"] = {"id": "cleanup", "steps": finally_steps}
+    path = tmp_path / "workflow.yaml"
+    path.write_text(yaml.safe_dump(workflow, sort_keys=False))
+    bundle = WorkflowLoader(tmp_path).load_bundle(path)
+    manager = StateManager(tmp_path, run_id="sticky")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    first = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    assert first["status"] == "completed"
+    return bundle, manager
+
+
+def _rewind_call(manager: StateManager, step_names: list[str]) -> str:
+    """Make the run resumable at its call with a stale step id inside the called frame."""
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    frame["status"] = "running"
+    frame["state"]["status"] = "running"
+    frame["state"]["current_step"] = {"name": "SetReady", "step_id": "root.stale", "status": "running"}
+    persisted.status = "failed"
+    for name in step_names:
+        persisted.steps[name]["status"] = "failed"
+    manager._write_state()
+    return frame_id
+
+
+def _resume(bundle, tmp_path, manager, **kwargs):
+    return WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, **kwargs), json.loads(
+        manager.state_file.read_text()
+    )
+
+
+def _clear(tmp_path: Path) -> None:
+    for marker in tmp_path.glob("*.marker"):
+        marker.unlink()
+
+
+@pytest.mark.parametrize("on_error", ["stop", "continue"])
+def test_authored_routes_and_on_error_cannot_consume_the_failure(tmp_path, on_error):
+    call = {"name": "Call", "id": "call", "call": "leaf",
+            "on": {"success": {"goto": "AfterSuccess"}, "failure": {"goto": "Recover"}, "always": {"goto": "Recover"}}}
+    steps = [call, _marker("Recover"), _marker("AfterSuccess")]
+    bundle, manager = _setup(tmp_path, steps)
+    _rewind_call(manager, ["Call"])
+    _clear(tmp_path)
+
+    result, persisted = _resume(bundle, tmp_path, manager, on_error=on_error)
+
+    assert result["status"] == "failed"
+    assert persisted["error"]["type"] == ERROR_TYPE
+    assert persisted["steps"]["Call"]["error"] == persisted["error"]
+    assert not list(tmp_path.glob("*.marker"))
+
+
+def test_unrouted_next_step_does_not_run_with_on_error_continue(tmp_path):
+    bundle, manager = _setup(tmp_path, [{"name": "Call", "id": "call", "call": "leaf"}, _marker("Next")])
+    _rewind_call(manager, ["Call"])
+    _clear(tmp_path)
+    result, persisted = _resume(bundle, tmp_path, manager, on_error="continue")
+    assert persisted["error"]["type"] == ERROR_TYPE and not list(tmp_path.glob("*.marker"))
+    assert result["status"] == "failed"
+
+
+def test_for_each_stops_without_a_next_iteration(tmp_path):
+    loop = {"name": "Loop", "id": "loop", "for_each": {"items": ["a", "b"], "steps": [
+        {"name": "Call", "id": "call", "call": "leaf"}, _marker("Body")]}}
+    bundle, manager = _setup(tmp_path, [loop, _marker("After")])
+    persisted = manager.load()
+    frame_id = next(f for f in persisted.call_frames if "#0" in f)
+    persisted.call_frames = {frame_id: persisted.call_frames[frame_id]}
+    frame = persisted.call_frames[frame_id]
+    frame["status"] = "running"
+    frame["state"]["status"] = "running"
+    frame["state"]["current_step"] = {"name": "SetReady", "step_id": "root.stale", "status": "running"}
+    persisted.steps = {k: v for k, v in persisted.steps.items() if "[1]" not in k and k != "Loop"}
+    persisted.steps["Loop[0].Call"]["status"] = "failed"
+    persisted.for_each["Loop"] = type(persisted.for_each["Loop"])(items=["a", "b"], completed_indices=[], current_index=0)
+    persisted.status = "failed"
+    manager._write_state()
+    _clear(tmp_path)
+
+    result, after = _resume(bundle, tmp_path, manager, on_error="continue")
+
+    assert result["status"] == "failed"
+    assert after["error"]["type"] == ERROR_TYPE
+    assert after["error"]["context"]["scope_path"][1]["frame_id"] == frame_id
+    assert not list(tmp_path.glob("*.marker"))
+    assert after["for_each"]["Loop"]["completed_indices"] == []
+    assert not any("[1]" in name for name in after["steps"])
+
+
+def test_repeat_until_stops_and_keeps_the_diagnostic_unwrapped(tmp_path):
+    loop = {"name": "Loop", "id": "loop", "repeat_until": {
+        "id": "body", "max_iterations": 3,
+        "outputs": {"ready": {"kind": "scalar", "type": "bool", "from": {"ref": "self.steps.Call.artifacts.ready"}}},
+        "condition": {"compare": {"left": {"ref": "self.outputs.ready"}, "op": "eq", "right": True}},
+        "steps": [{"name": "Call", "id": "call", "call": "leaf"}]}}
+    bundle, manager = _setup(tmp_path, [loop, _marker("After")])
+    persisted = manager.load()
+    frame_id = next(f for f in persisted.call_frames if "#0" in f)
+    frame = persisted.call_frames[frame_id]
+    persisted.call_frames = {frame_id: frame}
+    frame["status"] = "running"
+    frame["state"]["status"] = "running"
+    frame["state"]["current_step"] = {"name": "SetReady", "step_id": "root.stale", "status": "running"}
+    persisted.steps = {k: v for k, v in persisted.steps.items() if k.startswith("Loop[0]")}
+    persisted.steps["Loop[0].Call"]["status"] = "failed"
+    persisted.steps["Loop"] = {"status": "running", "name": "Loop", "step_id": "root.loop"}
+    persisted.repeat_until["Loop"] = {"current_iteration": 0, "completed_iterations": [],
+                                      "condition_evaluated_for_iteration": None, "last_condition_result": None}
+    persisted.status = "failed"
+    manager._write_state()
+    _clear(tmp_path)
+
+    result, after = _resume(bundle, tmp_path, manager)
+
+    assert result["status"] == "failed"
+    assert after["error"]["type"] == ERROR_TYPE
+    assert after["steps"]["Loop"]["error"] == after["error"]
+    assert after["repeat_until"]["Loop"]["current_iteration"] == 0
+    assert not list(tmp_path.glob("*.marker"))
+
+
+def test_finalization_runs_and_cleanup_failure_is_supplemental(tmp_path):
+    cleanup = [{"name": "Cleanup", "id": "cleanup_step",
+                "command": ["bash", "-lc", "touch cleanup.marker; test ! -f fail.flag"]}]
+    bundle, manager = _setup(tmp_path, [{"name": "Call", "id": "call", "call": "leaf"}], cleanup)
+    (tmp_path / "fail.flag").write_text("x")
+    _rewind_call(manager, ["Call"])
+    persisted = manager.load()
+    persisted.steps.pop("finally.Cleanup", None)
+    persisted.finalization = {}
+    manager._write_state()
+    _clear(tmp_path)
+
+    result, after = _resume(bundle, tmp_path, manager)
+
+    assert (tmp_path / "cleanup.marker").exists()
+    assert result["status"] == "failed"
+    assert after["error"]["type"] == ERROR_TYPE
+    assert after["finalization"]["status"] == "failed"
+    failure = after["finalization"]["failure"]
+    assert set(failure) == {"step", "step_id", "error"}
+    assert failure["step"] == "finally.Cleanup" and failure["error"] is None
+
+
+def test_projection_error_arising_only_in_finalization_becomes_the_run_error(tmp_path):
+    cleanup = [_marker("Cleanup")]
+    bundle, manager = _setup(tmp_path, [_marker("Body")], cleanup)
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    error = {"type": ERROR_TYPE, "message": "Resume projection integrity audit failed: x", "context": {}}
+    state = {"steps": {"finally.Cleanup": {"status": "failed", "step_id": "root.finally.cleanup.cleanup",
+                                           "exit_code": 2, "error": error}}}
+    for body_status in ("completed", "failed"):
+        state.pop("error", None)
+        executor._record_finalization_settled_result(
+            state, None, "finally.Cleanup", body_status, step_node_id="root.finally.cleanup.cleanup"
+        )
+        assert state["error"] is error
+        assert state["finalization"]["status"] == "failed"
+        assert state["finalization"]["failure"]["error"] is error
+
+
+def test_later_projection_error_never_replaces_the_run_diagnostic(tmp_path):
+    bundle, manager = _setup(tmp_path, [_marker("Body")], [_marker("Cleanup")])
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    first = {"type": ERROR_TYPE, "message": "first", "context": {}}
+    second = {"type": ERROR_TYPE, "message": "second", "context": {}}
+    state = {"error": first, "steps": {"finally.Cleanup": {"status": "failed", "step_id": "s", "error": second}}}
+    executor._record_finalization_settled_result(
+        state, None, "finally.Cleanup", "failed", step_node_id="root.finally.cleanup.cleanup"
+    )
+    assert state["error"] is first
+    assert state["finalization"]["failure"]["error"] is second

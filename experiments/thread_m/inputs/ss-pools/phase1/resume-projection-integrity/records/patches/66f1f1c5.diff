@@ -0,0 +1,103 @@
+"""Call-frame half of the resume scope audit (boundary ownership, alias, lineage)."""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_retry_lineage import (
+    CallFrameRetryLineageError,
+    group_frame_families,
+    index_retry_lineage,
+)
+
+
+def _frame_boundary(ctx: Any, index: Any, frame_id: str, frame: Mapping[str, Any]) -> Any:
+    """Resolve one frame's caller identity to its unique current boundary or fail."""
+    field = f"call_frames.{frame_id}.call_step_id"
+    call_step_id = frame.get("call_step_id")
+    if call_step_id is None:
+        ctx.fail("missing_required_identity", field=field)
+    if not isinstance(call_step_id, str):
+        ctx.fail("unsupported_shape", field=field, offending=call_step_id)
+    projection = ctx.bundle.projection
+    resolution = projection.resolve_call_boundary(index, call_step_id)
+    if resolution.candidate_count > 1:
+        ctx.fail(
+            "ambiguous_call_boundary",
+            field=field,
+            offending=call_step_id,
+            candidate_count=resolution.candidate_count,
+            call_boundary_step_id=call_step_id,
+        )
+    if resolution.boundary is None:
+        local = projection.resolve_resume_step_id(index, call_step_id)
+        reason = "missing_call_boundary" if local.candidate_count else "out_of_scope_step_id"
+        ctx.fail(
+            reason,
+            field=field,
+            offending=call_step_id,
+            candidate_count=0,
+            call_boundary_step_id=call_step_id if reason == "missing_call_boundary" else None,
+        )
+    return resolution.boundary
+
+
+def _validate_frame(ctx: Any, index: Any, frame_id: str, frame: Any) -> tuple[Any, Any]:
+    if not isinstance(frame, Mapping):
+        ctx.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+    boundary = _frame_boundary(ctx, index, frame_id, frame)
+    persisted_alias = frame.get("import_alias")
+    if persisted_alias != boundary.import_alias:
+        ctx.fail(
+            "persisted_import_alias_mismatch",
+            field=f"call_frames.{frame_id}.import_alias",
+            offending=persisted_alias,
+            candidate_count=1,
+            call_boundary_step_id=frame["call_step_id"],
+        )
+    imported = workflow_import_bundle(ctx.bundle, boundary.import_alias)
+    if imported is None:
+        ctx.fail(
+            "missing_imported_bundle",
+            field=f"imports.{boundary.import_alias}",
+            offending=boundary.import_alias,
+            candidate_count=1,
+            call_boundary_step_id=frame["call_step_id"],
+        )
+    return boundary, imported
+
+
+def _index_boundary_frames(
+    ctx: Any, step_id: str, frames: list[tuple[str, Any]], frontend_kind: Any
+) -> int:
+    """Index every visit family of one boundary; return the number of running frames."""
+    running = 0
+    for family_items in group_frame_families(frames).values():
+        try:
+            index_retry_lineage(step_id, family_items, frontend_kind=frontend_kind)
+        except CallFrameRetryLineageError as exc:
+            resumable = sum(1 for _, f in family_items if f.get("status") != "completed")
+            if exc.reason == "ambiguous_resumable_call_frame":
+                ctx.fail(exc.reason, field="call_frames", offending=resumable, candidate_count=resumable,
+                         call_boundary_step_id=step_id)
+            ctx.fail(exc.reason, field="call_frames", call_boundary_step_id=step_id)
+        running += sum(1 for _, f in family_items if f.get("status") == "running")
+    return running
+
+
+def audit_call_frames(ctx: Any, frames: Mapping[str, Any], index: Any) -> None:
+    """Validate every frame's caller, alias and status, then each boundary's lineage."""
+    by_boundary: dict[str, list[tuple[str, Any]]] = {}
+    imported_by_boundary: dict[str, Any] = {}
+    for frame_id, frame in frames.items():
+        _, imported = _validate_frame(ctx, index, str(frame_id), frame)
+        by_boundary.setdefault(frame["call_step_id"], []).append((str(frame_id), frame))
+        imported_by_boundary[frame["call_step_id"]] = imported
+    for step_id, items in by_boundary.items():
+        provenance = workflow_provenance(imported_by_boundary[step_id])
+        kind = getattr(provenance, "frontend_kind", None)
+        running = _index_boundary_frames(ctx, step_id, items, kind)
+        if running > 1:
+            ctx.fail("ambiguous_resumable_call_frame", field="call_frames", offending=running,
+                     candidate_count=running, call_boundary_step_id=step_id)

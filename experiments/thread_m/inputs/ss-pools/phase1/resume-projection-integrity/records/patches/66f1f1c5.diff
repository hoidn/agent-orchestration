+def _call_workflow(workspace: Path):
+    _write_yaml(
+        workspace / "lib.yaml",
+        {
+            "version": "2.7",
+            "name": "lib",
+            "steps": [{"name": "Work", "id": "work", "command": ["true"]}],
+        },
+    )
+    path = _write_yaml(
+        workspace / "caller.yaml",
+        {
+            "version": "2.7",
+            "name": "caller",
+            "imports": {"lib": "lib.yaml"},
+            "steps": [
+                {"name": "First", "id": "first", "command": ["true"]},
+                {"name": "Call", "id": "call", "call": "lib"},
+            ],
+        },
+    )
+    return WorkflowLoader(workspace).load_bundle(path)
+
+
+def _frame(status="failed", step="root.call", alias="lib"):
+    return {"status": status, "call_step_id": step, "import_alias": alias}
+
+
+def _fail(bundle, state, path=ROOT_PATH) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as excinfo:
+        audit_scope(bundle, state, path)
+    error = excinfo.value.error
+    assert set(error["context"]) == KEYS
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == f"Resume projection integrity audit failed: {error['context']['reason']}"
+    assert error["context"]["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    return error["context"]
+
+
+def _expect(ctx, reason, field, offending, count, boundary=None):
+    assert (ctx["reason"], ctx["field"], ctx["offending_value"], ctx["candidate_count"]) == (
+        reason, field, offending, count,
+    )
+    assert ctx["call_boundary_step_id"] == boundary
+
+
+@pytest.fixture
+def pbundle(tmp_path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_workflow(tmp_path))
+
+
+@pytest.fixture
+def cbundle(tmp_path):
+    return _call_workflow(tmp_path)
+
+
+def test_valid_state_passes_and_is_not_mutated(pbundle):

+
+    @staticmethod
+    def _delta(before: dict, after: dict) -> set:
+        assert [key for key in after if key in before] == list(before)
+        return {key for key in after if before.get(key, object()) != after[key]}
+
+    def test_read_persisted_state_accepts_shapes_typed_load_rejects(self, tmp_path):

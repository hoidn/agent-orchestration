+def test_cli_executor_guard_failure_keeps_session_metadata_and_unknown_fields(tmp_path):
+    path, _bundle, manager = _seed(tmp_path, run_id="cli-guard")
+    state = json.loads(manager.state_file.read_text())
+    state["current_step"] = {"name": "Effect", "step_id": "root.stale", "status": "running"}
+    manager.state_file.write_text(json.dumps(state, indent=2))

+"""Scope audit of persisted resume identities against the current workflow projection.
+
+`audit_scope(bundle, state, scope_path)` reads only the bundle and raw persisted state
+it is given: it loads no workflow, computes no checksum, reads no file and never mutates
+`state`. It audits one scope (it does not recurse into call-frame state; callers recurse
+with the bundle they select). Failure raises `ResumeProjectionIntegrityError` whose
+`.error` is the stable diagnostic dict (type `resume_projection_integrity_error`).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from .resume_projection_integrity_frames import audit_call_frames
+from .resume_retry_lineage import (  # noqa: F401  (re-exported lineage names)
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    group_frame_families,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .resume_slots import ResumeProjectionSlotIndex, ResumeProjectionValidationError
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+_SCALARS = (str, int, float, bool)
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through entered call frames."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, Any]]:
+        path: list[dict[str, Any]] = [{"kind": "root", "workflow_file": self.root_workflow_file}]
+        path.extend({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids)
+        return path
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Raised when persisted identities are not owned by the current projection."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def is_projection_integrity_error(value: Any) -> bool:
+    """True for the diagnostic dict, an exception carrying it, or a step/run result holding it."""
+    if isinstance(value, ResumeProjectionIntegrityError):
+        return True
+    if isinstance(value, Mapping):
+        if value.get("type") == ERROR_TYPE:
+            return True
+        error = value.get("error")
+        return isinstance(error, Mapping) and error.get("type") == ERROR_TYPE
+    return False
+
+
+def _scalar_or_none(value: Any) -> Any:
+    return value if isinstance(value, _SCALARS) else None
+
+
+class ScopeAuditContext:
+    """Builds diagnostics for one audited scope."""
+
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+
+    def diagnostic(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        offending: Any = None,
+        candidate_count: Optional[int] = None,
+        call_boundary_step_id: Optional[str] = None,
+    ) -> dict[str, Any]:
+        provenance = getattr(self.bundle, "provenance", None)
+        workflow_path = getattr(provenance, "workflow_path", None)
+        checksum = self.state.get("workflow_checksum")
+        return {
+            "type": ERROR_TYPE,
+            "message": f"Resume projection integrity audit failed: {reason}",
+            "context": {
+                "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                "reason": reason,
+                "scope_path": self.scope_path.as_context(),
+                "field": field,
+                "offending_value": _scalar_or_none(offending),
+                "expected_owner": {
+                    "workflow_file": str(workflow_path) if workflow_path is not None else None,
+                    "workflow_checksum": checksum if isinstance(checksum, str) else None,
+                    "projection_scope": self.scope_path.projection_scope,
+                },
+                "candidate_count": candidate_count,
+                "call_boundary_step_id": call_boundary_step_id,
+            },
+        }
+
+    def fail(self, reason: str, **fields: Any) -> NoReturn:
+        raise ResumeProjectionIntegrityError(self.diagnostic(reason, **fields))
+
+
+def build_diagnostic(
+    bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath, reason: str, **fields: Any
+) -> dict[str, Any]:
+    """Build one stable diagnostic dict for a scope without raising."""
+    return ScopeAuditContext(bundle, state if isinstance(state, Mapping) else {}, scope_path).diagnostic(
+        reason, **fields
+    )
+
+
+def _mapping_field(ctx: ScopeAuditContext, name: str) -> Mapping[str, Any]:
+    value = ctx.state.get(name, {})
+    if not isinstance(value, Mapping):
+        ctx.fail("unsupported_shape", field=name)
+    return value
+
+
+def _enumerate(ctx: ScopeAuditContext) -> ResumeProjectionSlotIndex:
+    try:
+        return ctx.bundle.projection.enumerate_resume_slots(ctx.state)
+    except ResumeProjectionValidationError as exc:
+        ctx.fail(exc.reason, field=exc.field)
+
+
+def _audit_step_rows(ctx: ScopeAuditContext, steps: Mapping[str, Any], index: ResumeProjectionSlotIndex) -> None:
+    projection = ctx.bundle.projection
+    for name, row in steps.items():
+        if not isinstance(row, Mapping):
+            if isinstance(row, list) and name in index.slots_by_row_name:
+                continue  # for_each result container owned by a known loop frame
+            ctx.fail("unsupported_shape", field=f"steps.{name}")
+        if "step_id" not in row or name not in index.slots_by_row_name:
+            continue
+        field = f"steps.{name}.step_id"
+        step_id = row["step_id"]
+        if not isinstance(step_id, str):
+            ctx.fail("unsupported_shape", field=field, offending=step_id)
+        resolution = projection.resolve_resume_step_id(index, step_id, name)
+        if resolution.exact_identity_candidate_count == 1:
+            continue
+        if resolution.candidate_count == 0:
+            ctx.fail("unknown_explicit_step_id", field=field, offending=step_id, candidate_count=0)
+        ctx.fail(
+            "presentation_slot_mismatch",
+            field=field,
+            offending=step_id,
+            candidate_count=resolution.candidate_count,
+        )
+
+
+def _audit_current_step(ctx: ScopeAuditContext, index: ResumeProjectionSlotIndex) -> None:
+    current = ctx.state.get("current_step")
+    if current is None:
+        return
+    if not isinstance(current, Mapping):
+        ctx.fail("unsupported_shape", field="current_step")
+    step_id = current.get("step_id")
+    if step_id is None:
+        ctx.fail("missing_required_identity", field="current_step.step_id")
+    if not isinstance(step_id, str):
+        ctx.fail("unsupported_shape", field="current_step.step_id", offending=step_id)
+    name = current.get("name")
+    resolution = ctx.bundle.projection.resolve_resume_step_id(
+        index, step_id, name if isinstance(name, str) else None
+    )
+    if resolution.exact_identity_candidate_count == 1:
+        return
+    if resolution.candidate_count == 0:
+        ctx.fail("out_of_scope_step_id", field="current_step.step_id", offending=step_id, candidate_count=0)
+    ctx.fail(
+        "presentation_slot_mismatch",
+        field="current_step.step_id",
+        offending=step_id,
+        candidate_count=resolution.candidate_count,
+    )
+
+
+def _audit_unclaimed_rows(ctx: ScopeAuditContext, index: ResumeProjectionSlotIndex) -> None:
+    for name, step_id in index.unclaimed_explicit_rows:
+        ctx.fail(
+            "unclaimed_explicit_step_row",
+            field=f"steps.{name}.step_id",
+            offending=step_id,
+            candidate_count=0,
+        )
+
+
+def audit_scope(bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+    """Audit one resumable scope; raise `ResumeProjectionIntegrityError` on any violation."""
+    ctx = ScopeAuditContext(bundle, state if isinstance(state, Mapping) else {}, scope_path)
+    if not isinstance(state, Mapping):
+        ctx.fail("unsupported_shape")
+    steps = _mapping_field(ctx, "steps")
+    frames = _mapping_field(ctx, "call_frames")
+    index = _enumerate(ctx)
+    _audit_step_rows(ctx, steps, index)
+    _audit_current_step(ctx, index)
+    _audit_unclaimed_rows(ctx, index)
+    audit_call_frames(ctx, frames, index)

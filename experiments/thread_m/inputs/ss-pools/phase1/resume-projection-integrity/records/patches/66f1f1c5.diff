+    _expect(ctx, "ambiguous_call_boundary", "call_frames.f.call_step_id", "root.call", 2, "root.call")
+
+
+def test_ambiguous_resumable_call_frame_across_visits(cbundle):
+    frames = {"root.call::visit::1": _frame("running"), "root.call::visit::2": _frame("running")}
+    ctx = _fail(cbundle, {"call_frames": frames})
+    _expect(ctx, "ambiguous_resumable_call_frame", "call_frames", 2, 2, "root.call")

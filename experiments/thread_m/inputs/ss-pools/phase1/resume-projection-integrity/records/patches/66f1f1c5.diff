--- /dev/null
+++ b/orchestrator/loader_imports_scan.py
@@ -0,0 +1,64 @@
+"""Pre-load scan for duplicate classic-YAML import aliases and `imports` sections.
+
+PyYAML silently keeps the last duplicate key, so the scan walks the composed node
+graph (anchors resolved, `<<` merges followed) before the mapping is constructed.
+"""
+
+from __future__ import annotations
+
+from typing import Iterator
+
+import yaml
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: yaml.Node) -> str:
+    mark = node.start_mark
+    return f"line {mark.line + 1}, column {mark.column + 1}"
+
+
+def _merge_sources(value: yaml.Node) -> Iterator[yaml.MappingNode]:
+    if isinstance(value, yaml.MappingNode):
+        yield value
+    elif isinstance(value, yaml.SequenceNode):
+        for item in value.value:
+            if isinstance(item, yaml.MappingNode):
+                yield item
+
+
+def _effective_pairs(mapping: yaml.MappingNode) -> Iterator[tuple[yaml.Node, yaml.Node]]:
+    """Yield (key, value) pairs of a mapping, following `<<` merges depth-first."""
+    for key, value in mapping.value:
+        if key.tag == _MERGE_TAG:
+            for source in _merge_sources(value):
+                yield from _effective_pairs(source)
+        else:
+            yield key, value
+
+
+def scan_import_aliases(text: str, loader: type = yaml.SafeLoader) -> list[str]:
+    """Return duplicate-alias / duplicate-section messages for one workflow document."""
+    try:
+        root = yaml.compose(text, Loader=loader)
+    except yaml.YAMLError:
+        return []  # the ordinary parse reports syntax errors
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [(key, value) for key, value in _effective_pairs(root) if key.value == "imports"]
+    occurrences: dict[str, list[yaml.Node]] = {}
+    for _, value in sections:
+        if isinstance(value, yaml.MappingNode):
+            for key, _ in _effective_pairs(value):
+                occurrences.setdefault(str(key.value), []).append(key)
+    messages = [
+        f"imports.{alias}: duplicate import alias ({'; '.join(_position(k) for k in keys)})"
+        for alias, keys in occurrences.items()
+        if len(keys) > 1
+    ]
+    if not messages and len(sections) > 1:
+        messages.append(
+            "imports: duplicate top-level mapping "
+            f"({'; '.join(_position(key) for key, _ in sections)})"
+        )
+    return messages

+    after = json.loads(manager.state_file.read_text())
+    assert events == ["audit"]
+    assert result["error"]["type"] == "resume_projection_integrity_error"
+    assert _delta(before, after) <= ENVELOPE_KEYS
+    assert after["current_step"] == before["current_step"]
+    assert after["unknown_root_field"] == {"keep": True}

diff --git a/orchestrator/loader_imports.py b/orchestrator/loader_imports.py
new file mode 100644
index 0000000..3420abe
--- /dev/null
+++ b/orchestrator/loader_imports.py
@@ -0,0 +1,65 @@
+"""Duplicate `imports` detection over the composed YAML node tree.
+
+`yaml.load` silently keeps the last of duplicate keys and lets explicit keys
+override `<<` merge sources, so duplicate import aliases and repeated
+top-level `imports` sections are only visible at the node level.
+"""
+
+from typing import Dict, Iterator, List, Tuple
+
+from yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+_MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _position(node: Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def _is_merge_key(key: Node) -> bool:
+    return key.tag == _MERGE_TAG
+
+
+def _effective_pairs(node: MappingNode) -> Iterator[Tuple[Node, Node]]:
+    """Yield every key/value pair of a mapping, expanding `<<` merge sources in place."""
+    for key, value in node.value:
+        if not _is_merge_key(key):
+            yield key, value
+            continue
+        sources = value.value if isinstance(value, SequenceNode) else [value]
+        for source in sources:
+            if isinstance(source, MappingNode):
+                yield from _effective_pairs(source)
+
+
+def duplicate_import_errors(root: Node) -> List[str]:
+    """Return duplicate-import messages for a composed workflow document root.
+
+    A repeated alias across all effective `imports` entries is reported once as
+    `imports.<alias>: duplicate import alias at <positions>`. Otherwise, more
+    than one top-level `imports` section is reported as
+    `imports: duplicate top-level mapping at <positions>`.
+    """
+    if not isinstance(root, MappingNode):
+        return []
+    section_keys: List[Node] = []
+    alias_keys: Dict[str, List[Node]] = {}
+    for key, value in _effective_pairs(root):
+        if not (isinstance(key, ScalarNode) and key.value == "imports"):
+            continue
+        section_keys.append(key)
+        if isinstance(value, MappingNode):
+            for alias_key, _ in _effective_pairs(value):
+                if isinstance(alias_key, ScalarNode):
+                    alias_keys.setdefault(alias_key.value, []).append(alias_key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias at " + "; ".join(_position(k) for k in keys)
+        for alias, keys in alias_keys.items()
+        if len(keys) > 1
+    ]
+    if not errors and len(section_keys) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping at " + "; ".join(_position(k) for k in section_keys)
+        )
+    return errors

--- /dev/null
+++ b/tests/test_state_manager_failure_envelopes.py
@@ -0,0 +1,147 @@
+"""Failure envelopes patch only root status/error/updated_at in state.json."""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager, StepResult
+
+
+def _running_manager_with_unknown_root_field(tmp_path: Path) -> StateManager:
+    (tmp_path / "wf.yaml").write_text("version: '1.3'\nsteps: []\n", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="run1")
+    manager.initialize("wf.yaml")
+    manager.update_step("Prep", StepResult(status="completed", exit_code=0))
+    manager.start_step("Draft", 1, "provider", step_id="root.draft", visit_count=2)
+    raw = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    raw["future_root_field"] = {"kept": True}
+    manager.state_file.write_text(json.dumps(raw), encoding="utf-8")
+    return manager
+
+
+def _read(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _changed_keys(before: dict, after: dict) -> set:
+    return {key for key in before.keys() | after.keys() if before.get(key) != after.get(key)}
+
+
+def test_checksum_mismatch_changes_only_status_error_and_updated_at(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+    before = _read(manager)
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="wf.yaml",
+        persisted_checksum="sha256:old",
+        current_checksum="sha256:new",
+        reason="workflow_modified",
+    )
+
+    assert _changed_keys(before, _read(manager)) <= {"status", "error", "updated_at"}
+
+
+def test_checksum_mismatch_persists_failed_envelope(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file=None,
+        persisted_checksum=None,
+        current_checksum=None,
+        reason="missing_workflow_path",
+    )
+
+    after = _read(manager)
+    assert (after["status"], after["error"]) == (
+        "failed",
+        {
+            "type": "workflow_checksum_mismatch",
+            "message": "Workflow has been modified since the run started",
+            "context": {
+                "workflow_file": None,
+                "persisted_checksum": None,
+                "current_checksum": None,
+                "reason": "missing_workflow_path",
+            },
+        },
+    )
+
+
+def test_checksum_mismatch_preserves_unknown_root_field_steps_and_current_step(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+    before = _read(manager)
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="wf.yaml",
+        persisted_checksum="sha256:old",
+        current_checksum="sha256:new",
+        reason="workflow_modified",
+    )
+
+    after = _read(manager)
+    preserved = ("future_root_field", "steps", "current_step")
+    assert {k: after[k] for k in preserved} == {k: before[k] for k in preserved}
+
+
+def test_checksum_mismatch_updates_in_memory_state(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+
+    manager.record_workflow_checksum_mismatch(
+        workflow_file="wf.yaml",
+        persisted_checksum="sha256:old",
+        current_checksum=None,
+        reason="workflow_unavailable",
+    )
+
+    assert (manager.state.status, manager.state.error, manager.state.current_step["status"]) == (
+        "failed",
+        _read(manager)["error"],
+        "running",
+    )
+
+
+def test_checksum_mismatch_rejects_unknown_reason(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+
+    with pytest.raises(ValueError):
+        manager.record_workflow_checksum_mismatch(
+            workflow_file="wf.yaml",
+            persisted_checksum="a",
+            current_checksum="b",
+            reason="something_else",
+        )
+
+
+def test_checksum_mismatch_rejects_non_string_checksum(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+
+    with pytest.raises(ValueError):
+        manager.record_workflow_checksum_mismatch(
+            workflow_file="wf.yaml",
+            persisted_checksum=123,
+            current_checksum="b",
+            reason="workflow_modified",
+        )
+
+
+def test_projection_integrity_failure_changes_only_status_error_and_updated_at(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+    before = _read(manager)
+    error = {"type": "resume_projection_integrity_error", "message": "bad", "context": {"k": 1}}
+
+    manager.record_resume_projection_integrity_failure(error)
+
+    after = _read(manager)
+    assert (_changed_keys(before, after) <= {"status", "error", "updated_at"}, after["status"], after["error"]) == (
+        True,
+        "failed",
+        error,
+    )
+
+
+def test_projection_integrity_failure_rejects_other_error_types(tmp_path: Path):
+    manager = _running_manager_with_unknown_root_field(tmp_path)
+
+    with pytest.raises(ValueError):
+        manager.record_resume_projection_integrity_failure({"type": "other", "message": "x"})

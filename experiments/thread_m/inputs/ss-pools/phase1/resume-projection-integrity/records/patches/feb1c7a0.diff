+"""Runtime coverage for checksum-compatible resume projection integrity.
+
+Covers the executor root guard, reached-call validation, retry lineage selection,
+the sticky non-routable failure contract, and the CLI failure envelopes.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from orchestrator.cli.commands import resume as resume_command
+from orchestrator.cli.commands.resume import resume_workflow
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow import calls as calls_module
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.test_workflow_state_projection import _write_projection_call_workflow
+from tests.workflow_bundle_helpers import bundle_context_dict, materialize_projection_body_steps
+
+STALE_CURRENT = {
+    "status": "running",
+    "name": "RemovedLocal",
+    "index": 0,
+    "step_id": "root.removed_local_call",
+    "visit_count": 1,
+}
+
+
+def _read(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _delta(before: dict, after: dict) -> set[str]:
+    return {key for key in before.keys() | after.keys() if before.get(key) != after.get(key)}
+
+
+def _graph_run(tmp_path: Path, root_steps: list[dict] | None = None, *, run_id: str = "run"):
+    """Run the root -> middle -> leaf graph to completion and return (bundle, manager)."""
+    workflow_path = _write_projection_integrity_call_graph(tmp_path)
+    if root_steps is not None:
+        payload = yaml.safe_load(workflow_path.read_text(encoding="utf-8"))
+        payload["steps"] = root_steps
+        workflow_path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow_path)
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize(workflow_path.name, context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    return bundle, manager
+
+
+def _make_middle_frame_resumable(manager: StateManager, *, stale_current: bool = True) -> str:
+    persisted = manager.load()
+    frame_id, frame = next(iter(persisted.call_frames.items()))
+    child_state = frame["state"]
+    child_state["status"] = "failed"
+    child_state["steps"]["InvokeLeaf"]["status"] = "failed"
+    if stale_current:
+        child_state["current_step"] = dict(STALE_CURRENT)
+        frame["current_step"] = dict(STALE_CURRENT)
+    frame["status"] = "running"
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    return frame_id
+
+
+# --------------------------------------------------------------------------- root guard
+
+
+def test_structural_root_rechecks_the_authoritative_checksum_before_the_audit(tmp_path):
+    bundle, manager = _graph_run(tmp_path)
+    persisted = manager.load()
+    persisted.status = "failed"
+    persisted.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    recorded = persisted.workflow_checksum
+    workflow_path = tmp_path / "workflow.yaml"
+    workflow_path.write_text(workflow_path.read_text(encoding="utf-8") + "\n# edited\n", encoding="utf-8")
+    before = _read(manager)
+    audited: list[object] = []
+
+    with patch("orchestrator.workflow.executor.audit_scope", side_effect=audited.append):
+        result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    after = _read(manager)
+    assert result["status"] == "failed"
+    assert audited == []
+    assert {"error", "updated_at"} <= _delta(before, after) <= {"status", "error", "updated_at"}
+    error = after["error"]
+    assert error["type"] == "workflow_checksum_mismatch"
+    assert error["message"] == "Workflow has been modified since the run started"
+    assert error["context"] == {
+        "workflow_file": "workflow.yaml",
+        "persisted_checksum": recorded,
+        "current_checksum": manager.calculate_checksum(workflow_path),
+        "reason": "workflow_modified",
+    }
+
+
+@pytest.mark.parametrize("reason", ["missing_recorded_checksum", "workflow_unavailable", "missing_workflow_path"])
+def test_structural_root_checksum_reasons(tmp_path, reason):
+    bundle, manager = _graph_run(tmp_path)
+    persisted = manager.load()
+    persisted.status = "failed"
+    if reason == "missing_recorded_checksum":
+        persisted.workflow_checksum = ""
+    elif reason == "workflow_unavailable":
+        (tmp_path / "workflow.yaml").unlink()
+    else:
+        persisted.workflow_file = ""
+    manager._write_state()
+
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+

@@ -0,0 +1,168 @@
+"""Duplicate classic-YAML import aliases / sections fail before bundle lowering."""
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+steps:
+  - name: Hello
+    command: ["echo", "hi"]
+"""
+
+
+def _write_workflow(tmp_path: Path, body: str) -> Path:
+    lib_dir = tmp_path / "workflows" / "library"
+    lib_dir.mkdir(parents=True, exist_ok=True)
+    for name in ("a.yaml", "b.yaml", "c.yaml"):
+        (lib_dir / name).write_text(LIBRARY)
+    path = tmp_path / "workflows" / "caller.yaml"
+    path.write_text(body)
+    return path
+
+
+def _load_error(tmp_path: Path, monkeypatch, body: str) -> str:
+    def _unreachable(*args, **kwargs):
+        raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _unreachable)
+    path = _write_workflow(tmp_path, body)
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(tmp_path).load(path)
+    return str(excinfo.value)
+
+
+STEPS = """\
+steps:
+  - name: Hello
+    command: ["echo", "hi"]
+"""
+
+
+def test_duplicate_key_in_one_imports_mapping(tmp_path, monkeypatch):
+    body = (
+        'version: "2.5"\n'
+        "name: caller\n"
+        "imports:\n"
+        "  a: library/a.yaml\n"
+        "  a: library/b.yaml\n" + STEPS
+    )
+    message = _load_error(tmp_path, monkeypatch, body)
+    assert "imports.a: duplicate import alias at line 4, column 3; line 5, column 3" in message
+
+

diff --git a/orchestrator/workflow/resume_call_lineage.py b/orchestrator/workflow/resume_call_lineage.py
new file mode 100644
index 0000000..d094ee3
--- /dev/null
+++ b/orchestrator/workflow/resume_call_lineage.py
@@ -0,0 +1,193 @@
+"""Call-frame retry lineage indexing for resume.
+
+Groups the persisted frames of one call boundary into a deterministic lineage:
+completed historical frames, failed predecessors, and at most one running
+member.  Workflow Lisp boundaries retry under a fresh ``<base>::retry::<n>``
+frame id; every other boundary has at most one resumable frame.
+
+Reads only its arguments and mutates nothing.  Dependencies: none.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+RETRY_MARKER = "::retry::"
+KNOWN_FRAME_STATUSES = frozenset({"completed", "running", "failed"})
+_RETRY_SUFFIX = re.compile(r"^(?P<base>.*)::retry::(?P<tail>[^.:]*)$")
+_ORDINAL = re.compile(r"^[1-9][0-9]*$")
+
+
+class CallFrameRetryLineageError(ValueError):
+    """Invalid frame set for one boundary; ``reason`` is a stable diagnostic reason."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    """One persisted frame of a boundary."""
+
+    frame_id: str
+    status: str = "completed"
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    """A lineage member with its retry ordinal (0 is the base frame)."""
+
+    ordinal: int = 0
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    """The deterministic lineage of one call boundary's frames."""
+
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[RetryFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+
+
+def _split_retry_id(frame_id: str) -> tuple[str, int]:
+    """Return ``(base, ordinal)`` for a frame id; a plain id is its own base at 0."""
+    match = _RETRY_SUFFIX.match(frame_id)
+    if match is None:
+        return frame_id, 0
+    base, tail = match.group("base"), match.group("tail")
+    if not _ORDINAL.match(tail):
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "call frame carries a malformed retry marker"
+        )
+    if _RETRY_SUFFIX.match(base) is not None:
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "call frame carries a nested retry marker"
+        )
+    return base, int(tail)
+
+
+def _frame_field(frame: Any, name: str) -> Any:
+    return frame.get(name) if isinstance(frame, Mapping) else None
+
+
+def _validate_frames(boundary_step_id: str, items: list[tuple[str, Any]]) -> None:
+    aliases = set()
+    for frame_id, frame in items:
+        if not isinstance(frame_id, str) or not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame is malformed")
+        if _frame_field(frame, "status") not in KNOWN_FRAME_STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame has an unknown status")
+        if _frame_field(frame, "call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", "call frame is not owned by the boundary"
+            )
+        alias = _frame_field(frame, "import_alias")
+        if not isinstance(alias, str):
+            raise CallFrameRetryLineageError("unsupported_shape", "call frame import alias is malformed")
+        aliases.add(alias)
+    if len(aliases) > 1:
+        raise CallFrameRetryLineageError(
+            "persisted_import_alias_mismatch", "call frames disagree on the import alias"
+        )
+
+
+def _plain_lineage(items: list[tuple[str, Any]]) -> CallFrameRetryLineage:
+    resumable = [(fid, frame["status"]) for fid, frame in items if frame["status"] != "completed"]
+    if len(resumable) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "boundary has several resumable call frames"
+        )
+    return CallFrameRetryLineage(
+        base_frame_id=resumable[0][0] if resumable else None,
+        completed_members=tuple(
+            CallFrameMember(fid, "completed") for fid, frame in items if frame["status"] == "completed"
+        ),
+        failed_predecessors=(),
+        running_member=CallFrameMember(*resumable[0]) if resumable else None,
+    )
+
+
+def _retry_lineage(items: list[tuple[str, Any]]) -> CallFrameRetryLineage:
+    open_members = [
+        (fid, frame["status"], *_split_retry_id(fid))
+        for fid, frame in items
+        if frame["status"] != "completed"
+    ]
+    bases = {base for _fid, _status, base, _ordinal in open_members}
+    if len(bases) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "boundary frames mix several retry bases"
+        )
+    ordinals = [ordinal for *_head, ordinal in open_members]
+    if len(set(ordinals)) != len(ordinals):
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "boundary frames repeat a retry ordinal"
+        )
+    if sum(1 for _fid, status, *_tail in open_members if status == "running") > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "boundary has several running call frames"
+        )
+    base = next(iter(bases), None)
+    completed: list[CallFrameMember] = []
+    for fid, frame in items:
+        if frame["status"] != "completed":
+            continue
+        try:
+            fid_base, ordinal = _split_retry_id(fid)
+        except CallFrameRetryLineageError:
+            fid_base, ordinal = None, 0
+        same_lineage = base is not None and fid_base == base and fid != base
+        completed.append(
+            RetryFrameMember(fid, "completed", ordinal) if same_lineage else CallFrameMember(fid)
+        )
+    used = sorted(
+        ordinals + [m.ordinal for m in completed if isinstance(m, RetryFrameMember)]
+    )
+    if used != list(range(len(used))):
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "boundary frames skip or repeat a retry ordinal"
+        )
+    members = sorted(
+        (RetryFrameMember(fid, status, ordinal) for fid, status, _base, ordinal in open_members),
+        key=lambda member: member.ordinal,
+    )
+    running = [member for member in members if member.status == "running"]
+    return CallFrameRetryLineage(
+        base_frame_id=base,
+        completed_members=tuple(completed),
+        failed_predecessors=tuple(member for member in members if member.status == "failed"),
+        running_member=running[0] if running else None,
+    )
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Index the frames of one boundary; raise ``CallFrameRetryLineageError`` when invalid."""
+    items = list(frame_items)
+    _validate_frames(boundary_step_id, items)
+    if frontend_kind != WORKFLOW_LISP_FRONTEND_KIND:
+        return _plain_lineage(items)
+    return _retry_lineage(items)
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<lowest unused positive ordinal>`` for ``lineage``."""
+    if lineage.base_frame_id is None:
+        raise ValueError("lineage has no base frame to retry")
+    members = [*lineage.failed_predecessors, *lineage.completed_members]
+    if isinstance(lineage.running_member, RetryFrameMember):
+        members.append(lineage.running_member)
+    used = {member.ordinal for member in members if isinstance(member, RetryFrameMember)}
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"
diff --git a/orchestrator/workflow/resume_loop_progress.py b/orchestrator/workflow/resume_loop_progress.py
new file mode 100644
index 0000000..d170677
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_progress.py
@@ -0,0 +1,246 @@
+"""Loop bookkeeping validation for checksum-compatible resume.
+
+Pure functions over persisted ``for_each`` / ``repeat_until`` progress mappings.
+They read nothing but their arguments and never mutate them.  Dependencies: none
+(leaf module consumed by ``state_projection``).
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional, Sequence
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Invalid persisted loop bookkeeping; ``str()`` is the stable message.
+
+    ``field`` is the dotted persisted path at fault and ``value`` its raw value.
+    """
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+        self.value = value
+
+
+def _shape(field: str, message: str, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field=field, value=value)
+
+
+def _progress(field: str, message: str, value: Any = None) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field=field, value=value)
+
+
+def is_plain_int(value: Any) -> bool:
+    """Return True for a non-boolean integer."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def declared_max_iterations(frame_row: Any) -> Optional[int]:
+    """Return the declared ``max_iterations`` persisted on a loop frame row, when present."""
+    debug = frame_row.get("debug") if isinstance(frame_row, Mapping) else None
+    block = debug.get("structured_repeat_until") if isinstance(debug, Mapping) else None
+    maximum = block.get("max_iterations") if isinstance(block, Mapping) else None
+    return maximum if is_plain_int(maximum) and maximum > 0 else None
+
+
+def repeat_until_history_span(progress: Any) -> int:
+    """Return how many iterations the bookkeeping itself shows; used when no maximum is persisted."""
+    if not isinstance(progress, Mapping):
+        return 0
+    values = [progress.get("current_iteration"), *(progress.get("completed_iterations") or [])]
+    ints = [value for value in values if is_plain_int(value) and value >= 0]
+    return max(ints) + 1 if ints else 0
+
+
+def validate_for_each_progress(name: str, progress: Any) -> int:
+    """Validate one ``for_each`` bookkeeping mapping and return its item count."""
+    prefix = f"for_each.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(prefix, f"{prefix} must be a mapping", progress)
+    items = progress.get("items")
+    if not isinstance(items, list):
+        raise _shape(f"{prefix}.items", f"{prefix}.items must be a list", items)
+    current = progress.get("current_index")
+    if current is not None and not is_plain_int(current):
+        raise _shape(
+            f"{prefix}.current_index",
+            f"{prefix}.current_index must be null or a non-boolean integer",
+            current,
+        )
+    completed = progress.get("completed_indices", [])
+    field = f"{prefix}.completed_indices"
+    if not isinstance(completed, list):
+        raise _shape(field, f"{field} must be a list", completed)
+    ints = [value for value in completed if is_plain_int(value)]
+    if len(set(ints)) != len(ints):
+        raise _progress(field, f"{field} must not contain duplicate indices")
+    if len(ints) != len(completed) or any(not 0 <= value < len(items) for value in ints):
+        raise _progress(field, f"{field} contains an out-of-range index")
+    if current is not None:
+        field = f"{prefix}.current_index"
+        if not 0 <= current < len(items):
+            raise _progress(field, f"{field} is out of range", current)
+        if current in ints:
+            raise _progress(field, f"{field} is already completed", current)
+    return len(items)
+
+
+def _completed_history(prefix: str, progress: Mapping[str, Any]) -> list[int]:
+    field = f"{prefix}.completed_iterations"
+    completed = progress.get("completed_iterations", [])
+    if not isinstance(completed, list):
+        raise _shape(field, f"{field} must be a list", completed)
+    ints = [value for value in completed if is_plain_int(value)]
+    if len(set(ints)) != len(ints):
+        raise _progress(field, f"{field} must not contain duplicate indices")
+    if len(ints) != len(completed) or any(value < 0 for value in ints):
+        raise _progress(field, f"{field} is not valid prior history")
+    return sorted(ints)
+
+
+def _conflict(prefix: str, field_name: str, value: Any) -> ResumeProjectionValidationError:
+    return _progress(
+        f"{prefix}.{field_name}",
+        f"{prefix}.condition result conflicts with evaluation state",
+        value,
+    )
+
+
+def _validate_terminal(
+    prefix: str,
+    *,
+    completed: Sequence[int],
+    evaluated: Any,
+    result: Any,
+    exhausted: bool,
+    max_iterations: Optional[int],
+    frame_row: Any,
+) -> None:
+    history = f"{prefix}.completed_iterations"
+    if not completed or evaluated != completed[-1]:
+        raise _progress(
+            f"{prefix}.condition_evaluated_for_iteration",
+            f"{prefix}.terminal progress requires completed evaluated history",
+            evaluated,
+        )
+    if list(completed) != list(range(completed[-1] + 1)):
+        raise _progress(history, f"{history} is not valid prior history")
+    if result is True:
+        if exhausted:
+            raise _conflict(prefix, "exhausted", exhausted)
+        if max_iterations is not None and completed[-1] >= max_iterations:
+            raise _progress(
+                f"{prefix}.current_iteration", f"{prefix}.current_iteration is out of range"
+            )
+        return
+    if result is not False:
+        raise _conflict(prefix, "last_condition_result", result)
+    if max_iterations is not None and completed[-1] != max_iterations - 1:
+        raise _progress(
+            history, f"{prefix}.terminal progress requires completed evaluated history"
+        )
+    if frame_row is None:
+        # The frame row is re-derived when the loop re-enters; only a present row can contradict.
+        return
+    status = frame_row.get("status") if isinstance(frame_row, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _progress(
+                f"steps.{prefix.split('.', 1)[1]}.status",
+                f"{prefix}.successful exhaustion requires a completed frame",
+                status,
+            )
+        return
+    error = frame_row.get("error") if isinstance(frame_row, Mapping) else None
+    error_type = error.get("type") if isinstance(error, Mapping) else None
+    if status != "failed" or error_type != EXHAUSTION_ERROR_TYPE:
+        raise _progress(
+            f"steps.{prefix.split('.', 1)[1]}.error.type",
+            f"{prefix}.failed exhaustion requires the terminal exhaustion error",
+            error_type,
+        )
+
+
+def _validate_active(
+    prefix: str,
+    *,
+    current: int,
+    completed: Sequence[int],
+    evaluated: Any,
+    result: Any,
+    exhausted: bool,
+    max_iterations: Optional[int],
+) -> None:
+    field = f"{prefix}.current_iteration"
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise _progress(field, f"{field} is out of range", current)
+    history = f"{prefix}.completed_iterations"
+    if list(completed) != list(range(current)):
+        raise _progress(history, f"{history} is not valid prior history")
+    if evaluated is not None and (not is_plain_int(evaluated) or evaluated != current):
+        raise _conflict(prefix, "condition_evaluated_for_iteration", evaluated)
+    if result is not None and not isinstance(result, bool):
+        raise _conflict(prefix, "last_condition_result", result)
+    if (evaluated is None) != (result is None):
+        raise _conflict(prefix, "last_condition_result", result)
+    if exhausted:
+        raise _conflict(prefix, "exhausted", exhausted)
+
+
+def validate_repeat_until_progress(
+    name: str,
+    progress: Any,
+    *,
+    max_iterations: Optional[int] = None,
+    frame_row: Any = None,
+) -> None:
+    """Validate one ``repeat_until`` bookkeeping mapping against the four legal forms."""
+    prefix = f"repeat_until.{name}"
+    if not isinstance(progress, Mapping):
+        raise _shape(prefix, f"{prefix} must be a mapping", progress)
+    current = progress.get("current_iteration", "missing")
+    if current is not None and not is_plain_int(current):
+        raise _shape(
+            f"{prefix}.current_iteration",
+            f"{prefix}.current_iteration must be null or a non-boolean integer",
+            None if current == "missing" else current,
+        )
+    exhausted = progress.get("exhausted", False)
+    if not isinstance(exhausted, bool):
+        raise _shape(
+            f"{prefix}.exhausted", f"{prefix}.exhausted must be boolean when present", exhausted
+        )
+    completed = _completed_history(prefix, progress)
+    evaluated = progress.get("condition_evaluated_for_iteration")
+    result = progress.get("last_condition_result")
+    if current is None:
+        _validate_terminal(
+            prefix,
+            completed=completed,
+            evaluated=evaluated,
+            result=result,
+            exhausted=exhausted,
+            max_iterations=max_iterations,
+            frame_row=frame_row,
+        )
+        return
+    _validate_active(
+        prefix,
+        current=current,
+        completed=completed,
+        evaluated=evaluated,
+        result=result,
+        exhausted=exhausted,
+        max_iterations=max_iterations,
+    )

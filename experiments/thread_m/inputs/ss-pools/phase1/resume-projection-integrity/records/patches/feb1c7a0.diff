+"""Resume-time frame selection and callee validation for reached calls.
+
+Splits the resume concerns out of ``calls.py``.  Functions take the owning
+``CallExecutor`` explicitly (for its input/checksum validators) and receive the
+scope audit as the ``audit`` argument so ``calls.audit_scope`` stays the single
+observable audit entry for the call path.  Dependencies: loaded bundle projection,
+persisted ``call_frames`` of the parent state; nothing is mutated.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Callable, Dict, Optional
+
+from .executor_runtime import CallFrameStateManager
+from .loaded_bundle import workflow_import_bundle
+from .resume_call_lineage import (
+    WORKFLOW_LISP_FRONTEND_KIND,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .resume_loop_progress import ResumeProjectionValidationError
+from .resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    integrity_diagnostic,
+)
+
+AuditScope = Callable[[Any, Any, ResumeScopePath], None]
+
+
+def projection_failure_result(error: Dict[str, Any]) -> Dict[str, Any]:
+    """Wrap a resume projection diagnostic as the caller's failed call-step result."""
+    return {"status": "failed", "exit_code": 2, "duration_ms": 0, "error": error}
+
+
+def scope_path_for(call_executor: Any, state: Dict[str, Any]) -> ResumeScopePath:
+    """Return the identity-only scope path of the scope ``call_executor`` runs in."""
+    frame_ids: list[str] = []
+    manager: Any = call_executor.executor.state_manager
+    while isinstance(manager, CallFrameStateManager) and len(frame_ids) < 1024:
+        frame_ids.append(manager.frame_id)
+        manager = manager.parent_manager
+    workflow_file = getattr(getattr(manager, "state", None), "workflow_file", None)
+    if not isinstance(workflow_file, str):
+        workflow_file = str(state.get("workflow_file") or "")
+    return ResumeScopePath(workflow_file, tuple(reversed(frame_ids)))
+
+
+def _lineage_failure_result(
+    call_executor: Any,
+    state: Dict[str, Any],
+    step_id: str,
+    members: list[tuple[str, Any]],
+    exc: CallFrameRetryLineageError,
+) -> Dict[str, Any]:
+    resumable = sum(1 for _frame_id, frame in members if frame.get("status") != "completed")
+    ambiguous = exc.reason == "ambiguous_resumable_call_frame"
+    return projection_failure_result(
+        integrity_diagnostic(
+            call_executor.executor.loaded_bundle,
+            state,
+            scope_path_for(call_executor, state),
+            exc.reason,
+            field="call_frames",
+            value=resumable if ambiguous else None,
+            count=resumable if ambiguous else None,
+            boundary_step_id=step_id,
+        )
+    )
+
+
+def select_resume_frame(
+    call_executor: Any,
+    *,
+    state: Dict[str, Any],
+    step_name: str,
+    step_id: str,
+    call_alias: Any,
+    callee: Any,
+    fresh_frame_id: str,
+) -> tuple[Optional[CallFrameRetryLineage], str, Optional[Dict[str, Any]]]:
+    """Pick the frame a resumed call occupies from its retry lineage, never by mapping order.
+
+    Returns ``(lineage, frame_id, failure_result)``.
+    """
+    call_frames = state.get("call_frames", {})
+
+    def invalid(frame_id: str, detail: str) -> Dict[str, Any]:
+        return call_executor.resume_state_invalid_result(
+            step_name=step_name, call_alias=call_alias, frame_id=frame_id, detail=detail
+        )
+
+    if not isinstance(call_frames, dict):
+        return None, fresh_frame_id, invalid(fresh_frame_id, "call_frames_not_mapping")
+
+    def occupied(frame_id: str) -> Optional[Dict[str, Any]]:
+        frame = call_frames.get(frame_id)
+        if frame is None:
+            return None
+        if not isinstance(frame, dict):
+            return invalid(frame_id, "call_frame_not_mapping")
+        if frame.get("status") == "completed":
+            return invalid(frame_id, "completed_call_frame_id_collision")
+        return invalid(frame_id, "call_frame_id_collision")
+
+    colliding = call_frames.get(fresh_frame_id)
+    if isinstance(colliding, dict) and colliding.get("status") == "completed":
+        return None, fresh_frame_id, occupied(fresh_frame_id)
+    members = [
+        (frame_id, frame)
+        for frame_id, frame in call_frames.items()
+        if isinstance(frame, dict) and frame.get("call_step_id") == step_id
+    ]
+    kind = WORKFLOW_LISP_FRONTEND_KIND if call_executor._is_workflow_lisp_target(callee) else None
+    try:
+        lineage = index_retry_lineage(step_id, members, frontend_kind=kind)
+    except CallFrameRetryLineageError as exc:
+        failure = _lineage_failure_result(call_executor, state, step_id, members, exc)
+        return None, fresh_frame_id, failure
+    if lineage.running_member is not None:
+        return lineage, lineage.running_member.frame_id, None
+    target = (
+        next_unused_retry_frame_id(lineage)
+        if lineage.base_frame_id is not None
+        else fresh_frame_id
+    )
+    return lineage, target, occupied(target)
+
+
+def _audit_frame_scopes(
+    audit: AuditScope,
+    bundle: Any,
+    frame_id: str,
+    frame: Dict[str, Any],
+    scope_path: ResumeScopePath,
+    *,
+    descend: bool,
+) -> None:
+    """Audit one frame's scope and, when ``descend``, every unfinished frame nested below it."""
+    frame_path = scope_path.child(frame_id)
+    child_state = frame.get("state")
+    if not isinstance(child_state, dict):
+        raise ResumeProjectionIntegrityError(
+            integrity_diagnostic(
+                bundle, {}, frame_path, "unsupported_shape", field=f"call_frames.{frame_id}.state"
+            )
+        )
+    audit(bundle, child_state, frame_path)
+    if not descend:
+        return
+    for nested_id, nested in child_state.get("call_frames", {}).items():
+        if nested.get("status") == "completed":
+            continue
+        nested_bundle = workflow_import_bundle(bundle, nested["import_alias"])
+        _audit_frame_scopes(audit, nested_bundle, nested_id, nested, frame_path, descend=True)
+
+
+def validate_resumed_callee(
+    call_executor: Any,
+    *,
+    audit: AuditScope,
+    state: Dict[str, Any],
+    step_name: str,
+    step_id: str,
+    call_alias: Any,
+    frame_id: str,
+    lineage: CallFrameRetryLineage,
+    existing_frame: Optional[Dict[str, Any]],
+) -> tuple[Any, Optional[Dict[str, Any]]]:
+    """Resolve the reached call's boundary and audit the scopes about to resume.
+
+    Returns ``(selected callee bundle, failure result)``; runs after the caller's
+    input/checksum validation and before any callee frame or state exists.
+    """
+    parent = call_executor.executor.loaded_bundle
+    projection = parent.projection
+    scope_path = scope_path_for(call_executor, state)
+
+    def failure(reason: str, **fields: Any) -> tuple[Any, Dict[str, Any]]:
+        fields.setdefault("boundary_step_id", step_id)
+        diagnostic = integrity_diagnostic(parent, state, scope_path, reason, **fields)
+        return None, projection_failure_result(diagnostic)
+
+    field = f"call_frames.{frame_id}.call_step_id"
+    try:
+        slots = projection.enumerate_resume_slots(state)
+    except ResumeProjectionValidationError as exc:
+        return failure(exc.reason, field=exc.field, value=exc.value)
+    resolved = projection.resolve_call_boundary(slots, step_id)
+    if resolved.candidate_count > 1:
+        return failure(
+            "ambiguous_call_boundary", field=field, value=step_id, count=resolved.candidate_count
+        )
+    boundary = resolved.boundary
+    if boundary is None:
+        known = projection.resolve_resume_step_id(slots, step_id)
+        reason = "out_of_scope_step_id" if known.candidate_count == 0 else "missing_call_boundary"
+        return failure(reason, field=field, value=step_id, count=0)
+    open_frames = [
+        *((member.frame_id, state["call_frames"][member.frame_id]) for member in lineage.failed_predecessors),
+        *(((frame_id, existing_frame),) if existing_frame is not None else ()),
+    ]
+    for open_id, open_frame in open_frames:
+        if open_frame.get("import_alias") != boundary.import_alias:
+            return failure(
+                "persisted_import_alias_mismatch",
+                field=f"call_frames.{open_id}.import_alias",
+                value=open_frame.get("import_alias"),
+                count=1,
+            )
+    callee = workflow_import_bundle(parent, boundary.import_alias)
+    if callee is None:
+        return failure(
+            "missing_imported_bundle",
+            field=f"imports.{boundary.import_alias}",
+            value=boundary.import_alias,
+            count=1,
+        )
+    for open_id, open_frame in open_frames:
+        is_running_member = open_frame is existing_frame
+        if not is_running_member:
+            checksum_error = call_executor.validate_resume_checksum(
+                step_name=step_name,
+                call_alias=call_alias,
+                frame_id=open_id,
+                imported_workflow=callee,
+                existing_frame=open_frame,
+            )
+            if checksum_error is not None:
+                return None, checksum_error
+        try:
+            # A failed predecessor is audited recursively; the running member audits only its
+            # own scope, and its nested calls audit theirs when reached.
+            _audit_frame_scopes(
+                audit, callee, open_id, open_frame, scope_path, descend=not is_running_member
+            )
+        except ResumeProjectionIntegrityError as exc:
+            return None, projection_failure_result(exc.error)
+    return callee, None

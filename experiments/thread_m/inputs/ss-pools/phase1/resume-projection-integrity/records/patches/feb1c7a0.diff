+++ b/tests/test_status_forensic_current_step.py
@@ -0,0 +1,152 @@
+"""A running current_step left by a failure envelope is forensic, not live."""
+
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.monitor.classifier import classify_run
+from orchestrator.monitor.messages import render_event_email
+from orchestrator.monitor.models import (
+    EmailConfig,
+    MonitorConfig,
+    MonitorEvent,
+    MonitorEventKind,
+    MonitorRun,
+    MonitorTiming,
+    MonitorWorkspace,
+)
+from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+
+
+NOW = datetime(2026, 4, 28, 12, 0, tzinfo=timezone.utc)
+ENVELOPE_TYPES = ["resume_projection_integrity_error", "workflow_checksum_mismatch"]
+
+
+def _bundle(tmp_path: Path):
+    path = tmp_path / "workflow.yaml"
+    path.write_text(
+        yaml.safe_dump(
+            {
+                "version": "1.3",
+                "name": "forensic",
+                "steps": [
+                    {"name": "Prep", "command": ["bash", "-lc", "echo prep"]},
+                    {"name": "Draft", "command": ["bash", "-lc", "echo draft"]},
+                ],
+            },
+            sort_keys=False,
+        ),
+        encoding="utf-8",
+    )
+    return WorkflowLoader(tmp_path).load_bundle(path)
+
+
+def _state(error_type: str, *, status: str = "failed") -> dict:
+    return {
+        "run_id": "run1",
+        "status": status,
+        "started_at": "2026-04-28T11:00:00+00:00",
+        "updated_at": "2026-04-28T11:59:30+00:00",
+        "workflow_file": "workflow.yaml",
+        "steps": {"Prep": {"status": "completed", "exit_code": 0}},
+        "current_step": {
+            "name": "Draft",
+            "status": "running",
+            "visit_count": 1,
+            "started_at": "2026-04-28T11:00:00+00:00",
+            "last_heartbeat_at": "2026-04-28T11:00:00+00:00",
+        },
+        "error": {"type": error_type, "message": "envelope"},
+    }
+
+
+def _snapshot(tmp_path: Path, state: dict) -> dict:
+    run_root = tmp_path / ".orchestrate" / "runs" / "run1"
+    (run_root / "logs").mkdir(parents=True, exist_ok=True)
+    return build_status_snapshot(_bundle(tmp_path), state, run_root, now=NOW)
+
+
+def _draft(snapshot: dict) -> dict:
+    return next(step for step in snapshot["steps"] if step["name"] == "Draft")
+
+
+@pytest.mark.parametrize("error_type", ENVELOPE_TYPES)
+def test_snapshot_reports_forensic_current_step_as_pending(tmp_path: Path, error_type: str):
+    draft = _draft(_snapshot(tmp_path, _state(error_type)))
+
+    assert (draft["status"], draft["summary"], draft["current_visit_count"]) == ("pending", "pending", None)
+
+
+@pytest.mark.parametrize("error_type", ENVELOPE_TYPES)
+def test_snapshot_counts_forensic_current_step_as_pending(tmp_path: Path, error_type: str):
+    progress = _snapshot(tmp_path, _state(error_type))["progress"]
+
+    assert (progress["running"], progress["pending"]) == (0, 1)
+
+
+def test_snapshot_reports_run_failed_with_envelope_error(tmp_path: Path):
+    run = _snapshot(tmp_path, _state("workflow_checksum_mismatch"))["run"]
+
+    assert (run["status"], run["error"]["type"]) == ("failed", "workflow_checksum_mismatch")
+
+
+def test_markdown_does_not_call_forensic_current_step_in_progress(tmp_path: Path):
+    markdown = render_status_markdown(_snapshot(tmp_path, _state("resume_projection_integrity_error")))
+
+    assert ("in progress" not in markdown, "### Draft (pending)" in markdown) == (True, True)
+
+
+def test_non_envelope_failure_keeps_existing_current_step_reporting(tmp_path: Path):
+    draft = _draft(_snapshot(tmp_path, _state("command_failed")))
+
+    assert draft["current_visit_count"] == 1
+
+
+def _monitor_run(tmp_path: Path, state: dict) -> MonitorRun:
+    run_root = tmp_path / ".orchestrate" / "runs" / "run1"
+    return MonitorRun(
+        workspace=MonitorWorkspace(name="repo", path=tmp_path),
+        run_dir_id="run1",
+        run_root=run_root,
+        state_path=run_root / "state.json",
+        state=state,
+    )
+
+
+def test_monitor_does_not_flag_forensic_heartbeat_as_stalled(tmp_path: Path):
+    state = _state("resume_projection_integrity_error", status="running")
+
+    event = classify_run(_monitor_run(tmp_path, state), now=NOW, stale_after_seconds=300)
+
+    assert event is None
+
+
+def test_monitor_reports_envelope_run_as_failed(tmp_path: Path):
+    event = classify_run(
+        _monitor_run(tmp_path, _state("workflow_checksum_mismatch")), now=NOW, stale_after_seconds=300
+    )
+
+    assert event.kind is MonitorEventKind.FAILED
+
+
+def test_monitor_email_omits_forensic_heartbeat(tmp_path: Path):
+    config = MonitorConfig(
+        workspaces=(MonitorWorkspace(name="repo", path=tmp_path),),
+        monitor=MonitorTiming(),
+        email=EmailConfig(
+            backend="smtp", from_address="m@example.com", to=("u@example.com",), smtp_host="smtp.example.com"
+        ),
+    )
+    event = MonitorEvent(
+        kind=MonitorEventKind.FAILED,
+        run=_monitor_run(tmp_path, _state("workflow_checksum_mismatch")),
+        reason="state_failed",
+        observed_at=NOW.isoformat(),
+    )
+
+    body = render_event_email(event, config).get_content()
+
+    assert "Heartbeat at: \n" in body

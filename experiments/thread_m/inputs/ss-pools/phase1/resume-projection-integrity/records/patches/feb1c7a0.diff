@@ -0,0 +1,309 @@
+"""Scope audit for checksum-compatible resume.
+
+``audit_scope`` checks every persisted identity of ONE scope (steps, current step,
+loop bookkeeping, call frames and their retry lineage) against the projection that
+owns that scope, and raises ``ResumeProjectionIntegrityError`` carrying the stable
+``resume_projection_integrity_error`` diagnostic.
+
+Type signature: ``audit_scope(bundle, state, scope_path) -> None``.
+Dependencies: only the loaded bundle (projection, imports, provenance) and the
+state mapping it is given.  It loads nothing, computes no checksum, reads no file
+and never mutates ``state``.  Child scopes are audited by the caller entering a
+frame with ``scope_path.child(frame_id)``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_call_lineage import (
+    KNOWN_FRAME_STATUSES,
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .state_projection import (
+    ResumeProjectionSlotIndex,
+    ResumeProjectionValidationError,
+    WorkflowStateProjection,
+    resolve_call_boundary_in,
+)
+
+__all__ = [
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "RetryFrameMember",
+    "audit_scope",
+    "integrity_diagnostic",
+    "is_resume_projection_error",
+    "index_retry_lineage",
+    "next_unused_retry_frame_id",
+]
+
+DIAGNOSTIC_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow down through entered call frames."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, (*self.call_frame_ids, frame_id))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [
+            {"kind": "root", "workflow_file": self.root_workflow_file},
+            *({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids),
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """Audit failure; ``error`` is the persisted ``resume_projection_integrity_error`` dict."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def is_resume_projection_error(error: Any) -> bool:
+    """Return True for the sticky, non-routable resume projection diagnostic."""
+    return isinstance(error, Mapping) and error.get("type") == DIAGNOSTIC_TYPE
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+class _Audit:
+    """One audit run over a single scope."""
+
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.projection: WorkflowStateProjection = bundle.projection
+        provenance = workflow_provenance(bundle)
+        path = getattr(provenance, "workflow_path", None)
+        checksum = state.get("workflow_checksum")
+        self.expected_owner = {
+            "workflow_file": str(path) if path is not None else scope_path.root_workflow_file,
+            "workflow_checksum": checksum if isinstance(checksum, str) else None,
+            "projection_scope": scope_path.projection_scope,
+        }
+
+    def diagnostic(
+        self,
+        reason: str,
+        *,
+        field: Optional[str] = None,
+        value: Any = None,
+        count: Optional[int] = None,
+        boundary_step_id: Any = None,
+    ) -> dict[str, Any]:
+        return {
+            "type": DIAGNOSTIC_TYPE,
+            "message": f"Resume projection integrity audit failed: {reason}",
+            "context": {
+                "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                "reason": reason,
+                "scope_path": self.scope_path.as_context(),
+                "field": field,
+                "offending_value": _scalar(value),
+                "expected_owner": dict(self.expected_owner),
+                "candidate_count": count,
+                "call_boundary_step_id": boundary_step_id
+                if isinstance(boundary_step_id, str)
+                else None,
+            },
+        }
+
+    def fail(self, reason: str, **fields: Any) -> NoReturn:
+        raise ResumeProjectionIntegrityError(self.diagnostic(reason, **fields))
+
+    def section(self, key: str) -> Mapping[str, Any]:
+        value = self.state.get(key)
+        if value is None:
+            return {}
+        if not isinstance(value, Mapping):
+            self.fail("unsupported_shape", field=key)
+        return value
+
+    def explicit_id(self, field: str, value: Any) -> str:
+        if not isinstance(value, str) or not value:
+            self.fail("unsupported_shape", field=field, value=value)
+        return value
+
+    def audit_steps(self, slots: ResumeProjectionSlotIndex, steps: Mapping[str, Any]) -> None:
+        loop_names = {
+            loop.frame_key for loop in self.projection.for_each_nodes.values()
+        }
+        for name, row in steps.items():
+            field = f"steps.{name}"
+            if not isinstance(row, Mapping):
+                if isinstance(row, list) and name in loop_names:
+                    continue
+                self.fail("unsupported_shape", field=field, value=row)
+            if "step_id" not in row:
+                continue
+            field = f"{field}.step_id"
+            step_id = self.explicit_id(field, row["step_id"])
+            if name not in slots.presentation_keys:
+                self.fail("unclaimed_explicit_step_row", field=field, value=step_id, count=0)
+            found = self.projection.resolve_resume_step_id(slots, step_id, name)
+            if found.slot is not None:
+                continue
+            if found.candidate_count == 0:
+                self.fail("unknown_explicit_step_id", field=field, value=step_id, count=0)
+            self.fail(
+                "presentation_slot_mismatch",
+                field=field,
+                value=step_id,
+                count=found.candidate_count,
+            )
+
+    def audit_current_step(self, slots: ResumeProjectionSlotIndex) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            self.fail("unsupported_shape", field="current_step")
+        field = "current_step.step_id"
+        if "step_id" not in current:
+            self.fail("missing_required_identity", field=field)
+        step_id = self.explicit_id(field, current["step_id"])
+        name = current.get("name")
+        found = self.projection.resolve_resume_step_id(
+            slots, step_id, name if isinstance(name, str) else None
+        )
+        if found.slot is not None:
+            return
+        if found.candidate_count == 0:
+            self.fail("out_of_scope_step_id", field=field, value=step_id, count=0)
+        self.fail("presentation_slot_mismatch", field=field, value=step_id, count=found.candidate_count)
+
+    def audit_frame_header(self, slots: ResumeProjectionSlotIndex, frame_id: str, frame: Any) -> str:
+        """Validate one frame's caller, alias, boundary and status; return its call step id."""
+        field = f"call_frames.{frame_id}"
+        if not isinstance(frame, Mapping):
+            self.fail("unsupported_shape", field=field, value=frame)
+        if frame.get("status") not in KNOWN_FRAME_STATUSES:
+            self.fail("unsupported_shape", field=f"{field}.status", value=frame.get("status"))
+        field = f"{field}.call_step_id"
+        if "call_step_id" not in frame:
+            self.fail("missing_required_identity", field=field)
+        call_step_id = self.explicit_id(field, frame["call_step_id"])
+        resolved = resolve_call_boundary_in(slots, call_step_id)
+        if resolved.candidate_count > 1:
+            self.fail(
+                "ambiguous_call_boundary",
+                field=field,
+                value=call_step_id,
+                count=resolved.candidate_count,
+                boundary_step_id=call_step_id,
+            )
+        boundary = resolved.boundary
+        if boundary is None:
+            known = self.projection.resolve_resume_step_id(slots, call_step_id)
+            self.fail(
+                "out_of_scope_step_id" if known.candidate_count == 0 else "missing_call_boundary",
+                field=field,
+                value=call_step_id,
+                count=0,
+                boundary_step_id=call_step_id,
+            )
+        alias_field = f"call_frames.{frame_id}.import_alias"
+        alias = frame.get("import_alias")
+        if not isinstance(alias, str) or alias != boundary.import_alias:
+            self.fail(
+                "persisted_import_alias_mismatch",
+                field=alias_field,
+                value=alias,
+                count=1,
+                boundary_step_id=call_step_id,
+            )
+        if workflow_import_bundle(self.bundle, boundary.import_alias) is None:
+            self.fail(
+                "missing_imported_bundle",
+                field=f"imports.{boundary.import_alias}",
+                value=boundary.import_alias,
+                count=1,
+                boundary_step_id=call_step_id,
+            )
+        return call_step_id
+
+    def audit_call_frames(self, slots: ResumeProjectionSlotIndex, frames: Mapping[str, Any]) -> None:
+        by_boundary: dict[str, list[tuple[str, Any]]] = {}
+        for frame_id, frame in frames.items():
+            call_step_id = self.audit_frame_header(slots, frame_id, frame)
+            by_boundary.setdefault(call_step_id, []).append((frame_id, frame))
+        for call_step_id, items in by_boundary.items():
+            alias = items[0][1]["import_alias"]
+            callee = workflow_import_bundle(self.bundle, alias)
+            kind = getattr(workflow_provenance(callee), "frontend_kind", None)
+            try:
+                index_retry_lineage(call_step_id, items, frontend_kind=kind)
+            except CallFrameRetryLineageError as exc:
+                resumable = sum(1 for _fid, frame in items if frame["status"] != "completed")
+                ambiguous = exc.reason == "ambiguous_resumable_call_frame"
+                self.fail(
+                    exc.reason,
+                    field="call_frames",
+                    value=resumable if ambiguous else None,
+                    count=resumable if ambiguous else None,
+                    boundary_step_id=call_step_id,
+                )
+
+    def run(self) -> None:
+        steps = self.section("steps")
+        frames = self.section("call_frames")
+        try:
+            slots = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            self.fail(exc.reason, field=exc.field, value=exc.value)
+        self.audit_steps(slots, steps)
+        self.audit_current_step(slots)
+        self.audit_call_frames(slots, frames)
+
+
+def integrity_diagnostic(
+    bundle: Any,
+    state: Mapping[str, Any],
+    scope_path: ResumeScopePath,
+    reason: str,
+    **fields: Any,
+) -> dict[str, Any]:
+    """Build the stable diagnostic dict for ``reason`` without raising."""
+    return _Audit(bundle, state, scope_path).diagnostic(reason, **fields)
+
+
+def audit_scope(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit one scope's persisted identities against ``bundle``; raise on any violation."""
+    if not isinstance(getattr(bundle, "projection", None), WorkflowStateProjection):
+        return  # test doubles without a typed projection own no scope to audit
+    mapping = state.to_dict() if hasattr(state, "to_dict") else state
+    if not isinstance(mapping, Mapping):
+        _Audit(bundle, {}, scope_path).fail("unsupported_shape")
+    _Audit(bundle, mapping, scope_path).run()

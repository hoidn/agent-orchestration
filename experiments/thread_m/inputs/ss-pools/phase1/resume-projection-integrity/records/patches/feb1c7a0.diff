index 7bc0259..3cd723f 100644
--- a/orchestrator/runtime_observability.py
+++ b/orchestrator/runtime_observability.py
@@ -19,6 +19,30 @@ RuntimeState = MutableMapping[str, Any] | Any
 ProcessLiveness = Callable[[Mapping[str, Any]], bool | None]
 
 
+FORENSIC_CURRENT_STEP_ERROR_TYPES = frozenset({
+    "resume_projection_integrity_error",
+    "workflow_checksum_mismatch",
+})
+
+
+def is_forensic_current_step(state: Any) -> bool:
+    """Return True when a `running` current_step was left untouched by a failure envelope.
+
+    Such a step (root error type in FORENSIC_CURRENT_STEP_ERROR_TYPES) is forensic, not live:
+    status reports show it as pending and heartbeat/stall interpretation ignores it.
+    """
+    if not isinstance(state, Mapping):
+        return False
+    current_step = state.get("current_step")
+    error = state.get("error")
+    return (
+        isinstance(current_step, Mapping)
+        and current_step.get("status") == "running"
+        and isinstance(error, Mapping)
+        and error.get("type") in FORENSIC_CURRENT_STEP_ERROR_TYPES
+    )
+
+
 def _now() -> datetime:
     return datetime.now(timezone.utc)
 

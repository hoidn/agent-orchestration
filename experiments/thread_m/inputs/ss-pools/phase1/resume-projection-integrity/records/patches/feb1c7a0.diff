index 0000000..4a1cee0
--- /dev/null
+++ b/tests/test_resume_projection_audit.py
@@ -0,0 +1,609 @@
+"""Behavioural coverage for checksum-compatible resume projection auditing."""
+
+from __future__ import annotations
+
+import copy
+import dataclasses
+import json
+import re
+from pathlib import Path
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.resume_projection_integrity import (
+    CallFrameRetryLineageError,
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from orchestrator.workflow.state_projection import (
+    CallBoundaryProjection,
+    ResumeProjectionValidationError,
+)
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.test_workflow_state_projection import (
+    _write_projection_call_workflow,
+    _write_projection_workflow,
+)
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+ROOT = ResumeScopePath.root("workflow.yaml")
+
+
+def _audit(bundle, state, path=ROOT):
+    try:
+        audit_scope(bundle, state, path)
+    except ResumeProjectionIntegrityError as exc:
+        return exc.error
+    return None
+
+
+def _run_to_completion(tmp_path: Path, writer):
+    workflow_path = writer(tmp_path)
+    bundle = WorkflowLoader(tmp_path).load_bundle(workflow_path)
+    manager = StateManager(tmp_path, run_id="audit-run")
+    manager.initialize(workflow_path.name, context=bundle_context_dict(bundle))
+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+    return bundle, json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+@pytest.fixture
+def projection_run(tmp_path):
+    return _run_to_completion(tmp_path, _write_projection_workflow)
+
+
+@pytest.fixture
+def call_graph_run(tmp_path):
+    return _run_to_completion(tmp_path, _write_projection_integrity_call_graph)
+
+
+def _reason(error):
+    return error["context"]["reason"] if error else None
+
+
+def test_genuine_completed_states_audit_cleanly_without_mutation(projection_run, call_graph_run):
+    for bundle, state in (projection_run, call_graph_run):
+        before = copy.deepcopy(state)
+        assert _audit(bundle, state) is None
+        assert state == before
+
+
+def test_loop_contained_calls_audit_cleanly_down_to_the_callee(tmp_path):
+    bundle, state = _run_to_completion(tmp_path, _write_projection_call_workflow)
+    assert len(state["call_frames"]) == 2
+    assert _audit(bundle, state) is None
+    for frame_id, frame in state["call_frames"].items():
+        callee = bundle.imports[frame["import_alias"]]
+        assert _audit(callee, frame["state"], ROOT.child(frame_id)) is None
+
+
+def test_loop_contained_call_boundary_ids_must_name_an_iteration_that_can_exist(tmp_path):
+    bundle, state = _run_to_completion(tmp_path, _write_projection_call_workflow)
+    frame_id = "root.review_loop#0.iteration_body.run_review_loop::visit::1"
+    state["call_frames"][frame_id]["call_step_id"] = "root.review_loop#2.iteration_body.run_review_loop"
+    assert _audit(bundle, state) is None  # iteration 2 is inside the declared maximum of 3
+    state["call_frames"][frame_id]["call_step_id"] = "root.review_loop#3.iteration_body.run_review_loop"
+    context = _audit(bundle, state)["context"]
+    assert (context["reason"], context["candidate_count"]) == ("out_of_scope_step_id", 0)
+    state["call_frames"][frame_id]["call_step_id"] = "root.review_loop.iteration_body.run_review_loop"
+    assert _reason(_audit(bundle, state)) == "out_of_scope_step_id"
+
+
+def test_diagnostic_shape_is_stable_and_identity_only(projection_run):
+    bundle, state = projection_run
+    state["steps"]["SetReady"]["step_id"] = "root.stale"
+    error = _audit(bundle, state)
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == "Resume projection integrity audit failed: unknown_explicit_step_id"
+    context = error["context"]
+    assert set(context) == {
+        "diagnostic_schema",
+        "reason",
+        "scope_path",
+        "field",
+        "offending_value",
+        "expected_owner",
+        "candidate_count",
+        "call_boundary_step_id",
+    }
+    assert context["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    assert context["scope_path"] == [{"kind": "root", "workflow_file": "workflow.yaml"}]
+    assert context["field"] == "steps.SetReady.step_id"
+    assert context["offending_value"] == "root.stale"
+    assert context["candidate_count"] == 0
+    assert set(context["expected_owner"]) == {"workflow_file", "workflow_checksum", "projection_scope"}
+    assert context["expected_owner"]["projection_scope"] == "root"
+    assert context["expected_owner"]["workflow_checksum"] == state["workflow_checksum"]
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason", "field", "value", "count"),
+    [
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id="root.gone"),
+            "unknown_explicit_step_id",
+            "steps.SetReady.step_id",
+            "root.gone",
+            0,
+        ),
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id="root.route_ready"),
+            "presentation_slot_mismatch",
+            "steps.SetReady.step_id",
+            "root.route_ready",
+            1,
+        ),
+        (
+            lambda s: s["steps"].__setitem__("Renamed", {"status": "completed", "step_id": "root.set_ready"}),
+            "unclaimed_explicit_step_row",
+            "steps.Renamed.step_id",
+            "root.set_ready",
+            0,
+        ),
+        (
+            lambda s: s.__setitem__("current_step", {"name": "SetReady", "status": "running"}),
+            "missing_required_identity",
+            "current_step.step_id",
+            None,
+            None,
+        ),
+        (
+            lambda s: s.__setitem__(
+                "current_step", {"name": "SetReady", "status": "running", "step_id": "root.gone"}
+            ),
+            "out_of_scope_step_id",
+            "current_step.step_id",
+            "root.gone",
+            0,
+        ),
+        (
+            lambda s: s.__setitem__(
+                "current_step", {"name": "SetReady", "status": "running", "step_id": "root.route_ready"}
+            ),
+            "presentation_slot_mismatch",
+            "current_step.step_id",
+            "root.route_ready",
+            1,
+        ),
+        (
+            lambda s: s.__setitem__("steps", []),
+            "unsupported_shape",
+            "steps",
+            None,
+            None,
+        ),
+        (
+            lambda s: s["steps"].__setitem__("SetReady", "oops"),
+            "unsupported_shape",
+            "steps.SetReady",
+            "oops",
+            None,
+        ),
+        (
+            lambda s: s["steps"]["SetReady"].update(step_id=["secret", "list"]),
+            "unsupported_shape",
+            "steps.SetReady.step_id",
+            None,
+            None,
+        ),
+        (
+            lambda s: s.__setitem__("call_frames", "nope"),
+            "unsupported_shape",
+            "call_frames",
+            None,
+            None,
+        ),
+        (
+            lambda s: s.__setitem__("call_frames", {"f": 3}),
+            "unsupported_shape",
+            "call_frames.f",
+            3,
+            None,
+        ),
+    ],
+)
+def test_root_scope_reasons(projection_run, mutate, reason, field, value, count):
+    bundle, state = projection_run
+    mutate(state)

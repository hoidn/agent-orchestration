+def test_projection_error_is_not_routable_and_not_wrapped(tmp_path: Path) -> None:
+    from orchestrator.workflow.executor import WorkflowExecutor
+    from tests.test_subworkflow_calls import _write_yaml
+
+    graph = _write_projection_integrity_call_graph(tmp_path)
+    payload = json.loads(json.dumps(__import__("yaml").safe_load(graph.read_text())))
+    payload["steps"][0]["on"] = {"failure": {"goto": "Recover"}}
+    payload["steps"].append(
+        {"name": "Recover", "id": "recover", "command": ["bash", "-lc", "touch recovered.txt"]}
+    )
+    payload["finally"] = {
+        "id": "cleanup",
+        "steps": [{"name": "Cleanup", "id": "cleanup_step", "command": ["bash", "-lc", "test -f cleanup-ok.txt"]}],
+    }
+    _write_yaml(graph, payload)
+    bundle = WorkflowLoader(tmp_path).load_bundle(graph)
+    manager = _seed_run(tmp_path, bundle)
+    (tmp_path / "cleanup-ok.txt").write_text("ok")
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    _corrupt_leaf_current_step(manager)
+    (tmp_path / "cleanup-ok.txt").unlink()
+    (tmp_path / "recovered.txt").unlink()
+
+    for on_error in ("stop", "continue"):
+        resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, on_error=on_error)
+        assert resumed["status"] == "failed"
+        error = resumed["error"]
+        assert error["type"] == "resume_projection_integrity_error"
+        assert error["context"]["reason"] == "out_of_scope_step_id"
+        assert resumed["steps"]["InvokeMiddle"]["error"] == error
+        assert not (tmp_path / "recovered.txt").exists()
+        finalization = resumed["finalization"]
+        assert finalization["status"] == "failed"
+        assert finalization["failure"]["step"] == "finally.Cleanup"
+        assert finalization["failure"]["step_id"].endswith("cleanup_step")
+        assert finalization["failure"]["error"] is None
+        _corrupt_leaf_current_step(manager)
+

+
+    persisted = manager.load()
+    frame_id = "root.process_items#1.run_review_loop_from_for_each::visit::1"
+    template = persisted.call_frames["root.process_items#0.run_review_loop_from_for_each::visit::1"]
+    frame = copy.deepcopy(template)
+    frame.update(call_step_id="root.process_items#1.run_review_loop_from_for_each", status="running")
+    frame["state"]["current_step"] = {"name": "Gone", "step_id": "root.gone", "status": "running"}
+    persisted.call_frames[frame_id] = frame
+    for name in [n for n in persisted.steps if n.startswith("ProcessItems[1]") or n.startswith("ProcessItems[2]")]:
+        del persisted.steps[name]
+    persisted.steps["ProcessItems"] = persisted.steps["ProcessItems"][:1]
+    persisted.for_each["ProcessItems"].completed_indices = [0]
+    persisted.for_each["ProcessItems"].current_index = 1
+    persisted.status = "failed"
+    manager._write_state()
+
+    resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True, on_error="continue")
+    after = manager.load().to_dict()

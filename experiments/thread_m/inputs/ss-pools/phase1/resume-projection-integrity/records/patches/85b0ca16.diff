+def step_granular_default_resume():
+    """Patch resume to the step-granular default-resume mode.
+
+    Bundles compiled directly through the Workflow Lisp compiler are typed
+    `frontend_kind == "workflow_lisp"`, so default resume would otherwise demand
+    lexical checkpoint evidence that single-step resume fixtures do not seed.
+    """
+    from unittest.mock import patch
+
+    from orchestrator.workflow.executor import WorkflowExecutor
+    from orchestrator.workflow_lisp.lexical_checkpoint_default_resume import (
+        MODE_INELIGIBLE_STEP_GRANULAR,
+    )
+
+    return patch.object(
+        WorkflowExecutor,
+        "_determine_resume_default_resume_decision",
+        lambda _executor, _state: {
+            "mode": MODE_INELIGIBLE_STEP_GRANULAR,
+            "restore_decision": None,
+            "restore_candidate": None,
+            "diagnostics": [],
+        },
+    )

+def test_ambiguous_call_boundary_owner_is_reported(graph_bundle) -> None:
+    projection_type = type(graph_bundle.projection)
+    real = projection_type.resolve_call_boundary
+
+    def two_owners(self, slot_index, call_step_id):
+        resolution = real(self, slot_index, call_step_id)
+        return type(resolution)(boundary=None, candidate_count=2)
+
+    state = {"steps": {}, "call_frames": {"f1": _frame("root.invoke_middle", "middle")}}
+    with patch.object(projection_type, "resolve_call_boundary", two_owners):
+        context = _context(_audit_error(graph_bundle, state))
+
+    assert (context["reason"], context["field"], context["offending_value"], context["candidate_count"]) == (
+        "ambiguous_call_boundary",
+        "call_frames.f1.call_step_id",
+        "root.invoke_middle",
+        2,
+    )
+

+    assert resumed["status"] == "failed"
+    assert after["error"]["type"] == "resume_projection_integrity_error"
+    assert after["error"]["context"]["scope_path"][-1] == {"kind": "call_frame", "frame_id": frame_id}
+    assert after["for_each"]["ProcessItems"]["completed_indices"] == [0]
+    assert after["for_each"]["ProcessItems"]["current_index"] == 1
+    assert not any(name.startswith("ProcessItems[2]") for name in after["steps"])
+    assert after["call_frames"][frame_id]["state"]["current_step"]["step_id"] == "root.gone"

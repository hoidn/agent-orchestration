--- /dev/null
+++ b/orchestrator/yaml_import_aliases.py
@@ -0,0 +1,55 @@
+"""Detect repeated `imports` sections/aliases that YAML mapping construction silently collapses.
+
+Operates on the composed node graph (``yaml.compose``) so source marks survive and
+``<<`` merge keys can be expanded explicitly instead of being resolved last-wins.
+"""
+
+from typing import Dict, Iterator, List, Tuple
+
+import yaml
+
+MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _effective_pairs(mapping: yaml.MappingNode) -> Iterator[Tuple[yaml.Node, yaml.Node]]:
+    """Yield every key/value pair of a mapping, expanding `<<` merge sources in place."""
+    for key, value in mapping.value:
+        if key.tag != MERGE_TAG:
+            yield key, value
+            continue
+        sources = value.value if isinstance(value, yaml.SequenceNode) else [value]
+        for source in sources:
+            if isinstance(source, yaml.MappingNode):
+                yield from _effective_pairs(source)
+
+
+def _position(node: yaml.Node) -> str:
+    return f"line {node.start_mark.line + 1}, column {node.start_mark.column + 1}"
+
+
+def duplicate_import_errors(root: yaml.Node) -> List[str]:
+    """Return messages for repeated import aliases, else for repeated top-level `imports` sections."""
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections: List[Tuple[yaml.Node, yaml.Node]] = [
+        (key, value)
+        for key, value in _effective_pairs(root)
+        if isinstance(key, yaml.ScalarNode) and key.value == "imports"
+    ]
+    aliases: Dict[str, List[yaml.Node]] = {}
+    for _, value in sections:
+        if isinstance(value, yaml.MappingNode):
+            for alias_key, _ in _effective_pairs(value):
+                if isinstance(alias_key, yaml.ScalarNode):
+                    aliases.setdefault(alias_key.value, []).append(alias_key)
+
+    errors = [
+        f"imports.{alias}: duplicate import alias at " + "; ".join(_position(n) for n in nodes)
+        for alias, nodes in aliases.items()
+        if len(nodes) > 1
+    ]
+    if not errors and len(sections) > 1:
+        errors.append(
+            "imports: duplicate top-level mapping at " + "; ".join(_position(key) for key, _ in sections)
+        )
+    return errors

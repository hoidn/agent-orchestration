+def test_enumerate_resume_slots_resolves_only_projection_owned_candidates(root_bundle) -> None:
+    projection = root_bundle.projection
+    state = {
+        "steps": {"Ghost": {"status": "completed", "step_id": ["unhashable"]}},
+        "for_each": {"ProcessItems": {"items": ["a", "b"], "completed_indices": [0], "current_index": 1}},
+        "repeat_until": {
+            "ReviewLoop": {
+                "current_iteration": 1,
+                "completed_iterations": [0],
+                "condition_evaluated_for_iteration": None,
+                "last_condition_result": None,
+            }
+        },
+    }
+    before = copy.deepcopy(state)
+
+    index = projection.enumerate_resume_slots(state)
+
+    assert state == before
+    assert index.unclaimed_explicit_rows == (("Ghost", ["unhashable"]),)
+    assert index.unclaimed_explicit_rows[0][1] is not state["steps"]["Ghost"]["step_id"]
+    qualified = projection.resolve_resume_step_id(
+        index, "root.process_items#1.increment_count", "ProcessItems[1].IncrementCount"
+    )
+    assert qualified.slot.iteration_index == 1
+    assert (qualified.candidate_count, qualified.exact_identity_candidate_count) == (1, 1)
+    mismatch = projection.resolve_resume_step_id(index, "root.process_items#1.increment_count", "ProcessItems[0].IncrementCount")
+    assert (mismatch.slot, mismatch.candidate_count, mismatch.exact_identity_candidate_count) == (None, 1, 0)
+    assert projection.resolve_resume_step_id(index, "root.process_items#2.increment_count").candidate_count == 0
+    assert projection.resolve_resume_step_id(index, ["x"]).candidate_count == 0
+    cleanup = projection.resolve_resume_step_id(index, "root.finally.cleanup.write_cleanup_marker")
+    assert cleanup.slot.region.value == "finalization"
+    assert "root.review_loop#1.iteration_body.write_decision" in index.candidates_by_step_id
+    assert "root.review_loop#2.iteration_body.write_decision" not in index.candidates_by_step_id

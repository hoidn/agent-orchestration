+"""Authoritative root checksum recheck for a structurally root resumed executor.
+
+Depends on: the persisted root state mapping and a state manager exposing
+`calculate_checksum` and `workspace`. Behavior: returns the checksum-mismatch context
+(`reason` is one of `workflow_modified`, `missing_recorded_checksum`,
+`missing_workflow_path`, `workflow_unavailable`) or None when the checksum still
+matches. Reads the workflow file only through `StateManager.calculate_checksum`.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+
+def root_checksum_mismatch(state_manager: Any, state: Mapping[str, Any]) -> Optional[dict[str, Any]]:
+    """Return the `record_workflow_checksum_mismatch` kwargs, or None when compatible."""
+    workflow_file = state.get("workflow_file")
+    persisted = state.get("workflow_checksum")
+    context: dict[str, Any] = {
+        "workflow_file": workflow_file if isinstance(workflow_file, str) else None,
+        "persisted_checksum": persisted if isinstance(persisted, str) else None,
+        "current_checksum": None,
+    }
+    if not isinstance(persisted, str) or not persisted.startswith("sha256:"):
+        return {**context, "reason": "missing_recorded_checksum"}
+    if not isinstance(workflow_file, str) or not workflow_file:
+        return {**context, "reason": "missing_workflow_path"}
+    try:
+        current = state_manager.calculate_checksum(Path(state_manager.workspace) / workflow_file)
+    except OSError:
+        return {**context, "reason": "workflow_unavailable"}
+    if current != persisted:
+        return {**context, "current_checksum": current, "reason": "workflow_modified"}
+    return None

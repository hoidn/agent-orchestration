+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.resume_projection_integrity import (
+    CallFrameRetryLineageError,
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from orchestrator.workflow.state_projection import (
+    CallBoundaryProjection,
+    ResumeProjectionValidationError,
+)
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.test_workflow_state_projection import (
+    _write_projection_call_workflow,
+    _write_projection_workflow,
+)
+
+ROOT_PATH = ResumeScopePath.root("workflow.yaml")
+
+
+@pytest.fixture
+def root_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_workflow(tmp_path))
+
+
+@pytest.fixture
+def call_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_call_workflow(tmp_path))
+
+
+@pytest.fixture
+def graph_bundle(tmp_path: Path):
+    return WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+
+
+def _row(name: str, step_id: str | None, status: str = "completed") -> dict:
+    row = {"status": status, "name": name}
+    if step_id is not None:
+        row["step_id"] = step_id
+    return row
+
+
+def _audit_error(bundle, state, path: ResumeScopePath = ROOT_PATH) -> dict:
+    with pytest.raises(ResumeProjectionIntegrityError) as excinfo:
+        audit_scope(bundle, state, path)
+    assert isinstance(excinfo.value, ValueError)
+    return excinfo.value.error
+
+
+def _context(error: dict) -> dict:
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == f"Resume projection integrity audit failed: {error['context']['reason']}"
+    assert set(error["context"]) == {
+        "diagnostic_schema",
+        "reason",
+        "scope_path",
+        "field",
+        "offending_value",
+        "expected_owner",
+        "candidate_count",
+        "call_boundary_step_id",
+    }
+    assert error["context"]["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    return error["context"]
+
+
+# --- ResumeScopePath -------------------------------------------------------------------
+
+
+def test_scope_path_snapshots_frames_and_renders_identity_only_context() -> None:
+    frames = ["frame-a"]
+    path = ResumeScopePath("wf.yaml", frames)
+    frames.append("mutated")
+
+    assert path.call_frame_ids == ("frame-a",)
+    assert path.projection_scope == "call_frame"
+    assert ResumeScopePath.root("wf.yaml").projection_scope == "root"
+    assert path.child("frame-b").call_frame_ids == ("frame-a", "frame-b")
+    assert path.child("frame-b").as_context() == [
+        {"kind": "root", "workflow_file": "wf.yaml"},
+        {"kind": "call_frame", "frame_id": "frame-a"},
+        {"kind": "call_frame", "frame_id": "frame-b"},
+    ]
+
+
+# --- retry lineage ---------------------------------------------------------------------
+
+
+def _frames(*specs: tuple[str, str]) -> list[tuple[str, dict]]:
+    return [
+        (frame_id, {"status": status, "call_step_id": "root.call", "import_alias": "child"})
+        for frame_id, status in specs
+    ]
+
+
+def test_non_workflow_lisp_boundary_has_one_resumable_frame_and_unlimited_history() -> None:
+    lineage = index_retry_lineage(
+        "root.call",
+        _frames(("a", "completed"), ("b", "completed"), ("c", "failed")),
+        frontend_kind=None,
+    )
+    assert [m.frame_id for m in lineage.completed_members] == ["a", "b"]
+    assert lineage.running_member.frame_id == "c"
+    assert lineage.failed_predecessors == ()
+
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage("root.call", _frames(("c", "failed"), ("d", "running")), frontend_kind=None)
+    assert excinfo.value.reason == "ambiguous_resumable_call_frame"
+
+
+def test_workflow_lisp_lineage_orders_failed_predecessors_independent_of_mapping_order() -> None:
+    forward = _frames(("B", "failed"), ("B::retry::1", "failed"), ("B::retry::2", "running"))
+    for items in (forward, list(reversed(forward))):
+        lineage = index_retry_lineage("root.call", items, frontend_kind="workflow_lisp")
+        assert lineage.base_frame_id == "B"
+        assert [(m.frame_id, m.ordinal) for m in lineage.failed_predecessors] == [("B", 0), ("B::retry::1", 1)]
+        assert (lineage.running_member.frame_id, lineage.running_member.ordinal) == ("B::retry::2", 2)
+
+
+def test_next_unused_retry_frame_id_is_lowest_unused_positive_ordinal_and_idempotent() -> None:
+    lineage = index_retry_lineage(
+        "root.call",
+        _frames(("B", "failed"), ("B::retry::2", "failed"), ("B::retry::1", "completed")),
+        frontend_kind="workflow_lisp",
+    )
+    assert next_unused_retry_frame_id(lineage) == "B::retry::3"
+    assert next_unused_retry_frame_id(lineage) == "B::retry::3"
+    gap = index_retry_lineage("root.call", _frames(("B", "failed"), ("B::retry::2", "failed")), frontend_kind="workflow_lisp")
+    assert next_unused_retry_frame_id(gap) == "B::retry::1"
+
+
+@pytest.mark.parametrize(
+    ("frame_ids", "statuses", "reason"),
+    [
+        (["B", "C"], ["failed", "failed"], "ambiguous_resumable_call_frame"),
+        (["B", "B::retry::1"], ["running", "running"], "ambiguous_resumable_call_frame"),
+        (["B", "B::retry::x"], ["failed", "failed"], "unsupported_shape"),
+        (["B", "B::retry::"], ["failed", "failed"], "unsupported_shape"),
+        (["B", "B::retry::0"], ["failed", "failed"], "unsupported_shape"),
+        (["B", "B::retry::1::retry::1"], ["failed", "failed"], "unsupported_shape"),
+        (["B"], ["paused"], "unsupported_shape"),
+    ],
+)
+def test_workflow_lisp_lineage_rejects_invalid_members(frame_ids, statuses, reason: str) -> None:
+    items = _frames(*zip(frame_ids, statuses))
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage("root.call", items, frontend_kind="workflow_lisp")
+    assert excinfo.value.reason == reason
+
+
+def test_workflow_lisp_lineage_rejects_a_duplicate_ordinal() -> None:
+    items = _frames(("B::retry::1", "failed"), ("B::retry::1", "running"))
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage("root.call", items, frontend_kind="workflow_lisp")
+    assert excinfo.value.reason == "ambiguous_resumable_call_frame"
+
+
+def test_lineage_rejects_foreign_caller_and_alias_mismatch() -> None:
+    foreign = [("B", {"status": "failed", "call_step_id": "root.other", "import_alias": "child"})]
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage("root.call", foreign, frontend_kind=None)
+    assert excinfo.value.reason == "missing_call_boundary"
+
+    mixed = _frames(("B", "failed"), ("B::retry::1", "failed"))
+    mixed[1][1]["import_alias"] = "other"
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        index_retry_lineage("root.call", mixed, frontend_kind="workflow_lisp")
+    assert excinfo.value.reason == "persisted_import_alias_mismatch"

+def _seed_run(tmp_path: Path, bundle, workflow_file: str = "workflow.yaml") -> StateManager:
+    manager = StateManager(tmp_path, run_id="audit-run")
+    manager.initialize(workflow_file)
+    return manager
+
+
+def _persist(manager: StateManager, **changes) -> dict:
+    state = manager.load()
+    for key, value in changes.items():
+        setattr(state, key, value)
+    manager._write_state()
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def _envelope_delta(before: dict, after: dict) -> set[str]:
+    return {key for key in set(before) | set(after) if before.get(key) != after.get(key)}
+
+
+def test_executor_checksum_recheck_records_only_the_envelope(tmp_path: Path, root_bundle) -> None:
+    from orchestrator.workflow.executor import WorkflowExecutor
+
+    manager = _seed_run(tmp_path, root_bundle)
+    _persist(manager, status="failed")
+    raw = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    raw["unknown_root_field"] = {"keep": True}
+    manager.state_file.write_text(json.dumps(raw), encoding="utf-8")
+    before = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    (tmp_path / "workflow.yaml").write_text("# edited\n" + (tmp_path / "workflow.yaml").read_text(encoding="utf-8"))
+    current = manager.calculate_checksum(tmp_path / "workflow.yaml")
+
+    with patch("orchestrator.workflow.executor.audit_scope") as audit, patch.object(
+        WorkflowExecutor, "_execute_prologue", side_effect=AssertionError("prologue reached")
+    ):
+        result = WorkflowExecutor(root_bundle, tmp_path, manager).execute(resume=True)
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    audit.assert_not_called()
+    assert result["status"] == "failed"
+    assert after["error"] == {
+        "type": "workflow_checksum_mismatch",
+        "message": "Workflow has been modified since the run started",
+        "context": {
+            "workflow_file": "workflow.yaml",
+            "persisted_checksum": before["workflow_checksum"],
+            "current_checksum": current,
+            "reason": "workflow_modified",
+        },
+    }
+    assert _envelope_delta(before, after) <= {"status", "error", "updated_at"}
+    assert after["unknown_root_field"] == {"keep": True}
+

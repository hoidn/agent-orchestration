diff --git a/orchestrator/workflow/call_resume_plan.py b/orchestrator/workflow/call_resume_plan.py
new file mode 100644
index 0000000..9c2b0c5
--- /dev/null
+++ b/orchestrator/workflow/call_resume_plan.py
@@ -0,0 +1,110 @@
+"""Frame selection for a reached call during resume.
+
+Depends on: the executor's projection and loaded bundle, the parent state mapping, and
+`resume_projection_integrity` (read-only). Behavior: resolves the persisted caller
+identity to exactly one current call boundary (one `resolve_call_boundary` call), lets
+that boundary's current alias select the callee bundle, and derives the frame to
+resume (or the fresh frame id to allocate) from the boundary's retry lineage, never
+from mapping order. Integrity failures are deferred in `failure` so the caller can run
+its ordinary input validations first. Mutates nothing.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping, Optional
+
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_call_lineage import (
+    WORKFLOW_LISP_FRONTEND_KIND,
+    CallFrameRetryLineage,
+    next_unused_retry_frame_id,
+)
+from .resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_call_boundary_frames,
+    integrity_error_payload,
+)
+from .state_projection import ResumeProjectionValidationError
+
+
+@dataclass(frozen=True)
+class ResumeCallPlan:
+    """Where a reached call resumes: the callee bundle, frame id and failed predecessors."""
+
+    bundle: Any
+    import_alias: Optional[str]
+    frame_id: str
+    existing_frame: Optional[dict]
+    predecessors: tuple[tuple[str, dict], ...] = ()
+    failure: Optional[dict] = None
+
+    @property
+    def child_resume(self) -> bool:
+        return self.existing_frame is not None
+
+
+def is_workflow_lisp_bundle(bundle: Any) -> bool:
+    """Typed capability: only `provenance.frontend_kind == "workflow_lisp"` qualifies."""
+    provenance = workflow_provenance(bundle)
+    return getattr(provenance, "frontend_kind", None) == WORKFLOW_LISP_FRONTEND_KIND
+
+
+def _selection(lineage: CallFrameRetryLineage, frames: Mapping[str, Any], fresh_frame_id: str, workflow_lisp: bool):
+    running = lineage.running_member
+    predecessors = tuple((m.frame_id, frames[m.frame_id]) for m in lineage.failed_predecessors)
+    if running is not None:
+        return running.frame_id, frames[running.frame_id], predecessors
+    if workflow_lisp and lineage.failed_predecessors:
+        return next_unused_retry_frame_id(lineage), None, predecessors
+    return fresh_frame_id, None, predecessors
+
+
+def plan_resume_call(
+    executor: Any,
+    state: Mapping[str, Any],
+    *,
+    step_id: str,
+    step_alias: Any,
+    fresh_frame_id: str,
+    scope_path: ResumeScopePath,
+    is_workflow_lisp: Callable[[Any], bool],
+) -> ResumeCallPlan:
+    """Select the callee bundle and frame for one reached call; defer integrity failures."""
+    parent_bundle = executor.loaded_bundle
+    fallback_bundle = workflow_import_bundle(parent_bundle, step_alias)
+
+    def fail(reason: str, offending: Any = step_id, **details: Any) -> ResumeCallPlan:
+        payload = integrity_error_payload(
+            reason, bundle=parent_bundle, state=state, scope_path=scope_path,
+            offending_value=offending, call_boundary_step_id=step_id, **details,
+        )
+        return ResumeCallPlan(fallback_bundle, step_alias, fresh_frame_id, None, failure=payload)
+
+    projection = executor.projection
+    try:
+        slot_index = projection.enumerate_resume_slots(state)
+    except ResumeProjectionValidationError as exc:
+        return fail(exc.reason, None, field=exc.field)
+    resolution = projection.resolve_call_boundary(slot_index, step_id)
+    if resolution.boundary is None:
+        return fail(
+            "missing_call_boundary" if resolution.candidate_count == 0 else "ambiguous_call_boundary",
+            candidate_count=resolution.candidate_count,
+        )
+    boundary = resolution.boundary
+    callee = workflow_import_bundle(parent_bundle, boundary.import_alias)
+    if callee is None:
+        return fail("missing_imported_bundle", field=f"imports.{boundary.import_alias}", candidate_count=1)
+    workflow_lisp = is_workflow_lisp(callee)
+    try:
+        lineage = audit_call_boundary_frames(
+            parent_bundle, state, scope_path, call_step_id=step_id, boundary=boundary,
+            frontend_kind=WORKFLOW_LISP_FRONTEND_KIND if workflow_lisp else None,
+        )
+    except ResumeProjectionIntegrityError as exc:
+        return ResumeCallPlan(callee, boundary.import_alias, fresh_frame_id, None, failure=exc.error)
+    frames = state.get("call_frames") or {}
+    frame_id, existing, predecessors = _selection(lineage, frames, fresh_frame_id, workflow_lisp)
+    return ResumeCallPlan(callee, boundary.import_alias, frame_id, existing, predecessors)

new file mode 100644
index 0000000..930ff7f
--- /dev/null
+++ b/tests/test_loader_duplicate_import_alias.py
@@ -0,0 +1,147 @@
+"""Classic-YAML import alias hardening: repeated aliases/sections fail before bundle lowering."""
+
+import textwrap
+
+import pytest
+
+import orchestrator.loader as loader_module
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+
+LIBRARY = """\
+version: "2.5"
+name: lib
+artifacts:
+  approved:
+    kind: scalar
+    type: bool
+steps:
+  - name: SetApproved
+    id: set_approved
+    set_scalar:
+      artifact: approved
+      value: true
+"""
+
+
+def _write(tmp_path, text):
+    lib_dir = tmp_path / "lib"
+    lib_dir.mkdir(exist_ok=True)
+    for name in ("a.yaml", "b.yaml", "c.yaml"):
+        (lib_dir / name).write_text(LIBRARY)
+    path = tmp_path / "workflow.yaml"
+    path.write_text(textwrap.dedent(text))
+    return path
+
+
+@pytest.fixture
+def forbid_lowering(monkeypatch):
+    def _fail(*args, **kwargs):
+        raise AssertionError("build_loaded_workflow_bundle must not be reached")
+
+    monkeypatch.setattr(loader_module, "build_loaded_workflow_bundle", _fail)
+
+
+def _messages(tmp_path, text):
+    with pytest.raises(WorkflowValidationError) as excinfo:
+        WorkflowLoader(tmp_path).load(_write(tmp_path, text))
+    return [error.message for error in excinfo.value.errors]
+
+
+def test_duplicate_key_inside_imports_mapping(tmp_path, forbid_lowering):
+    messages = _messages(tmp_path, """\
+        version: "2.5"
+        name: demo
+        imports:
+          a: lib/a.yaml
+          a: lib/b.yaml
+        steps: []
+        """)
+    assert messages == ["imports.a: duplicate import alias at line 4, column 3; line 5, column 3"]
+
+
+def test_merge_inside_imports_repeating_alias(tmp_path, forbid_lowering):
+    messages = _messages(tmp_path, """\
+        version: "2.5"
+        name: demo
+        base: &base
+          a: lib/a.yaml
+        imports:
+          <<: *base
+          a: lib/b.yaml
+        steps: []
+        """)
+    assert messages == ["imports.a: duplicate import alias at line 4, column 3; line 7, column 3"]
+
+
+def test_repeated_imports_sections_with_repeated_alias(tmp_path, forbid_lowering):
+    messages = _messages(tmp_path, """\
+        version: "2.5"
+        name: demo
+        imports:
+          a: lib/a.yaml
+        imports:
+          a: lib/b.yaml
+        steps: []
+        """)
+    assert messages == ["imports.a: duplicate import alias at line 4, column 3; line 6, column 3"]
+
+
+def test_top_level_merge_sources_each_carrying_imports(tmp_path, forbid_lowering):
+    messages = _messages(tmp_path, """\
+        one: &one
+          imports:
+            a: lib/a.yaml
+        two: &two
+          imports:
+            a: lib/b.yaml
+        <<: [*one, *two]
+        version: "2.5"
+        name: demo
+        steps: []
+        """)
+    assert messages == ["imports.a: duplicate import alias at line 3, column 5; line 6, column 5"]
+
+
+def test_repeated_imports_sections_with_distinct_aliases(tmp_path, forbid_lowering):
+    messages = _messages(tmp_path, """\
+        version: "2.5"
+        name: demo
+        imports:
+          a: lib/a.yaml
+        imports:
+          b: lib/b.yaml
+        steps: []
+        """)
+    assert messages == ["imports: duplicate top-level mapping at line 3, column 1; line 5, column 1"]
+
+
+def test_merged_and_explicit_imports_sections_with_distinct_aliases(tmp_path, forbid_lowering):
+    messages = _messages(tmp_path, """\
+        base: &base
+          imports:
+            a: lib/a.yaml
+        <<: *base
+        version: "2.5"
+        name: demo
+        imports:
+          b: lib/b.yaml
+        steps: []
+        """)
+    assert messages == ["imports: duplicate top-level mapping at line 2, column 3; line 7, column 1"]
+
+
+def test_single_merged_imports_section_loads(tmp_path):
+    path = _write(tmp_path, """\
+        <<:
+          imports:
+            a: lib/a.yaml
+            b: lib/b.yaml
+        version: "2.5"
+        name: demo
+        steps:
+          - name: Noop
+            command: ["true"]
+        """)
+    bundle = WorkflowLoader(tmp_path).load(path)
+    assert set(bundle.imports) == {"a", "b"}

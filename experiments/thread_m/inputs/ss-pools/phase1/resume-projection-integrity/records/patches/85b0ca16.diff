index 0000000..2a1576b
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,361 @@
+"""Checksum-compatible resume projection-integrity audit for one persisted scope.
+
+Depends on: the loaded `bundle` (projection, imports, provenance) and the persisted
+`state` mapping it is handed; it loads no workflow, computes no checksum, reads no
+file and never mutates `state`.
+Behavior: `audit_scope` verifies every persisted step, current-step, loop-progress
+and call-frame identity of ONE scope against that bundle's projection and raises
+`ResumeProjectionIntegrityError` carrying the stable v1 diagnostic. Callee scopes
+are audited by the caller when a call is reached.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, NoReturn, Optional
+
+from ..state import RESUME_PROJECTION_ERROR_TYPE
+from .loaded_bundle import workflow_import_bundle, workflow_provenance
+from .resume_call_lineage import (
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .resume_loop_bookkeeping import ResumeProjectionValidationError, validated_loop_bookkeeping
+from .state_projection import ResumeProjectionSlotIndex
+
+__all__ = [
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "RESUME_PROJECTION_ERROR_TYPE",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "RetryFrameMember",
+    "audit_call_boundary_frames",
+    "audit_scope",
+    "bundle_workflow_file",
+    "index_retry_lineage",
+    "integrity_error_payload",
+    "next_unused_retry_frame_id",
+]
+
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+KNOWN_FRAME_STATUSES = ("running", "failed", "completed")
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow through the call frames entered."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(workflow_file)
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        return [{"kind": "root", "workflow_file": self.root_workflow_file}] + [
+            {"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids
+        ]
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """The persisted scope disagrees with the current projection; `.error` is the diagnostic."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def bundle_workflow_file(bundle: Any) -> str:
+    """Return the bundle's workflow file as recorded in its provenance."""
+    provenance = workflow_provenance(bundle)
+    path = getattr(provenance, "workflow_path", None)
+    return str(path) if path is not None else ""
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def integrity_error_payload(
+    reason: str,
+    *,
+    bundle: Any,
+    state: Any,
+    scope_path: ResumeScopePath,
+    field: Optional[str] = None,
+    offending_value: Any = None,
+    candidate_count: Optional[int] = None,
+    call_boundary_step_id: Optional[str] = None,
+) -> dict[str, Any]:
+    checksum = state.get("workflow_checksum") if isinstance(state, Mapping) else None
+    return {
+        "type": RESUME_PROJECTION_ERROR_TYPE,
+        "message": f"Resume projection integrity audit failed: {reason}",
+        "context": {
+            "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+            "reason": reason,
+            "scope_path": scope_path.as_context(),
+            "field": field,
+            "offending_value": _scalar(offending_value),
+            "expected_owner": {
+                "workflow_file": bundle_workflow_file(bundle),
+                "workflow_checksum": _scalar(checksum),
+                "projection_scope": scope_path.projection_scope,
+            },
+            "candidate_count": candidate_count,
+            "call_boundary_step_id": call_boundary_step_id,
+        },
+    }
+
+
+class _ScopeAudit:
+    def __init__(self, bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope_path = scope_path
+        self.projection = bundle.projection
+
+    def fail(self, reason: str, **details: Any) -> NoReturn:
+        raise ResumeProjectionIntegrityError(
+            integrity_error_payload(
+                reason,
+                bundle=self.bundle,
+                state=self.state,
+                scope_path=self.scope_path,
+                **details,
+            )
+        )
+
+    def mapping_field(self, key: str) -> Mapping[str, Any]:
+        value = self.state.get(key, {})
+        if not isinstance(value, Mapping):
+            self.fail("unsupported_shape", field=key)
+        return value
+
+    def run(self) -> None:
+        if not isinstance(self.state, Mapping):
+            self.fail("unsupported_shape")
+        steps = self.mapping_field("steps")
+        frames = self.mapping_field("call_frames")
+        try:
+            validated_loop_bookkeeping(self.state, "repeat_until", self.declared_maximums())
+            index = self.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            self.fail(exc.reason, field=exc.field)
+        self.audit_loop_ownership()
+        self.audit_rows(steps, index)
+        self.audit_current_step(index)
+        self.audit_call_frames(frames, index)
+
+    def declared_maximums(self) -> dict[str, int]:
+        """Declared `max_iterations` per `repeat_until` frame key, from the executable IR."""
+        nodes = getattr(self.bundle.ir, "nodes", {})
+        maximums: dict[str, int] = {}
+        for node_id, loop in self.projection.repeat_until_nodes.items():
+            maximum = getattr(nodes.get(node_id), "max_iterations", None)
+            if isinstance(maximum, int) and not isinstance(maximum, bool):
+                maximums[loop.frame_key] = maximum
+        return maximums
+
+    def audit_loop_ownership(self) -> None:
+        for kind, nodes in (
+            ("for_each", self.projection.for_each_nodes),
+            ("repeat_until", self.projection.repeat_until_nodes),
+        ):
+            owned = {node.frame_key for node in nodes.values()}
+            for name in self.state.get(kind) or {}:
+                if name not in owned:
+                    self.fail(
+                        "invalid_loop_progress",
+                        field=f"{kind}.{name}",
+                        offending_value=name,
+                        candidate_count=0,
+                    )
+
+    def audit_rows(self, steps: Mapping[str, Any], index: ResumeProjectionSlotIndex) -> None:
+        unclaimed = {name for name, _ in index.unclaimed_explicit_rows}
+        for name, row in steps.items():
+            field = f"steps.{name}.step_id"
+            if isinstance(row, list):
+                continue
+            if not isinstance(row, Mapping):
+                self.fail("unsupported_shape", field=f"steps.{name}", offending_value=row)
+            if "step_id" not in row:
+                continue
+            step_id = row["step_id"]
+            if not isinstance(step_id, str) or not step_id:
+                self.fail("unsupported_shape", field=field, offending_value=step_id)
+            if name in unclaimed:
+                self.fail(
+                    "unclaimed_explicit_step_row", field=field, offending_value=step_id, candidate_count=0
+                )
+            resolution = self.projection.resolve_resume_step_id(index, step_id, name)
+            if resolution.slot is not None:
+                continue
+            reason = (
+                "unknown_explicit_step_id"
+                if resolution.candidate_count == 0
+                else "presentation_slot_mismatch"
+            )
+            self.fail(
+                reason, field=field, offending_value=step_id, candidate_count=resolution.candidate_count
+            )
+
+    def audit_current_step(self, index: ResumeProjectionSlotIndex) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            self.fail("unsupported_shape", field="current_step", offending_value=current)
+        field = "current_step.step_id"
+        if "step_id" not in current:
+            self.fail("missing_required_identity", field=field)
+        step_id = current["step_id"]
+        if not isinstance(step_id, str) or not step_id:
+            self.fail("unsupported_shape", field=field, offending_value=step_id)
+        name = current.get("name")
+        resolution = self.projection.resolve_resume_step_id(
+            index, step_id, name if isinstance(name, str) and name else None
+        )
+        if resolution.slot is not None:
+            return
+        reason = "out_of_scope_step_id" if resolution.candidate_count == 0 else "presentation_slot_mismatch"
+        self.fail(reason, field=field, offending_value=step_id, candidate_count=resolution.candidate_count)
+
+    def audit_call_frames(self, frames: Mapping[str, Any], index: ResumeProjectionSlotIndex) -> None:
+        groups: dict[str, list[tuple[str, Any]]] = {}
+        frontend_kinds: dict[str, Optional[str]] = {}
+        for frame_id, frame in frames.items():
+            boundary = self.audit_frame(frame_id, frame, index)
+            call_step_id = frame["call_step_id"]
+            groups.setdefault(call_step_id, []).append((frame_id, frame))
+            imported = workflow_import_bundle(self.bundle, boundary.import_alias)
+            frontend_kinds[call_step_id] = getattr(workflow_provenance(imported), "frontend_kind", None)
+        for call_step_id, items in groups.items():
+            self.lineage(call_step_id, items, frontend_kinds[call_step_id])
+
+    def resolve_boundary(self, index: ResumeProjectionSlotIndex, call_step_id: str, field: str) -> Any:
+        step = self.projection.resolve_resume_step_id(index, call_step_id)
+        if step.candidate_count == 0:
+            self.fail(
+                "out_of_scope_step_id",
+                field=field,
+                offending_value=call_step_id,
+                candidate_count=0,
+                call_boundary_step_id=call_step_id,
+            )
+        resolution = self.projection.resolve_call_boundary(index, call_step_id)
+        if resolution.boundary is None:
+            self.fail(
+                "missing_call_boundary" if resolution.candidate_count == 0 else "ambiguous_call_boundary",
+                field=field,
+                offending_value=call_step_id,
+                candidate_count=resolution.candidate_count,
+                call_boundary_step_id=call_step_id,
+            )
+        return resolution.boundary
+
+    def lineage(
+        self,
+        call_step_id: str,
+        items: list[tuple[str, Any]],
+        frontend_kind: Optional[str],
+    ) -> CallFrameRetryLineage:
+        try:
+            return index_retry_lineage(call_step_id, items, frontend_kind=frontend_kind)
+        except CallFrameRetryLineageError as exc:
+            resumable = sum(1 for _, frame in items if frame["status"] != "completed")
+            self.fail(
+                exc.reason,
+                field="call_frames",
+                offending_value=resumable,
+                candidate_count=resumable,
+                call_boundary_step_id=call_step_id,
+            )
+
+    def audit_frame(
+        self,
+        frame_id: str,
+        frame: Any,
+        index: Optional[ResumeProjectionSlotIndex],
+        boundary: Any = None,
+    ) -> Any:
+        prefix = f"call_frames.{frame_id}"
+        if not isinstance(frame, Mapping):
+            self.fail("unsupported_shape", field=prefix, offending_value=frame)
+        if frame.get("status") not in KNOWN_FRAME_STATUSES:
+            self.fail("unsupported_shape", field=f"{prefix}.status", offending_value=frame.get("status"))
+        if "call_step_id" not in frame:
+            self.fail("missing_required_identity", field=f"{prefix}.call_step_id")
+        call_step_id = frame["call_step_id"]
+        field = f"{prefix}.call_step_id"
+        if not isinstance(call_step_id, str) or not call_step_id:
+            self.fail("unsupported_shape", field=field, offending_value=call_step_id)
+        if boundary is None:
+            boundary = self.resolve_boundary(index, call_step_id, field)
+        persisted_alias = frame.get("import_alias")
+        if boundary.import_alias is not None and persisted_alias != boundary.import_alias:
+            self.fail(
+                "persisted_import_alias_mismatch",
+                field=f"{prefix}.import_alias",
+                offending_value=persisted_alias,
+                candidate_count=1,
+                call_boundary_step_id=call_step_id,
+            )
+        if workflow_import_bundle(self.bundle, boundary.import_alias) is None:
+            self.fail(
+                "missing_imported_bundle",
+                field=f"imports.{boundary.import_alias}",
+                offending_value=boundary.import_alias,
+                candidate_count=1,
+                call_boundary_step_id=call_step_id,
+            )
+        return boundary
+
+
+def audit_call_boundary_frames(
+    bundle: Any,
+    state: Any,
+    scope_path: ResumeScopePath,
+    *,
+    call_step_id: str,
+    boundary: Any,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Validate the frames of ONE already-resolved reached call boundary; return its lineage.
+
+    Checks frame shape, status, caller, import alias and retry lineage only; the
+    boundary itself is resolved by the caller exactly once per reached call.
+    """
+    audit = _ScopeAudit(bundle, state, scope_path)
+    frames = audit.mapping_field("call_frames") if isinstance(state, Mapping) else {}
+    items = [
+        (frame_id, frame)
+        for frame_id, frame in frames.items()
+        if isinstance(frame, Mapping) and frame.get("call_step_id") == call_step_id
+    ]
+    for frame_id, frame in items:
+        audit.audit_frame(frame_id, frame, None, boundary)
+    return audit.lineage(call_step_id, items, frontend_kind)
+
+
+def audit_scope(bundle: Any, state: Any, scope_path: ResumeScopePath) -> None:
+    """Audit one persisted scope against `bundle`'s projection; raise on any disagreement."""
+    _ScopeAudit(bundle, state, scope_path).run()
diff --git a/orchestrator/workflow/resume_sticky_error.py b/orchestrator/workflow/resume_sticky_error.py
new file mode 100644
index 0000000..1f80845
--- /dev/null
+++ b/orchestrator/workflow/resume_sticky_error.py
@@ -0,0 +1,41 @@
+"""Detection of the sticky, non-routable resume projection-integrity failure.
+
+Depends on: only the step/iteration result mappings it is handed. Behavior: finds the
+unchanged `resume_projection_integrity_error` diagnostic in a step result, including
+inside a `repeat_until` body-failure wrapper or a `for_each` iteration list. Routes,
+`on_error`, loop continuation and finalization wrapping must not consume it.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+from ..state import RESUME_PROJECTION_ERROR_TYPE
+
+_LOOP_BODY_FAILURE = "repeat_until_body_step_failed"
+
+
+def is_projection_error(error: Any) -> bool:
+    return isinstance(error, Mapping) and error.get("type") == RESUME_PROJECTION_ERROR_TYPE
+
+
+def find_projection_error(result: Any) -> Optional[dict]:
+    """Return the projection diagnostic carried by a step result, if any."""
+    if isinstance(result, list):
+        for iteration in result:
+            if isinstance(iteration, Mapping):
+                for nested in iteration.values():
+                    found = find_projection_error(nested)
+                    if found is not None:
+                        return found
+        return None
+    if not isinstance(result, Mapping):
+        return None
+    error = result.get("error")
+    if is_projection_error(error):
+        return error  # type: ignore[return-value]
+    if isinstance(error, Mapping) and error.get("type") == _LOOP_BODY_FAILURE:
+        context = error.get("context")

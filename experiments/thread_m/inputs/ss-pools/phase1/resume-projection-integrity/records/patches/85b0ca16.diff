+def test_status_snapshot_reports_forensic_current_step_as_pending(tmp_path: Path, root_bundle) -> None:
+    from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+
+    base = {
+        "run_id": "r",
+        "workflow_file": "workflow.yaml",
+        "status": "failed",
+        "started_at": "2026-01-01T00:00:00+00:00",
+        "updated_at": "2026-01-01T00:00:00+00:00",
+        "steps": {},
+        "current_step": {"name": "SetReady", "step_id": "root.set_ready", "status": "running", "visit_count": 3},
+    }
+    live = build_status_snapshot(root_bundle, {**base, "status": "running", "updated_at": "2999-01-01T00:00:00+00:00"}, tmp_path)
+    assert live["steps"][0]["status"] == "running"
+
+    for error_type in ("resume_projection_integrity_error", "workflow_checksum_mismatch"):
+        snapshot = build_status_snapshot(root_bundle, {**base, "error": {"type": error_type, "message": "m"}}, tmp_path)
+        entry = snapshot["steps"][0]
+        assert (entry["status"], entry["summary"], entry["current_visit_count"]) == ("pending", "pending", None)
+        assert snapshot["progress"]["running"] == 0
+        assert snapshot["progress"]["pending"] == snapshot["progress"]["total"]
+        assert snapshot["run"]["status"] == "failed"
+        assert "in progress" not in render_status_markdown(snapshot)
+
+    ordinary = build_status_snapshot(root_bundle, {**base, "error": {"type": "other", "message": "m"}}, tmp_path)
+    assert ordinary["steps"][0]["status"] == "running"
+

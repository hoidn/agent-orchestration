+++ b/tests/test_workflow_lisp_frontend_kind_provenance.py
@@ -0,0 +1,106 @@
+"""Workflow Lisp compiled bundles carry `frontend_kind == "workflow_lisp"`; classic YAML imports do not."""
+
+from pathlib import Path
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+
+def _orc(*lines: str) -> str:
+    return "\n".join(['(workflow-lisp', '  (:language "0.1")', '  (:target-dsl "2.14")', *lines]) + ")"
+
+
+@pytest.fixture
+def compiled(tmp_path: Path):
+    yaml_path = tmp_path / "classic.yaml"
+    yaml_path.write_text(
+        "\n".join(
+            [
+                'version: "2.14"',
+                "name: classic",
+                "inputs:",
+                "  input__label: {kind: scalar, type: string}",
+                "outputs:",
+                "  return__label:",
+                "    kind: scalar",
+                "    type: string",
+                "    from: {ref: root.steps.Echo.artifacts.return__label}",
+                "steps:",
+                "  - name: Echo",
+                "    id: echo",
+                '    command: ["printf", "x"]',
+                "    expected_outputs:",
+                "      - {name: return__label, path: state/label.txt, type: string}",
+            ]
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    classic_bundle = WorkflowLoader(tmp_path).load_bundle(yaml_path)
+
+    package = tmp_path / "src" / "demo"
+    package.mkdir(parents=True)
+    (package / "helper.orc").write_text(
+        _orc(
+            "  (defmodule demo/helper)",
+            "  (export Msg echo)",
+            "  (defrecord Msg (label String))",
+            "  (defworkflow echo ((input Msg)) -> Msg",
+            "    (record Msg :label input.label))",
+        ),
+        encoding="utf-8",
+    )
+    entry_path = package / "entry.orc"
+    entry_path.write_text(
+        _orc(
+            "  (defmodule demo/entry)",
+            "  (import demo/helper :only (Msg echo))",
+            "  (export entry)",
+            "  (defworkflow entry ((input Msg)) -> Msg",
+            "    (call echo :input input))",
+        ),
+        encoding="utf-8",
+    )
+    result = compile_stage3_entrypoint(
+        entry_path,
+        source_roots=(tmp_path / "src",),
+        imported_workflow_bundles={"classic": classic_bundle},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return result, classic_bundle
+
+
+def test_every_validated_lisp_bundle_is_tagged_workflow_lisp(compiled) -> None:
+    result, _ = compiled
+    kinds = {name: b.provenance.frontend_kind for name, b in result.validated_bundles_by_name.items()}
+    assert len(kinds) >= 2 and set(kinds.values()) == {"workflow_lisp"}, kinds
+
+
+def test_imported_lisp_bundles_reached_through_imports_are_tagged(compiled) -> None:
+    result, classic_bundle = compiled
+    lisp_imports = [
+        bundle
+        for parent in result.validated_bundles_by_name.values()
+        for bundle in parent.imports.values()
+        if bundle is not classic_bundle
+    ]
+    assert lisp_imports and {b.provenance.frontend_kind for b in lisp_imports} == {"workflow_lisp"}
+
+
+def test_lowered_surfaces_carry_workflow_lisp_kind(compiled) -> None:
+    result, _ = compiled
+    kinds = {
+        (b.surface.provenance.frontend_kind, b.ir.provenance.frontend_kind, b.core_workflow_ast.provenance.frontend_kind)
+        for b in result.validated_bundles_by_name.values()
+    }
+    assert kinds == {("workflow_lisp",) * 3}
+
+
+def test_classic_yaml_import_keeps_own_provenance_and_identity(compiled) -> None:
+    result, classic_bundle = compiled
+    linked = [parent.imports["classic"] for parent in result.validated_bundles_by_name.values()]
+    assert classic_bundle.provenance.frontend_kind is None
+    assert linked and all(bundle is classic_bundle for bundle in linked)

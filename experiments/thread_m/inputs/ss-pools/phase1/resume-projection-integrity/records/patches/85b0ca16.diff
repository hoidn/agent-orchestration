+def test_cli_second_root_audit_keeps_session_metadata_and_closes_session_failed(tmp_path: Path, root_bundle) -> None:
+    import os
+
+    import orchestrator.cli.commands.resume as resume_command
+
+    manager = _seed_run(tmp_path, root_bundle)
+    state = manager.load()
+    state.status = "failed"
+    state.current_step = {"name": "Gone", "step_id": "root.gone", "status": "running"}
+    manager._write_state()
+    before = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    real_audit = resume_command.audit_scope
+    calls: list[int] = []
+
+    def audit_once_then_pass(bundle, state_dict, scope_path):
+        calls.append(1)  # the CLI audit is let through, the executor's second audit must catch it
+        return None
+
+    def failing_close(*_args, **_kwargs):
+        raise RuntimeError("close failed")
+
+    cwd = os.getcwd()
+    os.chdir(tmp_path)
+    try:
+        with patch.object(resume_command, "audit_scope", audit_once_then_pass), patch.object(
+            resume_command, "close_executor_session", failing_close
+        ):
+            assert resume_command.resume_workflow(run_id="audit-run") == 1
+    finally:
+        os.chdir(cwd)
+
+    after = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert calls == [1]
+    assert real_audit is not audit_once_then_pass
+    assert after["error"]["type"] == "resume_projection_integrity_error"
+    assert after["error"]["context"]["reason"] == "out_of_scope_step_id"
+    assert after["status"] == "failed"
+    sessions = after["runtime_observability"]["executor_sessions"]
+    assert len(sessions) == 1 and sessions[0]["entrypoint"] == "resume"
+    assert (manager.run_root / "monitor_process.json").is_file()
+    assert after["steps"] == before["steps"]
+    assert after["current_step"] == before["current_step"]
+

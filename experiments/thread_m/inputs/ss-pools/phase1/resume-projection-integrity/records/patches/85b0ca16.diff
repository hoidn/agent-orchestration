+def test_resolve_call_boundary_reports_unique_and_ambiguous_owners(call_bundle) -> None:
+    projection = call_bundle.projection
+    index = projection.enumerate_resume_slots(
+        {"for_each": {"ProcessItems": {"items": ["a", "b"], "completed_indices": []}}}
+    )

+        for kind in ("for_each", "repeat_until")
+    }
+    candidates: dict[str, list[ResumeStepSlot]] = {}
+    boundaries: dict[str, list[CallBoundaryProjection]] = {}
+    owned_names: set[str] = set()
+    loops = {
+        ("for_each", node_id): node for node_id, node in projection.for_each_nodes.items()
+    } | {("repeat_until", node_id): node for node_id, node in projection.repeat_until_nodes.items()}
+    nested_ids = {nested for node in loops.values() for nested in node.nested_presentation_keys}
+
+    def add(slot: ResumeStepSlot) -> None:
+        candidates.setdefault(slot.step_id, []).append(slot)
+        owned_names.add(slot.presentation_key)

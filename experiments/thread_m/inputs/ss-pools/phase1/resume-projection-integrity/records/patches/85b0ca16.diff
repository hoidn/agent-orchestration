index 0000000..727d92f
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_bookkeeping.py
@@ -0,0 +1,157 @@
+"""Read-only validation of persisted `for_each` / `repeat_until` bookkeeping for resume.
+
+Depends on: the persisted state mapping only (`for_each`, `repeat_until`, and the
+loop frame row under `steps`) plus optional declared `max_iterations` per loop key.
+Behavior: returns the validated per-loop progress mappings or raises
+`ResumeProjectionValidationError` with a stable reason and message. Never mutates.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted resume bookkeeping violates the projection contract."""
+
+    def __init__(self, reason: str, message: str, field: Optional[str] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.field = field
+
+
+def _shape(field: str, message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("unsupported_shape", message, field)
+
+
+def _progress(field: str, message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError("invalid_loop_progress", message, field)
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _optional_index(value: Any, path: str) -> Optional[int]:
+    if value is not None and not _is_index(value):
+        raise _shape(path, f"{path} must be null or a non-boolean integer")
+    return value
+
+
+def _index_list(progress: Mapping[str, Any], key: str, path: str) -> list[Any]:
+    values = progress.get(key, [])
+    if not isinstance(values, list):
+        raise _shape(f"{path}.{key}", f"{path}.{key} must be a list")
+    if len(set(map(repr, values))) != len(values):
+        raise _progress(f"{path}.{key}", f"{path}.{key} must not contain duplicate indices")
+    return values
+
+
+def _check_for_each(path: str, progress: Mapping[str, Any]) -> None:
+    items = progress.get("items")
+    if not isinstance(items, list):
+        raise _shape(f"{path}.items", f"{path}.items must be a list")
+    current = _optional_index(progress.get("current_index"), f"{path}.current_index")
+    completed = _index_list(progress, "completed_indices", path)
+    if any(not _is_index(i) or not 0 <= i < len(items) for i in completed):
+        raise _progress(f"{path}.completed_indices", f"{path}.completed_indices contains an out-of-range index")
+    if current is not None and not 0 <= current < len(items):
+        raise _progress(f"{path}.current_index", f"{path}.current_index is out of range")
+    if current in completed:
+        raise _progress(f"{path}.current_index", f"{path}.current_index is already completed")
+
+
+def _check_repeat_until(
+    path: str,
+    progress: Mapping[str, Any],
+    frame: Any,
+    max_iterations: Optional[int],
+) -> None:
+    current = _optional_index(progress.get("current_iteration"), f"{path}.current_iteration")
+    evaluated = _optional_index(
+        progress.get("condition_evaluated_for_iteration"),
+        f"{path}.condition_evaluated_for_iteration",
+    )
+    last = progress.get("last_condition_result")
+    if last is not None and not isinstance(last, bool):
+        raise _shape(f"{path}.last_condition_result", f"{path}.last_condition_result must be null or boolean")
+    exhausted = progress.get("exhausted", False)
+    if not isinstance(exhausted, bool):
+        raise _shape(f"{path}.exhausted", f"{path}.exhausted must be boolean when present")
+    completed = _index_list(progress, "completed_iterations", path)
+    if any(not _is_index(i) or i < 0 for i in completed):
+        raise _progress(f"{path}.completed_iterations", f"{path}.completed_iterations is not valid prior history")
+    conflict = _progress(path, f"{path}.condition result conflicts with evaluation state")
+    if current is not None:
+        _check_active(path, current, completed, evaluated, last, exhausted, max_iterations, conflict)
+        return
+    if evaluated is None or evaluated not in completed or evaluated != max(completed):
+        raise _progress(path, f"{path}.terminal progress requires completed evaluated history")
+    if set(completed) != set(range(evaluated + 1)) or (
+        max_iterations is not None and evaluated >= max_iterations
+    ):
+        raise _progress(f"{path}.completed_iterations", f"{path}.completed_iterations is not valid prior history")
+    if last is True and not exhausted:
+        return
+    if last is not False:
+        raise conflict
+    if max_iterations is not None and evaluated + 1 != max_iterations:
+        raise _progress(f"{path}.completed_iterations", f"{path}.completed_iterations is not valid prior history")
+    if frame is None:
+        return  # an absent loop-frame row is resumable (the frame is re-derived); only a contradicting row is invalid
+    status = frame.get("status") if isinstance(frame, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _progress(path, f"{path}.successful exhaustion requires a completed frame")
+        return
+    error = frame.get("error") if isinstance(frame, Mapping) else None
+    if status != "failed" or not isinstance(error, Mapping) or error.get("type") != EXHAUSTION_ERROR_TYPE:
+        raise _progress(path, f"{path}.failed exhaustion requires the terminal exhaustion error")
+
+
+def _check_active(
+    path: str,
+    current: int,
+    completed: list[Any],
+    evaluated: Optional[int],
+    last: Optional[bool],
+    exhausted: bool,
+    max_iterations: Optional[int],
+    conflict: ResumeProjectionValidationError,
+) -> None:
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise _progress(f"{path}.current_iteration", f"{path}.current_iteration is out of range")
+    if current in completed or set(completed) != set(range(current)):
+        raise _progress(f"{path}.completed_iterations", f"{path}.completed_iterations is not valid prior history")
+    if exhausted:
+        raise conflict
+    if evaluated is None:
+        if last is not None:
+            raise conflict
+    elif evaluated != current or last is None:
+        raise conflict
+
+
+def validated_loop_bookkeeping(
+    state: Mapping[str, Any],
+    kind: str,
+    max_iterations_by_key: Mapping[str, Optional[int]],
+) -> Mapping[str, Mapping[str, Any]]:
+    """Return validated `state[kind]` progress mappings (`for_each` or `repeat_until`)."""
+    entries = state.get(kind, {})
+    if not isinstance(entries, Mapping):
+        raise _shape(kind, f"{kind} must be a mapping")
+    steps = state.get("steps")
+    for name, progress in entries.items():
+        path = f"{kind}.{name}"
+        if not isinstance(progress, Mapping):
+            raise _shape(path, f"{path} must be a mapping")
+        if kind == "for_each":
+            _check_for_each(path, progress)
+        else:
+            frame = steps.get(name) if isinstance(steps, Mapping) else None
+            _check_repeat_until(path, progress, frame, max_iterations_by_key.get(name))
+    return entries
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py

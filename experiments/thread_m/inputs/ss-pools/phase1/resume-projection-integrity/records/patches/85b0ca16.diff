new file mode 100644
index 0000000..1d1c677
--- /dev/null
+++ b/orchestrator/workflow/resume_call_lineage.py
@@ -0,0 +1,142 @@
+"""Call-frame retry lineage indexing for checksum-compatible resume.
+
+Depends on: only the `(frame_id, frame)` pairs it is given (frames expose `status`,
+`call_step_id`, `import_alias`) and the boundary's typed frontend kind.
+Behavior: groups the frames of ONE call boundary into completed history plus, for
+Workflow Lisp boundaries, a retry lineage `B`, `B::retry::1`, ... with at most one
+running member. Selection never depends on mapping order. Never mutates anything.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+RETRY_MARKER = "::retry::"
+WORKFLOW_LISP_FRONTEND_KIND = "workflow_lisp"
+KNOWN_FRAME_STATUSES = frozenset({"running", "failed", "completed"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """The frames of one boundary do not form a valid, unambiguous lineage."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember:
+    frame_id: str
+    ordinal: int
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    boundary_step_id: str
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[RetryFrameMember, ...]
+    running_member: Optional[CallFrameMember | RetryFrameMember]
+
+
+def _split_retry_id(frame_id: str) -> tuple[str, int]:
+    """Return `(base, ordinal)`; ordinal 0 is the base frame itself."""
+    if RETRY_MARKER not in frame_id:
+        return frame_id, 0
+    base, _, suffix = frame_id.partition(RETRY_MARKER)
+    if RETRY_MARKER in suffix:
+        raise CallFrameRetryLineageError("unsupported_shape", f"nested retry marker in '{frame_id}'")
+    if not base or not suffix.isascii() or not suffix.isdecimal() or str(int(suffix)) != suffix or int(suffix) < 1:
+        raise CallFrameRetryLineageError("unsupported_shape", f"malformed retry ordinal in '{frame_id}'")
+    return base, int(suffix)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[str, Any]]
+) -> list[tuple[str, str]]:
+    """Return `(frame_id, status)` after shape, caller and alias checks."""
+    frames: list[tuple[str, str]] = []
+    aliases: set[Any] = set()
+    for frame_id, frame in frame_items:
+        if not isinstance(frame, Mapping):
+            raise CallFrameRetryLineageError("unsupported_shape", f"frame '{frame_id}' is not a mapping")
+        status = frame.get("status")
+        if status not in KNOWN_FRAME_STATUSES:
+            raise CallFrameRetryLineageError("unsupported_shape", f"frame '{frame_id}' has an unknown status")
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError("missing_call_boundary", f"frame '{frame_id}' is not owned by the boundary")
+        aliases.add(frame.get("import_alias"))
+        frames.append((frame_id, status))
+    if len(aliases) > 1:
+        raise CallFrameRetryLineageError("persisted_import_alias_mismatch", "frames disagree on the import alias")
+    return frames
+
+
+def _ambiguous(message: str) -> CallFrameRetryLineageError:
+    return CallFrameRetryLineageError("ambiguous_resumable_call_frame", message)
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Any]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group one boundary's frames into completed history and its retry lineage."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    completed = tuple(CallFrameMember(fid) for fid, status in frames if status == "completed")
+    open_frames = [(fid, status) for fid, status in frames if status != "completed"]
+    if frontend_kind != WORKFLOW_LISP_FRONTEND_KIND:
+        if len(open_frames) > 1:
+            raise _ambiguous("several non-completed frames for one non-Workflow-Lisp boundary")
+        running = CallFrameMember(open_frames[0][0]) if open_frames else None
+        return CallFrameRetryLineage(
+            boundary_step_id, running.frame_id if running else None, completed, (), running
+        )
+    members = [(*_split_retry_id(fid), status, fid) for fid, status in open_frames]
+    if len({base for base, *_ in members}) > 1:
+        raise _ambiguous("retry lineage mixes several base frames")
+    if len({ordinal for _, ordinal, *_ in members}) != len(members):
+        raise _ambiguous("retry lineage repeats an ordinal")
+    running_members = [RetryFrameMember(fid, ordinal) for _, ordinal, status, fid in members if status == "running"]
+    if len(running_members) > 1:
+        raise _ambiguous("retry lineage has several running members")
+    failed = tuple(
+        sorted(
+            (RetryFrameMember(fid, ordinal) for _, ordinal, status, fid in members if status == "failed"),
+            key=lambda member: member.ordinal,
+        )
+    )
+    return CallFrameRetryLineage(
+        boundary_step_id,
+        members[0][0] if members else None,
+        completed,
+        failed,
+        running_members[0] if running_members else None,
+    )
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return `<base>::retry::<n>` for the lowest unused positive ordinal (idempotent)."""
+    if lineage.base_frame_id is None:
+        raise ValueError("lineage has no base frame to retry")
+    used = {member.ordinal for member in lineage.failed_predecessors}
+    if isinstance(lineage.running_member, RetryFrameMember):
+        used.add(lineage.running_member.ordinal)
+    for member in lineage.completed_members:
+        try:
+            base, ordinal = _split_retry_id(member.frame_id)
+        except CallFrameRetryLineageError:
+            continue
+        if base == lineage.base_frame_id:
+            used.add(ordinal)
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{lineage.base_frame_id}{RETRY_MARKER}{ordinal}"

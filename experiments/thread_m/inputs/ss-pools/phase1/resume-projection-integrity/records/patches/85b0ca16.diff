+def test_loop_contained_projection_failure_stops_the_loop_and_is_promoted(tmp_path: Path) -> None:
+    import yaml
+
+    from orchestrator.workflow.executor import WorkflowExecutor
+    from tests.test_subworkflow_calls import _write_yaml
+
+    workflow = _write_projection_call_workflow(tmp_path)

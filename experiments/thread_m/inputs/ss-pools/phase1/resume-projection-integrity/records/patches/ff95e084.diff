+        calls.append((id(slot_index), call_step_id))
+        return original(slot_index, call_step_id)
+
+    with patch("orchestrator.workflow.calls.audit_scope"), patch.object(
+        WorkflowStateProjection, "resolve_call_boundary", staticmethod(record)
+    ), patch.object(executor_module, "audit_scope"):
+        WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert [call_step_id for _, call_step_id in calls] == ["root.invoke_middle", "root.invoke_leaf"]

+    index = audit.index()
+    audit.check_rows(steps, index)
+    audit.check_current_step(index)
+    boundaries = {}
+    for frame_id, frame in frames.items():
+        boundaries[frame["call_step_id"]] = audit.check_frame(frame_id, frame, index)

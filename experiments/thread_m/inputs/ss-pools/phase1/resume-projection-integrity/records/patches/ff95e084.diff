+++ b/orchestrator/workflow/resume_stickiness.py
@@ -0,0 +1,49 @@
+"""Sticky, non-routable resume projection integrity failures."""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+STICKY_ERROR_TYPE = "resume_projection_integrity_error"
+
+
+def is_sticky_projection_error(error: Any) -> bool:
+    """True for a resume projection diagnostic, which routes and loops must not consume."""
+    return isinstance(error, dict) and error.get("type") == STICKY_ERROR_TYPE
+
+
+def sticky_projection_error_in(result: Any) -> Optional[dict]:
+    """Return the sticky error carried by a step result or a for-each result list."""
+    if isinstance(result, dict):
+        error = result.get("error")
+        return error if is_sticky_projection_error(error) else None
+    if isinstance(result, list):
+        for iteration in result:
+            if not isinstance(iteration, dict):
+                continue
+            for candidate in (iteration, *iteration.values()):
+                error = sticky_projection_error_in(candidate) if isinstance(candidate, dict) else None
+                if error is not None:
+                    return error
+    return None
+
+
+FORENSIC_CURRENT_STEP_ERROR_TYPES = frozenset(
+    {STICKY_ERROR_TYPE, "workflow_checksum_mismatch"}
+)
+
+
+def has_forensic_current_step(state: Any) -> bool:
+    """True when a failed resume envelope left `current_step` unchanged.
+
+    Such a step is evidence of where the earlier run stopped, not a live step:
+    status snapshots show it as pending and heartbeats must not treat it as live.
+    """
+    if not isinstance(state, dict) or state.get("status") != "failed":
+        return False
+    error = state.get("error")
+    return (
+        isinstance(error, dict)
+        and error.get("type") in FORENSIC_CURRENT_STEP_ERROR_TYPES
+        and isinstance(state.get("current_step"), dict)
+    )

+"""Retry lineage indexing for Workflow Lisp call boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+from orchestrator.workflow.resume_projection_integrity import (
+    CallFrameRetryLineageError,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+
+BOUNDARY = "root.call"
+BASE = "root.call::visit::1"
+
+
+def _frame(status: str, **overrides):
+    frame = {"call_step_id": BOUNDARY, "import_alias": "lib", "status": status}
+    frame.update(overrides)
+    return frame
+
+
+def _index(frames: dict, kind: str | None = "workflow_lisp"):
+    return index_retry_lineage(BOUNDARY, frames.items(), frontend_kind=kind)
+
+
+def test_failed_predecessors_are_ordered_by_ordinal_and_running_member_is_separate() -> None:
+    lineage = _index(
+        {
+            f"{BASE}::retry::2": _frame("running"),
+            f"{BASE}::retry::1": _frame("failed"),
+            BASE: _frame("failed"),
+            "other::visit::1": _frame("completed"),
+        }
+    )
+
+    assert lineage.base_frame_id == BASE
+    assert [(m.frame_id, m.ordinal) for m in lineage.failed_predecessors] == [
+        (BASE, 0),
+        (f"{BASE}::retry::1", 1),
+    ]
+    assert lineage.running_member is not None
+    assert lineage.running_member.frame_id == f"{BASE}::retry::2"
+    assert [m.frame_id for m in lineage.completed_members] == ["other::visit::1"]
+
+
+def test_completed_frames_are_unlimited_and_never_resumable() -> None:
+    lineage = _index({f"{BOUNDARY}::visit::{n}": _frame("completed") for n in range(1, 6)})
+
+    assert lineage.running_member is None
+    assert lineage.failed_predecessors == ()
+    assert len(lineage.completed_members) == 5
+
+
+def test_non_workflow_lisp_boundary_has_at_most_one_non_completed_frame() -> None:
+    single = _index({BASE: _frame("failed"), "x::visit::0": _frame("completed")}, kind=None)
+    assert single.running_member is not None and single.running_member.frame_id == BASE
+
+    with pytest.raises(CallFrameRetryLineageError) as excinfo:
+        _index({BASE: _frame("failed"), "b::visit::2": _frame("running")}, kind="classic")
+    assert excinfo.value.reason == "ambiguous_resumable_call_frame"
+
+
+@pytest.mark.parametrize(
+    ("frames", "reason"),
+    [
+        ({BASE: _frame("running"), f"{BASE}::retry::1": _frame("running")}, "ambiguous_resumable_call_frame"),

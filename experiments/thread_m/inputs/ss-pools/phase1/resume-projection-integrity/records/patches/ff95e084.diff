+"""`audit_scope` behaviour: one case per diagnostic reason, privacy and purity."""
+
+from __future__ import annotations
+
+import copy
+import json
+import re
+from pathlib import Path
+
+import pytest
+
+import orchestrator.workflow.resume_projection_integrity as integrity_module
+from orchestrator.workflow.resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+)
+from tests.resume_projection_helpers import audit_error, build_projection_bundle, valid_state
+
+CONTEXT_KEYS = {
+    "diagnostic_schema",
+    "reason",
+    "scope_path",
+    "field",
+    "offending_value",
+    "expected_owner",
+    "candidate_count",
+    "call_boundary_step_id",
+}
+
+
+@pytest.fixture()
+def bundle(tmp_path: Path):
+    return build_projection_bundle(tmp_path)
+
+
+def _frame(**overrides):
+    frame = {"call_step_id": "root.call", "import_alias": "lib", "status": "running"}
+    frame.update(overrides)
+    return frame
+
+
+def test_a_fully_owned_state_passes_and_is_not_mutated(bundle) -> None:
+    state = valid_state()
+    before = copy.deepcopy(state)
+
+    audit_scope(bundle, state, ResumeScopePath.root("w.yaml"))
+
+    assert state == before
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason", "field", "value", "count"),
+    [
+        (lambda s: s["steps"]["A"].update(step_id="root.nope"), "unknown_explicit_step_id", "steps.A.step_id", "root.nope", 0),
+        (lambda s: s["steps"]["A"].update(step_id="root.call"), "presentation_slot_mismatch", "steps.A.step_id", "root.call", 1),
+        (lambda s: s["current_step"].update(name="Call", step_id="root.a"), "presentation_slot_mismatch", "current_step.step_id", "root.a", 1),
+        (lambda s: s["current_step"].update(step_id="root.removed"), "out_of_scope_step_id", "current_step.step_id", "root.removed", 0),
+        (lambda s: s["steps"].update(Ghost={"step_id": "root.a"}), "unclaimed_explicit_step_row", "steps.Ghost.step_id", "root.a", 0),
+        (lambda s: s["current_step"].pop("step_id"), "missing_required_identity", "current_step.step_id", None, None),
+        (
+            lambda s: s["call_frames"].update(f=_frame(call_step_id="root.a")),
+            "missing_call_boundary",
+            "call_frames.f.call_step_id",
+            "root.a",
+            0,
+        ),
+        (
+            lambda s: s["call_frames"].update(f=_frame(call_step_id="root.gone")),
+            "out_of_scope_step_id",
+            "call_frames.f.call_step_id",
+            "root.gone",
+            0,
+        ),
+        (
+            lambda s: s["call_frames"].update(f=_frame(), g=_frame(status="failed")),
+            "ambiguous_resumable_call_frame",
+            "call_frames",
+            2,
+            2,
+        ),
+        (
+            lambda s: s["call_frames"].update(f=_frame(import_alias="other")),
+            "persisted_import_alias_mismatch",
+            "call_frames.f.import_alias",
+            "other",
+            1,
+        ),
+        (lambda s: s.update(steps=[]), "unsupported_shape", "steps", None, None),
+        (lambda s: s.update(call_frames="x"), "unsupported_shape", "call_frames", None, None),
+        (lambda s: s["call_frames"].update(f="x"), "unsupported_shape", "call_frames.f", None, None),
+        (lambda s: s["steps"].update(A="x"), "unsupported_shape", "steps.A", None, None),
+        (lambda s: s["steps"]["A"].update(step_id=["root.a"]), "unsupported_shape", "steps.A.step_id", None, None),
+        (
+            lambda s: s["repeat_until"]["L"].update(completed_iterations=[0, 0]),
+            "invalid_loop_progress",
+            "repeat_until.L.completed_iterations",
+            None,
+            None,
+        ),
+        (
+            lambda s: s["steps"].update({"L[1].B": {"step_id": "root.l#1.body.b"}}),
+            "unknown_explicit_step_id",
+            "steps.L[1].B.step_id",
+            "root.l#1.body.b",
+            0,
+        ),
+    ],
+)
+def test_each_reason_has_the_documented_field_value_and_count(bundle, mutate, reason, field, value, count) -> None:
+    error = audit_error(bundle, valid_state(), mutate)
+
+    assert error is not None
+    assert error["type"] == "resume_projection_integrity_error"
+    assert error["message"] == f"Resume projection integrity audit failed: {reason}"
+    context = error["context"]
+    assert set(context) == CONTEXT_KEYS
+    assert (context["reason"], context["field"], context["offending_value"], context["candidate_count"]) == (
+        reason,
+        field,
+        value,
+        count,
+    )
+    assert context["diagnostic_schema"] == "resume_projection_integrity_error.v1"
+    assert context["scope_path"] == [{"kind": "root", "workflow_file": "w.yaml"}]
+    assert context["expected_owner"]["projection_scope"] == "root"
+    assert context["expected_owner"]["workflow_checksum"] == valid_state()["workflow_checksum"]
+    assert context["expected_owner"]["workflow_file"].endswith("w.yaml")
+
+
+def test_missing_call_boundary_names_the_frames_call_step(bundle) -> None:
+    error = audit_error(
+        bundle, valid_state(), lambda s: s["call_frames"].update(f=_frame(call_step_id="root.a"))
+    )
+
+    assert error["context"]["call_boundary_step_id"] == "root.a"
+
+
+def test_missing_imported_bundle_names_the_alias(bundle) -> None:
+    broken = copy.copy(bundle)
+    object.__setattr__(broken, "imports", {})
+
+    with pytest.raises(ResumeProjectionIntegrityError) as excinfo:
+        audit_scope(broken, valid_state(), ResumeScopePath.root("w.yaml"))
+
+    context = excinfo.value.error["context"]
+    assert (context["reason"], context["field"], context["offending_value"], context["candidate_count"]) == (
+        "missing_imported_bundle",
+        "imports.lib",
+        "lib",
+        1,
+    )
+
+
+def test_absent_step_ids_stay_compatible_and_are_never_backfilled(bundle) -> None:
+    state = valid_state()
+    state["steps"]["A"].pop("step_id")
+    state["steps"]["Unlisted"] = {"status": "failed"}
+    before = copy.deepcopy(state)
+
+    audit_scope(bundle, state, ResumeScopePath.root("w.yaml"))
+
+    assert state == before
+    assert "step_id" not in state["steps"]["A"]
+
+
+def test_for_each_result_lists_are_accepted_as_rows(bundle) -> None:
+    state = valid_state()
+    state["steps"]["F"] = [{"C": {"status": "completed"}}]
+
+    audit_scope(bundle, state, ResumeScopePath.root("w.yaml"))
+
+
+def test_nested_scopes_report_a_call_frame_scope_path(bundle) -> None:
+    scope = ResumeScopePath.root("w.yaml").child("frame-1").child("frame-2")
+
+    with pytest.raises(ResumeProjectionIntegrityError) as excinfo:
+        audit_scope(bundle, {"steps": {"A": {"step_id": "root.zz"}}}, scope)
+
+    context = excinfo.value.error["context"]
+    assert context["scope_path"] == [
+        {"kind": "root", "workflow_file": "w.yaml"},
+        {"kind": "call_frame", "frame_id": "frame-1"},
+        {"kind": "call_frame", "frame_id": "frame-2"},
+    ]
+    assert context["expected_owner"]["projection_scope"] == "call_frame"
+
+
+def test_diagnostics_never_expose_container_contents_or_state(bundle) -> None:
+    secret = "do-not-leak-this"
+    state = valid_state()
+    state["bound_inputs"] = {"token": secret}
+    state["context"] = {"key": secret}
+    state["steps"]["A"]["step_id"] = [secret, {"nested": secret}]
+    state["call_frames"]["root.call::visit::1"]["bound_inputs"] = {"token": secret}
+
+    error = audit_error(bundle, state, lambda s: None)
+
+    assert error["context"]["reason"] == "unsupported_shape"
+    assert error["context"]["offending_value"] is None
+    assert secret not in json.dumps(error)
+
+
+def test_scope_path_input_list_is_snapshotted_to_a_tuple() -> None:
+    frame_ids = ["a"]
+    scope = ResumeScopePath("w.yaml", frame_ids)
+    frame_ids.append("b")
+
+    assert scope.call_frame_ids == ("a",)
+    assert scope.child("c").call_frame_ids == ("a", "c")
+    assert ResumeScopePath.root("w.yaml").projection_scope == "root"
+    assert scope.projection_scope == "call_frame"
+
+
+def test_auditor_module_stays_free_of_migration_evidence_and_audit_caches() -> None:
+    source = Path(integrity_module.__file__).read_text(encoding="utf-8").lower()
+
+    for forbidden in (
+        "migration_parity",
+        "procedure_identity_retirement",
+        "load_parity_targets",
+        "load_retirement_evidence",
+        "load_retirement_record",
+        "validate_retirement_record",
+        "receipt",
+    ):
+        assert forbidden not in source
+    assert not re.search(r"cache.*audit|audit.*cache|resume projection.*cache|projection integrity.*cache", source)

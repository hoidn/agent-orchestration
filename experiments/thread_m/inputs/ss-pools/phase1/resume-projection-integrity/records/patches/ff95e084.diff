index 0000000..b8cfec4
--- /dev/null
+++ b/orchestrator/workflow/resume_projection_integrity.py
@@ -0,0 +1,320 @@
+"""Audit persisted run identities against the current workflow projection.
+
+``audit_scope`` proves that every durable identity in one persisted scope (the
+root run state or one call-frame state) has exactly one owner in the current
+bundle's projection. It reads only the bundle and state it is given: it loads no
+workflow, computes no checksum, reads no file and never mutates the state.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from .resume_call_lineage import (
+    CallFrameMember,
+    CallFrameRetryLineage,
+    CallFrameRetryLineageError,
+    RetryFrameMember,
+    index_retry_lineage,
+    next_unused_retry_frame_id,
+)
+from .resume_loop_integrity import ResumeProjectionValidationError
+from .state_projection import ResumeProjectionSlotIndex
+
+__all__ = [
+    "CallFrameMember",
+    "CallFrameRetryLineage",
+    "CallFrameRetryLineageError",
+    "ResumeProjectionIntegrityError",
+    "ResumeScopePath",
+    "RetryFrameMember",
+    "audit_scope",
+    "lineage_diagnostic",
+    "resolve_reached_call",
+    "index_retry_lineage",
+    "next_unused_retry_frame_id",
+]
+
+ERROR_TYPE = "resume_projection_integrity_error"
+DIAGNOSTIC_SCHEMA = "resume_projection_integrity_error.v1"
+
+
+@dataclass(frozen=True)
+class ResumeScopePath:
+    """Identity-only path from the root workflow to the audited scope."""
+
+    root_workflow_file: str
+    call_frame_ids: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "call_frame_ids", tuple(self.call_frame_ids))
+
+    @classmethod
+    def root(cls, workflow_file: str) -> "ResumeScopePath":
+        return cls(str(workflow_file))
+
+    def child(self, frame_id: str) -> "ResumeScopePath":
+        return ResumeScopePath(self.root_workflow_file, self.call_frame_ids + (frame_id,))
+
+    @property
+    def projection_scope(self) -> str:
+        return "call_frame" if self.call_frame_ids else "root"
+
+    def as_context(self) -> list[dict[str, str]]:
+        path = [{"kind": "root", "workflow_file": self.root_workflow_file}]
+        path.extend({"kind": "call_frame", "frame_id": frame_id} for frame_id in self.call_frame_ids)
+        return path
+
+
+class ResumeProjectionIntegrityError(ValueError):
+    """A persisted identity has no unique owner in the current projection."""
+
+    def __init__(self, error: dict[str, Any]) -> None:
+        super().__init__(error["message"])
+        self.error = error
+
+
+def _scalar(value: Any) -> Any:
+    return value if isinstance(value, (str, int, float, bool)) else None
+
+
+def _diag(
+    reason: str,
+    scope: ResumeScopePath,
+    bundle: Any,
+    state: Mapping[str, Any],
+    *,
+    field: Optional[str] = None,
+    value: Any = None,
+    count: Optional[int] = None,
+    boundary_id: Any = None,
+) -> ResumeProjectionIntegrityError:
+    workflow_path = getattr(getattr(bundle, "provenance", None), "workflow_path", None)
+    return ResumeProjectionIntegrityError(
+        {
+            "type": ERROR_TYPE,
+            "message": f"Resume projection integrity audit failed: {reason}",
+            "context": {
+                "diagnostic_schema": DIAGNOSTIC_SCHEMA,
+                "reason": reason,
+                "scope_path": scope.as_context(),
+                "field": field,
+                "offending_value": _scalar(value),
+                "expected_owner": {
+                    "workflow_file": None if workflow_path is None else str(workflow_path),
+                    "workflow_checksum": state.get("workflow_checksum"),
+                    "projection_scope": scope.projection_scope,
+                },
+                "candidate_count": count,
+                "call_boundary_step_id": boundary_id if isinstance(boundary_id, str) else None,
+            },
+        }
+    )
+
+
+class _Audit:
+    """One audit run; ``fail`` builds the diagnostic with this scope's context."""
+
+    def __init__(self, bundle: Any, state: Mapping[str, Any], scope: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.state = state
+        self.scope = scope
+
+    def fail(self, reason: str, **kwargs: Any) -> ResumeProjectionIntegrityError:
+        return _diag(reason, self.scope, self.bundle, self.state, **kwargs)
+
+    def mapping(self, key: str) -> Mapping[str, Any]:
+        value = self.state.get(key)
+        if value is None:
+            return {}
+        if not isinstance(value, Mapping):
+            raise self.fail("unsupported_shape", field=key)
+        return value
+
+    def index(self) -> ResumeProjectionSlotIndex:
+        try:
+            return self.bundle.projection.enumerate_resume_slots(self.state)
+        except ResumeProjectionValidationError as exc:
+            raise self.fail(exc.reason, field=exc.message.split(" ", 1)[0]) from exc
+
+    def check_rows(self, steps: Mapping[str, Any], index: ResumeProjectionSlotIndex) -> None:
+        projection = self.bundle.projection
+        loop_names = {loop.frame_key for loop in projection.for_each_nodes.values()}
+        owned_keys = {slot.presentation_key for slots in index.candidates_by_step_id.values() for slot in slots}
+        for name, row in steps.items():
+            if isinstance(row, list) and name in loop_names:
+                continue
+            if not isinstance(row, Mapping):
+                raise self.fail("unsupported_shape", field=f"steps.{name}")
+            if "step_id" not in row:
+                continue
+            field, step_id = f"steps.{name}.step_id", row["step_id"]
+            if not isinstance(step_id, str):
+                raise self.fail("unsupported_shape", field=field, value=step_id)
+            resolution = projection.resolve_resume_step_id(index, step_id, name)
+            if resolution.candidate_count == 0:
+                raise self.fail("unknown_explicit_step_id", field=field, value=step_id, count=0)
+            if resolution.slot is None:
+                if resolution.candidate_count == 1 and name in owned_keys:
+                    raise self.fail("presentation_slot_mismatch", field=field, value=step_id, count=1)
+                raise self.fail(
+                    "unclaimed_explicit_step_row",
+                    field=field,
+                    value=step_id,
+                    count=0 if resolution.candidate_count == 1 else resolution.candidate_count,
+                )
+
+    def check_current_step(self, index: ResumeProjectionSlotIndex) -> None:
+        current = self.state.get("current_step")
+        if current is None:
+            return
+        if not isinstance(current, Mapping):
+            raise self.fail("unsupported_shape", field="current_step")
+        field, step_id = "current_step.step_id", current.get("step_id")
+        if step_id is None:
+            raise self.fail("missing_required_identity", field=field)
+        if not isinstance(step_id, str):
+            raise self.fail("unsupported_shape", field=field, value=step_id)
+        name = current.get("name")
+        resolution = self.bundle.projection.resolve_resume_step_id(
+            index, step_id, name if isinstance(name, str) else None
+        )
+        if resolution.candidate_count == 0 or resolution.candidate_count > 1:
+            raise self.fail(
+                "out_of_scope_step_id", field=field, value=step_id, count=resolution.candidate_count
+            )
+        if resolution.slot is None:
+            raise self.fail("presentation_slot_mismatch", field=field, value=step_id, count=1)
+
+    def require_boundary(self, index: ResumeProjectionSlotIndex, call_step_id: str, field: str) -> Any:
+        """Resolve a caller id to exactly one current call boundary or raise."""
+        resolution = self.bundle.projection.resolve_call_boundary(index, call_step_id)
+        if resolution.candidate_count > 1:
+            raise self.fail(
+                "ambiguous_call_boundary",
+                field=field,
+                value=call_step_id,
+                count=resolution.candidate_count,
+                boundary_id=call_step_id,
+            )
+        if resolution.boundary is None:
+            reason = (
+                "missing_call_boundary" if call_step_id in index.candidates_by_step_id else "out_of_scope_step_id"
+            )
+            raise self.fail(reason, field=field, value=call_step_id, count=0, boundary_id=call_step_id)
+        return resolution.boundary
+
+    def check_alias(self, boundary: Any, alias: Any, field: str, call_step_id: str) -> None:
+        """The persisted alias must equal the boundary's current alias, which must be imported."""
+        if alias != boundary.import_alias:
+            raise self.fail(
+                "persisted_import_alias_mismatch",
+                field=field,
+                value=alias,
+                count=1,
+                boundary_id=call_step_id,
+            )
+        if boundary.import_alias not in self.bundle.imports:
+            raise self.fail(
+                "missing_imported_bundle",
+                field=f"imports.{boundary.import_alias}",
+                value=boundary.import_alias,
+                count=1,
+                boundary_id=call_step_id,
+            )
+
+    def check_frame(self, frame_id: str, frame: Any, index: ResumeProjectionSlotIndex) -> Any:
+        """Validate one frame's caller, alias and status; return its boundary."""
+        if not isinstance(frame, Mapping):
+            raise self.fail("unsupported_shape", field=f"call_frames.{frame_id}")
+        field, call_step_id = f"call_frames.{frame_id}.call_step_id", frame.get("call_step_id")
+        if call_step_id is None:
+            raise self.fail("missing_required_identity", field=field)
+        if not isinstance(call_step_id, str):
+            raise self.fail("unsupported_shape", field=field, value=call_step_id)
+        boundary = self.require_boundary(index, call_step_id, field)
+        self.check_alias(boundary, frame.get("import_alias"), f"call_frames.{frame_id}.import_alias", call_step_id)
+        if frame.get("status") not in ("completed", "failed", "running"):
+            raise self.fail(
+                "unsupported_shape",
+                field=f"call_frames.{frame_id}.status",
+                value=frame.get("status"),
+                boundary_id=call_step_id,
+            )
+        return boundary
+
+    def check_lineages(self, frames: Mapping[str, Any], boundaries: dict[str, Any]) -> None:
+        by_boundary: dict[str, list[tuple[str, Mapping[str, Any]]]] = {}
+        for frame_id, frame in frames.items():
+            by_boundary.setdefault(frame["call_step_id"], []).append((frame_id, frame))
+        for call_step_id, items in by_boundary.items():
+            callee = self.bundle.imports[boundaries[call_step_id].import_alias]
+            frontend_kind = getattr(getattr(callee, "provenance", None), "frontend_kind", None)
+            try:
+                index_retry_lineage(call_step_id, items, frontend_kind=frontend_kind)
+            except CallFrameRetryLineageError as exc:
+                self.raise_lineage_error(exc, call_step_id)
+
+    def raise_lineage_error(self, exc: CallFrameRetryLineageError, call_step_id: str) -> None:

+++ b/tests/test_loader_import_aliases.py
@@ -0,0 +1,91 @@
+"""Classic-YAML import alias integrity, checked before bundle construction."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.exceptions import WorkflowValidationError
+from orchestrator.loader import WorkflowLoader
+from tests.resume_projection_helpers import LIB_WORKFLOW, write_yaml
+
+HEAD = 'version: "2.7"\nname: t\n'
+BODY = "steps:\n  - name: C\n    id: c\n    call: lib\n"
+
+
+def _load_expecting_errors(tmp_path: Path, text: str) -> list[str]:
+    write_yaml(tmp_path / "lib.yaml", LIB_WORKFLOW)
+    (tmp_path / "w.yaml").write_text(text, encoding="utf-8")
+    with patch("orchestrator.loader.build_loaded_workflow_bundle") as build:
+        with pytest.raises(WorkflowValidationError) as excinfo:
+            WorkflowLoader(tmp_path).load(tmp_path / "w.yaml")
+    build.assert_not_called()
+    return [error.message for error in excinfo.value.errors]
+
+
+@pytest.mark.parametrize(
+    ("imports", "positions"),
+    [
+        ("imports:\n  lib: lib.yaml\n  lib: lib.yaml\n", "line 4, column 3; line 5, column 3"),
+        (
+            "shared: &shared\n  lib: lib.yaml\nimports:\n  <<: *shared\n  lib: lib.yaml\n",
+            "line 4, column 3; line 7, column 3",
+        ),
+        (
+            "imports:\n  lib: lib.yaml\nimports:\n  lib: lib.yaml\n",
+            "line 4, column 3; line 6, column 3",
+        ),
+        (
+            "first: &first\n  imports:\n    lib: lib.yaml\nsecond: &second\n  imports:\n    lib: lib.yaml\n<<: [*first, *second]\n",
+            "line 4, column 5; line 7, column 5",
+        ),
+    ],
+)
+def test_a_repeated_alias_is_reported_once_with_each_position(tmp_path: Path, imports: str, positions: str) -> None:
+    errors = _load_expecting_errors(tmp_path, HEAD + imports + BODY)
+
+    assert len(errors) == 1
+    assert errors[0].startswith("imports.lib: duplicate import alias")
+    assert "duplicate top-level mapping" not in errors[0]
+    assert errors[0].count("line ") == 2
+    assert "column" in errors[0]
+
+
+def test_repeated_imports_sections_with_distinct_aliases_are_one_section_error(tmp_path: Path) -> None:
+    text = HEAD + "imports:\n  lib: lib.yaml\nimports:\n  other: lib.yaml\n" + BODY
+
+    errors = _load_expecting_errors(tmp_path, text)
+
+    assert errors == ["imports: duplicate top-level mapping (line 3, column 1; line 5, column 1)"]
+
+
+def test_one_explicit_and_one_merged_imports_section_are_a_section_error(tmp_path: Path) -> None:
+    text = (
+        HEAD
+        + "base: &base\n  imports:\n    lib: lib.yaml\n<<: *base\nimports:\n  other: lib.yaml\n"
+        + BODY
+    )
+
+    errors = _load_expecting_errors(tmp_path, text)
+
+    assert len(errors) == 1 and errors[0].startswith("imports: duplicate top-level mapping")
+    assert errors[0].count("line ") == 2
+
+
+def test_single_merged_imports_section_with_unique_aliases_loads(tmp_path: Path) -> None:
+    write_yaml(tmp_path / "lib.yaml", LIB_WORKFLOW)
+    text = HEAD + "<<: &base\n  imports:\n    lib: lib.yaml\n" + BODY
+    (tmp_path / "w.yaml").write_text(text, encoding="utf-8")
+
+    bundle = WorkflowLoader(tmp_path).load(tmp_path / "w.yaml")
+
+    assert list(bundle.imports) == ["lib"]
+
+
+def test_unique_aliases_in_one_section_load(tmp_path: Path) -> None:
+    write_yaml(tmp_path / "lib.yaml", LIB_WORKFLOW)
+    (tmp_path / "w.yaml").write_text(HEAD + "imports:\n  lib: lib.yaml\n" + BODY, encoding="utf-8")
+
+    assert list(WorkflowLoader(tmp_path).load(tmp_path / "w.yaml").imports) == ["lib"]

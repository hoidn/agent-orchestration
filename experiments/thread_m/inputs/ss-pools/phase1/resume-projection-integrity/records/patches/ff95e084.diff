+"""Projection-owned resume slot enumeration and identity resolution."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.workflow.state_projection import (
+    CallBoundaryProjection,
+    ResumeProjectionValidationError,
+)
+from tests.resume_projection_helpers import build_projection_bundle, valid_state
+
+
+@pytest.fixture()
+def projection(tmp_path: Path):
+    return build_projection_bundle(tmp_path).projection
+
+
+def test_enumerates_top_level_loop_local_and_finalization_candidates(projection) -> None:
+    index = projection.enumerate_resume_slots(valid_state())
+
+    assert [slot.presentation_key for slot in index.candidates_by_step_id["root.a"]] == ["A"]
+    finalization = index.candidates_by_step_id["root.finally.cleanup.z"]
+    assert [slot.region.value for slot in finalization] == ["finalization"]
+    loop_local = index.candidates_by_step_id["root.l#0.body.b"]
+    assert [(slot.presentation_key, slot.iteration_index) for slot in loop_local] == [("L[0].B", 0)]
+    assert set(index.candidates_by_step_id) >= {"root.f#0.c", "root.f#1.c"}
+
+
+def test_iterations_the_bookkeeping_does_not_make_legal_have_no_candidates(projection) -> None:
+    index = projection.enumerate_resume_slots(valid_state())
+
+    assert "root.l#1.body.b" not in index.candidates_by_step_id
+    assert "root.l.body.b" not in index.candidates_by_step_id
+
+
+def test_call_boundaries_resolve_by_exact_runtime_id_only(projection) -> None:
+    index = projection.enumerate_resume_slots(valid_state())
+
+    top = projection.resolve_call_boundary(index, "root.call")
+    assert isinstance(top.boundary, CallBoundaryProjection)
+    assert (top.boundary.import_alias, top.candidate_count) == ("lib", 1)
+    loop_local = projection.resolve_call_boundary(index, "root.l#0.body.c2")
+    assert loop_local.boundary is not None and loop_local.boundary.import_alias == "lib"
+    for stale in ("root.l#1.body.c2", "root.cal", "root.call::visit::1", None, ["root.call"]):
+        resolution = projection.resolve_call_boundary(index, stale)
+        assert (resolution.boundary, resolution.candidate_count) == (None, 0)
+
+
+def test_resolve_resume_step_id_reports_presentation_mismatch_without_selecting(projection) -> None:
+    index = projection.enumerate_resume_slots(valid_state())
+
+    exact = projection.resolve_resume_step_id(index, "root.a", "A")
+    assert exact.slot is not None and exact.slot.node_id == "root.a"
+    mismatch = projection.resolve_resume_step_id(index, "root.a", "Other")
+    assert (mismatch.slot, mismatch.candidate_count) == (None, 1)
+    assert mismatch.exact_identity_candidate_count == 1
+    for unusable in ("missing", ["root.a"], {"a": 1}, 3, None):
+        resolution = projection.resolve_resume_step_id(index, unusable)
+        assert (resolution.slot, resolution.candidate_count) == (None, 0)
+
+
+def test_unclaimed_explicit_rows_are_snapshotted_even_when_unhashable(projection) -> None:
+    state = valid_state()
+    state["steps"]["Ghost"] = {"step_id": "root.a"}
+    state["steps"]["Weird"] = {"step_id": ["root", "a"]}
+
+    index = projection.enumerate_resume_slots(state)
+
+    assert ("Ghost", "root.a") in index.unclaimed_explicit_rows
+    assert ("Weird", ("root", "a")) in index.unclaimed_explicit_rows
+    assert all(name != "A" for name, _ in index.unclaimed_explicit_rows)
+
+
+def test_enumeration_never_mutates_or_backfills_the_state(projection) -> None:
+    state = valid_state()
+    state["steps"]["A"].pop("step_id")
+    before = copy.deepcopy(state)
+
+    projection.enumerate_resume_slots(state)
+
+    assert state == before
+
+
+def _mutated(mutate):
+    state = valid_state()
+    mutate(state)
+    return state
+
+
+def _terminal_exhaustion(state, *, exhausted, frame):
+    state["repeat_until"]["L"] = {
+        "current_iteration": None,
+        "completed_iterations": [0, 1, 2],
+        "condition_evaluated_for_iteration": 2,
+        "last_condition_result": False,
+        **({"exhausted": True} if exhausted else {}),
+    }
+    state["steps"]["L"] = frame
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason", "message"),
+    [
+        (lambda s: s.update(for_each=[]), "unsupported_shape", "for_each must be a mapping"),
+        (lambda s: s["for_each"].update(F=[]), "unsupported_shape", "for_each.F must be a mapping"),
+        (lambda s: s["for_each"]["F"].update(items="x"), "unsupported_shape", "for_each.F.items must be a list"),
+        (
+            lambda s: s["for_each"]["F"].update(current_index=True),
+            "unsupported_shape",
+            "for_each.F.current_index must be null or a non-boolean integer",
+        ),
+        (lambda s: s.update(repeat_until=[]), "unsupported_shape", "repeat_until must be a mapping"),
+        (lambda s: s["repeat_until"].update(L=[]), "unsupported_shape", "repeat_until.L must be a mapping"),
+        (
+            lambda s: s["repeat_until"]["L"].update(current_iteration="0"),
+            "unsupported_shape",
+            "repeat_until.L.current_iteration must be null or a non-boolean integer",
+        ),
+        (
+            lambda s: s["repeat_until"]["L"].update(exhausted="yes"),
+            "unsupported_shape",
+            "repeat_until.L.exhausted must be boolean when present",
+        ),
+        (
+            lambda s: s["for_each"]["F"].update(completed_indices=[0, 0], current_index=1),
+            "invalid_loop_progress",
+            "for_each.F.completed_indices must not contain duplicate indices",
+        ),
+        (
+            lambda s: s["for_each"]["F"].update(completed_indices=[5]),
+            "invalid_loop_progress",
+            "for_each.F.completed_indices contains an out-of-range index",
+        ),
+        (
+            lambda s: s["for_each"]["F"].update(completed_indices=[1], current_index=1),
+            "invalid_loop_progress",
+            "for_each.F.current_index is already completed",
+        ),
+        (
+            lambda s: s["repeat_until"]["L"].update(completed_iterations=[0, 0]),
+            "invalid_loop_progress",
+            "repeat_until.L.completed_iterations must not contain duplicate indices",
+        ),
+        (
+            lambda s: s["repeat_until"]["L"].update(current_iteration=3, completed_iterations=[0, 1, 2]),
+            "invalid_loop_progress",
+            "repeat_until.L.current_iteration is out of range",
+        ),
+        (
+            lambda s: s["repeat_until"]["L"].update(current_iteration=2, completed_iterations=[0]),
+            "invalid_loop_progress",
+            "repeat_until.L.completed_iterations is not valid prior history",
+        ),
+        (
+            lambda s: s["repeat_until"]["L"].update(last_condition_result=True),
+            "invalid_loop_progress",
+            "repeat_until.L condition result conflicts with evaluation state",
+        ),
+        (
+            lambda s: s["repeat_until"]["L"].update(
+                current_iteration=None, completed_iterations=[], last_condition_result=True
+            ),
+            "invalid_loop_progress",
+            "repeat_until.L terminal progress requires completed evaluated history",
+        ),
+        (
+            lambda s: _terminal_exhaustion(s, exhausted=True, frame={"status": "failed"}),
+            "invalid_loop_progress",
+            "repeat_until.L successful exhaustion requires a completed frame",
+        ),
+        (
+            lambda s: _terminal_exhaustion(
+                s, exhausted=False, frame={"status": "failed", "error": {"type": "other"}}
+            ),
+            "invalid_loop_progress",
+            "repeat_until.L failed exhaustion requires the terminal exhaustion error",
+        ),
+    ],
+)
+def test_invalid_loop_bookkeeping_reports_exact_reason_and_message(projection, mutate, reason, message) -> None:
+    with pytest.raises(ResumeProjectionValidationError) as excinfo:
+        projection.enumerate_resume_slots(_mutated(mutate))
+
+    assert excinfo.value.reason == reason
+    assert excinfo.value.message == message
+    assert str(excinfo.value) == message
+
+
+@pytest.mark.parametrize("exhausted_form", ["success", "failure", "condition"])
+def test_valid_terminal_repeat_until_forms_are_accepted(projection, exhausted_form) -> None:
+    state = valid_state()
+    progress = {
+        "current_iteration": None,
+        "completed_iterations": [0, 1, 2],
+        "condition_evaluated_for_iteration": 2,
+        "last_condition_result": False,
+    }
+    if exhausted_form == "success":
+        progress["exhausted"] = True
+        state["steps"]["L"] = {"status": "completed"}
+    elif exhausted_form == "failure":
+        state["steps"]["L"] = {"status": "failed", "error": {"type": "repeat_until_iterations_exhausted"}}
+    else:
+        progress.update(completed_iterations=[0], condition_evaluated_for_iteration=0, last_condition_result=True)
+    state["repeat_until"]["L"] = progress
+
+    index = projection.enumerate_resume_slots(state)
+
+    assert "root.l#0.body.b" in index.candidates_by_step_id
+    json.dumps(index.unclaimed_explicit_rows)  # snapshot stays serialisable

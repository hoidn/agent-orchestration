+
+def test_completed_frame_colliding_with_the_resumed_call_frame_is_rejected_first(tmp_path: Path) -> None:
+    bundle, manager = _completed_call_graph_run(tmp_path, "ordering-collision")
+    state = manager.load()
+    frame_id, frame = next(iter(state.call_frames.items()))
+    frame["call_step_id"] = "root.some_other_call"
+    state.status = "failed"
+    state.steps["InvokeMiddle"]["status"] = "failed"
+    state.steps.pop("InvokeMiddle")
+    state.step_visits["InvokeMiddle"] = 1
+    manager._write_state()
+    before_frames = json.loads(json.dumps(manager.load().call_frames))
+    executor = WorkflowExecutor(bundle, tmp_path, manager)
+    executor.resume_mode = True
+
+    def unexpected(*_args, **_kwargs):
+        raise AssertionError("collision reached child construction")
+
+    step = materialize_projection_body_steps(bundle)[0]
+    with patch.object(call_frame_state, "_CallFrameStateManager", side_effect=unexpected), patch.object(
+        executor_module, "WorkflowExecutor", side_effect=unexpected
+    ):
+        result = executor.call_executor.execute_call(step, manager.load().to_dict())
+
+    assert result["error"]["type"] == "contract_violation"
+    assert result["error"]["context"] == {
+        "step": "InvokeMiddle",
+        "call": "middle",
+        "call_frame_id": frame_id,
+        "reason": "call_resume_state_invalid",
+        "detail": "completed_call_frame_id_collision",
+    }
+    assert manager.load().call_frames == before_frames
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason"),
+    [
+        (lambda path, manager: path.write_text(path.read_text() + "\n# edited\n"), "workflow_modified"),
+        (lambda path, manager: path.unlink(), "workflow_unavailable"),
+    ],
+)
+def test_structural_root_checksum_recheck_persists_only_the_envelope(tmp_path: Path, mutate, reason) -> None:
+    bundle, manager = _completed_call_graph_run(tmp_path, f"checksum-{reason}")

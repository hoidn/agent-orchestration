index 0000000..a3323b8
--- /dev/null
+++ b/orchestrator/workflow/resume_loop_integrity.py
@@ -0,0 +1,176 @@
+"""Loop bookkeeping validation for checksum-compatible resume.
+
+Pure functions over persisted ``for_each`` / ``repeat_until`` bookkeeping.
+Each validator returns the iteration indices the bookkeeping makes legal for
+every loop, or raises ``ResumeProjectionValidationError``. Nothing is mutated.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+UNSUPPORTED_SHAPE = "unsupported_shape"
+INVALID_LOOP_PROGRESS = "invalid_loop_progress"
+EXHAUSTION_ERROR_TYPE = "repeat_until_iterations_exhausted"
+
+
+class ResumeProjectionValidationError(ValueError):
+    """Persisted bookkeeping cannot be mapped onto the current projection."""
+
+    def __init__(self, reason: str, message: str) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+
+
+def _fail(reason: str, message: str) -> ResumeProjectionValidationError:
+    return ResumeProjectionValidationError(reason, message)
+
+
+def _is_index(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _optional_index(value: Any, path: str) -> Optional[int]:
+    if value is not None and not _is_index(value):
+        raise _fail(UNSUPPORTED_SHAPE, f"{path} must be null or a non-boolean integer")
+    return value
+
+
+def _loop_mapping(container: Any, kind: str) -> Mapping[str, Any]:
+    if container is None:
+        return {}
+    if not isinstance(container, Mapping):
+        raise _fail(UNSUPPORTED_SHAPE, f"{kind} must be a mapping")
+    for name, progress in container.items():
+        if not isinstance(progress, Mapping):
+            raise _fail(UNSUPPORTED_SHAPE, f"{kind}.{name} must be a mapping")
+    return container
+
+
+def _index_list(value: Any, path: str, malformed: str) -> list[int]:
+    if value is None:
+        return []
+    if not isinstance(value, list):
+        raise _fail(UNSUPPORTED_SHAPE, f"{path} must be a list")
+    if not all(_is_index(item) for item in value):
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path} {malformed}")
+    if len(set(value)) != len(value):
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path} must not contain duplicate indices")
+    return value
+
+
+def validate_for_each_progress(for_each: Any) -> dict[str, frozenset[int]]:
+    """Return legal iteration indices per ``for_each`` loop name."""
+    legal: dict[str, frozenset[int]] = {}
+    for name, progress in _loop_mapping(for_each, "for_each").items():
+        path = f"for_each.{name}"
+        items = progress.get("items")
+        if not isinstance(items, list):
+            raise _fail(UNSUPPORTED_SHAPE, f"{path}.items must be a list")
+        current = _optional_index(progress.get("current_index"), f"{path}.current_index")
+        completed = _index_list(
+            progress.get("completed_indices"), f"{path}.completed_indices", "contains an out-of-range index"
+        )
+        if any(index < 0 or index >= len(items) for index in completed):
+            raise _fail(INVALID_LOOP_PROGRESS, f"{path}.completed_indices contains an out-of-range index")
+        if current is not None:
+            if current < 0 or current >= len(items):
+                raise _fail(INVALID_LOOP_PROGRESS, f"{path}.current_index is out of range")
+            if current in completed:
+                raise _fail(INVALID_LOOP_PROGRESS, f"{path}.current_index is already completed")
+        legal[name] = frozenset(completed) | (frozenset() if current is None else frozenset({current}))
+    return legal
+
+
+def _check_terminal(
+    path: str,
+    completed: list[int],
+    evaluated: Optional[int],
+    result: Optional[bool],
+    exhausted: bool,
+    frame: Any,
+    max_iterations: Optional[int],
+) -> None:
+    if not completed or evaluated is None or evaluated != max(completed):
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path} terminal progress requires completed evaluated history")
+    if sorted(completed) != list(range(evaluated + 1)):
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path}.completed_iterations is not valid prior history")
+    if result is True:
+        if exhausted:
+            raise _fail(INVALID_LOOP_PROGRESS, f"{path} condition result conflicts with evaluation state")
+        return
+    if result is not False:
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path} condition result conflicts with evaluation state")
+    if max_iterations is not None and len(completed) != max_iterations:
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path}.completed_iterations is not valid prior history")
+    if frame is None:
+        return  # the loop frame row is re-derived on resume; nothing to cross-check
+    status = frame.get("status") if isinstance(frame, Mapping) else None
+    if exhausted:
+        if status != "completed":
+            raise _fail(INVALID_LOOP_PROGRESS, f"{path} successful exhaustion requires a completed frame")
+        return
+    error = frame.get("error") if isinstance(frame, Mapping) else None
+    error_type = error.get("type") if isinstance(error, Mapping) else None
+    if status != "failed" or error_type != EXHAUSTION_ERROR_TYPE:
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path} failed exhaustion requires the terminal exhaustion error")
+
+
+def _check_active(
+    path: str,
+    current: int,
+    completed: list[int],
+    evaluated: Optional[int],
+    result: Optional[bool],
+    max_iterations: Optional[int],
+) -> None:
+    if current < 0 or (max_iterations is not None and current >= max_iterations):
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path}.current_iteration is out of range")
+    if current in completed:
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path}.current_iteration is out of range")
+    if sorted(completed) != list(range(current)):
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path}.completed_iterations is not valid prior history")
+    if evaluated is None:
+        consistent = result is None
+    else:
+        consistent = evaluated == current and result is not None
+    if not consistent:
+        raise _fail(INVALID_LOOP_PROGRESS, f"{path} condition result conflicts with evaluation state")
+
+
+def validate_repeat_until_progress(
+    repeat_until: Any,
+    steps: Mapping[str, Any],
+    max_iterations_by_loop: Mapping[str, Optional[int]],
+) -> dict[str, frozenset[int]]:
+    """Return legal iteration indices per ``repeat_until`` loop name."""
+    legal: dict[str, frozenset[int]] = {}
+    for name, progress in _loop_mapping(repeat_until, "repeat_until").items():
+        path = f"repeat_until.{name}"
+        current = _optional_index(progress.get("current_iteration"), f"{path}.current_iteration")
+        evaluated = _optional_index(
+            progress.get("condition_evaluated_for_iteration"),
+            f"{path}.condition_evaluated_for_iteration",
+        )
+        result = progress.get("last_condition_result")
+        if result is not None and not isinstance(result, bool):
+            raise _fail(UNSUPPORTED_SHAPE, f"{path}.last_condition_result must be null or boolean")
+        exhausted = progress.get("exhausted", False)
+        if not isinstance(exhausted, bool):
+            raise _fail(UNSUPPORTED_SHAPE, f"{path}.exhausted must be boolean when present")
+        completed = _index_list(
+            progress.get("completed_iterations"),
+            f"{path}.completed_iterations",
+            "is not valid prior history",
+        )
+        max_iterations = max_iterations_by_loop.get(name)
+        if current is None:
+            _check_terminal(
+                path, completed, evaluated, result, exhausted, steps.get(name), max_iterations
+            )
+            legal[name] = frozenset(completed)
+        else:
+            _check_active(path, current, completed, evaluated, result, max_iterations)
+            legal[name] = frozenset(completed) | {current}
+    return legal
diff --git a/orchestrator/workflow/resume_projection_integrity.py b/orchestrator/workflow/resume_projection_integrity.py

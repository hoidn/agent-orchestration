@@ -0,0 +1,44 @@
+"""Typed Workflow Lisp provenance on every compiled bundle."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow.loaded_bundle import LoadedWorkflowBundle
+from tests.resume_projection_helpers import LIB_WORKFLOW, write_yaml
+from tests.workflow_lisp_characterization import _compile_case, load_characterization_cases
+
+
+def _walk_imports(bundle: LoadedWorkflowBundle, seen: dict[int, LoadedWorkflowBundle]) -> None:
+    for imported in bundle.imports.values():
+        if id(imported) not in seen:
+            seen[id(imported)] = imported
+            _walk_imports(imported, seen)
+
+
+def test_compiled_imported_and_lowered_bundles_are_workflow_lisp_but_classic_imports_are_not(
+    tmp_path: Path,
+) -> None:
+    case = next(case for case in load_characterization_cases() if case.case_id == "module_graph_imported_bundle_mix")
+
+    compiled = _compile_case(case, tmp_path, lowering_route="legacy")
+
+    classic_ids = {id(binding.bundle) for binding in compiled["imported_workflow_bundles"]}
+    assert classic_ids
+    for bundle in compiled["compile_result"].validated_bundles.values():
+        assert bundle.provenance.frontend_kind == "workflow_lisp"
+        reachable: dict[int, LoadedWorkflowBundle] = {}
+        _walk_imports(bundle, reachable)
+        for identity, imported in reachable.items():
+            if identity in classic_ids:
+                # classic YAML imports are linked as the very same object, untouched
+                assert imported.provenance.frontend_kind is None
+            else:
+                assert imported.provenance.frontend_kind == "workflow_lisp"
+
+
+def test_classic_yaml_bundle_keeps_its_own_provenance_when_loaded_directly(tmp_path: Path) -> None:
+    classic = WorkflowLoader(tmp_path).load_bundle(write_yaml(tmp_path / "lib.yaml", LIB_WORKFLOW))
+
+    assert classic.provenance.frontend_kind is None

@@ -0,0 +1,301 @@
+"""Ordering and envelope behaviour of the resume projection audit.
+
+Observation points are the module-level `audit_scope` names in
+`orchestrator.workflow.executor` and `orchestrator.workflow.calls`, plus the
+public state-manager envelope entries.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import replace
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+import orchestrator.workflow.call_frame_state as call_frame_state
+import orchestrator.workflow.calls as calls_module
+import orchestrator.workflow.executor as executor_module
+from orchestrator.loader import WorkflowLoader
+from orchestrator.state import StateManager
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.state_projection import WorkflowStateProjection
+from tests.test_subworkflow_calls import _write_projection_integrity_call_graph
+from tests.workflow_bundle_helpers import bundle_context_dict, materialize_projection_body_steps
+
+
+def _completed_call_graph_run(tmp_path: Path, run_id: str):
+    bundle = WorkflowLoader(tmp_path).load_bundle(_write_projection_integrity_call_graph(tmp_path))
+    manager = StateManager(tmp_path, run_id=run_id)
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    assert WorkflowExecutor(bundle, tmp_path, manager).execute()["status"] == "completed"
+    return bundle, manager
+
+
+def _reopen_as_failed_running_frame(manager: StateManager) -> str:
+    state = manager.load()
+    frame_id, frame = next(iter(state.call_frames.items()))
+    frame["status"] = "running"
+    frame["state"]["status"] = "failed"
+    frame["state"]["steps"]["InvokeLeaf"]["status"] = "failed"
+    next(iter(frame["state"]["call_frames"].values()))["status"] = "running"
+    state.status = "failed"
+    state.steps["InvokeMiddle"]["status"] = "failed"
+    manager._write_state()
+    return frame_id
+
+
+def test_reached_call_checks_checksum_then_audits_callee_before_any_frame_is_constructed(tmp_path: Path) -> None:
+    bundle, manager = _completed_call_graph_run(tmp_path, "ordering-reached-call")
+    frame_id = _reopen_as_failed_running_frame(manager)
+    events: list[tuple] = []
+    original_checksum = CallExecutor.validate_resume_checksum
+    original_audit = calls_module.audit_scope
+    original_init = call_frame_state._CallFrameStateManager.__init__
+
+    def record_checksum(self, **kwargs):
+        events.append(("checksum", kwargs["frame_id"]))
+        return original_checksum(self, **kwargs)
+
+    def record_audit(audited_bundle, state, scope_path):
+        events.append(("audit", scope_path.call_frame_ids))
+        return original_audit(audited_bundle, state, scope_path)
+
+    def record_init(self, **kwargs):
+        events.append(("frame.construct", kwargs["frame_id"]))
+        return original_init(self, **kwargs)
+
+    with patch.object(CallExecutor, "validate_resume_checksum", record_checksum), patch(
+        "orchestrator.workflow.calls.audit_scope", new=record_audit
+    ), patch.object(call_frame_state._CallFrameStateManager, "__init__", record_init):
+        resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+    assert resumed["status"] in {"completed", "failed"}
+    assert events[:3] == [
+        ("checksum", frame_id),
+        ("audit", (frame_id,)),
+        ("frame.construct", frame_id),
+    ]
+    # Nested scopes repeat the same rule one frame deeper, again before construction.
+    nested = [event for event in events[3:] if event[0] == "audit"]
+    assert nested and all(len(event[1]) == 2 and event[1][0] == frame_id for event in nested)
+
+
+def test_reached_call_resolves_its_caller_identity_once_with_positional_arguments(tmp_path: Path) -> None:
+    bundle, manager = _completed_call_graph_run(tmp_path, "ordering-resolve-once")

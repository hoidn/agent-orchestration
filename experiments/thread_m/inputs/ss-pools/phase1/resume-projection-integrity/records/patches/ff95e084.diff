+
+def test_retry_marker_inside_a_parent_frame_prefix_is_not_a_retry_of_this_frame() -> None:
+    nested = f"{BASE}::retry::1.{BOUNDARY}::visit::1"
+
+    lineage = _index({nested: _frame("running")})
+
+    assert lineage.base_frame_id == nested
+    assert lineage.running_member is not None and lineage.running_member.ordinal == 0

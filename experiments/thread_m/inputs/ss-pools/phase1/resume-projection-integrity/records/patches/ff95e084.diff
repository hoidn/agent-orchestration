+"""`resume_projection_integrity_error` is a sticky, non-routable terminal failure."""
+
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+from typing import Any
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.observability.report import build_status_snapshot, render_status_markdown
+from orchestrator.state import StateManager
+from orchestrator.workflow.calls import CallExecutor
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.resume_projection_helpers import LIB_WORKFLOW, write_yaml
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+DIAGNOSTIC = {
+    "type": "resume_projection_integrity_error",
+    "message": "Resume projection integrity audit failed: out_of_scope_step_id",
+    "context": {"diagnostic_schema": "resume_projection_integrity_error.v1", "reason": "out_of_scope_step_id"},
+}
+FAILED_CALL = {"status": "failed", "exit_code": 2, "duration_ms": 0, "error": DIAGNOSTIC}
+MARKER = "state/marker.txt"
+
+
+def _marker_step(name: str) -> dict:
+    return {"name": name, "id": name.lower(), "command": ["bash", "-lc", f"mkdir -p state && echo {name} >> {MARKER}"]}
+
+
+def _run(tmp_path: Path, workflow: dict, *, on_error: str = "stop", call_result: dict | None = None):
+    write_yaml(tmp_path / "lib.yaml", LIB_WORKFLOW)
+    workflow = {"version": "2.7", "name": "sticky", "imports": {"lib": "lib.yaml"}, **workflow}
+    bundle = WorkflowLoader(tmp_path).load_bundle(write_yaml(tmp_path / "workflow.yaml", workflow))
+    manager = StateManager(tmp_path, run_id="sticky")
+    manager.initialize("workflow.yaml", context=bundle_context_dict(bundle))
+    result = call_result if call_result is not None else FAILED_CALL
+    with patch.object(CallExecutor, "execute_call", return_value=copy.deepcopy(result)) as execute_call:
+        state = WorkflowExecutor(bundle, tmp_path, manager).execute(on_error=on_error)
+    return state, manager.load().to_dict(), execute_call, tmp_path / MARKER
+
+
+def _markers(path: Path) -> list[str]:
+    return path.read_text().split() if path.exists() else []
+
+
+@pytest.mark.parametrize("route", ["failure", "always"])
+def test_authored_routes_cannot_consume_the_diagnostic(tmp_path: Path, route: str) -> None:
+    call = {"name": "Call", "id": "call", "call": "lib", "on": {route: {"goto": "Recover"}}}
+
+    state, persisted, _, marker = _run(
+        tmp_path,
+        {"steps": [call, {"name": "Skipped", "id": "skipped", "command": ["true"]}, _marker_step("Recover")]},
+    )
+
+    assert _markers(marker) == []
+    assert state["status"] == "failed" and persisted["status"] == "failed"
+    assert persisted["error"] == DIAGNOSTIC
+
+
+def test_on_error_continue_cannot_consume_the_diagnostic(tmp_path: Path) -> None:
+    state, persisted, _, marker = _run(
+        tmp_path,
+        {"steps": [{"name": "Call", "id": "call", "call": "lib"}, _marker_step("After")]},
+        on_error="continue",
+    )
+
+    assert _markers(marker) == []
+    assert persisted["status"] == "failed" and persisted["error"] == DIAGNOSTIC
+
+
+def test_for_each_stops_without_scheduling_the_next_iteration(tmp_path: Path) -> None:
+    workflow = {
+        "steps": [
+            {
+                "name": "Each",
+                "id": "each",
+                "for_each": {
+                    "items": ["a", "b", "c"],
+                    "steps": [{"name": "Call", "id": "call", "call": "lib"}],
+                },
+            },
+            _marker_step("After"),
+        ]
+    }
+
+    state, persisted, execute_call, marker = _run(tmp_path, workflow, on_error="continue")
+
+    assert execute_call.call_count == 1
+    assert _markers(marker) == []
+    assert persisted["status"] == "failed" and persisted["error"] == DIAGNOSTIC
+    assert persisted["for_each"]["Each"]["completed_indices"] == []
+
+
+def test_repeat_until_stops_and_promotes_the_diagnostic_unwrapped(tmp_path: Path) -> None:
+    workflow = {
+        "artifacts": {"v": {"kind": "scalar", "type": "integer"}},
+        "steps": [
+            {
+                "name": "Loop",
+                "id": "loop",
+                "repeat_until": {
+                    "id": "body",
+                    "max_iterations": 3,
+                    "outputs": {
+                        "o": {
+                            "kind": "scalar",
+                            "type": "integer",
+                            "from": {"ref": "self.steps.Set.artifacts.v"},
+                        }
+                    },
+                    "condition": {
+                        "compare": {"left": {"ref": "self.outputs.o"}, "op": "eq", "right": 1}
+                    },
+                    "steps": [
+                        {"name": "Call", "id": "call", "call": "lib"},
+                        {"name": "Set", "id": "set", "set_scalar": {"artifact": "v", "value": 1}},
+                    ],
+                },
+            },
+            _marker_step("After"),
+        ],
+    }
+
+    state, persisted, execute_call, marker = _run(tmp_path, workflow, on_error="continue")
+
+    assert execute_call.call_count == 1
+    assert _markers(marker) == []
+    assert persisted["steps"]["Loop"]["error"] == DIAGNOSTIC
+    assert persisted["error"] == DIAGNOSTIC
+
+
+def test_cleanup_runs_but_its_failure_is_supplemental(tmp_path: Path) -> None:
+    workflow = {
+        "steps": [{"name": "Call", "id": "call", "call": "lib"}],
+        "finally": {
+            "id": "cleanup",
+            "steps": [
+                _marker_step("Cleanup"),
+                {"name": "Broken", "id": "broken", "command": ["bash", "-lc", "exit 3"]},
+            ],
+        },
+    }
+
+    state, persisted, _, marker = _run(tmp_path, workflow)
+
+    assert _markers(marker) == ["Cleanup"]
+    assert persisted["status"] == "failed"
+    assert persisted["error"] == DIAGNOSTIC
+    finalization = persisted["finalization"]
+    assert finalization["status"] == "failed"
+    assert finalization["failure"]["step"] == "finally.Broken"
+    assert finalization["failure"]["step_id"] == "root.finally.cleanup.broken"
+    assert finalization["failure"]["error"] is None
+
+
+def test_projection_error_arising_only_in_cleanup_becomes_the_run_error(tmp_path: Path) -> None:
+    workflow = {
+        "steps": [{"name": "Body", "id": "body", "command": ["true"]}],
+        "finally": {"id": "cleanup", "steps": [{"name": "CleanupStep", "id": "cleanup_step", "command": ["true"]}]},
+    }
+    original = WorkflowExecutor._execute_command_with_context
+
+    def projection_failure_in_cleanup(executor, step, context, state, **kwargs):
+        if step.get("name") == "finally.CleanupStep":
+            return copy.deepcopy(FAILED_CALL)
+        return original(executor, step, context, state, **kwargs)
+
+    with patch.object(WorkflowExecutor, "_execute_command_with_context", projection_failure_in_cleanup):
+        state, persisted, _, _ = _run(tmp_path, workflow)
+
+    assert persisted["status"] == "failed"
+    assert persisted["error"] == DIAGNOSTIC
+    assert persisted["finalization"]["status"] == "failed"
+    assert persisted["finalization"]["failure"] == {
+        "step": "finally.CleanupStep",
+        "step_id": "root.finally.cleanup.cleanup_step",
+        "error": DIAGNOSTIC,
+    }
+
+
+@pytest.mark.parametrize("error_type", ["resume_projection_integrity_error", "workflow_checksum_mismatch"])
+def test_forensic_current_step_is_pending_not_live(tmp_path: Path, error_type: str) -> None:
+    bundle = WorkflowLoader(tmp_path).load_bundle(
+        write_yaml(
+            tmp_path / "workflow.yaml",
+            {
+                "version": "2.7",
+                "name": "forensic",
+                "steps": [
+                    {"name": "First", "id": "first", "command": ["true"]},
+                    {"name": "Second", "id": "second", "command": ["true"]},
+                ],
+            },
+        )
+    )
+    state: dict[str, Any] = {
+        "run_id": "r",
+        "status": "failed",
+        "updated_at": "2026-01-01T00:00:00+00:00",
+        "error": {"type": error_type, "message": "m", "context": {}},
+        "current_step": {
+            "name": "Second",
+            "step_id": "root.second",
+            "status": "running",
+            "visit_count": 1,
+            "started_at": "2026-01-01T00:00:00+00:00",
+            "last_heartbeat_at": "2026-01-01T00:00:01+00:00",
+        },
+        "steps": {"First": {"status": "completed", "exit_code": 0}},
+        "step_visits": {"Second": 1},
+    }
+
+    snapshot = build_status_snapshot(bundle, state, tmp_path / "run")
+
+    second = next(step for step in snapshot["steps"] if step["name"] == "Second")
+    assert (second["status"], second["summary"], second["current_visit_count"]) == ("pending", "pending", None)
+    assert snapshot["run"]["status"] == "failed"
+    assert snapshot["progress"]["running"] == 0 and snapshot["progress"]["pending"] == 1
+    assert "in progress" not in render_status_markdown(snapshot)
+
+    live = dict(state, error={"type": "other", "message": "m"})
+    live_second = next(s for s in build_status_snapshot(bundle, live, tmp_path / "run")["steps"] if s["name"] == "Second")
+    assert live_second["status"] == "running"

+"""Shared fixtures for checksum-compatible resume projection integrity tests."""
+
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+from typing import Any, Callable
+
+import yaml
+
+from orchestrator.loader import WorkflowLoader
+from orchestrator.workflow.resume_projection_integrity import (
+    ResumeProjectionIntegrityError,
+    ResumeScopePath,
+    audit_scope,
+)
+
+LIB_WORKFLOW = {
+    "version": "2.7",
+    "name": "lib",
+    "steps": [{"name": "X", "id": "x", "command": ["true"]}],
+}
+
+
+def write_yaml(path: Path, payload: dict) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
+    return path
+
+
+def build_projection_bundle(workspace: Path):
+    """Load a workflow with a plain step, a call, a repeat_until, a for_each and cleanup."""
+    write_yaml(workspace / "lib.yaml", LIB_WORKFLOW)
+    workflow = {
+        "version": "2.7",
+        "name": "projection-shapes",
+        "imports": {"lib": "lib.yaml"},
+        "artifacts": {"v": {"kind": "scalar", "type": "integer"}},
+        "steps": [
+            {"name": "A", "id": "a", "command": ["echo", "a"]},
+            {"name": "Call", "id": "call", "call": "lib"},
+            {
+                "name": "L",
+                "id": "l",
+                "repeat_until": {
+                    "id": "body",
+                    "max_iterations": 3,
+                    "outputs": {
+                        "o": {
+                            "kind": "scalar",
+                            "type": "integer",
+                            "from": {"ref": "self.steps.B.artifacts.v"},
+                        }
+                    },
+                    "condition": {
+                        "compare": {"left": {"ref": "self.outputs.o"}, "op": "eq", "right": 1}
+                    },
+                    "steps": [
+                        {"name": "B", "id": "b", "set_scalar": {"artifact": "v", "value": 1}},
+                        {"name": "C2", "id": "c2", "call": "lib"},
+                    ],
+                },
+            },
+            {
+                "name": "F",
+                "id": "f",
+                "for_each": {
+                    "items": [1, 2],
+                    "steps": [{"name": "C", "id": "c", "command": ["true"]}],
+                },
+            },
+        ],
+        "finally": {
+            "id": "cleanup",
+            "steps": [{"name": "Z", "id": "z", "command": ["true"]}],
+        },
+    }
+    path = write_yaml(workspace / "w.yaml", workflow)
+    return WorkflowLoader(workspace).load_bundle(path)
+
+
+def valid_state() -> dict[str, Any]:
+    """A persisted state the projection built by `build_projection_bundle` fully owns."""
+    return {
+        "workflow_checksum": "sha256:" + "0" * 64,
+        "steps": {
+            "A": {"step_id": "root.a", "status": "completed"},
+            "L[0].B": {"step_id": "root.l#0.body.b", "status": "completed"},
+        },
+        "repeat_until": {
+            "L": {
+                "current_iteration": 0,
+                "completed_iterations": [],
+                "condition_evaluated_for_iteration": None,
+                "last_condition_result": None,
+            }
+        },
+        "for_each": {
+            "F": {"items": [1, 2], "completed_indices": [0], "current_index": 1}
+        },
+        "current_step": {"name": "A", "step_id": "root.a"},
+        "call_frames": {
+            "root.call::visit::1": {
+                "call_step_id": "root.call",
+                "import_alias": "lib",
+                "status": "completed",
+            }
+        },
+    }
+
+
+def audit_error(bundle, state: dict[str, Any], mutate: Callable[[dict], None]):
+    """Apply `mutate` to a copy of `state`, audit it, and return the raised diagnostic."""
+    mutated = copy.deepcopy(state)
+    mutate(mutated)
+    try:
+        audit_scope(bundle, mutated, ResumeScopePath.root("w.yaml"))
+    except ResumeProjectionIntegrityError as exc:
+        return exc.error
+    return None

diff --git a/orchestrator/loader_yaml_positions.py b/orchestrator/loader_yaml_positions.py
new file mode 100644
index 0000000..1cc174d
--- /dev/null
+++ b/orchestrator/loader_yaml_positions.py
@@ -0,0 +1,76 @@
+"""Source-positioned YAML loading for classic-workflow `imports` integrity.
+
+PyYAML silently keeps the last of duplicate mapping keys and flattens `<<` merges,
+so a repeated import alias or `imports` section would vanish before validation.
+This module composes the node graph first, reports every effective repeat with its
+source position, and then constructs the document exactly as `yaml.load` would.
+"""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import Any, Iterator, TextIO
+
+import yaml
+
+MERGE_TAG = "tag:yaml.org,2002:merge"
+
+
+def _effective_pairs(node: yaml.MappingNode) -> Iterator[tuple[yaml.Node, yaml.Node]]:
+    """Yield (key, value) node pairs of a mapping with `<<` merge sources expanded."""
+    for key_node, value_node in node.value:
+        if key_node.tag != MERGE_TAG:
+            yield key_node, value_node
+        elif isinstance(value_node, yaml.MappingNode):
+            yield from _effective_pairs(value_node)
+        elif isinstance(value_node, yaml.SequenceNode):
+            for source in value_node.value:
+                if isinstance(source, yaml.MappingNode):
+                    yield from _effective_pairs(source)
+
+
+def _position(node: yaml.Node) -> tuple[int, int]:
+    return node.start_mark.line + 1, node.start_mark.column + 1
+
+
+def _render(positions: list[tuple[int, int]]) -> str:
+    return "; ".join(f"line {line}, column {column}" for line, column in sorted(positions))
+
+
+def duplicate_import_errors(root: yaml.Node | None) -> list[str]:
+    """Return validation messages for repeated import aliases or `imports` sections."""
+    if not isinstance(root, yaml.MappingNode):
+        return []
+    sections = [
+        (key_node, value_node)
+        for key_node, value_node in _effective_pairs(root)
+        if isinstance(key_node, yaml.ScalarNode) and key_node.value == "imports"
+    ]
+    alias_positions: dict[str, list[tuple[int, int]]] = defaultdict(list)
+    for _key_node, value_node in sections:
+        if not isinstance(value_node, yaml.MappingNode):
+            continue
+        for alias_node, _path_node in _effective_pairs(value_node):
+            if isinstance(alias_node, yaml.ScalarNode):
+                alias_positions[alias_node.value].append(_position(alias_node))
+    errors = [
+        f"imports.{alias}: duplicate import alias ({_render(positions)})"
+        for alias, positions in alias_positions.items()
+        if len(positions) > 1
+    ]
+    if not errors and len(sections) > 1:
+        positions = [_position(key_node) for key_node, _value_node in sections]
+        errors.append(f"imports: duplicate top-level mapping ({_render(positions)})")
+    return errors
+
+
+def load_yaml_with_import_errors(stream: TextIO, loader_cls: type) -> tuple[Any, list[str]]:
+    """Like `yaml.load(stream, Loader=loader_cls)`, plus duplicate-import messages."""
+    loader = loader_cls(stream)
+    try:
+        root = loader.get_single_node()
+        if root is None:
+            return None, []
+        return loader.construct_document(root), duplicate_import_errors(root)
+    finally:
+        loader.dispose()

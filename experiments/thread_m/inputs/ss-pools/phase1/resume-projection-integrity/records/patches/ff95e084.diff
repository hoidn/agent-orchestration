index 0000000..e789024
--- /dev/null
+++ b/orchestrator/workflow/resume_call_lineage.py
@@ -0,0 +1,197 @@
+"""Call-frame retry lineage for checksum-compatible resume.
+
+A Workflow Lisp call boundary may own a base frame ``B`` and retry frames
+``B::retry::<n>``. This module indexes the non-completed frames of one
+boundary into a lineage and allocates the next retry frame id. Pure: reads only
+the frames it is given and never mutates them.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+WORKFLOW_LISP_FRONTEND = "workflow_lisp"
+_RETRY_MARKER = "::retry::"
+_TRAILING_MARKER = re.compile(r"^(?P<head>.*)::retry::(?P<tail>[^.:]*)$", re.DOTALL)
+_ORDINAL = re.compile(r"[1-9][0-9]*")
+_STATUSES = frozenset({"completed", "failed", "running"})
+
+
+class CallFrameRetryLineageError(ValueError):
+    """The frames of one call boundary do not form a valid retry lineage."""
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        frame_id: Optional[str] = None,
+        count: Optional[int] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.frame_id = frame_id
+        self.count = count
+
+
+@dataclass(frozen=True)
+class CallFrameMember:
+    frame_id: str
+    status: str
+
+
+@dataclass(frozen=True)
+class RetryFrameMember(CallFrameMember):
+    ordinal: int
+
+
+@dataclass(frozen=True)
+class CallFrameRetryLineage:
+    base_frame_id: Optional[str]
+    completed_members: tuple[CallFrameMember, ...]
+    failed_predecessors: tuple[RetryFrameMember, ...]
+    running_member: Optional[CallFrameMember]
+
+
+def parse_retry_frame_id(frame_id: str) -> tuple[str, int]:
+    """Split a frame id into (base, ordinal); ordinal 0 is the base frame itself."""
+    match = _TRAILING_MARKER.match(frame_id)
+    if match is None:
+        return frame_id, 0
+    head, tail = match.group("head"), match.group("tail")
+    if not head or not _ORDINAL.fullmatch(tail):
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "malformed retry marker", frame_id=frame_id
+        )
+    if _TRAILING_MARKER.match(head):
+        raise CallFrameRetryLineageError(
+            "unsupported_shape", "nested retry marker", frame_id=frame_id
+        )
+    return head, int(tail)
+
+
+def _validated_frames(
+    boundary_step_id: str, frame_items: Iterable[tuple[str, Mapping[str, Any]]]
+) -> list[tuple[str, str]]:
+    frames: list[tuple[str, str]] = []
+    aliases: set[Any] = set()
+    for frame_id, frame in frame_items:
+        if frame.get("call_step_id") != boundary_step_id:
+            raise CallFrameRetryLineageError(
+                "missing_call_boundary", "frame belongs to another boundary", frame_id=frame_id
+            )
+        status = frame.get("status")
+        if status not in _STATUSES:
+            raise CallFrameRetryLineageError(
+                "unsupported_shape", "unknown frame status", frame_id=frame_id
+            )
+        if aliases and frame.get("import_alias") not in aliases:
+            raise CallFrameRetryLineageError(
+                "persisted_import_alias_mismatch",
+                "frames disagree on the import alias",
+                frame_id=frame_id,
+            )
+        aliases.add(frame.get("import_alias"))
+        frames.append((frame_id, status))
+    return frames
+
+
+def _check_non_workflow_lisp(frames: list[tuple[str, str]]) -> CallFrameRetryLineage:
+    completed = tuple(CallFrameMember(fid, st) for fid, st in frames if st == "completed")
+    open_frames = [CallFrameMember(fid, st) for fid, st in frames if st != "completed"]
+    if len(open_frames) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "several resumable frames for one boundary",
+            count=len(open_frames),
+        )
+    return CallFrameRetryLineage(
+        base_frame_id=open_frames[0].frame_id if open_frames else None,
+        completed_members=completed,
+        failed_predecessors=(),
+        running_member=open_frames[0] if open_frames else None,
+    )
+
+
+def index_retry_lineage(
+    boundary_step_id: str,
+    frame_items: Iterable[tuple[str, Mapping[str, Any]]],
+    *,
+    frontend_kind: Optional[str],
+) -> CallFrameRetryLineage:
+    """Group the frames of one boundary into a retry lineage or raise."""
+    frames = _validated_frames(boundary_step_id, frame_items)
+    if frontend_kind != WORKFLOW_LISP_FRONTEND:
+        return _check_non_workflow_lisp(frames)
+
+    completed: list[CallFrameMember] = []
+    lineage: list[RetryFrameMember] = []
+    for frame_id, status in frames:
+        if status == "completed":
+            completed.append(CallFrameMember(frame_id, status))
+            continue
+        base, ordinal = parse_retry_frame_id(frame_id)
+        lineage.append(RetryFrameMember(frame_id, status, ordinal))
+        if base != parse_retry_frame_id(lineage[0].frame_id)[0]:
+            raise CallFrameRetryLineageError(
+                "ambiguous_resumable_call_frame",
+                "retry frames of several bases",
+                frame_id=frame_id,
+                count=len(lineage),
+            )
+    lineage.sort(key=lambda member: member.ordinal)
+    ordinals = [member.ordinal for member in lineage]
+    if len(set(ordinals)) != len(ordinals):
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame", "duplicate retry ordinal", count=len(lineage)
+        )
+    running = [member for member in lineage if member.status == "running"]
+    if len(running) > 1:
+        raise CallFrameRetryLineageError(
+            "ambiguous_resumable_call_frame",
+            "several running frames in one lineage",
+            count=len(running),
+        )
+    base = parse_retry_frame_id(lineage[0].frame_id)[0] if lineage else None
+    family = set(ordinals) | _family_ordinals(completed, base)
+    if lineage and (min(family) not in (0, 1) or family != set(range(min(family), max(family) + 1))):
+        raise CallFrameRetryLineageError("unsupported_shape", "missing retry ordinal")
+    return CallFrameRetryLineage(
+        base_frame_id=base,
+        completed_members=tuple(completed),
+        failed_predecessors=tuple(member for member in lineage if member.status == "failed"),
+        running_member=running[0] if running else None,
+    )
+
+
+def _family_ordinals(members: Iterable[CallFrameMember], base: Optional[str]) -> set[int]:
+    """Ordinals of the given members that belong to the family of ``base``."""
+    ordinals: set[int] = set()
+    for member in members:
+        try:
+            member_base, ordinal = parse_retry_frame_id(member.frame_id)
+        except CallFrameRetryLineageError:
+            continue
+        if member_base == base:
+            ordinals.add(ordinal)
+    return ordinals
+
+
+def next_unused_retry_frame_id(lineage: CallFrameRetryLineage) -> str:
+    """Return ``<base>::retry::<lowest unused positive ordinal>`` over all members."""
+    base = lineage.base_frame_id
+    if base is None:
+        raise ValueError("a retry lineage without a base frame cannot allocate a retry id")
+    members: list[CallFrameMember] = [
+        *lineage.completed_members,
+        *lineage.failed_predecessors,
+    ]
+    if lineage.running_member is not None:
+        members.append(lineage.running_member)
+    used = _family_ordinals(members, base)
+    ordinal = 1
+    while ordinal in used:
+        ordinal += 1
+    return f"{base}{_RETRY_MARKER}{ordinal}"
diff --git a/orchestrator/workflow/resume_loop_integrity.py b/orchestrator/workflow/resume_loop_integrity.py

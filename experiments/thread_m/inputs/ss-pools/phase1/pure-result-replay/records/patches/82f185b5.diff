+
+    module = tmp_path / "lexical_checkpoint_restore_regions.orc"
+    shutil.copy(VALID / module.name, module)
+    bundle = _compile(module, tmp_path)
+    (tmp_path / "artifacts" / "work").mkdir(parents=True)
+    for name in ("r.md", "summary.json"):
+        (tmp_path / "artifacts" / "work" / name).write_text("{}\n", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="regions")
+    manager.initialize(
+        str(module),
+        context=bundle_context_dict(bundle),
+        bound_inputs={"report_path": "artifacts/work/r.md", "summary_target": "artifacts/work/summary.json"},
+        result_persistence_profile=profile,
+    )
+    final = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    assert final["status"] == "completed"
+    return module, bundle, manager, final
+
+
+def _checkpoint_records(manager: StateManager):
+    return sorted((manager.run_root / "workflow_lisp" / "checkpoints" / "records").rglob("*.json"))
+
+
+def test_profiled_run_emits_no_pure_checkpoint_records_and_child_frames_select_by_callee(tmp_path: Path) -> None:
+    _, _, manager, final = _regions_run(tmp_path, DERIVED_PURE_REPLAY_PROFILE)
+    kinds = {json.loads(p.read_text())["pending_effect_policy"]["effect_kind"] for p in _checkpoint_records(manager)}
+    assert kinds and "pure_projection" not in kinds
+    (frame,) = final["call_frames"].values()
+    assert frame["state"]["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+
+    unprofiled_root = tmp_path / "plain"
+    unprofiled_root.mkdir()
+    _, _, plain_manager, plain_final = _regions_run(unprofiled_root, None)
+    assert "result_persistence_profile" not in plain_final
+    (plain_frame,) = plain_final["call_frames"].values()
+    assert plain_frame["state"]["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE  # from the callee, not the parent
+    historical_kinds = {
+        json.loads(p.read_text())["pending_effect_policy"]["effect_kind"] for p in _checkpoint_records(plain_manager)
+    }
+    assert "pure_projection" in historical_kinds
+
+
+def test_leftover_pure_checkpoint_record_and_restore_binding_are_conflicts(tmp_path: Path) -> None:
+    (tmp_path / "plain").mkdir()
+    module, bundle, manager, _ = _regions_run(tmp_path / "plain", None)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root(str(module)))
+
+    def audit():
+        runtime.audit_persisted_surfaces(
+            state={"steps": {}}, state_manager=manager, resolve_bundle_path=lambda _node: None
+        )
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        audit()
+    assert excinfo.value.context["surface"] == "checkpoint_record"
+
+    eligible_ids = {n.step_id for n in runtime.index.nodes.values()}
+    point_ids = {p.step_id for p in bundle.runtime_plan.lexical_checkpoint_points}
+    pure_point_ids = eligible_ids & point_ids
+    for path in _checkpoint_records(manager):
+        record = json.loads(path.read_text())
+        if record.get("pending_effect_policy", {}).get("effect_kind") == "pure_projection":
+            path.unlink()
+    index_dir = manager.run_root / "workflow_lisp" / "checkpoints" / "index"
+    for index_path in index_dir.glob("*.json"):
+        payload = json.loads(index_path.read_text())
+        payload["records"] = [r for r in payload["records"] if (manager.workspace / r["record_path"]).exists()]
+        index_path.write_text(json.dumps(payload))
+    audit()  # nothing eligible remains in the records
+
+    for path in _checkpoint_records(manager):
+        record = json.loads(path.read_text())
+        bindings = (record.get("restore_payload") or {}).get("bindings")
+        if bindings:
+            bindings[0]["source_step_id"] = sorted(eligible_ids)[0]
+            path.write_text(json.dumps(record))
+            break
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        audit()
+    assert excinfo.value.context["surface"] == "restore_payload"
+    assert pure_point_ids  # the fixture really had an eligible point
+
+
+def _cli(workspace: Path, *args: str):
+    import os
+    import subprocess
+    import sys
+
+    env = {**os.environ, "PYTHONPATH": str(REPO_ROOT)}
+    return subprocess.run(
+        [sys.executable, "-m", "orchestrator", *args],
+        cwd=workspace, env=env, capture_output=True, text=True, timeout=240,
+    )
+
+
+def test_cli_run_and_force_restart_select_the_profile(tmp_path: Path) -> None:
+    import shutil
+
+    shutil.copy(VALID / "pure_expr_selector_action_projection.orc", tmp_path)
+    ran = _cli(tmp_path, "run", "pure_expr_selector_action_projection.orc", "--input", "approved=false", "--input", "status=WAIT")
+    assert ran.returncode == 0, ran.stderr
+    (run_dir,) = (tmp_path / ".orchestrate" / "runs").iterdir()
+    source_bytes = (run_dir / "state.json").read_bytes()
+    assert json.loads(source_bytes)["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+
+    restarted = _cli(tmp_path, "resume", run_dir.name, "--force-restart",
+                       "--summary-provider", "no_such_summary_provider", "--summary-max-input-chars", "777")
+    assert restarted.returncode == 0, restarted.stderr
+    assert (run_dir / "state.json").read_bytes() == source_bytes
+    (new_dir,) = [d for d in (tmp_path / ".orchestrate" / "runs").iterdir() if d != run_dir]
+    new_state = json.loads((new_dir / "state.json").read_text())
+    assert new_state["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    assert new_state["observability"]["step_summaries"]["max_input_chars"] == 777

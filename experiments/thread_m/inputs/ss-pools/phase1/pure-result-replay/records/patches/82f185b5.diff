+"""Shared builders for the derived pure-result replay tests."""
+
+
+from __future__ import annotations
+
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+VALID = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp" / "valid"
+
+SUMMARY_SOURCE = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule pure_replay_summary)
+  (export orchestrate)
+  (defpath MaterializedSummaryPath
+    :kind relpath
+    :under "artifacts/work"
+    :must-exist true)
+  (defrecord SummaryValue (status String) (count Int))
+  (defrecord Output (summary_path MaterializedSummaryPath) (n Int))
+  (defworkflow orchestrate
+    ((summary_target MaterializedSummaryPath) (count Int))
+    -> Output
+    (let* ((n (+ count 1))
+           (st (if (> count 0) "ready" "empty"))
+           (summary_path
+             (materialize-view runtime-summary
+               :value (record SummaryValue :status st :count count)
+               :renderer canonical-json
+               :renderer-version 1
+               :target summary_target
+               :returns MaterializedSummaryPath)))
+      (record Output :summary_path summary_path :n n))))
+"""
+SUMMARY_INPUTS = {"summary_target": "artifacts/work/s.json", "count": 4}
+
+
+def _compile(path: Path, root: Path, name_suffix: str = "::orchestrate"):
+    result = compile_stage3_entrypoint(
+        path,
+        source_roots=(path.parent,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=root,
+    )
+    return next(
+        bundle
+        for name, bundle in result.validated_bundles_by_name.items()
+        if name.endswith(name_suffix)
+    )
+
+
+@pytest.fixture
+def selector_bundle(tmp_path: Path):
+    return _compile(VALID / "pure_expr_selector_action_projection.orc", tmp_path)
+
+
+@pytest.fixture
+def summary_run(tmp_path: Path):
+    module = tmp_path / "pure_replay_summary.orc"
+    module.write_text(SUMMARY_SOURCE, encoding="utf-8")
+    bundle = _compile(module, tmp_path)
+    (tmp_path / "artifacts" / "work").mkdir(parents=True)
+    (tmp_path / "artifacts" / "work" / "s.json").write_text("{}\n", encoding="utf-8")
+    return module, bundle
+
+
+def _start(tmp_path: Path, module: Path, bundle, *, profile):
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    manager.initialize(
+        str(module),
+        context=bundle_context_dict(bundle),
+        bound_inputs=dict(SUMMARY_INPUTS),
+        result_persistence_profile=profile,
+    )
+    return manager
+
+
+def _fail_materialize_once():
+    real = WorkflowExecutor._execute_materialize_view.__globals__["render_view"]
+    armed = {"on": True}
+
+    def render(*args, **kwargs):
+        if armed["on"]:
+            armed["on"] = False
+            raise RuntimeError("synthetic interruption")
+        return real(*args, **kwargs)
+
+    return patch("orchestrator.workflow.executor.render_view", side_effect=render)
+
+
+def _interrupt(manager: StateManager, bundle) -> str:
+    state = manager.load()
+    key = next(name for name in state.steps if "materialize" in name)
+    step_id = state.steps[key]["step_id"] if isinstance(state.steps[key], dict) else state.steps[key].step_id
+    state.current_step = {
+        "name": key,
+        "index": bundle.projection.execution_index_for_step_id(step_id),
+        "step_id": step_id,
+        "status": "running",
+    }
+    manager._write_state()
+    return key
+
+

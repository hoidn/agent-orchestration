new file mode 100644
index 0000000..ddae475
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_index.py
@@ -0,0 +1,421 @@
+"""Derived replay-eligibility and dependency index for compiler-generated pure steps.
+
+Reads a ``LoadedWorkflowBundle`` without mutating or serializing it.
+Dependencies: executable IR nodes, the projection tables, the pure-expression
+type coercer, and the structured-ref parser. Behavior: see specs/state.md
+(``derived_pure_replay.v1``).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import Any, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    LoopOutputAddress,
+    NodeResultAddress,
+    PureProjectionStepConfig,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_witness import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    PureResultReplayIndexError,
+)
+from .references import (
+    ReferenceResolutionError,
+    StructuredStepReference,
+    SurfaceRefScopeCatalog,
+    WorkflowInputReference,
+    parse_surface_ref,
+)
+
+ROOT_SCOPE = "root"
+
+
+def _thaw(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _thaw(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_thaw(v) for v in value]
+    return value
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    """One exact ``{"ref": ...}`` leaf of a binding value document."""
+
+    path: tuple[Any, ...]
+    address: BoundAddress
+    expected_type: Optional[Mapping[str, Any]] = field(default=None, compare=False, repr=False)
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    """One replay-eligible pure projection and its direct dependencies."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Mapping[str, Any]]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+    step: Mapping[str, Any] = field(default_factory=dict, compare=False, repr=False)
+    step_index: int = field(default=0, compare=False)
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    """Derived eligibility table for one workflow scope."""
+
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[Any],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Pure nodes (topological order) needed to rebuild ``seed_addresses``.
+
+        Only already-reached nodes are rebuilt; unreached ones execute normally.
+        """
+        reached = set(reached_node_ids)
+        pending = [
+            address.node_id
+            for address in seed_addresses
+            if isinstance(address, NodeResultAddress) and address.node_id in self.nodes
+        ]
+        needed: set[str] = set()
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed or node_id not in reached:
+                continue
+            needed.add(node_id)
+            pending.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(n for n in self.topological_node_ids if n in needed)
+
+
+def _propagate_pure_ineligibility(
+    reasons: dict[str, str],
+    owned_by: Mapping[str, Iterable[str]],
+) -> dict[str, str]:
+    """Spread an owner's ineligibility reason to the pure nodes it owns."""
+    pending = [owner for owner in owned_by if owner in reasons]
+    while pending:
+        owner = pending.pop()
+        for child in owned_by.get(owner, ()):
+            if child not in reasons:
+                reasons[child] = reasons[owner]
+                pending.append(child)
+    return reasons
+
+
+def _multiply_visited_ids(bundle: LoadedWorkflowBundle) -> set[str]:
+    """Node ids inside iteration bodies or on a routed control-flow cycle."""
+    nodes = bundle.ir.nodes
+    owned: dict[str, list[str]] = {}
+    for node_id, node in nodes.items():
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)):
+            owned[node_id] = list(node.body_node_ids)
+    projection = bundle.projection
+    for table in (projection.repeat_until_nodes, projection.for_each_nodes):
+        for owner, entry in table.items():
+            owned.setdefault(owner, []).extend(entry.nested_presentation_keys)
+    reasons = {owner: MULTIPLE_VISIT_REGION for owner in owned}
+    _propagate_pure_ineligibility(reasons, owned)
+    flagged = set(reasons)
+    flagged.update(_cyclic_node_ids(bundle))
+    return flagged
+
+
+def _cyclic_node_ids(bundle: LoadedWorkflowBundle) -> set[str]:
+    edges: dict[str, set[str]] = {}
+    for node_id, node in bundle.ir.nodes.items():
+        targets = {t.target_node_id for t in node.routed_transfers.values() if t.target_node_id}
+        if node.fallthrough_node_id:
+            targets.add(node.fallthrough_node_id)
+        edges[node_id] = {t for t in targets if t in bundle.ir.nodes}
+    cyclic: set[str] = set()
+    for start in edges:
+        seen: set[str] = set()
+        stack = list(edges[start])
+        while stack:
+            current = stack.pop()
+            if current == start:
+                cyclic.add(start)
+                break
+            if current not in seen:
+                seen.add(current)
+                stack.extend(edges.get(current, ()))
+    return cyclic
+
+
+def _bundle_scope(bundle: LoadedWorkflowBundle) -> str:
+    # Refs are scoped to the workflow holding them: every bundle is its own "root".
+    return ROOT_SCOPE
+
+
+def _parse_ref(ref: Any, catalog: SurfaceRefScopeCatalog) -> Any:
+    if not isinstance(ref, str) or not ref:
+        raise _invalid("pure binding ref must be a non-empty string", ref=ref)
+    try:
+        parsed = parse_surface_ref(ref, catalog)
+    except ReferenceResolutionError as exc:
+        raise _invalid(f"pure binding ref is not resolvable: {exc}", ref=ref) from exc
+    if isinstance(parsed, StructuredStepReference) and parsed.scope != "root":
+        raise _invalid("pure binding ref crosses a frame boundary", ref=ref)
+    if isinstance(parsed, WorkflowInputReference) or isinstance(parsed, StructuredStepReference):
+        return parsed
+    raise _invalid("pure binding ref crosses a frame boundary", ref=ref)
+
+
+class _DocWalker:
+    """Type-check one binding value document and collect its exact refs."""
+
+    def __init__(self, bundle: LoadedWorkflowBundle, node_id: str) -> None:
+        self.bundle = bundle
+        self.node_id = node_id
+        keys = bundle.projection.presentation_key_by_node_id
+        self.node_by_key = {key: nid for nid, key in keys.items()}
+        self.catalog = SurfaceRefScopeCatalog(root_step_names=tuple(self.node_by_key))
+        self.found: list[PureReplayBinding] = []
+
+    def address_for(self, ref: str) -> BoundAddress:
+        parsed = _parse_ref(ref, self.catalog)
+        if isinstance(parsed, WorkflowInputReference):
+            if parsed.input_name not in self.bundle.ir.inputs:
+                raise _invalid("pure binding ref names an unknown input", ref=ref)
+            return WorkflowInputAddress(input_name=parsed.input_name)
+        target = self.node_by_key.get(parsed.step_name)
+        if target is None:
+            raise _invalid("pure binding ref names an unknown step", ref=ref)
+        node = self.bundle.ir.nodes[target]
+        if parsed.field == "artifacts" and parsed.member:
+            kind = node.kind
+            if kind is ExecutableNodeKind.CALL_BOUNDARY:
+                return CallOutputAddress(node_id=target, output_name=parsed.member)
+            if kind is ExecutableNodeKind.REPEAT_UNTIL_FRAME:
+                return LoopOutputAddress(node_id=target, output_name=parsed.member)
+            if kind in (ExecutableNodeKind.IF_JOIN, ExecutableNodeKind.MATCH_JOIN):
+                return BlockOutputAddress(node_id=target, output_name=parsed.member)
+        return NodeResultAddress(node_id=target, field=parsed.field, member=parsed.member)
+
+    def walk(self, value: Any, descriptor: Any, path: tuple[Any, ...]) -> None:
+        kind = descriptor.get("kind") if isinstance(descriptor, Mapping) else None
+        if isinstance(value, Mapping) and "ref" in value:
+            if len(value) == 1:
+                self.found.append(
+                    PureReplayBinding(path, self.address_for(value["ref"]), descriptor)
+                )
+                return
+            if kind not in ("record", "union", "variant_case", "map"):
+                raise _invalid("malformed ref object", path=list(path))
+        if kind == "optional":
+            if value is not None:
+                self.walk(value, descriptor["item"], path)
+        elif kind == "list":
+            if not isinstance(value, (list, tuple)):
+                raise _invalid("literal binding is not a list", path=list(path))
+            for i, item in enumerate(value):
+                self.walk(item, descriptor["item"], (*path, i))
+        elif kind == "map":
+            if not isinstance(value, Mapping):
+                raise _invalid("literal binding is not a map", path=list(path))
+            for key, item in value.items():
+                self.walk(item, descriptor["value"], (*path, key))
+        elif kind == "record":
+            self._walk_fields(value, descriptor["fields"], path, strict=True)
+        elif kind in ("union", "variant_case"):
+            self._walk_union(value, descriptor, path)
+        else:
+            self._check_leaf(value, descriptor, path)
+
+    def _walk_fields(self, value: Any, fields: Any, path: tuple[Any, ...], *, strict: bool) -> None:
+        if not isinstance(value, Mapping):
+            raise _invalid("literal binding is not a record", path=list(path))
+        names = {f["name"] for f in fields}
+        if strict and set(value) - names - {"variant"}:
+            raise _invalid("literal binding has unexpected fields", path=list(path))
+        for f in fields:
+            if f["name"] in value:
+                self.walk(value[f["name"]], f["type"], (*path, f["name"]))
+            elif strict:
+                raise _invalid("literal binding is missing a field", path=list(path), field=f["name"])
+
+    def _walk_union(self, value: Any, descriptor: Mapping[str, Any], path: tuple[Any, ...]) -> None:
+        if not isinstance(value, Mapping) or not isinstance(value.get("variant"), str):
+            raise _invalid("literal union binding must declare a variant", path=list(path))
+        variants = descriptor.get("variants") or [descriptor]
+        by_name = {v.get("name", v.get("variant")): v for v in variants}
+        active = by_name.get(value["variant"])
+        if active is None:
+            raise _invalid("literal union binding names an unknown variant", path=list(path))
+        # The active member must be complete; inactive members, when present, must still type-check.
+        self._walk_fields(value, active["fields"], path, strict=False)
+        missing = [f["name"] for f in active["fields"] if f["name"] not in value]
+        if missing:
+            raise _invalid("literal union binding lacks active fields", path=list(path), fields=missing)
+        for name, variant in by_name.items():
+            if variant is active:
+                continue
+            for f in variant["fields"]:
+                if f["name"] in value and f["name"] not in {a["name"] for a in active["fields"]}:
+                    self.walk(value[f["name"]], f["type"], (*path, f["name"]))
+
+    def _check_leaf(self, value: Any, descriptor: Any, path: tuple[Any, ...]) -> None:
+        if isinstance(value, str) and value.startswith("${") and value.endswith("}"):
+            raise _invalid("pure binding literal holds unbound text", path=list(path))
+        try:
+            _coerce_value(value, descriptor, context="binding")
+        except (PureExprEvaluationError, KeyError, TypeError) as exc:
+            raise _invalid(f"literal binding does not match its type: {exc}", path=list(path)) from exc
+
+
+def _pure_config(bundle: LoadedWorkflowBundle, node_id: str) -> Mapping[str, Any]:
+    config = bundle.ir.nodes[node_id].execution_config
+    assert isinstance(config, PureProjectionStepConfig)
+    return config.pure_projection
+
+
+def _node_bindings(bundle: LoadedWorkflowBundle, node_id: str, config: Mapping[str, Any]) -> tuple[PureReplayBinding, ...]:
+    refs = config.get("binding_refs")
+    declared = (config.get("payload") or {}).get("bindings")
+    if not isinstance(refs, Mapping) or not isinstance(declared, Mapping):
+        raise _invalid("pure projection config lacks bindings", node_id=node_id)
+    if set(refs) - set(declared):
+        raise _invalid("pure projection binds undeclared names", node_id=node_id)
+    walker = _DocWalker(bundle, node_id)
+    for name, doc in refs.items():
+        walker.walk(doc, declared[name].get("type"), (name,))
+    return tuple(walker.found)
+
+
+def _check_projection_authority(bundle: LoadedWorkflowBundle, pure_ids: list[str]) -> None:
+    projection = bundle.projection
+    seen_keys: dict[str, str] = {}
+    seen_steps: dict[str, str] = {}
+    for node_id in pure_ids:
+        node = bundle.ir.nodes[node_id]
+        entry = projection.entries_by_node_id.get(node_id)
+        if entry is None or entry.presentation_key != node.presentation_name or entry.step_id != node.step_id:
+            raise _invalid("pure node disagrees with its projection entry", node_id=node_id)
+        for table, key in ((seen_keys, entry.presentation_key), (seen_steps, entry.step_id)):
+            if key in table:
+                raise _invalid("duplicate projection authority", node_id=node_id, other=table[key])
+            table[key] = node_id
+        if projection.presentation_key_by_node_id.get(node_id) != entry.presentation_key:
+            raise _invalid("pure node presentation key is not authoritative", node_id=node_id)
+    # No non-pure node may claim a pure node's identity.
+    for node_id, entry in projection.entries_by_node_id.items():
+        if node_id not in pure_ids and (entry.presentation_key in seen_keys or entry.step_id in seen_steps):
+            raise _invalid("duplicate projection authority", node_id=node_id)
+
+
+def _topological_order(deps: Mapping[str, tuple[str, ...]]) -> tuple[str, ...]:
+    remaining = {n: set(d) for n, d in deps.items()}
+    ordered: list[str] = []
+    while remaining:
+        ready = sorted(n for n, d in remaining.items() if not d)
+        if not ready:
+            raise _invalid("pure dependency cycle", node_ids=sorted(remaining))
+        ordered.extend(ready)
+        for n in ready:
+            del remaining[n]
+        for d in remaining.values():
+            d.difference_update(ready)
+    return tuple(ordered)
+
+
+def derive_pure_result_replay_index(
+    bundle: LoadedWorkflowBundle,
+    *,
+    scope_kind: str = ROOT_SCOPE,
+) -> PureResultReplayIndex:
+    """Derive eligible pure nodes and their dependencies from ``bundle``."""
+    actual = _bundle_scope(bundle)
+    if scope_kind != actual:
+        raise _invalid(
+            "scope_kind does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=actual,
+        )
+    generated = bundle.provenance.frontend_kind == "workflow_lisp"
+    pure_ids = [
+        node_id
+        for node_id, node in bundle.ir.nodes.items()
+        if node.kind is ExecutableNodeKind.PURE_PROJECTION
+        and isinstance(node.execution_config, PureProjectionStepConfig)
+        and generated
+    ]
+    _check_projection_authority(bundle, pure_ids)
+    multiply = _multiply_visited_ids(bundle)
+    reasons = {n: MULTIPLE_VISIT_REGION for n in pure_ids if n in multiply}
+    eligible = [n for n in pure_ids if n not in reasons]
+    eligible_set = set(eligible)
+
+    built: dict[str, tuple[PureReplayBinding, ...]] = {}
+    pure_deps: dict[str, tuple[str, ...]] = {}
+    for node_id in eligible:
+        config = _pure_config(bundle, node_id)
+        built[node_id] = _node_bindings(bundle, node_id, config)
+        pure_deps[node_id] = tuple(sorted({
+            b.address.node_id for b in built[node_id]
+            if getattr(b.address, "node_id", None) in eligible_set
+        }))
+    order = _topological_order(pure_deps)
+
+    nodes: dict[str, PureReplayNode] = {}
+    for node_id in eligible:
+        ir_node = bundle.ir.nodes[node_id]
+        config = _thaw(_pure_config(bundle, node_id))
+        contracts = config.get("output_contracts")
+        if not isinstance(contracts, dict):
+            raise _invalid("pure projection lacks output contracts", node_id=node_id)
+        durable = tuple(sorted({
+            b.address.node_id for b in built[node_id]
+            if getattr(b.address, "node_id", None) not in (None, *eligible_set)
+        }))
+        entry = bundle.projection.entries_by_node_id[node_id]
+        nodes[node_id] = PureReplayNode(
+            node_id=node_id,
+            step_id=ir_node.step_id,
+            presentation_key=ir_node.presentation_name,
+            bindings=built[node_id],
+            output_addresses=tuple(
+                NodeResultAddress(node_id=node_id, field="artifacts", member=name) for name in contracts
+            ),
+            output_contracts=MappingProxyType(contracts),
+            pure_dependency_node_ids=pure_deps[node_id],
+            durable_dependency_node_ids=durable,
+            step={
+                "name": ir_node.presentation_name,
+                "id": ir_node.step_id,
+                "pure_projection": config,
+            },
+            step_index=entry.compatibility_index if isinstance(entry.compatibility_index, int) else 0,
+        )
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=MappingProxyType(nodes),
+        topological_node_ids=order,
+        ineligible_pure_reasons=MappingProxyType(reasons),
+    )
diff --git a/orchestrator/workflow/pure_replay_surfaces.py b/orchestrator/workflow/pure_replay_surfaces.py
new file mode 100644
index 0000000..c02bbd8
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_surfaces.py
@@ -0,0 +1,107 @@
+"""Audit of durable surfaces an eligible pure node must not leave behind.
+
+Under ``derived_pure_replay.v1`` an eligible pure node persists only its
+value-free completion shell. A value row, result bundle, private lineage entry,
+checkpoint record or restore binding for such a node is a ``profile_conflict``.
+Dependencies: the runtime's index and witnesses, plus checkpoint sidecars read
+through the state manager (no writes).
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from .pure_replay_witness import (
+    PROFILE_CONFLICT,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    validate_pure_completion_shell,
+)
+
+
+def _conflict(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(PROFILE_CONFLICT, message, context=context)
+
+
+def audit_persisted_surfaces(
+    runtime: Any,
+    *,
+    state: Mapping[str, Any],
+    state_manager: Any,
+    resolve_bundle_path: Callable[[Any], Optional[Path]],
+) -> None:
+    """Raise ``profile_conflict`` when an eligible node left a durable value surface."""
+    nodes = runtime.index.nodes
+    step_ids = {n.step_id for n in nodes.values()}
+    keys = {n.presentation_key for n in nodes.values()}
+    _audit_rows(runtime, state)
+    for node in nodes.values():
+        path = resolve_bundle_path(node)
+        if path is not None and Path(path).exists():
+            raise _conflict("eligible pure node has a persisted result bundle",
+                            surface="pure_bundle", node_id=node.node_id)
+    private = state.get("private_artifact_versions")
+    if isinstance(private, Mapping) and any(
+        isinstance(entry, Mapping)
+        and (entry.get("producer") in step_ids or entry.get("producer_name") in keys)
+        for entries in private.values() if isinstance(entries, list)
+        for entry in entries
+    ):
+        raise _conflict("eligible pure node has private lineage", surface="private_artifact_versions")
+    _audit_checkpoints(runtime, state_manager, step_ids)
+
+
+def _audit_rows(runtime: Any, state: Mapping[str, Any]) -> None:
+    steps = state.get("steps") if isinstance(state.get("steps"), Mapping) else {}
+    for node in runtime.index.nodes.values():
+        row = steps.get(node.presentation_key)
+        if row is None or (isinstance(row, Mapping) and row.get("status") in ("failed", "skipped")):
+            continue
+        witness = runtime.witness(node.node_id)
+        try:
+            validate_pure_completion_shell(row, witness=witness)
+        except ValueError:
+            if isinstance(row, Mapping) and set(row) == set(build_pure_completion_shell(witness)):
+                continue  # a value-free shell with wrong values is a progress failure, not a surface conflict
+            raise _conflict("eligible pure node has a persisted value row",
+                            surface="steps", node_id=node.node_id) from None
+
+
+def _audit_checkpoints(runtime: Any, state_manager: Any, step_ids: set[str]) -> None:
+    ids = runtime.scope_path.call_frame_ids
+    frame_id = ids[-1] if ids else None
+    for point in runtime.bundle.runtime_plan.lexical_checkpoint_points:
+        point_step_id = _field(point, "step_id")
+        for record in _scope_records(state_manager, point, frame_id):
+            if point_step_id in step_ids:
+                raise _conflict("eligible pure node has a checkpoint record",
+                                surface="checkpoint_record", step_id=point_step_id)
+            payload = record.get("restore_payload")
+            bindings = payload.get("bindings") if isinstance(payload, Mapping) else None
+            if isinstance(bindings, list) and any(
+                isinstance(b, Mapping) and b.get("source_step_id") in step_ids for b in bindings
+            ):
+                raise _conflict("restore payload binds an eligible pure node",
+                                surface="restore_payload", step_id=point_step_id)
+
+
+def _field(point: Any, name: str) -> Any:
+    return point.get(name) if isinstance(point, Mapping) else getattr(point, name, None)
+
+
+def _scope_records(state_manager: Any, point: Any, frame_id: Optional[str]) -> Iterable[Mapping[str, Any]]:
+    """Yield stored checkpoint records for ``point`` that belong to ``frame_id``."""
+    from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_index_path
+
+    index_path = resolve_checkpoint_index_path(
+        state_manager=state_manager,
+        workflow_name=str(_field(point, "workflow_name")),
+        checkpoint_id=str(_field(point, "checkpoint_id")),
+    )
+    index = state_manager.read_runtime_sidecar_json(index_path)
+    for entry in (index or {}).get("records", ()):
+        if (entry.get("frame_identity") or {}).get("call_frame_id") != frame_id:
+            continue
+        record = state_manager.read_runtime_sidecar_json(state_manager.workspace / entry["record_path"])
+        yield record if isinstance(record, Mapping) else dict(entry)
diff --git a/orchestrator/workflow/pure_replay_witness.py b/orchestrator/workflow/pure_replay_witness.py
new file mode 100644
index 0000000..d2a561f
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_witness.py
@@ -0,0 +1,231 @@
+"""Visit witness, value-free completion shell and progress classification.
+
+Part of the ``derived_pure_replay.v1`` result persistence profile (specs/state.md).
+Dependencies: none beyond the standard library; callers pass plain state mappings.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+DURABLE_INPUT_MISSING = "durable_input_missing"
+DURABLE_INPUT_INVALID = "durable_input_invalid"
+BINDING_UNRESOLVED = "binding_unresolved"
+EVALUATION_FAILED = "evaluation_failed"
+OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+
+PURE_STEP_TYPE = "pure_projection"
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+_SHELL_KEYS = frozenset(
+    {"name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage"}
+)
+_SHELL_OUTCOME = {
+    "status": "completed",
+    "phase": "execution",
+    "class": "completed",
+    "retryable": False,
+}
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed replay error carrying a stable ``reason`` and ``context``."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row (not via a serialized result)."""
+    if type(witness.visit_count) is not int or witness.visit_count != 1:
+        raise ValueError("a pure completion shell requires a single-visit witness")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": dict(_SHELL_OUTCOME),
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's shell."""
+    if not isinstance(row, Mapping) or set(row) != _SHELL_KEYS:
+        raise ValueError("pure completion shell must contain exactly the shell keys")
+    expected = build_pure_completion_shell(witness)
+    for key, want in expected.items():
+        got = row[key]
+        if key == "outcome":
+            if not isinstance(got, Mapping) or dict(got) != want or any(
+                type(got[k]) is not type(v) for k, v in want.items()
+            ):
+                raise ValueError("pure completion shell outcome is not exact")
+        elif got != want or type(got) is not type(want):
+            raise ValueError(f"pure completion shell field {key!r} is not exact")
+
+
+def _is_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True
+
+
+def _cursor_is_related(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _cursor_matches(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and cursor.get("type") == PURE_STEP_TYPE
+        and cursor.get("status") == "running"
+        and type(cursor.get("visit_count")) is int
+        and cursor["visit_count"] == witness.visit_count
+    )
+
+
+def _failure_row_matches(row: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        row.get("status") in ("failed", "skipped")
+        and row.get("name", witness.presentation_key) == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and type(row.get("visit_count")) is int
+        and row["visit_count"] == witness.visit_count
+    )
+
+
+def classify_pure_replay_progress(state: Any, *, witness: PureReplayVisitWitness) -> str:
+    """Classify one state's visit, cursor and row for ``witness``."""
+    if hasattr(state, "to_dict"):
+        state = state.to_dict()
+    visits = state.get("step_visits")
+    steps = state.get("steps")
+    visit = visits.get(witness.presentation_key) if isinstance(visits, Mapping) else None
+    row = steps.get(witness.presentation_key) if isinstance(steps, Mapping) else None
+    cursor = state.get("current_step")
+    if cursor is not None and not isinstance(cursor, Mapping):
+        return PROGRESS_WITNESS_INVALID
+    related = cursor is not None and _cursor_is_related(cursor, witness)
+
+    if visit is None:
+        if row is None and not related:
+            return UNSTARTED
+        return PROGRESS_WITNESS_INVALID
+    if type(visit) is not int or visit != witness.visit_count:
+        return PROGRESS_WITNESS_INVALID
+
+    if row is None:
+        if related and _cursor_matches(cursor, witness):
+            return INTERRUPTED
+        return PROGRESS_WITNESS_INVALID
+    if related or not isinstance(row, Mapping):
+        return PROGRESS_WITNESS_INVALID
+    if _is_shell(row, witness):
+        return DERIVED_COMPLETE
+    if _failure_row_matches(row, witness):
+        return DURABLE_FAILURE_SKIP
+    return PROGRESS_WITNESS_INVALID
+
+
+# -- visit-atomic mutations on a RunState (persistence is the caller's job) ----
+
+def _require_progress(state: Any, witness: PureReplayVisitWitness, expected: str) -> None:
+    progress = classify_pure_replay_progress(state.to_dict(), witness=witness)
+    if progress != expected:
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            f"pure visit is {progress}, expected {expected}",
+            context={"step_id": witness.step_id, "progress": progress, "expected": expected},
+        )
+
+
+def apply_begin_eligible_pure_visit(
+    state: Any, *, step_name: str, step_index: int, step_id: str, now: str
+) -> int:
+    """Increment the (first) visit and publish the matching running cursor."""
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    _require_progress(state, witness, UNSTARTED)
+    state.step_visits[step_name] = 1
+    state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": PURE_STEP_TYPE,
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def apply_reuse_interrupted_eligible_pure_visit(state: Any, witness: PureReplayVisitWitness) -> int:
+    _require_progress(state, witness, INTERRUPTED)
+    return witness.visit_count
+
+
+def apply_settle_eligible_pure_success(state: Any, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    _require_progress(state, witness, INTERRUPTED)
+    shell = build_pure_completion_shell(witness)
+    state.steps[witness.presentation_key] = shell
+    state.current_step = None
+    return dict(shell)
+
+
+def apply_settle_eligible_pure_failure(
+    state: Any, witness: PureReplayVisitWitness, result: Any
+) -> None:
+    _require_progress(state, witness, INTERRUPTED)
+    row = result.to_dict() if hasattr(result, "to_dict") else dict(result)
+    candidate = {**row, "name": row.get("name", witness.presentation_key)}
+    if not _failure_row_matches(candidate, witness):
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            "failure row does not match the pure visit",
+            context={"step_id": witness.step_id},
+        )
+    state.steps[witness.presentation_key] = result
+    state.current_step = None
diff --git a/orchestrator/workflow/pure_result_replay.py b/orchestrator/workflow/pure_result_replay.py
new file mode 100644
index 0000000..489ac40
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,460 @@
+"""Resume-time replay of derived pure results (``derived_pure_replay.v1``).
+
+``PureReplayRuntime`` rebuilds the values of completed, replay-eligible pure
+projections in memory from durable inputs. It never dispatches an effect,
+increments a visit, settles a result or writes durable state.
+
+Dependencies: the derived index (``pure_replay_index``), the witness helpers
+(``pure_replay_witness``), the workflow state mapping handed in by callers,
+and the process-local active-result cache held on the runtime instance.
+See specs/state.md for the profile contract.
+"""
+
+from __future__ import annotations
+
+import copy
+import re
+from pathlib import Path
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    CallOutputAddress,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_index import (
+    PureReplayBinding,
+    PureReplayNode,
+    PureResultReplayIndex,
+    _propagate_pure_ineligibility,
+    derive_pure_result_replay_index,
+)
+from .pure_replay_witness import (
+    BINDING_UNRESOLVED,
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_COMPLETE,
+    DURABLE_FAILURE_SKIP,
+    DERIVED_PURE_REPLAY_PROFILE,
+    DURABLE_INPUT_INVALID,
+    DURABLE_INPUT_MISSING,
+    EVALUATION_FAILED,
+    INTERRUPTED,
+    MULTIPLE_VISIT_REGION,
+    OUTPUT_CONTRACT_INVALID,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PURE_RESULT_REPLAY_UNAVAILABLE,
+    REACHABILITY_AMBIGUOUS,
+    UNSTARTED,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+from .pure_replay_surfaces import audit_persisted_surfaces as _audit_persisted_surfaces
+from .resume_projection_integrity import ResumeScopePath
+
+__all__ = [
+    "BINDING_UNRESOLVED",
+    "DERIVED_COMPLETE",
+    "DURABLE_FAILURE_SKIP",
+    "INTERRUPTED",
+    "UNSTARTED",
+    "DEPENDENCY_INDEX_INVALID",
+    "DERIVED_PURE_REPLAY_PROFILE",
+    "MULTIPLE_VISIT_REGION",
+    "PROFILE_CONFLICT",
+    "PROGRESS_WITNESS_INVALID",
+    "PURE_RESULT_REPLAY_UNAVAILABLE",
+    "REACHABILITY_AMBIGUOUS",
+    "PureReplayBinding",
+    "PureReplayNode",
+    "PureReplayRuntime",
+    "PureReplayVisitWitness",
+    "PureResultReplayIndex",
+    "PureResultReplayIndexError",
+    "_propagate_pure_ineligibility",
+    "automatic_result_persistence_profile",
+    "build_pure_completion_shell",
+    "classify_pure_replay_progress",
+    "derive_pure_result_replay_index",
+    "validate_pure_completion_shell",
+]
+
+_OUTCOME_STR_MEMBERS = ("status", "phase", "class")
+_STEP_REF_RE = re.compile(r"steps\.(.+?)\.(?:artifacts|exit_code|outcome|snapshots)")
+
+
+def automatic_result_persistence_profile(workflow: Any) -> Optional[str]:
+    """Profile for a new root: selected only for a typed compiled Workflow Lisp bundle."""
+    if (
+        isinstance(workflow, LoadedWorkflowBundle)
+        and workflow.provenance.frontend_kind == "workflow_lisp"
+    ):
+        return DERIVED_PURE_REPLAY_PROFILE
+    return None
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _is_int(value: Any) -> bool:
+    return type(value) is int
+
+
+def _union_group(contract: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
+    projection = contract.get("projection")
+    if isinstance(projection, Mapping) and projection.get("projection_class") == "union_workflow_boundary":
+        return projection
+    return None
+
+
+class _ReplayStep(dict):
+    """Runtime step input for one replayed node, also readable as the node itself."""
+
+    def __init__(self, node: PureReplayNode) -> None:
+        super().__init__(copy.deepcopy(dict(node.step)))
+        self._node = node
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._node, name)
+
+
+class PureReplayRuntime:
+    """Per-scope replay index plus the process-local cache of derived rows."""
+
+    def __init__(self, *, bundle: LoadedWorkflowBundle, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index = derive_pure_result_replay_index(bundle, scope_kind="root")
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._node_by_step_id = {n.step_id: n.node_id for n in self.index.nodes.values()}
+
+    # -- identity ---------------------------------------------------------
+
+    def _node(self, node_id: str) -> PureReplayNode:
+        node = self.index.nodes.get(node_id)
+        if node is None:
+            raise _error(DEPENDENCY_INDEX_INVALID, "node is not replay-eligible", node_id=node_id)
+        return node
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        return PureReplayVisitWitness(node.presentation_key, node.step_index, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        return self.witness(node_id, visit_count=1 if visit is None else visit)
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._node_by_step_id.get(step_id)
+
+    # -- active/derived cache ----------------------------------------------
+
+    def _expected_artifact_names(self, node: PureReplayNode, artifacts: Mapping[str, Any]) -> set[str]:
+        names: set[str] = set()
+        discriminant_name = None
+        for name, contract in node.output_contracts.items():
+            group = _union_group(contract)
+            if group is not None:
+                discriminant_name = group.get("discriminant_output")
+        active = artifacts.get(discriminant_name) if discriminant_name else None
+        for name, contract in node.output_contracts.items():
+            group = _union_group(contract)
+            role = group.get("field_role") if group else None
+            if group is None or role in ("discriminant", "shared"):
+                names.add(name)
+            elif role == "variant" and active in (group.get("active_variants") or ()):
+                names.add(name)
+        if discriminant_name and discriminant_name not in artifacts:
+            raise _error(DEPENDENCY_INDEX_INVALID, "union result lacks its discriminant", node_id=node.node_id)
+        return names
+
+    def _validated_row(
+        self,
+        node: PureReplayNode,
+        witness: PureReplayVisitWitness,
+        result: Mapping[str, Any],
+    ) -> dict[str, Any]:
+        artifacts = result.get("artifacts")
+        if (
+            result.get("status") != "completed"
+            or result.get("exit_code") != 0
+            or not isinstance(artifacts, Mapping)
+            or result.get("name", witness.presentation_key) != witness.presentation_key
+            or result.get("step_id", witness.step_id) != witness.step_id
+        ):
+            raise _error(DEPENDENCY_INDEX_INVALID, "pure result is not a completed row", node_id=node.node_id)
+        expected = self._expected_artifact_names(node, artifacts)
+        if set(artifacts) != expected:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                "pure result artifacts do not match the active union member",
+                node_id=node.node_id,
+                missing=sorted(expected - set(artifacts)),
+                extra=sorted(set(artifacts) - expected),
+            )
+        row = copy.deepcopy(dict(result))
+        shell = build_pure_completion_shell(witness)
+        row.setdefault("name", shell["name"])
+        row.setdefault("step_id", shell["step_id"])
+        row.setdefault("visit_count", 1)
+        row.setdefault("outcome", shell["outcome"])
+        return row
+
+    def record_full_result(
+        self,
+        node_id: str,
+        *,
+        witness: PureReplayVisitWitness,
+        result: Mapping[str, Any],
+    ) -> None:
+        node = self._node(node_id)
+        if witness != self.witness(node_id, visit_count=witness.visit_count) or witness.visit_count != 1:
+            raise _error(PROGRESS_WITNESS_INVALID, "witness does not identify the node", node_id=node_id)
+        self._cache[node_id] = (witness, self._validated_row(node, witness, result))
+
+    def _authoritative_row(self, node_id: str, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Revalidate one cache hit against the current state authority."""
+        witness, cached = self._cache[node_id]
+        visits = state.get("step_visits")
+        visit = visits.get(witness.presentation_key) if isinstance(visits, Mapping) else None
+        cursor = state.get("current_step")
+        if (
+            not _is_int(visit)
+            or visit != 1
+            or (isinstance(cursor, Mapping) and (
+                cursor.get("name") == witness.presentation_key
+                or cursor.get("step_id") == witness.step_id
+            ))
+        ):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure result lacks a settled single visit", node_id=node_id)
+        steps = state.get("steps")
+        row = steps.get(witness.presentation_key) if isinstance(steps, Mapping) else None
+        try:
+            validate_pure_completion_shell(row, witness=witness)
+        except ValueError:
+            if row != cached:
+                raise _error(
+                    PROGRESS_WITNESS_INVALID,
+                    "state row is neither the durable shell nor the validated active result",
+                    node_id=node_id,
+                ) from None
+        return cached
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Copy ``state`` with every cached pure row projected into ``steps``."""
+        overlay = dict(state)
+        steps = dict(state.get("steps") or {})
+        for node_id, (witness, _) in self._cache.items():
+            steps[witness.presentation_key] = copy.deepcopy(self._authoritative_row(node_id, state))
+        overlay["steps"] = steps
+        return overlay
+
+    # -- address resolution ---------------------------------------------------
+
+    def _presentation_key(self, node_id: str) -> str:
+        return self.bundle.projection.presentation_key_by_node_id[node_id]
+
+    def resolve_state_address(self, address: Any, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.input_name in inputs:
+                return True, inputs[address.input_name]
+            return False, None
+        node_id = getattr(address, "node_id", None)
+        if node_id is None:
+            raise _error(DEPENDENCY_INDEX_INVALID, "unsupported address", address=repr(address))
+        if node_id in self.index.nodes and node_id in self._cache:
+            row: Any = self._authoritative_row(node_id, state)
+        else:
+            steps = state.get("steps")
+            row = steps.get(self._presentation_key(node_id)) if isinstance(steps, Mapping) else None
+        if not isinstance(row, Mapping):
+            return False, None
+        if isinstance(address, NodeResultAddress):
+            field, member = address.field, address.member
+        elif isinstance(address, (BlockOutputAddress, LoopOutputAddress, CallOutputAddress)):
+            field, member = "artifacts", address.output_name
+        else:
+            raise _error(DEPENDENCY_INDEX_INVALID, "unsupported address", address=repr(address))
+        container = row.get(field)
+        if member is None:
+            return (field in row), container
+        if isinstance(container, Mapping) and member in container:
+            return True, container[member]
+        return False, None

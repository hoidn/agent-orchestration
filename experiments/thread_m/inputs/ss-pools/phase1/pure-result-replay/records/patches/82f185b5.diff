+        return value
+
+    # -- leaf audit -------------------------------------------------------------
+
+    def _validate_leaf(self, binding: PureReplayBinding, state: Mapping[str, Any]) -> None:
+        address = binding.address
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _error(DURABLE_INPUT_MISSING, "durable pure input is missing", address=repr(address))

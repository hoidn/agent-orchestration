+def evaluate_pure_projection_in_memory(
+    runtime: StepRuntime,
+    step: RuntimeStepInput,
+    state: Dict[str, Any],
+) -> Dict[str, Any]:
+    """Evaluate one pure projection with no bundle read, write or reuse."""
+    config = step.get("pure_projection")

+    def required_node_ids_for_boundary(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        reached = []
+        for node_id in self.index.nodes:
+            witness = self.witness_from_state(node_id, state)
+            progress = classify_pure_replay_progress(state, witness=witness)
+            if progress == PROGRESS_WITNESS_INVALID:
+                raise _error(PROGRESS_WITNESS_INVALID, "invalid pure progress", node_id=node_id)
+            if progress == DERIVED_COMPLETE:
+                reached.append(node_id)
+        return self.index.required_pure_node_ids(
+            self._seed_addresses(restart_node_id), reached_node_ids=reached
+        )
+
+    def audit_boundary_leaves(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        for node_id in required:
+            for binding in self._all_durable_leaves(self.index.nodes[node_id]):
+                self._validate_leaf(binding, state)
+        return required
+
+    # -- replay --------------------------------------------------------------------------
+
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[Any, dict[str, Any]], Mapping[str, Any]],
+    ) -> dict[str, Any]:
+        node = self._node(node_id)
+        witness = self.witness_from_state(node_id, state)
+        if classify_pure_replay_progress(state, witness=witness) != DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "node is not a derived-complete visit", node_id=node_id)
+        result = evaluate_node(_ReplayStep(node), self.overlay_active_state(state))
+        if result.get("status") != "completed":
+            raise self._failure(node, result)
+        row = self._validated_row(node, witness, result)
+        self._cache[node_id] = (witness, row)
+        return copy.deepcopy(row)
+
+    def _failure(self, node: PureReplayNode, result: Mapping[str, Any]) -> PureResultReplayIndexError:
+        error = result.get("error") if isinstance(result.get("error"), Mapping) else {}
+        context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+        if error.get("type") == "materialize_ref_unresolved":
+            reason, cause = BINDING_UNRESOLVED, "materialize_ref_unresolved"
+        elif context.get("reason") == "pure_projection_contract_invalid":
+            reason, cause = OUTPUT_CONTRACT_INVALID, "pure_projection_contract_invalid"
+        else:
+            reason, cause = EVALUATION_FAILED, "pure_evaluation_failed"
+        return _error(
+            reason,
+            f"pure result for {node.presentation_key!r} could not be re-derived",
+            node_id=node.node_id,
+            step_id=node.step_id,
+            cause={"type": cause},
+        )
+
+    def replay_boundary(
+        self,
+        restart_node_id: Optional[str],
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[Any, dict[str, Any]], Mapping[str, Any]],
+    ) -> tuple[str, ...]:
+        """Audit leaves, then re-derive every required node in topological order."""
+        required = self.audit_boundary_leaves(restart_node_id, state=state)
+        for node_id in required:
+            self.replay_node(node_id, state=state, evaluate_node=evaluate_node)
+        return required
+
+    # -- persisted surface audit ------------------------------------------------------------------
+
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Mapping[str, Any],
+        state_manager: Any,
+        resolve_bundle_path: Callable[[PureReplayNode], Optional[Path]],
+    ) -> None:
+        """Raise ``profile_conflict`` when an eligible node left a durable value surface."""
+        _audit_persisted_surfaces(
+            self,
+            state=state,
+            state_manager=state_manager,
+            resolve_bundle_path=resolve_bundle_path,
+        )

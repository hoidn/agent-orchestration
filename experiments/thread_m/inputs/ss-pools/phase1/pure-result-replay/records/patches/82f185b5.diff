+
+    def _all_durable_leaves(self, node: PureReplayNode) -> Iterable[PureReplayBinding]:
+        pure = set(self.index.nodes)
+        return (b for b in node.bindings if getattr(b.address, "node_id", None) not in pure)
+
+    # -- boundary planning ----------------------------------------------------------
+
+    def _seed_addresses(self, restart_node_id: Optional[str]) -> list[Any]:
+        ir = self.bundle.ir
+        projection = self.bundle.projection
+        ordered = list(projection.ordered_execution_node_ids())
+        before: set[str] = set()
+        if restart_node_id is not None:
+            if restart_node_id not in ordered:
+                raise _error(REACHABILITY_AMBIGUOUS, "restart node is not a top-level node", node_id=restart_node_id)
+            before = set(ordered[: ordered.index(restart_node_id)])
+        else:
+            before = set(ordered)
+        seeds: list[Any] = []
+        key_to_node = {n.presentation_key: n.node_id for n in self.index.nodes.values()}
+
+        def collect(obj: Any) -> None:
+            if isinstance(obj, (NodeResultAddress, BlockOutputAddress, LoopOutputAddress, CallOutputAddress)):
+                seeds.append(obj)
+            elif isinstance(obj, str):
+                for match in _STEP_REF_RE.finditer(obj):
+                    node_id = key_to_node.get(match.group(1))
+                    if node_id is not None:
+                        seeds.append(NodeResultAddress(node_id, "artifacts"))
+            elif isinstance(obj, Mapping):
+                for key, value in obj.items():
+                    collect(key)
+                    collect(value)
+            elif isinstance(obj, (list, tuple, set, frozenset)):
+                for item in obj:
+                    collect(item)
+            elif hasattr(obj, "__dataclass_fields__"):
+                for name in obj.__dataclass_fields__:
+                    collect(getattr(obj, name))

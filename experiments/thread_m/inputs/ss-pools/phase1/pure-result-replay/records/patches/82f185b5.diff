+def test_binding_documents_accept_exact_refs_and_typed_literals(selector_bundle) -> None:
+    record = {"kind": "record", "name": "R", "fields": [{"name": "x", "type": STRING}, {"name": "n", "type": INT}]}
+    found = _walk_doc(selector_bundle, {"x": {"ref": "inputs.status"}, "n": 3}, record)
+    assert [(b.path, b.address.input_name) for b in found] == [(("b", "x"), "status")]
+    assert _walk_doc(selector_bundle, {"variant": "A", "a": "x", "b": 4}, UNION) == []
+
+
+@pytest.mark.parametrize(
+    ("doc", "descriptor"),
+    [
+        ("text", INT),
+        ({"ref": 5}, STRING),
+        ({"ref": "inputs.status", "extra": 1}, STRING),
+        ({"ref": "self.steps.x.exit_code"}, INT),
+        ({"ref": "inputs.nope"}, STRING),
+        ({"variant": "A", "a": "x", "b": "not-an-int"}, UNION),
+        ({"variant": "C"}, UNION),
+        ("${steps.unbound}", STRING),
+    ],
+)
+def test_binding_documents_reject_bad_literals_and_refs(selector_bundle, doc, descriptor) -> None:
+    with pytest.raises(PureResultReplayIndexError) as excinfo:

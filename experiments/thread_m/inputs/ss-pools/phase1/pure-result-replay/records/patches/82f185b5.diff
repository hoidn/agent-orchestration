@@ -0,0 +1,374 @@
+"""Behavioral tests for the derived pure-result profile: selector, shell, index, frames."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import RunState, StateManager, StepResult
+from orchestrator.workflow.call_frame_state import (
+    _CallFrameStateManager,
+    load_existing_call_frame_read_only,
+)
+from orchestrator.workflow.pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_PURE_REPLAY_PROFILE,
+    MULTIPLE_VISIT_REGION,
+    PureReplayRuntime,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    derive_pure_result_replay_index,
+    validate_pure_completion_shell,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.pure_replay_helpers import VALID, _compile, selector_bundle  # noqa: F401
+
+# -- selector ------------------------------------------------------------------
+
+
+def _state_kwargs(**extra):
+    return dict(
+        schema_version="2.1",
+        run_id="r",
+        workflow_file="w.orc",
+        workflow_checksum="sha256:x",
+        started_at="t",
+        updated_at="t",
+        status="running",
+        **extra,
+    )
+
+
+def test_absent_profile_is_omitted_and_round_trips() -> None:
+    payload = RunState(**_state_kwargs()).to_dict()
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None
+    assert RunState.from_dict(payload).to_dict() == payload
+
+
+def test_present_profile_round_trips() -> None:
+    state = RunState(**_state_kwargs(result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE))
+    assert RunState.from_dict(state.to_dict()).result_persistence_profile == "derived_pure_replay.v1"
+
+
+def test_unknown_profile_fails_closed_everywhere(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="profile"):
+        RunState(**_state_kwargs(result_persistence_profile="derived_pure_replay.v2"))
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="bad")
+    with pytest.raises(ValueError, match="profile"):
+        manager.initialize("w.orc", result_persistence_profile="nope")
+
+    good = StateManager(workspace=tmp_path, run_id="good")
+    good.initialize("w.orc", result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+    payload = json.loads(good.state_file.read_text(encoding="utf-8"))
+    payload["result_persistence_profile"] = "nope"
+    good.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = good.state_file.read_bytes()
+    with pytest.raises(ValueError, match="profile"):
+        StateManager(workspace=tmp_path, run_id="good").load()
+    assert good.state_file.read_bytes() == before
+
+
+def test_initialize_writes_profile_before_any_visit(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="r")
+    manager.initialize("w.orc", result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+    payload = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert payload["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    assert payload["step_visits"] == {}
+
+
+# -- shell and progress ------------------------------------------------------------
+
+
+WITNESS = PureReplayVisitWitness("step", 3, "root.step", 1)
+
+
+def test_completion_shell_is_exact() -> None:
+    assert build_pure_completion_shell(WITNESS) == {
+        "name": "step",
+        "step_id": "root.step",
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+        "result_storage": "derived_pure_replay.v1",
+    }
+
+
+@pytest.mark.parametrize("extra", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_rejects_extra_keys(extra: str) -> None:
+    row = {**build_pure_completion_shell(WITNESS), extra: 1}
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(row, witness=WITNESS)
+
+
+def test_shell_rejects_missing_wrong_and_loose_outcome() -> None:
+    shell = build_pure_completion_shell(WITNESS)
+    for broken in (
+        {k: v for k, v in shell.items() if k != "exit_code"},
+        {**shell, "visit_count": 2},
+        {**shell, "outcome": {**shell["outcome"], "retryable": 0}},
+        {**shell, "outcome": {**shell["outcome"], "extra": 1}},
+    ):
+        with pytest.raises(ValueError):
+            validate_pure_completion_shell(broken, witness=WITNESS)
+
+
+def _cursor(**over):
+    cursor = {
+        "name": "step", "index": 3, "type": "pure_projection", "step_id": "root.step",
+        "visit_count": 1, "status": "running",
+    }
+    return {**cursor, **over}
+
+
+def _state(*, visit=None, cursor=None, row=None):
+    return {
+        "step_visits": {} if visit is None else {"step": visit},
+        "current_step": cursor,
+        "steps": {} if row is None else {"step": row},
+    }
+
+
+FAILED_ROW = {"name": "step", "step_id": "root.step", "visit_count": 1, "status": "failed"}
+
+
+@pytest.mark.parametrize(
+    ("state", "expected"),
+    [
+        (_state(), "unstarted"),
+        (_state(cursor={"name": "other", "step_id": "root.other", "status": "running"}), "unstarted"),
+        (_state(visit=1, cursor=_cursor()), "interrupted"),
+        (_state(visit=1, row=build_pure_completion_shell(WITNESS)), "derived_complete"),
+        (_state(visit=1, row=build_pure_completion_shell(WITNESS),
+                cursor={"name": "other", "step_id": "root.other"}), "derived_complete"),
+        (_state(visit=1, row=FAILED_ROW), "durable_failure_skip"),
+        (_state(visit=1, row={**FAILED_ROW, "status": "skipped"}), "durable_failure_skip"),
+        (_state(visit=1), "progress_witness_invalid"),
+        (_state(cursor=_cursor()), "progress_witness_invalid"),
+        (_state(row=build_pure_completion_shell(WITNESS)), "progress_witness_invalid"),
+        (_state(visit=1, cursor=_cursor(), row=build_pure_completion_shell(WITNESS)), "progress_witness_invalid"),
+        (_state(visit=1, cursor=_cursor(visit_count=2)), "progress_witness_invalid"),
+        (_state(visit=1, cursor=_cursor(type="command")), "progress_witness_invalid"),
+        (_state(visit=1, cursor=_cursor(index=9)), "progress_witness_invalid"),
+        (_state(visit=2, cursor=_cursor(visit_count=2)), "progress_witness_invalid"),
+        (_state(visit=1, row={**FAILED_ROW, "visit_count": 2}), "progress_witness_invalid"),
+        (_state(visit=1, row={**FAILED_ROW, "step_id": "root.other"}), "progress_witness_invalid"),
+        (_state(visit=1, row={**build_pure_completion_shell(WITNESS), "artifacts": {}}), "progress_witness_invalid"),
+        (_state(visit=1, row={**FAILED_ROW, "status": "running"}), "progress_witness_invalid"),
+        (_state(visit=1, cursor=_cursor(), row=FAILED_ROW), "progress_witness_invalid"),
+    ],
+)
+def test_progress_classification(state, expected) -> None:
+    assert classify_pure_replay_progress(state, witness=WITNESS) == expected
+
+
+# -- state manager transactions -------------------------------------------------------
+
+
+def test_visit_transactions_publish_and_settle_atomically(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="r")
+    manager.initialize("w.orc", result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+
+    assert manager.begin_eligible_pure_visit(step_name="step", step_index=3, step_id="root.step") == 1
+    on_disk = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert on_disk["step_visits"] == {"step": 1}
+    assert {k: on_disk["current_step"][k] for k in ("name", "index", "type", "step_id", "visit_count", "status")} == {
+        "name": "step", "index": 3, "type": "pure_projection", "step_id": "root.step",
+        "visit_count": 1, "status": "running",
+    }
+    assert manager.reuse_interrupted_eligible_pure_visit(WITNESS) == 1
+
+    shell = manager.settle_eligible_pure_success(WITNESS)
+    on_disk = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert shell == build_pure_completion_shell(WITNESS) == on_disk["steps"]["step"]
+    assert "current_step" not in on_disk
+
+
+def test_double_begin_and_settle_without_visit_are_rejected(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="r")
+    manager.initialize("w.orc")
+    with pytest.raises(PureResultReplayIndexError):
+        manager.settle_eligible_pure_success(WITNESS)
+    manager.begin_eligible_pure_visit(step_name="step", step_index=3, step_id="root.step")
+    with pytest.raises(PureResultReplayIndexError):
+        manager.begin_eligible_pure_visit(step_name="step", step_index=3, step_id="root.step")
+    assert json.loads(manager.state_file.read_text(encoding="utf-8"))["step_visits"] == {"step": 1}
+
+
+def test_failure_settlement_keeps_full_row(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="r")
+    manager.initialize("w.orc")
+    manager.begin_eligible_pure_visit(step_name="step", step_index=3, step_id="root.step")
+    result = StepResult(status="failed", name="step", step_id="root.step", visit_count=1, exit_code=2,
+                        error={"type": "boom"})
+    assert manager.settle_eligible_pure_failure(WITNESS, result) is None
+    row = json.loads(manager.state_file.read_text(encoding="utf-8"))["steps"]["step"]
+    assert row["error"] == {"type": "boom"}
+
+
+# -- index -----------------------------------------------------------------------------
+
+
+def test_index_of_straight_line_pure_node(selector_bundle) -> None:
+    index = derive_pure_result_replay_index(selector_bundle)
+    (node,) = index.nodes.values()
+    assert index.scope_kind == "root"
+    assert index.topological_node_ids == (node.node_id,)
+    assert [b.address.input_name for b in node.bindings] == ["status", "approved"]
+    assert {a.member for a in node.output_addresses} == {"return__status", "return__ready"}
+    assert node.pure_dependency_node_ids == () and node.durable_dependency_node_ids == ()
+    assert index.required_pure_node_ids(node.output_addresses, reached_node_ids=[node.node_id]) == (node.node_id,)
+    assert index.required_pure_node_ids(node.output_addresses, reached_node_ids=[]) == ()
+
+
+def test_loop_owned_pure_nodes_are_ineligible(tmp_path: Path) -> None:
+    bundle = _compile(VALID / "pure_expr_loop_counter.orc", tmp_path, "::run-counter")
+    index = derive_pure_result_replay_index(bundle)
+    assert index.nodes == {}
+    assert set(index.ineligible_pure_reasons.values()) == {MULTIPLE_VISIT_REGION}
+
+
+def test_scope_mismatch_names_both_scopes(selector_bundle) -> None:
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(selector_bundle, scope_kind="call_frame")
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+    assert excinfo.value.code == "pure_result_replay_unavailable"
+    assert excinfo.value.context["actual_scope"] == "root"
+    assert excinfo.value.context["expected_scope"] == "call_frame"
+
+
+def test_index_does_not_change_serialized_plan(selector_bundle) -> None:
+    before = repr(selector_bundle.runtime_plan)
+    derive_pure_result_replay_index(selector_bundle)
+    assert repr(selector_bundle.runtime_plan) == before
+
+
+def test_runtime_maps_step_id_but_not_node_id_literal(selector_bundle) -> None:
+    runtime = PureReplayRuntime(bundle=selector_bundle, scope_path=ResumeScopePath.root("w.orc"))
+    (node,) = runtime.index.nodes.values()
+    assert runtime.node_id_for_step_id(node.step_id) == node.node_id
+    assert runtime.node_id_for_step_id("not-a-step") is None
+
+
+# -- call frames --------------------------------------------------------------------------
+
+
+def test_read_only_frame_loader_returns_detached_copy(tmp_path: Path) -> None:
+    frame = {"state": {"steps": {"a": {"x": 1}}}}
+    loaded = load_existing_call_frame_read_only(frame)
+    loaded["steps"]["a"]["x"] = 2
+    assert frame["state"]["steps"]["a"]["x"] == 1
+    assert list(tmp_path.iterdir()) == []
+
+
+@pytest.mark.parametrize("frame", [{}, {"state": None}, {"state": []}])
+def test_malformed_existing_frame_is_rejected_before_any_write(tmp_path: Path, frame) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    parent = StateManager(workspace=tmp_path, run_id="r")
+    parent.initialize("w.orc")
+    before = parent.state_file.read_bytes()
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        _CallFrameStateManager(
+            parent_manager=parent, workflow=None, frame_id="f", call_step_name="c", call_step_id="c",
+            import_alias="a", bound_inputs={}, existing_frame=frame,
+        )
+    assert parent.state_file.read_bytes() == before
+    assert not (parent.run_root / "call_frames").exists()
+
+
+def _walk_doc(selector_bundle, doc, descriptor):
+    from orchestrator.workflow.pure_replay_index import _DocWalker
+
+    node_id = next(iter(selector_bundle.ir.nodes))
+    walker = _DocWalker(selector_bundle, node_id)
+    walker.walk(doc, descriptor, ("b",))
+    return walker.found
+
+
+STRING = {"kind": "primitive", "name": "String"}
+INT = {"kind": "primitive", "name": "Int"}
+UNION = {
+    "kind": "union", "name": "U",
+    "variants": [
+        {"name": "A", "fields": [{"name": "a", "type": STRING}]},
+        {"name": "B", "fields": [{"name": "b", "type": INT}]},
+    ],
+}

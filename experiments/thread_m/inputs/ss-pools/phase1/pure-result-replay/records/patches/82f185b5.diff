+def test_outcome_recorder_settles_pure_success_through_the_manager() -> None:
+    from orchestrator.workflow.outcomes import OutcomeRecorder
+
+    calls = []
+
+    class Manager:
+        def settle_eligible_pure_success(self, witness):
+            calls.append(("success", witness))
+            return build_pure_completion_shell(witness)
+
+        def settle_eligible_pure_failure(self, witness, result):
+            calls.append(("failure", result.status))
+
+        def update_step(self, *_):
+            raise AssertionError("eligible pure results never use the ordinary update")
+
+        def update_run_error(self, *_):
+            pass
+
+    emitted = []
+    recorder = OutcomeRecorder(
+        state_manager=Manager(),
+        step_id_resolver=lambda step: "root.step",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, row: emitted.append(row),
+    )
+    state = {"step_visits": {"step": 1}}
+    finalized = recorder.persist_step_result(
+        state, "step", {}, {"status": "completed", "exit_code": 0, "artifacts": {"v": 1}},
+        eligible_pure_settlement=WITNESS,
+    )
+    assert finalized["artifacts"] == {"v": 1} and state["steps"]["step"] is finalized
+    assert emitted == [build_pure_completion_shell(WITNESS)]
+    recorder.persist_step_result(
+        state, "step", {}, {"status": "failed", "exit_code": 2, "error": {"type": "x"}},
+        eligible_pure_settlement=WITNESS,
+    )
+    assert calls[-1] == ("failure", "failed")
+

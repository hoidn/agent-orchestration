diff --git a/orchestrator/pure_replay_witness.py b/orchestrator/pure_replay_witness.py
new file mode 100644
index 0000000..873e700
--- /dev/null
+++ b/orchestrator/pure_replay_witness.py
@@ -0,0 +1,310 @@
+"""Value-free completion shell, visit witness and progress classification.
+
+Dependencies: stdlib only (kept below ``orchestrator.state`` so state managers can use it).
+Behavior: defines the exact durable row an eligible pure projection leaves under the
+``derived_pure_replay.v1`` result persistence profile, and classifies one state's
+visit, cursor and row for one witness. Pure functions over plain state mappings.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+DERIVED_PURE_REPLAY_PROFILE = "derived_pure_replay.v1"
+PURE_REPLAY_UNAVAILABLE_CODE = "pure_result_replay_unavailable"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+
+PROGRESS_UNSTARTED = "unstarted"
+PROGRESS_INTERRUPTED = "interrupted"
+PROGRESS_DERIVED_COMPLETE = "derived_complete"
+PROGRESS_DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+_PURE_STEP_TYPE = "pure_projection"
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed pure-result replay error carrying a stable reason."""
+
+    code = PURE_REPLAY_UNAVAILABLE_CODE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+    def __post_init__(self) -> None:
+        for name in ("presentation_key", "step_id"):
+            value = getattr(self, name)
+            if not isinstance(value, str) or not value:
+                raise ValueError(f"witness {name} must be a non-empty string")
+        for name in ("step_index", "visit_count"):
+            value = getattr(self, name)
+            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+                raise ValueError(f"witness {name} must be a non-negative integer")
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"))
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row for one single-visit success."""
+    if witness.visit_count != 1:
+        raise ValueError("a derived pure completion shell requires visit_count 1")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's completion shell."""
+    expected = build_pure_completion_shell(witness)
+    if not isinstance(row, Mapping):
+        raise ValueError("pure completion shell must be a mapping")
+    if set(row) != set(expected):
+        extra = sorted(set(row) - set(expected))
+        missing = sorted(set(expected) - set(row))
+        raise ValueError(
+            f"pure completion shell keys differ (extra={extra}, missing={missing})"
+        )
+    for key, value in expected.items():
+        if _canonical(row[key]) != _canonical(value):
+            raise ValueError(f"pure completion shell field {key!r} is not exact")
+
+
+def _is_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _cursor_is_related(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    if cursor is None:
+        return False
+    if not isinstance(cursor, Mapping):
+        return True
+    return cursor.get("name") == witness.presentation_key or cursor.get(
+        "step_id"
+    ) == witness.step_id
+
+
+def _cursor_matches(cursor: Mapping[str, Any], witness: PureReplayVisitWitness, visit: int) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and _is_int(cursor.get("index"))
+        and cursor.get("type") == _PURE_STEP_TYPE
+        and cursor.get("status") == "running"
+        and _is_int(cursor.get("visit_count"))
+        and cursor.get("visit_count") == visit
+    )
+
+
+def _failure_row_matches(row: Any, witness: PureReplayVisitWitness, visit: int) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("name") == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and _is_int(row.get("visit_count"))
+        and row.get("visit_count") == visit
+    )
+
+
+def classify_pure_replay_progress(
+    state: Mapping[str, Any],
+    *,
+    witness: PureReplayVisitWitness,
+) -> str:
+    """Classify one state's visit, cursor and row for ``witness``."""
+    visits = state.get("step_visits")
+    visit = visits.get(witness.presentation_key) if isinstance(visits, Mapping) else None
+    steps = state.get("steps")
+    row = steps.get(witness.presentation_key) if isinstance(steps, Mapping) else None
+    cursor = state.get("current_step")
+    related = _cursor_is_related(cursor, witness)
+
+    if visit is None:
+        if related or row is not None:
+            return PROGRESS_WITNESS_INVALID
+        return PROGRESS_UNSTARTED
+    if not _is_int(visit) or visit != witness.visit_count:
+        return PROGRESS_WITNESS_INVALID
+    if related:
+        if row is None and isinstance(cursor, Mapping) and _cursor_matches(cursor, witness, visit):
+            return PROGRESS_INTERRUPTED
+        return PROGRESS_WITNESS_INVALID
+    if row is None:
+        return PROGRESS_WITNESS_INVALID
+    if _is_shell(row, witness):
+        return PROGRESS_DERIVED_COMPLETE
+    if _failure_row_matches(row, witness, visit):
+        return PROGRESS_DURABLE_FAILURE_SKIP
+    return PROGRESS_WITNESS_INVALID
+
+
+def require_progress(
+    state: Mapping[str, Any],
+    *,
+    witness: PureReplayVisitWitness,
+    expected: str,
+    operation: str,
+) -> None:
+    """Raise ``progress_witness_invalid`` unless the state is in ``expected`` progress."""
+    observed = classify_pure_replay_progress(state, witness=witness)
+    if observed != expected:
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            f"{operation} requires {expected} pure progress, observed {observed}",
+            context={
+                "step_id": witness.step_id,
+                "presentation_key": witness.presentation_key,
+                "expected": expected,
+                "observed": observed,
+            },
+        )
+
+
+def running_cursor(
+    *, step_name: str, step_index: int, step_id: str, visit_count: int, now: str
+) -> dict[str, Any]:
+    """Build the running ``current_step`` cursor for one eligible pure visit."""
+    return {
+        "name": step_name,
+        "index": step_index,
+        "type": _PURE_STEP_TYPE,
+        "step_id": step_id,
+        "visit_count": visit_count,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+
+
+def _progress_view(run_state: Any) -> dict[str, Any]:
+    """Plain-mapping view of the fields progress classification reads."""
+    steps = {
+        name: row.to_dict() if hasattr(row, "to_dict") else row
+        for name, row in run_state.steps.items()
+    }
+    return {
+        "step_visits": run_state.step_visits,
+        "steps": steps,
+        "current_step": run_state.current_step,
+    }
+
+
+def require_profile(run_state: Any, operation: str) -> None:
+    """Eligible-pure transitions are only legal under the derived profile."""
+    if run_state.result_persistence_profile != DERIVED_PURE_REPLAY_PROFILE:
+        raise PureResultReplayIndexError(
+            "profile_conflict",
+            f"{operation} requires result_persistence_profile {DERIVED_PURE_REPLAY_PROFILE}",
+            context={"profile": run_state.result_persistence_profile},
+        )
+
+
+def apply_begin_eligible_visit(
+    run_state: Any, *, step_name: str, step_index: int, step_id: str, now: str
+) -> int:
+    """Increment the visit and publish its running cursor on ``run_state``."""
+    require_profile(run_state, "begin_eligible_pure_visit")
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    require_progress(
+        _progress_view(run_state),
+        witness=witness,
+        expected=PROGRESS_UNSTARTED,
+        operation="begin_eligible_pure_visit",
+    )
+    run_state.step_visits[step_name] = 1
+    run_state.current_step = running_cursor(
+        step_name=step_name,
+        step_index=step_index,
+        step_id=step_id,
+        visit_count=1,
+        now=now,
+    )
+    return 1
+
+
+def apply_reuse_interrupted_visit(run_state: Any, witness: PureReplayVisitWitness) -> int:
+    """Validate an interrupted visit; writes nothing."""
+    require_profile(run_state, "reuse_interrupted_eligible_pure_visit")
+    require_progress(
+        _progress_view(run_state),
+        witness=witness,
+        expected=PROGRESS_INTERRUPTED,
+        operation="reuse_interrupted_eligible_pure_visit",
+    )
+    return witness.visit_count
+
+
+def apply_settle_success(run_state: Any, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Persist the exact shell and clear the cursor on ``run_state``."""
+    require_profile(run_state, "settle_eligible_pure_success")
+    require_progress(
+        _progress_view(run_state),
+        witness=witness,
+        expected=PROGRESS_INTERRUPTED,
+        operation="settle_eligible_pure_success",
+    )
+    shell = build_pure_completion_shell(witness)
+    run_state.steps[witness.presentation_key] = shell
+    run_state.current_step = None
+    return dict(shell)
+
+
+def apply_settle_failure(run_state: Any, witness: PureReplayVisitWitness, result: Any) -> None:
+    """Persist a full failed or skipped row and clear the cursor on ``run_state``."""
+    require_profile(run_state, "settle_eligible_pure_failure")
+    require_progress(
+        _progress_view(run_state),
+        witness=witness,
+        expected=PROGRESS_INTERRUPTED,
+        operation="settle_eligible_pure_failure",
+    )
+    row = result.to_dict() if hasattr(result, "to_dict") else dict(result)
+    if not _failure_row_matches(row, witness, witness.visit_count):
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            "settle_eligible_pure_failure requires a failed or skipped row matching the witness",
+            context={"step_id": witness.step_id, "presentation_key": witness.presentation_key},
+        )
+    run_state.steps[witness.presentation_key] = result
+    run_state.current_step = None

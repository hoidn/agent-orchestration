+def test_cli_run_and_force_restart_select_profile_and_keep_source_unchanged(tmp_path: Path, monkeypatch) -> None:
+    import subprocess
+    import sys
+
+    source = tmp_path / "pure_expr_selector_action_projection.orc"
+    source.write_text((FIXTURES / "pure_expr_selector_action_projection.orc").read_text())
+    env = {**__import__("os").environ, "PYTHONPATH": str(Path(__file__).parent.parent)}
+
+    def cli(*args):
+        return subprocess.run([sys.executable, "-m", "orchestrator", *args], cwd=tmp_path,
+                              env=env, capture_output=True, text=True, check=True)
+
+    cli("run", "pure_expr_selector_action_projection.orc", "--input", "approved=false", "--input", "status=WAIT")
+    runs = tmp_path / ".orchestrate" / "runs"
+    (run_dir,) = list(runs.iterdir())
+    state_file = run_dir / "state.json"
+    assert json.loads(state_file.read_text())["result_persistence_profile"] == PROFILE
+    before = state_file.read_bytes()
+    cli("resume", run_dir.name, "--force-restart")
+    assert state_file.read_bytes() == before
+    (new_dir,) = [p for p in runs.iterdir() if p != run_dir]
+    assert json.loads((new_dir / "state.json").read_text())["result_persistence_profile"] == PROFILE

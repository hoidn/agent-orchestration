diff --git a/orchestrator/workflow/pure_replay_executor.py b/orchestrator/workflow/pure_replay_executor.py
new file mode 100644
index 0000000..23a67f3
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_executor.py
@@ -0,0 +1,162 @@
+"""Executor-side wiring of the derived pure replay profile.
+
+Dependencies: the host ``WorkflowExecutor`` (state manager, loaded bundle, runtime step
+lookup, pure-projection evaluation) and ``PureReplayRuntime``.
+Behavior: under ``result_persistence_profile == derived_pure_replay.v1`` it (1) audits
+persisted surfaces and progress witnesses before a resume prologue, (2) rebuilds the pure
+values a resume boundary needs into the in-memory state, (3) opens and settles each
+eligible pure visit atomically, and (4) fails closed with
+``pure_result_replay_unavailable``. It never runs effects.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import Any, Dict, Mapping, Optional
+
+from ..pure_replay_witness import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PROGRESS_INTERRUPTED,
+    PROGRESS_UNSTARTED,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    _progress_view,
+    classify_pure_replay_progress,
+)
+from .pure_replay_runtime import PureReplayRuntime
+from .pure_result_replay import PureReplayNode
+from .steps.pure_projection import execute_pure_projection
+
+_INPUT_TEMPLATE = re.compile(r"\$\{inputs\.([^}]+)\}")
+
+
+class PureReplayExecutorMixin:
+    """Profile-gated pure replay behavior for ``WorkflowExecutor``."""
+
+    _pure_replay: Optional[PureReplayRuntime] = None
+    _pure_witnesses: Dict[str, PureReplayVisitWitness]
+
+    def _init_pure_replay(self, run_state: Any) -> None:
+        """Build the replay runtime when this scope's state selects the profile."""
+        self._pure_replay = None
+        self._pure_witnesses = {}
+        if getattr(run_state, "result_persistence_profile", None) != DERIVED_PURE_REPLAY_PROFILE:
+            return
+        runtime = PureReplayRuntime(
+            bundle=self.loaded_bundle, scope_path=self.resume_scope_path  # type: ignore[attr-defined]
+        )
+        self._pure_replay = runtime if runtime.index.nodes else None
+
+    def _eligible_pure_node_id(self, node_id: Optional[str]) -> Optional[str]:
+        runtime = self._pure_replay
+        if runtime is None or node_id not in runtime.index.nodes:
+            return None
+        return node_id
+
+    def _pure_node_id_for_step(self, step: Any) -> Optional[str]:
+        runtime = self._pure_replay
+        if runtime is None:
+            return None
+        return runtime.node_id_for_step_id(self._step_id(step))  # type: ignore[attr-defined]
+
+    def _fail_pure_replay(self, exc: PureResultReplayIndexError) -> Dict[str, Any]:
+        """Persist a fail-closed replay error and return the failed state."""
+        return self._fail_resume_state_integrity(  # type: ignore[attr-defined]
+            exc.code, str(exc), {"reason": exc.reason, **exc.context}
+        )
+
+    def _pure_bundle_path(self, node: PureReplayNode, state: Mapping[str, Any]) -> Optional[Path]:
+        """Where this eligible node's private result bundle would live, if bound."""
+        ir_node = self.executable_ir.nodes[node.node_id]  # type: ignore[attr-defined]
+        output_bundle = ir_node.execution_config.common.output_bundle
+        raw = output_bundle.get("path") if isinstance(output_bundle, Mapping) else None
+        match = _INPUT_TEMPLATE.fullmatch(raw) if isinstance(raw, str) else None
+        if match:
+            bound = state.get("bound_inputs")
+            raw = bound.get(match.group(1)) if isinstance(bound, Mapping) else None
+        if not isinstance(raw, str) or not raw:
+            return None
+        return self._bounded_private_runtime_bundle_path(  # type: ignore[attr-defined]
+            (self.workspace / raw).resolve(), namespace="pure_projection"  # type: ignore[attr-defined]
+        )
+
+    def _pure_replay_preflight(self, state: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+        """Audit surfaces and progress witnesses of a resumed state before the prologue."""
+        runtime = self._pure_replay
+        if runtime is None:
+            return None
+        runtime.audit_persisted_surfaces(
+            state=state,
+            state_manager=self.state_manager,  # type: ignore[attr-defined]
+            resolve_bundle_path=self._pure_bundle_path,
+        )
+        for node_id in runtime.index.nodes:
+            if runtime.progress(node_id, state) == PROGRESS_WITNESS_INVALID:
+                return self._fail_pure_replay(
+                    PureResultReplayIndexError(
+                        PROGRESS_WITNESS_INVALID,
+                        f"pure node {node_id} has an invalid progress witness",
+                        context={"node_id": node_id},
+                    )
+                )
+        return None
+
+    def _evaluate_pure_node_for_replay(self, node: PureReplayNode, overlay: Dict[str, Any]) -> Dict[str, Any]:
+        step = self._typed_execution_step(  # type: ignore[attr-defined]
+            self._runtime_step_for_node_id(node.node_id)  # type: ignore[attr-defined]
+        )
+        return execute_pure_projection(self, step, overlay, persist_bundle=False)  # type: ignore[arg-type]
+
+    def _replay_pure_prefix(self, state: Dict[str, Any], restart_node_id: Any) -> Optional[Dict[str, Any]]:
+        """Rebuild the pure values the resume boundary needs into ``state`` (in memory)."""
+        runtime = self._pure_replay
+        if runtime is None:
+            return None
+        boundary = restart_node_id if isinstance(restart_node_id, str) else None
+        try:
+            for node_id in runtime.audit_boundary_leaves(boundary, state=state):
+                row = runtime.replay_node(
+                    node_id, state=state, evaluate_node=self._evaluate_pure_node_for_replay
+                )
+                state.setdefault("steps", {})[runtime.index.nodes[node_id].presentation_key] = row
+        except PureResultReplayIndexError as exc:
+            return self._fail_pure_replay(exc)
+        return None
+
+    def _begin_eligible_pure_visit(self, node_id: str, state: Dict[str, Any]) -> PureReplayVisitWitness:
+        """Open (or re-enter an interrupted) single visit of one eligible pure node."""
+        runtime = self._pure_replay
+        assert runtime is not None
+        node = runtime.index.nodes[node_id]
+        witness = runtime.witness(node_id)
+        manager_state = self.state_manager.state  # type: ignore[attr-defined]
+        progress = classify_pure_replay_progress(_progress_view(manager_state), witness=witness)
+        if progress == PROGRESS_UNSTARTED:
+            self.state_manager.begin_eligible_pure_visit(  # type: ignore[attr-defined]
+                step_name=node.presentation_key,
+                step_index=node.execution_index,
+                step_id=node.step_id,
+            )
+        elif progress == PROGRESS_INTERRUPTED:
+            self.state_manager.reuse_interrupted_eligible_pure_visit(witness)  # type: ignore[attr-defined]
+        else:
+            raise PureResultReplayIndexError(
+                PROGRESS_WITNESS_INVALID,
+                f"pure node {node_id} cannot be visited from {progress} progress",
+                context={"node_id": node_id, "observed": progress},
+            )
+        state.setdefault("step_visits", {})[node.presentation_key] = 1
+        self._pure_witnesses[node.presentation_key] = witness
+        return witness
+
+    def _settle_pure_witness(self, step_name: str) -> Optional[PureReplayVisitWitness]:
+        witnesses = getattr(self, "_pure_witnesses", None)
+        return witnesses.pop(step_name, None) if witnesses else None
+
+    def _record_pure_success(self, witness: PureReplayVisitWitness, finalized: Dict[str, Any]) -> None:
+        runtime = self._pure_replay
+        node_id = runtime.node_id_for_step_id(witness.step_id) if runtime is not None else None
+        if runtime is not None and node_id is not None and finalized.get("status") == "completed":
+            runtime.record_full_result(node_id, witness=witness, result=finalized)
diff --git a/orchestrator/workflow/pure_replay_runtime.py b/orchestrator/workflow/pure_replay_runtime.py
new file mode 100644
index 0000000..fe1f897
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_runtime.py
@@ -0,0 +1,404 @@
+"""Resume-time replay of derived pure results over durable inputs.
+
+Dependencies: ``pure_result_replay`` (index, witness, shell), a loaded workflow bundle,
+a ``ResumeScopePath``; reads the loaded run state and (for surface audits) checkpoint
+sidecars through a state manager. Holds one process-local cache of validated results.
+Behavior: validates only the dependency leaves a boundary needs, rebuilds typed pure
+values into an in-memory overlay and never dispatches an effect, increments a visit,
+settles a result or writes durable state.
+"""
+
+from __future__ import annotations
+
+import inspect
+from copy import deepcopy
+from typing import Any, Callable, Mapping, Optional
+
+from ..pure_replay_witness import _cursor_is_related, _is_shell
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_surfaces import audit_persisted_surfaces as _audit_surfaces
+from .pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    PROGRESS_DERIVED_COMPLETE,
+    PROGRESS_WITNESS_INVALID,
+    PureBinding,
+    PureReplayNode,
+    PureReplayVisitWitness,
+    PureResultReplayIndex,
+    PureResultReplayIndexError,
+    address_node_id,
+    classify_pure_replay_progress,
+    derive_pure_result_replay_index,
+    invalid_index,
+)
+from .resume_projection_integrity import ResumeScopePath
+
+EvaluateNode = Callable[[PureReplayNode, dict], Mapping[str, Any]]
+
+_COMPLETED_OUTCOME = {
+    "status": "completed",
+    "phase": "execution",
+    "class": "completed",
+    "retryable": False,
+}
+_OUTCOME_TYPES = {"status": str, "phase": str, "class": str, "retryable": bool}
+
+
+def _fail(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def expected_artifact_names(
+    contracts: Mapping[str, Mapping[str, Any]], artifacts: Mapping[str, Any]
+) -> set[str]:
+    """Names a transient pure row must hold: shared outputs plus the active variant's."""
+    expected: set[str] = set()
+    for name, contract in contracts.items():
+        projection = contract.get("projection")
+        if not isinstance(projection, Mapping) or projection.get("field_role") != "variant":
+            expected.add(name)
+            continue
+        active = artifacts.get(projection.get("discriminant_output"))
+        if active in projection.get("active_variants", ()):
+            expected.add(name)
+    return expected
+
+
+def check_transient_artifacts(node: PureReplayNode, artifacts: Any) -> None:
+    """Fail unless ``artifacts`` hold exactly the node's active typed members."""
+    if not isinstance(artifacts, Mapping):
+        raise invalid_index("pure result artifacts must be a mapping", node_id=node.node_id)
+    expected = expected_artifact_names(node.output_contracts, artifacts)
+    missing, extra = sorted(expected - set(artifacts)), sorted(set(artifacts) - expected)
+    if missing or extra:
+        raise invalid_index(
+            "pure result members differ from the active variant",
+            node_id=node.node_id,
+            missing=missing,
+            extra=extra,
+        )
+
+
+class PureReplayRuntime:
+    """Per-scope replay index, validated-result cache and overlay builder."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(
+            bundle, scope_kind="root"
+        )
+        self._nodes = bundle.ir.nodes
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._by_step_id: dict[str, str] = {}
+        for node in self.index.nodes.values():
+            self._by_step_id[node.step_id] = node.node_id
+            self._by_step_id[node.step_id.removeprefix("root.")] = node.node_id
+
+    # --- identity -----------------------------------------------------------------
+
+    def _eligible(self, node_id: str) -> PureReplayNode:
+        node = self.index.nodes.get(node_id)
+        if node is None:
+            raise _fail(DEPENDENCY_INDEX_INVALID, "node is not a replay-eligible pure node",
+                        node_id=node_id)
+        return node
+
+    def node_id_for_step_id(self, step_id: Any) -> Optional[str]:
+        """Eligible node a durable step id names; ``None`` otherwise."""
+        return self._by_step_id.get(step_id) if isinstance(step_id, str) else None
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._eligible(node_id)
+        return PureReplayVisitWitness(
+            node.presentation_key, node.execution_index, node.step_id, visit_count
+        )
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        node = self._eligible(node_id)
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        if isinstance(visit, bool) or not isinstance(visit, int) or visit < 1:
+            raise _fail(PROGRESS_WITNESS_INVALID, "pure node has no valid visit",
+                        node_id=node_id, visit=visit)
+        return self.witness(node_id, visit_count=visit)
+
+    def progress(self, node_id: str, state: Mapping[str, Any]) -> str:
+        return classify_pure_replay_progress(state, witness=self.witness(node_id))
+
+    def reached_node_ids(self, state: Mapping[str, Any]) -> tuple[str, ...]:
+        """Eligible nodes whose durable progress is an exact derived completion."""
+        return tuple(
+            node_id
+            for node_id in self.index.topological_node_ids
+            if self.progress(node_id, state) == PROGRESS_DERIVED_COMPLETE
+        )
+
+    # --- state addresses -----------------------------------------------------------
+
+    def resolve_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        """Look one typed address up in ``state``; ``(False, None)`` when absent."""
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.input_name in inputs:
+                return True, inputs[address.input_name]
+            return False, None
+        node = self._nodes.get(address_node_id(address) or "")
+        steps = state.get("steps")
+        row = steps.get(node.presentation_name) if node is not None and isinstance(steps, Mapping) else None
+        if not isinstance(row, Mapping):
+            return False, None
+        if isinstance(address, NodeResultAddress):
+            field, member = address.field, address.member
+        elif isinstance(address, (BlockOutputAddress, LoopOutputAddress, CallOutputAddress)):
+            field, member = "artifacts", address.output_name
+        else:
+            return False, None
+        container = row.get(field)
+        if member is None:
+            return (field in row), container
+        if isinstance(container, Mapping) and member in container:
+            return True, container[member]
+        return False, None
+
+    def value_for_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _fail("durable_input_missing", "durable input is missing", address=repr(address))
+        return value
+
+    # --- cache / overlay -----------------------------------------------------------
+
+    def record_full_result(
+        self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]
+    ) -> None:
+        """Hold an active executor's validated full result for ``node_id``."""
+        node = self._eligible(node_id)
+        if witness != self.witness(node_id):
+            raise _fail(PROGRESS_WITNESS_INVALID, "witness does not match the node", node_id=node_id)
+        self._validate_result(node, witness, result)
+        self._cache[node_id] = (witness, deepcopy(dict(result)))
+
+    def _validate_result(
+        self, node: PureReplayNode, witness: PureReplayVisitWitness, result: Any
+    ) -> None:
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise _fail(PROGRESS_WITNESS_INVALID, "pure result is not a completed row",
+                        node_id=node.node_id)
+        exit_code = result.get("exit_code")
+        if isinstance(exit_code, bool) or exit_code != 0:
+            raise _fail(PROGRESS_WITNESS_INVALID, "pure result exit_code must be 0",
+                        node_id=node.node_id)
+        for key, expected in (
+            ("name", witness.presentation_key),
+            ("step_id", witness.step_id),
+            ("visit_count", witness.visit_count),
+        ):
+            if key in result and result[key] != expected:
+                raise _fail(PROGRESS_WITNESS_INVALID, f"pure result {key} mismatches the witness",
+                            node_id=node.node_id)
+        check_transient_artifacts(node, result.get("artifacts"))
+
+    def _revalidated(self, node_id: str, state: Mapping[str, Any]) -> Optional[dict[str, Any]]:
+        entry = self._cache.get(node_id)
+        if entry is None:
+            return None
+        witness, result = entry
+        visits = state.get("step_visits")
+        visit = visits.get(witness.presentation_key) if isinstance(visits, Mapping) else None
+        steps = state.get("steps")
+        row = steps.get(witness.presentation_key) if isinstance(steps, Mapping) else None
+        related = _cursor_is_related(state.get("current_step"), witness)
+        exact = _is_shell(row, witness) or row == result
+        if isinstance(visit, bool) or visit != 1 or related or not exact:
+            raise _fail(PROGRESS_WITNESS_INVALID, "cached pure result no longer matches state",
+                        node_id=node_id, visit=visit, cursor_related=related)
+        return result
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Copy of ``state`` whose cached pure rows carry their full typed results."""
+        overlay = dict(state)
+        steps = dict(state.get("steps") or {})
+        for node_id, (witness, _result) in self._cache.items():
+            result = self._revalidated(node_id, state)
+            if result is not None:
+                steps[witness.presentation_key] = deepcopy(result)
+        overlay["steps"] = steps
+        return overlay
+
+    def replay_node(
+        self, node_id: str, *, state: Mapping[str, Any], evaluate_node: EvaluateNode
+    ) -> dict[str, Any]:
+        """Evaluate one derived-complete node over the overlay; writes nothing."""
+        node = self._eligible(node_id)
+        cached = self._revalidated(node_id, state)
+        if cached is not None:
+            return cached
+        witness = self.witness_from_state(node_id, state)
+        if classify_pure_replay_progress(state, witness=witness) != PROGRESS_DERIVED_COMPLETE:
+            raise _fail(PROGRESS_WITNESS_INVALID, "pure node is not an exact derived completion",
+                        node_id=node_id)
+        overlay = self.overlay_active_state(state)
+        try:
+            result = evaluate_node(node, overlay)
+        except PureResultReplayIndexError:
+            raise
+        except Exception as exc:  # evaluator failures are surfaced as typed replay errors
+            raise _fail("evaluation_failed", str(exc), node_id=node_id,
+                        cause={"type": "pure_evaluation_failed"}) from exc
+        result = self._replayed_row(node, witness, result)
+        self._cache[node_id] = (witness, result)
+        return result
+
+    def _replayed_row(
+        self, node: PureReplayNode, witness: PureReplayVisitWitness, result: Any
+    ) -> dict[str, Any]:
+        if isinstance(result, Mapping) and result.get("status") == "failed":
+            raise self._failed_result_error(node, result)
+        row = {
+            **dict(result),
+            "name": witness.presentation_key,
+            "step_id": witness.step_id,
+            "visit_count": witness.visit_count,
+            "outcome": dict(_COMPLETED_OUTCOME),
+        }
+        self._validate_result(node, witness, row)
+        return row
+
+    @staticmethod
+    def _failed_result_error(node: PureReplayNode, result: Mapping[str, Any]) -> PureResultReplayIndexError:
+        error = result.get("error")
+        error = error if isinstance(error, Mapping) else {}
+        context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+        if error.get("type") == "materialize_ref_unresolved":
+            reason, cause = "binding_unresolved", "materialize_ref_unresolved"
+        elif context.get("reason") == "pure_projection_contract_invalid":
+            reason, cause = "output_contract_invalid", "pure_projection_contract_invalid"
+        else:
+            reason, cause = "evaluation_failed", "pure_evaluation_failed"
+        return _fail(reason, str(error.get("message") or reason), node_id=node.node_id,
+                     cause={"type": cause})
+
+    # --- boundary planning -----------------------------------------------------------
+
+    def _consumer_node_ids(self, restart_node_id: Optional[str]) -> list[str]:
+        ordered = list(self.bundle.runtime_plan.ordered_node_ids)
+        if restart_node_id in ordered:
+            consumers = ordered[ordered.index(restart_node_id):]
+        else:
+            consumers = []
+        consumers.extend(self.bundle.ir.finalization_region)
+        return consumers
+
+    def required_node_ids_for_boundary(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        """Reached pure nodes (dependency order) later work or outputs still reads."""
+        if not self.index.nodes:
+            return ()
+        seeds: list[BoundAddress] = []
+        for node_id in self._consumer_node_ids(restart_node_id):
+            seeds.extend(self._referenced_addresses(self._nodes[node_id]))
+        for contract in self.bundle.ir.outputs.values():
+            seeds.extend(self._referenced_addresses(contract))
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=self.reached_node_ids(state))
+
+    def _referenced_addresses(self, value: Any) -> list[BoundAddress]:
+        found: list[BoundAddress] = []
+        pk_to_node = {n.presentation_key: n.node_id for n in self.index.nodes.values()}
+        for text in _iter_strings(value):
+            for presentation_key, node_id in pk_to_node.items():
+                if f".steps.{presentation_key}." in text:
+                    found.append(NodeResultAddress(node_id, "artifacts"))
+        found.extend(_iter_addresses(value, self.index.nodes))
+        return found
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        """Validate the durable leaves of every node the boundary needs; return those nodes."""
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        derived = set(required)
+        for node_id in required:
+            for binding in self.index.nodes[node_id].bindings:
+                if address_node_id(binding.address) in derived:
+                    continue
+                self._audit_leaf(node_id, binding, state)
+        return required
+
+    def _audit_leaf(self, node_id: str, binding: PureBinding, state: Mapping[str, Any]) -> None:
+        context = {"node_id": node_id, "address": repr(binding.address), "path": list(binding.path)}
+        found, value = self.resolve_state_address(binding.address, state)
+        if not found:
+            raise _fail("durable_input_missing", "durable input is missing", **context)
+        try:
+            _validate_leaf(binding, value)
+        except (PureExprEvaluationError, TypeError, ValueError) as exc:
+            raise _fail("durable_input_invalid", "durable input has the wrong type", **context) from exc
+
+    def audit_persisted_surfaces(self, *, state: Mapping[str, Any], state_manager: Any,
+                                 resolve_bundle_path: Any) -> None:
+        """Raise ``profile_conflict`` for any persisted surface of an eligible node."""
+        _audit_surfaces(self, state=state, state_manager=state_manager,
+                        resolve_bundle_path=resolve_bundle_path)
+
+
+def _validate_leaf(binding: PureBinding, value: Any) -> None:
+    address = binding.address
+    if isinstance(address, NodeResultAddress) and address.field == "exit_code":
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError("exit_code must be an integer")
+        return
+    if isinstance(address, NodeResultAddress) and address.field == "outcome":
+        expected = _OUTCOME_TYPES.get(address.member or "")
+        if expected is None or type(value) is not expected:
+            raise TypeError("outcome member has the wrong type")
+        return
+    _coerce_value(value, binding.value_type, context=".".join(str(p) for p in binding.path))
+
+
+def _iter_strings(value: Any):
+    if isinstance(value, str):
+        yield value
+    elif isinstance(value, Mapping):
+        for key, item in value.items():
+            yield from _iter_strings(key)
+            yield from _iter_strings(item)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for item in value:
+            yield from _iter_strings(item)
+    elif hasattr(value, "__dataclass_fields__"):
+        for name in value.__dataclass_fields__:
+            yield from _iter_strings(getattr(value, name))
+
+
+def _iter_addresses(value: Any, eligible: Mapping[str, Any]):
+    node_id = getattr(value, "node_id", None)
+    if isinstance(node_id, str) and node_id in eligible and hasattr(value, "__dataclass_fields__") and (
+        hasattr(value, "field") or hasattr(value, "output_name")
+    ):
+        yield value
+    if isinstance(value, Mapping):
+        for item in value.values():
+            yield from _iter_addresses(item, eligible)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for item in value:
+            yield from _iter_addresses(item, eligible)
+    elif hasattr(value, "__dataclass_fields__"):
+        for name in value.__dataclass_fields__:
+            yield from _iter_addresses(getattr(value, name), eligible)
+
+
+def call_bundle_path_resolver(resolver: Callable[..., Any], node: PureReplayNode, state: Mapping[str, Any]) -> Any:
+    """Call a caller-supplied bundle-path resolver with ``node`` (and ``state`` if accepted)."""
+    positional = [
+        p for p in inspect.signature(resolver).parameters.values()
+        if p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)
+    ]
+    return resolver(node, state) if len(positional) >= 2 else resolver(node)

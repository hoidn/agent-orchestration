diff --git a/tests/test_pure_result_replay.py b/tests/test_pure_result_replay.py
new file mode 100644
index 0000000..29a433d
--- /dev/null
+++ b/tests/test_pure_result_replay.py
@@ -0,0 +1,395 @@
+"""Behavioral tests for the derived pure-result persistence profile."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.contracts.output_contract import validate_output_bundle
+from orchestrator.pure_replay_witness import (
+    PureReplayVisitWitness,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+from orchestrator.state import RunState, StateManager, StepResult
+from orchestrator.workflow.call_frame_state import load_existing_call_frame_read_only
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+FIXTURES = Path(__file__).parent / "fixtures" / "workflow_lisp" / "valid"
+MID = "pure_replay_chain::orchestrate__mid"
+MID_NODE = "root.pure_replay_chain_orchestrate__mid"
+PROFILE = DERIVED_PURE_REPLAY_PROFILE
+
+
+def _compile(tmp_path: Path):
+    source = tmp_path / "pure_replay_chain.orc"
+    source.write_text((FIXTURES / "pure_replay_chain.orc").read_text(), encoding="utf-8")
+    boundaries = {
+        name: ExternalToolBinding(name=name, stable_command=("python", f"scripts/{name}.py"))
+        for name in ("run_checks", "run_more")
+    }
+    result = compile_stage3_entrypoint(
+        source,
+        source_roots=(tmp_path,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries=boundaries,
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return source, result.validated_bundles_by_name["pure_replay_chain::orchestrate"]
+
+
+def _witness(step_name: str = "p", visit: int = 1) -> PureReplayVisitWitness:
+    return PureReplayVisitWitness(step_name, 3, f"root.{step_name}", visit)
+
+
+def test_run_state_profile_is_additive_and_validated() -> None:
+    base = dict(
+        schema_version="2.1", run_id="r", workflow_file="w", workflow_checksum="c",
+        started_at="t", updated_at="t", status="running",
+    )
+    plain = RunState(**base)
+    assert "result_persistence_profile" not in plain.to_dict()
+    assert RunState.from_dict(plain.to_dict()).result_persistence_profile is None
+    profiled = RunState(**base, result_persistence_profile=PROFILE)
+    assert RunState.from_dict(profiled.to_dict()).result_persistence_profile == PROFILE
+    with pytest.raises(ValueError, match="profile"):
+        RunState(**base, result_persistence_profile="other.v1")
+
+
+def test_state_manager_initialize_and_load_fail_closed(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="r")
+    with pytest.raises(ValueError, match="profile"):
+        manager.initialize("w.orc", result_persistence_profile="bad")
+    manager.initialize("w.orc", result_persistence_profile=PROFILE)
+    payload = json.loads(manager.state_file.read_text())
+    assert payload["result_persistence_profile"] == PROFILE
+    payload["result_persistence_profile"] = "bad"
+    manager.state_file.write_text(json.dumps(payload))
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError, match="profile"):
+        StateManager(tmp_path, run_id="r").load()
+    assert manager.state_file.read_bytes() == before
+
+
+def test_existing_call_frame_state_is_read_only_and_validated(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        load_existing_call_frame_read_only({"status": "running"})
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        load_existing_call_frame_read_only({"state": []})
+    before = sorted(tmp_path.iterdir())
+    state = {
+        "schema_version": "2.1", "run_id": "r", "workflow_file": "w", "workflow_checksum": "c",
+        "started_at": "t", "updated_at": "t", "status": "running",
+    }
+    loaded = load_existing_call_frame_read_only({"state": state})
+    loaded.status = "failed"
+    assert state["status"] == "running"
+    assert sorted(tmp_path.iterdir()) == before
+
+
+def test_completion_shell_is_exact_and_value_free() -> None:
+    witness = _witness()
+    shell = build_pure_completion_shell(witness)
+    assert shell == {
+        "name": "p", "step_id": "root.p", "visit_count": 1, "status": "completed",
+        "exit_code": 0,
+        "outcome": {"status": "completed", "phase": "execution", "class": "completed",
+                    "retryable": False},
+        "result_storage": PROFILE,
+    }
+    validate_pure_completion_shell(shell, witness=witness)
+    for key in ("value", "artifacts", "debug", "duration_ms"):
+        with pytest.raises(ValueError):
+            validate_pure_completion_shell({**shell, key: 1}, witness=witness)
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell({**shell, "exit_code": False}, witness=witness)
+
+
+def _state(**overrides):
+    base = {"step_visits": {}, "steps": {}, "current_step": None}
+    base.update(overrides)
+    return base
+
+
+def _cursor(witness, **overrides):
+    cursor = {"name": witness.presentation_key, "index": witness.step_index,
+              "type": "pure_projection", "step_id": witness.step_id,
+              "visit_count": 1, "status": "running"}
+    cursor.update(overrides)
+    return cursor
+
+
+def test_progress_classification() -> None:
+    w = _witness()
+    shell = build_pure_completion_shell(w)
+    failed = {"name": "p", "step_id": "root.p", "visit_count": 1, "status": "failed"}
+    unrelated = {"name": "q", "step_id": "root.q", "status": "running"}
+    cases = {
+        "unstarted": _state(current_step=unrelated),
+        "interrupted": _state(step_visits={"p": 1}, current_step=_cursor(w)),
+        "derived_complete": _state(step_visits={"p": 1}, steps={"p": shell}, current_step=unrelated),
+        "durable_failure_skip": _state(step_visits={"p": 1}, steps={"p": failed}),
+        "progress_witness_invalid": _state(step_visits={"p": 1}),
+    }
+    for expected, state in cases.items():
+        assert classify_pure_replay_progress(state, witness=w) == expected
+    invalid = [
+        _state(current_step=_cursor(w)),
+        _state(steps={"p": shell}),
+        _state(step_visits={"p": 2}, steps={"p": {**shell, "visit_count": 2}}),
+        _state(step_visits={"p": 1}, steps={"p": shell}, current_step=_cursor(w)),
+        _state(step_visits={"p": 1}, current_step=_cursor(w, index=9)),
+        _state(step_visits={"p": 1}, steps={"p": {**shell, "artifacts": {}}}),
+        _state(step_visits={"p": 1}, steps={"p": {**failed, "visit_count": 2}}),
+        _state(step_visits={"p": 1}, steps={"p": failed}, current_step=_cursor(w)),
+    ]
+    for state in invalid:
+        assert classify_pure_replay_progress(state, witness=w) == "progress_witness_invalid"
+
+
+def test_state_manager_pure_visit_transactions(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="r")
+    manager.initialize("w.orc", result_persistence_profile=PROFILE)
+    w = _witness()
+    assert manager.begin_eligible_pure_visit(step_name="p", step_index=3, step_id="root.p") == 1
+    assert manager.reuse_interrupted_eligible_pure_visit(w) == 1
+    with pytest.raises(PureResultReplayIndexError):
+        manager.begin_eligible_pure_visit(step_name="p", step_index=3, step_id="root.p")
+    assert manager.settle_eligible_pure_success(w) == build_pure_completion_shell(w)
+    persisted = json.loads(manager.state_file.read_text())
+    assert persisted["steps"]["p"] == build_pure_completion_shell(w)
+    assert "current_step" not in persisted
+
+
+def test_failed_pure_visit_keeps_full_row(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="r")
+    manager.initialize("w.orc", result_persistence_profile=PROFILE)
+    manager.begin_eligible_pure_visit(step_name="p", step_index=3, step_id="root.p")
+    manager.settle_eligible_pure_failure(
+        _witness(),
+        StepResult(status="failed", name="p", step_id="root.p", exit_code=2, visit_count=1),
+    )
+    assert json.loads(manager.state_file.read_text())["steps"]["p"]["status"] == "failed"
+
+
+def test_index_lists_eligible_nodes_and_dependencies(tmp_path: Path) -> None:
+    _, bundle = _compile(tmp_path)
+    index = derive_pure_result_replay_index(bundle)
+    node = index.nodes[MID_NODE]
+    assert index.scope_kind == "root" and index.topological_node_ids == (MID_NODE,)
+    assert node.presentation_key == MID
+    assert node.durable_dependency_node_ids == ("root.pure_replay_chain_orchestrate__first__run_checks",)
+    assert {b.ref for b in node.bindings} >= {"inputs.run_now"}
+    assert [a.member for a in node.output_addresses] == ["return__label", "return__flag"]
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(bundle, scope_kind="call_frame")
+    assert info.value.reason == "dependency_index_invalid"
+    assert info.value.context["actual_scope"] == "root"
+
+
+def test_index_marks_loop_owned_pure_nodes_ineligible(tmp_path: Path) -> None:
+    source = tmp_path / "lexical_checkpoint_restore_regions.orc"
+    source.write_text((FIXTURES / source.name).read_text(), encoding="utf-8")
+    result = compile_stage3_entrypoint(
+        source, source_roots=(tmp_path,), validate_shared=True, workspace_root=tmp_path
+    )
+    bundle = result.validated_bundles_by_name["lexical_checkpoint_restore_regions::orchestrate"]
+    index = derive_pure_result_replay_index(bundle)
+    assert index.nodes and set(index.ineligible_pure_reasons.values()) == {"multiple_visit_region"}
+
+
+def _run(tmp_path, bundle, source, *, crash_second: bool, profile=PROFILE, resume=False, manager=None, calls=None):
+    calls = calls if calls is not None else []
+
+    def fake_command(self, step, state):
+        name = step["name"].split("__")[-1]
+        calls.append(name)
+        if crash_second and name == "run_more":
+            raise RuntimeError("crash")
+        _, bundle_spec, _err = self._resolve_output_contract_paths(step, state)
+        path = self.workspace / bundle_spec["path"]
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps({"status": f"OK-{name}", "report": "artifacts/work/r.md"}))
+        (self.workspace / "artifacts/work").mkdir(parents=True, exist_ok=True)
+        (self.workspace / "artifacts/work/r.md").write_text("x")
+        return {"status": "completed", "exit_code": 0, "duration_ms": 0,
+                "artifacts": validate_output_bundle(bundle_spec, workspace=self.workspace)}
+
+    if manager is None:
+        manager = StateManager(tmp_path, run_id="r1")
+        manager.initialize(
+            str(source), context=bundle_context_dict(bundle),
+            bound_inputs={"report_path": "artifacts/work/rep.txt", "run_now": True},
+            result_persistence_profile=profile,
+        )
+    else:
+        manager.load()
+    with patch.object(WorkflowExecutor, "_execute_command", fake_command):
+        try:
+            state = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=resume)
+        except RuntimeError:
+            state = None
+    return manager, state, calls
+
+
+def test_clean_profiled_run_persists_only_the_shell(tmp_path: Path) -> None:
+    source, bundle = _compile(tmp_path)
+    manager, state, _ = _run(tmp_path, bundle, source, crash_second=False)
+    persisted = json.loads(manager.state_file.read_text())
+    assert state["status"] == "completed"
+    assert persisted["steps"][MID] == build_pure_completion_shell(
+        PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w")).witness(MID_NODE)
+    )
+    assert persisted["workflow_outputs"] == {"return__label": "OK-run_checks", "return__status": "OK-run_more"}
+    assert not list(tmp_path.rglob("*mid__result_bundle.json"))
+    assert not list(tmp_path.rglob("ckpt:726f82643fbbdc90f210ab3c*"))
+
+
+def test_resume_replays_pure_value_without_rerunning_committed_effects(tmp_path: Path) -> None:
+    source, bundle = _compile(tmp_path)
+    manager, _, calls = _run(tmp_path, bundle, source, crash_second=True)
+    _, state, calls = _run(tmp_path, bundle, source, crash_second=False, resume=True,
+                           manager=StateManager(tmp_path, run_id="r1"), calls=calls)
+    assert state["status"] == "completed"
+    assert calls == ["run_checks", "run_more", "run_more"]

--- /dev/null
+++ b/tests/fixtures/workflow_lisp/valid/pure_replay_chain.orc
@@ -0,0 +1,36 @@
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule pure_replay_chain)
+  (export orchestrate)
+  (defpath WorkReport
+    :kind relpath
+    :under "artifacts/work"
+    :must-exist true)
+  (defrecord ChecksResult
+    (status String)
+    (report WorkReport))
+  (defrecord Mid
+    (label String)
+    (flag Bool))
+  (defrecord Out
+    (label String)
+    (status String))
+  (defworkflow orchestrate
+    ((report_path WorkReport)
+     (run_now Bool))
+    -> Out
+    (let* ((first
+             (command-result run_checks
+               :argv ("python" "scripts/run_checks.py" report_path)
+               :returns ChecksResult))
+           (mid
+             (if run_now
+               (record Mid :label first.status :flag true)
+               (record Mid :label "skipped" :flag false)))
+           (second
+             (command-result run_more
+               :argv ("python" "scripts/run_more.py" report_path)
+               :returns ChecksResult))
+           (out (record Out :label mid.label :status second.status)))
+      out)))

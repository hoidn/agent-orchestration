@@ -0,0 +1,116 @@
+"""Persisted-surface audit for the derived pure replay profile.
+
+Dependencies: a ``PureReplayRuntime`` (eligible nodes), the loaded run state, a state
+manager able to read runtime sidecars, and a caller-supplied pure-bundle path resolver.
+Behavior: raises ``profile_conflict`` when any durable surface holds data the profile
+says must stay derived: value rows, pure bundles, private lineage, checkpoint records
+or restore bindings of an eligible node in this scope. Reads only; never writes.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Mapping
+
+from ..pure_replay_witness import (
+    PROGRESS_DERIVED_COMPLETE,
+    PROGRESS_DURABLE_FAILURE_SKIP,
+    PureReplayVisitWitness,
+    build_pure_completion_shell,
+)
+from .pure_result_replay import PROFILE_CONFLICT, PureResultReplayIndexError
+
+
+_PROBE = PureReplayVisitWitness("_", 0, "_", 1)
+
+
+def _conflict(surface: str, node_id: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROFILE_CONFLICT,
+        f"persisted {surface} holds derived pure data for {node_id}",
+        context={"surface": surface, "node_id": node_id, **context},
+    )
+
+
+def _scope_frame_id(runtime: Any) -> str | None:
+    frame_ids = runtime.scope_path.call_frame_ids
+    return frame_ids[-1] if frame_ids else None
+
+
+def audit_persisted_surfaces(
+    runtime: Any, *, state: Mapping[str, Any], state_manager: Any, resolve_bundle_path: Any
+) -> None:
+    """Raise ``profile_conflict`` for persisted data of any eligible node."""
+    from .pure_replay_runtime import call_bundle_path_resolver
+
+    nodes = runtime.index.nodes
+    if not nodes:
+        return
+    steps = state.get("steps") if isinstance(state.get("steps"), Mapping) else {}
+    lineage = state.get("private_artifact_versions")
+    lineage = lineage if isinstance(lineage, Mapping) else {}
+    for node in nodes.values():
+        if node.presentation_key in steps and runtime.progress(node.node_id, state) not in {
+            PROGRESS_DERIVED_COMPLETE,
+            PROGRESS_DURABLE_FAILURE_SKIP,
+        } and _is_value_row(steps[node.presentation_key]):
+            raise _conflict("steps", node.node_id)
+        bundle_path = call_bundle_path_resolver(resolve_bundle_path, node, state)
+        if bundle_path is not None and Path(bundle_path).exists():
+            raise _conflict("pure_bundle", node.node_id, path=str(bundle_path))
+        for versions in lineage.values():
+            for entry in versions if isinstance(versions, list) else ():
+                owners = {entry.get("producer"), entry.get("producer_name")} if isinstance(entry, Mapping) else set()
+                if owners & {node.presentation_key, node.step_id, node.step_id.removeprefix("root.")}:
+                    raise _conflict("private_artifact_versions", node.node_id)
+    _audit_checkpoint_records(runtime, state_manager)
+
+
+def _is_value_row(row: Any) -> bool:
+    shell_keys = set(build_pure_completion_shell(_PROBE))
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") == "completed"
+        and not set(row) <= shell_keys
+    )
+
+
+def _scope_records(runtime: Any, state_manager: Any):
+    """Yield ``(point, record)`` for every checkpoint record owned by this scope's frame."""
+    from orchestrator.workflow_lisp import lexical_checkpoints as checkpoints
+
+    frame_id = _scope_frame_id(runtime)
+    for point in runtime.bundle.runtime_plan.lexical_checkpoint_points:
+        index_path = checkpoints.resolve_checkpoint_index_path(
+            state_manager=state_manager,
+            workflow_name=point.workflow_name,
+            checkpoint_id=point.checkpoint_id,
+        )
+        index = state_manager.read_runtime_sidecar_json(index_path)
+        for entry in (index or {}).get("records", ()):
+            identity = entry.get("frame_identity") if isinstance(entry, Mapping) else None
+            if not isinstance(identity, Mapping) or identity.get("call_frame_id") != frame_id:
+                continue
+            record_path = Path(state_manager.workspace) / str(entry.get("record_path"))
+            record = state_manager.read_runtime_sidecar_json(record_path)
+            if isinstance(record, Mapping):
+                yield point, record
+
+
+def _audit_checkpoint_records(runtime: Any, state_manager: Any) -> None:
+    nodes = runtime.index.nodes
+    step_ids = {n.step_id for n in nodes.values()} | {
+        n.step_id.removeprefix("root.") for n in nodes.values()
+    }
+    names = {n.presentation_key for n in nodes.values()}
+    for point, record in _scope_records(runtime, state_manager):
+        node_id = getattr(point, "node_id", None)
+        if node_id in nodes:
+            raise _conflict("checkpoint_record", node_id, record_id=record.get("record_id"))
+        payload = record.get("restore_payload")
+        for binding in (payload.get("bindings", ()) if isinstance(payload, Mapping) else ()):
+            if isinstance(binding, Mapping) and (
+                binding.get("source_step_id") in step_ids
+                or binding.get("source_step_name") in names
+            ):
+                raise _conflict("restore_payload", str(node_id), record_id=record.get("record_id"))
diff --git a/orchestrator/workflow/pure_result_replay.py b/orchestrator/workflow/pure_result_replay.py
new file mode 100644
index 0000000..7581772
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,487 @@
+"""Replay-eligibility index for compiler-generated pure projections.
+
+Dependencies: a loaded workflow bundle (executable IR, runtime plan, projection,
+provenance) and the pure-expression type validator; no state or filesystem access.
+Behavior: derives, without mutating or serializing the program, which pure
+``pure_projection`` nodes can be rebuilt from durable inputs and what each depends on.
+The value-free shell, witness and progress classification live in
+``orchestrator.pure_replay_witness`` and are re-exported here; the replay runtime
+lives in ``orchestrator.workflow.pure_replay_runtime``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from types import MappingProxyType
+from typing import Any, Iterable, Mapping, Optional, cast
+
+from ..pure_replay_witness import (  # noqa: F401  (re-exported public names)
+    DERIVED_PURE_REPLAY_PROFILE,
+    PROGRESS_DERIVED_COMPLETE,
+    PROGRESS_DURABLE_FAILURE_SKIP,
+    PROGRESS_INTERRUPTED,
+    PROGRESS_UNSTARTED,
+    PROGRESS_WITNESS_INVALID,
+    PURE_REPLAY_UNAVAILABLE_CODE,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallBoundaryNode,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    IfJoinNode,
+    LoopOutputAddress,
+    MatchJoinNode,
+    NodeResultAddress,
+    PureProjectionStepConfig,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_expr import _coerce_value, _descriptor_kind, PureExprEvaluationError
+from .references import ReferenceResolutionError, parse_structured_ref
+
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROFILE_CONFLICT = "profile_conflict"
+SCOPE_ROOT = "root"
+
+_INELIGIBLE_DEPENDENCY_REASON = "depends_on_ineligible_pure"
+
+
+def address_node_id(address: Any) -> Optional[str]:
+    """Producer node id of a typed address; ``None`` for workflow inputs."""
+    return getattr(address, "node_id", None)
+
+
+def invalid_index(message: str, **context: Any) -> PureResultReplayIndexError:
+    """Build a ``dependency_index_invalid`` error."""
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+@dataclass(frozen=True)
+class PureBinding:
+    """One exact ``{"ref": ...}`` leaf of a binding value document."""
+
+    name: str
+    path: tuple[str | int, ...]
+    ref: str
+    address: BoundAddress
+    value_type: Mapping[str, Any]
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    """One replay-eligible pure projection and its dependencies."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    execution_index: int
+    bindings: tuple[PureBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Mapping[str, Any]]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    """Eligible pure nodes of one workflow scope, in dependency order."""
+
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[BoundAddress],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Pure nodes (dependency order) needed to rebuild ``seed_addresses``.
+
+        Seeds on pure nodes that were never reached are ignored; a reached pure
+        node that needs an unreached pure producer is ambiguous and fails closed.
+        """
+        reached = set(reached_node_ids)
+        needed: set[str] = set()
+        pending = [
+            address_node_id(address)
+            for address in seed_addresses
+            if address_node_id(address) in self.nodes
+            and address_node_id(address) in reached
+        ]
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            needed.add(node_id)
+            for dependency in self.nodes[node_id].pure_dependency_node_ids:
+                if dependency not in reached:
+                    raise PureResultReplayIndexError(
+                        REACHABILITY_AMBIGUOUS,
+                        f"pure node {node_id} needs unreached pure producer {dependency}",
+                        context={"node_id": node_id, "dependency": dependency},
+                    )
+                pending.append(dependency)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+# --- literal / ref document walking -------------------------------------------------
+
+
+def _exact_ref(doc: Any) -> Optional[str]:
+    if isinstance(doc, Mapping) and "ref" in doc:
+        ref = doc["ref"]
+        if len(doc) != 1 or not isinstance(ref, str) or not ref:
+            raise invalid_index("malformed ref object in binding document", document=repr(doc))
+        return ref
+    return None
+
+
+def _check_literal(doc: Any, descriptor: Mapping[str, Any], path: tuple) -> None:
+    if isinstance(doc, str) and "${" in doc:
+        raise invalid_index("unbound text in binding literal", path=list(path))
+    try:
+        _coerce_value(doc, descriptor, context=".".join(str(p) for p in path))
+    except PureExprEvaluationError as exc:
+        raise invalid_index(
+            "binding literal does not match its declared type", path=list(path)
+        ) from exc
+
+
+def _union_fields(descriptor: Mapping[str, Any]) -> dict[str, Mapping[str, Any]]:
+    variants = descriptor.get("variants")
+    if variants is None:
+        variants = [descriptor]
+    return {
+        field_def["name"]: field_def["type"]
+        for variant in variants
+        for field_def in variant.get("fields", ())
+    }
+
+
+def walk_binding_document(
+    doc: Any,
+    descriptor: Mapping[str, Any],
+    path: tuple[str | int, ...],
+    on_ref: Any,
+) -> None:
+    """Walk ``doc`` against ``descriptor``; call ``on_ref(path, ref, type)`` per exact ref."""
+    ref = _exact_ref(doc)
+    if ref is not None:
+        on_ref(path, ref, descriptor)
+        return
+    kind = _descriptor_kind(descriptor)
+    if kind == "optional":
+        if doc is not None:
+            walk_binding_document(doc, descriptor["item"], path, on_ref)
+        return
+    if kind == "list":
+        if not isinstance(doc, (list, tuple)):
+            raise invalid_index("binding literal must be a list", path=list(path))
+        for position, item in enumerate(doc):
+            walk_binding_document(item, descriptor["item"], (*path, position), on_ref)
+        return
+    if kind == "map":
+        if not isinstance(doc, Mapping):
+            raise invalid_index("binding literal must be a map", path=list(path))
+        for key, item in doc.items():
+            _check_literal(key, descriptor["key"], (*path, str(key)))
+            walk_binding_document(item, descriptor["value"], (*path, str(key)), on_ref)
+        return
+    if kind == "record":
+        if not isinstance(doc, Mapping):
+            raise invalid_index("binding literal must be a record", path=list(path))
+        names = {f["name"]: f["type"] for f in descriptor["fields"]}
+        if set(doc) != set(names):
+            raise invalid_index("binding record fields differ from its type", path=list(path))
+        for name, item in doc.items():
+            walk_binding_document(item, names[name], (*path, name), on_ref)
+        return
+    if kind in {"union", "variant_case"}:
+        _walk_union(doc, descriptor, path, on_ref)
+        return
+    if isinstance(doc, (Mapping, list, tuple)):
+        raise invalid_index("binding literal must be a scalar", path=list(path))
+    _check_literal(doc, descriptor, path)
+
+
+def _walk_union(doc: Any, descriptor: Mapping[str, Any], path: tuple, on_ref: Any) -> None:
+    if not isinstance(doc, Mapping) or "variant" not in doc:
+        raise invalid_index("binding union document must declare variant", path=list(path))
+    names = _union_fields(descriptor)
+    unknown = set(doc) - set(names) - {"variant"}
+    if unknown:
+        raise invalid_index(
+            "binding union document has unknown members", path=list(path), members=sorted(unknown)
+        )
+    variant_names = [v["name"] for v in descriptor.get("variants", ())]
+    if "variant" in doc:
+        variant_doc = doc["variant"]
+        if _exact_ref(variant_doc) is None:
+            if variant_doc not in variant_names and variant_names:
+                raise invalid_index("binding union variant is not declared", path=list(path))
+        else:
+            on_ref((*path, "variant"), variant_doc["ref"], {"kind": "primitive", "name": "String"})
+    for name, item in doc.items():
+        if name != "variant":
+            walk_binding_document(item, names[name], (*path, name), on_ref)
+
+
+# --- node identity and control-flow structure ----------------------------------------
+
+
+def _is_pure(node: Any) -> bool:
+    return node.kind is ExecutableNodeKind.PURE_PROJECTION
+
+
+def _loop_owned_ids(nodes: Mapping[str, Any]) -> set[str]:
+    owned: set[str] = set()
+    for node in nodes.values():
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)):
+            owned.update(node.body_node_ids)
+    return owned
+
+
+def _control_successors(bundle: LoadedWorkflowBundle) -> dict[str, set[str]]:
+    nodes = bundle.ir.nodes
+    successors: dict[str, set[str]] = {node_id: set() for node_id in nodes}
+    ordered = [n for n in bundle.runtime_plan.ordered_node_ids if n in nodes]
+    for previous, following in zip(ordered, ordered[1:]):
+        successors[previous].add(following)
+    for node in nodes.values():
+        if node.fallthrough_node_id in nodes:
+            successors[node.node_id].add(node.fallthrough_node_id)
+        for transfer in node.routed_transfers.values():
+            if transfer.target_node_id in nodes:
+                successors[node.node_id].add(transfer.target_node_id)
+    return successors
+
+
+def _recurrent_ids(successors: Mapping[str, set[str]]) -> set[str]:
+    recurrent: set[str] = set()
+    for start in successors:
+        seen: set[str] = set()
+        stack = list(successors[start])
+        while stack:
+            current = stack.pop()
+            if current == start:
+                recurrent.add(start)
+                break
+            if current in seen:
+                continue
+            seen.add(current)
+            stack.extend(successors.get(current, ()))
+    return recurrent
+
+
+def _check_identities(bundle: LoadedWorkflowBundle, pure_nodes: list[Any]) -> None:
+    names: dict[str, int] = {}
+    step_ids: dict[str, int] = {}
+    for node in bundle.ir.nodes.values():
+        names[node.presentation_name] = names.get(node.presentation_name, 0) + 1
+        step_ids[node.step_id] = step_ids.get(node.step_id, 0) + 1
+    for node in pure_nodes:
+        if names[node.presentation_name] > 1 or step_ids[node.step_id] > 1:
+            raise invalid_index(
+                "duplicate projection authority", node_id=node.node_id,
+                presentation_key=node.presentation_name,
+            )
+        plan_node = bundle.runtime_plan.nodes.get(node.node_id)
+        entry = bundle.projection.entries_by_node_id.get(node.node_id)
+        for label, other in (("runtime_plan", plan_node), ("projection", entry)):
+            if other is None or other.step_id != node.step_id or (
+                other.presentation_key != node.presentation_name
+            ):
+                raise invalid_index(
+                    "projection identity mismatch", node_id=node.node_id, authority=label
+                )
+
+
+# --- reference parsing ----------------------------------------------------------------
+
+
+def _address_for(ref: str, bundle: LoadedWorkflowBundle, names: Mapping[str, Any]) -> BoundAddress:
+    if ref.startswith("inputs."):
+        return WorkflowInputAddress(input_name=ref[len("inputs."):])
+    if not ref.startswith("root.steps."):
+        raise invalid_index("pure binding ref has an unsupported scope", ref=ref)
+    try:
+        target = parse_structured_ref(ref, names.keys())
+    except ReferenceResolutionError as exc:
+        raise invalid_index("cross-frame or unknown step ref", ref=ref) from exc
+    if target.step_name not in names:
+        raise invalid_index("cross-frame or unknown step ref", ref=ref)
+    node = names[target.step_name]
+    if target.field == "artifacts" and target.member:
+        if isinstance(node, (IfJoinNode, MatchJoinNode)):
+            return BlockOutputAddress(node_id=node.node_id, output_name=target.member)
+        if isinstance(node, RepeatUntilFrameNode):
+            return LoopOutputAddress(node_id=node.node_id, output_name=target.member)
+        if isinstance(node, CallBoundaryNode):
+            return CallOutputAddress(node_id=node.node_id, output_name=target.member)
+    return NodeResultAddress(node_id=node.node_id, field=target.field, member=target.member)
+
+
+def _binding_inputs(node: Any) -> tuple[Mapping[str, Any], Mapping[str, Any], Mapping[str, Any]]:
+    config = node.execution_config
+    if not isinstance(config, PureProjectionStepConfig):
+        raise invalid_index("pure node lacks a pure_projection config", node_id=node.node_id)
+    document = config.pure_projection
+    payload = document.get("payload")
+    refs = document.get("binding_refs")
+    contracts = document.get("output_contracts")
+    if not all(isinstance(v, Mapping) for v in (payload, refs, contracts)):
+        raise invalid_index("pure_projection config is incomplete", node_id=node.node_id)
+    declared = payload.get("bindings")
+    if not isinstance(declared, Mapping) or set(declared) != set(refs):
+        raise invalid_index("pure binding documents differ from declared bindings",
+                            node_id=node.node_id)
+    return cast(Mapping[str, Any], declared), cast(Mapping[str, Any], refs), cast(Mapping[str, Any], contracts)
+
+
+def _derive_bindings(
+    node: Any, bundle: LoadedWorkflowBundle, names: Mapping[str, Any]
+) -> tuple[tuple[PureBinding, ...], Mapping[str, Any]]:
+    declared, refs, contracts = _binding_inputs(node)
+    found: list[PureBinding] = []
+    for name in sorted(refs):
+        def on_ref(path: tuple, ref: str, descriptor: Mapping[str, Any], _name: str = name) -> None:
+            found.append(
+                PureBinding(
+                    name=_name,
+                    path=path,
+                    ref=ref,
+                    address=_address_for(ref, bundle, names),
+                    value_type=descriptor,
+                )
+            )
+
+        walk_binding_document(refs[name], declared[name]["type"], (name,), on_ref)
+    return tuple(found), contracts
+
+
+def _topological(nodes: Mapping[str, PureReplayNode]) -> tuple[str, ...]:
+    remaining = {n: set(node.pure_dependency_node_ids) for n, node in nodes.items()}
+    order: list[str] = []
+    while remaining:
+        ready = sorted(
+            (n for n, deps in remaining.items() if not deps),
+            key=lambda n: (nodes[n].execution_index, n),
+        )
+        if not ready:
+            raise invalid_index("pure dependency cycle", node_ids=sorted(remaining))
+        order.extend(ready)
+        for n in ready:
+            del remaining[n]
+        for deps in remaining.values():
+            deps.difference_update(ready)
+    return tuple(order)
+
+
+def _propagate_pure_ineligibility(
+    reasons: dict[str, str], pure_dependencies: Mapping[str, Iterable[str]]
+) -> dict[str, str]:
+    """Make pure dependents of ineligible pure producers ineligible (in place)."""
+    changed = True
+    while changed:
+        changed = False
+        for node_id, dependencies in pure_dependencies.items():
+            if node_id not in reasons and any(dep in reasons for dep in dependencies):
+                reasons[node_id] = _INELIGIBLE_DEPENDENCY_REASON
+                changed = True
+    return reasons
+
+
+def derive_pure_result_replay_index(
+    bundle: LoadedWorkflowBundle, *, scope_kind: str = SCOPE_ROOT
+) -> PureResultReplayIndex:
+    """Derive replay eligibility and dependencies for ``bundle``'s own nodes."""
+    actual_scope = SCOPE_ROOT
+    if scope_kind != actual_scope:
+        raise invalid_index(
+            "scope_kind does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=actual_scope,
+        )
+    ir = bundle.ir
+    pure_nodes = [n for n in ir.nodes.values() if _is_pure(n)]
+    if bundle.provenance.frontend_kind != "workflow_lisp" or not pure_nodes:
+        return PureResultReplayIndex(scope_kind, MappingProxyType({}), (), MappingProxyType({}))
+    _check_identities(bundle, pure_nodes)
+
+    reasons: dict[str, str] = {}
+    loop_owned = _loop_owned_ids(ir.nodes)
+    recurrent = _recurrent_ids(_control_successors(bundle))
+    for node in pure_nodes:
+        common = node.execution_config.common
+        if node.node_id in loop_owned or node.node_id in recurrent:
+            reasons[node.node_id] = MULTIPLE_VISIT_REGION
+        elif common.publishes or common.consumes:
+            reasons[node.node_id] = "durable_lineage"
+
+    names = {n.presentation_name: n for n in ir.nodes.values()}
+    pure_ids = {n.node_id for n in pure_nodes}
+    derived: dict[str, tuple[tuple[PureBinding, ...], Mapping[str, Any]]] = {}
+    pure_deps: dict[str, set[str]] = {}
+    for node in pure_nodes:
+        if node.node_id in reasons:
+            continue
+        derived[node.node_id] = _derive_bindings(node, bundle, names)
+        pure_deps[node.node_id] = {
+            address_node_id(b.address)
+            for b in derived[node.node_id][0]
+            if address_node_id(b.address) in pure_ids
+        }
+        if node.node_id in pure_deps[node.node_id]:
+            raise invalid_index("pure node depends on its own result", node_id=node.node_id)
+    _propagate_pure_ineligibility(reasons, pure_deps)
+
+    nodes: dict[str, PureReplayNode] = {}
+    for node_id, (bindings, contracts) in derived.items():
+        if node_id in reasons:
+            continue
+        node = ir.nodes[node_id]
+        deps = {
+            address_node_id(b.address) for b in bindings if address_node_id(b.address)
+        }
+        nodes[node_id] = PureReplayNode(
+            node_id=node_id,
+            step_id=node.step_id,
+            presentation_key=node.presentation_name,
+            execution_index=bundle.runtime_plan.nodes[node_id].execution_index or 0,
+            bindings=bindings,
+            output_addresses=tuple(
+                NodeResultAddress(node_id=node_id, field="artifacts", member=name)
+                for name in contracts
+            ),
+            output_contracts=MappingProxyType({k: dict(v) for k, v in contracts.items()}),
+            pure_dependency_node_ids=tuple(sorted(deps & set(derived) - set(reasons))),
+            durable_dependency_node_ids=tuple(sorted(deps - (deps & set(derived) - set(reasons)))),
+        )
+    return PureResultReplayIndex(
+        scope_kind,
+        MappingProxyType(nodes),
+        _topological(nodes),
+        MappingProxyType(dict(reasons)),
+    )
+
+
+def __getattr__(name: str) -> Any:
+    """Lazily expose the replay runtime (it imports this module)."""
+    if name == "PureReplayRuntime":
+        from .pure_replay_runtime import PureReplayRuntime
+
+        return PureReplayRuntime
+    raise AttributeError(name)

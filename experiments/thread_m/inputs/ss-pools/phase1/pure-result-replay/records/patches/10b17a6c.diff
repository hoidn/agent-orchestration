+    good = {"status": "completed", "artifacts": {name.member: "x" for name in node.output_addresses}}
+
+    runtime.record_full_result(node.node_id, witness=runtime.witness(node.node_id), result=good)
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.record_full_result(
+            node.node_id,
+            witness=runtime.witness(node.node_id),
+            result={"status": "completed", "artifacts": {**good["artifacts"], "return__bogus": 1}},

+  (export orchestrate)
+  (defrecord Pair (left String) (right String))
+  (defworkflow helper ((name String)) -> Pair
+    (record Pair :left (string/concat name "!") :right "x"))
+  (defworkflow orchestrate ((name String)) -> Pair
+    (call helper :name name)))
+""",
+        encoding="utf-8",
+    )
+    result = compile_stage3_entrypoint(source, source_roots=(tmp_path,), validate_shared=True, workspace_root=tmp_path)

+    assert excinfo.value.context["surface"] == "pure_bundle"
+
+
+def test_recurrent_pure_nodes_stay_ineligible_inside_a_profiled_root(tmp_path: Path) -> None:
+    _, bundle = _bundle(tmp_path)

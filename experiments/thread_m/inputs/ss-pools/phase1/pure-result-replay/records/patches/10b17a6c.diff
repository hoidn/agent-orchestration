+
+def test_active_result_with_extra_union_member_is_invalid(tmp_path: Path) -> None:
+    _, bundle = _bundle(tmp_path)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("wf.orc"))

+
+def _fresh_manager(tmp_path: Path) -> StateManager:
+    source = tmp_path / FIXTURE.name
+    manager = StateManager(workspace=tmp_path, run_id="other")
+    manager.initialize(str(source), bound_inputs=dict(INPUTS))
+    return manager
+
+
+ZERO_RECORD_SOURCE = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule zero_rec)
+  (export orchestrate)
+  (defpath MaterializedSummaryPath :kind relpath :under "artifacts/work" :must-exist true)
+  (defrecord Output (summary_path MaterializedSummaryPath) (label String))
+  (defworkflow orchestrate
+    ((summary_target MaterializedSummaryPath) (name String))
+    -> Output
+    (let* ((status (if (= name "bob") "friendly" "stranger"))
+           (summary_path
+             (materialize-view runtime-summary
+               :value status :renderer canonical-json :renderer-version 1
+               :target summary_target :returns MaterializedSummaryPath)))
+      (record Output :summary_path summary_path :label (string/concat status "!")))))
+"""
+PRIOR_BOUNDARY_SOURCE = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule prior_b)
+  (export orchestrate)
+  (defpath MaterializedSummaryPath :kind relpath :under "artifacts/work" :must-exist true)
+  (defrecord Output (first_path MaterializedSummaryPath) (summary_path MaterializedSummaryPath) (label String))
+  (defworkflow orchestrate
+    ((first_target MaterializedSummaryPath) (summary_target MaterializedSummaryPath) (name String))
+    -> Output
+    (let* ((first_path
+             (materialize-view first-summary
+               :value name :renderer canonical-json :renderer-version 1
+               :target first_target :returns MaterializedSummaryPath))
+           (status (if (= name "bob") "friendly" "stranger"))
+           (summary_path
+             (materialize-view runtime-summary
+               :value status :renderer canonical-json :renderer-version 1
+               :target summary_target :returns MaterializedSummaryPath)))
+      (record Output :first_path first_path :summary_path summary_path :label (string/concat status "!")))))
+"""
+
+
+def _source_run(tmp_path: Path, source: str, name: str, inputs: dict, fail_on_call: int):
+    path = tmp_path / f"{name}.orc"
+    path.write_text(source, encoding="utf-8")
+    result = compile_stage3_entrypoint(path, source_roots=(tmp_path,), validate_shared=True, workspace_root=tmp_path)
+    bundle = next(b for n, b in result.validated_bundles_by_name.items() if n.endswith("orchestrate"))
+    (tmp_path / "artifacts" / "work").mkdir(parents=True)
+    for target in inputs.values():
+        if str(target).endswith(".json"):
+            (tmp_path / target).write_text("{}\n", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    manager.initialize(
+        str(path),
+        context=bundle_context_dict(bundle),
+        bound_inputs=inputs,
+        result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE,
+    )
+    real = WorkflowExecutor._execute_materialize_view.__globals__["render_view"]
+    calls = {"n": 0}
+
+    def flaky(*args, **kwargs):
+        calls["n"] += 1
+        if calls["n"] == fail_on_call:
+            raise RuntimeError("interrupt")
+        return real(*args, **kwargs)
+
+    with patch("orchestrator.workflow.executor.render_view", side_effect=flaky):
+        WorkflowExecutor(bundle, tmp_path, manager).execute()
+    return bundle, flaky
+
+
+def _default_resume_decision(tmp_path: Path, bundle, flaky) -> dict:
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    manager.load()
+    with patch("orchestrator.workflow.executor.render_view", side_effect=flaky):
+        resumed = WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+    report = json.loads(manager.workflow_lisp_checkpoint_default_resume_report_path().read_text(encoding="utf-8"))
+    return resumed, report["checked_workflows"][0]["decision"]
+

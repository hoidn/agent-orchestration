--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,371 @@
+"""Derived pure-result replay: index, value-free shells and the replay runtime.
+
+Public façade for ``derived_pure_replay.v1``. Pure compiler-generated projections
+settle as exact value-free completion shells; on resume this runtime rebuilds the
+needed pure values in memory from durable inputs, never dispatching an effect,
+bumping a visit or writing durable state.
+
+Dependencies: ``pure_result_replay_{witness,index,types,surfaces}`` and the loaded
+bundle; evaluation itself is injected by the executor (``evaluate_node``).
+"""
+
+from __future__ import annotations
+
+import json
+from collections import deque
+from typing import Any, Callable, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+from .executable_ir import NodeResultAddress
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_result_replay_index import (
+    PureReplayBinding,
+    PureReplayNode,
+    PureResultReplayIndex,
+    _propagate_pure_ineligibility,
+    control_successors,
+    derive_pure_result_replay_index,
+)
+from .pure_result_replay_surfaces import (
+    DURABLE_INPUT_INVALID,
+    DURABLE_INPUT_MISSING,
+    audit_persisted_surfaces,
+    collect_addresses,
+    validate_durable_leaves,
+)
+from .pure_result_replay_witness import (
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_COMPLETE,
+    DURABLE_FAILURE_SKIP,
+    INTERRUPTED,
+    MULTIPLE_VISIT_REGION,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PURE_REPLAY_UNAVAILABLE_CODE,
+    REACHABILITY_AMBIGUOUS,
+    UNSTARTED,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+    _cursor_targets,
+    _is_exact_shell,
+)
+
+__all__ = [
+    "DEPENDENCY_INDEX_INVALID",
+    "DERIVED_COMPLETE",
+    "DERIVED_PURE_REPLAY_PROFILE",
+    "DURABLE_FAILURE_SKIP",
+    "DURABLE_INPUT_INVALID",
+    "DURABLE_INPUT_MISSING",
+    "INTERRUPTED",
+    "MULTIPLE_VISIT_REGION",
+    "PROFILE_CONFLICT",
+    "PROGRESS_WITNESS_INVALID",
+    "PURE_REPLAY_UNAVAILABLE_CODE",
+    "REACHABILITY_AMBIGUOUS",
+    "UNSTARTED",
+    "PureReplayBinding",
+    "PureReplayNode",
+    "PureReplayRuntime",
+    "PureReplayVisitWitness",
+    "PureResultReplayIndex",
+    "PureResultReplayIndexError",
+    "_propagate_pure_ineligibility",
+    "build_pure_completion_shell",
+    "classify_pure_replay_progress",
+    "derive_pure_result_replay_index",
+    "validate_pure_completion_shell",
+]
+
+BINDING_UNRESOLVED = "binding_unresolved"
+EVALUATION_FAILED = "evaluation_failed"
+OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+_CAUSES = {
+    BINDING_UNRESOLVED: "materialize_ref_unresolved",
+    OUTPUT_CONTRACT_INVALID: "pure_projection_contract_invalid",
+    EVALUATION_FAILED: "pure_evaluation_failed",
+}
+
+
+class NodeKey(str):
+    """A node id that also exposes the node's replay identity attributes."""
+
+    step_id: str
+    presentation_key: str
+
+    def __new__(cls, node: PureReplayNode) -> "NodeKey":
+        key = super().__new__(cls, node.node_id)
+        key.step_id = node.step_id
+        key.presentation_key = node.presentation_key
+        return key
+
+    @property
+    def node_id(self) -> str:
+        return str(self)
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def _state_dict(state: Any) -> Mapping[str, Any]:
+    return state.to_dict() if hasattr(state, "to_dict") else state
+
+
+def _failure_reason(result: Mapping[str, Any]) -> tuple[str, dict[str, Any]]:
+    error = result.get("error") if isinstance(result.get("error"), Mapping) else {}
+    context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+    if error.get("type") == "materialize_ref_unresolved":
+        reason = BINDING_UNRESOLVED
+    elif context.get("reason") == "pure_projection_contract_invalid":
+        reason = OUTPUT_CONTRACT_INVALID
+    else:
+        reason = EVALUATION_FAILED
+    return reason, {"type": _CAUSES[reason]}
+
+
+def _expected_members(contracts: Mapping[str, Mapping[str, Any]], artifacts: Mapping[str, Any]) -> set[str]:
+    """Discriminant + shared + active-variant members of one (possibly union) row."""
+    projections = {
+        name: contract["projection"]
+        for name, contract in contracts.items()
+        if isinstance(contract.get("projection"), Mapping)
+        and contract["projection"].get("projection_class") == "union_workflow_boundary"
+    }
+    discriminants = {p.get("discriminant_output") for p in projections.values()}
+    active = artifacts.get(next(iter(discriminants))) if len(discriminants) == 1 else None
+    return {
+        name
+        for name in contracts
+        if name not in projections
+        or projections[name].get("field_role") != "variant"
+        or active in (projections[name].get("active_variants") or ())
+    }
+
+
+class PureReplayRuntime:
+    """Process-local replay cache plus the index for one resume scope."""
+
+    def __init__(self, *, bundle: LoadedWorkflowBundle, scope_path: Any) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index = derive_pure_result_replay_index(bundle)
+        self._node_by_step_id = {node.step_id: node_id for node_id, node in self.index.nodes.items()}
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # -- identities -------------------------------------------------------
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self.index.nodes[node_id]
+        step_index = self.bundle.projection.execution_index_for_step_id(node.step_id)
+        return PureReplayVisitWitness(node.presentation_key, step_index, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Any) -> PureReplayVisitWitness:
+        """Witness carrying the state's recorded visit count (default one)."""
+        visits = _state_dict(state).get("step_visits")
+        recorded = visits.get(self.index.nodes[node_id].presentation_key) if isinstance(visits, Mapping) else None
+        valid = isinstance(recorded, int) and not isinstance(recorded, bool)
+        return self.witness(node_id, visit_count=recorded if valid else 1)
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._node_by_step_id.get(step_id)
+
+    # -- cache ------------------------------------------------------------
+    def _invalid(self, reason: str, message: str, node_id: str, **context: Any) -> PureResultReplayIndexError:
+        node = self.index.nodes[node_id]
+        return PureResultReplayIndexError(
+            reason,
+            message,
+            context={"node_id": node_id, "step_id": node.step_id, "presentation_key": node.presentation_key, **context},
+        )
+
+    def _validate_result(self, node_id: str, result: Any) -> dict[str, Any]:
+        node = self.index.nodes[node_id]
+        artifacts = result.get("artifacts") if isinstance(result, Mapping) else None
+        if not isinstance(result, Mapping) or result.get("status") != "completed" or not isinstance(artifacts, Mapping):
+            raise self._invalid(DEPENDENCY_INDEX_INVALID, "active pure result is not a completed value row", node_id)
+        expected = _expected_members(node.output_contracts, artifacts)
+        if set(artifacts) != expected:
+            raise self._invalid(
+                DEPENDENCY_INDEX_INVALID,
+                "pure result row members do not match the active variant",
+                node_id,
+                missing=sorted(expected - set(artifacts)),
+                extra=sorted(set(artifacts) - expected),
+            )
+        return dict(result)
+
+    def check_active_result(self, node_id: str, result: Any) -> None:
+        """Raise unless ``result`` is a well-formed active row for the node."""
+        self._validate_result(node_id, result)
+
+    def record_full_result(self, node_id: str, *, witness: PureReplayVisitWitness, result: Any) -> None:
+        """Hold one active executor's validated full result for this process."""
+        if witness != self.witness(node_id):
+            raise self._invalid(PROGRESS_WITNESS_INVALID, "witness does not identify a single visit", node_id)
+        self._cache[node_id] = (witness, self._validate_result(node_id, result))
+
+    def _revalidated_hit(self, node_id: str, state: Any) -> dict[str, Any]:
+        """Return the cached result iff the state still shows its exact visit."""
+        witness, result = self._cache[node_id]
+        data = _state_dict(state)
+        key = witness.presentation_key
+        visits = data.get("step_visits")
+        steps = data.get("steps")
+        visit = visits.get(key) if isinstance(visits, Mapping) else None
+        row = steps.get(key) if isinstance(steps, Mapping) else None
+        if (
+            type(visit) is not int
+            or visit != 1
+            or _cursor_targets(data.get("current_step"), witness)
+            or not (_is_exact_shell(row, witness) or (isinstance(row, Mapping) and _canonical(row) == _canonical(result)))
+        ):
+            raise self._invalid(PROGRESS_WITNESS_INVALID, "cached pure result disagrees with the state", node_id)
+        return result
+
+    # -- addresses --------------------------------------------------------
+    def resolve_state_address(self, address: Any, state: Any) -> tuple[bool, Any]:
+        """Resolve an eligible-node address from the cache; (False, None) when absent."""
+        node_id = getattr(address, "node_id", None)
+        if node_id not in self.index.nodes:
+            return False, None
+        if node_id not in self._cache:
+            raise self._invalid(BINDING_UNRESOLVED, "pure value was never reconstructed", node_id)
+        result = self._revalidated_hit(node_id, state)
+        if not isinstance(address, NodeResultAddress):
+            return False, None
+        container = result.get(address.field)
+        if address.field == "exit_code":
+            return True, result.get("exit_code")
+        if isinstance(container, Mapping) and address.member in container:
+            return True, container[address.member]
+        return False, None
+
+    def value_for_state_address(self, address: Any, state: Any) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            node_id = getattr(address, "node_id", None)
+            if node_id not in self.index.nodes:
+                raise PureResultReplayIndexError(
+                    DEPENDENCY_INDEX_INVALID, "address is not an eligible pure node address", context={"node_id": node_id}
+                )
+            raise self._invalid(DEPENDENCY_INDEX_INVALID, "address is not a member of the active pure row", node_id)
+        return value
+
+    def overlay_active_state(self, state: Any) -> dict[str, Any]:
+        """Copy of ``state`` whose completed eligible shells carry the cached full rows."""
+        data = dict(_state_dict(state))
+        steps = dict(data.get("steps") or {})
+        for node_id, (witness, _) in self._cache.items():
+            steps[witness.presentation_key] = dict(self._revalidated_hit(node_id, data))
+        data["steps"] = steps
+        return data
+
+    # -- replay -----------------------------------------------------------
+    def replay_node(self, node_id: str, *, state: Any, evaluate_node: Callable[[Any, dict[str, Any]], Any]) -> dict[str, Any]:
+        """Rebuild one completed node's full row in memory; never writes state."""
+        node = self.index.nodes[node_id]
+        if node_id in self._cache:
+            return self._revalidated_hit(node_id, state)
+        witness = self.witness_from_state(node_id, state)
+        if classify_pure_replay_progress(state, witness=witness) != DERIVED_COMPLETE:
+            raise self._invalid(PROGRESS_WITNESS_INVALID, "only a derived-complete node can be replayed", node_id)
+        for dependency in node.pure_dependency_node_ids:
+            self.replay_node(dependency, state=state, evaluate_node=evaluate_node)
+        overlay = self.overlay_active_state(state)
+        try:
+            result = evaluate_node(NodeKey(node), overlay)
+        except PureResultReplayIndexError:
+            raise
+        except Exception as exc:  # evaluator crashes are replay failures, not run state
+            raise self._invalid(
+                EVALUATION_FAILED, str(exc), node_id, cause={"type": _CAUSES[EVALUATION_FAILED]}
+            ) from exc
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            reason, cause = _failure_reason(result if isinstance(result, Mapping) else {})
+            raise self._invalid(reason, "pure value could not be re-derived", node_id, cause=cause)
+        validated = self._validate_result(node_id, self._with_identity(result, witness))
+        self._cache[node_id] = (witness, validated)
+        return validated
+
+    @staticmethod
+    def _with_identity(result: Mapping[str, Any], witness: PureReplayVisitWitness) -> dict[str, Any]:
+        row = dict(result)
+        row.setdefault("name", witness.presentation_key)
+        row.setdefault("step_id", witness.step_id)
+        row.setdefault("visit_count", 1)
+        row.setdefault("exit_code", 0)
+        row.setdefault("outcome", build_pure_completion_shell(witness)["outcome"])
+        return row
+
+    # -- boundary ---------------------------------------------------------
+    def _future_nodes(self, restart_node_id: Optional[str]) -> set[str]:
+        ir = self.bundle.ir
+        graph = control_successors(self.bundle)
+        start = [restart_node_id] if restart_node_id else []
+        if restart_node_id is not None and restart_node_id not in ir.nodes:
+            raise PureResultReplayIndexError(
+                REACHABILITY_AMBIGUOUS, "restart node is unknown", context={"restart_node_id": restart_node_id}
+            )
+        seen: set[str] = set(ir.finalization_region)
+        queue = deque([*start, *ir.finalization_region])
+        while queue:
+            current = queue.popleft()
+            node = ir.nodes[current]
+            seen.add(current)
+            for follower in (*graph.get(current, ()), *getattr(node, "body_node_ids", ())):
+                if follower not in seen:
+                    seen.add(follower)
+                    queue.append(follower)
+        return seen
+
+    def _reached_pure_nodes(self, state: Any) -> list[str]:
+        reached = []
+        for node_id in self.index.nodes:
+            witness = self.witness_from_state(node_id, state)
+            progress = classify_pure_replay_progress(state, witness=witness)
+            if progress == PROGRESS_WITNESS_INVALID:
+                raise self._invalid(PROGRESS_WITNESS_INVALID, "pure visit progress is invalid", node_id)
+            if progress == DERIVED_COMPLETE:
+                reached.append(node_id)
+        return reached
+
+    def required_node_ids_for_boundary(self, restart_node_id: Optional[str], *, state: Any) -> tuple[str, ...]:
+        """Completed pure nodes whose values the run from the boundary still reads."""
+        if not self.index.nodes:
+            return ()
+        seeds: list[Any] = []
+        for node_id in self._future_nodes(restart_node_id):
+            collect_addresses(self.bundle.ir.nodes[node_id], self.bundle, seeds)
+        collect_addresses(self.bundle.ir.outputs, self.bundle, seeds)
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=self._reached_pure_nodes(state))
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Any) -> tuple[str, ...]:
+        """Validate the durable leaves feeding the required nodes; return those nodes."""
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        validate_durable_leaves(self.bundle, self.index, required, _state_dict(state))
+        return required
+
+    def audit_progress(self, state: Any) -> None:
+        """Reject any invalid visit/cursor/row combination for an eligible node."""
+        self._reached_pure_nodes(state)
+
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Any,
+        state_manager: Any,
+        resolve_bundle_path: Callable[[Any], Any],
+    ) -> None:
+        frame_ids = getattr(self.scope_path, "call_frame_ids", ())
+        audit_persisted_surfaces(
+            self.index,
+            bundle=self.bundle,
+            frame_id=frame_ids[-1] if frame_ids else None,
+            state=_state_dict(state),
+            state_manager=state_manager,
+            resolve_bundle_path=resolve_bundle_path,
+            node_key=NodeKey,
+        )

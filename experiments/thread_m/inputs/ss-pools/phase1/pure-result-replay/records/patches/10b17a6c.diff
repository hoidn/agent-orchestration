+
+def test_provider_observation_manager_is_created_at_execution_and_closed_once(tmp_path: Path) -> None:
+    source, bundle = _bundle(tmp_path)
+    manager = _manager(tmp_path, source, bundle, None)
+    created: list[object] = []
+
+    class FakeManager:
+        def __init__(self, run_root):
+            self.closed = 0
+            created.append(self)
+
+        def close(self):
+            self.closed += 1
+
+    with patch("orchestrator.workflow.executor.ProviderObservationManager", FakeManager):
+        executor = WorkflowExecutor(bundle, tmp_path, manager)
+        assert created == []

+++ b/orchestrator/workflow/pure_result_replay_surfaces.py
@@ -0,0 +1,242 @@
+"""Durable-surface audits and boundary leaf validation for derived pure replay.
+
+Dependencies: the replay index, the persisted run state dict, and (for checkpoint
+conflicts) the lexical-checkpoint sidecar readers. Nothing here writes state.
+Behavior: ``audit_persisted_surfaces`` raises ``profile_conflict`` when an eligible
+pure node left a value row, bundle, private lineage, checkpoint record or restore
+binding; ``validate_durable_leaves`` types the durable inputs replay will read.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import fields, is_dataclass
+from enum import Enum
+from pathlib import Path
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+from .executable_ir import (
+    BlockOutputAddress,
+    CallOutputAddress,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_result_replay_index import (
+    PureReplayNode,
+    PureResultReplayIndex,
+    address_for_ref,
+    step_names_for,
+)
+from .pure_result_replay_types import TypedValueError, check_typed_value
+from .pure_result_replay_witness import PROFILE_CONFLICT, PureResultReplayIndexError
+
+DURABLE_INPUT_MISSING = "durable_input_missing"
+DURABLE_INPUT_INVALID = "durable_input_invalid"
+
+_ADDRESS_TYPES = (
+    WorkflowInputAddress,
+    NodeResultAddress,
+    BlockOutputAddress,
+    LoopOutputAddress,
+    CallOutputAddress,
+)
+_REF_TEXT = re.compile(r"root\.steps\.[^\s'\"\\]+")
+_VALUE_KEYS = frozenset({"artifacts", "output", "json", "text", "lines", "debug", "files", "snapshots"})
+_OUTCOME_TYPES = {"status": str, "phase": str, "class": str, "retryable": bool}
+
+
+def collect_addresses(obj: Any, bundle: LoadedWorkflowBundle, out: list[Any], depth: int = 0) -> None:
+    """Collect every bound address or scope-local ref reachable inside ``obj``."""
+    if depth > 40 or isinstance(obj, (Enum, int, float, bool, type(None), bytes)):
+        return
+    if isinstance(obj, _ADDRESS_TYPES):
+        out.append(obj)
+    elif isinstance(obj, str):
+        _collect_ref_text(obj, bundle, out)
+    elif isinstance(obj, Mapping):
+        for item in obj.values():
+            collect_addresses(item, bundle, out, depth + 1)
+    elif isinstance(obj, (list, tuple, set, frozenset)):
+        for item in obj:
+            collect_addresses(item, bundle, out, depth + 1)
+    elif is_dataclass(obj) and not isinstance(obj, type):
+        for spec in fields(obj):
+            collect_addresses(getattr(obj, spec.name), bundle, out, depth + 1)
+
+
+def _collect_ref_text(text: str, bundle: LoadedWorkflowBundle, out: list[Any]) -> None:
+    names = step_names_for(bundle)
+    for match in _REF_TEXT.finditer(text):
+        candidate = match.group(0)
+        while candidate.startswith("root.steps."):
+            try:
+                out.append(address_for_ref(candidate, bundle, names))
+                break
+            except ValueError:
+                candidate = candidate[:-1]
+
+
+def _row_of(bundle: LoadedWorkflowBundle, node_id: str, state: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
+    key = bundle.projection.presentation_key_by_node_id.get(node_id)
+    steps = state.get("steps")
+    row = steps.get(key) if isinstance(steps, Mapping) else None
+    return row if isinstance(row, Mapping) else None
+
+
+def _leaf_error(reason: str, message: str, node: PureReplayNode, address: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        reason,
+        message,
+        context={"node_id": node.node_id, "step_id": node.step_id, "address": repr(address)},
+    )
+
+
+def _typed(value: Any, descriptor: Mapping[str, Any], node: PureReplayNode, address: Any) -> None:
+    try:
+        check_typed_value(value, descriptor, "durable input")
+    except TypedValueError as exc:
+        raise _leaf_error(DURABLE_INPUT_INVALID, str(exc), node, address) from exc
+
+
+def _intrinsic_value(row: Mapping[str, Any], address: NodeResultAddress) -> tuple[bool, Any, bool]:
+    """Return (found, value, intrinsic_type_ok) for exit_code / outcome members."""
+    if address.field == "exit_code":
+        value = row.get("exit_code")
+        return "exit_code" in row, value, type(value) is int
+    outcome = row.get("outcome")
+    if not isinstance(outcome, Mapping) or address.member not in outcome:
+        return False, None, True
+    expected = _OUTCOME_TYPES.get(address.member or "")
+    value = outcome[address.member]
+    return True, value, expected is None or type(value) is expected
+
+
+def _durable_value(address: Any, row: Optional[Mapping[str, Any]]) -> tuple[bool, Any, bool]:
+    if row is None:
+        return False, None, True
+    if isinstance(address, NodeResultAddress) and address.field in {"exit_code", "outcome"}:
+        return _intrinsic_value(row, address)
+    member = address.member if isinstance(address, NodeResultAddress) else address.output_name
+    container = row.get(address.field if isinstance(address, NodeResultAddress) else "artifacts")
+    if isinstance(container, Mapping) and member in container:
+        return True, container[member], True
+    return False, None, True
+
+
+def validate_durable_leaves(
+    bundle: LoadedWorkflowBundle,
+    index: PureResultReplayIndex,
+    node_ids: Iterable[str],
+    state: Mapping[str, Any],
+) -> None:
+    """Validate the durable inputs and rows that replaying ``node_ids`` will read."""
+    bound_inputs = state.get("bound_inputs")
+    for node_id in node_ids:
+        node = index.nodes[node_id]
+        for binding in node.bindings:
+            address = binding.address
+            if isinstance(address, WorkflowInputAddress):
+                present = isinstance(bound_inputs, Mapping) and address.input_name in bound_inputs
+                value = bound_inputs[address.input_name] if present else None
+                typed = True
+            elif address.node_id in index.nodes:
+                continue
+            else:
+                present, value, typed = _durable_value(address, _row_of(bundle, address.node_id, state))
+            if not present:
+                raise _leaf_error(DURABLE_INPUT_MISSING, "durable replay input is missing", node, address)
+            if not typed:
+                raise _leaf_error(DURABLE_INPUT_INVALID, "durable intrinsic has the wrong type", node, address)
+            if not (isinstance(address, NodeResultAddress) and address.field in {"exit_code", "outcome"}):
+                _typed(value, binding.value_type, node, address)
+
+
+def _conflict(surface: str, node: PureReplayNode, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROFILE_CONFLICT,
+        f"eligible pure node {node.node_id!r} left a persisted {surface}",
+        context={"surface": surface, "node_id": node.node_id, "step_id": node.step_id, **context},
+    )
+
+
+def _is_value_row(row: Any) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") == "completed"
+        and (row.get("result_storage") != DERIVED_PURE_REPLAY_PROFILE or bool(_VALUE_KEYS & set(row)))
+    )
+
+
+def _checkpoint_records(
+    runtime_plan: Any,
+    state_manager: Any,
+    frame_id: Optional[str],
+) -> Iterable[tuple[Any, Mapping[str, Any]]]:
+    from orchestrator.workflow_lisp import lexical_checkpoints as checkpoints
+
+    for point in getattr(runtime_plan, "lexical_checkpoint_points", ()) or ():
+        index_path = checkpoints.resolve_checkpoint_index_path(
+            state_manager=state_manager,
+            workflow_name=point.workflow_name,
+            checkpoint_id=point.checkpoint_id,
+        )
+        payload = checkpoints._load_json_object(state_manager, index_path)
+        for entry in (payload or {}).get("records", ()):
+            identity = entry.get("frame_identity") if isinstance(entry, Mapping) else None
+            if not isinstance(identity, Mapping) or identity.get("call_frame_id") != frame_id:
+                continue
+            record = checkpoints._load_json_object(
+                state_manager, Path(state_manager.workspace) / str(entry.get("record_path"))
+            )
+            if record is not None:
+                yield point, record
+
+
+def _audit_checkpoints(
+    index: PureResultReplayIndex,
+    runtime_plan: Any,
+    state_manager: Any,
+    frame_id: Optional[str],
+) -> None:
+    by_step = {node.step_id: node for node in index.nodes.values()}
+    for point, record in _checkpoint_records(runtime_plan, state_manager, frame_id):
+        node = by_step.get(getattr(point, "step_id", None))
+        if node is not None:
+            raise _conflict("checkpoint_record", node, record_id=record.get("record_id"))
+        for binding in (record.get("restore_payload") or {}).get("bindings") or ():
+            source = binding.get("source_step_id") if isinstance(binding, Mapping) else None
+            if source in by_step:
+                raise _conflict("restore_payload", by_step[source], record_id=record.get("record_id"))
+
+
+def audit_persisted_surfaces(
+    index: PureResultReplayIndex,
+    *,
+    bundle: LoadedWorkflowBundle,
+    frame_id: Optional[str],
+    state: Mapping[str, Any],
+    state_manager: Any,
+    resolve_bundle_path: Callable[[Any], Optional[Path]],
+    node_key: Callable[[PureReplayNode], Any],
+) -> None:
+    """Raise ``profile_conflict`` for any persisted value surface of an eligible node."""
+    steps = state.get("steps")
+    versions = state.get("private_artifact_versions")
+    for node in index.nodes.values():
+        if isinstance(steps, Mapping) and _is_value_row(steps.get(node.presentation_key)):
+            raise _conflict("steps", node)
+        bundle_path = resolve_bundle_path(node_key(node))
+        if bundle_path is not None and Path(bundle_path).exists():
+            raise _conflict("pure_bundle", node, path=str(bundle_path))
+        if isinstance(versions, Mapping) and any(
+            isinstance(entry, Mapping)
+            and (entry.get("producer") == node.step_id or entry.get("producer_name") == node.presentation_key)
+            for entries in versions.values()
+            for entry in (entries if isinstance(entries, list) else ())
+        ):
+            raise _conflict("private_artifact_versions", node)
+    if state_manager is not None and index.nodes:
+        _audit_checkpoints(index, bundle.runtime_plan, state_manager, frame_id)

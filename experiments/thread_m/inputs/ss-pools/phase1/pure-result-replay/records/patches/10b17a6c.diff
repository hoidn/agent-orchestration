@@ -0,0 +1,239 @@
+"""Replay-index derivation: eligibility, typed addresses, dependency edges."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from orchestrator.workflow.executable_ir import NodeResultAddress, WorkflowInputAddress
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+VALID = Path("tests/fixtures/workflow_lisp/valid")
+LOOP = "pure_expr_loop_counter::run-counter"
+TWO_PURE = "minimal_caller_finalize_selected_item::minimal-finalize-selected-item"
+
+
+@pytest.fixture(scope="module")
+def bundles(tmp_path_factory) -> dict[str, Any]:
+    workspace = tmp_path_factory.mktemp("index")
+    out: dict[str, Any] = {}
+    for fixture in ("pure_expr_loop_counter.orc", "minimal_caller_finalize_selected_item.orc"):
+        result = compile_stage3_entrypoint(
+            VALID / fixture,
+            source_roots=(VALID,),
+            provider_externs={},
+            prompt_externs={},
+            command_boundaries={},
+            validate_shared=True,
+            workspace_root=workspace,
+        )
+        out.update(result.validated_bundles_by_name)
+    return out
+
+
+def _with_pure_config(bundle, node_id: str, **overrides: Any):
+    node = bundle.ir.nodes[node_id]
+    config = replace(
+        node.execution_config,
+        pure_projection={**node.execution_config.pure_projection, **overrides},
+    )
+    nodes = {**bundle.ir.nodes, node_id: replace(node, execution_config=config)}
+    return replace(bundle, ir=replace(bundle.ir, nodes=nodes))
+
+
+def test_loop_owned_pure_nodes_are_ineligible_with_a_reason(bundles) -> None:
+    index = derive_pure_result_replay_index(bundles[LOOP])
+
+    assert index.nodes == {}
+    assert set(index.ineligible_pure_reasons.values()) == {"multiple_visit_region"}
+
+
+def test_nodes_carry_typed_addresses_and_contracts(bundles) -> None:
+    index = derive_pure_result_replay_index(bundles[TWO_PURE])
+    node = next(iter(index.nodes.values()))
+
+    assert index.scope_kind == "root"
+    assert index.topological_node_ids == tuple(index.nodes)
+    assert {type(binding.address) for binding in node.bindings} == {WorkflowInputAddress}
+    assert all(isinstance(address, NodeResultAddress) for address in node.output_addresses)
+    assert {address.member for address in node.output_addresses} == set(node.output_contracts)
+    assert node.pure_dependency_node_ids == () and node.durable_dependency_node_ids == ()
+
+
+def test_index_derivation_does_not_change_the_bundle(bundles) -> None:
+    bundle = bundles[TWO_PURE]
+    before = bundle.runtime_plan
+
+    derive_pure_result_replay_index(bundle)
+
+    assert bundle.runtime_plan is before
+
+
+def test_pure_to_pure_ref_forms_a_dependency_edge(bundles) -> None:
+    bundle = bundles[TWO_PURE]
+    first, second = list(derive_pure_result_replay_index(bundle).nodes)
+    first_member = next(iter(bundle.ir.nodes[first].execution_config.pure_projection["output_contracts"]))
+    ref = f"root.steps.{bundle.ir.nodes[first].presentation_name}.artifacts.{first_member}"
+    refs = dict(bundle.ir.nodes[second].execution_config.pure_projection["binding_refs"])
+    refs["blocker-class"] = {"ref": ref}
+
+    index = derive_pure_result_replay_index(_with_pure_config(bundle, second, binding_refs=refs))
+
+    assert index.nodes[second].pure_dependency_node_ids == (first,)
+    assert index.topological_node_ids == (first, second)

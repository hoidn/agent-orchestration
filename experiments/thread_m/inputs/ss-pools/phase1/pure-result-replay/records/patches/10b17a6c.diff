+++ b/orchestrator/workflow/pure_result_replay_index.py
@@ -0,0 +1,422 @@
+"""Derive the pure-result replay index from one loaded workflow bundle.
+
+Dependencies: the bundle's executable IR, projection and pure-projection step
+configs (read only; the serialized runtime plan is never touched).
+Behavior: finds compiler-generated pure projections that are acyclic and visited
+at most once per scope, binds every exact ``{"ref": ...}`` leaf of their binding
+documents to a typed address, and records pure/durable dependency edges.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field, replace
+from typing import Any, Iterable, Mapping
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_result_replay_types import TypedValueError, check_typed_value
+from .pure_result_replay_witness import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+from .references import ReferenceResolutionError, parse_structured_ref
+
+ROOT_SCOPE = "root"
+NOT_COMPILER_GENERATED = "not_compiler_generated"
+DURABLE_PUBLICATION = "durable_publication"
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    """One ref leaf of a binding document: ``path[0]`` is the binding name."""
+
+    path: tuple[Any, ...]
+    address: BoundAddress
+    value_type: Mapping[str, Any] = field(compare=False, default_factory=dict)
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    """One replay-eligible pure projection and what it depends on."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Mapping[str, Any]]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    """Derived, immutable replay catalog for one scope."""
+
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[Any],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Return reached pure nodes needed to rebuild the seed addresses."""
+        reached = frozenset(reached_node_ids)
+        needed: set[str] = set()
+        pending = [
+            seed.node_id
+            for seed in seed_addresses
+            if getattr(seed, "node_id", None) in self.nodes and seed.node_id in reached
+        ]
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            needed.add(node_id)
+            for dependency in self.nodes[node_id].pure_dependency_node_ids:
+                if dependency not in reached:
+                    raise PureResultReplayIndexError(
+                        REACHABILITY_AMBIGUOUS,
+                        f"pure node {node_id!r} depends on unreached pure node {dependency!r}",
+                        context={"node_id": node_id, "dependency_node_id": dependency},
+                    )
+                pending.append(dependency)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and set(doc) == {"ref"}
+
+
+def address_for_ref(ref: str, bundle: LoadedWorkflowBundle, step_names: Mapping[str, str]) -> BoundAddress:
+    """Bind one scope-local ref string; foreign or unknown targets are invalid."""
+    if ref.startswith("inputs."):
+        name = ref[len("inputs."):]
+        if name not in bundle.ir.inputs:
+            raise _invalid(f"ref {ref!r} names an unknown workflow input", ref=ref)
+        return WorkflowInputAddress(input_name=name)
+    if not ref.startswith("root.steps."):
+        raise _invalid(f"ref {ref!r} is not scoped to this workflow's root", ref=ref)
+    try:
+        target = parse_structured_ref(ref, step_names)
+    except ReferenceResolutionError as exc:
+        raise _invalid(f"ref {ref!r} does not name a step of this workflow", ref=ref) from exc
+    if target.step_name not in step_names:
+        raise _invalid(f"ref {ref!r} does not name a step of this workflow", ref=ref)
+    node_id = step_names[target.step_name]
+    kind = bundle.ir.nodes[node_id].kind
+    if target.field == "artifacts" and target.member:
+        if kind in {ExecutableNodeKind.IF_JOIN, ExecutableNodeKind.MATCH_JOIN}:
+            return BlockOutputAddress(node_id=node_id, output_name=target.member)
+        if kind is ExecutableNodeKind.REPEAT_UNTIL_FRAME:
+            return LoopOutputAddress(node_id=node_id, output_name=target.member)
+        if kind is ExecutableNodeKind.CALL_BOUNDARY:
+            return CallOutputAddress(node_id=node_id, output_name=target.member)
+    return NodeResultAddress(node_id=node_id, field=target.field, member=target.member)
+
+
+def _walk_document(
+    doc: Any,
+    descriptor: Mapping[str, Any],
+    path: tuple[Any, ...],
+    resolve_ref: Any,
+    out: list[PureReplayBinding],
+) -> None:
+    """Collect ref leaves and type-check every literal subtree of one document."""
+    if isinstance(doc, Mapping) and "ref" in doc and (
+        not isinstance(doc["ref"], str) or not doc["ref"]
+    ):
+        raise _invalid("malformed ref object in binding document", path=list(path))
+    if _is_exact_ref(doc):
+        out.append(PureReplayBinding(path, resolve_ref(doc["ref"]), descriptor))
+        return
+    kind = descriptor["kind"]
+    try:
+        if kind == "optional":
+            if doc is not None:
+                _walk_document(doc, descriptor["item"], path, resolve_ref, out)
+        elif kind == "list" and isinstance(doc, (list, tuple)):
+            for index, item in enumerate(doc):
+                _walk_document(item, descriptor["item"], (*path, index), resolve_ref, out)
+        elif kind == "map" and isinstance(doc, Mapping):
+            for key, item in doc.items():
+                _walk_document(item, descriptor["value"], (*path, key), resolve_ref, out)
+        elif kind == "record" and isinstance(doc, Mapping):
+            fields = {f["name"]: f["type"] for f in descriptor["fields"]}
+            if set(doc) != set(fields):
+                raise TypedValueError("record fields do not match the declared fields")
+            for name, field_type in fields.items():
+                _walk_document(doc[name], field_type, (*path, name), resolve_ref, out)
+        elif kind in {"union", "variant_case"} and _union_has_ref(doc):
+            _walk_union(doc, descriptor, path, resolve_ref, out)
+        else:
+            _check_literal(doc, descriptor)
+    except TypedValueError as exc:
+        raise _invalid(f"binding literal does not match its declared type: {exc}", path=list(path)) from exc
+
+
+def _union_has_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and any(
+        _contains_ref(item) for key, item in doc.items() if key != "variant"
+    )
+
+
+def _contains_ref(doc: Any) -> bool:
+    if _is_exact_ref(doc):
+        return True
+    if isinstance(doc, Mapping):
+        return any(_contains_ref(item) for item in doc.values())
+    if isinstance(doc, (list, tuple)):
+        return any(_contains_ref(item) for item in doc)
+    return False
+
+
+def _walk_union(doc, descriptor, path, resolve_ref, out) -> None:
+    variants = (
+        {descriptor["variant"]: descriptor}
+        if descriptor["kind"] == "variant_case"
+        else {v["name"]: v for v in descriptor["variants"]}
+    )
+    active = doc.get("variant")
+    if not isinstance(active, str) or active not in variants:
+        raise TypedValueError("union literal needs a known `variant`")
+    active_fields = {f["name"]: f["type"] for f in variants[active]["fields"]}
+    other_fields = {
+        f["name"]: f["type"]
+        for name, variant in variants.items()
+        if name != active
+        for f in variant["fields"]
+    }
+    for key, item in doc.items():
+        if key == "variant":
+            continue
+        field_type = active_fields.get(key) or other_fields.get(key)
+        if field_type is None:
+            raise TypedValueError(f"unexpected union member `{key}`")
+        _walk_document(item, field_type, (*path, key), resolve_ref, out)
+    if set(active_fields) - set(doc):
+        raise TypedValueError("union literal is missing active variant fields")
+
+
+def _check_literal(doc: Any, descriptor: Mapping[str, Any]) -> None:
+    _reject_unbound_text(doc)
+    check_typed_value(doc, descriptor, "binding")
+
+
+def _reject_unbound_text(doc: Any) -> None:
+    if isinstance(doc, str) and "${" in doc:
+        raise TypedValueError("unbound text template in literal")
+    if isinstance(doc, Mapping):
+        for item in doc.values():
+            _reject_unbound_text(item)
+    elif isinstance(doc, (list, tuple)):
+        for item in doc:
+            _reject_unbound_text(item)
+
+
+def control_successors(bundle: LoadedWorkflowBundle) -> dict[str, set[str]]:
+    graph: dict[str, set[str]] = {}
+    for node_id, node in bundle.ir.nodes.items():
+        targets = {t.target_node_id for t in node.routed_transfers.values() if t.target_node_id}
+        if node.fallthrough_node_id:
+            targets.add(node.fallthrough_node_id)
+        graph[node_id] = targets
+    return graph
+
+
+def _on_cycle(node_id: str, graph: Mapping[str, set[str]]) -> bool:
+    seen: set[str] = set()
+    stack = list(graph.get(node_id, ()))
+    while stack:
+        current = stack.pop()
+        if current == node_id:
+            return True
+        if current not in seen:
+            seen.add(current)
+            stack.extend(graph.get(current, ()))
+    return False
+
+
+def _propagate_pure_ineligibility(
+    reasons: dict[str, str],
+    regions: Mapping[str, frozenset[str]],
+    pure_node_ids: frozenset[str] = frozenset(),
+) -> None:
+    """Spread a multi-visit verdict to every pure node sharing the same region."""
+    for region_nodes in regions.values():
+        pure_members = region_nodes & pure_node_ids
+        if any(reasons.get(node_id) == MULTIPLE_VISIT_REGION for node_id in pure_members):
+            for node_id in pure_members:
+                reasons[node_id] = MULTIPLE_VISIT_REGION
+
+
+def _structural_verdicts(bundle: LoadedWorkflowBundle) -> tuple[list[str], dict[str, str]]:
+    """Split pure nodes into replay candidates and ineligible-with-reason."""
+    ir = bundle.ir
+    top_level = set(ir.body_region) | set(ir.finalization_region)
+    loop_bodies: dict[str, frozenset[str]] = {
+        node_id: frozenset(node.body_node_ids)
+        for node_id, node in ir.nodes.items()
+        if hasattr(node, "body_node_ids")
+    }
+    graph = control_successors(bundle)
+    compiler_generated = bundle.provenance.frontend_kind == "workflow_lisp"
+    candidates: list[str] = []
+    reasons: dict[str, str] = {}
+    for node_id, node in ir.nodes.items():
+        if node.kind is not ExecutableNodeKind.PURE_PROJECTION:
+            continue
+        common = node.execution_config.common
+        if not compiler_generated:
+            reasons[node_id] = NOT_COMPILER_GENERATED
+        elif node_id not in top_level or _on_cycle(node_id, graph):
+            reasons[node_id] = MULTIPLE_VISIT_REGION
+        elif common.publishes or common.consumes:
+            reasons[node_id] = DURABLE_PUBLICATION
+        else:
+            candidates.append(node_id)
+    pure_ids = frozenset(candidates) | frozenset(reasons)
+    _propagate_pure_ineligibility(reasons, loop_bodies, pure_ids)
+    return [n for n in candidates if n not in reasons], reasons
+
+
+def step_names_for(bundle: LoadedWorkflowBundle) -> dict[str, str]:
+    """Presentation key -> node id for this workflow's own top-level steps."""
+    projection = bundle.projection
+    names: dict[str, str] = {}
+    for node_id in projection.ordered_execution_node_ids():
+        key = projection.presentation_key_by_node_id.get(node_id)
+        if key is not None:
+            names[key] = node_id
+    return names
+
+
+def _check_authority(bundle: LoadedWorkflowBundle, candidates: Iterable[str]) -> None:
+    projection = bundle.projection
+    seen_steps: dict[str, str] = {}
+    seen_keys: dict[str, str] = {}
+    for node_id in candidates:
+        node = bundle.ir.nodes[node_id]
+        for registry, value, label in (
+            (seen_steps, node.step_id, "step id"),
+            (seen_keys, node.presentation_name, "presentation key"),
+        ):
+            if value in registry:
+                raise _invalid(f"duplicate projection authority for {label} {value!r}", node_id=node_id)
+            registry[value] = node_id
+        if (
+            projection.node_id_by_step_id.get(node.step_id) != node_id
+            or projection.presentation_key_by_node_id.get(node_id) != node.presentation_name
+        ):
+            raise _invalid("pure node disagrees with the state projection", node_id=node_id)
+
+
+def _build_node(bundle: LoadedWorkflowBundle, node_id: str, step_names: Mapping[str, str]) -> PureReplayNode:
+    node = bundle.ir.nodes[node_id]
+    config = node.execution_config.pure_projection
+    payload, binding_refs = config.get("payload"), config.get("binding_refs")
+    contracts = config.get("output_contracts")
+    if not (isinstance(payload, Mapping) and isinstance(binding_refs, Mapping) and isinstance(contracts, Mapping)):
+        raise _invalid("pure projection config is malformed", node_id=node_id)
+    declared = payload.get("bindings", {})
+    unknown = set(binding_refs) - set(declared)
+    unbound = {name for name, spec in declared.items() if name not in binding_refs and "value" not in spec}
+    if unknown or unbound:
+        raise _invalid(
+            "pure projection bindings are not bound",
+            node_id=node_id,
+            unknown=sorted(unknown),
+            unbound=sorted(unbound),
+        )
+    bindings: list[PureReplayBinding] = []
+    for name, doc in binding_refs.items():
+        _walk_document(
+            doc,
+            declared[name]["type"],
+            (name,),
+            lambda ref: address_for_ref(ref, bundle, step_names),
+            bindings,
+        )
+    return PureReplayNode(
+        node_id=node_id,
+        step_id=node.step_id,
+        presentation_key=node.presentation_name,
+        bindings=tuple(bindings),
+        output_addresses=tuple(NodeResultAddress(node_id, "artifacts", name) for name in contracts),
+        output_contracts=contracts,
+        pure_dependency_node_ids=(),
+        durable_dependency_node_ids=(),
+    )
+
+
+def _with_dependencies(node: PureReplayNode, eligible: frozenset[str], order: Mapping[str, int]) -> PureReplayNode:
+    targets = {b.address.node_id for b in node.bindings if hasattr(b.address, "node_id")}
+
+    def rank(node_id: str) -> tuple[int, str]:
+        return (order.get(node_id, len(order)), node_id)
+
+    return replace(
+        node,
+        pure_dependency_node_ids=tuple(sorted(targets & eligible, key=rank)),
+        durable_dependency_node_ids=tuple(sorted(targets - eligible, key=rank)),
+    )
+
+
+def _topological_order(nodes: Mapping[str, PureReplayNode], order: Mapping[str, int]) -> tuple[str, ...]:
+    remaining = {node_id: set(node.pure_dependency_node_ids) for node_id, node in nodes.items()}
+    ordered: list[str] = []
+    while remaining:
+        ready = sorted((n for n, deps in remaining.items() if not deps), key=lambda n: (order.get(n, 0), n))
+        if not ready:
+            raise _invalid("pure dependency cycle", node_ids=sorted(remaining))
+        ordered.extend(ready)
+        for node_id in ready:
+            del remaining[node_id]
+        for deps in remaining.values():
+            deps.difference_update(ready)
+    return tuple(ordered)
+
+
+def derive_pure_result_replay_index(
+    bundle: LoadedWorkflowBundle,
+    *,
+    scope_kind: str = ROOT_SCOPE,
+) -> PureResultReplayIndex:
+    """Derive the replay index for ``bundle`` without mutating or serializing it."""
+    if scope_kind != ROOT_SCOPE:
+        raise PureResultReplayIndexError(
+            DEPENDENCY_INDEX_INVALID,
+            "scope_kind does not match the bundle's scope",
+            context={"expected_scope": scope_kind, "actual_scope": ROOT_SCOPE},
+        )
+    candidates, reasons = _structural_verdicts(bundle)
+    _check_authority(bundle, candidates)
+    step_names = step_names_for(bundle)
+    base = {node_id: _build_node(bundle, node_id, step_names) for node_id in candidates}
+    execution = {n: i for i, n in enumerate(bundle.projection.ordered_execution_node_ids())}
+    eligible = frozenset(base)
+    nodes = {node_id: _with_dependencies(node, eligible, execution) for node_id, node in base.items()}
+    return PureResultReplayIndex(
+        scope_kind=ROOT_SCOPE,
+        nodes=nodes,
+        topological_node_ids=_topological_order(nodes, execution),
+        ineligible_pure_reasons=reasons,
+    )

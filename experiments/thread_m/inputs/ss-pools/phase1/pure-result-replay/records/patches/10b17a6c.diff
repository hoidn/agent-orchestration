index 0000000..78b68b4
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_types.py
@@ -0,0 +1,143 @@
+"""Strict typed-value checks over normalized pure type descriptors.
+
+Behavior: ``check_typed_value`` validates a JSON-like value against one
+descriptor and, unlike pure evaluation coercion, also types the *inactive*
+members of union values. ``descriptor_for_path`` walks a descriptor along a
+document path. No dependencies beyond the standard library.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Sequence
+
+
+class TypedValueError(ValueError):
+    """A value does not match its declared descriptor."""
+
+
+def _is_seq(value: Any) -> bool:
+    return isinstance(value, (list, tuple))
+
+
+def _variant_fields(variant: Mapping[str, Any]) -> Mapping[str, Any]:
+    return {field["name"]: field["type"] for field in variant.get("fields") or ()}
+
+
+def _union_variants(descriptor: Mapping[str, Any]) -> Mapping[str, Mapping[str, Any]]:
+    if descriptor["kind"] == "variant_case":
+        return {descriptor["variant"]: _variant_fields(descriptor)}
+    return {variant["name"]: _variant_fields(variant) for variant in descriptor["variants"]}
+
+
+def _fail(context: str, message: str) -> None:
+    raise TypedValueError(f"{context}: {message}")
+
+
+def _check_primitive(value: Any, name: str, context: str) -> None:
+    if name == "Bool":
+        ok = type(value) is bool
+    elif name == "Int":
+        ok = type(value) is int
+    elif name == "Float":
+        ok = isinstance(value, float)
+    elif name == "Json":
+        ok = True
+    else:
+        ok = isinstance(value, str)
+    if not ok:
+        _fail(context, f"expected {name}")
+
+
+def _check_union(value: Any, descriptor: Mapping[str, Any], context: str) -> None:
+    variants = _union_variants(descriptor)
+    if not isinstance(value, Mapping) or not isinstance(value.get("variant"), str):
+        _fail(context, "union value must declare a string `variant`")
+    active = value["variant"]
+    if active not in variants:
+        _fail(context, f"unknown variant `{active}`")
+    inactive_fields: dict[str, list[Any]] = {}
+    for variant_name, fields in variants.items():
+        if variant_name != active:
+            for field_name, field_type in fields.items():
+                inactive_fields.setdefault(field_name, []).append(field_type)
+    for field_name, field_type in variants[active].items():
+        if field_name not in value:
+            _fail(context, f"missing variant field `{field_name}`")
+        check_typed_value(value[field_name], field_type, f"{context}.{field_name}")
+    for key, item in value.items():
+        if key == "variant" or key in variants[active]:
+            continue
+        candidates = inactive_fields.get(key)
+        if not candidates:
+            _fail(context, f"unexpected union member `{key}`")
+        errors = []
+        for candidate in candidates:
+            try:
+                check_typed_value(item, candidate, f"{context}.{key}")
+                break
+            except TypedValueError as exc:
+                errors.append(str(exc))
+        else:
+            _fail(context, errors[0])
+
+
+def check_typed_value(value: Any, descriptor: Mapping[str, Any], context: str = "value") -> None:
+    """Raise ``TypedValueError`` unless ``value`` matches ``descriptor`` exactly."""
+    kind = descriptor["kind"]
+    if kind == "primitive":
+        _check_primitive(value, descriptor["name"], context)
+    elif kind == "enum":
+        if not isinstance(value, str) or value not in descriptor["allowed"]:
+            _fail(context, "expected one of the enum members")
+    elif kind == "path":
+        if not isinstance(value, str):
+            _fail(context, "expected a path string")
+    elif kind == "optional":
+        if value is not None:
+            check_typed_value(value, descriptor["item"], context)
+    elif kind == "list":
+        if not _is_seq(value):
+            _fail(context, "expected a list")
+        for index, item in enumerate(value):
+            check_typed_value(item, descriptor["item"], f"{context}[{index}]")
+    elif kind == "map":
+        if not isinstance(value, Mapping):
+            _fail(context, "expected a map")
+        for key, item in value.items():
+            check_typed_value(key, descriptor["key"], f"{context}.key")
+            check_typed_value(item, descriptor["value"], f"{context}[{key!r}]")
+    elif kind == "record":
+        if not isinstance(value, Mapping):
+            _fail(context, "expected a record")
+        fields = _variant_fields(descriptor)
+        if set(value) != set(fields):
+            _fail(context, "record fields do not match the declared fields")
+        for name, field_type in fields.items():
+            check_typed_value(value[name], field_type, f"{context}.{name}")
+    elif kind in {"union", "variant_case"}:
+        _check_union(value, descriptor, context)
+    else:
+        _fail(context, f"unsupported type kind `{kind}`")
+
+
+def descriptor_for_path(descriptor: Mapping[str, Any], path: Sequence[Any]) -> Mapping[str, Any]:
+    """Return the descriptor reached by walking ``path`` (keys and list indexes)."""
+    current = descriptor
+    for step in path:
+        while current["kind"] == "optional":
+            current = current["item"]
+        kind = current["kind"]
+        if kind == "list":
+            current = current["item"]
+        elif kind == "map":
+            current = current["value"]
+        elif kind == "record":
+            current = _variant_fields(current)[step]
+        elif kind in {"union", "variant_case"}:
+            merged: dict[str, Any] = {"variant": {"kind": "primitive", "name": "String"}}
+            for fields in _union_variants(current).values():
+                merged.update(fields)
+            current = merged[step]
+        else:
+            raise TypedValueError(f"cannot descend into `{kind}` at {step!r}")
+    return current

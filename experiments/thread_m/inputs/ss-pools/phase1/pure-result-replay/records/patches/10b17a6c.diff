@@ -0,0 +1,227 @@
+"""Value-free completion shells and visit-progress witnesses for derived pure replay.
+
+Dependencies: ``orchestrator.state`` (profile constant, ``StepResult``) only, so
+``StateManager`` and call-frame managers can reuse the state operations here.
+Behavior: under ``derived_pure_replay.v1`` an eligible pure projection settles its
+success as an exact value-free shell; failures and skips stay full durable rows.
+All classification reads only the visit counter, the running cursor and the row.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, replace
+from datetime import datetime, timezone
+from typing import Any, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE, RunState, StepResult
+
+PURE_REPLAY_UNAVAILABLE_CODE = "pure_result_replay_unavailable"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+_PURE_STEP_TYPE = "pure_projection"
+_CURSOR_KEYS = frozenset(
+    {"name", "index", "type", "step_id", "visit_count", "status", "started_at", "last_heartbeat_at"}
+)
+
+
+class PureResultReplayIndexError(ValueError):
+    """Stable fail-closed error for derived pure-result replay."""
+
+    code = PURE_REPLAY_UNAVAILABLE_CODE
+
+    def __init__(self, reason: str, message: str, *, context: Optional[Mapping[str, Any]] = None):
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit eligible pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row directly (never from a result)."""
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _is_exact_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(row, Mapping) and _canonical(dict(row)) == _canonical(
+        build_pure_completion_shell(witness)
+    )
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's shell."""
+    if not _is_exact_shell(row, witness):
+        raise ValueError(
+            f"row is not the exact derived-pure completion shell for {witness.presentation_key!r}"
+        )
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _state_dict(state: Any) -> Mapping[str, Any]:
+    return state.to_dict() if hasattr(state, "to_dict") else state
+
+
+def _cursor_targets(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _cursor_matches(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        set(cursor) == _CURSOR_KEYS
+        and cursor["name"] == witness.presentation_key
+        and cursor["step_id"] == witness.step_id
+        and cursor["type"] == _PURE_STEP_TYPE
+        and cursor["status"] == "running"
+        and _is_int(cursor["index"])
+        and cursor["index"] == witness.step_index
+        and _is_int(cursor["visit_count"])
+        and cursor["visit_count"] == witness.visit_count
+    )
+
+
+def _row_is_failure_or_skip(row: Any, witness: PureReplayVisitWitness) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in ("failed", "skipped")
+        and row.get("name") == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and _is_int(row.get("visit_count"))
+        and row["visit_count"] == witness.visit_count
+    )
+
+
+def classify_pure_replay_progress(state: Any, *, witness: PureReplayVisitWitness) -> str:
+    """Classify visit, cursor and row for one eligible pure node."""
+    data = _state_dict(state)
+    steps = data.get("steps")
+    visits = data.get("step_visits")
+    key = witness.presentation_key
+    row = steps.get(key) if isinstance(steps, Mapping) else None
+    visit = visits.get(key) if isinstance(visits, Mapping) else None
+    cursor = data.get("current_step")
+    related = _cursor_targets(cursor, witness)
+    if visit is None:
+        return UNSTARTED if row is None and not related else PROGRESS_WITNESS_INVALID
+    if not _is_int(visit) or visit != witness.visit_count or witness.visit_count != 1:
+        return PROGRESS_WITNESS_INVALID
+    if related:
+        if row is None and isinstance(cursor, Mapping) and _cursor_matches(cursor, witness):
+            return INTERRUPTED
+        return PROGRESS_WITNESS_INVALID
+    if _is_exact_shell(row, witness):
+        return DERIVED_COMPLETE
+    if _row_is_failure_or_skip(row, witness):
+        return DURABLE_FAILURE_SKIP
+    return PROGRESS_WITNESS_INVALID
+
+
+def _require_progress(state: RunState, witness: PureReplayVisitWitness, expected: str) -> None:
+    observed = classify_pure_replay_progress(state, witness=witness)
+    if observed != expected:
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            f"pure visit for {witness.presentation_key!r} is {observed}, expected {expected}",
+            context={
+                "presentation_key": witness.presentation_key,
+                "step_id": witness.step_id,
+                "observed": observed,
+                "expected": expected,
+            },
+        )
+
+
+def begin_pure_visit(state: RunState, *, step_name: str, step_index: int, step_id: str) -> int:
+    """Publish visit one and its running cursor in one in-memory mutation."""
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    _require_progress(state, witness, UNSTARTED)
+    now = datetime.now(timezone.utc).isoformat()
+    state.step_visits[step_name] = 1
+    state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": _PURE_STEP_TYPE,
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def reuse_interrupted_pure_visit(state: RunState, witness: PureReplayVisitWitness) -> int:
+    """Validate an interrupted visit and return its unchanged visit count."""
+    _require_progress(state, witness, INTERRUPTED)
+    return witness.visit_count
+
+
+def settle_pure_success(state: RunState, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Persist the exact shell and clear the cursor."""
+    _require_progress(state, witness, INTERRUPTED)
+    shell = build_pure_completion_shell(witness)
+    state.steps[witness.presentation_key] = shell
+    state.current_step = None
+    return dict(shell)
+
+
+def settle_pure_failure(state: RunState, witness: PureReplayVisitWitness, result: StepResult) -> None:
+    """Persist a full failed or skipped row (identity filled if absent) and clear the cursor."""
+    _require_progress(state, witness, INTERRUPTED)
+    identity = {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": witness.visit_count,
+    }
+    row = replace(
+        result,
+        **{key: value for key, value in identity.items() if getattr(result, key) is None},
+    )
+    if not _row_is_failure_or_skip(row.to_dict(), witness):
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            "pure failure/skip row does not match its visit witness",
+            context={"presentation_key": witness.presentation_key, "step_id": witness.step_id},
+        )
+    state.steps[witness.presentation_key] = row
+    state.current_step = None

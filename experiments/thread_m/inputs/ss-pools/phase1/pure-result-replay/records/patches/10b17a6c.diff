+
+def test_scope_kind_must_match_the_bundle_scope(tmp_path: Path) -> None:
+    _, bundle = _bundle(tmp_path)
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(bundle, scope_kind="call_frame")
+
+    assert excinfo.value.reason == "dependency_index_invalid"
+    assert excinfo.value.context == {"expected_scope": "call_frame", "actual_scope": "root"}
+
+
+def test_node_id_for_step_id_maps_durable_step_identity(tmp_path: Path) -> None:
+    _, bundle = _bundle(tmp_path)

+"""Profile selector, completion shell and visit-atomicity contracts."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import RunState, StateManager, StepResult
+from orchestrator.workflow.call_frame_state import load_existing_call_frame_read_only
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+WITNESS = PureReplayVisitWitness("pure_step", 3, "root.pure_step", 1)
+EXPECTED_SHELL = {
+    "name": "pure_step",
+    "step_id": "root.pure_step",
+    "visit_count": 1,
+    "status": "completed",
+    "exit_code": 0,
+    "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+    "result_storage": "derived_pure_replay.v1",
+}
+
+
+def _manager(tmp_path: Path, profile: str | None = DERIVED_PURE_REPLAY_PROFILE) -> StateManager:
+    (tmp_path / "wf.orc").write_text("(workflow-lisp)\n", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    manager.initialize("wf.orc", result_persistence_profile=profile)
+    return manager
+
+
+def test_absent_profile_is_omitted_and_round_trips() -> None:
+    payload = {
+        "schema_version": "2.1",
+        "run_id": "r",
+        "workflow_file": "w.orc",
+        "workflow_checksum": "sha256:0",
+        "started_at": "t",
+        "updated_at": "t",
+        "status": "running",
+    }
+    state = RunState.from_dict(payload)
+
+    assert state.result_persistence_profile is None
+    assert "result_persistence_profile" not in state.to_dict()
+
+
+@pytest.mark.parametrize("bad", ["derived_pure_replay.v2", "", "historical"])
+def test_unsupported_profile_fails_closed_at_construction(bad: str) -> None:
+    with pytest.raises(ValueError, match="profile"):
+        RunState("2.1", "r", "w.orc", "c", "t", "t", "running", result_persistence_profile=bad)
+
+
+def test_initialize_rejects_unsupported_profile_before_writing(tmp_path: Path) -> None:
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    (tmp_path / "wf.orc").write_text("x\n", encoding="utf-8")
+
+    with pytest.raises(ValueError, match="profile"):
+        manager.initialize("wf.orc", result_persistence_profile="nope")
+
+    assert not manager.state_file.exists()
+
+
+def test_profile_is_written_with_the_first_state_write(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+
+    assert json.loads(manager.state_file.read_text())["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+
+
+def test_load_failure_leaves_state_file_unchanged(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    payload = json.loads(manager.state_file.read_text())
+    payload["result_persistence_profile"] = "bogus"
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+
+    with pytest.raises(ValueError, match="profile"):
+        StateManager(workspace=tmp_path, run_id="run").load()
+
+    assert manager.state_file.read_bytes() == before
+
+
+def test_ordinary_load_never_backfills_the_profile(tmp_path: Path) -> None:
+    manager = _manager(tmp_path, profile=None)
+
+    loaded = StateManager(workspace=tmp_path, run_id="run").load()
+
+    assert loaded.result_persistence_profile is None
+    assert "result_persistence_profile" not in json.loads(manager.state_file.read_text())
+
+
+@pytest.mark.parametrize("frame", [{}, {"state": "nope"}, {"state": None}])
+def test_malformed_existing_frame_is_rejected(frame: dict) -> None:
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        load_existing_call_frame_read_only(frame)
+
+
+def test_read_only_frame_load_returns_a_detached_copy(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    frame_state = manager.state.to_dict()
+
+    loaded = load_existing_call_frame_read_only({"state": frame_state})
+    loaded.steps["x"] = {"status": "completed"}
+
+    assert "x" not in frame_state["steps"]
+    assert loaded.result_persistence_profile == DERIVED_PURE_REPLAY_PROFILE
+    assert not (tmp_path / "call_frames").exists()
+
+
+def test_shell_is_exactly_the_value_free_completion_row() -> None:
+    assert build_pure_completion_shell(WITNESS) == EXPECTED_SHELL
+    validate_pure_completion_shell(dict(EXPECTED_SHELL), witness=WITNESS)
+
+
+@pytest.mark.parametrize("extra", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_rejects_extra_keys(extra: str) -> None:
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell({**EXPECTED_SHELL, extra: 1}, witness=WITNESS)
+
+
+def test_shell_rejects_missing_keys_wrong_values_and_loose_outcome() -> None:
+    for broken in (
+        {k: v for k, v in EXPECTED_SHELL.items() if k != "exit_code"},
+        {**EXPECTED_SHELL, "visit_count": 2},
+        {**EXPECTED_SHELL, "exit_code": False},
+        {**EXPECTED_SHELL, "outcome": {**EXPECTED_SHELL["outcome"], "extra": 1}},
+    ):
+        with pytest.raises(ValueError):
+            validate_pure_completion_shell(broken, witness=WITNESS)
+
+
+def test_visit_lifecycle_is_atomic_and_settles_value_free(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+
+    visit = manager.begin_eligible_pure_visit(step_name="pure_step", step_index=3, step_id="root.pure_step")
+    on_disk = json.loads(manager.state_file.read_text())
+    assert visit == 1
+    assert on_disk["step_visits"] == {"pure_step": 1}
+    assert set(on_disk["current_step"]) == {
+        "name", "index", "type", "step_id", "visit_count", "status", "started_at", "last_heartbeat_at",
+    }
+    assert classify_pure_replay_progress(manager.state, witness=WITNESS) == "interrupted"
+    assert manager.reuse_interrupted_eligible_pure_visit(WITNESS) == 1
+
+    shell = manager.settle_eligible_pure_success(WITNESS)
+
+    assert shell == EXPECTED_SHELL
+    on_disk = json.loads(manager.state_file.read_text())
+    assert on_disk["steps"]["pure_step"] == EXPECTED_SHELL
+    assert "current_step" not in on_disk
+    assert classify_pure_replay_progress(manager.state, witness=WITNESS) == "derived_complete"
+
+
+def test_failure_settlement_keeps_the_full_row(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.begin_eligible_pure_visit(step_name="pure_step", step_index=3, step_id="root.pure_step")
+
+    manager.settle_eligible_pure_failure(
+        WITNESS,
+        StepResult(status="failed", name="pure_step", step_id="root.pure_step", visit_count=1, exit_code=2,
+                   error={"type": "boom"}),
+    )
+
+    assert classify_pure_replay_progress(manager.state, witness=WITNESS) == "durable_failure_skip"
+    assert json.loads(manager.state_file.read_text())["steps"]["pure_step"]["error"] == {"type": "boom"}
+
+
+def test_a_second_begin_is_rejected_without_a_write(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.begin_eligible_pure_visit(step_name="pure_step", step_index=3, step_id="root.pure_step")
+    before = manager.state_file.read_bytes()
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        manager.begin_eligible_pure_visit(step_name="pure_step", step_index=3, step_id="root.pure_step")
+
+    assert excinfo.value.reason == "progress_witness_invalid"
+    assert manager.state_file.read_bytes() == before
+
+
+def _state(**overrides) -> dict:
+    cursor = {
+        "name": "pure_step", "index": 3, "type": "pure_projection", "step_id": "root.pure_step",
+        "visit_count": 1, "status": "running", "started_at": "t", "last_heartbeat_at": "t",
+    }
+    base = {"step_visits": {"pure_step": 1}, "current_step": cursor, "steps": {}}
+    base.update(overrides)
+    return base
+
+
+@pytest.mark.parametrize(
+    ("state", "expected"),
+    [
+        ({"step_visits": {}, "steps": {}}, "unstarted"),
+        ({"step_visits": {}, "steps": {}, "current_step": {"name": "other", "step_id": "other"}}, "unstarted"),
+        (_state(), "interrupted"),
+        (_state(current_step=None, steps={"pure_step": EXPECTED_SHELL}), "derived_complete"),
+        (
+            _state(current_step=None, steps={"pure_step": {
+                "name": "pure_step", "step_id": "root.pure_step", "visit_count": 1, "status": "skipped"}}),
+            "durable_failure_skip",
+        ),
+        (_state(current_step=None), "progress_witness_invalid"),
+        (_state(step_visits={}, current_step=None, steps={"pure_step": EXPECTED_SHELL}), "progress_witness_invalid"),
+        (_state(step_visits={"pure_step": 2}), "progress_witness_invalid"),
+        (_state(steps={"pure_step": EXPECTED_SHELL}), "progress_witness_invalid"),
+        (
+            _state(current_step=None, steps={"pure_step": {**EXPECTED_SHELL, "artifacts": {"a": 1}}}),
+            "progress_witness_invalid",
+        ),
+        (
+            _state(current_step=None, steps={"pure_step": {"name": "pure_step", "status": "running"}}),
+            "progress_witness_invalid",
+        ),
+    ],
+)
+def test_progress_classification(state: dict, expected: str) -> None:
+    assert classify_pure_replay_progress(state, witness=WITNESS) == expected

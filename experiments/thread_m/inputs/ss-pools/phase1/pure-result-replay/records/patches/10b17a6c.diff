+    assert resumed["workflow_outputs"]["return__label"] == "friendly!"
+    assert decision["restore_decision"] == "VALIDATED_FRAME_ENTRY_REPLAY"
+    assert decision["checkpoint_id"] is None
+    assert decision["selection_reason"] == "validated_frame_entry_replay"
+
+
+def test_zero_record_decision_fails_closed_without_validated_leaves(tmp_path: Path) -> None:
+    from orchestrator.workflow_lisp.lexical_checkpoint_default_resume import (
+        determine_runtime_default_resume_decision,
+    )
+
+    bundle, _ = _source_run(
+        tmp_path, ZERO_RECORD_SOURCE, "zero_rec",
+        {"summary_target": "artifacts/work/summary.json", "name": "bob"}, fail_on_call=1,
+    )
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    state = manager.load().to_dict()
+    restart = bundle.runtime_plan.ordered_node_ids[1]
+
+    def decide(state_dict: dict) -> dict:
+        return determine_runtime_default_resume_decision(
+            state=state_dict,
+            runtime_plan=bundle.runtime_plan,
+            restart_node_id=restart,
+            state_manager=manager,
+            loaded_workflow=bundle,
+            executable_workflow=bundle.ir,
+        )
+
+    assert decide(state)["restore_decision"] == "VALIDATED_FRAME_ENTRY_REPLAY"
+
+    state["bound_inputs"].pop("name")
+    broken = decide(state)
+
+    assert broken["mode"] == "FAIL_CLOSED"
+    assert broken["diagnostics"] == ["lexical_default_resume_prior_boundary_not_restorable"]
+
+
+def test_restorable_nearest_durable_point_is_the_validated_prior_boundary(tmp_path: Path) -> None:

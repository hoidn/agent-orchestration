+"""End-to-end derived pure replay: clean runs, resume, fail-closed surfaces."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    MULTIPLE_VISIT_REGION,
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow.resume_planner import ResumePlanner
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+FIXTURE = Path("tests/fixtures/workflow_lisp/valid/lexical_checkpoint_restore_regions.orc")
+SUMMARY_STEP = "lexical_checkpoint_restore_regions::orchestrate__summary_status"
+MATCH_STEP = "lexical_checkpoint_restore_regions::orchestrate__selected_label__match_decision"
+INPUTS = {"report_path": "artifacts/work/report.md", "summary_target": "artifacts/work/summary.json"}
+
+
+def _bundle(tmp_path: Path):
+    source = tmp_path / FIXTURE.name
+    source.write_text(FIXTURE.read_text(encoding="utf-8"), encoding="utf-8")
+    result = compile_stage3_entrypoint(source, source_roots=(tmp_path,), validate_shared=True, workspace_root=tmp_path)
+    bundle = next(b for n, b in result.validated_bundles_by_name.items() if n.endswith("orchestrate"))
+    work = tmp_path / "artifacts" / "work"
+    work.mkdir(parents=True)
+    (work / "report.md").write_text("report\n", encoding="utf-8")
+    (work / "summary.json").write_text("{}\n", encoding="utf-8")
+    return source, bundle
+
+
+def _manager(tmp_path: Path, source: Path, bundle, profile: str | None) -> StateManager:
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    manager.initialize(
+        str(source),
+        context=bundle_context_dict(bundle),
+        bound_inputs=dict(INPUTS),
+        result_persistence_profile=profile,
+    )
+    return manager
+
+
+def _interrupted_run(tmp_path: Path, profile: str | None = DERIVED_PURE_REPLAY_PROFILE):
+    """Run until the materialize-view effect fails once; return what a resume needs."""
+    source, bundle = _bundle(tmp_path)
+    manager = _manager(tmp_path, source, bundle, profile)
+    real = WorkflowExecutor._execute_materialize_view.__globals__["render_view"]
+    calls = {"count": 0}
+
+    def flaky(*args, **kwargs):
+        calls["count"] += 1
+        if calls["count"] == 1:
+            raise RuntimeError("interrupt")
+        return real(*args, **kwargs)
+
+    with patch("orchestrator.workflow.executor.render_view", side_effect=flaky):
+        first = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    assert first["status"] == "failed"
+    return source, bundle, manager, flaky, calls
+
+
+def _resume(tmp_path: Path, bundle, flaky) -> dict:
+    manager = StateManager(workspace=tmp_path, run_id="run")
+    manager.load()
+    with patch("orchestrator.workflow.executor.render_view", side_effect=flaky):
+        return WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True)
+
+
+def _persisted(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def test_clean_profiled_run_is_value_free_and_outputs_match_historical(tmp_path: Path) -> None:
+    historical_root = tmp_path / "historical"
+    historical_root.mkdir()
+    _, _, historical, flaky, _ = _interrupted_run(historical_root, profile=None)
+    historical_done = _resume(historical_root, _bundle_for(historical_root), flaky)
+
+    profiled_root = tmp_path / "profiled"
+    profiled_root.mkdir()
+    _, bundle, manager, flaky, _ = _interrupted_run(profiled_root)
+    profiled_done = _resume(profiled_root, bundle, flaky)
+
+    assert profiled_done["status"] == historical_done["status"] == "completed"
+    assert profiled_done["workflow_outputs"] == historical_done["workflow_outputs"]
+    row = _persisted(manager)["steps"][SUMMARY_STEP]
+    assert row["result_storage"] == DERIVED_PURE_REPLAY_PROFILE
+    assert "artifacts" not in row
+    assert "result_storage" not in _persisted(historical)["steps"][SUMMARY_STEP]
+
+
+def _bundle_for(root: Path):
+    return compile_stage3_entrypoint(
+        root / FIXTURE.name, source_roots=(root,), validate_shared=True, workspace_root=root
+    ).validated_bundles_by_name["lexical_checkpoint_restore_regions::orchestrate"]
+
+
+def test_profiled_run_writes_no_pure_bundle_and_no_pure_checkpoint_records(tmp_path: Path) -> None:
+    _, bundle, manager, flaky, _ = _interrupted_run(tmp_path)
+    _resume(tmp_path, bundle, flaky)
+
+    index = derive_pure_result_replay_index(bundle)
+    eligible_step_ids = {node.step_id for node in index.nodes.values()}
+    effect_kinds = set()
+    for record_file in (tmp_path / ".orchestrate").rglob("*.json"):
+        payload = json.loads(record_file.read_text(encoding="utf-8"))
+        if isinstance(payload, dict) and "pending_effect_policy" in payload:
+            effect_kinds.add(payload["pending_effect_policy"]["effect_kind"])
+            assert payload["pending_effect_policy"]["effect_kind"] != "pure_projection"
+            for binding in (payload.get("restore_payload") or {}).get("bindings", ()):
+                assert binding.get("source_step_id") not in eligible_step_ids
+    assert effect_kinds, "effect-boundary checkpoint records are still written"
+    assert not _persisted(manager)["private_artifact_versions"]
+
+
+def test_resume_after_interruption_reproduces_outputs_and_skips_committed_effects(tmp_path: Path) -> None:
+    _, bundle, _, flaky, calls = _interrupted_run(tmp_path)
+
+    resumed = _resume(tmp_path, bundle, flaky)
+
+    assert resumed["status"] == "completed"
+    assert resumed["workflow_outputs"]["return__selected_label"] == "ready"
+    assert resumed["workflow_outputs"]["return__loop_count"] == 1
+    assert calls["count"] == 2  # only the interrupted effect re-ran
+
+
+def test_resume_determines_the_restart_boundary_once(tmp_path: Path) -> None:
+    _, bundle, _, flaky, _ = _interrupted_run(tmp_path)
+    real = ResumePlanner.determine_restart_node_id
+    seen: list[str | None] = []
+
+    def counting(self, *args, **kwargs):
+        seen.append(real(self, *args, **kwargs))
+        return seen[-1]
+
+    with patch.object(ResumePlanner, "determine_restart_node_id", counting):
+        _resume(tmp_path, bundle, flaky)
+
+    assert len(seen) == 1
+
+
+@pytest.mark.parametrize(
+    ("mutate", "reason"),
+    [
+        (lambda steps: steps[MATCH_STEP]["artifacts"].pop("__result__"), "durable_input_missing"),
+        (lambda steps: steps[MATCH_STEP]["artifacts"].update({"__result__": 7}), "durable_input_invalid"),
+    ],
+)
+def test_resume_fails_closed_on_broken_durable_leaves(tmp_path: Path, mutate, reason: str) -> None:
+    _, bundle, manager, flaky, calls = _interrupted_run(tmp_path)
+    payload = _persisted(manager)
+    mutate(payload["steps"])
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+
+    resumed = _resume(tmp_path, bundle, flaky)
+
+    assert resumed["status"] == "failed"
+    assert resumed["error"]["type"] == "pure_result_replay_unavailable"
+    assert resumed["error"]["context"]["reason"] == reason
+    assert calls["count"] == 1  # no effect was dispatched
+
+
+def test_visit_two_shell_is_rejected_before_the_prologue(tmp_path: Path) -> None:
+    _, bundle, manager, flaky, _ = _interrupted_run(tmp_path)
+    payload = _persisted(manager)
+    payload["step_visits"][SUMMARY_STEP] = 2
+    payload["steps"][SUMMARY_STEP]["visit_count"] = 2
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+
+    resumed = _resume(tmp_path, bundle, flaky)
+
+    assert resumed["error"]["type"] == "pure_result_replay_unavailable"
+    assert resumed["error"]["context"]["reason"] == "progress_witness_invalid"
+
+
+def test_persisted_value_row_for_an_eligible_node_is_a_profile_conflict(tmp_path: Path) -> None:
+    _, bundle, manager, flaky, _ = _interrupted_run(tmp_path)
+    payload = _persisted(manager)
+    payload["steps"][SUMMARY_STEP] = {
+        "name": SUMMARY_STEP, "status": "completed", "exit_code": 0, "artifacts": {"return": "x"},
+    }
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        _resume(tmp_path, bundle, flaky)
+
+    assert excinfo.value.reason == "profile_conflict"
+    assert excinfo.value.context["surface"] == "steps"
+    assert manager.state_file.read_bytes() == before
+
+
+def test_persisted_pure_bundle_is_a_profile_conflict(tmp_path: Path) -> None:
+    _, bundle, manager, flaky, _ = _interrupted_run(tmp_path)
+    bundle_input = next(k for k in _persisted(manager)["bound_inputs"] if "summary_status" in k)
+    bundle_path = tmp_path / _persisted(manager)["bound_inputs"][bundle_input]
+    bundle_path.parent.mkdir(parents=True, exist_ok=True)
+    bundle_path.write_text("{}", encoding="utf-8")
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        _resume(tmp_path, bundle, flaky)

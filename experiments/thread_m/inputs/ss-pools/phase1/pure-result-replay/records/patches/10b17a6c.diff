+def test_fresh_workflow_lisp_child_frame_selects_the_profile_from_callee_provenance(tmp_path: Path) -> None:
+    source = tmp_path / "child_demo.orc"
+    source.write_text(
+        """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")

+    WorkflowExecutor(bundle, tmp_path, manager).execute()
+
+    persisted = _persisted(manager)
+    assert "result_persistence_profile" not in persisted  # the historical root is untouched
+    (frame,) = persisted["call_frames"].values()
+    assert frame["state"]["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    (row,) = frame["state"]["steps"].values()
+    assert row["result_storage"] == DERIVED_PURE_REPLAY_PROFILE

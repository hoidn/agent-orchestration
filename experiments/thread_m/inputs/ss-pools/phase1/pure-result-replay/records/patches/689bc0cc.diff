+"""Constants and the fail-closed error shared by the derived pure-replay modules."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any, Optional
+
+from .executable_ir import ExecutableNodeKind
+
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+NOT_TOP_LEVEL_EXECUTION = "not_top_level_execution"
+LINEAGE_BEARING = "lineage_bearing"
+
+PROGRESS_UNSTARTED = "unstarted"
+PROGRESS_INTERRUPTED = "interrupted"
+PROGRESS_DERIVED_COMPLETE = "derived_complete"
+PROGRESS_DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed replay diagnostic carrying a stable reason and context."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+LOOP_KINDS = frozenset({"for_each", "repeat_until_frame"})
+PURE_KIND = ExecutableNodeKind.PURE_PROJECTION.value

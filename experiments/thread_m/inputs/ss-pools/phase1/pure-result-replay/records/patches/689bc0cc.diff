+@pytest.mark.parametrize(
+    ("failure", "reason", "cause"),
+    [
+        ({"type": "materialize_ref_unresolved"}, "binding_unresolved", "materialize_ref_unresolved"),
+        ({"type": "pure_expr_overflow"}, "evaluation_failed", "pure_evaluation_failed"),
+        (
+            {"type": "contract_violation", "context": {"reason": "pure_projection_contract_invalid"}},
+            "output_contract_invalid",
+            "pure_projection_contract_invalid",
+        ),
+    ],
+)
+def test_replay_failures_map_to_typed_reasons(flow, failure, reason, cause) -> None:
+    workspace, source, bundle = flow
+    WorkflowExecutor(bundle, workspace, _manager(workspace, source, f"fail-{reason}")).execute()
+    persisted = _persisted(workspace, f"fail-{reason}")
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root(str(source)))
+    (node_id,) = runtime.index.nodes
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.replay_node(
+            node_id, state=persisted,
+            evaluate_node=lambda node, overlay: {"status": "failed", "error": failure},
+        )
+
+    assert excinfo.value.reason == reason
+    assert excinfo.value.context["cause"]["type"] == cause
+

index 0000000..11ce9ce
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_runtime.py
@@ -0,0 +1,502 @@
+"""In-memory replay of derived pure results for the ``derived_pure_replay.v1`` profile.
+
+``PureReplayRuntime`` re-derives the values of eligible, completed pure nodes from
+durable inputs. It validates leaves, evaluates through a caller-supplied
+callable, and keeps reconstructed values only in a process-local cache and an
+overlay copy of the state. It never dispatches an effect, increments a visit,
+settles a result or writes durable state.
+
+Dependencies: ``pure_result_replay`` (index, shell and progress contract),
+``ResumeScopePath`` (scope identity), the lexical checkpoint storage helpers
+(read-only, lazily imported) for the persisted-surface audit.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import inspect
+import json
+from collections.abc import Callable, Iterable, Mapping
+from copy import deepcopy
+from pathlib import Path
+from typing import Any, Optional
+
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    PROFILE_CONFLICT,
+    PROGRESS_DERIVED_COMPLETE,
+    PROGRESS_WITNESS_INVALID,
+    PureBinding,
+    PureReplayNode,
+    PureReplayVisitWitness,
+    PureResultReplayIndex,
+    PureResultReplayIndexError,
+    PureStateAddress,
+    REACHABILITY_AMBIGUOUS,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    derive_pure_result_replay_index,
+    parse_pure_state_address,
+    validate_pure_completion_shell,
+)
+from .resume_projection_integrity import ResumeScopePath
+
+BINDING_UNRESOLVED = "binding_unresolved"
+EVALUATION_FAILED = "evaluation_failed"
+OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+DURABLE_INPUT_MISSING = "durable_input_missing"
+DURABLE_INPUT_INVALID = "durable_input_invalid"
+
+_OUTCOME_FIELD_TYPES = {"status": str, "phase": str, "class": str, "retryable": bool}
+
+
+def _error(reason: str, message: str, node: Optional[PureReplayNode] = None, **context: Any) -> PureResultReplayIndexError:
+    if node is not None:
+        context.setdefault("node_id", node.node_id)
+        context.setdefault("step_id", node.step_id)
+    return PureResultReplayIndexError(reason, message, context={"reason": reason, **context})
+
+
+def _strings(value: Any, depth: int = 0) -> Iterable[str]:
+    """Every string reachable through mappings, sequences and dataclasses."""
+    if depth > 24:
+        return
+    if isinstance(value, str):
+        yield value
+    elif isinstance(value, Mapping):
+        for key, item in value.items():
+            yield from _strings(key, depth + 1)
+            yield from _strings(item, depth + 1)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for item in value:
+            yield from _strings(item, depth + 1)
+    elif dataclasses.is_dataclass(value) and not isinstance(value, type):
+        for fld in dataclasses.fields(value):
+            yield from _strings(getattr(value, fld.name, None), depth + 1)
+
+
+def _call_evaluator(evaluate_node: Callable[..., Any], node: PureReplayNode, overlay: dict[str, Any]) -> Any:
+    """Call ``evaluate_node(node, overlay)``; evaluators that take only the node get just that."""
+    try:
+        inspect.signature(evaluate_node).bind(node, overlay)
+    except TypeError:
+        return evaluate_node(node)
+    except ValueError:
+        pass  # builtins without introspectable signatures take the full form
+    return evaluate_node(node, overlay)
+
+
+class _NodeRef(str):
+    """A node id that also exposes the node's attributes (for injected path resolvers)."""
+
+    def __new__(cls, node: PureReplayNode) -> "_NodeRef":
+        ref = super().__new__(cls, node.node_id)
+        ref._node = node
+        return ref
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._node, name)
+
+
+class PureReplayRuntime:
+    """Replay eligible pure nodes of one workflow scope from durable inputs."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        if not isinstance(scope_path, ResumeScopePath):
+            raise TypeError("ResumeScopePath required")
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(bundle, scope_kind="root")
+        self._by_step_id = {node.step_id: nid for nid, node in self.index.nodes.items()}
+        self._by_key = {node.presentation_key: nid for nid, node in self.index.nodes.items()}
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # -- identity -----------------------------------------------------------------
+
+    def _node(self, node_id: str) -> PureReplayNode:
+        node = self.index.nodes.get(node_id)
+        if node is None:
+            raise _error(DEPENDENCY_INDEX_INVALID, "node is not replay-eligible", node_id=node_id)
+        return node
+
+    def node_id_for_step_id(self, step_id: Any) -> Optional[str]:
+        """The eligible node a durable step id names; raw node ids do not match."""
+        return self._by_step_id.get(step_id) if isinstance(step_id, str) else None
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        plan_node = self.bundle.runtime_plan.nodes[node_id]
+        return PureReplayVisitWitness(
+            node.presentation_key, plan_node.execution_index, node.step_id, visit_count
+        )
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key, 1) if isinstance(visits, Mapping) else 1
+        if type(visit) is not int:
+            raise _error(PROGRESS_WITNESS_INVALID, "visit count is malformed", node)
+        return self.witness(node_id, visit_count=visit)
+
+    def progress(self, node_id: str, state: Mapping[str, Any]) -> str:
+        return classify_pure_replay_progress(state, witness=self.witness_from_state(node_id, state))
+
+    def audit_progress(self, state: Mapping[str, Any]) -> dict[str, str]:
+        """Classify every eligible node; raises ``progress_witness_invalid``."""
+        return {nid: self.progress(nid, state) for nid in self.index.nodes}
+
+    # -- cache --------------------------------------------------------------------
+
+    def _validate_transient_row(self, node: PureReplayNode, artifacts: Any) -> dict[str, Any]:
+        if not isinstance(artifacts, Mapping):
+            raise _error(DEPENDENCY_INDEX_INVALID, "pure result row must be a mapping", node)
+        contracts = node.output_contracts
+        expected = set(contracts)
+        discriminant = next(
+            (
+                name
+                for name, c in contracts.items()
+                if (c.get("projection") or {}).get("field_role") == "discriminant"
+            ),
+            None,
+        )
+        if discriminant is not None:
+            variant = artifacts.get(discriminant)
+            expected = {
+                name
+                for name, c in contracts.items()
+                if (c.get("projection") or {}).get("field_role") != "variant"
+                or variant in ((c.get("projection") or {}).get("active_variants") or ())
+            }
+        missing = sorted(expected - set(artifacts))
+        extra = sorted(set(artifacts) - expected)
+        if missing or extra:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                "pure result row members do not match the active variant",
+                node,
+                missing=missing,
+                extra=extra,
+            )
+        return dict(artifacts)
+
+    def record_full_result(
+        self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]
+    ) -> None:
+        """Hold one active executor's validated full result in the process-local cache."""
+        node = self._node(node_id)
+        if witness != self.witness(node_id):
+            raise _error(PROGRESS_WITNESS_INVALID, "result witness does not match the node", node)
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise _error(DEPENDENCY_INDEX_INVALID, "only completed results are cached", node)
+        row = self._validate_transient_row(node, result.get("artifacts"))
+        self._cache[node_id] = (witness, deepcopy(row))
+
+    def _cache_hit(self, node_id: str, state: Mapping[str, Any]) -> Optional[dict[str, Any]]:
+        """Return the cached row after revalidating the exact current state authority."""
+        entry = self._cache.get(node_id)
+        if entry is None:
+            return None
+        node = self._node(node_id)
+        witness, row = entry
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        if type(visit) is not int or visit != 1 or witness != self.witness(node_id):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached result lacks its exact visit", node)
+        steps = state.get("steps")
+        durable = steps.get(node.presentation_key) if isinstance(steps, Mapping) else None
+        if not isinstance(durable, Mapping):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached result lacks its durable row", node)
+        cursor = state.get("current_step")
+        if isinstance(cursor, Mapping) and (
+            cursor.get("name") == node.presentation_key or cursor.get("step_id") == node.step_id
+        ):
+            raise _error(PROGRESS_WITNESS_INVALID, "cursor targets a cached pure node", node)
+        try:
+            validate_pure_completion_shell(durable, witness=witness)
+        except ValueError:
+            if not (
+                durable.get("status") == "completed"
+                and durable.get("name", node.presentation_key) == node.presentation_key
+                and durable.get("step_id") == node.step_id
+                and durable.get("visit_count") == 1
+                and durable.get("artifacts") == row
+            ):
+                raise _error(PROGRESS_WITNESS_INVALID, "cached result does not match its row", node)
+        return row
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """A copy of ``state`` whose cached pure rows carry their reconstructed values."""
+        overlay = dict(state)
+        steps = dict(state.get("steps") or {})
+        for node_id in self._cache:
+            row = self._cache_hit(node_id, state)
+            node = self._node(node_id)
+            full = build_pure_completion_shell(self.witness(node_id))
+            full["artifacts"] = deepcopy(row)
+            steps[node.presentation_key] = full
+        overlay["steps"] = steps
+        return overlay
+
+    def durable_view(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """``state`` with overlay values stripped, i.e. what is durable for eligible rows."""
+        view = dict(state)
+        steps = dict(state.get("steps") or {})
+        for node in self.index.nodes.values():
+            row = steps.get(node.presentation_key)
+            if isinstance(row, Mapping) and "artifacts" in row:
+                steps[node.presentation_key] = {k: v for k, v in row.items() if k != "artifacts"}
+        view["steps"] = steps
+        return view
+
+    # -- addresses ----------------------------------------------------------------
+
+    def resolve_state_address(self, address: Any, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if not isinstance(address, PureStateAddress):
+            address = parse_pure_state_address(address, self.index.step_keys)
+        if address.kind == "input":
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.name in inputs:
+                return True, inputs[address.name]
+            return False, None
+        node_id = self._by_key.get(address.name)
+        if node_id is not None and address.kind == "artifact":
+            row = self._cache_hit(node_id, state)
+            if row is None or address.member not in row:
+                return False, None
+            return True, row[address.member]
+        steps = state.get("steps")
+        durable = steps.get(address.name) if isinstance(steps, Mapping) else None
+        if not isinstance(durable, Mapping):
+            return False, None
+        if address.kind == "exit_code":
+            return "exit_code" in durable, durable.get("exit_code")
+        container = {"artifact": "artifacts", "snapshot": "snapshots", "outcome": "outcome"}[address.kind]
+        values = durable.get(container)
+        if isinstance(values, Mapping) and address.member in values:
+            return True, values[address.member]
+        return False, None
+
+    def value_for_state_address(self, address: Any, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _error(BINDING_UNRESOLVED, "state address is unavailable", address=str(address))
+        return value
+
+    # -- leaves -------------------------------------------------------------------
+
+    def _audit_binding(self, node: PureReplayNode, binding: PureBinding, state: Mapping[str, Any]) -> None:
+        address = binding.address
+        if address.kind != "input" and address.name in self._by_key:
+            return  # derived from its own producer, replayed first
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            if binding.in_union and address.kind == "artifact":
+                return
+            raise _error(DURABLE_INPUT_MISSING, "durable dependency leaf is missing", node, address=str(address))
+        valid = True
+        if address.kind == "exit_code":
+            valid = type(value) is int
+        elif address.kind == "outcome":
+            expected = _OUTCOME_FIELD_TYPES.get(address.member or "")
+            valid = expected is not None and type(value) is expected
+        elif address.kind in {"input", "artifact"} and binding.descriptor is not None:
+            try:
+                _coerce_value(value, binding.descriptor, context="leaf")
+            except PureExprEvaluationError:
+                valid = False
+        if not valid:
+            raise _error(DURABLE_INPUT_INVALID, "durable dependency leaf is invalid", node, address=str(address))
+
+    def _audit_node_leaves(self, node_id: str, state: Mapping[str, Any]) -> None:
+        node = self._node(node_id)
+        for binding in node.bindings:
+            self._audit_binding(node, binding, state)
+
+    # -- boundary -----------------------------------------------------------------
+
+    def _remaining_node_ids(self, restart_node_id: Optional[str]) -> set[str]:
+        nodes = self.bundle.runtime_plan.nodes
+        if restart_node_id is None:
+            return set()
+        restart = nodes.get(restart_node_id)
+        ordered = self.bundle.runtime_plan.ordered_node_ids
+        if restart is None or ordered.count(restart_node_id) != 1 or restart.execution_index is None:
+            raise _error(REACHABILITY_AMBIGUOUS, "restart node is not a unique top-level node", restart_node_id=restart_node_id)
+        before = {
+            nid
+            for nid, plan_node in nodes.items()
+            if plan_node.execution_index is not None and plan_node.execution_index < restart.execution_index
+        }
+        for nid in tuple(before):
+            before.update(nodes[nid].nested_body_node_ids)
+        return set(nodes) - before
+
+    def _seed_addresses(self, restart_node_id: Optional[str]) -> list[PureStateAddress]:
+        remaining = self._remaining_node_ids(restart_node_id)
+        ir_nodes = self.bundle.ir.nodes
+        sources: list[Any] = [self.bundle.ir.outputs]
+        sources.extend(ir_nodes[nid] for nid in remaining if nid in ir_nodes)
+        texts = set(_strings(sources))
+        seeds = []
+        for node in self.index.nodes.values():
+            key = node.presentation_key
+            marker = f"steps.{key}"
+            if (
+                {key, node.node_id, node.step_id} & texts
+                or any(marker in text for text in texts)
+            ):
+                seeds.append(PureStateAddress("artifact", key))
+        return seeds
+
+    def required_node_ids_for_boundary(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        """Completed pure nodes whose values the remaining program needs, in dependency order."""
+        progress = self.audit_progress(state)
+        reached = {nid for nid, status in progress.items() if status == PROGRESS_DERIVED_COMPLETE}
+        return self.index.required_pure_node_ids(
+            self._seed_addresses(restart_node_id), reached_node_ids=reached
+        )
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        """Validate the durable leaves of every node the boundary needs."""
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        audited = list(required)
+        if restart_node_id in self.index.nodes and restart_node_id not in audited:
+            audited.append(restart_node_id)
+        for node_id in audited:
+            self._audit_node_leaves(node_id, state)
+        return tuple(audited)
+
+    # -- replay -------------------------------------------------------------------
+
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Any],
+    ) -> dict[str, Any]:
+        """Re-derive one completed node's values with ``evaluate_node`` over the overlay."""
+        node = self._node(node_id)
+        if self.progress(node_id, state) != PROGRESS_DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "only a derived-complete node can replay", node)
+        cached = self._cache_hit(node_id, state)
+        if cached is not None:
+            return deepcopy(cached)
+        self._audit_node_leaves(node_id, state)
+        try:
+            result = _call_evaluator(evaluate_node, node, self.overlay_active_state(state))
+        except PureResultReplayIndexError:
+            raise
+        except Exception as exc:
+            raise _error(
+                EVALUATION_FAILED, "pure replay evaluation raised", node,
+                cause={"type": "pure_evaluation_failed", "error": str(exc)},
+            ) from exc
+        artifacts = self._artifacts_from_result(node, result)
+        self._cache[node_id] = (self.witness(node_id), self._validate_transient_row(node, artifacts))
+        return deepcopy(self._cache[node_id][1])
+
+    def _artifacts_from_result(self, node: PureReplayNode, result: Any) -> Any:
+        if not isinstance(result, Mapping) or "status" not in result:
+            return result
+        if result.get("status") == "completed":
+            return result.get("artifacts")
+        error = result.get("error") if isinstance(result.get("error"), Mapping) else {}
+        error_type = error.get("type")
+        context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+        if error_type == "materialize_ref_unresolved":
+            reason, cause = BINDING_UNRESOLVED, "materialize_ref_unresolved"
+        elif context.get("reason") == "pure_projection_contract_invalid":
+            reason, cause = OUTPUT_CONTRACT_INVALID, "pure_projection_contract_invalid"
+        else:
+            reason, cause = EVALUATION_FAILED, "pure_evaluation_failed"
+        raise _error(
+            reason, "pure replay could not re-derive the value", node,
+            cause={"type": cause, "error_type": error_type},
+        )
+
+    def replay_required(
+        self,
+        restart_node_id: Optional[str],
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Any],
+    ) -> tuple[str, ...]:
+        """Audit, then replay every node the boundary needs; no writes, no effects."""
+        self.audit_boundary_leaves(restart_node_id, state=state)
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        for node_id in required:
+            self.replay_node(node_id, state=state, evaluate_node=evaluate_node)
+        return required
+
+    # -- persisted-surface audit --------------------------------------------------
+
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Mapping[str, Any],
+        state_manager: Any,
+        resolve_bundle_path: Callable[[PureReplayNode], Optional[Path]],
+    ) -> None:
+        """Reject any persisted value, bundle, lineage or checkpoint surface of an eligible node."""
+        steps = state.get("steps") if isinstance(state.get("steps"), Mapping) else {}
+        lineage = state.get("private_artifact_versions")
+        lineage = lineage if isinstance(lineage, Mapping) else {}
+        for node in self.index.nodes.values():
+            row = steps.get(node.presentation_key)
+            if (
+                isinstance(row, Mapping)
+                and row.get("status") == "completed"
+                and set(row) - set(build_pure_completion_shell(self.witness(node.node_id)))
+            ):
+                raise self._conflict("steps", node)  # a value-bearing row
+            path = resolve_bundle_path(_NodeRef(node))
+            if path is not None and (Path(state_manager.workspace) / path).exists():
+                raise self._conflict("pure_bundle", node, path=str(path))
+            for versions in lineage.values():
+                for entry in versions if isinstance(versions, list) else ():
+                    if isinstance(entry, Mapping) and (
+                        entry.get("producer") in {node.step_id, node.presentation_key}
+                        or entry.get("producer_name") == node.presentation_key
+                    ):
+                        raise self._conflict("private_artifact_versions", node)
+        self._audit_checkpoint_surfaces(state_manager)
+
+    def _conflict(self, surface: str, node: PureReplayNode, **context: Any) -> PureResultReplayIndexError:
+        return _error(PROFILE_CONFLICT, "persisted surface contradicts the derived pure profile", node, surface=surface, **context)
+
+    def _scope_frame_id(self) -> Optional[str]:
+        ids = self.scope_path.call_frame_ids
+        return ids[-1] if ids else None
+
+    def _audit_checkpoint_surfaces(self, state_manager: Any) -> None:
+        from orchestrator.workflow_lisp import lexical_checkpoints as checkpoints
+
+        eligible_steps = {node.step_id: node for node in self.index.nodes.values()}
+        scope_frame = self._scope_frame_id()
+        for point in getattr(self.bundle.runtime_plan, "lexical_checkpoint_points", ()):
+            payload = checkpoints._point_payload(point)
+            family = checkpoints.resolve_checkpoint_record_family_path(
+                state_manager=state_manager,
+                workflow_name=str(payload.get("workflow_name") or ""),
+                checkpoint_id=str(payload.get("checkpoint_id") or ""),
+                storage_scope=(payload.get("storage") or {}).get("resume_scope"),
+            )
+            if not family.is_dir():
+                continue
+            own = eligible_steps.get(payload.get("step_id"))
+            for record_path in sorted(family.glob("*.json")):
+                record = json.loads(record_path.read_text(encoding="utf-8"))
+                frame = (record.get("frame_identity") or {}).get("call_frame_id")
+                if frame != scope_frame:
+                    continue
+                if own is not None:
+                    raise self._conflict("checkpoint_record", own, record=record_path.name)
+                for binding in (record.get("restore_payload") or {}).get("bindings", ()):
+                    source = eligible_steps.get(binding.get("source_step_id"))
+                    if source is not None:
+                        raise self._conflict("restore_payload", source, record=record_path.name)

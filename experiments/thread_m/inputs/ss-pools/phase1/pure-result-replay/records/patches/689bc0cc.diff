+def test_provider_observation_manager_is_created_when_execution_starts(flow) -> None:
+    workspace, source, bundle = flow
+    created = []
+    import orchestrator.workflow.executor as executor_module
+
+    class _Manager:
+        def __init__(self, run_root):
+            created.append(self)
+            self.closed = 0
+
+        def close(self):
+            self.closed += 1
+
+    with patch.object(executor_module, "ProviderObservationManager", _Manager):
+        executor = WorkflowExecutor(bundle, workspace, _manager(workspace, source, "obs"))
+        assert created == []
+        executor.execute()
+
+    assert [m.closed for m in created] == [1]
+

+++ b/orchestrator/workflow/pure_result_replay_index.py
@@ -0,0 +1,379 @@
+"""Eligibility index for derived pure-result replay.
+
+``derive_pure_result_replay_index`` derives, from a loaded bundle alone, which
+compiler-generated pure nodes are replay-eligible and what each depends on. It
+never mutates or serializes the program; refs are scoped to the workflow that
+holds them, so an imported callee indexes only its own nodes under scope
+``root``.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from typing import Any, Iterable, Optional
+
+from .pure_binding_documents import _RefLeaf, _thaw, _walk_document
+from .pure_result_replay_errors import (
+    LINEAGE_BEARING,
+    LOOP_KINDS,
+    MULTIPLE_VISIT_REGION,
+    NOT_TOP_LEVEL_EXECUTION,
+    PURE_KIND,
+    _invalid,
+)
+from .references import ReferenceResolutionError, parse_structured_ref
+
+_LOOP_KINDS = LOOP_KINDS
+_PURE_KIND = PURE_KIND
+
+
+@dataclass(frozen=True)
+class PureStateAddress:
+    """Typed location of one durable value: a bound input or a step result leaf."""
+
+    kind: str  # input | artifact | exit_code | outcome | snapshot
+    name: str  # input name, or step presentation key
+    member: Optional[str] = None
+
+    @property
+    def is_step(self) -> bool:
+        return self.kind != "input"
+
+
+_STEP_FIELD_KINDS = {
+    "artifacts": "artifact",
+    "exit_code": "exit_code",
+    "outcome": "outcome",
+    "snapshots": "snapshot",
+}
+
+
+def parse_pure_state_address(ref: Any, step_keys: Iterable[str]) -> PureStateAddress:
+    """Parse one exact ref into a typed address scoped to the holding workflow."""
+    keys = frozenset(step_keys)
+    if not isinstance(ref, str) or not ref:
+        raise _invalid("pure binding ref must be a non-empty string", ref=ref)
+    if "${" in ref:
+        raise _invalid("pure binding ref contains unbound text", ref=ref)
+    if ref.startswith("inputs."):
+        name = ref[len("inputs."):]
+        if not name:
+            raise _invalid("pure binding input ref is empty", ref=ref)
+        return PureStateAddress("input", name)
+    if not ref.startswith("root.steps."):
+        raise _invalid("pure binding ref leaves the holding workflow scope", ref=ref)
+    try:
+        target = parse_structured_ref(ref, keys)
+    except ReferenceResolutionError as exc:
+        raise _invalid("pure binding ref is malformed", ref=ref, error=str(exc)) from exc
+    if target.step_name not in keys:
+        raise _invalid("pure binding ref names a step outside this workflow", ref=ref)
+    return PureStateAddress(_STEP_FIELD_KINDS[target.field], target.step_name, target.member)
+
+
+# ---------------------------------------------------------------------------
+# Index model
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PureBinding:
+    path: tuple[Any, ...]
+    address: PureStateAddress
+    descriptor: Optional[Mapping[str, Any]] = field(default=None, compare=False, repr=False)
+    in_union: bool = field(default=False, compare=False, repr=False)
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureBinding, ...]
+    output_addresses: tuple[PureStateAddress, ...]
+    output_contracts: Mapping[str, Mapping[str, Any]]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+    step_keys: frozenset[str] = field(default_factory=frozenset, repr=False, compare=False)
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[Any],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Reached pure nodes needed to rebuild ``seed_addresses``, dependencies first."""
+        reached = frozenset(reached_node_ids)
+        producer = {
+            (address.name): node_id
+            for node_id, node in self.nodes.items()
+            for address in node.output_addresses
+        }
+        pending: list[str] = []
+        for seed in seed_addresses:
+            address = (
+                seed
+                if isinstance(seed, PureStateAddress)
+                else parse_pure_state_address(seed, self.step_keys)
+            )
+            node_id = producer.get(address.name) if address.is_step else None
+            if node_id is not None and node_id in reached:
+                pending.append(node_id)
+        needed: set[str] = set()
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            needed.add(node_id)
+            pending.extend(
+                dep
+                for dep in self.nodes[node_id].pure_dependency_node_ids
+                if dep in reached
+            )
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+def _strongly_connected_cycle_nodes(plan_nodes: Mapping[str, Any]) -> set[str]:
+    """Nodes on a control-flow cycle (fallthrough and routed edges)."""
+    edges = {
+        node_id: [
+            target
+            for target in (node.fallthrough_node_id, *node.routed_transfer_targets.values())
+            if isinstance(target, str) and target in plan_nodes
+        ]
+        for node_id, node in plan_nodes.items()
+    }
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    stack: list[str] = []
+    on_stack: set[str] = set()
+    cyclic: set[str] = set()
+    counter = 0
+    for root in edges:
+        if root in index:
+            continue
+        work = [(root, iter(edges[root]))]
+        index[root] = low[root] = counter
+        counter += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            node_id, successors = work[-1]
+            advanced = False
+            for succ in successors:
+                if succ not in index:
+                    index[succ] = low[succ] = counter
+                    counter += 1
+                    stack.append(succ)
+                    on_stack.add(succ)
+                    work.append((succ, iter(edges[succ])))
+                    advanced = True
+                    break
+                if succ in on_stack:
+                    low[node_id] = min(low[node_id], index[succ])
+            if advanced:
+                continue
+            work.pop()
+            if work:
+                parent = work[-1][0]
+                low[parent] = min(low[parent], low[node_id])
+            if low[node_id] == index[node_id]:
+                component = []
+                while True:
+                    member = stack.pop()
+                    on_stack.discard(member)
+                    component.append(member)
+                    if member == node_id:
+                        break
+                if len(component) > 1 or node_id in edges[node_id]:
+                    cyclic.update(component)
+    return cyclic
+
+
+def _propagate_pure_ineligibility(
+    reasons: dict[str, str],
+    plan_nodes: Mapping[str, Any],
+) -> None:
+    """Mark every pure node nested under a loop-like owner as multiply visited."""
+    for node in plan_nodes.values():
+        if node.kind not in _LOOP_KINDS:
+            continue
+        for nested in node.nested_body_node_ids:
+            if nested in plan_nodes and plan_nodes[nested].kind == _PURE_KIND:
+                reasons.setdefault(nested, MULTIPLE_VISIT_REGION)
+
+
+def _bundle_scope(bundle: Any) -> str:
+    node_ids = list(bundle.runtime_plan.nodes)
+    prefixes = {node_id.split(".", 1)[0] for node_id in node_ids}
+    return prefixes.pop() if len(prefixes) == 1 else "root"
+
+
+def _pure_config(bundle: Any, node_id: str) -> Mapping[str, Any]:
+    node = bundle.ir.nodes.get(node_id)
+    config = getattr(getattr(node, "execution_config", None), "pure_projection", None)
+    if not isinstance(config, Mapping):
+        raise _invalid("pure projection node lacks its config", node_id=node_id)
+    return config
+
+
+def _node_bindings(
+    config: Mapping[str, Any],
+    node_id: str,
+    step_keys: frozenset[str],
+) -> tuple[PureBinding, ...]:
+    payload = config.get("payload")
+    binding_refs = config.get("binding_refs")
+    if not isinstance(payload, Mapping) or not isinstance(binding_refs, Mapping):
+        raise _invalid("pure projection config is malformed", node_id=node_id)
+    declared = payload.get("bindings")
+    if not isinstance(declared, Mapping):
+        raise _invalid("pure projection payload lacks binding types", node_id=node_id)
+    bindings: list[PureBinding] = []
+    for name, doc in binding_refs.items():
+        spec = declared.get(name)
+        if not isinstance(spec, Mapping) or not isinstance(spec.get("type"), Mapping):
+            raise _invalid("pure binding has no declared type", node_id=node_id, binding=name)
+        refs: list[_RefLeaf] = []
+        _walk_document(_thaw(doc), spec["type"], (name,), refs)
+        bindings.extend(
+            PureBinding(
+                leaf.path,
+                parse_pure_state_address(leaf.ref, step_keys),
+                leaf.descriptor,
+                leaf.in_union,
+            )
+            for leaf in refs
+        )
+    return tuple(bindings)
+
+
+def _topological_order(deps: Mapping[str, tuple[str, ...]], order: list[str]) -> tuple[str, ...]:
+    state: dict[str, int] = {}
+    result: list[str] = []
+
+    def visit(node_id: str, trail: tuple[str, ...]) -> None:
+        if state.get(node_id) == 2:
+            return
+        if state.get(node_id) == 1:
+            raise _invalid("pure dependency cycle", cycle=list((*trail, node_id)))
+        state[node_id] = 1
+        for dep in deps[node_id]:
+            visit(dep, (*trail, node_id))
+        state[node_id] = 2
+        result.append(node_id)
+
+    for node_id in order:
+        visit(node_id, ())
+    return tuple(result)
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = "root") -> PureResultReplayIndex:
+    """Derive replay eligibility and dependencies for one bundle's own pure nodes."""
+    actual_scope = _bundle_scope(bundle)
+    if scope_kind != actual_scope:
+        raise _invalid(
+            "replay index scope does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=actual_scope,
+        )
+    plan_nodes = bundle.runtime_plan.nodes
+    compiler_generated = bundle.provenance.frontend_kind == "workflow_lisp"
+    pure_ids = [
+        node_id
+        for node_id, node in plan_nodes.items()
+        if node.kind == _PURE_KIND and compiler_generated
+    ]
+    keys: dict[str, str] = {}
+    step_ids: dict[str, str] = {}
+    for node_id, node in plan_nodes.items():
+        for registry, value in ((keys, node.presentation_key), (step_ids, node.step_id)):
+            owner = registry.setdefault(value, node_id)
+            if owner != node_id and (owner in pure_ids or node_id in pure_ids):
+                raise _invalid("duplicate projection authority", identity=value)
+    for node_id in pure_ids:
+        plan_node = plan_nodes[node_id]
+        ir_node = bundle.ir.nodes.get(node_id)
+        if (
+            ir_node is None
+            or ir_node.step_id != plan_node.step_id
+            or ir_node.presentation_name != plan_node.presentation_key
+        ):
+            raise _invalid("projection identity mismatch", node_id=node_id)
+    step_keys = frozenset(keys)
+
+    reasons = _ineligible_reasons(bundle, plan_nodes, pure_ids)
+    candidates = [node_id for node_id in pure_ids if node_id not in reasons]
+    configs = {node_id: _pure_config(bundle, node_id) for node_id in candidates}
+    parsed = {node_id: _node_bindings(configs[node_id], node_id, step_keys) for node_id in candidates}
+    producers = {plan_nodes[node_id].presentation_key: node_id for node_id in candidates}
+    all_pure_deps = {
+        node_id: tuple(
+            dict.fromkeys(
+                producers[b.address.name]
+                for b in parsed[node_id]
+                if b.address.is_step and b.address.name in producers
+            )
+        )
+        for node_id in candidates
+    }
+    topo = _topological_order(all_pure_deps, candidates)
+    nodes: dict[str, PureReplayNode] = {}
+    for node_id in topo:
+        plan_node = plan_nodes[node_id]
+        key = plan_node.presentation_key
+        contracts = _thaw(configs[node_id].get("output_contracts") or {})
+        step_deps = tuple(
+            dict.fromkeys(
+                keys[b.address.name] for b in parsed[node_id] if b.address.is_step
+            )
+        )
+        pure_deps = tuple(d for d in step_deps if d in producers.values())
+        nodes[node_id] = PureReplayNode(
+            node_id=node_id,
+            step_id=plan_node.step_id,
+            presentation_key=key,
+            bindings=parsed[node_id],
+            output_addresses=tuple(PureStateAddress("artifact", key, name) for name in contracts),
+            output_contracts=contracts,
+            pure_dependency_node_ids=pure_deps,
+            durable_dependency_node_ids=tuple(d for d in step_deps if d not in pure_deps),
+        )
+    return PureResultReplayIndex(
+        scope_kind=actual_scope,
+        nodes=nodes,
+        topological_node_ids=tuple(nodes),
+        ineligible_pure_reasons={n: reasons[n] for n in pure_ids if n in reasons},
+        step_keys=step_keys,
+    )
+
+
+def _has_lineage(ir_node: Any) -> bool:
+    """Whether a node publishes or consumes artifact lineage that shells cannot carry."""
+    common = getattr(getattr(ir_node, "execution_config", None), "common", None)
+    return bool(getattr(common, "publishes", ()) or getattr(common, "consumes", ()))
+
+
+def _ineligible_reasons(
+    bundle: Any, plan_nodes: Mapping[str, Any], pure_ids: list[str]
+) -> dict[str, str]:
+    cyclic = _strongly_connected_cycle_nodes(plan_nodes)
+    reasons: dict[str, str] = {}
+    for node_id in pure_ids:
+        if node_id in cyclic:
+            reasons[node_id] = MULTIPLE_VISIT_REGION
+        elif plan_nodes[node_id].execution_index is None:
+            reasons[node_id] = NOT_TOP_LEVEL_EXECUTION
+        elif _has_lineage(bundle.ir.nodes.get(node_id)):
+            reasons[node_id] = LINEAGE_BEARING
+    _propagate_pure_ineligibility(reasons, plan_nodes)
+    return reasons

new file mode 100644
index 0000000..67ec3ee
--- /dev/null
+++ b/orchestrator/workflow/pure_binding_documents.py
@@ -0,0 +1,171 @@
+"""Binding-document walk: exact ref leaves and typed literal validation.
+
+A compiled pure projection binds each payload binding through a value document
+made of exact ``{"ref": ...}`` leaves and ordinary literals. ``_walk_document``
+collects the ref leaves and checks every literal subtree against the binding's
+declared type (including the inactive members of union literals).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any, Iterable, Optional
+
+from .pure_expr import PureExprEvaluationError, _coerce_value, _descriptor_kind
+from .pure_result_replay_errors import PureResultReplayIndexError, _invalid
+
+
+def _thaw(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _thaw(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_thaw(item) for item in value]
+    return value
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and set(doc) == {"ref"} and isinstance(doc["ref"], str)
+
+
+@dataclass(frozen=True)
+class _RefLeaf:
+    path: tuple[Any, ...]
+    ref: str
+    descriptor: Mapping[str, Any]
+    in_union: bool
+
+
+_DISCRIMINANT_TYPE = {"kind": "primitive", "name": "String"}
+
+
+def _walk_document(
+    doc: Any,
+    descriptor: Mapping[str, Any],
+    path: tuple[Any, ...],
+    refs: list[_RefLeaf],
+    in_union: bool = False,
+) -> None:
+    """Collect exact refs and type-check every literal subtree against ``descriptor``."""
+    kind = _descriptor_kind(descriptor)
+    if _is_exact_ref(doc):
+        refs.append(_RefLeaf(path, doc["ref"], descriptor, in_union))
+        return
+    if isinstance(doc, Mapping) and "ref" in doc and kind not in {"record", "union", "variant_case", "map"}:
+        raise _invalid("malformed ref object in pure binding document", path=list(path))
+    if kind == "optional":
+        if doc is not None:
+            _walk_document(doc, descriptor["item"], path, refs, in_union)
+        return
+    if kind == "list":
+        if not isinstance(doc, (list, tuple)):
+            raise _invalid("pure binding literal must be a list", path=list(path))
+        for index, item in enumerate(doc):
+            _walk_document(item, descriptor["item"], (*path, index), refs, in_union)
+        return
+    if kind == "map":
+        if not isinstance(doc, Mapping):
+            raise _invalid("pure binding literal must be a map", path=list(path))
+        for key, item in doc.items():
+            _walk_document(item, descriptor["value"], (*path, key), refs, in_union)
+        return
+    if kind == "record":
+        _walk_record(doc, descriptor["fields"], path, refs, in_union)
+        return
+    if kind in {"union", "variant_case"}:
+        _walk_union(doc, descriptor, path, refs)
+        return
+    if isinstance(doc, str) and "${" in doc:
+        raise _invalid("pure binding literal contains unbound text", path=list(path))
+    try:
+        _coerce_value(doc, descriptor, context="binding")
+    except PureExprEvaluationError as exc:
+        raise _invalid(
+            "pure binding literal does not match its declared type",
+            path=list(path),
+            error=str(exc),
+        ) from exc
+
+
+def _walk_record(
+    doc: Any,
+    fields: Iterable[Mapping[str, Any]],
+    path: tuple[Any, ...],
+    refs: list[_RefLeaf],
+    in_union: bool,
+) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("pure binding literal must be a record", path=list(path))
+    declared = {f["name"]: f["type"] for f in fields}
+    if set(doc) != set(declared):
+        raise _invalid(
+            "pure binding record fields do not match the declared type",
+            path=list(path),
+            fields=sorted(map(str, doc)),
+        )
+    for name, item in doc.items():
+        _walk_document(item, declared[name], (*path, name), refs, in_union)
+
+
+def _walk_union(
+    doc: Any,
+    descriptor: Mapping[str, Any],
+    path: tuple[Any, ...],
+    refs: list[_RefLeaf],
+) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("pure binding literal must be a union value", path=list(path))
+    variants = (
+        [{"name": descriptor["variant"], "fields": descriptor["fields"]}]
+        if _descriptor_kind(descriptor) == "variant_case"
+        else list(descriptor["variants"])
+    )
+    names = [v["name"] for v in variants]
+    discriminant = doc.get("variant")
+    if _is_exact_ref(discriminant):
+        refs.append(_RefLeaf((*path, "variant"), discriminant["ref"], _DISCRIMINANT_TYPE, True))
+        active = None
+    elif isinstance(discriminant, str) and discriminant in names:
+        active = discriminant
+    else:
+        raise _invalid("pure binding union needs a declared variant", path=list(path))
+    candidates: dict[str, list[Mapping[str, Any]]] = {}
+    for variant in variants:
+        for fld in variant["fields"]:
+            candidates.setdefault(fld["name"], []).append(fld["type"])
+    for name, item in doc.items():
+        if name == "variant":
+            continue
+        if name not in candidates:
+            raise _invalid("pure binding union has an undeclared member", path=[*path, name])
+        _walk_alternatives(item, candidates[name], (*path, name), refs)
+    if active is not None:
+        missing = [
+            f["name"]
+            for v in variants
+            if v["name"] == active
+            for f in v["fields"]
+            if f["name"] not in doc
+        ]
+        if missing:
+            raise _invalid("pure binding union lacks active members", path=list(path), missing=missing)
+
+
+def _walk_alternatives(
+    doc: Any,
+    types: list[Mapping[str, Any]],
+    path: tuple[Any, ...],
+    refs: list[_RefLeaf],
+) -> None:
+    last: Optional[PureResultReplayIndexError] = None
+    for descriptor in types:
+        trial: list[_RefLeaf] = []
+        try:
+            _walk_document(doc, descriptor, path, trial, True)
+        except PureResultReplayIndexError as exc:
+            last = exc
+            continue
+        refs.extend(trial)
+        return
+    assert last is not None
+    raise last
diff --git a/orchestrator/workflow/pure_replay_executor.py b/orchestrator/workflow/pure_replay_executor.py
new file mode 100644
index 0000000..c7f89e5
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_executor.py
@@ -0,0 +1,193 @@
+"""Executor-side coordination of the ``derived_pure_replay.v1`` profile.
+
+``PureReplayCoordinator`` is composed into ``WorkflowExecutor`` (like
+``LoopExecutor``/``CallExecutor``). It owns the per-run ``PureReplayRuntime`` and
+the four moments where the profile changes execution:
+
+* before the prologue: audit persisted surfaces and progress witnesses;
+* after the restart boundary is known: replay the needed pure values in memory;
+* at visit start: begin/reuse the eligible visit instead of an ordinary one;
+* at settlement: route eligible results through the value-free shell.
+
+Historical runs (no profile) never construct a runtime; every method then
+reports "not eligible" and the executor behaves exactly as before.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Dict, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+from .pure_result_replay import (
+    PROGRESS_INTERRUPTED,
+    PROGRESS_UNSTARTED,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    classify_pure_replay_progress,
+)
+from .pure_result_replay_runtime import PureReplayRuntime
+
+
+class PureReplayCoordinator:
+    """Per-executor adapter between ``WorkflowExecutor`` and ``PureReplayRuntime``."""
+
+    def __init__(self, executor: Any) -> None:
+        self.executor = executor
+        self.runtime: Optional[PureReplayRuntime] = None
+
+    # -- setup --------------------------------------------------------------------
+
+    def prepare(self, run_state: Any) -> None:
+        """Build the runtime for a profiled scope; leave historical scopes untouched."""
+        self.runtime = None
+        if getattr(run_state, "result_persistence_profile", None) != DERIVED_PURE_REPLAY_PROFILE:
+            return
+        self.runtime = PureReplayRuntime(
+            bundle=self.executor.loaded_bundle,
+            scope_path=self.executor.resume_scope_path,
+        )
+
+    def fail_closed(self, error: PureResultReplayIndexError) -> Dict[str, Any]:
+        """Record a typed replay failure before any effect and return the failed state."""
+        return self.executor._fail_resume_state_integrity(
+            error.code,
+            str(error),
+            {**error.context, "reason": error.reason},
+        )
+
+    # -- pre-prologue audit -------------------------------------------------------
+
+    def audit_persisted(self, state: Mapping[str, Any]) -> None:
+        """Raise on a conflicting surface or an invalid progress witness; writes nothing."""
+        runtime = self.runtime
+        if runtime is None:
+            return
+        runtime.audit_persisted_surfaces(
+            state=state,
+            state_manager=self.executor.state_manager,
+            resolve_bundle_path=self._resolve_bundle_path,
+        )
+        runtime.audit_progress(state)
+
+    def _resolve_bundle_path(self, node: Any) -> Optional[Path]:
+        """The declared result-bundle path of one eligible node, resolved read-only."""
+        executor = self.executor
+        step = executor._typed_execution_step(executor._runtime_step_for_node_id(node.node_id))
+        declared = (step.get("output_bundle") or {}).get("path")
+        if not isinstance(declared, str) or not declared:
+            return None
+        state = executor.state_manager.state
+        bound = state.bound_inputs if state is not None else {}
+        prefix = "${inputs."
+        if declared.startswith(prefix) and declared.endswith("}"):
+            declared = bound.get(declared[len(prefix):-1])
+        if not isinstance(declared, str) or not declared:
+            return None
+        return Path(executor.workspace) / declared
+
+    # -- replay -------------------------------------------------------------------
+
+    def replay_for_boundary(self, state: Dict[str, Any], restart_node_id: Optional[str]) -> None:
+        """Re-derive needed pure values and expose them in the in-memory ``state`` only."""
+        runtime = self.runtime
+        if runtime is None:
+            return
+        runtime.replay_required(
+            restart_node_id, state=state, evaluate_node=self._evaluate_replay_node
+        )
+        state["steps"] = runtime.overlay_active_state(state)["steps"]
+
+    def _evaluate_replay_node(self, node: Any, overlay_state: Dict[str, Any]) -> Dict[str, Any]:
+        from .steps.pure_projection import execute_pure_projection
+
+        executor = self.executor
+        step = executor._typed_execution_step(executor._runtime_step_for_node_id(node.node_id))
+        return execute_pure_projection(executor, step, overlay_state, persist_bundle=False)
+
+    # -- visits and settlement ----------------------------------------------------
+
+    def witness_for_step(self, step: Any) -> Optional[PureReplayVisitWitness]:
+        runtime = self.runtime
+        if runtime is None:
+            return None
+        node_id = runtime.node_id_for_step_id(self.executor._step_id(step))
+        return runtime.witness(node_id) if node_id is not None else None
+
+    def _progress_view(self) -> Dict[str, Any]:
+        run_state = self.executor.state_manager.state
+        return {
+            "step_visits": run_state.step_visits,
+            "steps": run_state.steps,
+            "current_step": run_state.current_step,
+        }
+
+    def begin_visit(
+        self,
+        state: Dict[str, Any],
+        step: Any,
+        *,
+        resume_current_step: bool,
+    ) -> Optional[int]:
+        """Begin (or re-enter) one eligible visit; ``None`` for a non-eligible step."""
+        witness = self.witness_for_step(step)
+        if witness is None:
+            return None
+        manager = self.executor.state_manager
+        progress = classify_pure_replay_progress(self._progress_view(), witness=witness)
+        if progress == PROGRESS_INTERRUPTED and resume_current_step:
+            visit_count = manager.reuse_interrupted_eligible_pure_visit(witness)
+        elif progress == PROGRESS_UNSTARTED:
+            visit_count = manager.begin_eligible_pure_visit(
+                step_name=witness.presentation_key,
+                step_index=witness.step_index,
+                step_id=witness.step_id,
+            )
+        else:
+            raise PureResultReplayIndexError(
+                PROGRESS_WITNESS_INVALID,
+                f"eligible pure visit cannot start from progress {progress!r}",
+                context={"step_id": witness.step_id},
+            )
+        state.setdefault("step_visits", {})[witness.presentation_key] = visit_count
+        return visit_count
+
+    def settlement_witness(self, state: Dict[str, Any], step: Any) -> Optional[PureReplayVisitWitness]:
+        """Witness for settling ``step`` through the shell path, starting its visit if needed."""
+        witness = self.witness_for_step(step)
+        if witness is None:
+            return None
+        progress = classify_pure_replay_progress(self._progress_view(), witness=witness)
+        if progress == PROGRESS_UNSTARTED:
+            self.executor.state_manager.begin_eligible_pure_visit(
+                step_name=witness.presentation_key,
+                step_index=witness.step_index,
+                step_id=witness.step_id,
+            )
+            state.setdefault("step_visits", {})[witness.presentation_key] = witness.visit_count
+        elif progress != PROGRESS_INTERRUPTED:
+            raise PureResultReplayIndexError(
+                PROGRESS_WITNESS_INVALID,
+                f"eligible pure result cannot settle from progress {progress!r}",
+                context={"step_id": witness.step_id},
+            )
+        return witness
+
+    def record_success(self, witness: PureReplayVisitWitness, finalized: Mapping[str, Any]) -> None:
+        runtime = self.runtime
+        if runtime is None or finalized.get("status") != "completed":
+            return
+        node_id = runtime.node_id_for_step_id(witness.step_id)
+        if node_id is not None:
+            runtime.record_full_result(node_id, witness=witness, result=finalized)
+
+    def is_eligible_step(self, step: Any) -> bool:
+        runtime = self.runtime
+        return runtime is not None and runtime.node_id_for_step_id(self.executor._step_id(step)) is not None
+
+
+def replay_runtime_of(executor: Any) -> Optional[PureReplayRuntime]:
+    """The executor's active replay runtime, or ``None`` (historical or foreign executors)."""
+    runtime = getattr(getattr(executor, "pure_replay", None), "runtime", None)
+    return runtime if isinstance(runtime, PureReplayRuntime) else None

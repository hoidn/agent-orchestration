+    assert overlay["steps"][PROJECTION_STEP]["artifacts"] == row
+    assert "artifacts" not in persisted["steps"][PROJECTION_STEP]
+    assert runtime.node_id_for_step_id("root.flow_orchestrate__projection") == node_id
+

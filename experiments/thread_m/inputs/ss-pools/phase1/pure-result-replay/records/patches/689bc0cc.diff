+def test_union_rows_hold_exactly_the_active_variant(flow) -> None:
+    _, _, bundle = flow
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("flow.orc"))
+    (node_id,) = runtime.index.nodes
+    node = runtime.index.nodes[node_id]
+    union_node = type(node)(
+        **{
+            **node.__dict__,
+            "output_contracts": {
+                "return__variant": {"kind": "scalar", "type": "enum", "allowed": ["A", "B"],
+                                    "projection": {"projection_class": "union_workflow_boundary", "field_role": "discriminant"}},
+                "return__shared": {"kind": "scalar", "type": "string",
+                                   "projection": {"projection_class": "union_workflow_boundary", "field_role": "shared"}},
+                "return__a_only": {"kind": "scalar", "type": "string",
+                                   "projection": {"projection_class": "union_workflow_boundary", "field_role": "variant", "active_variants": ["A"]}},
+                "return__b_only": {"kind": "scalar", "type": "string",
+                                   "projection": {"projection_class": "union_workflow_boundary", "field_role": "variant", "active_variants": ["B"]}},
+            },
+        }
+    )
+
+    assert runtime._validate_transient_row(
+        union_node, {"return__variant": "A", "return__shared": "s", "return__a_only": "x"}
+    )
+    for bad in (
+        {"return__variant": "A", "return__shared": "s"},
+        {"return__variant": "A", "return__shared": "s", "return__a_only": "x", "return__b_only": "y"},
+    ):
+        with pytest.raises(PureResultReplayIndexError) as excinfo:
+            runtime._validate_transient_row(union_node, bad)
+        assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+

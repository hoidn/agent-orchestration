new file mode 100644
index 0000000..ff713b2
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,292 @@
+"""Derived pure-result replay: completion shells, progress witnesses, visit mutations.
+
+Under the ``derived_pure_replay.v1`` result-persistence profile an eligible
+compiler-generated ``pure_projection`` persists only a value-free completion
+shell. This module is the public facade for the contract:
+
+* the replay index (``derive_pure_result_replay_index`` and its model) from
+  ``pure_result_replay_index``;
+* ``build_pure_completion_shell`` / ``validate_pure_completion_shell``, the one
+  exact durable row an eligible success leaves behind;
+* ``classify_pure_replay_progress``, classifying a state's visit, cursor and row
+  for one single-visit pure execution;
+* ``apply_*``, the leaf mutations behind the four visit transactions that
+  ``StateManager`` and call-frame managers expose;
+* ``PureReplayRuntime`` (lazily, from ``pure_result_replay_runtime``).
+
+Dependencies: ``orchestrator.state`` (profile constant, ``RunState``).
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE, RunState, StepResult
+from .pure_result_replay_errors import (  # noqa: F401  (re-exported)
+    DEPENDENCY_INDEX_INVALID,
+    LINEAGE_BEARING,
+    MULTIPLE_VISIT_REGION,
+    NOT_TOP_LEVEL_EXECUTION,
+    PROFILE_CONFLICT,
+    PROGRESS_DERIVED_COMPLETE,
+    PROGRESS_DURABLE_FAILURE_SKIP,
+    PROGRESS_INTERRUPTED,
+    PROGRESS_UNSTARTED,
+    PROGRESS_WITNESS_INVALID,
+    PURE_RESULT_REPLAY_UNAVAILABLE,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+from .pure_result_replay_index import (  # noqa: F401  (re-exported)
+    PureBinding,
+    PureReplayNode,
+    PureResultReplayIndex,
+    PureStateAddress,
+    _node_bindings,
+    _propagate_pure_ineligibility,
+    derive_pure_result_replay_index,
+    parse_pure_state_address,
+)
+
+
+# ---------------------------------------------------------------------------
+# Completion shell and progress witnesses
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+_SHELL_OUTCOME = {
+    "status": "completed",
+    "phase": "execution",
+    "class": "completed",
+    "retryable": False,
+}
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Return the exact value-free durable row for one eligible pure success."""
+    if witness.visit_count != 1:
+        raise ValueError("a pure completion shell is only defined for visit 1")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": dict(_SHELL_OUTCOME),
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=repr)
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's completion shell."""
+    expected = build_pure_completion_shell(witness)
+    if not isinstance(row, Mapping):
+        raise ValueError("pure completion shell must be a mapping")
+    extra = sorted(set(row) - set(expected), key=str)
+    missing = sorted(set(expected) - set(row))
+    if extra or missing:
+        raise ValueError(
+            f"pure completion shell keys differ (extra={extra}, missing={missing})"
+        )
+    if _canonical(dict(row)) != _canonical(expected):
+        raise ValueError("pure completion shell does not match its witness")
+
+
+def _is_cursor_for(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _exact_cursor(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and type(cursor.get("visit_count")) is int
+        and cursor.get("visit_count") == witness.visit_count
+        and cursor.get("type") == "pure_projection"
+        and cursor.get("status") == "running"
+    )
+
+
+def _witness_invalid(reason: str, witness: PureReplayVisitWitness) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID,
+        f"pure replay progress witness is invalid: {reason}",
+        context={"step_id": witness.step_id, "presentation_key": witness.presentation_key, "detail": reason},
+    )
+
+
+def classify_pure_replay_progress(state: Mapping[str, Any], *, witness: PureReplayVisitWitness) -> str:
+    """Classify visit, cursor and row for ``witness`` or raise ``progress_witness_invalid``."""
+    key = witness.presentation_key
+    visits = state.get("step_visits")
+    visit = visits.get(key) if isinstance(visits, Mapping) else None
+    steps = state.get("steps")
+    row = steps.get(key) if isinstance(steps, Mapping) else None
+    cursor = state.get("current_step")
+    has_cursor = _is_cursor_for(cursor, witness)
+    if witness.visit_count != 1:
+        raise _witness_invalid("eligible pure nodes are single-visit", witness)
+    if visit is None:
+        if has_cursor or row is not None:
+            raise _witness_invalid("cursor or row without a visit", witness)
+        return PROGRESS_UNSTARTED
+    if type(visit) is not int or visit != witness.visit_count:
+        raise _witness_invalid("visit count mismatch", witness)
+    if has_cursor:
+        if row is not None:
+            raise _witness_invalid("cursor together with a row", witness)
+        if not _exact_cursor(cursor, witness):
+            raise _witness_invalid("cursor identity mismatch", witness)
+        return PROGRESS_INTERRUPTED
+    if row is None:
+        raise _witness_invalid("visit without cursor or row", witness)
+    if not isinstance(row, Mapping):
+        raise _witness_invalid("row is not a mapping", witness)
+    if row.get("status") in {"failed", "skipped"}:
+        if (
+            row.get("step_id") != witness.step_id
+            or row.get("name", key) != key
+            or row.get("visit_count") != witness.visit_count
+            or type(row.get("visit_count")) is not int
+        ):
+            raise _witness_invalid("failure or skip identity mismatch", witness)
+        return PROGRESS_DURABLE_FAILURE_SKIP
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError as exc:
+        raise _witness_invalid(str(exc), witness) from exc
+    return PROGRESS_DERIVED_COMPLETE
+
+
+# ---------------------------------------------------------------------------
+# Leaf mutations (one RunState leaf; callers own atomicity)
+# ---------------------------------------------------------------------------
+
+
+def _require_profile(leaf: RunState) -> None:
+    if leaf.result_persistence_profile != DERIVED_PURE_REPLAY_PROFILE:
+        raise PureResultReplayIndexError(
+            PROFILE_CONFLICT,
+            "eligible pure visits require the derived pure replay profile",
+            context={"profile": leaf.result_persistence_profile},
+        )
+
+
+def apply_begin_eligible_pure_visit(
+    leaf: RunState, *, step_name: str, step_index: int, step_id: str
+) -> int:
+    _require_profile(leaf)
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    state_view = {
+        "step_visits": leaf.step_visits,
+        "steps": leaf.steps,
+        "current_step": leaf.current_step,
+    }
+    if classify_pure_replay_progress(state_view, witness=witness) != PROGRESS_UNSTARTED:
+        raise _witness_invalid("visit already started", witness)
+    leaf.step_visits[step_name] = 1
+    now = datetime.now(timezone.utc).isoformat()
+    leaf.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": "pure_projection",
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def apply_reuse_interrupted_eligible_pure_visit(leaf: RunState, witness: PureReplayVisitWitness) -> int:
+    _require_profile(leaf)
+    state_view = {
+        "step_visits": leaf.step_visits,
+        "steps": leaf.steps,
+        "current_step": leaf.current_step,
+    }
+    if classify_pure_replay_progress(state_view, witness=witness) != PROGRESS_INTERRUPTED:
+        raise _witness_invalid("visit is not interrupted", witness)
+    return witness.visit_count
+
+
+def _settle_precondition(leaf: RunState, witness: PureReplayVisitWitness) -> None:
+    _require_profile(leaf)
+    state_view = {
+        "step_visits": leaf.step_visits,
+        "steps": leaf.steps,
+        "current_step": leaf.current_step,
+    }
+    if classify_pure_replay_progress(state_view, witness=witness) != PROGRESS_INTERRUPTED:
+        raise _witness_invalid("only an interrupted visit can settle", witness)
+
+
+def apply_settle_eligible_pure_success(leaf: RunState, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    _settle_precondition(leaf, witness)
+    shell = build_pure_completion_shell(witness)
+    leaf.steps[witness.presentation_key] = shell
+    leaf.current_step = None
+    return dict(shell)
+
+
+def apply_settle_eligible_pure_failure(
+    leaf: RunState, witness: PureReplayVisitWitness, result: StepResult
+) -> None:
+    _settle_precondition(leaf, witness)
+    if result.status not in {"failed", "skipped"}:
+        raise ValueError("a pure failure settlement needs a failed or skipped result")
+    leaf.steps[witness.presentation_key] = result
+    leaf.current_step = None
+
+
+def replay_eligible_pure_step_ids(state: Any, bundle: Any) -> frozenset[str]:
+    """Step ids of replay-eligible pure nodes when ``state`` selects the profile.
+
+    Empty for historical states and for anything that is not a loaded bundle, so
+    callers can filter checkpoint candidates unconditionally.
+    """
+    profile = (
+        state.get("result_persistence_profile")
+        if isinstance(state, Mapping)
+        else getattr(state, "result_persistence_profile", None)
+    )
+    if profile != DERIVED_PURE_REPLAY_PROFILE or not hasattr(bundle, "runtime_plan"):
+        return frozenset()
+    index = derive_pure_result_replay_index(bundle)
+    return frozenset(node.step_id for node in index.nodes.values())
+
+
+# ---------------------------------------------------------------------------
+# Lazy re-export of the runtime so callers import everything from here
+# ---------------------------------------------------------------------------
+
+
+def __getattr__(name: str) -> Any:
+    if name == "PureReplayRuntime":
+        from .pure_result_replay_runtime import PureReplayRuntime
+
+        return PureReplayRuntime
+    raise AttributeError(name)

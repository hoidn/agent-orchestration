+def test_force_restart_selects_the_profile_and_leaves_the_source_run_untouched(tmp_path: Path) -> None:
+    from orchestrator.cli.commands.resume import resume_workflow
+
+    workflow_path = tmp_path / "wf.orc"
+    workflow_path.write_text(
+        "\n".join(
+            [
+                "(workflow-lisp", '  (:language "0.1")', '  (:target-dsl "2.15")', "  (defmodule wf)",
+                "  (export orchestrate)", "  (defrecord S (status String) (ready Bool))",
+                "  (defworkflow orchestrate ((approved Bool) (status String)) -> S",
+                "    (record S :status status :ready approved)))", "",
+            ]
+        ),
+        encoding="utf-8",
+    )
+    source_manager = StateManager(workspace=tmp_path, run_id="source")
+    source_manager.initialize(
+        str(workflow_path), bound_inputs={"approved": True, "status": "x"},
+        observability={"summary": {"mode": "off"}},
+    )
+    before = source_manager.state_file.read_bytes()
+    created = {}
+
+    class _Executor:
+        def __init__(self, **kwargs):
+            created["manager"] = kwargs["state_manager"]
+
+        def execute(self, **kwargs):
+            return {"status": "completed"}
+
+    with patch("orchestrator.cli.commands.resume.WorkflowExecutor", _Executor), patch(
+        "os.getcwd", return_value=str(tmp_path)
+    ):
+        assert resume_workflow(run_id="source", force_restart=True, summary_mode="async") == 0
+
+    new_manager = created["manager"]
+    assert new_manager.run_id != "source"
+    assert new_manager.state.result_persistence_profile == DERIVED_PURE_REPLAY_PROFILE
+    assert new_manager.state.observability is not None
+    assert source_manager.state_file.read_bytes() == before
+

+@pytest.mark.parametrize("frame", [{}, {"state": None}, {"state": []}, {"state": "x"}])
+def test_malformed_existing_call_frame_is_rejected_before_anything_is_written(tmp_path: Path, frame) -> None:
+    from orchestrator.workflow.call_frame_state import _CallFrameStateManager
+
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    parent = StateManager(workspace=tmp_path, run_id="parent")
+    parent.initialize("w.orc")
+    before = parent.state_file.read_bytes()
+
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        _CallFrameStateManager(
+            parent_manager=parent, workflow=None, frame_id="f", call_step_name="c",
+            call_step_id="root.c", import_alias="a", bound_inputs={}, existing_frame=frame,
+        )
+
+    assert parent.state_file.read_bytes() == before
+    assert not (parent.run_root / "call_frames").exists()

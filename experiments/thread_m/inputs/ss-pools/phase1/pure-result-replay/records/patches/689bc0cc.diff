+def test_cache_hit_revalidates_the_current_cursor(flow) -> None:
+    workspace, source, bundle = flow
+    WorkflowExecutor(bundle, workspace, _manager(workspace, source, "cursor")).execute()
+    persisted = _persisted(workspace, "cursor")
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root(str(source)))
+    (node_id,) = runtime.index.nodes
+    runtime.replay_node(
+        node_id, state=persisted,
+        evaluate_node=lambda node, overlay: {"status": "completed", "artifacts": {"return__label": "pos", "return__flag": True}},
+    )
+    persisted["current_step"] = _cursor(name=PROJECTION_STEP, step_id="root.flow_orchestrate__projection", index=0)
+
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.overlay_active_state(persisted)
+
+    assert excinfo.value.reason == "progress_witness_invalid"

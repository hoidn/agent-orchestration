+++ b/orchestrator/workflow/pure_result_replay_progress.py
@@ -0,0 +1,200 @@
+"""Value-free completion shell, visit witness, and progress classification.
+
+Leaf module of the ``derived_pure_replay.v1`` result persistence profile: it
+depends on nothing outside the standard library, so ``orchestrator.state`` may
+import it lazily. See ``specs/state.md`` ("Result persistence profile").
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+PURE_PROJECTION_TYPE = "pure_projection"
+
+
+class PureResultReplayIndexError(ValueError):
+    """Typed fail-closed error for pure-result replay."""
+
+    code = "pure_result_replay_unavailable"
+
+    def __init__(self, reason: str, message: str, *, context: Optional[Mapping[str, Any]] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit eligible pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+_SHELL_OUTCOME = {"status": "completed", "phase": "execution", "class": "completed", "retryable": False}
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row for one single-visit pure step."""
+    if witness.visit_count != 1:
+        raise ValueError(f"pure completion shell is single-visit only, got visit {witness.visit_count}")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": dict(_SHELL_OUTCOME),
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ValueError unless ``row`` is exactly the shell for ``witness``."""
+    expected = build_pure_completion_shell(witness)
+    if not isinstance(row, Mapping):
+        raise ValueError("pure completion shell must be an object")
+    for key in sorted(set(row) - set(expected), key=str):
+        raise ValueError(f"pure completion shell has unexpected key {key!r}")
+    for key in expected:
+        if key not in row:
+            raise ValueError(f"pure completion shell is missing key {key!r}")
+    for key, value in expected.items():
+        # type(...) guards bool/int aliasing (True == 1).
+        if row[key] != value or type(row[key]) is not type(value):
+            raise ValueError(f"pure completion shell key {key!r} does not match the witness")
+
+
+def _is_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True
+
+
+def _invalid(witness: PureReplayVisitWitness, why: str) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID,
+        f"pure step {witness.presentation_key!r}: {why}",
+        context={"presentation_key": witness.presentation_key, "step_id": witness.step_id, "detail": why},
+    )
+
+
+def _cursor_is_exact(cursor: Mapping[str, Any], witness: PureReplayVisitWitness, visit: int) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and cursor.get("type") == PURE_PROJECTION_TYPE
+        and cursor.get("status") == "running"
+        and cursor.get("visit_count") == visit
+    )
+
+
+def _row_is_failure_or_skip(row: Any, witness: PureReplayVisitWitness, visit: int) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("name") == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and row.get("visit_count") == visit
+    )
+
+
+def classify_pure_replay_progress(state: Mapping[str, Any], *, witness: PureReplayVisitWitness) -> str:
+    """Classify visit, cursor and row of one pure step: unstarted, interrupted, derived_complete, durable_failure_skip."""
+    name = witness.presentation_key
+    visits = state.get("step_visits")
+    steps = state.get("steps")
+    visit = visits.get(name) if isinstance(visits, Mapping) else None
+    row = steps.get(name) if isinstance(steps, Mapping) else None
+    cursor = state.get("current_step")
+    cursor_related = isinstance(cursor, Mapping) and (
+        cursor.get("name") == name or cursor.get("step_id") == witness.step_id
+    )
+    has_row = isinstance(steps, Mapping) and name in steps
+
+    if visit is None:
+        if cursor_related or has_row:
+            raise _invalid(witness, "cursor or row without a recorded visit")
+        return "unstarted"
+    if type(visit) is not int or visit != 1 or visit != witness.visit_count:
+        # Eligible pure nodes are visited at most once per scope.
+        raise _invalid(witness, f"recorded visit {visit!r} is not the single witnessed visit {witness.visit_count}")
+    if not has_row:
+        if cursor_related and _cursor_is_exact(cursor, witness, visit):
+            return "interrupted"
+        raise _invalid(witness, "visit without a matching cursor or row")
+    if cursor_related:
+        raise _invalid(witness, "cursor and row are both present")
+    if _is_shell(row, witness):
+        return "derived_complete"
+    if _row_is_failure_or_skip(row, witness, visit):
+        return "durable_failure_skip"
+    raise _invalid(witness, "row is neither the exact completion shell nor a matching failure or skip")
+
+
+# -- run-state mutations shared by StateManager and call-frame managers ------------
+
+
+def _progress_view(run_state: Any) -> dict[str, Any]:
+    state = run_state.to_dict()
+    return {key: state.get(key) for key in ("step_visits", "steps", "current_step")}
+
+
+def begin_visit_on(run_state: Any, *, step_name: str, step_index: int, step_id: str) -> int:
+    """Increment the visit and publish the matching running cursor (caller persists)."""
+    from datetime import datetime, timezone
+
+    visit_count = run_state.step_visits.get(step_name, 0) + 1
+    run_state.step_visits[step_name] = visit_count
+    now = datetime.now(timezone.utc).isoformat()
+    run_state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": PURE_PROJECTION_TYPE,
+        "step_id": step_id,
+        "visit_count": visit_count,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return visit_count
+
+
+def require_interrupted_visit(run_state: Any, witness: PureReplayVisitWitness) -> None:
+    progress = classify_pure_replay_progress(_progress_view(run_state), witness=witness)
+    if progress != "interrupted":
+        raise ValueError(f"pure step {witness.presentation_key!r} is {progress}, not an interrupted visit")
+
+
+def settle_success_on(run_state: Any, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Persist-ready exact shell; clears the cursor (caller persists)."""
+    require_interrupted_visit(run_state, witness)
+    shell = build_pure_completion_shell(witness)
+    run_state.steps[witness.presentation_key] = shell
+    run_state.current_step = None
+    return dict(shell)
+
+
+def settle_failure_on(run_state: Any, witness: PureReplayVisitWitness, result: Any) -> None:
+    """Persist-ready full failed/skipped row; clears the cursor (caller persists)."""
+    if result.status not in {"failed", "skipped"}:
+        raise ValueError(f"a failure settlement requires a failed or skipped result, got {result.status!r}")
+    require_interrupted_visit(run_state, witness)
+    result.name = result.name or witness.presentation_key
+    result.step_id = result.step_id or witness.step_id
+    result.visit_count = witness.visit_count
+    run_state.steps[witness.presentation_key] = result
+    run_state.current_step = None

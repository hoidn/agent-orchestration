+
+
+@pytest.mark.parametrize("ref", [{"ref": 5}, {"ref": "inputs.count", "extra": 1}])
+def test_malformed_ref_objects_fail(bundle, ref):
+    pure = next(n for n in bundle.ir.nodes.values() if n.presentation_name == TERMINAL)

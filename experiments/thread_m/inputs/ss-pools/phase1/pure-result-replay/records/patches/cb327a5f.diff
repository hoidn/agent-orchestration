+"""Shared fixtures for derived_pure_replay.v1 tests: a small .orc with two commands and pure steps."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+
+SOURCE = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule replay_e2e)
+  (export orchestrate)
+  (defrecord Result (total Int) (label String))
+  (defworkflow orchestrate
+    ((count Int))
+    -> Result
+    (let* ((a (command-result step_a :argv ("python" "scripts/a.py") :returns Int))
+           (b (+ a count))
+           (c (if (> b 5) (command-result step_c :argv ("python" "scripts/c.py") :returns Int) 0))
+           (d (+ b c)))
+      (record Result :total d :label "done"))))
+"""
+
+CONDITION = "replay_e2e::orchestrate__c__condition"
+TERMINAL = "replay_e2e::orchestrate__terminal_projection"
+STEP_A = "replay_e2e::orchestrate__a__step_a"
+STEP_C = "replay_e2e::orchestrate__c.then.replay_e2e::orchestrate__c__then__step_c"
+
+
+def command_script(name: str, value: int) -> str:
+    """A command that counts its invocations in calls_<name>.log and emits ``value``."""
+    return (
+        "import os, pathlib, json\n"
+        f"pathlib.Path('calls_{name}.log').open('a').write('x')\n"
+        'bundle = pathlib.Path(os.environ["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])\n'
+        "bundle.parent.mkdir(parents=True, exist_ok=True)\n"
+        f"bundle.write_text(json.dumps({value}))\n"
+    )
+
+
+def compile_scenario(workspace: Path, *, a_value: int = 10, c_value: int = 5):
+    (workspace / "scripts").mkdir(exist_ok=True)
+    (workspace / "scripts" / "a.py").write_text(command_script("a", a_value), encoding="utf-8")
+    (workspace / "scripts" / "c.py").write_text(command_script("c", c_value), encoding="utf-8")
+    (workspace / "replay_e2e.orc").write_text(SOURCE, encoding="utf-8")
+    result = compile_stage3_entrypoint(
+        workspace / "replay_e2e.orc",
+        source_roots=(workspace,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={
+            "step_a": ExternalToolBinding(name="step_a", stable_command=("python", "scripts/a.py")),
+            "step_c": ExternalToolBinding(name="step_c", stable_command=("python", "scripts/c.py")),
+        },
+        validate_shared=True,
+        workspace_root=workspace,
+    )
+    return next(b for n, b in result.validated_bundles_by_name.items() if n.endswith("orchestrate"))
+
+
+def call_count(workspace: Path, name: str) -> int:
+    path = workspace / f"calls_{name}.log"
+    return len(path.read_text(encoding="utf-8")) if path.exists() else 0
+
+
+def read_state(state_manager) -> dict:
+    return json.loads(state_manager.state_file.read_text(encoding="utf-8"))

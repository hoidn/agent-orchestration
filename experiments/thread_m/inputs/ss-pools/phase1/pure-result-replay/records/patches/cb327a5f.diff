+"""Value-free completion shell, progress classification, and atomic visit/settle."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import DERIVED_PURE_REPLAY_PROFILE, StateManager, StepResult
+from orchestrator.workflow.outcomes import OutcomeRecorder
+from orchestrator.workflow.pure_result_replay import (
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+WITNESS = PureReplayVisitWitness("pure::a", 3, "root.pure_a", 1)
+SHELL = {
+    "name": "pure::a",
+    "step_id": "root.pure_a",
+    "visit_count": 1,
+    "status": "completed",
+    "exit_code": 0,
+    "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+    "result_storage": "derived_pure_replay.v1",
+}
+CURSOR = {
+    "name": "pure::a", "index": 3, "type": "pure_projection", "step_id": "root.pure_a",
+    "visit_count": 1, "status": "running", "started_at": "t", "last_heartbeat_at": "t",
+}
+UNRELATED_CURSOR = {**CURSOR, "name": "other", "step_id": "root.other"}
+FAILED = {"name": "pure::a", "step_id": "root.pure_a", "visit_count": 1, "status": "failed", "exit_code": 2}
+
+
+def _state(visit=None, cursor=None, row=None):
+    state = {"step_visits": {}, "steps": {}, "current_step": cursor}
+    if visit is not None:
+        state["step_visits"]["pure::a"] = visit
+    if row is not None:
+        state["steps"]["pure::a"] = row
+    return state
+
+
+def test_shell_is_the_exact_value_free_row():
+    assert build_pure_completion_shell(WITNESS) == SHELL
+
+
+@pytest.mark.parametrize("extra", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_validation_rejects_extra_keys(extra):
+    with pytest.raises(ValueError, match=extra):
+        validate_pure_completion_shell({**SHELL, extra: 1}, witness=WITNESS)
+
+
+@pytest.mark.parametrize("missing", sorted(SHELL))
+def test_shell_validation_rejects_missing_keys(missing):
+    row = {k: v for k, v in SHELL.items() if k != missing}
+    with pytest.raises(ValueError, match=missing):
+        validate_pure_completion_shell(row, witness=WITNESS)
+
+
+@pytest.mark.parametrize(
+    "key,value",
+    [("name", "x"), ("step_id", "x"), ("visit_count", 2), ("status", "failed"), ("exit_code", 1),
+     ("outcome", {"status": "completed"}), ("result_storage", "other")],
+)
+def test_shell_validation_rejects_wrong_values(key, value):
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell({**SHELL, key: value}, witness=WITNESS)
+
+
+def test_shell_validation_accepts_the_exact_shell():
+    validate_pure_completion_shell(copy.deepcopy(SHELL), witness=WITNESS)
+
+
+@pytest.mark.parametrize(
+    "state,expected",
+    [
+        (_state(), "unstarted"),
+        (_state(cursor=UNRELATED_CURSOR), "unstarted"),
+        (_state(visit=1, cursor=CURSOR), "interrupted"),
+        (_state(visit=1, row=SHELL), "derived_complete"),
+        (_state(visit=1, row=SHELL, cursor=UNRELATED_CURSOR), "derived_complete"),
+        (_state(visit=1, row=FAILED), "durable_failure_skip"),
+        (_state(visit=1, row={**FAILED, "status": "skipped"}), "durable_failure_skip"),
+    ],
+)
+def test_classify_valid_states(state, expected):
+    assert classify_pure_replay_progress(state, witness=WITNESS) == expected
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _state(visit=1),
+        _state(cursor=CURSOR),
+        _state(row=SHELL),
+        _state(visit=1, cursor=CURSOR, row=SHELL),
+        _state(visit=1, cursor=CURSOR, row=FAILED),
+        _state(visit=2, cursor={**CURSOR, "visit_count": 2}),
+        _state(visit=2, row=SHELL),
+        _state(visit=1, cursor={**CURSOR, "visit_count": 2}),
+        _state(visit=1, cursor={**CURSOR, "step_id": "root.other"}),
+        _state(visit=1, cursor={**CURSOR, "index": 9}),
+        _state(visit=1, cursor={**CURSOR, "type": "command"}),
+        _state(visit=1, cursor={**CURSOR, "status": "failed"}),
+        _state(visit=1, cursor=UNRELATED_CURSOR),
+        _state(visit=1, row={**SHELL, "artifacts": {"x": 1}}),
+        _state(visit=1, row={**FAILED, "visit_count": 2}),
+        _state(visit=1, row={**FAILED, "step_id": "root.other"}),
+        _state(visit=1, row={**FAILED, "status": "running"}),
+    ],
+)
+def test_classify_rejects_inconsistent_states(state):
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        classify_pure_replay_progress(state, witness=WITNESS)
+    assert excinfo.value.reason == PROGRESS_WITNESS_INVALID
+    assert excinfo.value.code == "pure_result_replay_unavailable"
+
+
+@pytest.fixture
+def manager(tmp_path: Path) -> StateManager:
+    (tmp_path / "wf.orc").write_text("(workflow-lisp)\n", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="run-1")
+    manager.initialize("wf.orc", result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+    return manager
+
+
+def _disk(manager: StateManager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def test_begin_publishes_visit_and_matching_cursor_atomically(manager):
+    visit = manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+
+    on_disk = _disk(manager)
+    assert visit == 1
+    assert on_disk["step_visits"] == {"pure::a": 1}
+    assert {k: on_disk["current_step"][k] for k in ("name", "index", "type", "step_id", "visit_count", "status")} == {
+        "name": "pure::a", "index": 3, "type": "pure_projection", "step_id": "root.pure_a",
+        "visit_count": 1, "status": "running",
+    }
+    assert {"started_at", "last_heartbeat_at"} <= set(on_disk["current_step"])
+
+
+def test_reuse_returns_same_visit_without_writing(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    before = manager.state_file.read_bytes()
+
+    assert manager.reuse_interrupted_eligible_pure_visit(WITNESS) == 1
+    assert manager.state_file.read_bytes() == before
+
+
+def test_reuse_requires_an_interrupted_visit(manager):
+    with pytest.raises(ValueError):
+        manager.reuse_interrupted_eligible_pure_visit(WITNESS)
+
+
+def test_settle_success_persists_exact_shell_and_clears_cursor(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+
+    shell = manager.settle_eligible_pure_success(WITNESS)
+
+    on_disk = _disk(manager)
+    assert shell == SHELL
+    assert on_disk["steps"]["pure::a"] == SHELL
+    assert "current_step" not in on_disk
+    assert on_disk["private_artifact_versions"] == {}
+
+
+def test_settle_success_without_cursor_fails_and_writes_nothing(manager):
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError):
+        manager.settle_eligible_pure_success(WITNESS)
+    assert manager.state_file.read_bytes() == before
+
+
+def test_settle_failure_persists_full_row_and_clears_cursor(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+
+    result = manager.settle_eligible_pure_failure(WITNESS, StepResult(status="failed", exit_code=2, error={"type": "x"}))
+
+    on_disk = _disk(manager)
+    assert result is None
+    assert on_disk["steps"]["pure::a"]["status"] == "failed"
+    assert on_disk["steps"]["pure::a"]["error"] == {"type": "x"}
+    assert "current_step" not in on_disk
+
+
+def test_outcome_recorder_settles_success_as_shell_but_returns_full_result(manager):
+    emitted = []
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: "root.pure_a",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, row: emitted.append(row),
+    )
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    state = {"steps": {}, "step_visits": {"pure::a": 1}}
+
+    finalized = recorder.persist_step_result(
+        state, "pure::a", {}, {"status": "completed", "exit_code": 0, "artifacts": {"v": 7}},
+        eligible_pure_settlement=WITNESS,
+    )
+
+    assert finalized["artifacts"] == {"v": 7}
+    assert state["steps"]["pure::a"]["artifacts"] == {"v": 7}
+    assert _disk(manager)["steps"]["pure::a"] == SHELL
+    assert emitted == [SHELL]
+
+
+def test_outcome_recorder_settles_failure_as_full_row(manager):
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: "root.pure_a",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda *args: None,
+    )
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    state = {"steps": {}, "step_visits": {"pure::a": 1}}
+
+    recorder.persist_step_result(
+        state, "pure::a", {}, {"status": "failed", "exit_code": 2, "error": {"type": "boom"}},
+        eligible_pure_settlement=WITNESS,
+    )
+
+    row = _disk(manager)["steps"]["pure::a"]
+    assert (row["status"], row["error"], row["visit_count"]) == ("failed", {"type": "boom"}, 1)

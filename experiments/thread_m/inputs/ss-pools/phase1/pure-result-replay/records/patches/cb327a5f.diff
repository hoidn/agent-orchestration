+    bad = _clone_pure(bundle, pure.node_id, new_id="root.bad", binding_refs={"y": "not-an-int"}, bindings={"y": {"type": INT}})
+    broken = _with_pure_nodes(bundle, {**bundle.ir.nodes, "root.bad": bad})

+"""result_persistence_profile selector: state field, initialization, loading, call-frame state."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import DERIVED_PURE_REPLAY_PROFILE, RunState, StateManager
+from tests.pure_replay_helpers import compile_scenario
+from orchestrator.workflow.call_frame_state import (
+    _CallFrameStateManager,
+    load_existing_call_frame_read_only,
+)
+
+
+def _run_state(**kwargs) -> RunState:
+    return RunState(
+        schema_version="2.1", run_id="r", workflow_file="w", workflow_checksum="c",
+        started_at="t", updated_at="t", status="running", **kwargs,
+    )
+
+
+@pytest.fixture
+def workspace(tmp_path: Path) -> Path:
+    (tmp_path / "wf.yaml").write_text("version: '1.1'\nsteps: []\n", encoding="utf-8")
+    return tmp_path
+
+
+def test_absent_profile_is_omitted_and_round_trips_unchanged():
+    payload = _run_state().to_dict()
+
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None
+    assert RunState.from_dict(payload).to_dict() == payload
+
+
+def test_present_profile_round_trips():
+    payload = _run_state(result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE).to_dict()
+
+    assert payload["result_persistence_profile"] == "derived_pure_replay.v1"
+    assert RunState.from_dict(payload).result_persistence_profile == DERIVED_PURE_REPLAY_PROFILE
+
+
+def test_unsupported_profile_fails_closed_at_construction():
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        _run_state(result_persistence_profile="derived_pure_replay.v2")
+
+
+def test_initialize_writes_profile_in_the_first_atomic_write(workspace):
+    manager = StateManager(workspace, run_id="r1")
+
+    manager.initialize("wf.yaml", result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+
+    assert json.loads(manager.state_file.read_text())["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+
+
+def test_initialize_rejects_unsupported_profile_before_any_write(workspace):
+    manager = StateManager(workspace, run_id="r1")
+
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        manager.initialize("wf.yaml", result_persistence_profile="bogus")
+
+    assert not manager.run_root.exists()
+
+
+def test_load_never_infers_or_backfills_the_profile(workspace):
+    manager = StateManager(workspace, run_id="r1")
+    manager.initialize("wf.yaml")
+    before = manager.state_file.read_bytes()
+
+    loaded = StateManager(workspace, run_id="r1").load()
+
+    assert loaded.result_persistence_profile is None
+    assert manager.state_file.read_bytes() == before
+
+
+def test_load_of_unsupported_profile_fails_and_leaves_bytes_unchanged(workspace):
+    manager = StateManager(workspace, run_id="r1")
+    manager.initialize("wf.yaml")
+    payload = json.loads(manager.state_file.read_text())
+    payload["result_persistence_profile"] = "bogus"
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        StateManager(workspace, run_id="r1").load()
+
+    assert manager.state_file.read_bytes() == before
+
+
+class _Parent:
+    """Minimal ParentCallStateManager for frame construction."""
+
+    def __init__(self, workspace: Path):
+        self.workspace = workspace
+        self.run_id = "r1"
+        self.run_root = workspace / ".orchestrate" / "runs" / "r1"
+        self.frames: dict = {}
+
+    def calculate_checksum(self, path):
+        return "sha256:x"
+
+    def update_call_frame(self, frame_id, snapshot):
+        self.frames[frame_id] = snapshot
+
+
+def _frame(parent, *, existing=None, select=False, frame_id="f1"):
+    return _CallFrameStateManager(
+        parent_manager=parent, workflow=compile_scenario(parent.workspace), frame_id=frame_id, call_step_name="call",
+        call_step_id="root.call", import_alias="child", bound_inputs={}, existing_frame=existing,
+        select_derived_pure_replay=select,
+    )
+
+
+def test_fresh_frame_selects_profile_only_when_asked(tmp_path):
+    parent = _Parent(tmp_path)
+
+    assert _frame(parent, select=True, frame_id="a").state.result_persistence_profile == DERIVED_PURE_REPLAY_PROFILE
+    assert _frame(parent, select=False, frame_id="b").state.result_persistence_profile is None
+    assert parent.frames["a"]["state"]["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+
+
+def test_existing_frame_keeps_its_stored_profile_and_is_never_backfilled(tmp_path):
+    parent = _Parent(tmp_path)
+    historical = _frame(parent, frame_id="old").state.to_dict()
+
+    resumed = _frame(parent, existing={"state": historical}, select=True, frame_id="old")
+
+    assert resumed.state.result_persistence_profile is None
+
+
+@pytest.mark.parametrize("frame", [{}, {"state": None}, {"state": []}, {"state": "x"}])
+def test_malformed_existing_frame_is_rejected_before_anything_is_written(tmp_path, frame):
+    parent = _Parent(tmp_path)
+
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        _frame(parent, existing=frame)
+
+    assert parent.frames == {}
+    assert not parent.run_root.exists()
+
+
+def test_read_only_loader_returns_a_detached_copy_without_touching_disk(tmp_path):
+    frame = {"state": {"steps": {"a": {"status": "completed"}}}}
+
+    copied = load_existing_call_frame_read_only(frame)
+    copied["steps"]["a"]["status"] = "changed"
+
+    assert frame["state"]["steps"]["a"]["status"] == "completed"
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_read_only_loader_rejects_malformed_frames():
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        load_existing_call_frame_read_only({"state": 3})

@@ -0,0 +1,69 @@
+"""CLI selection of derived_pure_replay.v1 for typed public .orc runs."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+FIXTURE = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp" / "valid" / "pure_expr_selector_action_projection.orc"
+
+
+def _cli(workspace: Path, *args: str) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        [sys.executable, "-m", "orchestrator", *args],
+        cwd=workspace, capture_output=True, text=True, env={"PYTHONPATH": str(REPO_ROOT), "PATH": "/usr/bin:/bin"},
+    )
+
+
+def _states(workspace: Path) -> dict[str, dict]:
+    return {
+        path.parent.name: json.loads(path.read_text(encoding="utf-8"))
+        for path in (workspace / ".orchestrate" / "runs").glob("*/state.json")
+    }
+
+
+def _run_orc(workspace: Path) -> dict[str, dict]:
+    (workspace / FIXTURE.name).write_text(FIXTURE.read_text(encoding="utf-8"), encoding="utf-8")
+    result = _cli(workspace, "run", FIXTURE.name, "--input", "status=WAIT", "--input", "approved=false")
+    assert result.returncode == 0, result.stderr
+    return _states(workspace)
+
+
+def test_orc_run_selects_the_profile_and_stays_value_free(tmp_path):
+    (state,) = _run_orc(tmp_path).values()
+
+    assert state["result_persistence_profile"] == "derived_pure_replay.v1"
+    assert all(row.get("result_storage") == "derived_pure_replay.v1" for row in state["steps"].values())
+
+
+def test_force_restart_selects_the_profile_for_the_new_root_and_leaves_the_source_unchanged(tmp_path):
+    (source_id, _), = _run_orc(tmp_path).items()
+    state_file = tmp_path / ".orchestrate" / "runs" / source_id / "state.json"
+    before = state_file.read_bytes()
+
+    result = _cli(tmp_path, "resume", source_id, "--force-restart", "--summary-mode", "sync")
+
+    assert result.returncode == 0, result.stderr
+    assert state_file.read_bytes() == before
+    states = _states(tmp_path)
+    (new_id,) = set(states) - {source_id}
+    assert states[new_id]["result_persistence_profile"] == "derived_pure_replay.v1"
+    assert "sync" in json.dumps(states[new_id]["observability"])
+    assert "sync" not in json.dumps(json.loads(before).get("observability"))
+
+
+def test_unsupported_profile_on_disk_fails_resume_without_rewriting_state(tmp_path):
+    (source_id, state), = _run_orc(tmp_path).items()
+    state["result_persistence_profile"] = "bogus"
+    state_file = tmp_path / ".orchestrate" / "runs" / source_id / "state.json"
+    state_file.write_text(json.dumps(state), encoding="utf-8")
+    before = state_file.read_bytes()
+
+    result = _cli(tmp_path, "resume", source_id)
+
+    assert result.returncode != 0
+    assert "result_persistence_profile" in result.stderr
+    assert state_file.read_bytes() == before

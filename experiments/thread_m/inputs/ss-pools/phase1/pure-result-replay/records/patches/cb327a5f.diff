@@ -0,0 +1,681 @@
+"""End-to-end behaviour of derived_pure_replay.v1: clean runs, resume, fail-closed replay."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.contracts.output_contract import ContractViolation, OutputContractError
+from orchestrator.state import DERIVED_PURE_REPLAY_PROFILE, StateManager
+from orchestrator.workflow import pure_result_replay_executor as replay_glue
+from orchestrator.workflow.executable_ir import NodeResultAddress, WorkflowInputAddress
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_expr import PureExprEvaluationError
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+)
+from orchestrator.workflow.resume_planner import ResumePlanner
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.pure_replay_helpers import (
+    CONDITION, STEP_A, STEP_C, TERMINAL, call_count, command_script, compile_scenario, read_state,
+)
+
+SHELL_KEYS = {"name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage"}
+
+
+def _manager(workspace, bundle, *, profile, run_id="r1", count=1) -> StateManager:
+    manager = StateManager(workspace, run_id=run_id)
+    manager.initialize(
+        str(bundle.provenance.workflow_path), bound_inputs={"count": count}, result_persistence_profile=profile
+    )
+    return manager
+
+
+def _run(workspace, bundle, *, profile, run_id="r1"):
+    manager = _manager(workspace, bundle, profile=profile, run_id=run_id)
+    result = WorkflowExecutor(bundle, workspace, manager, retry_delay_ms=0).execute()
+    return manager, result
+
+
+def _interrupt_before_step_c(workspace, bundle, monkeypatch, *, profile=DERIVED_PURE_REPLAY_PROFILE):
+    """Crash after step A and the pure condition committed, before step C starts."""
+    manager = _manager(workspace, bundle, profile=profile)
+    original = StateManager.start_step
+
+    def crash(self, name, *args, **kwargs):
+        if name == STEP_C:
+            raise KeyboardInterrupt("simulated crash")
+        return original(self, name, *args, **kwargs)
+
+    monkeypatch.setattr(StateManager, "start_step", crash)
+    with pytest.raises(KeyboardInterrupt):
+        WorkflowExecutor(bundle, workspace, manager, retry_delay_ms=0).execute()
+    monkeypatch.setattr(StateManager, "start_step", original)
+    return manager
+
+
+def _resume(workspace, bundle, run_id="r1"):
+    manager = StateManager(workspace, run_id=run_id)
+    return WorkflowExecutor(bundle, workspace, manager, retry_delay_ms=0).execute(resume=True)
+
+
+@pytest.fixture
+def bundle(tmp_path):
+    return compile_scenario(tmp_path)
+
+
+def test_clean_profiled_run_leaves_pure_results_value_free(tmp_path, bundle):
+    manager, result = _run(tmp_path, bundle, profile=DERIVED_PURE_REPLAY_PROFILE)
+    state = read_state(manager)
+
+    assert result["status"] == "completed"
+    assert set(state["steps"][TERMINAL]) == SHELL_KEYS
+    assert set(state["steps"][CONDITION]) == SHELL_KEYS
+    assert state["private_artifact_versions"] == {}
+    bundles = [p for p in (tmp_path / ".orchestrate").rglob("*result_bundle.json") if "terminal_projection" in p.name]
+    assert bundles == []
+
+
+def test_profiled_run_outputs_equal_historical_outputs(tmp_path_factory):
+    outputs = []
+    for profile in (None, DERIVED_PURE_REPLAY_PROFILE):
+        workspace = tmp_path_factory.mktemp("ws")
+        manager, result = _run(workspace, compile_scenario(workspace), profile=profile)
+        outputs.append((result["status"], result["workflow_outputs"], read_state(manager)["workflow_outputs"]))
+
+    assert outputs[0] == outputs[1]
+
+
+def test_clean_profiled_run_writes_no_pure_checkpoint_authority(tmp_path, bundle):
+    manager, _ = _run(tmp_path, bundle, profile=DERIVED_PURE_REPLAY_PROFILE)
+    pure_step_ids = {n.step_id for n in bundle.ir.nodes.values() if n.kind.value == "pure_projection"}
+
+    records = list((manager.run_root / "workflow_lisp" / "checkpoints" / "records").rglob("*.json"))
+
+    assert records, "effect boundaries still checkpoint"
+    for path in records:
+        record = json.loads(path.read_text())
+        assert record["pending_effect_policy"]["effect_kind"] != "pure_projection"
+        for binding in (record.get("restore_payload") or {}).get("bindings", []):
+            assert binding.get("source_step_id") not in pure_step_ids
+
+
+def test_historical_run_is_unchanged(tmp_path, bundle):
+    manager, _ = _run(tmp_path, bundle, profile=None)
+    state = read_state(manager)
+
+    assert "result_persistence_profile" not in state
+    assert state["steps"][TERMINAL]["artifacts"] == {"return__total": 16, "return__label": "done"}
+
+
+def test_resume_after_interruption_reproduces_outputs_and_reruns_no_committed_effect(tmp_path, bundle, monkeypatch):
+    _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    replayed = []
+    original = replay_glue.evaluate_node
+
+    def spying(executor):
+        evaluate = original(executor)
+
+        def wrapped(node, view):
+            replayed.append(node.presentation_key)
+            return evaluate(node, view)
+
+        return wrapped
+
+    monkeypatch.setattr(replay_glue, "evaluate_node", spying)
+
+    result = _resume(tmp_path, bundle)
+
+    assert result["status"] == "completed"
+    assert result["workflow_outputs"] == {"return__total": 16, "return__label": "done"}
+    assert (call_count(tmp_path, "a"), call_count(tmp_path, "c")) == (1, 1)
+    assert CONDITION in replayed
+    state = read_state(StateManager(tmp_path, run_id="r1"))
+    assert set(state["steps"][TERMINAL]) == SHELL_KEYS
+
+
+def test_resume_matches_an_uninterrupted_historical_run(tmp_path_factory, monkeypatch):
+    base = tmp_path_factory.mktemp("hist")
+    _, historical = _run(base, compile_scenario(base), profile=None)
+    workspace = tmp_path_factory.mktemp("prof")
+    bundle = compile_scenario(workspace)
+    _interrupt_before_step_c(workspace, bundle, monkeypatch)
+
+    resumed = _resume(workspace, bundle)
+
+    assert resumed["workflow_outputs"] == historical["workflow_outputs"]
+
+
+def test_replay_never_writes_durable_state(tmp_path, bundle, monkeypatch):
+    manager = _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    executor = WorkflowExecutor(bundle, tmp_path, StateManager(tmp_path, run_id="r1"), retry_delay_ms=0)
+    executor.state_manager.load()
+    state = executor.state_manager.state.to_dict()
+    runtime = replay_glue.runtime_for(executor)
+    before = manager.state_file.read_bytes()
+    node_id = runtime.node_id_for_step_id(bundle.ir.nodes[next(
+        n for n in bundle.ir.nodes if bundle.ir.nodes[n].presentation_name == CONDITION)].step_id)
+
+    row = runtime.replay_node(node_id, state=state, evaluate_node=replay_glue.evaluate_node(executor))
+
+    assert row["artifacts"]["__result__"] is True
+    assert manager.state_file.read_bytes() == before
+    assert state["steps"][CONDITION] == {k: state["steps"][CONDITION][k] for k in SHELL_KEYS}
+
+
+def _error_from_resume(workspace, bundle):
+    result = _resume(workspace, bundle)
+    assert result["status"] == "failed"
+    assert result["error"]["type"] == "pure_result_replay_unavailable"
+    return result["error"]["context"]["reason"], result["error"]["context"]
+
+
+def _corrupt(manager, mutate):
+    state = read_state(manager)
+    mutate(state)
+    manager.state_file.write_text(json.dumps(state), encoding="utf-8")
+
+
+def test_missing_bound_input_fails_closed_before_any_effect(tmp_path, bundle, monkeypatch):
+    manager = _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    _corrupt(manager, lambda s: s["bound_inputs"].pop("count"))
+
+    reason, _ = _error_from_resume(tmp_path, bundle)
+
+    assert reason == "durable_input_missing"
+    assert call_count(tmp_path, "c") == 0
+
+
+def test_wrong_typed_bound_input_fails_closed(tmp_path, bundle, monkeypatch):
+    manager = _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    _corrupt(manager, lambda s: s["bound_inputs"].__setitem__("count", "not-an-int"))
+
+    reason, _ = _error_from_resume(tmp_path, bundle)
+
+    assert reason == "durable_input_invalid"
+    assert call_count(tmp_path, "c") == 0
+
+
+def test_missing_durable_effect_result_fails_closed(tmp_path, bundle, monkeypatch):
+    manager = _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    _corrupt(manager, lambda s: s["steps"][STEP_A]["artifacts"].clear())
+
+    reason, _ = _error_from_resume(tmp_path, bundle)
+
+    assert reason == "durable_input_missing"
+
+
+@pytest.mark.parametrize(
+    "target,exception,reason,cause",
+    [
+        ("evaluate_pure_expr", PureExprEvaluationError("pure_expr_x", "boom"), "evaluation_failed", "pure_evaluation_failed"),
+        ("_pure_projection_artifacts", OutputContractError([ContractViolation(type="invalid_value", message="bad", context={})]), "output_contract_invalid", "pure_projection_contract_invalid"),
+    ],
+)
+def test_rederivation_failures_map_to_typed_reasons(tmp_path, bundle, monkeypatch, target, exception, reason, cause):
+    _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+
+    def raiser(*args, **kwargs):
+        raise exception
+
+    if target == "evaluate_pure_expr":
+        monkeypatch.setattr(replay_glue, "evaluate_pure_expr", raiser)
+    else:
+        monkeypatch.setattr(WorkflowExecutor, target, raiser)
+
+    got_reason, context = _error_from_resume(tmp_path, bundle)
+
+    assert got_reason == reason
+    assert context["cause"] == {"type": cause}
+    assert call_count(tmp_path, "c") == 0
+
+
+def test_unresolved_binding_maps_to_binding_unresolved(tmp_path, bundle, monkeypatch):
+    _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    monkeypatch.setattr(
+        WorkflowExecutor, "_resolve_pure_projection_bindings", lambda self, *a, **k: (None, {"error": "nope"})
+    )
+
+    reason, context = _error_from_resume(tmp_path, bundle)
+
+    assert reason == "binding_unresolved"
+    assert context["cause"] == {"type": "materialize_ref_unresolved"}
+
+
+def test_visit_two_shell_is_rejected_before_the_prologue(tmp_path, bundle, monkeypatch):
+    manager = _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+    _corrupt(manager, lambda s: s["step_visits"].__setitem__(CONDITION, 2))
+    before = manager.state_file.read_bytes()
+    result = _resume(tmp_path, bundle)
+
+    assert result["error"]["context"]["reason"] == "progress_witness_invalid"
+    assert call_count(tmp_path, "c") == 0
+    assert json.loads(before)["bound_inputs"].keys() == read_state(manager)["bound_inputs"].keys()
+
+
+def test_visit_two_cursor_is_rejected(tmp_path, bundle, monkeypatch):
+    manager = _interrupt_before_step_c(tmp_path, bundle, monkeypatch)
+
+    def mutate(state):
+        state["step_visits"][TERMINAL] = 2

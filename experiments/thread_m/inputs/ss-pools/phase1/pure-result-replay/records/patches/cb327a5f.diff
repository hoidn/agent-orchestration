+def _forge_record(manager, workspace, point, *, call_frame_id, payload):
+    """Write a checkpoint index entry + record for ``point`` as the runtime would."""
+    from orchestrator.workflow_lisp import lexical_checkpoints as checkpoints
+
+    index_path = checkpoints.resolve_checkpoint_index_path(
+        state_manager=manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+    )
+    record_path = index_path.parent.parent / "records" / f"{point.checkpoint_id}-forged.json"
+    record_path.parent.mkdir(parents=True, exist_ok=True)
+    record_path.write_text(json.dumps(payload), encoding="utf-8")
+    index_path.parent.mkdir(parents=True, exist_ok=True)
+    index_path.write_text(json.dumps({"records": [{
+        "record_id": "forged", "frame_identity": {"call_frame_id": call_frame_id},
+        "record_path": record_path.relative_to(workspace).as_posix(),
+    }]}), encoding="utf-8")
+    return index_path

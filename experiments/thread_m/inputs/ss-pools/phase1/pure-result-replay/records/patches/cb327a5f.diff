@@ -0,0 +1,129 @@
+"""Durable-surface and durable-leaf audits for the ``derived_pure_replay.v1`` profile."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from .executable_ir import NodeResultAddress, WorkflowInputAddress
+from .pure_result_replay_progress import (
+    PROFILE_CONFLICT,
+    PureResultReplayIndexError,
+    classify_pure_replay_progress,
+)
+
+_SHELL_KEYS = {"name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage"}
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _conflict(surface: str, node: Any) -> PureResultReplayIndexError:
+    return _error(
+        PROFILE_CONFLICT,
+        f"persisted {surface} exists for replay-eligible pure node {node.node_id!r}",
+        surface=surface,
+        node_id=node.node_id,
+    )
+
+
+def _type_ok(value: Any, definition: Mapping[str, Any]) -> bool:
+    declared = definition.get("type")
+    if declared == "bool":
+        return type(value) is bool
+    if declared == "integer":
+        return type(value) is int
+    if declared == "float":
+        return type(value) in {int, float}
+    if declared == "enum":
+        return isinstance(value, str) and value in definition.get("allowed", ())
+    if declared in {"string", "relpath"}:
+        return isinstance(value, str)
+    return True
+
+
+_INTRINSIC_CHECKS = {
+    "status": lambda v: isinstance(v, str),
+    "phase": lambda v: isinstance(v, str),
+    "class": lambda v: isinstance(v, str),
+    "retryable": lambda v: type(v) is bool,
+}
+
+
+def check_durable_leaf(runtime: Any, address: Any, state: Mapping[str, Any]) -> None:
+    """Raise durable_input_missing / durable_input_invalid unless the leaf exists with the right type."""
+    found, value = runtime.resolve_state_address(address, state)
+    if not found:
+        raise _error("durable_input_missing", f"durable input {address!r} is missing", address=repr(address))
+    ok = True
+    if isinstance(address, WorkflowInputAddress):
+        contract = runtime.bundle.ir.inputs.get(address.input_name)
+        ok = contract is None or _type_ok(value, contract.definition)
+    elif isinstance(address, NodeResultAddress):
+        if address.field == "exit_code":
+            ok = type(value) is int
+        elif address.field == "outcome" and address.member in _INTRINSIC_CHECKS:
+            ok = _INTRINSIC_CHECKS[address.member](value)
+    if not ok:
+        raise _error("durable_input_invalid", f"durable input {address!r} has the wrong type", address=repr(address))
+
+
+def _is_value_row(row: Any) -> bool:
+    return isinstance(row, Mapping) and row.get("status") == "completed" and not set(row) <= _SHELL_KEYS
+
+
+def _record_files(state_manager: Any, runtime_plan: Any, frame_id: Any):
+    from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_index_path
+
+    for point in getattr(runtime_plan, "lexical_checkpoint_points", ()):
+        index_path = resolve_checkpoint_index_path(
+            state_manager=state_manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+        )
+        if not index_path.exists():
+            continue
+        index = json.loads(index_path.read_text(encoding="utf-8"))
+        for entry in index.get("records", ()):
+            identity = entry.get("frame_identity") or {}
+            if identity.get("call_frame_id") != frame_id:
+                continue  # records of other frames are not this scope's authority
+            path = Path(state_manager.workspace) / entry.get("record_path", "")
+            if path.exists():
+                yield point, json.loads(path.read_text(encoding="utf-8"))
+
+
+def _audit_checkpoints(runtime: Any, state_manager: Any) -> None:
+    plan = runtime.bundle.runtime_plan
+    frame_id = getattr(state_manager, "frame_id", None)
+    for point, record in _record_files(state_manager, plan, frame_id):
+        for node in runtime.index.nodes.values():
+            if point.step_id == node.step_id:
+                raise _conflict("checkpoint_record", node)
+            payload = record.get("restore_payload") or {}
+            if any(b.get("source_step_id") == node.step_id for b in payload.get("bindings", ())):
+                raise _conflict("restore_payload", node)
+
+
+def audit_persisted_surfaces(
+    runtime: Any, *, state: Mapping[str, Any], state_manager: Any, resolve_bundle_path: Callable[[Any], Any]
+) -> None:
+    """Raise profile_conflict if any eligible node has a value row, bundle, lineage or checkpoint surface."""
+    steps = state.get("steps") or {}
+    lineage = state.get("private_artifact_versions") or {}
+    for node in runtime.index.nodes.values():
+        if _is_value_row(steps.get(node.presentation_key)):
+            raise _conflict("steps", node)
+        bundle_path = resolve_bundle_path(node)
+        if bundle_path is not None and Path(bundle_path).exists():
+            raise _conflict("pure_bundle", node)
+        for versions in lineage.values():
+            for entry in versions if isinstance(versions, list) else ():
+                if isinstance(entry, Mapping) and (
+                    entry.get("producer") in {node.step_id, node.presentation_key}
+                    or entry.get("producer_name") == node.presentation_key
+                ):
+                    raise _conflict("private_artifact_versions", node)
+    _audit_checkpoints(runtime, state_manager)
+    for node_id in runtime.index.nodes:
+        classify_pure_replay_progress(state, witness=runtime.witness_from_state(node_id, state))

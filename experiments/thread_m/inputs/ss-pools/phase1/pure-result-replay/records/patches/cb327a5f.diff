+        binding_refs={"x": {"ref": f"root.steps.{CONDITION}.artifacts.__result__"}, "y": 3},
+        bindings={"x": {"type": {"kind": "primitive", "name": "Bool"}}, "y": {"type": INT}},
+    )
+    index = derive_pure_result_replay_index(_with_pure_nodes(bundle, {**bundle.ir.nodes, second.node_id: second}))
+
+    assert index.nodes["root.derived"].pure_dependency_node_ids == (first.node_id,)
+    assert index.topological_node_ids.index(first.node_id) < index.topological_node_ids.index("root.derived")
+
+
+def test_wrong_typed_literal_fails(bundle):

+++ b/orchestrator/workflow/pure_result_replay_runtime.py
@@ -0,0 +1,284 @@
+"""In-memory replay of eligible pure projections at resume (``derived_pure_replay.v1``).
+
+Replay never dispatches an effect, increments a visit, settles a result, or
+writes durable state. A retained overlay row is never authority: every read
+revalidates the exact visit, cursor and row against the state it is given.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import fields, is_dataclass
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from ..contracts.output_contract import OutputContractError
+from .executable_ir import NodeResultAddress, WorkflowInputAddress
+from .pure_expr import PureExprEvaluationError
+from .pure_result_replay_index import PureReplayNode, PureResultReplayIndex, derive_pure_result_replay_index
+from .pure_result_replay_progress import (
+    DEPENDENCY_INDEX_INVALID,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+)
+from .pure_result_replay_surfaces import audit_persisted_surfaces, check_durable_leaf
+from .references import ReferenceResolutionError
+from .resume_projection_integrity import ResumeScopePath
+
+EvaluateNode = Callable[[PureReplayNode, Mapping[str, Any]], Mapping[str, Any]]
+
+
+def _unavailable(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def validate_row_artifacts(node: PureReplayNode, artifacts: Mapping[str, Any]) -> None:
+    """A row holds the discriminant, shared outputs and exactly the active variant's outputs."""
+    unknown = set(artifacts) - set(node.output_contracts)
+    if unknown:
+        raise _unavailable(DEPENDENCY_INDEX_INVALID, f"row of {node.node_id!r} has unknown outputs {sorted(unknown)}", node_id=node.node_id)
+    for name, contract in node.output_contracts.items():
+        projection = contract.get("projection") if isinstance(contract, Mapping) else None
+        active: Optional[bool] = True
+        if isinstance(projection, Mapping) and projection.get("field_role") == "variant":
+            discriminant = artifacts.get(projection.get("discriminant_output"))
+            active = discriminant in projection.get("active_variants", ())
+        if active and name not in artifacts:
+            raise _unavailable(DEPENDENCY_INDEX_INVALID, f"row of {node.node_id!r} is missing output {name!r}", node_id=node.node_id)
+        if not active and name in artifacts:
+            raise _unavailable(DEPENDENCY_INDEX_INVALID, f"row of {node.node_id!r} has inactive output {name!r}", node_id=node.node_id)
+
+
+def _walk_strings_and_addresses(value: Any, out_strings: list, out_addresses: list, seen: set) -> None:
+    if id(value) in seen:
+        return
+    seen.add(id(value))
+    if isinstance(value, str):
+        out_strings.append(value)
+    elif isinstance(value, NodeResultAddress):
+        out_addresses.append(value)
+    elif isinstance(value, Mapping):
+        for k, v in value.items():
+            _walk_strings_and_addresses(k, out_strings, out_addresses, seen)
+            _walk_strings_and_addresses(v, out_strings, out_addresses, seen)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for v in value:
+            _walk_strings_and_addresses(v, out_strings, out_addresses, seen)
+    elif is_dataclass(value) and not isinstance(value, type):
+        for f in fields(value):
+            _walk_strings_and_addresses(getattr(value, f.name), out_strings, out_addresses, seen)
+
+
+class PureReplayRuntime:
+    """Per-scope replay state for the eligible pure nodes of one bundle."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        # An imported callee indexes only its own nodes, under its own "root" scope.
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(bundle, scope_kind="root")
+        self._by_step_id = {n.step_id: n.node_id for n in self.index.nodes.values()}
+        self._active: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._overlay: dict[str, dict[str, Any]] = {}
+
+    # -- identity ---------------------------------------------------------
+    def node_id_for_step_id(self, step_id: Any) -> Optional[str]:
+        return self._by_step_id.get(step_id) if isinstance(step_id, str) else None
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self.index.nodes[node_id]
+        step_index = self.bundle.projection.compatibility_index_by_node_id.get(node_id)
+        if not isinstance(step_index, int):
+            raise _unavailable(DEPENDENCY_INDEX_INVALID, f"pure node {node_id!r} has no execution index", node_id=node_id)
+        return PureReplayVisitWitness(node.presentation_key, step_index, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        visits = state.get("step_visits")
+        visit = visits.get(self.index.nodes[node_id].presentation_key) if isinstance(visits, Mapping) else None
+        return self.witness(node_id, visit_count=visit if type(visit) is int else 1)
+
+    # -- active results and cache-hit revalidation --------------------------
+    def record_full_result(self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]) -> None:
+        """Hold an active executor's validated full result for this process only."""
+        node = self.index.nodes[node_id]
+        if witness != self.witness(node_id, visit_count=witness.visit_count) or witness.visit_count != 1:
+            raise _unavailable(PROGRESS_WITNESS_INVALID, f"witness does not identify pure node {node_id!r}", node_id=node_id)
+        if result.get("status") != "completed" or not isinstance(result.get("artifacts"), Mapping):
+            raise _unavailable(PROGRESS_WITNESS_INVALID, f"active result of {node_id!r} is not a completed value row", node_id=node_id)
+        validate_row_artifacts(node, result["artifacts"])
+        self._active[node_id] = (witness, copy.deepcopy(dict(result)))
+
+    def _revalidate(self, node_id: str, state: Mapping[str, Any]) -> str:
+        """Return 'shell' or 'active' when ``state`` legitimately shows this node complete."""
+        node = self.index.nodes[node_id]
+        witness = self.witness_from_state(node_id, state)
+        steps = state.get("steps")
+        row = steps.get(node.presentation_key) if isinstance(steps, Mapping) else None
+        cached = self._active.get(node_id)
+        if cached is not None and row == cached[1]:
+            visits = state.get("step_visits")
+            visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+            cursor = state.get("current_step")
+            related = isinstance(cursor, Mapping) and (
+                cursor.get("name") == node.presentation_key or cursor.get("step_id") == node.step_id
+            )
+            if type(visit) is not int or visit != 1 or cached[0] != witness or related:
+                raise _unavailable(PROGRESS_WITNESS_INVALID, f"active result of {node_id!r} fails revalidation", node_id=node_id)
+            return "active"
+        if classify_pure_replay_progress(state, witness=witness) != "derived_complete":
+            raise _unavailable(PROGRESS_WITNESS_INVALID, f"pure node {node_id!r} is not complete in the given state", node_id=node_id)
+        return "shell"
+
+    # -- replay -------------------------------------------------------------
+    def replay_node(self, node_id: str, *, state: Mapping[str, Any], evaluate_node: EvaluateNode) -> dict[str, Any]:
+        """Re-derive one completed node (after its pure dependencies) into the process-local overlay."""
+        node = self.index.nodes[node_id]
+        if self._revalidate(node_id, state) == "active":
+            return copy.deepcopy(self._active[node_id][1])
+        if node_id in self._overlay:
+            return copy.deepcopy(self._overlay[node_id])
+        for dep in node.pure_dependency_node_ids:
+            self.replay_node(dep, state=state, evaluate_node=evaluate_node)
+        view = self._view(state, only=node.pure_dependency_node_ids)
+        try:
+            artifacts = dict(evaluate_node(node, view))
+        except ReferenceResolutionError as exc:
+            raise _unavailable("binding_unresolved", f"binding of {node_id!r} is unresolved: {exc}",
+                               node_id=node_id, cause={"type": "materialize_ref_unresolved"}) from exc
+        except PureExprEvaluationError as exc:
+            raise _unavailable("evaluation_failed", f"evaluation of {node_id!r} failed: {exc}",
+                               node_id=node_id, cause={"type": "pure_evaluation_failed"}) from exc
+        except OutputContractError as exc:
+            raise _unavailable("output_contract_invalid", f"output contract of {node_id!r} is invalid",
+                               node_id=node_id, cause={"type": "pure_projection_contract_invalid"}) from exc
+        validate_row_artifacts(node, artifacts)
+        row = {**build_pure_completion_shell(self.witness_from_state(node_id, state)), "artifacts": artifacts}
+        self._overlay[node_id] = row
+        return copy.deepcopy(row)
+
+    def _row(self, node_id: str, state: Mapping[str, Any]) -> Optional[dict[str, Any]]:
+        if self._revalidate(node_id, state) == "active":
+            return self._active[node_id][1]
+        return self._overlay.get(node_id)
+
+    def _view(self, state: Mapping[str, Any], *, only: Iterable[str]) -> dict[str, Any]:
+        view = dict(state)
+        view["steps"] = dict(state.get("steps") or {})
+        for node_id in only:
+            view["steps"][self.index.nodes[node_id].presentation_key] = self._row(node_id, state)
+        return view
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Deep copy of ``state`` with replayed and active rows filled in; ``state`` itself stays value-free."""
+        result = copy.deepcopy(dict(state))
+        steps = result.setdefault("steps", {})
+        for node_id in [*self._overlay, *(n for n in self._active if n not in self._overlay)]:
+            row = self._row(node_id, state)
+            if row is not None:
+                steps[self.index.nodes[node_id].presentation_key] = copy.deepcopy(row)
+        return result
+
+    # -- address resolution -------------------------------------------------
+    def resolve_state_address(self, address: Any, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.input_name in inputs:
+                return True, inputs[address.input_name]
+            return False, None
+        node_id = getattr(address, "node_id", None)
+        node = self.bundle.ir.nodes.get(node_id)
+        if node is None:
+            raise _unavailable(DEPENDENCY_INDEX_INVALID, f"address {address!r} names no node of this scope", address=repr(address))
+        if node_id in self.index.nodes:
+            row = self._row(node_id, state)
+        else:
+            steps = state.get("steps")
+            row = steps.get(node.presentation_name) if isinstance(steps, Mapping) else None
+        if not isinstance(row, Mapping):
+            return False, None
+        field = getattr(address, "field", "artifacts")
+        member = getattr(address, "member", None) or getattr(address, "output_name", None)
+        value: Any = row.get(field)
+        if member is not None:
+            if not isinstance(value, Mapping) or member not in value:
+                return False, None
+            value = value[member]
+        elif field not in row:
+            return False, None
+        return True, value
+
+    def value_for_state_address(self, address: Any, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _unavailable("binding_unresolved", f"address {address!r} is not available", address=repr(address),
+                               cause={"type": "materialize_ref_unresolved"})
+        return value
+
+    # -- boundary -----------------------------------------------------------
+    def _top_level_position(self, node_id: str) -> Optional[int]:
+        order = self.bundle.projection.ordered_execution_node_ids()
+        parts = node_id.split(".")
+        for end in range(len(parts), 1, -1):
+            candidate = ".".join(parts[:end])
+            if candidate in order:
+                return order.index(candidate)
+        return None
+
+    def _nodes_at_or_after(self, restart_node_id: str) -> list[Any]:
+        boundary = self._top_level_position(restart_node_id)
+        if boundary is None:
+            raise _unavailable("reachability_ambiguous", f"restart node {restart_node_id!r} is not part of this scope", node_id=restart_node_id)
+        nodes = []
+        for node in self.bundle.ir.nodes.values():
+            position = self._top_level_position(node.node_id)
+            if position is None or position >= boundary:
+                nodes.append(node)
+        return nodes
+
+    def required_node_ids_for_boundary(self, restart_node_id: str, *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        """Complete eligible pure nodes that anything at or after the boundary may read (over-approximated)."""
+        strings: list[str] = []
+        addresses: list[Any] = []
+        seen: set[int] = set()
+        for node in self._nodes_at_or_after(restart_node_id):
+            _walk_strings_and_addresses(node, strings, addresses, seen)
+        _walk_strings_and_addresses(self.bundle.ir.outputs, strings, addresses, seen)
+        text = "\n".join(strings)
+        seeds = [a for a in addresses if a.node_id in self.index.nodes]
+        for node in self.index.nodes.values():
+            if f"steps.{node.presentation_key}." in text:
+                seeds.extend(node.output_addresses)
+        reached = [
+            nid for nid, node in self.index.nodes.items()
+            if classify_pure_replay_progress(state, witness=self.witness_from_state(nid, state)) == "derived_complete"
+        ]
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=reached)
+
+    def audit_boundary_leaves(self, restart_node_id: str, *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        """Check that the durable leaves of the required nodes exist and have the right type."""
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        for node_id in required:
+            for binding in self.index.nodes[node_id].bindings:
+                producer = getattr(binding.address, "node_id", None)
+                if producer in self.index.nodes:
+                    continue
+                check_durable_leaf(self, binding.address, state)
+        return required
+
+    def audit_persisted_surfaces(self, *, state: Mapping[str, Any], state_manager: Any, resolve_bundle_path: Callable[[PureReplayNode], Any]) -> None:
+        audit_persisted_surfaces(self, state=state, state_manager=state_manager, resolve_bundle_path=resolve_bundle_path)
+
+
+def runtime_from_state(state: Mapping[str, Any], loaded_workflow: Any) -> Optional[PureReplayRuntime]:
+    """The replay runtime for a profiled state and its bundle, or None when either is missing."""
+    from ..state import DERIVED_PURE_REPLAY_PROFILE
+    from .loaded_bundle import LoadedWorkflowBundle
+
+    if state.get("result_persistence_profile") != DERIVED_PURE_REPLAY_PROFILE:
+        return None
+    if not isinstance(loaded_workflow, LoadedWorkflowBundle):
+        return None
+    scope = ResumeScopePath.root(str(state.get("workflow_file") or "<unknown>"))
+    return PureReplayRuntime(bundle=loaded_workflow, scope_path=scope)

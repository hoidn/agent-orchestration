+def test_node_carries_identity_bindings_outputs_and_durable_dependencies(bundle):
+    index = derive_pure_result_replay_index(bundle)
+    node = next(n for n in index.nodes.values() if n.presentation_key == TERMINAL)
+
+    assert node.step_id == bundle.ir.nodes[node.node_id].step_id

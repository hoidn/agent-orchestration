+def _with_pure_nodes(bundle, nodes):
+    """Clone the bundle with the given node mapping replacing its IR nodes."""
+    return replace(bundle, ir=replace(bundle.ir, nodes=MappingProxyType(dict(nodes))))
+
+
+def _clone_pure(bundle, node_id, *, new_id, binding_refs, bindings, name=None):
+    original = bundle.ir.nodes[node_id]
+    config = dict(original.execution_config.pure_projection)
+    payload = dict(config["payload"])
+    payload["bindings"] = bindings
+    config.update(binding_refs=binding_refs, payload=payload)
+    clone = replace(
+        original,
+        node_id=new_id,
+        step_id=new_id,
+        presentation_name=name or new_id,
+        execution_config=replace(original.execution_config, pure_projection=MappingProxyType(config)),
+        fallthrough_node_id=None,
+    )
+    return clone
+
+
+def test_pure_nodes_of_a_straight_line_program_are_eligible(bundle):
+    index = derive_pure_result_replay_index(bundle)
+
+    assert index.scope_kind == "root"
+    assert set(index.nodes) >= {n for n in bundle.ir.nodes if bundle.ir.nodes[n].presentation_name == TERMINAL}
+    assert index.ineligible_pure_reasons == {}
+

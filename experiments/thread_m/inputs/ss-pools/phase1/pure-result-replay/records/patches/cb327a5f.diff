diff --git a/orchestrator/workflow/pure_result_replay_executor.py b/orchestrator/workflow/pure_result_replay_executor.py
new file mode 100644
index 0000000..ea9300f
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_executor.py
@@ -0,0 +1,136 @@
+"""Executor-side glue for the ``derived_pure_replay.v1`` result persistence profile.
+
+Every function is gated on (profile present AND the step is an eligible pure
+node); historical runs and ineligible nodes never reach this code.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Callable, Dict, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_expr import evaluate_pure_expr
+from .pure_result_replay_index import PureReplayNode
+from .pure_result_replay_progress import PureReplayVisitWitness, classify_pure_replay_progress
+from .pure_result_replay_runtime import PureReplayRuntime
+from .references import ReferenceResolutionError
+
+
+def profile_active(executor: Any) -> bool:
+    state = getattr(executor.state_manager, "state", None)
+    return getattr(state, "result_persistence_profile", None) == DERIVED_PURE_REPLAY_PROFILE
+
+
+def runtime_for(executor: Any) -> Optional[PureReplayRuntime]:
+    """The executor's replay runtime, or None for historical runs."""
+    if not profile_active(executor) or not isinstance(executor.loaded_bundle, LoadedWorkflowBundle):
+        return None
+    cached = getattr(executor, "_pure_replay_runtime", None)
+    if cached is None:
+        cached = PureReplayRuntime(bundle=executor.loaded_bundle, scope_path=executor.resume_scope_path)
+        executor._pure_replay_runtime = cached
+    return cached
+
+
+def eligible_node_id(executor: Any, step_id: Any) -> Optional[str]:
+    runtime = runtime_for(executor)
+    return runtime.node_id_for_step_id(step_id) if runtime is not None else None
+
+
+def durable_state_view(executor: Any) -> Dict[str, Any]:
+    """Authoritative (value-free) progress fields straight from the run state."""
+    state = executor.state_manager.state.to_dict()
+    return {key: state.get(key) for key in ("step_visits", "steps", "current_step")}
+
+
+def _witness(executor: Any, node_id: str) -> PureReplayVisitWitness:
+    return runtime_for(executor).witness(node_id)
+
+
+def begin_visit(executor: Any, state: Dict[str, Any], node_id: str) -> int:
+    """Publish (or, on resume, reuse) the single visit and running cursor of an eligible node."""
+    runtime = runtime_for(executor)
+    witness = _witness(executor, node_id)
+    node = runtime.index.nodes[node_id]
+    progress = classify_pure_replay_progress(durable_state_view(executor), witness=witness)
+    if progress == "interrupted":
+        visit = executor.state_manager.reuse_interrupted_eligible_pure_visit(witness)
+    else:
+        visit = executor.state_manager.begin_eligible_pure_visit(
+            step_name=node.presentation_key, step_index=witness.step_index, step_id=node.step_id
+        )
+    state.setdefault("step_visits", {})[node.presentation_key] = visit
+    return visit
+
+
+def persist_result(
+    executor: Any, node_id: str, state: Dict[str, Any], step_name: str, step: Any, result: Dict[str, Any], **hints: Any
+) -> Dict[str, Any]:
+    """Settle an eligible node: value-free shell on success, full row on failure or skip."""
+    runtime = runtime_for(executor)
+    witness = _witness(executor, node_id)
+    if classify_pure_replay_progress(durable_state_view(executor), witness=witness) == "unstarted":
+        # e.g. skipped by a branch guard before any visit: it still takes its single visit.
+        begin_visit(executor, state, node_id)
+    finalized = executor.outcome_recorder.persist_step_result(
+        state, step_name, step, result, eligible_pure_settlement=witness, **hints
+    )
+    if finalized.get("status") == "completed":
+        runtime.record_full_result(node_id, witness=witness, result=finalized)
+    return finalized
+
+
+def evaluate_node(executor: Any) -> Callable[[PureReplayNode, Dict[str, Any]], Dict[str, Any]]:
+    """Build the replay evaluator: the same resolve/evaluate/contract path as live execution, minus all writes."""
+
+    def evaluate(node: PureReplayNode, view: Dict[str, Any]) -> Dict[str, Any]:
+        step = executor._typed_execution_step(executor._runtime_step_for_node_id(node.node_id))
+        config = step.get("pure_projection")
+        resolved, error = executor._resolve_pure_projection_bindings(config["binding_refs"], view)
+        if error is not None:
+            raise ReferenceResolutionError(str(error.get("error") or error))
+        value = evaluate_pure_expr(config["payload"], resolved_bindings=resolved)
+        return executor._pure_projection_artifacts(value, output_contracts=config["output_contracts"])
+
+    return evaluate
+
+
+def bundle_path_resolver(executor: Any, state: Dict[str, Any]) -> Callable[[PureReplayNode], Optional[Path]]:
+    """Where a historical run would have written this node's pure result bundle."""
+
+    def resolve(node: PureReplayNode) -> Optional[Path]:
+        step = executor._typed_execution_step(executor._runtime_step_for_node_id(node.node_id))
+        _, bundle, error = executor._resolve_output_contract_paths(step, state)
+        raw = bundle.get("path") if error is None and isinstance(bundle, dict) else None
+        if not isinstance(raw, str) or not raw:
+            return None
+        return executor._bounded_private_runtime_bundle_path(
+            (executor.workspace / raw).resolve(), namespace="pure_projection"
+        )
+
+    return resolve
+
+
+def audit_before_prologue(executor: Any, state: Dict[str, Any]) -> None:
+    runtime_for(executor).audit_persisted_surfaces(
+        state=state,
+        state_manager=executor.state_manager,
+        resolve_bundle_path=bundle_path_resolver(executor, state),
+    )
+
+
+def replay_at_resume(executor: Any, state: Dict[str, Any], restart_node_id: Optional[str]) -> None:
+    """Re-derive every complete pure value the rest of the run may read, into the in-memory state only."""
+    runtime = runtime_for(executor)
+    if restart_node_id is None:
+        restart_node_id = executor.projection.ordered_execution_node_ids()[0]
+    required = runtime.audit_boundary_leaves(restart_node_id, state=state)
+    evaluate = evaluate_node(executor)
+    rows = {nid: runtime.replay_node(nid, state=state, evaluate_node=evaluate) for nid in required}
+    for nid, row in rows.items():
+        node = runtime.index.nodes[nid]
+        witness = runtime.witness_from_state(nid, state)
+        state["steps"][node.presentation_key] = row
+        runtime.record_full_result(nid, witness=witness, result=row)
diff --git a/orchestrator/workflow/pure_result_replay_index.py b/orchestrator/workflow/pure_result_replay_index.py
new file mode 100644
index 0000000..1ed18e6
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_index.py
@@ -0,0 +1,363 @@
+"""Derive which compiler-generated pure projections are replay-eligible, and what each depends on.
+
+Read-only over the loaded bundle: nothing here mutates or serializes the runtime plan.
+Part of the ``derived_pure_replay.v1`` profile (see ``specs/state.md``).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .pure_expr import _coerce_value, _descriptor_kind
+from .pure_result_replay_progress import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+from .references import ReferenceResolutionError, parse_structured_ref
+
+_ROOT_SCOPE = "root"
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    """One exact ref leaf of a binding value document."""
+
+    path: tuple[str, ...]
+    address: BoundAddress
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+
+    def required_pure_node_ids(
+        self, seed_addresses: Iterable[BoundAddress], *, reached_node_ids: Iterable[str]
+    ) -> tuple[str, ...]:
+        """Eligible pure nodes needed to rebuild ``seed_addresses``, restricted to reached nodes."""
+        produced = {a: n.node_id for n in self.nodes.values() for a in n.output_addresses}
+        pending: list[str] = []
+        for seed in seed_addresses:
+            if isinstance(seed, NodeResultAddress) and seed.node_id in self.nodes:
+                if seed not in produced:
+                    raise PureResultReplayIndexError(
+                        REACHABILITY_AMBIGUOUS,
+                        f"seed {seed!r} does not name an output of pure node {seed.node_id!r}",
+                        context={"node_id": seed.node_id},
+                    )
+                pending.append(seed.node_id)
+        needed: set[str] = set()
+        while pending:
+            node_id = pending.pop()
+            if node_id not in needed:
+                needed.add(node_id)
+                pending.extend(self.nodes[node_id].pure_dependency_node_ids)
+        reached = set(reached_node_ids)
+        return tuple(n for n in self.topological_node_ids if n in needed and n in reached)
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+def _is_ref_object(value: Any) -> bool:
+    return isinstance(value, Mapping) and "ref" in value
+
+
+def _check_ref_object(value: Mapping[str, Any], where: str) -> None:
+    if set(value) != {"ref"} or not isinstance(value["ref"], str) or not value["ref"]:
+        raise _invalid(f"malformed ref object at {where}", path=where)
+
+
+def _check_scalar(value: Any, descriptor: Mapping[str, Any], where: str) -> None:
+    if isinstance(value, str) and "${" in value:
+        raise _invalid(f"unbound text at {where}", path=where)
+    try:
+        _coerce_value(value, descriptor, context=where)
+    except ValueError as exc:
+        raise _invalid(f"literal at {where} does not match its declared type: {exc}", path=where) from exc
+
+
+def _declares_ref_field(descriptor: Mapping[str, Any]) -> bool:
+    groups = [descriptor.get("fields", ())] + [v.get("fields", ()) for v in descriptor.get("variants", ())]
+    return any(f.get("name") == "ref" for fields in groups for f in fields)
+
+
+def _check_union_literal(value: Mapping[str, Any], descriptor: Mapping[str, Any], path: tuple, leaves: list) -> None:
+    where = ".".join(path)
+    variants = {v["name"]: v for v in descriptor.get("variants", ())}
+    if not variants:  # variant_case descriptor
+        variants = {descriptor["variant"]: descriptor}
+    active = value.get("variant")
+    if _is_ref_object(active):
+        _check_ref_object(active, f"{where}.variant")
+        leaves.append((path + ("variant",), active["ref"]))
+    elif active not in variants:
+        raise _invalid(f"literal at {where} names unknown variant {active!r}", path=where)
+    field_types: dict[str, Mapping[str, Any]] = {}
+    for variant in variants.values():
+        for fld in variant.get("fields", ()):
+            field_types.setdefault(fld["name"], fld["type"])
+    extra = set(value) - set(field_types) - {"variant"}
+    if extra:
+        raise _invalid(f"literal at {where} has unexpected members {sorted(extra)}", path=where)
+    for fld in variants.get(active, {}).get("fields", ()):
+        if fld["name"] not in value:
+            raise _invalid(f"literal at {where} is missing active member {fld['name']!r}", path=where)
+    # Inactive members, when present, must still match their declared types.
+    for name, member in value.items():
+        if name != "variant":
+            _walk_document(member, field_types[name], path + (name,), leaves)
+
+
+def _walk_document(value: Any, descriptor: Mapping[str, Any], path: tuple, leaves: list) -> None:
+    where = ".".join(path)
+    if _is_ref_object(value) and not _declares_ref_field(descriptor):
+        _check_ref_object(value, where)
+        leaves.append((path, value["ref"]))
+        return
+    kind = _descriptor_kind(descriptor)
+    if kind == "optional":
+        if value is not None:
+            _walk_document(value, descriptor["item"], path, leaves)
+    elif kind == "list":
+        if not isinstance(value, (list, tuple)):
+            raise _invalid(f"literal at {where} must be a list", path=where)
+        for i, item in enumerate(value):
+            _walk_document(item, descriptor["item"], path + (str(i),), leaves)
+    elif kind == "map":
+        if not isinstance(value, Mapping):
+            raise _invalid(f"literal at {where} must be a map", path=where)
+        for key, item in value.items():
+            _check_scalar(key, descriptor["key"], f"{where}.key")
+            _walk_document(item, descriptor["value"], path + (str(key),), leaves)
+    elif kind == "record":
+        if not isinstance(value, Mapping):
+            raise _invalid(f"literal at {where} must be a record", path=where)
+        names = {f["name"]: f["type"] for f in descriptor["fields"]}
+        if set(value) != set(names):
+            raise _invalid(f"record literal at {where} has fields {sorted(value)}, expected {sorted(names)}", path=where)
+        for name, item in value.items():
+            _walk_document(item, names[name], path + (name,), leaves)
+    elif kind in {"union", "variant_case"}:
+        if not isinstance(value, Mapping):
+            raise _invalid(f"literal at {where} must be a union value", path=where)
+        _check_union_literal(value, descriptor, path, leaves)
+    else:
+        _check_scalar(value, descriptor, where)
+
+
+def _loop_owned_node_ids(ir_nodes: Mapping[str, Any]) -> set[str]:
+    owned: set[str] = set()
+    for node in ir_nodes.values():
+        if node.kind in {ExecutableNodeKind.FOR_EACH, ExecutableNodeKind.REPEAT_UNTIL_FRAME}:
+            owned.update(node.body_node_ids)
+    return owned
+
+
+def _cyclic_node_ids(ir_nodes: Mapping[str, Any]) -> set[str]:
+    """Nodes on a cycle of the fallthrough/routed-transfer graph (Tarjan SCC, iterative)."""
+    edges = {
+        nid: [t for t in ([n.fallthrough_node_id] + [x.target_node_id for x in n.routed_transfers.values()]) if t in ir_nodes]
+        for nid, n in ir_nodes.items()
+    }
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    stack: list[str] = []
+    on_stack: set[str] = set()
+    cyclic: set[str] = set()
+    counter = 0
+    for root in ir_nodes:
+        if root in index:
+            continue
+        work = [(root, iter(edges[root]))]
+        index[root] = low[root] = counter
+        counter += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            node, it = work[-1]
+            for nxt in it:
+                if nxt not in index:
+                    index[nxt] = low[nxt] = counter
+                    counter += 1
+                    stack.append(nxt)
+                    on_stack.add(nxt)
+                    work.append((nxt, iter(edges[nxt])))
+                    break
+                if nxt in on_stack:
+                    low[node] = min(low[node], index[nxt])
+            else:
+                work.pop()
+                if work:
+                    low[work[-1][0]] = min(low[work[-1][0]], low[node])
+                if low[node] == index[node]:
+                    component = []
+                    while True:
+                        member = stack.pop()
+                        on_stack.discard(member)
+                        component.append(member)
+                        if member == node:
+                            break
+                    if len(component) > 1 or node in edges[node]:
+                        cyclic.update(component)
+    return cyclic
+
+
+def _propagate_pure_ineligibility(raw_nodes: dict[str, dict[str, set[str]]], reasons: Mapping[str, str]) -> None:
+    """Demote pure dependencies on ineligible nodes to durable leaves.
+
+    Ineligible pure nodes keep full durable rows, so an eligible reader may read
+    them as ordinary durable results instead of replaying them.
+    """
+    for deps in raw_nodes.values():
+        for dep in [d for d in deps["pure"] if d in reasons]:
+            deps["pure"].discard(dep)
+            deps["durable"].add(dep)
+
+
+def _address_for(node: Any, field: str, member: Optional[str]) -> BoundAddress:
+    if field == "artifacts" and member:
+        cls = {
+            ExecutableNodeKind.IF_JOIN: BlockOutputAddress,
+            ExecutableNodeKind.MATCH_JOIN: BlockOutputAddress,
+            ExecutableNodeKind.REPEAT_UNTIL_FRAME: LoopOutputAddress,
+            ExecutableNodeKind.CALL_BOUNDARY: CallOutputAddress,
+        }.get(node.kind)
+        if cls is not None:
+            return cls(node_id=node.node_id, output_name=member)
+    return NodeResultAddress(node_id=node.node_id, field=field, member=member)
+
+
+def _check_identities(bundle: Any, ir_nodes: Mapping[str, Any]) -> None:
+    seen_step: dict[str, str] = {}
+    seen_key: dict[str, str] = {}
+    projection = getattr(bundle, "projection", None)
+    for nid, node in ir_nodes.items():
+        for seen, ident, label in ((seen_step, node.step_id, "step_id"), (seen_key, node.presentation_name, "presentation key")):
+            if ident in seen:
+                raise _invalid(f"duplicate projection authority for {label} {ident!r}", node_ids=[seen[ident], nid])
+            seen[ident] = nid
+        if projection is not None:
+            key = projection.presentation_key_by_node_id.get(nid)
+            owner = projection.node_id_by_step_id.get(node.step_id)
+            if (key is not None and key != node.presentation_name) or (owner is not None and owner != nid):
+                raise _invalid(f"projection identity mismatch for node {nid!r}", node_id=nid)
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = "root") -> PureResultReplayIndex:
+    """Derive the replay index for the nodes of ``bundle`` alone (an imported callee is its own ``root`` scope)."""
+    if scope_kind != _ROOT_SCOPE:
+        raise _invalid(
+            f"scope_kind {scope_kind!r} does not match the bundle scope {_ROOT_SCOPE!r}",
+            expected_scope=scope_kind,
+            actual_scope=_ROOT_SCOPE,
+        )
+    ir_nodes = bundle.ir.nodes
+    _check_identities(bundle, ir_nodes)
+    pure = {
+        nid: n for nid, n in ir_nodes.items()
+        if n.kind is ExecutableNodeKind.PURE_PROJECTION and n.execution_config is not None
+    }
+    loop_owned = _loop_owned_node_ids(ir_nodes)
+    cyclic = _cyclic_node_ids(ir_nodes)
+    reasons = {nid: MULTIPLE_VISIT_REGION for nid in pure if nid in loop_owned or nid in cyclic}
+    by_key = {n.presentation_name: n for n in ir_nodes.values()}
+
+    raw: dict[str, dict[str, set[str]]] = {}
+    bindings: dict[str, tuple[PureReplayBinding, ...]] = {}
+    for nid, node in pure.items():
+        if nid in reasons:
+            continue
+        config = node.execution_config.pure_projection
+        declared = config["payload"]["bindings"]
+        leaves: list = []
+        for name, document in config["binding_refs"].items():
+            if name not in declared:
+                raise _invalid(f"binding {name!r} of {nid!r} is not declared by its payload", node_id=nid)
+            _walk_document(document, declared[name]["type"], (name,), leaves)
+        node_bindings = []
+        deps = {"pure": set(), "durable": set()}
+        for path, ref in leaves:
+            address, producer = _resolve_ref(ref, by_key, nid)
+            node_bindings.append(PureReplayBinding(path=path, address=address))
+            if producer is not None:
+                deps["pure" if producer in pure else "durable"].add(producer)
+        raw[nid], bindings[nid] = deps, tuple(node_bindings)
+
+    _propagate_pure_ineligibility(raw, reasons)
+    order = _topological_order(raw)
+    nodes = {}
+    for nid in order:
+        node = pure[nid]
+        contracts = node.execution_config.pure_projection.get("output_contracts", {})
+        nodes[nid] = PureReplayNode(
+            node_id=nid,
+            step_id=node.step_id,
+            presentation_key=node.presentation_name,
+            bindings=bindings[nid],
+            output_addresses=tuple(NodeResultAddress(nid, "artifacts", name) for name in contracts),
+            output_contracts=contracts,
+            pure_dependency_node_ids=tuple(sorted(raw[nid]["pure"])),
+            durable_dependency_node_ids=tuple(sorted(raw[nid]["durable"])),
+        )
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=nodes,
+        topological_node_ids=order,
+        ineligible_pure_reasons=reasons,
+    )
+
+
+def _resolve_ref(ref: str, by_key: Mapping[str, Any], owner: str) -> tuple[BoundAddress, Optional[str]]:
+    if ref.startswith("inputs."):
+        return WorkflowInputAddress(input_name=ref[len("inputs."):]), None
+    try:
+        parsed = parse_structured_ref(ref, by_key)
+    except ReferenceResolutionError as exc:
+        raise _invalid(f"ref {ref!r} of {owner!r} is not resolvable in this scope: {exc}", ref=ref, node_id=owner) from exc
+    target = by_key.get(parsed.step_name)
+    if target is None:
+        raise _invalid(f"ref {ref!r} of {owner!r} names no step of this workflow (cross-frame ref)", ref=ref, node_id=owner)
+    return _address_for(target, parsed.field, parsed.member), target.node_id
+
+
+def _topological_order(raw: Mapping[str, Mapping[str, set[str]]]) -> tuple[str, ...]:
+    remaining = {nid: {d for d in deps["pure"] if d in raw} for nid, deps in raw.items()}
+    order: list[str] = []
+    while remaining:
+        ready = [nid for nid, deps in remaining.items() if not deps]
+        if not ready:
+            raise _invalid("pure dependency cycle", node_ids=sorted(remaining))
+        for nid in ready:
+            order.append(nid)
+            del remaining[nid]
+        for deps in remaining.values():
+            deps.difference_update(ready)
+    return tuple(order)

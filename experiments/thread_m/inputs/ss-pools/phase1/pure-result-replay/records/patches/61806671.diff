+
+    def _require_pure_progress(self, witness: Any, expected: str) -> None:
+        from .workflow.pure_replay_core import PROGRESS_WITNESS_INVALID, PureResultReplayIndexError
+
+        if not self.state:
+            raise RuntimeError("State not initialized")
+        progress = self._pure_progress(witness)
+        if progress != expected:
+            raise PureResultReplayIndexError(
+                PROGRESS_WITNESS_INVALID,
+                f"pure visit is {progress}; expected {expected}",
+                context={"presentation_key": witness.presentation_key, "progress": progress},
+            )
+
+    def _drop_skipped_row_without_visit(self, step_name: str) -> None:
+        """A skipped guard row from an earlier pass does not block a node that is now reached."""
+        row = self.state.steps.get(step_name)
+        status = row.get("status") if isinstance(row, Mapping) else getattr(row, "status", None)
+        if step_name not in self.state.step_visits and status == "skipped":
+            del self.state.steps[step_name]
+
+    def begin_eligible_pure_visit(self, *, step_name: str, step_index: int, step_id: str) -> int:
+        """Atomically record visit one and its running cursor; return the visit count."""
+        from .workflow.pure_replay_core import PURE_STEP_TYPE, PureReplayVisitWitness
+
+        with self._state_mutation():
+            witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+            self._drop_skipped_row_without_visit(step_name)
+            self._require_pure_progress(witness, "unstarted")
+            now = datetime.now(timezone.utc).isoformat()
+            self.state.step_visits[step_name] = 1
+            self.state.current_step = {
+                "name": step_name,
+                "index": step_index,
+                "type": PURE_STEP_TYPE,
+                "step_id": step_id,
+                "visit_count": 1,
+                "status": "running",
+                "started_at": now,
+                "last_heartbeat_at": now,
+            }
+            self._write_state()
+            return 1
+
+    def reuse_interrupted_eligible_pure_visit(self, witness: Any) -> int:
+        """Validate an interrupted pure visit without writing; return its visit count."""
+        with self._state_mutation():
+            self._require_pure_progress(witness, "interrupted")
+            return witness.visit_count
+
+    def settle_eligible_pure_success(self, witness: Any) -> Dict[str, Any]:

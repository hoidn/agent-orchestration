+    state = {
+        "steps": {witness.presentation_key: build_pure_completion_shell(witness)},
+        "step_visits": {witness.presentation_key: 1},
+        "current_step": None,
+        "bound_inputs": {},
+    }
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.audit_boundary_leaves(bundle.runtime_plan.ordered_node_ids[-1], state=state)
+    assert excinfo.value.reason == "binding_unresolved"
+    assert excinfo.value.context["cause"] == {"type": "materialize_ref_unresolved"}
+
+
+class _SidecarManager:
+    """Just enough of a state manager to serve checkpoint index/record sidecars."""
+
+    def __init__(self, workspace, payloads):
+        self.workspace = workspace
+        self.run_id = "audit"
+        self.payloads = payloads
+
+    def read_runtime_sidecar_json(self, path):
+        return self.payloads.get(Path(path))
+
+
+def _audit_surface(tmp_path, *, point_selector, frame_id=None, binding_source=None):
+    from orchestrator.workflow_lisp.lexical_checkpoints import (
+        resolve_checkpoint_index_path,
+        resolve_checkpoint_record_path,
+    )
+
+    bundle, runtime = _regions_runtime(tmp_path)
+    (eligible,) = runtime.index.nodes
+    point = next(p for p in bundle.runtime_plan.lexical_checkpoint_points if point_selector(p, eligible))
+    manager = _SidecarManager(tmp_path, {})
+    record_path = resolve_checkpoint_record_path(
+        state_manager=manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id, record_id="r1"
+    )
+    manager.payloads[resolve_checkpoint_index_path(
+        state_manager=manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+    )] = {"records": [{
+        "record_id": "r1", "frame_identity": {"call_frame_id": frame_id},
+        "record_path": record_path.relative_to(tmp_path).as_posix(),
+    }]}
+    manager.payloads[record_path] = {
+        "restore_payload": {"bindings": [{"source_step_id": binding_source}] if binding_source else []}
+    }
+    scope = ResumeScopePath.root("w.orc")
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=scope)
+    return runtime, manager, runtime.index.nodes[eligible].step_id
+
+
+def _audit(runtime, manager):
+    runtime.audit_persisted_surfaces(
+        state={"steps": {}, "step_visits": {}}, state_manager=manager, resolve_bundle_path=lambda _node_id: None
+    )
+
+
+def test_eligible_nodes_checkpoint_record_is_a_profile_conflict(tmp_path):
+    runtime, manager, _ = _audit_surface(tmp_path, point_selector=lambda p, eligible: p.node_id == eligible)
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        _audit(runtime, manager)
+    assert (excinfo.value.reason, excinfo.value.context["surface"]) == ("profile_conflict", "checkpoint_record")
+
+
+def test_checkpoint_records_of_other_frames_are_allowed(tmp_path):
+    runtime, manager, _ = _audit_surface(
+        tmp_path, point_selector=lambda p, eligible: p.node_id == eligible, frame_id="other-frame"
+    )
+    _audit(runtime, manager)
+
+
+def test_restore_binding_sourced_from_an_eligible_pure_step_is_a_profile_conflict(tmp_path):
+    _, _, step_id = _audit_surface(tmp_path, point_selector=lambda p, eligible: p.node_id == eligible)
+    runtime, manager, step_id = _audit_surface(
+        tmp_path,
+        point_selector=lambda p, eligible: p.node_id != eligible and p.point_kind == "effect_boundary",
+        binding_source=step_id.removeprefix("root."),
+    )
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        _audit(runtime, manager)
+    assert (excinfo.value.reason, excinfo.value.context["surface"]) == ("profile_conflict", "restore_payload")
+
+
+def test_noneligible_records_without_pure_bindings_are_allowed(tmp_path):
+    runtime, manager, _ = _audit_surface(
+        tmp_path, point_selector=lambda p, eligible: p.node_id != eligible and p.point_kind == "loop_back_edge"
+    )
+    _audit(runtime, manager)

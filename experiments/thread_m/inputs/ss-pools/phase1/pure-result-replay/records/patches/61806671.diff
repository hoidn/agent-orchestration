+"""Static replay-eligibility index for ``derived_pure_replay.v1``.
+
+``derive_pure_result_replay_index`` walks a loaded bundle read-only and answers:
+which compiler-generated ``pure_projection`` nodes can be re-derived from durable
+inputs (single visit, acyclic), and what each depends on. It never mutates or
+serializes the bundle. Dependencies: executable IR, runtime plan, projection and
+the pure-expression type coercer. Spec: ``specs/state.md``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Iterable, Mapping, Optional, Sequence
+
+from .executable_ir import (
+    BlockOutputAddress,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_core import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+from .references import ReferenceResolutionError, parse_structured_ref
+
+ROOT_SCOPE = "root"
+_LOOP_KINDS = {"repeat_until_frame", "for_each"}
+
+
+def thaw(value: Any) -> Any:
+    """Convert frozen mappings/tuples into plain JSON-like containers."""
+    if isinstance(value, Mapping):
+        return {str(key): thaw(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [thaw(item) for item in value]
+    return value
+
+
+@dataclass(frozen=True)
+class PureBinding:
+    """One ref leaf of a binding document: where it sits and what it points at."""
+
+    path: str
+    address: Any
+    ref: str = field(default="", compare=False)
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+    payload: Mapping[str, Any] = field(default_factory=dict, compare=False, repr=False)
+    binding_docs: Mapping[str, Any] = field(default_factory=dict, compare=False, repr=False)
+    input_names: tuple[str, ...] = field(default=(), compare=False, repr=False)
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+    _parse_ref: Any = field(default=None, compare=False, repr=False)
+
+    def parse_address(self, value: Any) -> Any:
+        """Accept a typed address or a ref string and return a typed address."""
+        return self._parse_ref(value) if isinstance(value, str) else value
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[Any],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Pure nodes needed to rebuild ``seed_addresses``, in topological order.
+
+        Seeds owned by non-reached or non-eligible nodes are ignored (they run
+        live or live in durable rows); an unreached pure *dependency* of a
+        needed node is ambiguous and raises ``reachability_ambiguous``.
+        """
+        reached = set(reached_node_ids)
+        needed: set[str] = set()
+        stack = []
+        for seed in seed_addresses:
+            owner = getattr(self.parse_address(seed), "node_id", None)
+            if owner in self.nodes and owner in reached:
+                stack.append(owner)
+        while stack:
+            node_id = stack.pop()
+            if node_id in needed:
+                continue
+            needed.add(node_id)
+            for dep in self.nodes[node_id].pure_dependency_node_ids:
+                if dep not in reached:
+                    raise PureResultReplayIndexError(
+                        REACHABILITY_AMBIGUOUS,
+                        f"pure dependency {dep!r} of {node_id!r} was not reached",
+                        context={"node_id": node_id, "dependency": dep},
+                    )
+                stack.append(dep)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+def _kind(node: Any) -> str:
+    kind = getattr(node, "kind", None)
+    return getattr(kind, "value", kind)
+
+
+# -- reference parsing --------------------------------------------------------
+
+
+def _make_ref_parser(bundle: Any):
+    ir = bundle.ir
+    node_by_key: dict[str, str] = {}
+    for node_id in ir.nodes:
+        entry = bundle.projection.entries_by_node_id.get(node_id)
+        key = entry.presentation_key if entry is not None else None
+        if isinstance(key, str):
+            node_by_key.setdefault(key, node_id)
+    input_names = set(ir.inputs)
+
+    def parse(ref: Any) -> Any:
+        if not isinstance(ref, str) or not ref:
+            raise _invalid("ref must be a non-empty string", ref=ref)
+        if ref.startswith("inputs."):
+            name = ref[len("inputs."):]
+            if name not in input_names:
+                raise _invalid("ref names an unknown workflow input", ref=ref)
+            return WorkflowInputAddress(input_name=name)
+        if not ref.startswith("root.steps."):
+            raise _invalid("ref is outside this workflow's root scope", ref=ref)
+        try:
+            target = parse_structured_ref(ref, node_by_key)
+        except ReferenceResolutionError as exc:
+            raise _invalid(f"unbound ref text: {exc}", ref=ref) from exc
+        node_id = node_by_key.get(target.step_name)
+        if node_id is None:
+            raise _invalid("ref names no step of this workflow", ref=ref)
+        kind = _kind(ir.nodes[node_id])
+        if target.field == "artifacts" and target.member:
+            if kind in {"if_join", "match_join"}:
+                return BlockOutputAddress(node_id=node_id, output_name=target.member)
+            if kind == "repeat_until_frame":
+                return LoopOutputAddress(node_id=node_id, output_name=target.member)
+            if kind == "call_boundary":
+                return CallOutputAddress(node_id=node_id, output_name=target.member)
+        return NodeResultAddress(node_id=node_id, field=target.field, member=target.member)
+
+    return parse
+
+
+# -- binding documents --------------------------------------------------------
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and set(doc) == {"ref"} and isinstance(doc["ref"], str)
+
+
+def _union_field_types(desc: Mapping[str, Any]) -> dict[str, Any]:
+    fields: dict[str, Any] = {}
+    for variant in desc.get("variants", ()) or ():
+        for item in variant.get("fields", ()):
+            fields.setdefault(item["name"], item["type"])
+    return fields
+
+
+def _variant_fields(desc: Mapping[str, Any], variant: str) -> Optional[list[Mapping[str, Any]]]:
+    if desc.get("kind") == "variant_case":
+        return list(desc["fields"]) if desc.get("variant") == variant else None
+    for candidate in desc.get("variants", ()):
+        if candidate["name"] == variant:
+            return list(candidate["fields"])
+    return None
+
+
+def _walk_document(doc: Any, desc: Mapping[str, Any], path: str, leaves: list[tuple[str, str]]) -> None:
+    """Collect exact ref leaves and type-check every literal subtree."""
+    if _is_exact_ref(doc):
+        leaves.append((path, doc["ref"]))
+        return
+    if isinstance(doc, Mapping) and "ref" in doc and desc.get("kind") not in {"record", "union", "variant_case"}:
+        raise _invalid("malformed ref object", path=path)
+    kind = desc["kind"]
+    if kind == "optional":
+        if doc is not None:
+            _walk_document(doc, desc["item"], path, leaves)
+    elif kind == "list":
+        if not isinstance(doc, (list, tuple)):
+            raise _invalid("literal must be a list", path=path)
+        for position, item in enumerate(doc):
+            _walk_document(item, desc["item"], f"{path}[{position}]", leaves)
+    elif kind == "map":
+        if not isinstance(doc, Mapping):
+            raise _invalid("literal must be a map", path=path)
+        for key, item in doc.items():
+            _walk_literal(key, desc["key"], f"{path}.{key}")
+            _walk_document(item, desc["value"], f"{path}.{key}", leaves)
+    elif kind == "record":
+        _walk_fields(doc, list(desc["fields"]), path, leaves, allow_extra=())
+    elif kind in {"union", "variant_case"}:
+        _walk_union(doc, desc, path, leaves)
+    else:
+        _walk_literal(doc, desc, path)
+
+
+def _walk_fields(
+    doc: Any,
+    fields: Sequence[Mapping[str, Any]],
+    path: str,
+    leaves: list[tuple[str, str]],
+    *,
+    allow_extra: Sequence[str],
+    skip: Sequence[str] = (),
+) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("literal must be a record", path=path)
+    names = {item["name"] for item in fields}
+    unexpected = sorted(set(doc) - names - set(allow_extra) - set(skip))
+    if unexpected:
+        raise _invalid("literal has unexpected fields", path=path, fields=unexpected)
+    for item in fields:
+        name = item["name"]
+        if name not in doc:
+            raise _invalid("literal is missing a field", path=path, field=name)
+        _walk_document(doc[name], item["type"], f"{path}.{name}", leaves)
+
+
+def _walk_union(doc: Any, desc: Mapping[str, Any], path: str, leaves: list[tuple[str, str]]) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("literal must be a union value", path=path)
+    variant = doc.get("variant")
+    if _is_exact_ref(variant):
+        leaves.append((f"{path}.variant", variant["ref"]))
+        variant_fields: Optional[list[Mapping[str, Any]]] = []
+    elif isinstance(variant, str) and variant:
+        variant_fields = _variant_fields(desc, variant)
+        if variant_fields is None:
+            raise _invalid("literal names an unknown variant", path=path, variant=variant)
+    else:
+        raise _invalid("union literal must declare a variant", path=path)
+    all_fields = _union_field_types(desc) if desc["kind"] == "union" else {
+        item["name"]: item["type"] for item in desc["fields"]
+    }
+    for item in variant_fields:
+        if item["name"] not in doc:
+            raise _invalid("union literal is missing an active member", path=path, field=item["name"])
+    for name, member in doc.items():
+        if name == "variant":
+            continue
+        member_type = all_fields.get(name)
+        if member_type is None:
+            raise _invalid("union literal has an unknown member", path=path, field=name)
+        # Inactive members are still checked against their declared type.
+        _walk_document(member, member_type, f"{path}.{name}", leaves)
+
+
+def _walk_literal(value: Any, desc: Mapping[str, Any], path: str) -> None:
+    if isinstance(value, str) and "${" in value:
+        raise _invalid("literal carries unbound substitution text", path=path)
+    try:
+        _coerce_value(value, desc, context=path)
+    except PureExprEvaluationError as exc:
+        raise _invalid(f"literal does not match its declared type: {exc}", path=path) from exc
+
+
+# -- eligibility --------------------------------------------------------------
+
+
+def _multi_visit_node_ids(bundle: Any) -> set[str]:
+    """Pure-candidate node ids that can be visited more than once per scope."""
+    plan = bundle.runtime_plan
+    multi: set[str] = set()
+    for node_id, plan_node in plan.nodes.items():
+        if plan_node.execution_index is None:
+            multi.add(node_id)
+        if plan_node.kind in _LOOP_KINDS:
+            multi.update(plan_node.nested_body_node_ids)
+    edges = {
+        node_id: [
+            target
+            for target in (
+                plan_node.fallthrough_node_id,
+                *plan_node.routed_transfer_targets.values(),
+            )
+            if isinstance(target, str)
+        ]
+        for node_id, plan_node in plan.nodes.items()
+    }
+    for node_id, plan_node in plan.nodes.items():
+        if plan_node.kind != "pure_projection" or node_id in multi:
+            continue
+        seen: set[str] = set()
+        frontier = list(edges.get(node_id, ()))
+        while frontier:
+            current = frontier.pop()
+            if current == node_id:
+                multi.add(node_id)
+                break
+            if current not in seen:
+                seen.add(current)
+                frontier.extend(edges.get(current, ()))
+    return multi
+
+
+def _build_node(bundle: Any, node_id: str, parse: Any, pure_ids: set[str]) -> PureReplayNode:
+    node = bundle.ir.nodes[node_id]
+    entry = bundle.projection.entries_by_node_id.get(node_id)
+    plan_node = bundle.runtime_plan.nodes.get(node_id)
+    if entry is None or plan_node is None:
+        raise _invalid("pure node is missing its projection identity", node_id=node_id)
+    if entry.step_id != node.step_id or plan_node.step_id != node.step_id:
+        raise _invalid("projection step identity mismatch", node_id=node_id)
+    if plan_node.presentation_key != entry.presentation_key:
+        raise _invalid("projection presentation identity mismatch", node_id=node_id)
+    config = thaw(node.execution_config.pure_projection)
+    payload, refs, contracts = config.get("payload"), config.get("binding_refs"), config.get("output_contracts")
+    if not (isinstance(payload, dict) and isinstance(refs, dict) and isinstance(contracts, dict)):
+        raise _invalid("pure projection config is not compiler-generated", node_id=node_id)
+    declared = payload.get("bindings")
+    if not isinstance(declared, dict) or set(refs) != set(declared):
+        raise _invalid("binding refs do not match declared bindings", node_id=node_id)
+    bindings: list[PureBinding] = []
+    pure_deps: list[str] = []
+    durable_deps: list[str] = []
+    inputs: list[str] = []
+    for name in declared:
+        leaves: list[tuple[str, str]] = []
+        _walk_document(refs[name], declared[name]["type"], name, leaves)
+        for path, ref in leaves:
+            address = parse(ref)
+            bindings.append(PureBinding(path=path, address=address, ref=ref))
+            owner = getattr(address, "node_id", None)
+            if owner is None:
+                inputs.append(address.input_name)
+            elif owner in pure_ids:
+                pure_deps.append(owner)
+            else:
+                durable_deps.append(owner)
+    return PureReplayNode(
+        node_id=node_id,
+        step_id=node.step_id,
+        presentation_key=entry.presentation_key,
+        bindings=tuple(bindings),
+        output_addresses=tuple(NodeResultAddress(node_id, "artifacts", name) for name in contracts),
+        output_contracts=contracts,
+        pure_dependency_node_ids=tuple(dict.fromkeys(pure_deps)),
+        durable_dependency_node_ids=tuple(dict.fromkeys(durable_deps)),
+        payload=payload,
+        binding_docs=refs,
+        input_names=tuple(dict.fromkeys(inputs)),
+    )
+
+
+def _topological_order(nodes: Mapping[str, PureReplayNode]) -> tuple[str, ...]:
+    remaining = {node_id: {d for d in node.pure_dependency_node_ids if d in nodes} for node_id, node in nodes.items()}
+    order: list[str] = []
+    while remaining:
+        ready = [node_id for node_id, deps in remaining.items() if not deps]
+        if not ready:
+            raise _invalid("pure dependency cycle", node_ids=sorted(remaining))
+        for node_id in ready:
+            order.append(node_id)
+            del remaining[node_id]
+        for deps in remaining.values():
+            deps.difference_update(ready)
+    return tuple(order)
+
+
+def _propagate_pure_ineligibility(nodes: dict[str, PureReplayNode], reasons: dict[str, str]) -> None:
+    """Drop (in place) pure nodes whose pure dependencies are ineligible."""
+    changed = True
+    while changed:
+        changed = False
+        for node_id, node in list(nodes.items()):
+            blocked = next((dep for dep in node.pure_dependency_node_ids if dep in reasons), None)
+            if blocked is not None:
+                reasons[node_id] = reasons[blocked]
+                del nodes[node_id]
+                changed = True
+
+
+def _check_unique_authority(bundle: Any, pure_ids: Sequence[str]) -> None:
+    seen: dict[str, str] = {}
+    for node_id in pure_ids:
+        key = bundle.projection.entries_by_node_id[node_id].presentation_key
+        if key in seen:
+            raise _invalid("duplicate projection authority", presentation_key=key, node_ids=[seen[key], node_id])
+        seen[key] = node_id
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = ROOT_SCOPE) -> PureResultReplayIndex:
+    """Derive the replay index for ``bundle`` without mutating it."""
+    if scope_kind != ROOT_SCOPE:
+        # A bundle (root or imported callee) always indexes its own nodes as "root".
+        raise _invalid(
+            "scope kind does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=ROOT_SCOPE,
+        )
+    pure_ids = [
+        node_id for node_id, node in bundle.ir.nodes.items() if node.kind is ExecutableNodeKind.PURE_PROJECTION
+    ]
+    _check_unique_authority(bundle, pure_ids)
+    multi = _multi_visit_node_ids(bundle)
+    reasons: dict[str, str] = {node_id: MULTIPLE_VISIT_REGION for node_id in pure_ids if node_id in multi}
+    candidates = [node_id for node_id in pure_ids if node_id not in reasons]
+    parse = _make_ref_parser(bundle)
+    nodes = {node_id: _build_node(bundle, node_id, parse, set(pure_ids)) for node_id in candidates}
+    _topological_order(nodes)
+    _propagate_pure_ineligibility(nodes, reasons)
+    return PureResultReplayIndex(
+        scope_kind=ROOT_SCOPE,
+        nodes=nodes,
+        topological_node_ids=_topological_order(nodes),
+        ineligible_pure_reasons=reasons,
+        _parse_ref=parse,
+    )

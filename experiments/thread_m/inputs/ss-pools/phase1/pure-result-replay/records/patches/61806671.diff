+"""PureReplayRuntime: in-memory replay, cache revalidation and union rows."""
+
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+
+import pytest
+
+from orchestrator.workflow.executable_ir import NodeResultAddress
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from tests.test_workflow_lisp_pure_projection_runtime import _compile_runtime_union_variant_bundle
+
+VALID = Path(__file__).parent / "fixtures" / "workflow_lisp" / "valid"
+
+
+def _selector(tmp_path):
+    result = compile_stage3_entrypoint(
+        VALID / "pure_expr_selector_action_projection.orc",
+        source_roots=(VALID,), provider_externs={}, prompt_externs={}, command_boundaries={},
+        validate_shared=True, workspace_root=tmp_path,
+    )
+    return result.validated_bundles_by_name["pure_expr_selector_action_projection::orchestrate"]
+
+
+@pytest.fixture
+def runtime(tmp_path):
+    return PureReplayRuntime(bundle=_selector(tmp_path), scope_path=ResumeScopePath.root("w.orc"))
+
+
+def _shell_state(runtime, **inputs):
+    (node_id,) = runtime.index.nodes
+    witness = runtime.witness(node_id)
+    key = witness.presentation_key
+    return node_id, {
+        "bound_inputs": {"approved": False, "status": "WAIT", **inputs},
+        "step_visits": {key: 1},
+        "steps": {key: build_pure_completion_shell(witness)},
+        "current_step": None,
+    }
+
+
+def test_index_scope_and_step_identity(runtime):
+    (node_id,) = runtime.index.nodes
+    step_id = runtime.index.nodes[node_id].step_id
+    assert runtime.index.scope_kind == "root"
+    assert runtime.node_id_for_step_id(step_id) == node_id
+    assert runtime.node_id_for_step_id("not-a-step") is None
+
+
+def test_replay_rebuilds_the_row_without_touching_state(runtime):
+    node_id, state = _shell_state(runtime)
+    before = copy.deepcopy(state)
+    row = runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate)
+    assert row["artifacts"] == {"return__status": "WAIT", "return__ready": False}
+    assert {k: v for k, v in row.items() if k != "artifacts"} == state["steps"][row["name"]]
+    assert state == before
+
+
+def test_overlay_is_a_copy_whose_rows_carry_values(runtime):
+    node_id, state = _shell_state(runtime)
+    overlay = runtime.overlay_active_state(state)
+    key = runtime.index.nodes[node_id].presentation_key
+    assert overlay["steps"][key]["artifacts"]["return__status"] == "WAIT"
+    assert "artifacts" not in state["steps"][key]
+
+
+def test_missing_bound_input_is_durable_input_missing(runtime):
+    node_id, state = _shell_state(runtime)
+    del state["bound_inputs"]["status"]
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate)
+    assert excinfo.value.reason == "durable_input_missing"
+
+
+def test_wrong_typed_bound_input_is_durable_input_invalid(runtime):
+    node_id, state = _shell_state(runtime, status=3)
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate)
+    assert excinfo.value.reason == "durable_input_invalid"
+
+
+def test_active_result_is_valid_only_without_a_cursor_on_the_node(runtime):
+    node_id, state = _shell_state(runtime)
+    witness = runtime.witness(node_id)
+    key = witness.presentation_key
+    full = {**build_pure_completion_shell(witness), "artifacts": {"return__status": "WAIT", "return__ready": False}}
+    runtime.record_full_result(node_id, witness=witness, result=full)
+    state["steps"][key] = copy.deepcopy(full)
+    assert runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate) == full
+
+    state["current_step"] = {"name": key, "step_id": "other"}
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate)
+    assert excinfo.value.reason == "progress_witness_invalid"
+
+
+def test_cache_never_overrides_the_state_row(runtime):
+    node_id, state = _shell_state(runtime)
+    witness = runtime.witness(node_id)
+    key = witness.presentation_key
+    full = {**build_pure_completion_shell(witness), "artifacts": {"return__status": "WAIT", "return__ready": False}}
+    runtime.record_full_result(node_id, witness=witness, result=full)
+    state["steps"][key] = {**full, "artifacts": {"return__status": "FORGED", "return__ready": False}}
+    with pytest.raises(PureResultReplayIndexError):
+        runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate)
+
+
+@pytest.mark.parametrize("visit", [None, 0, 2, True])
+def test_non_one_visits_fail(runtime, visit):
+    node_id, state = _shell_state(runtime)
+    key = runtime.index.nodes[node_id].presentation_key
+    if visit is None:
+        del state["step_visits"][key]
+    else:
+        state["step_visits"][key] = visit
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.replay_node(node_id, state=state, evaluate_node=runtime._default_evaluate)
+    assert excinfo.value.reason == "progress_witness_invalid"
+
+
+def test_union_rows_hold_discriminant_and_active_variant_only(tmp_path):
+    bundle = _compile_runtime_union_variant_bundle(tmp_path)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc"))
+    (node,) = runtime.index.nodes.values()
+    assert len(node.output_addresses) == 3  # the static catalog keeps every address
+    witness = runtime.witness(node.node_id)
+    active = {"return__variant": "BLOCKED", "return__blocked_reason": "why"}
+    runtime.record_full_result(node.node_id, witness=witness, result={**build_pure_completion_shell(witness), "artifacts": active})
+    for artifacts in (
+        {"return__variant": "BLOCKED"},
+        {**active, "return__selected_item_selection_bundle": "state/x.json"},
+    ):
+        with pytest.raises(PureResultReplayIndexError) as excinfo:
+            PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc")).record_full_result(
+                node.node_id, witness=witness, result={**build_pure_completion_shell(witness), "artifacts": artifacts}
+            )
+        assert excinfo.value.reason == "dependency_index_invalid"
+
+
+def test_durable_intrinsics_must_have_their_declared_types(tmp_path):
+    result = compile_stage3_entrypoint(
+        VALID / "lexical_checkpoint_restore_regions.orc",
+        source_roots=(VALID,), validate_shared=True, workspace_root=tmp_path,
+    )
+    bundle = next(b for n, b in result.validated_bundles_by_name.items() if n.endswith("orchestrate"))
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc"))
+    (node,) = runtime.index.nodes.values()
+    (owner,) = node.durable_dependency_node_ids
+    key = bundle.projection.entries_by_node_id[owner].presentation_key
+    cases = [
+        (NodeResultAddress(owner, "exit_code"), {"exit_code": "0"}),
+        (NodeResultAddress(owner, "outcome", "status"), {"outcome": {"status": 3}}),
+        (NodeResultAddress(owner, "outcome", "retryable"), {"outcome": {"retryable": "no"}}),
+    ]
+    for address, row in cases:
+        with pytest.raises(PureResultReplayIndexError) as excinfo:
+            runtime.resolve_state_address(address, {"steps": {key: row}, "bound_inputs": {}})
+        assert excinfo.value.reason == "durable_input_invalid"
+
+
+def _executor(tmp_path, **kwargs):
+    from orchestrator.state import StateManager
+    from orchestrator.workflow.executor import WorkflowExecutor
+    from tests.workflow_bundle_helpers import historical_workflow_lisp_bundle_context
+
+    bundle = _selector(tmp_path)
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="obs")
+    manager.initialize(
+        "w.orc",
+        context=historical_workflow_lisp_bundle_context(bundle),
+        bound_inputs={"approved": False, "status": "WAIT"},
+    )
+    return WorkflowExecutor(bundle, tmp_path, manager, **kwargs)
+
+
+def test_observation_manager_is_created_when_execution_starts_and_closed_once(tmp_path):
+    from unittest.mock import patch
+
+    with patch("orchestrator.workflow.executor.ProviderObservationManager") as manager_class:
+        executor = _executor(tmp_path, provider_observation_enabled=True)
+        assert manager_class.call_count == 0
+        assert executor.execute()["status"] == "completed"
+        assert manager_class.call_count == 1
+        manager_class.return_value.close.assert_called_once()
+
+
+def test_no_observation_manager_when_observation_is_disabled(tmp_path):
+    from unittest.mock import patch
+
+    with patch("orchestrator.workflow.executor.ProviderObservationManager") as manager_class:
+        _executor(tmp_path, provider_observation_enabled=False).execute()
+        assert manager_class.call_count == 0
+
+
+def _regions_runtime(tmp_path):
+    result = compile_stage3_entrypoint(
+        VALID / "lexical_checkpoint_restore_regions.orc",
+        source_roots=(VALID,), validate_shared=True, workspace_root=tmp_path,
+    )
+    bundle = next(b for n, b in result.validated_bundles_by_name.items() if n.endswith("orchestrate"))
+    return bundle, PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc"))
+
+
+def test_boundary_requires_only_pure_nodes_the_remaining_steps_consume(tmp_path):
+    bundle, runtime = _regions_runtime(tmp_path)
+    (node_id,) = runtime.index.nodes
+    witness = runtime.witness(node_id)
+    state = {
+        "steps": {witness.presentation_key: build_pure_completion_shell(witness)},
+        "step_visits": {witness.presentation_key: 1},
+        "current_step": None,
+        "bound_inputs": {},
+    }
+    order = list(bundle.runtime_plan.ordered_node_ids)
+    assert runtime.required_node_ids_for_boundary(order[-1], state=state) == (node_id,)
+    assert runtime.required_node_ids_for_boundary(order[0], state=state) == ()

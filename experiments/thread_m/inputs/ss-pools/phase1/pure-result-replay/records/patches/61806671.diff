diff --git a/tests/test_pure_replay_progress.py b/tests/test_pure_replay_progress.py
new file mode 100644
index 0000000..421a0f8
--- /dev/null
+++ b/tests/test_pure_replay_progress.py
@@ -0,0 +1,169 @@
+"""Completion shell, progress classification and visit atomicity for derived_pure_replay.v1."""
+
+
+import pytest
+
+from orchestrator.state import StateManager, StepResult
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+W = PureReplayVisitWitness("pure::a", 3, "root.pure_a", 1)
+
+
+def _cursor(**over):
+    cursor = {
+        "name": "pure::a", "index": 3, "type": "pure_projection", "step_id": "root.pure_a",
+        "visit_count": 1, "status": "running", "started_at": "t", "last_heartbeat_at": "t",
+    }
+    cursor.update(over)
+    return cursor
+
+
+def _state(visit=None, cursor=None, row=None, **extra):
+    state = {"step_visits": {}, "steps": {}, "current_step": cursor}
+    if visit is not None:
+        state["step_visits"]["pure::a"] = visit
+    if row is not None:
+        state["steps"]["pure::a"] = row
+    state.update(extra)
+    return state
+
+
+def _failure(**over):
+    row = {"name": "pure::a", "step_id": "root.pure_a", "visit_count": 1, "status": "failed", "exit_code": 2}
+    row.update(over)
+    return row
+
+
+def test_shell_is_exact():
+    assert build_pure_completion_shell(W) == {
+        "name": "pure::a", "step_id": "root.pure_a", "visit_count": 1, "status": "completed",
+        "exit_code": 0,
+        "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+        "result_storage": "derived_pure_replay.v1",
+    }
+
+
+@pytest.mark.parametrize("mutate", [
+    lambda r: r.update(value=1),
+    lambda r: r.update(artifacts={}),
+    lambda r: r.update(duration_ms=0),
+    lambda r: r.pop("exit_code"),
+    lambda r: r.update(visit_count=2),
+    lambda r: r["outcome"].update(retryable=True),
+    lambda r: r["outcome"].update(extra=1),
+    lambda r: r.update(exit_code=False),
+])
+def test_shell_validation_rejects_any_deviation(mutate):
+    row = build_pure_completion_shell(W)
+    mutate(row)
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(row, witness=W)
+
+
+def test_shell_validation_accepts_the_shell():
+    validate_pure_completion_shell(build_pure_completion_shell(W), witness=W)
+
+
+@pytest.mark.parametrize("state,expected", [
+    (_state(), "unstarted"),
+    (_state(cursor={"name": "other", "step_id": "root.other", "status": "running"}), "unstarted"),
+    (_state(visit=1, cursor=_cursor()), "interrupted"),
+    (_state(visit=1, row=build_pure_completion_shell(W)), "derived_complete"),
+    (_state(visit=1, row=build_pure_completion_shell(W),
+            cursor={"name": "other", "step_id": "root.other", "status": "running"}), "derived_complete"),
+    (_state(visit=1, row=_failure()), "durable_failure_skip"),
+    (_state(visit=1, row=_failure(status="skipped")), "durable_failure_skip"),
+])
+def test_classification(state, expected):
+    assert classify_pure_replay_progress(state, witness=W) == expected
+
+
+def _shell(**over):
+    row = build_pure_completion_shell(W)
+    row.update(over)
+    return row
+
+
+@pytest.mark.parametrize("state", [
+    _state(visit=1),
+    _state(cursor=_cursor()),
+    _state(row=build_pure_completion_shell(W)),
+    _state(visit=1, cursor=_cursor(), row=build_pure_completion_shell(W)),
+    _state(visit=1, cursor=_cursor(), row=_failure()),
+    _state(visit=2, cursor=_cursor(visit_count=2)),
+    _state(visit=1, cursor=_cursor(visit_count=2)),
+    _state(visit=1, cursor=_cursor(step_id="root.else")),
+    _state(visit=1, cursor=_cursor(name="pure::b")),
+    _state(visit=1, cursor=_cursor(index=9)),
+    _state(visit=1, cursor=_cursor(type="command")),
+    _state(visit=1, cursor=_cursor(status="done")),
+    _state(visit=2, row=_shell(visit_count=2)),
+    _state(visit=1, row=_shell(artifacts={"x": 1})),
+    _state(visit=1, row={"name": "pure::a", "step_id": "root.pure_a", "visit_count": 1, "status": "running"}),
+    _state(visit=1, row=_failure(visit_count=2)),
+    _state(visit=1, row=_failure(step_id="root.other")),
+])
+def test_everything_else_is_progress_witness_invalid(state):
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        classify_pure_replay_progress(state, witness=W)
+    assert excinfo.value.reason == "progress_witness_invalid"
+    assert excinfo.value.code == "pure_result_replay_unavailable"
+
+
+@pytest.fixture
+def manager(tmp_path):
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="atomic")
+    manager.initialize("w.orc")
+    return manager
+
+
+def test_begin_publishes_visit_and_cursor_in_one_write(manager):
+    assert manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a") == 1
+    persisted = StateManager(manager.workspace, run_id="atomic").load()
+    assert persisted.step_visits == {"pure::a": 1}
+    assert {k: persisted.current_step[k] for k in ("name", "index", "type", "step_id", "visit_count", "status")} == {
+        "name": "pure::a", "index": 3, "type": "pure_projection", "step_id": "root.pure_a",
+        "visit_count": 1, "status": "running",
+    }
+    assert {"started_at", "last_heartbeat_at"} <= set(persisted.current_step)
+
+
+def test_reuse_interrupted_visit_does_not_write(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    before = manager.state_file.read_bytes()
+    assert manager.reuse_interrupted_eligible_pure_visit(W) == 1
+    assert manager.state_file.read_bytes() == before
+
+
+def test_success_settles_exact_shell_and_clears_cursor(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    shell = manager.settle_eligible_pure_success(W)
+    assert shell == build_pure_completion_shell(W)
+    persisted = StateManager(manager.workspace, run_id="atomic").load()
+    assert persisted.steps["pure::a"] == shell and persisted.current_step is None
+
+
+def test_failure_persists_full_row_and_clears_cursor(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    result = StepResult(status="failed", name="pure::a", step_id="root.pure_a", exit_code=2, visit_count=1)
+    assert manager.settle_eligible_pure_failure(W, result) is None
+    persisted = StateManager(manager.workspace, run_id="atomic").load()
+    assert persisted.steps["pure::a"]["status"] == "failed" and persisted.current_step is None
+
+
+def test_settle_without_begin_is_rejected(manager):
+    with pytest.raises(PureResultReplayIndexError):
+        manager.settle_eligible_pure_success(W)
+
+
+def test_begin_twice_is_rejected(manager):
+    manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
+    with pytest.raises(PureResultReplayIndexError):
+        manager.begin_eligible_pure_visit(step_name="pure::a", step_index=3, step_id="root.pure_a")
diff --git a/tests/test_pure_replay_resume.py b/tests/test_pure_replay_resume.py
new file mode 100644
index 0000000..4e36889
--- /dev/null
+++ b/tests/test_pure_replay_resume.py
@@ -0,0 +1,377 @@
+"""End-to-end derived_pure_replay.v1: value-free runs and in-memory replay on resume.
+
+Drives the real CLI in-process over a small effect/pure/effect/pure/effect program.
+A crash is simulated by an uncatchable exception at a chosen persistence point.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.cli.main import main
+from orchestrator.contracts.output_contract import ContractViolation, OutputContractError
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.outcomes import OutcomeRecorder
+from orchestrator.workflow.resume_planner import ResumePlanner
+
+PROFILE = "derived_pure_replay.v1"
+PROGRAM = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule chain)
+  (export orchestrate)
+  (defrecord Stage (label String))
+  (defrecord Final (a String) (b String))
+  (defworkflow orchestrate
+    ((seed String))
+    -> Final
+    (let* ((s1 (command-result stage_one :argv ("python" "scripts/stage.py" "one" "x") :returns Stage))
+           (g1 (= s1.label "one:x"))
+           (s2 (if g1
+                 (command-result stage_two :argv ("python" "scripts/stage.py" "two" "x") :returns Stage)
+                 (command-result stage_alt :argv ("python" "scripts/stage.py" "alt" "x") :returns Stage)))
+           (g2 (string/concat s2.label (string/concat "-" seed)))
+           (s3 (if (= g2 "two:x-hi")
+                 (command-result stage_three :argv ("python" "scripts/stage.py" "three" "x") :returns Stage)
+                 (command-result stage_alt :argv ("python" "scripts/stage.py" "alt" "x") :returns Stage))))
+      (record Final :a g2 :b (string/concat s3.label (string/concat "-" g2))))))
+"""
+STAGE = """import json, os, sys
+name = sys.argv[1]
+with open("calls.log", "a") as handle:
+    handle.write(name + "\\n")
+path = os.environ["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"]
+os.makedirs(os.path.dirname(path), exist_ok=True)
+json.dump({"label": name + ":" + sys.argv[2]}, open(path, "w"))
+"""
+COMMANDS = {
+    name: {"kind": "external_tool", "stable_command": ["python", "scripts/stage.py"]}
+    for name in ("stage_one", "stage_two", "stage_three", "stage_alt")
+}
+EXPECTED = {"return__a": "two:x-hi", "return__b": "three:x-two:x-hi"}
+S3_CONDITION = "chain::orchestrate__s3__condition"
+
+
+@pytest.fixture
+def workspace(tmp_path, monkeypatch):
+    (tmp_path / "scripts").mkdir()
+    (tmp_path / "chain.orc").write_text(PROGRAM, encoding="utf-8")
+    (tmp_path / "scripts" / "stage.py").write_text(STAGE, encoding="utf-8")
+    (tmp_path / "cmds.json").write_text(json.dumps(COMMANDS), encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+    return tmp_path
+
+
+def _run(workspace, *, crash_at=None):
+    argv = ["orchestrate", "run", "chain.orc", "--input", "seed=hi", "--command-boundaries-file", "cmds.json"]
+    original = OutcomeRecorder.persist_step_result
+
+    def crashing(self, state, step_name, *args, **kwargs):
+        if crash_at is not None and step_name.endswith(crash_at):
+            raise KeyboardInterrupt("simulated crash")
+        return original(self, state, step_name, *args, **kwargs)
+
+    with patch.object(sys, "argv", argv), patch.object(OutcomeRecorder, "persist_step_result", crashing):
+        try:
+            main(argv[1:])
+        except KeyboardInterrupt:
+            pass
+    (run_dir,) = (workspace / ".orchestrate" / "runs").iterdir()
+    return run_dir.name
+
+
+def _state(workspace, run_id):
+    return json.loads((workspace / ".orchestrate" / "runs" / run_id / "state.json").read_text())
+
+
+def _write_state(workspace, run_id, state):
+    (workspace / ".orchestrate" / "runs" / run_id / "state.json").write_text(json.dumps(state), encoding="utf-8")
+
+
+def _resume(run_id):
+    with patch.object(sys, "argv", ["orchestrate", "resume", run_id]):
+        return main(["resume", run_id])
+
+
+def _calls(workspace):
+    return (workspace / "calls.log").read_text().split()
+
+
+def _pure_rows(state):
+    return {k: v for k, v in state["steps"].items() if v.get("result_storage") == PROFILE}
+
+
+def test_clean_run_leaves_pure_results_value_free(workspace):
+    run_id = _run(workspace)
+    state = _state(workspace, run_id)
+    assert state["status"] == "completed" and state["workflow_outputs"] == EXPECTED
+    assert state["result_persistence_profile"] == PROFILE
+    shells = _pure_rows(state)
+    assert set(shells) == {
+        "chain::orchestrate__s2__condition",
+        S3_CONDITION,
+        "chain::orchestrate__terminal_projection",
+    }
+    for key, row in shells.items():
+        assert set(row) == {"name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage"}
+    assert state["private_artifact_versions"] == {}
+    records = list((workspace / ".orchestrate" / "runs" / run_id / "workflow_lisp" / "checkpoints" / "records").rglob("*.json"))
+    assert records
+    for path in records:
+        record = json.loads(path.read_text())
+        assert record["pending_effect_policy"]["effect_kind"] != "pure_projection"
+        shell_step_ids = {row["step_id"].removeprefix("root.") for row in shells.values()}
+        for binding in (record.get("restore_payload") or {}).get("bindings", ()):
+            assert binding.get("source_step_id") not in shell_step_ids
+    bundles = [p for p in (workspace / ".orchestrate" / "workflow_lisp").rglob("*.json") if "condition" in p.name or "terminal_projection" in p.name]
+    assert bundles == []
+
+
+@pytest.mark.parametrize("crash_at", [S3_CONDITION, "s3.then", "terminal_projection", "s2__condition"])
+def test_resume_after_interruption_reproduces_outputs_without_recalling_effects(workspace, crash_at):
+    run_id = _run(workspace, crash_at=crash_at)
+    crashed = _state(workspace, run_id)
+    assert crashed["status"] == "running"
+    calls_before = _calls(workspace)
+
+    assert _resume(run_id) == 0
+
+    state = _state(workspace, run_id)
+    assert state["status"] == "completed" and state["workflow_outputs"] == EXPECTED
+    assert _calls(workspace)[: len(calls_before)] == calls_before
+    assert sorted(_calls(workspace)) == ["one", "three", "two"]
+    for row in _pure_rows(state).values():
+        assert "artifacts" not in row
+
+
+def _crashed(workspace):
+    run_id = _run(workspace, crash_at="s3.then")
+    return run_id, _state(workspace, run_id)
+
+
+def _resume_error(workspace, run_id):
+    assert _resume(run_id) != 0
+    state = _state(workspace, run_id)
+    assert state["status"] == "failed"
+    assert state["error"]["type"] == "pure_result_replay_unavailable"
+    return state["error"]["context"]
+
+
+def test_resume_fails_closed_before_any_effect_when_a_bound_input_is_missing(workspace):
+    run_id, state = _crashed(workspace)
+    del state["bound_inputs"]["seed"]
+    _write_state(workspace, run_id, state)
+    calls = _calls(workspace)
+    assert _resume_error(workspace, run_id)["reason"] == "durable_input_missing"
+    assert _calls(workspace) == calls
+
+
+def test_resume_fails_closed_when_a_bound_input_has_the_wrong_type(workspace):
+    run_id, state = _crashed(workspace)
+    state["bound_inputs"]["seed"] = 5
+    _write_state(workspace, run_id, state)
+    assert _resume_error(workspace, run_id)["reason"] == "durable_input_invalid"
+
+
+def test_resume_reports_unresolved_binding_when_a_durable_member_is_gone(workspace):
+    run_id, state = _crashed(workspace)
+    state["steps"]["chain::orchestrate__s2"]["artifacts"].clear()
+    _write_state(workspace, run_id, state)
+    context = _resume_error(workspace, run_id)
+    assert context["reason"] == "binding_unresolved"
+    assert context["cause"] == {"type": "materialize_ref_unresolved"}
+
+
+def test_resume_reports_evaluation_failure_when_a_durable_value_is_mistyped(workspace):
+    run_id, state = _crashed(workspace)
+    state["steps"]["chain::orchestrate__s2"]["artifacts"]["return__label"] = 7
+    _write_state(workspace, run_id, state)
+    context = _resume_error(workspace, run_id)
+    assert context["reason"] == "evaluation_failed"
+    assert context["cause"] == {"type": "pure_evaluation_failed"}
+
+
+def test_resume_reports_output_contract_failure(workspace):
+    run_id, _ = _crashed(workspace)
+    with patch.object(
+        WorkflowExecutor, "_pure_projection_artifacts", side_effect=OutputContractError([ContractViolation(type="x", message="bad", context={})])
+    ):
+        context = _resume_error(workspace, run_id)
+    assert context["reason"] == "output_contract_invalid"
+    assert context["cause"] == {"type": "pure_projection_contract_invalid"}
+
+
+def test_visit_two_shell_is_rejected_before_the_prologue(workspace):
+    run_id, state = _crashed(workspace)
+    state["steps"][S3_CONDITION]["visit_count"] = 2
+    state["step_visits"][S3_CONDITION] = 2
+    _write_state(workspace, run_id, state)
+    assert _resume_error(workspace, run_id)["reason"] == "progress_witness_invalid"
+
+
+def test_visit_two_cursor_is_rejected(workspace):
+    run_id = _run(workspace, crash_at=S3_CONDITION)
+    state = _state(workspace, run_id)
+    state["current_step"]["visit_count"] = 2
+    _write_state(workspace, run_id, state)
+    assert _resume_error(workspace, run_id)["reason"] == "progress_witness_invalid"
+
+
+def test_persisted_value_row_is_a_profile_conflict(workspace):
+    run_id, state = _crashed(workspace)
+    state["steps"][S3_CONDITION] = {**state["steps"][S3_CONDITION], "artifacts": {"x": 1}}
+    _write_state(workspace, run_id, state)
+    context = _resume_error(workspace, run_id)
+    assert (context["reason"], context["surface"]) == ("profile_conflict", "steps")
+
+
+def test_private_lineage_for_an_eligible_node_is_a_profile_conflict(workspace):
+    run_id, state = _crashed(workspace)
+    state["private_artifact_versions"] = {"x": [{"version": 1, "producer": "root.chain_orchestrate__s3__condition"}]}
+    _write_state(workspace, run_id, state)
+    context = _resume_error(workspace, run_id)
+    assert (context["reason"], context["surface"]) == ("profile_conflict", "private_artifact_versions")
+
+
+def test_pure_result_bundle_is_a_profile_conflict(workspace):
+    run_id, _ = _crashed(workspace)
+    with patch.object(WorkflowExecutor, "_pure_bundle_path_for_node", lambda self, node_id, state: workspace / "b.json"):
+        (workspace / "b.json").write_text("{}", encoding="utf-8")
+        context = _resume_error(workspace, run_id)
+    assert (context["reason"], context["surface"]) == ("profile_conflict", "pure_bundle")
+
+
+def test_resume_determines_the_restart_boundary_exactly_once(workspace):
+    run_id = _run(workspace, crash_at="s3.then")
+    original = ResumePlanner.determine_restart_node_id
+    calls = []
+
+    def counting(self, *args, **kwargs):
+        calls.append(1)
+        return original(self, *args, **kwargs)
+
+    with patch.object(ResumePlanner, "determine_restart_node_id", counting):
+        assert _resume(run_id) == 0
+    assert len(calls) == 1
+
+
+def test_force_restart_creates_a_profiled_root_and_leaves_the_source_untouched(workspace):
+    run_id = _run(workspace, crash_at=S3_CONDITION)
+    source = (workspace / ".orchestrate" / "runs" / run_id / "state.json").read_bytes()
+    with patch.object(sys, "argv", ["orchestrate", "resume", run_id, "--force-restart"]):
+        main(["resume", run_id, "--force-restart"])
+    runs = sorted(p.name for p in (workspace / ".orchestrate" / "runs").iterdir())
+    (new_id,) = [name for name in runs if name != run_id]
+    assert _state(workspace, new_id)["result_persistence_profile"] == PROFILE
+    assert (workspace / ".orchestrate" / "runs" / run_id / "state.json").read_bytes() == source
+
+
+PURE_FIRST_PROGRAM = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule chain)
+  (export orchestrate)
+  (defrecord Stage (label String))
+  (defworkflow orchestrate
+    ((seed String))
+    -> Stage
+    (let* ((g (= seed "hi"))
+           (s (if g
+                 (command-result stage_one :argv ("python" "scripts/stage.py" "one" "x") :returns Stage)
+                 (command-result stage_alt :argv ("python" "scripts/stage.py" "alt" "x") :returns Stage))))
+      s)))
+"""
+
+
+def test_zero_record_resume_replays_from_frame_entry(workspace):
+    from orchestrator.state import StateManager
+
+    (workspace / "chain.orc").write_text(PURE_FIRST_PROGRAM, encoding="utf-8")
+    argv = ["orchestrate", "run", "chain.orc", "--input", "seed=hi", "--command-boundaries-file", "cmds.json"]
+    original = StateManager.start_step
+
+    def crash_before_effect(self, name, *args, **kwargs):
+        if name.endswith("stage_one"):
+            raise KeyboardInterrupt("simulated crash")
+        return original(self, name, *args, **kwargs)
+
+    with patch.object(sys, "argv", argv), patch.object(StateManager, "start_step", crash_before_effect):
+        try:
+            main(argv[1:])
+        except KeyboardInterrupt:
+            pass
+    (run_dir,) = (workspace / ".orchestrate" / "runs").iterdir()
+    assert not list(run_dir.glob("workflow_lisp/checkpoints/records/*/*.json"))
+
+    assert _resume(run_dir.name) == 0
+
+    state = _state(workspace, run_dir.name)
+    assert state["status"] == "completed" and state["workflow_outputs"] == {"return__label": "one:x"}
+    report = json.loads((run_dir / "workflow_lisp" / "checkpoints" / "default_resume_report.json").read_text())
+    (entry,) = report["default_modes"]
+    assert entry["mode"] == "LEXICAL_CHECKPOINT_DEFAULT"
+    assert entry["restore_decision"] == "VALIDATED_FRAME_ENTRY_REPLAY"
+    assert entry["checkpoint_id"] is None and entry["record_id"] is None
+
+
+def _decision(workspace, run_id, restart_node_id=None):
+    from orchestrator.cli.commands.resume import _load_resume_workflow_bundle
+    from orchestrator.state import StateManager
+    from orchestrator.workflow_lisp.lexical_checkpoint_default_resume import (
+        determine_runtime_default_resume_decision,
+    )
+
+    manager = StateManager(workspace, run_id=run_id)
+    state = manager.load().to_dict()
+    run_root = workspace / ".orchestrate" / "runs" / run_id
+    with patch.object(sys, "argv", ["orchestrate", "run", "chain.orc", "--command-boundaries-file", "cmds.json"]):
+        loaded = _load_resume_workflow_bundle(
+            workflow_path=workspace / "chain.orc", workspace_dir=workspace, run_root=run_root
+        )
+    bundle = getattr(loaded, "bundle", loaded)
+    if restart_node_id is None:
+        restart_node_id = ResumePlanner().determine_restart_node_id(state, projection=bundle.projection)
+    return determine_runtime_default_resume_decision(
+        state=state,
+        runtime_plan=bundle.runtime_plan,
+        restart_node_id=restart_node_id,
+        state_manager=manager,
+        loaded_workflow=bundle,
+        executable_workflow=bundle.ir,
+    ), bundle
+
+
+def test_default_resume_decision_for_zero_record_frame_entry(workspace):
+    (workspace / "chain.orc").write_text(PURE_FIRST_PROGRAM, encoding="utf-8")
+    argv = ["orchestrate", "run", "chain.orc", "--input", "seed=hi", "--command-boundaries-file", "cmds.json"]
+    from orchestrator.state import StateManager
+
+    original = StateManager.start_step
+
+    def crash(self, name, *args, **kwargs):
+        if name.endswith("stage_one"):
+            raise KeyboardInterrupt("simulated crash")
+        return original(self, name, *args, **kwargs)
+
+    with patch.object(sys, "argv", argv), patch.object(StateManager, "start_step", crash):
+        try:
+            main(argv[1:])
+        except KeyboardInterrupt:
+            pass
+    (run_dir,) = (workspace / ".orchestrate" / "runs").iterdir()
+    decision, bundle = _decision(workspace, run_dir.name)
+    assert decision["mode"] == "LEXICAL_CHECKPOINT_DEFAULT"
+    assert decision["restore_decision"] == "VALIDATED_FRAME_ENTRY_REPLAY"
+    assert decision["selection_reason"] == "validated_frame_entry_replay"
+    assert decision["checkpoint_id"] is None
+
+    state = _state(workspace, run_dir.name)
+    state["bound_inputs"].pop("seed")
+    _write_state(workspace, run_dir.name, state)
+    failed, _ = _decision(workspace, run_dir.name)
+    assert failed["mode"] == "FAIL_CLOSED"
+    assert failed["diagnostics"] == ["lexical_default_resume_prior_boundary_not_restorable"]

+"""Replay-eligibility index for derived_pure_replay.v1."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from pathlib import Path
+from types import MappingProxyType
+
+import pytest
+
+from orchestrator.workflow.executable_ir import NodeResultAddress, WorkflowInputAddress
+from orchestrator.workflow.pure_replay_index import thaw
+from orchestrator.workflow.pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    PureResultReplayIndexError,
+    _propagate_pure_ineligibility,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+VALID = Path(__file__).parent / "fixtures" / "workflow_lisp" / "valid"
+
+
+def _compile(tmp_path, fixture, name):
+    result = compile_stage3_entrypoint(
+        VALID / fixture,
+        source_roots=(VALID,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return next(b for n, b in result.validated_bundles_by_name.items() if n == name or n.endswith("::" + name))
+
+
+@pytest.fixture
+def selector(tmp_path):
+    return _compile(tmp_path, "pure_expr_selector_action_projection.orc", "orchestrate")
+
+
+@pytest.fixture
+def regions(tmp_path):
+    return _compile(tmp_path, "lexical_checkpoint_restore_regions.orc", "orchestrate")
+
+
+def _mutated(bundle, node_id, *, bindings=None, refs=None):
+    """A copy of ``bundle`` whose pure node carries different binding declarations/docs."""
+    node = bundle.ir.nodes[node_id]
+    config = node.execution_config
+    projection = thaw(config.pure_projection)
+    payload = projection["payload"]
+    if bindings is not None:
+        payload["bindings"] = bindings
+    projection["payload"] = payload
+    if refs is not None:
+        projection["binding_refs"] = refs
+    new_node = replace(node, execution_config=replace(config, pure_projection=MappingProxyType(projection)))
+    nodes = MappingProxyType({**bundle.ir.nodes, node_id: new_node})
+    return replace(bundle, ir=replace(bundle.ir, nodes=nodes))
+
+
+def _only_node(bundle):
+    return next(iter(derive_pure_result_replay_index(bundle).nodes))
+
+
+STRING = {"kind": "primitive", "name": "String"}
+INT = {"kind": "primitive", "name": "Int"}
+UNION = {
+    "kind": "union", "name": "U",
+    "variants": [
+        {"name": "A", "fields": [{"name": "a", "type": STRING}]},
+        {"name": "B", "fields": [{"name": "b", "type": INT}]},
+    ],
+}
+
+
+def test_single_visit_pure_node_is_eligible_with_typed_bindings(selector):
+    index = derive_pure_result_replay_index(selector)
+    node_id = _only_node(selector)
+    node = index.nodes[node_id]
+    assert index.scope_kind == "root" and index.topological_node_ids == (node_id,)
+    assert index.ineligible_pure_reasons == {}
+    assert {b.path: b.address for b in node.bindings} == {
+        "status": WorkflowInputAddress("status"),
+        "approved": WorkflowInputAddress("approved"),
+    }
+    assert NodeResultAddress(node_id, "artifacts", "return__status") in node.output_addresses
+    assert node.pure_dependency_node_ids == () and node.durable_dependency_node_ids == ()
+
+
+def test_loop_owned_pure_nodes_are_ineligible_but_top_level_ones_are_not(regions):
+    index = derive_pure_result_replay_index(regions)
+    assert len(index.nodes) == 1
+    assert len(index.ineligible_pure_reasons) == 2
+    assert set(index.ineligible_pure_reasons.values()) == {MULTIPLE_VISIT_REGION}
+    (eligible,) = index.nodes.values()
+    assert eligible.durable_dependency_node_ids and not eligible.pure_dependency_node_ids
+
+
+def test_derivation_does_not_change_the_runtime_plan(regions):
+    before = repr(regions.runtime_plan)
+    derive_pure_result_replay_index(regions)
+    assert repr(regions.runtime_plan) == before
+
+
+def test_required_nodes_follow_pure_dependencies_in_topological_order(regions):
+    index = derive_pure_result_replay_index(regions)
+    (node_id,) = index.nodes
+    seed = NodeResultAddress(node_id, "artifacts", "x")
+    assert index.required_pure_node_ids([seed], reached_node_ids={node_id}) == (node_id,)
+    assert index.required_pure_node_ids([seed], reached_node_ids=set()) == ()
+
+
+def test_scope_kind_must_match_the_bundle_scope(selector):
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(selector, scope_kind="call_frame")
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+    assert excinfo.value.context["expected_scope"] == "call_frame"
+    assert excinfo.value.context["actual_scope"] == "root"
+
+
+def test_self_reference_is_a_cycle(selector):
+    node_id = _only_node(selector)
+    key = selector.projection.entries_by_node_id[node_id].presentation_key
+    bundle = _mutated(
+        selector, node_id,
+        bindings={"x": {"type": STRING}},
+        refs={"x": {"ref": f"root.steps.{key}.artifacts.return__status"}},
+    )
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(bundle)
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+@pytest.mark.parametrize("ref", [
+    "self.steps.other.artifacts.x",
+    "root.steps.not_a_step.artifacts.x",
+    "inputs.not_an_input",
+    "unbound text",
+])
+def test_unresolvable_or_cross_scope_refs_fail(selector, ref):
+    bundle = _mutated(selector, _only_node(selector), bindings={"x": {"type": STRING}}, refs={"x": {"ref": ref}})
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(bundle)
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+@pytest.mark.parametrize("doc,type_", [
+    (5, STRING),
+    ("${inputs.x}", STRING),
+    ({"ref": 5}, STRING),
+    ({"ref": "inputs.status", "extra": 1}, STRING),
+    ({"variant": "A", "a": "ok", "b": "not-an-int"}, UNION),
+    ({"variant": "A"}, UNION),
+    ({"variant": "Z", "a": "x"}, UNION),
+    ([1, 2], {"kind": "list", "item": STRING}),
+])
+def test_literals_must_match_their_declared_type(selector, doc, type_):
+    bundle = _mutated(selector, _only_node(selector), bindings={"x": {"type": type_}}, refs={"x": doc})
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(bundle)
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+@pytest.mark.parametrize("doc,type_", [
+    ("literal", STRING),
+    ({"variant": "A", "a": "ok", "b": 3}, UNION),
+    ({"variant": "B", "b": {"ref": "inputs.approved"}}, UNION),
+    ({"ref": "inputs.status"}, STRING),
+])
+def test_well_typed_literals_and_refs_are_accepted(selector, doc, type_):
+    bundle = _mutated(selector, _only_node(selector), bindings={"x": {"type": type_}}, refs={"x": doc})
+    assert _only_node(bundle)
+
+
+def test_only_exact_refs_form_dependency_edges(selector):
+    node_id = _only_node(selector)
+    bundle = _mutated(
+        selector, node_id,
+        bindings={"x": {"type": {"kind": "list", "item": STRING}}},
+        refs={"x": [{"ref": "inputs.status"}, "inputs.approved"]},
+    )
+    node = derive_pure_result_replay_index(bundle).nodes[node_id]
+    assert [b.address for b in node.bindings] == [WorkflowInputAddress("status")]
+
+
+def test_propagation_marks_consumers_of_ineligible_nodes():
+    class _Node:
+        def __init__(self, deps):
+            self.pure_dependency_node_ids = deps
+
+    nodes = {"a": _Node(()), "b": _Node(("x",)), "c": _Node(("b",))}
+    reasons = {"x": MULTIPLE_VISIT_REGION}
+    _propagate_pure_ineligibility(nodes, reasons)
+    assert set(nodes) == {"a"} and reasons["c"] == MULTIPLE_VISIT_REGION

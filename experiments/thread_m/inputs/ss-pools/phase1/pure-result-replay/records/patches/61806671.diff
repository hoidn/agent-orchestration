+"""result_persistence_profile selector on RunState / StateManager (specs/state.md)."""
+
+import json
+
+import pytest
+
+from orchestrator.state import RunState, StateManager
+
+PROFILE = "derived_pure_replay.v1"
+
+
+def _run_state(**extra):
+    return RunState(
+        schema_version="2.1",
+        run_id="r",
+        workflow_file="w.orc",
+        workflow_checksum="sha256:x",
+        started_at="t",
+        updated_at="t",
+        status="running",
+        **extra,
+    )
+
+
+def _workflow(tmp_path):
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    return "w.orc"
+
+
+def test_absent_profile_is_omitted_and_round_trips():
+    payload = _run_state().to_dict()
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None
+    assert RunState.from_dict(payload).to_dict() == payload
+
+
+def test_profile_round_trips_when_set():
+    payload = _run_state(result_persistence_profile=PROFILE).to_dict()
+    assert payload["result_persistence_profile"] == PROFILE
+    assert RunState.from_dict(payload).result_persistence_profile == PROFILE
+
+
+def test_unknown_profile_fails_closed_at_construction():
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        _run_state(result_persistence_profile="derived_pure_replay.v2")
+
+
+def test_initialize_writes_profile_in_first_write(tmp_path):
+    manager = StateManager(tmp_path, run_id="p1")
+    manager.initialize(_workflow(tmp_path), result_persistence_profile=PROFILE)
+    assert json.loads(manager.state_file.read_text())["result_persistence_profile"] == PROFILE
+
+
+def test_initialize_default_stays_historical(tmp_path):
+    manager = StateManager(tmp_path, run_id="p2")
+    manager.initialize(_workflow(tmp_path))
+    assert "result_persistence_profile" not in json.loads(manager.state_file.read_text())
+
+
+def test_initialize_rejects_unknown_profile_before_any_io(tmp_path):
+    manager = StateManager(tmp_path, run_id="p3")
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        manager.initialize(_workflow(tmp_path), result_persistence_profile="nope")
+    assert not manager.run_root.exists()
+
+
+def test_load_rejects_unknown_profile_and_leaves_file_untouched(tmp_path):
+    manager = StateManager(tmp_path, run_id="p4")
+    manager.initialize(_workflow(tmp_path))
+    payload = json.loads(manager.state_file.read_text())
+    payload["result_persistence_profile"] = "bogus"
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        StateManager(tmp_path, run_id="p4").load()
+    assert manager.state_file.read_bytes() == before
+
+
+def test_load_never_backfills_the_profile(tmp_path):
+    manager = StateManager(tmp_path, run_id="p5")
+    manager.initialize(_workflow(tmp_path))
+    before = manager.state_file.read_bytes()
+    assert StateManager(tmp_path, run_id="p5").load().result_persistence_profile is None
+    assert manager.state_file.read_bytes() == before

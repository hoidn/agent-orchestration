new file mode 100644
index 0000000..9e7f3c0
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_runtime.py
@@ -0,0 +1,503 @@
+"""In-memory replay of eligible pure results for ``derived_pure_replay.v1``.
+
+``PureReplayRuntime`` reconstructs value-free pure results from durable inputs
+into a transient overlay. It never dispatches an effect, increments a visit,
+settles a result or writes durable state. Dependencies: the replay index, the
+progress classifier and the pure-expression evaluator; reads checkpoint sidecars
+through the supplied state manager. Spec: ``specs/state.md``.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import fields, is_dataclass
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from ..contracts.output_contract import OutputContractError
+from .pure_expr import PureExprEvaluationError, evaluate_pure_expr
+from .pure_projection_artifacts import pure_projection_value_to_artifacts
+from .pure_replay_core import (
+    BINDING_UNRESOLVED,
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_COMPLETE,
+    DERIVED_PURE_REPLAY_PROFILE,
+    DURABLE_INPUT_INVALID,
+    DURABLE_INPUT_MISSING,
+    EVALUATION_FAILED,
+    OUTPUT_CONTRACT_INVALID,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    cursor_targets_witness,
+    validate_pure_completion_shell,
+)
+from .pure_replay_index import PureReplayNode, PureResultReplayIndex, derive_pure_result_replay_index
+
+EvaluateNode = Callable[[PureReplayNode, Mapping[str, Any]], Mapping[str, Any]]
+_UNSET = object()
+_INTRINSIC_TYPES = {"status": str, "phase": str, "class": str, "retryable": bool}
+
+
+def _err(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _row_view(state: Mapping[str, Any]) -> Mapping[str, Any]:
+    steps = state.get("steps")
+    return steps if isinstance(steps, Mapping) else {}
+
+
+def _input_matches(contract: Any, value: Any) -> bool:
+    value_type = getattr(contract, "value_type", None)
+    if value_type in {"string", "relpath", "enum"}:
+        return isinstance(value, str)
+    if value_type == "integer":
+        return type(value) is int
+    if value_type == "bool":
+        return type(value) is bool
+    if value_type == "float":
+        return isinstance(value, (int, float)) and type(value) is not bool
+    return True
+
+
+def _collect_addresses(value: Any, out: list[Any], seen: set[int]) -> None:
+    """Gather every typed address or ``root.steps`` ref reachable from a config object."""
+    if isinstance(value, str):
+        if value.startswith("root.steps."):
+            out.append(value)
+        return
+    if id(value) in seen or value is None or isinstance(value, (int, float, bool, bytes)):
+        return
+    seen.add(id(value))
+    if hasattr(value, "node_id") and (hasattr(value, "field") or hasattr(value, "output_name")):
+        out.append(value)
+    elif is_dataclass(value) and not isinstance(value, type):
+        for item in fields(value):
+            _collect_addresses(getattr(value, item.name), out, seen)
+    elif isinstance(value, Mapping):
+        for item in value.values():
+            _collect_addresses(item, out, seen)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for item in value:
+            _collect_addresses(item, out, seen)
+
+
+class PureReplayRuntime:
+    """Replay authority for one workflow scope (root or call frame)."""
+
+    def __init__(self, *, bundle: Any, scope_path: Any) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(bundle)
+        self._step_ids = {node.step_id: node.node_id for node in self.index.nodes.values()}
+        self._active: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._replayed: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # -- identity -----------------------------------------------------------
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self.index.nodes[node_id]
+        entry = self.bundle.projection.entries_by_node_id[node_id]
+        index = entry.compatibility_index
+        if not isinstance(index, int):
+            index = self.bundle.runtime_plan.nodes[node_id].execution_index
+        return PureReplayVisitWitness(node.presentation_key, index, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        node = self.index.nodes[node_id]
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        if type(visit) is not int or visit != 1:
+            raise _err(
+                PROGRESS_WITNESS_INVALID,
+                "eligible pure nodes must record exactly one visit",
+                node_id=node_id,
+                visit_count=visit,
+            )
+        return self.witness(node_id, visit_count=1)
+
+    @property
+    def derivable_presentation_keys(self) -> frozenset[str]:
+        return frozenset(node.presentation_key for node in self.index.nodes.values())
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._step_ids.get(step_id)
+
+    def durable_view(self, state: Mapping[str, Any]) -> Mapping[str, Any]:
+        """``state`` with this runtime's own overlay rows mapped back to their shells.
+
+        The overlay is only an in-memory projection; progress and surface checks
+        must always judge the durable shape.
+        """
+        steps = dict(_row_view(state))
+        changed = False
+        for node_id, (witness, row) in self._replayed.items():
+            key = witness.presentation_key
+            if isinstance(steps.get(key), Mapping) and dict(steps[key]) == row:
+                steps[key] = build_pure_completion_shell(witness)
+                changed = True
+        return {**state, "steps": steps} if changed else state
+
+    def overlay_cached_rows(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """``state`` with already-held full rows swapped in for their exact shells.
+
+        Never evaluates anything: only rows this process validated or replayed.
+        """
+        steps = dict(_row_view(state))
+        for node_id, (witness, row) in {**self._replayed, **self._active}.items():
+            current = steps.get(witness.presentation_key)
+            if isinstance(current, Mapping) and _is_shell(current, witness):
+                steps[witness.presentation_key] = copy.deepcopy(row)
+        return {**state, "steps": steps}
+
+    def invalidate(self, node_id: str) -> None:
+        """Forget held rows for a node being re-derived after its inputs were re-run."""
+        self._active.pop(node_id, None)
+        self._replayed.pop(node_id, None)
+
+    # -- active results -----------------------------------------------------
+
+    def record_full_result(self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]) -> None:
+        """Hold an active executor's validated full result in the process-local cache."""
+        node = self.index.nodes[node_id]
+        if witness != self.witness(node_id, visit_count=witness.visit_count) or witness.visit_count != 1:
+            raise _err(PROGRESS_WITNESS_INVALID, "witness does not belong to this node", node_id=node_id)
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise _err(DEPENDENCY_INDEX_INVALID, "active pure result must be a completed row", node_id=node_id)
+        artifacts = result.get("artifacts")
+        if not isinstance(artifacts, Mapping):
+            raise _err(DEPENDENCY_INDEX_INVALID, "active pure result carries no artifacts", node_id=node_id)
+        self._validate_artifacts(node, artifacts)
+        self._active[node_id] = (witness, copy.deepcopy(dict(result)))
+
+    @staticmethod
+    def _validate_artifacts(node: PureReplayNode, artifacts: Mapping[str, Any]) -> None:
+        """Rows hold the discriminant, shared outputs and the active variant's outputs only."""
+        contracts = node.output_contracts
+        discriminants = {
+            c["projection"]["discriminant_output"]
+            for c in contracts.values()
+            if isinstance(c.get("projection"), Mapping) and c["projection"].get("discriminant_output")
+        }
+        active = artifacts.get(next(iter(discriminants))) if len(discriminants) == 1 else None
+        expected = set()
+        for name, contract in contracts.items():
+            projection = contract.get("projection") if isinstance(contract, Mapping) else None
+            if (
+                isinstance(projection, Mapping)
+                and projection.get("projection_class") == "union_workflow_boundary"
+                and projection.get("field_role") == "variant"
+                and active not in projection.get("active_variants", ())
+            ):
+                continue
+            expected.add(name)
+        if set(artifacts) != expected:
+            raise _err(
+                DEPENDENCY_INDEX_INVALID,
+                "pure row members do not match the active union variant",
+                node_id=node.node_id,
+                missing=sorted(expected - set(artifacts)),
+                extra=sorted(set(artifacts) - expected),
+            )
+
+    # -- evaluation ---------------------------------------------------------
+
+    def _default_evaluate(self, node: PureReplayNode, resolved: Mapping[str, Any]) -> Mapping[str, Any]:
+        from pathlib import Path
+
+        value = evaluate_pure_expr(node.payload, resolved_bindings=resolved)
+        return pure_projection_value_to_artifacts(
+            value, output_contracts=node.output_contracts, workspace=Path.cwd()
+        )
+
+    def _durable_value(self, address: Any, state: Mapping[str, Any], rows: Mapping[str, Any]) -> tuple[bool, Any]:
+        if hasattr(address, "input_name"):
+            inputs = state.get("bound_inputs")
+            if not isinstance(inputs, Mapping) or address.input_name not in inputs:
+                raise _err(DURABLE_INPUT_MISSING, "bound input is missing", input=address.input_name)
+            value = inputs[address.input_name]
+            if not _input_matches(self.bundle.ir.inputs.get(address.input_name), value):
+                raise _err(DURABLE_INPUT_INVALID, "bound input has the wrong type", input=address.input_name)
+            return True, value
+        key = self.bundle.projection.entries_by_node_id[address.node_id].presentation_key
+        row = rows.get(key)
+        if not isinstance(row, Mapping):
+            return False, None
+        field_name = getattr(address, "field", "artifacts")
+        member = getattr(address, "member", None) or getattr(address, "output_name", None)
+        if field_name == "exit_code":
+            if type(row.get("exit_code")) is not int:
+                raise _err(DURABLE_INPUT_INVALID, "durable exit_code is not an integer", step=key)
+            return True, row["exit_code"]
+        container = row.get(field_name)
+        if not isinstance(container, Mapping) or member not in container:
+            return False, None
+        value = container[member]
+        expected = _INTRINSIC_TYPES.get(member) if field_name == "outcome" else None
+        if expected is not None and type(value) is not expected:
+            raise _err(DURABLE_INPUT_INVALID, "durable outcome member has the wrong type", step=key, member=member)
+        return True, value
+
+    def _leaf(self, ref: str, node: PureReplayNode, state: Mapping[str, Any], rows: dict, evaluate: EvaluateNode) -> Any:
+        address = self.index.parse_address(ref)
+        owner = getattr(address, "node_id", None)
+        if owner in self.index.nodes:
+            rows[self.index.nodes[owner].presentation_key] = self._row(owner, state, rows, evaluate)
+        found, value = self._durable_value(address, state, rows)
+        if not found:
+            raise _err(
+                BINDING_UNRESOLVED,
+                "binding ref did not resolve",
+                node_id=node.node_id,
+                ref=ref,
+                cause={"type": "materialize_ref_unresolved"},
+            )
+        return value
+
+    def _materialize(self, doc: Any, node: PureReplayNode, state, rows, evaluate) -> Any:
+        if isinstance(doc, Mapping) and set(doc) == {"ref"} and isinstance(doc["ref"], str):
+            return self._leaf(doc["ref"], node, state, rows, evaluate)
+        if isinstance(doc, Mapping):
+            return {k: self._materialize(v, node, state, rows, evaluate) for k, v in doc.items()}
+        if isinstance(doc, list):
+            return [self._materialize(v, node, state, rows, evaluate) for v in doc]
+        return doc
+
+    def _row(self, node_id: str, state: Mapping[str, Any], rows: dict, evaluate: EvaluateNode) -> dict[str, Any]:
+        node = self.index.nodes[node_id]
+        state = self.durable_view(state)
+        witness = self.witness_from_state(node_id, state)
+        durable = _row_view(state).get(node.presentation_key)
+        active = self._active.get(node_id)
+        if active is not None and active[0] != witness:
+            raise _err(PROGRESS_WITNESS_INVALID, "cached active result is stale", node_id=node_id)
+        if isinstance(durable, Mapping) and not _is_shell(durable, witness):
+            # active-result form: only the exact validated row, with no cursor on this node
+            if active is None or dict(durable) != active[1] or cursor_targets_witness(state, witness):
+                raise _err(PROGRESS_WITNESS_INVALID, "pure row is neither the shell nor the active result", node_id=node_id)
+            return copy.deepcopy(active[1])
+        if classify_pure_replay_progress(state, witness=witness) != DERIVED_COMPLETE:
+            raise _err(PROGRESS_WITNESS_INVALID, "pure node is not derived-complete", node_id=node_id)
+        if active is not None:
+            return copy.deepcopy(active[1])
+        cached = self._replayed.get(node_id)
+        if cached is not None and cached[0] == witness:
+            return copy.deepcopy(cached[1])
+        resolved = {
+            name: self._materialize(doc, node, state, rows, evaluate) for name, doc in node.binding_docs.items()
+        }
+        artifacts = self._evaluate(node, resolved, evaluate)
+        self._validate_artifacts(node, artifacts)
+        row = {**build_pure_completion_shell(witness), "artifacts": dict(artifacts)}
+        self._replayed[node_id] = (witness, copy.deepcopy(row))
+        return row
+
+    @staticmethod
+    def _evaluate(node: PureReplayNode, resolved: Mapping[str, Any], evaluate: EvaluateNode) -> Mapping[str, Any]:
+        try:
+            return evaluate(node, resolved)
+        except PureExprEvaluationError as exc:
+            raise _err(EVALUATION_FAILED, str(exc), node_id=node.node_id, cause={"type": "pure_evaluation_failed"}) from exc
+        except OutputContractError as exc:
+            raise _err(
+                OUTPUT_CONTRACT_INVALID,
+                "pure result violates its output contract",
+                node_id=node.node_id,
+                cause={"type": "pure_projection_contract_invalid"},
+            ) from exc
+
+    def replay_node(self, node_id: str, *, state: Mapping[str, Any], evaluate_node: EvaluateNode) -> dict[str, Any]:
+        """Evaluate one node over the overlay; returns its transient full row."""
+        if node_id not in self.index.nodes:
+            raise _err(DEPENDENCY_INDEX_INVALID, "node is not replay-eligible", node_id=node_id)
+        return self._row(node_id, state, dict(_row_view(state)), evaluate_node)
+
+    def resolve_state_address(
+        self, address: Any, state: Mapping[str, Any], *, evaluate_node: Optional[EvaluateNode] = None
+    ) -> tuple[bool, Any]:
+        address = self.index.parse_address(address)
+        rows = dict(_row_view(state))
+        owner = getattr(address, "node_id", None)
+        if owner in self.index.nodes and self._has_row(owner, state):
+            rows[self.index.nodes[owner].presentation_key] = self._row(
+                owner, state, rows, evaluate_node or self._default_evaluate
+            )
+        return self._durable_value(address, state, rows)
+
+    def value_for_state_address(self, address: Any, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _err(BINDING_UNRESOLVED, "address did not resolve", cause={"type": "materialize_ref_unresolved"})
+        return value
+
+    def _has_row(self, node_id: str, state: Mapping[str, Any]) -> bool:
+        return isinstance(_row_view(state).get(self.index.nodes[node_id].presentation_key), Mapping)
+
+    # -- boundary planning --------------------------------------------------
+
+    def _reached(self, state: Mapping[str, Any]) -> set[str]:
+        return {
+            node_id
+            for node_id, node in self.index.nodes.items()
+            if isinstance(row := _row_view(state).get(node.presentation_key), Mapping) and row.get("status") == "completed"
+        }
+
+    def _downstream_nodes(self, restart_node_id: Optional[str]) -> list[Any]:
+        ir, plan = self.bundle.ir, self.bundle.runtime_plan
+        ordered = list(plan.ordered_node_ids)
+        tail = ordered[ordered.index(restart_node_id):] if restart_node_id in ordered else []
+        node_ids = set(tail) | set(ir.finalization_region)
+        for node_id in tail:
+            node_ids.update(plan.nodes[node_id].nested_body_node_ids)
+        return [ir.nodes[node_id] for node_id in ir.nodes if node_id in node_ids]
+
+    def required_node_ids_for_boundary(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        seeds: list[Any] = []
+        seen: set[int] = set()
+        for node in self._downstream_nodes(restart_node_id):
+            _collect_addresses(node, seeds, seen)
+        _collect_addresses(dict(self.bundle.ir.outputs), seeds, seen)
+        addresses = []
+        for seed in seeds:
+            try:
+                addresses.append(self.index.parse_address(seed))
+            except PureResultReplayIndexError:
+                continue
+        eligible_after = {
+            n.node_id for n in self._downstream_nodes(restart_node_id) if n.node_id in self.index.nodes
+        }
+        reached = self._reached(state) - eligible_after if restart_node_id else self._reached(state)
+        return self.index.required_pure_node_ids(addresses, reached_node_ids=reached)
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> None:
+        """Validate only the durable leaves the required pure nodes depend on."""
+        rows = _row_view(state)
+        for node_id in self.required_node_ids_for_boundary(restart_node_id, state=state):
+            for binding in self.index.nodes[node_id].bindings:
+                owner = getattr(binding.address, "node_id", None)
+                if owner in self.index.nodes:
+                    continue
+                found, _ = self._durable_value(binding.address, state, rows)
+                if not found:
+                    raise _err(
+                        BINDING_UNRESOLVED,
+                        "durable dependency did not resolve",
+                        node_id=node_id,
+                        ref=binding.ref,
+                        cause={"type": "materialize_ref_unresolved"},
+                    )
+
+    def overlay_active_state(self, state: Mapping[str, Any], *, restart_node_id: Any = _UNSET,
+                             evaluate_node: Optional[EvaluateNode] = None) -> dict[str, Any]:
+        """Shallow copy of ``state`` whose ``steps`` carry transient rows for replayed nodes."""
+        evaluate = evaluate_node or self._default_evaluate
+        if restart_node_id is _UNSET:
+            needed: Iterable[str] = [n for n in self.index.topological_node_ids if n in self._reached(state)]
+        else:
+            needed = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        steps = dict(_row_view(state))
+        for node_id in needed:
+            node = self.index.nodes[node_id]
+            steps[node.presentation_key] = self._row(node_id, state, steps, evaluate)
+        overlay = dict(state)
+        overlay["steps"] = steps
+        return overlay
+
+    # -- persisted-surface audit -------------------------------------------
+
+    def audit_persisted_surfaces(self, *, state: Mapping[str, Any], state_manager: Any, resolve_bundle_path: Callable[[str], Any]) -> None:
+        """Fail closed on any persisted value surface or inconsistent progress for eligible nodes."""
+        state = self.durable_view(state)
+        rows = _row_view(state)
+        for node_id, node in self.index.nodes.items():
+            row = rows.get(node.presentation_key)
+            if isinstance(row, Mapping) and row.get("status") == "completed":
+                try:
+                    validate_pure_completion_shell(row, witness=self.witness(node_id))
+                except ValueError as exc:
+                    if row.get("result_storage") == DERIVED_PURE_REPLAY_PROFILE and row.get("visit_count") != 1:
+                        raise _err(PROGRESS_WITNESS_INVALID, "pure shell does not match its single visit",
+                                   node_id=node_id) from exc
+                    raise _err(PROFILE_CONFLICT, "eligible pure node has a persisted value row",
+                               surface="steps", node_id=node_id) from exc
+            self._audit_progress(node_id, state)
+            path = resolve_bundle_path(node_id)
+            if path is not None and path.exists():
+                raise _err(PROFILE_CONFLICT, "eligible pure node has a persisted result bundle",
+                           surface="pure_bundle", node_id=node_id)
+        self._audit_lineage(state)
+        self._audit_checkpoints(state_manager)
+
+    def audit_progress(self, state: Mapping[str, Any]) -> None:
+        """Every eligible node's visit, cursor and row must classify cleanly."""
+        state = self.durable_view(state)
+        for node_id in self.index.nodes:
+            self._audit_progress(node_id, state)
+
+    def _audit_progress(self, node_id: str, state: Mapping[str, Any]) -> None:
+        node = self.index.nodes[node_id]
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        witness = self.witness(node_id, visit_count=visit if type(visit) is int else 1)
+        row = _row_view(state).get(node.presentation_key)
+        skipped_without_visit = visit is None and isinstance(row, Mapping) and row.get("status") == "skipped"
+        if skipped_without_visit:
+            return
+        if type(visit) is int and visit != 1:
+            raise _err(PROGRESS_WITNESS_INVALID, "eligible pure node was visited more than once", node_id=node_id, visit_count=visit)
+        classify_pure_replay_progress(state, witness=witness)
+
+    def _audit_lineage(self, state: Mapping[str, Any]) -> None:
+        keys = {n.step_id for n in self.index.nodes.values()} | {n.presentation_key for n in self.index.nodes.values()}
+        for entries in (state.get("private_artifact_versions") or {}).values():
+            for entry in entries if isinstance(entries, list) else ():
+                if isinstance(entry, Mapping) and (entry.get("producer") in keys or entry.get("producer_name") in keys):
+                    raise _err(PROFILE_CONFLICT, "eligible pure node has private lineage",
+                               surface="private_artifact_versions")
+
+    def _audit_checkpoints(self, state_manager: Any) -> None:
+        from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_index_path
+
+        frame_id = self.scope_path.call_frame_ids[-1] if self.scope_path.call_frame_ids else None
+        step_ids = {n.step_id.removeprefix("root.") for n in self.index.nodes.values()} | {
+            n.step_id for n in self.index.nodes.values()
+        }
+        eligible_nodes = set(self.index.nodes)
+        for point in self.bundle.runtime_plan.lexical_checkpoint_points:
+            index = _read_sidecar(
+                state_manager,
+                resolve_checkpoint_index_path(
+                    state_manager=state_manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+                ),
+            )
+            for entry in (index or {}).get("records", ()):
+                if (entry.get("frame_identity") or {}).get("call_frame_id") != frame_id:
+                    continue
+                if point.node_id in eligible_nodes:
+                    raise _err(PROFILE_CONFLICT, "eligible pure node has a checkpoint record",
+                               surface="checkpoint_record", node_id=point.node_id)
+                record = _read_sidecar(state_manager, state_manager.workspace / entry["record_path"])
+                for binding in ((record or {}).get("restore_payload") or {}).get("bindings", ()):
+                    if binding.get("source_step_id") in step_ids:
+                        raise _err(PROFILE_CONFLICT, "restore payload binds an eligible pure result",
+                                   surface="restore_payload", node_id=point.node_id)
+
+
+def _read_sidecar(state_manager: Any, path: Any) -> Optional[Mapping[str, Any]]:
+    """Checkpoint sidecars are shadow evidence, not authority: resume already ignores
+    unreadable ones, so an unreadable sidecar cannot be a conflicting record either."""
+    try:
+        return state_manager.read_runtime_sidecar_json(path)
+    except (OSError, ValueError):
+        return None
+
+
+def _is_shell(row: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True

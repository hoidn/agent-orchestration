@@ -0,0 +1,195 @@
+"""Shared vocabulary for the ``derived_pure_replay.v1`` result-persistence profile.
+
+Owns the error type, reason constants, the value-free completion shell and the
+progress classifier. Depends only on ``orchestrator.state`` constants, so both
+``StateManager`` (write side) and the replay runtime (read side) can import it.
+Behaviour is specified in ``specs/state.md`` (result_persistence_profile).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from ..state import PROFILE_DERIVED_PURE_REPLAY as DERIVED_PURE_REPLAY_PROFILE
+
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+DURABLE_INPUT_MISSING = "durable_input_missing"
+DURABLE_INPUT_INVALID = "durable_input_invalid"
+BINDING_UNRESOLVED = "binding_unresolved"
+EVALUATION_FAILED = "evaluation_failed"
+OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+
+PURE_STEP_TYPE = "pure_projection"
+
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+
+class PureResultReplayIndexError(ValueError):
+    """A pure-result replay precondition failed; callers must fail closed."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row for a single-visit pure step."""
+    if witness.visit_count != 1:
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            "pure completion shells exist only for single-visit executions",
+            context={"visit_count": witness.visit_count},
+        )
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's shell."""
+    expected = build_pure_completion_shell(witness)
+    if not isinstance(row, Mapping):
+        raise ValueError("pure completion shell must be a mapping")
+    if dict(row) != expected:
+        diff = sorted(
+            key for key in set(row) | set(expected) if row.get(key, _MISSING) != expected.get(key, _MISSING)
+        )
+        raise ValueError(f"pure completion shell mismatch on keys: {diff}")
+    # == treats True/1 and False/0 alike; the shell must carry the exact types.
+    if (
+        type(row["visit_count"]) is not int
+        or type(row["exit_code"]) is not int
+        or type(row["outcome"]["retryable"]) is not bool
+    ):
+        raise ValueError("pure completion shell carries wrongly typed scalars")
+
+
+_MISSING = object()
+
+
+def _is_exact_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True
+
+
+def _invalid(message: str, witness: PureReplayVisitWitness, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID,
+        message,
+        context={"presentation_key": witness.presentation_key, "step_id": witness.step_id, **context},
+    )
+
+
+def _cursor_targets(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key or cursor.get("step_id") == witness.step_id
+    )
+
+
+def cursor_targets_witness(state: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    """True when ``current_step`` names this node by presentation key or step id."""
+    return _cursor_targets(state.get("current_step"), witness)
+
+
+def _cursor_is_exact(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and type(cursor.get("index")) is int
+        and cursor.get("type") == PURE_STEP_TYPE
+        and cursor.get("visit_count") == witness.visit_count
+        and type(cursor.get("visit_count")) is int
+        and cursor.get("status") == "running"
+    )
+
+
+def _row_is_failure_or_skip(row: Any, witness: PureReplayVisitWitness) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("visit_count") == witness.visit_count
+        and type(row.get("visit_count")) is int
+        and row.get("step_id") == witness.step_id
+        and row.get("name", witness.presentation_key) == witness.presentation_key
+    )
+
+
+def classify_pure_replay_progress(state: Mapping[str, Any], *, witness: PureReplayVisitWitness) -> str:
+    """Classify the state's visit, cursor and row for one pure witness.
+
+    Returns ``unstarted``, ``interrupted``, ``derived_complete`` or
+    ``durable_failure_skip``; every other combination raises
+    ``PureResultReplayIndexError(progress_witness_invalid)``.
+    """
+    key = witness.presentation_key
+    visits = state.get("step_visits")
+    visit = visits.get(key) if isinstance(visits, Mapping) else None
+    steps = state.get("steps")
+    row = steps.get(key) if isinstance(steps, Mapping) else None
+    cursor = state.get("current_step")
+    has_cursor = _cursor_targets(cursor, witness)
+
+    if visit is None:
+        if has_cursor or row is not None:
+            raise _invalid("cursor or row present without a recorded visit", witness)
+        return UNSTARTED
+    if type(visit) is not int or visit != witness.visit_count:
+        raise _invalid("recorded visit does not match the witness", witness, visit_count=visit)
+
+    if has_cursor:
+        if row is not None:
+            raise _invalid("running cursor coexists with a result row", witness)
+        if not _cursor_is_exact(cursor, witness):
+            raise _invalid("running cursor does not match the witness", witness)
+        return INTERRUPTED
+    if row is None:
+        raise _invalid("visit recorded without a cursor or a result row", witness)
+    if _is_exact_shell(row, witness):
+        return DERIVED_COMPLETE
+    if _row_is_failure_or_skip(row, witness):
+        return DURABLE_FAILURE_SKIP
+    raise _invalid("result row is neither the exact shell nor a failure/skip", witness)

+"""Profile selection for call-frame state (specs/state.md, result_persistence_profile)."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.call_frame_state import (
+    _CallFrameStateManager,
+    load_existing_call_frame_read_only,
+)
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+VALID = Path(__file__).parent / "fixtures" / "workflow_lisp" / "valid"
+PROFILE = "derived_pure_replay.v1"
+
+
+@pytest.fixture
+def parent(tmp_path):
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="parent")
+    manager.initialize("w.orc", result_persistence_profile=PROFILE)
+    return manager
+
+
+@pytest.fixture
+def workflow(tmp_path):
+    result = compile_stage3_entrypoint(
+        VALID / "pure_expr_selector_action_projection.orc",
+        source_roots=(VALID,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return result.validated_bundles_by_name["pure_expr_selector_action_projection::orchestrate"]
+
+
+def _frame(parent, workflow, existing=None, **extra):
+    return _CallFrameStateManager(
+        parent_manager=parent,
+        workflow=workflow,
+        frame_id="frame-1",
+        call_step_name="call",
+        call_step_id="root.call",
+        import_alias="child",
+        bound_inputs={},
+        existing_frame=existing,
+        **extra,
+    )
+
+
+def test_fresh_frame_records_requested_profile(parent, workflow):
+    frame = _frame(parent, workflow, result_persistence_profile=PROFILE)
+    assert frame.state.result_persistence_profile == PROFILE
+    assert parent.state.call_frames["frame-1"]["state"]["result_persistence_profile"] == PROFILE
+
+
+def test_fresh_frame_defaults_to_historical(parent, workflow):
+    frame = _frame(parent, workflow)
+    assert frame.state.result_persistence_profile is None
+    assert "result_persistence_profile" not in parent.state.call_frames["frame-1"]["state"]
+
+
+def test_existing_frame_is_never_backfilled(parent, workflow):
+    _frame(parent, workflow)
+    existing = copy.deepcopy(parent.state.call_frames["frame-1"])
+    resumed = _frame(parent, workflow, existing, result_persistence_profile=PROFILE)
+    assert resumed.state.result_persistence_profile is None
+    assert "result_persistence_profile" not in parent.state.call_frames["frame-1"]["state"]
+
+
+@pytest.mark.parametrize("existing", [{}, {"state": None}, {"state": "text"}, {"status": "running"}])
+def test_malformed_existing_frame_is_rejected_before_any_write(parent, workflow, existing):
+    before = parent.state_file.read_bytes()
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        _frame(parent, workflow, existing)
+    assert parent.state_file.read_bytes() == before
+    assert not (parent.run_root / "call_frames").exists()
+
+
+def test_read_only_loader_returns_detached_copy_without_side_effects(tmp_path):
+    frame = {"state": {"steps": {"a": {"status": "completed"}}}}
+    before = sorted(tmp_path.rglob("*"))
+    loaded = load_existing_call_frame_read_only(frame)
+    loaded["steps"]["a"]["status"] = "mutated"
+    assert frame["state"]["steps"]["a"]["status"] == "completed"
+    assert sorted(tmp_path.rglob("*")) == before
+
+
+def test_profile_survives_snapshot_round_trip(parent, workflow):
+    _frame(parent, workflow, result_persistence_profile=PROFILE)
+    persisted = json.loads(parent.state_file.read_text())
+    assert persisted["call_frames"]["frame-1"]["state"]["result_persistence_profile"] == PROFILE

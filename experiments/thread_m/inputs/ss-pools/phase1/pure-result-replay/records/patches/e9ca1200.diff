+        _compile_pure_projection_bundle(tmp_path), {"approved": True, "status": {"ref": "inputs.status"}}
+    )
+    (node,) = derive_pure_result_replay_index(bundle).nodes.values()
+    assert [b.path for b in node.bindings] == [("status",)]
+
+
+def test_loop_owned_pure_nodes_are_not_eligible(tmp_path: Path) -> None:
+    index = derive_pure_result_replay_index(_compile_fixture(tmp_path))
+    assert index.nodes and index.ineligible_pure_reasons
+    assert set(index.ineligible_pure_reasons.values()) == {MULTIPLE_VISIT_REGION}
+    assert not set(index.nodes) & set(index.ineligible_pure_reasons)

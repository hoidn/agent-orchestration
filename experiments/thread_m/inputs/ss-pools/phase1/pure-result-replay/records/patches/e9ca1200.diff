+
+# -- runtime ----------------------------------------------------------------------
+
+def test_runtime_maps_durable_step_id_not_raw_node_id(tmp_path: Path) -> None:
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc"))
+    (node_id,) = runtime.index.nodes
+    node = runtime.index.nodes[node_id]

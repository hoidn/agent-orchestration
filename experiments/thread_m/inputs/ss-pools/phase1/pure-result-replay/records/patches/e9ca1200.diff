+
+# -- end to end -----------------------------------------------------------------
+
+def _profiled_run(tmp_path: Path, *, profile: str | None = PROFILE):
+    bundle = _compile_fixture(tmp_path)
+    (tmp_path / "artifacts/work").mkdir(parents=True)
+    (tmp_path / "artifacts/work/r.md").write_text("x", encoding="utf-8")
+    manager = StateManager(workspace=tmp_path, run_id="r")
+    manager.initialize(
+        str(tmp_path / FIXTURE.name),
+        context=workflow_lisp_context_with_lowering_schema(bundle_context_dict(bundle), 2),
+        bound_inputs={"report_path": "artifacts/work/r.md", "summary_target": "artifacts/work/s.json"},
+        result_persistence_profile=profile,
+    )
+    return bundle, manager, WorkflowExecutor(bundle, tmp_path, manager).execute()
+
+
+def _drop_checkpoint_records(bundle: Any, manager: StateManager, *, step_suffix: str) -> None:
+    """Simulate a crash before the effect's checkpoint record was committed."""
+    from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_index_path
+
+    for point in bundle.runtime_plan.lexical_checkpoint_points:
+        if point.step_id.endswith(step_suffix):
+            index_path = resolve_checkpoint_index_path(
+                state_manager=manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+            )
+            for entry in json.loads(index_path.read_text())["records"]:
+                (manager.workspace / entry["record_path"]).unlink()
+            index_path.unlink()
+
+
+def test_profiled_run_leaves_eligible_results_value_free(tmp_path: Path) -> None:
+    bundle, manager, final = _profiled_run(tmp_path)
+    plain_dir = tmp_path / "plain"
+    plain_dir.mkdir()
+    _, _, plain = _profiled_run(plain_dir, profile=None)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc"))
+    durable = json.loads(manager.state_file.read_text())
+    for node in runtime.index.nodes.values():
+        assert durable["steps"][node.presentation_key] == build_pure_completion_shell(runtime.witness(node.node_id))
+    assert final["workflow_outputs"] == plain["workflow_outputs"]
+    assert durable["call_frames"] and all(
+        frame["state"]["result_persistence_profile"] == PROFILE for frame in durable["call_frames"].values()
+    )
+
+
+def test_resume_rederives_pure_values_without_persisted_results(tmp_path: Path) -> None:
+    bundle, manager, first = _profiled_run(tmp_path)
+    view = "lexical_checkpoint_restore_regions::orchestrate__materialize-view__runtime-summary"
+    manager.load()
+    manager.state.steps.pop(view)
+    manager.state.status = "running"
+    manager.state.workflow_outputs = {}
+    manager._write_state()
+    (tmp_path / "artifacts/work/s.json").unlink()
+    _drop_checkpoint_records(bundle, manager, step_suffix="materialize_view__runtime_summary")
+    resumed = WorkflowExecutor(bundle, tmp_path, StateManager(workspace=tmp_path, run_id="r")).execute(resume=True)
+    assert resumed["status"] == "completed", resumed.get("error")
+    assert resumed["workflow_outputs"] == first["workflow_outputs"]
+    assert json.loads((tmp_path / "artifacts/work/s.json").read_text())["status"] == "ready-summary"
+
+
+def test_resume_rejects_visit_two_shell_before_any_effect(tmp_path: Path) -> None:
+    bundle, manager, _ = _profiled_run(tmp_path)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w.orc"))
+    key = next(iter(runtime.index.nodes.values())).presentation_key
+    manager.load()
+    manager.state.step_visits[key] = 2
+    manager.state.status = "running"

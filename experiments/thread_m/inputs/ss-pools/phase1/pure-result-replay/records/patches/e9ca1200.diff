@@ -0,0 +1,53 @@
+"""Audit lexical-checkpoint sidecars for records of replay-eligible pure nodes.
+
+Type signature: ``audit_checkpoint_surfaces(runtime, *, state, state_manager)``.
+Dependencies: checkpoint index/record sidecar files under the run root, the
+bundle's runtime-plan checkpoint points, the replay runtime's eligible nodes.
+Behavior: raises ``PureResultReplayIndexError`` (``profile_conflict``) when this
+scope holds a checkpoint record for, or a restore binding sourced from, an
+eligible pure step. Records of other frames and noneligible nodes are allowed.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from orchestrator.workflow.pure_result_replay_index import PROFILE_CONFLICT, PureResultReplayIndexError
+
+from .lexical_checkpoints import _load_json_object, _point_field, resolve_checkpoint_index_path
+
+
+def _conflict(surface: str, step_id: str, checkpoint_id: str) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROFILE_CONFLICT,
+        f"{surface} exists for eligible pure step '{step_id}'",
+        context={"surface": surface, "step_id": step_id, "checkpoint_id": checkpoint_id},
+    )
+
+
+def audit_checkpoint_surfaces(runtime: Any, *, state: Mapping[str, Any], state_manager: Any) -> None:
+    eligible_step_ids = {node.step_id for node in runtime.index.nodes.values()}
+    frame_ids = runtime.scope_path.call_frame_ids
+    scope_frame_id = frame_ids[-1] if frame_ids else None
+    plan = runtime.bundle.runtime_plan
+    for point in getattr(plan, "lexical_checkpoint_points", ()):
+        checkpoint_id = str(_point_field(point, "checkpoint_id") or "")
+        point_step_id = _point_field(point, "step_id")
+        index = _load_json_object(
+            state_manager,
+            resolve_checkpoint_index_path(
+                state_manager=state_manager,
+                workflow_name=str(_point_field(point, "workflow_name") or plan.workflow_name),
+                checkpoint_id=checkpoint_id,
+            ),
+        )
+        for entry in (index or {}).get("records", ()):
+            identity = entry.get("frame_identity") or {}
+            if identity.get("call_frame_id") != scope_frame_id:
+                continue
+            if point_step_id in eligible_step_ids:
+                raise _conflict("checkpoint_record", point_step_id, checkpoint_id)
+            record = _load_json_object(state_manager, state_manager.workspace / str(entry.get("record_path")))
+            for binding in ((record or {}).get("restore_payload") or {}).get("bindings", ()):
+                if binding.get("source_step_id") in eligible_step_ids:
+                    raise _conflict("restore_payload", binding["source_step_id"], checkpoint_id)

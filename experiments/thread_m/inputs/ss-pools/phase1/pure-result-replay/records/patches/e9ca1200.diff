+"""Atomic visit transitions for eligible pure projections over a ``RunState``.
+
+Type signatures: each helper takes a ``RunState`` (and a ``PureReplayVisitWitness``)
+and returns the visit count / shell / None. Dependencies: the progress classifier
+and shell builder of ``pure_result_replay``. Behavior: every helper validates
+before it mutates, so a caller persists exactly one consistent state or none.
+"""
+
+from __future__ import annotations
+
+import copy
+from datetime import datetime, timezone
+from typing import Any
+
+from .pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PURE_STEP_TYPE,
+    PureReplayVisitWitness,
+    _is_failure_or_skip,
+    _progress_invalid,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+)
+
+def _progress_view(run_state: Any) -> dict[str, Any]:
+    return {
+        "steps": run_state.steps,
+        "step_visits": run_state.step_visits,
+        "current_step": run_state.current_step,
+    }
+
+
+def _require_profile(run_state: Any) -> None:
+    if run_state.result_persistence_profile != DERIVED_PURE_REPLAY_PROFILE:
+        raise ValueError("eligible pure visits require result_persistence_profile derived_pure_replay.v1")
+
+
+def begin_eligible_pure_visit_state(run_state: Any, *, step_name: str, step_index: int, step_id: str) -> int:
+    _require_profile(run_state)
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    if classify_pure_replay_progress(_progress_view(run_state), witness=witness) != "unstarted":
+        raise _progress_invalid("eligible pure node was already visited", step_name=step_name)
+    now = datetime.now(timezone.utc).isoformat()
+    run_state.step_visits[step_name] = 1
+    run_state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": PURE_STEP_TYPE,
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def reuse_interrupted_eligible_pure_visit_state(run_state: Any, witness: PureReplayVisitWitness) -> int:
+    _require_profile(run_state)
+    if classify_pure_replay_progress(_progress_view(run_state), witness=witness) != "interrupted":
+        raise _progress_invalid("no interrupted eligible pure visit", step_name=witness.presentation_key)
+    return witness.visit_count
+
+
+def settle_eligible_pure_success_state(run_state: Any, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    reuse_interrupted_eligible_pure_visit_state(run_state, witness)
+    shell = build_pure_completion_shell(witness)
+    run_state.steps[witness.presentation_key] = shell
+    run_state.current_step = None
+    return copy.deepcopy(shell)
+
+
+def settle_eligible_pure_failure_state(run_state: Any, witness: PureReplayVisitWitness, result: Any) -> None:
+    reuse_interrupted_eligible_pure_visit_state(run_state, witness)
+    row = result.to_dict() if hasattr(result, "to_dict") else dict(result)
+    if not _is_failure_or_skip(row, witness):
+        raise _progress_invalid("settled failure must be a full failed or skipped row", step_name=witness.presentation_key)
+    run_state.steps[witness.presentation_key] = result
+    run_state.current_step = None

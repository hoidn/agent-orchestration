+    assert RunState.from_dict(payload).result_persistence_profile == PROFILE
+
+
+def test_unsupported_profile_fails_closed_at_construction() -> None:
+    with pytest.raises(ValueError, match="profile"):
+        _run_state(result_persistence_profile="other.v1")
+
+
+def test_unsupported_profile_fails_closed_at_initialize(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+    with pytest.raises(ValueError, match="profile"):
+        StateManager(tmp_path, run_id="r").initialize("w.orc", result_persistence_profile="other.v1")
+
+
+def test_unsupported_profile_load_leaves_file_unchanged(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    payload = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    payload["result_persistence_profile"] = "other.v1"
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError, match="profile"):
+        StateManager(tmp_path, run_id="r").load()
+    assert manager.state_file.read_bytes() == before

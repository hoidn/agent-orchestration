+
+# -- selector -----------------------------------------------------------------
+
+def test_absent_profile_is_omitted_and_round_trips() -> None:
+    payload = _run_state().to_dict()
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None

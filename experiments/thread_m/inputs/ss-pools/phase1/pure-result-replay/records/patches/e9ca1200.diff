new file mode 100644
index 0000000..42256c3
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,515 @@
+"""Derived pure-result replay: value-free completion shells and in-memory replay.
+
+Type signatures: see the individual classes. Dependencies: the replay index
+(static, from the bundle), and the run-state mapping handed in by the caller
+(``steps``, ``step_visits``, ``current_step``, ``bound_inputs``). Behavior:
+under profile ``derived_pure_replay.v1`` an eligible pure projection persists
+only an exact value-free completion shell; resume re-derives the values into a
+process-local overlay. Nothing here dispatches an effect, increments a visit,
+settles a result or writes durable state.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from .executable_ir import NodeResultAddress, WorkflowInputAddress
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_result_replay_index import (
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_PURE_REPLAY_PROFILE,
+    MULTIPLE_VISIT_REGION,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PURE_RESULT_REPLAY_UNAVAILABLE,
+    REACHABILITY_AMBIGUOUS,
+    PureBinding,
+    PureReplayNode,
+    PureResultReplayIndex,
+    PureResultReplayIndexError,
+    _propagate_pure_ineligibility,
+    _reachable_successors,
+    derive_pure_result_replay_index,
+)
+from .resume_projection_integrity import ResumeScopePath
+
+__all__ = [
+    "DERIVED_PURE_REPLAY_PROFILE",
+    "DEPENDENCY_INDEX_INVALID",
+    "MULTIPLE_VISIT_REGION",
+    "PROFILE_CONFLICT",
+    "PROGRESS_WITNESS_INVALID",
+    "PURE_RESULT_REPLAY_UNAVAILABLE",
+    "REACHABILITY_AMBIGUOUS",
+    "PureBinding",
+    "PureReplayNode",
+    "PureReplayRuntime",
+    "PureReplayVisitWitness",
+    "PureResultReplayIndex",
+    "PureResultReplayIndexError",
+    "_propagate_pure_ineligibility",
+    "build_pure_completion_shell",
+    "classify_pure_replay_progress",
+    "derive_pure_result_replay_index",
+    "validate_pure_completion_shell",
+]
+
+PURE_STEP_TYPE = "pure_projection"
+_OUTCOME_FIELDS = {"status": str, "phase": str, "class": str, "retryable": bool}
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def _progress_invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(PROGRESS_WITNESS_INVALID, message, context=context)
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=repr)
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row for ``witness``."""
+    if witness.visit_count != 1 or type(witness.visit_count) is not int:
+        raise _progress_invalid("a value-free completion requires visit one", visit_count=witness.visit_count)
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _is_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    if not isinstance(row, Mapping) or witness.visit_count != 1:
+        return False
+    return _canonical(dict(row)) == _canonical(build_pure_completion_shell(witness))
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the completion shell."""
+    if not _is_shell(row, witness):
+        raise ValueError("row is not the exact derived-pure completion shell")
+
+
+def _cursor_is_related(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _cursor_matches(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and cursor.get("type") == PURE_STEP_TYPE
+        and cursor.get("status") == "running"
+        and cursor.get("visit_count") == witness.visit_count
+        and type(cursor.get("visit_count")) is int
+    )
+
+
+def _is_failure_or_skip(row: Any, witness: PureReplayVisitWitness) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("name", witness.presentation_key) == witness.presentation_key
+        and row.get("step_id", witness.step_id) == witness.step_id
+        and row.get("visit_count", witness.visit_count) == witness.visit_count
+    )
+
+
+def classify_pure_replay_progress(state: Mapping[str, Any], *, witness: PureReplayVisitWitness) -> str:
+    """Classify the recorded visit, cursor and row for ``witness``."""
+    key = witness.presentation_key
+    steps = state.get("steps")
+    row = steps.get(key) if isinstance(steps, Mapping) else None
+    if hasattr(row, "to_dict"):
+        row = row.to_dict()
+    visits = state.get("step_visits")
+    visit = visits.get(key) if isinstance(visits, Mapping) else None
+    cursor = state.get("current_step")
+    related = _cursor_is_related(cursor, witness)
+    if visit is None and not related and row is None:
+        return "unstarted"
+    if type(visit) is not int or visit != witness.visit_count or witness.visit_count != 1:
+        return PROGRESS_WITNESS_INVALID
+    if related:
+        return "interrupted" if row is None and _cursor_matches(cursor, witness) else PROGRESS_WITNESS_INVALID
+    if _is_shell(row, witness):
+        return "derived_complete"
+    if _is_failure_or_skip(row, witness):
+        return "durable_failure_skip"
+    return PROGRESS_WITNESS_INVALID
+
+
+def _active_artifact_names(contracts: Mapping[str, Any], artifacts: Mapping[str, Any]) -> set[str]:
+    """Names of the outputs that a row holding ``artifacts`` must carry."""
+    names: set[str] = set()
+    for name, contract in contracts.items():
+        projection = contract.get("projection") if isinstance(contract, Mapping) else None
+        if not isinstance(projection, Mapping) or projection.get("projection_class") != "union_workflow_boundary":
+            names.add(name)
+        elif projection.get("field_role") != "variant":
+            names.add(name)
+        else:
+            discriminant = artifacts.get(projection.get("discriminant_output"))
+            if discriminant in (projection.get("active_variants") or ()):
+                names.add(name)
+    return names
+
+
+def _validate_artifacts(node: PureReplayNode, artifacts: Any) -> dict[str, Any]:
+    if not isinstance(artifacts, Mapping):
+        raise PureResultReplayIndexError(
+            DEPENDENCY_INDEX_INVALID, "pure result carries no artifacts", context={"node_id": node.node_id}
+        )
+    expected = _active_artifact_names(node.output_contracts, artifacts)
+    actual = set(artifacts)
+    if actual != expected:
+        raise PureResultReplayIndexError(
+            DEPENDENCY_INDEX_INVALID,
+            "pure result members do not match the active variant",
+            context={
+                "node_id": node.node_id,
+                "missing": sorted(expected - actual),
+                "extra": sorted(actual - expected),
+            },
+        )
+    return dict(artifacts)
+
+
+def _evaluation_error(node_id: str, result: Mapping[str, Any]) -> PureResultReplayIndexError:
+    error = result.get("error") if isinstance(result.get("error"), Mapping) else {}
+    context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+    if error.get("type") == "materialize_ref_unresolved":
+        reason, cause = "binding_unresolved", "materialize_ref_unresolved"
+    elif context.get("reason") == "pure_projection_contract_invalid":
+        reason, cause = "output_contract_invalid", "pure_projection_contract_invalid"
+    else:
+        reason, cause = "evaluation_failed", "pure_evaluation_failed"
+    return PureResultReplayIndexError(
+        reason, f"pure node '{node_id}' could not be re-derived", context={"node_id": node_id, "cause": {"type": cause}}
+    )
+
+
+class PureReplayRuntime:
+    """Process-local replay cache over one workflow scope."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index = derive_pure_result_replay_index(bundle)
+        self._plan_nodes = bundle.runtime_plan.nodes
+        self._node_id_by_step_id = {node.step_id: node.node_id for node in self.index.nodes.values()}
+        self._active: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._overlay: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # -- identity -----------------------------------------------------
+    @staticmethod
+    def classify(state: Mapping[str, Any], witness: PureReplayVisitWitness) -> str:
+        return classify_pure_replay_progress(state, witness=witness)
+
+    def _node(self, node_id: str) -> PureReplayNode:
+        node = self.index.nodes.get(node_id)
+        if node is None:
+            raise PureResultReplayIndexError(
+                DEPENDENCY_INDEX_INVALID, f"'{node_id}' is not a replay-eligible pure node", context={"node_id": node_id}
+            )
+        return node
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._node_id_by_step_id.get(step_id)
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        index = self._plan_nodes[node_id].execution_index
+        return PureReplayVisitWitness(node.presentation_key, index if index is not None else 0, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        return self.witness(node_id, visit_count=visit if type(visit) is int else 1)
+
+    # -- cache --------------------------------------------------------
+    def _row_for(self, node_id: str, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Return the validated full row for ``node_id`` or raise."""
+        node = self._node(node_id)
+        witness = self.witness(node_id)
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        if type(visit) is not int or visit != 1:
+            raise _progress_invalid("pure replay requires exactly one visit", node_id=node_id, visit_count=visit)
+        if _cursor_is_related(state.get("current_step"), witness):
+            raise _progress_invalid("a running cursor targets a completed pure node", node_id=node_id)
+        steps = state.get("steps")
+        row = steps.get(node.presentation_key) if isinstance(steps, Mapping) else None
+        active = self._active.get(node_id)
+        if active is not None and active[0] == witness and row is not None and _canonical(row) == _canonical(active[1]):
+            return active[1]
+        overlay = self._overlay.get(node_id)
+        if overlay is not None and row is not None and _canonical(row) == _canonical(overlay[1]):
+            return overlay[1]  # the overlay view of a state whose durable row is the shell
+        if not _is_shell(row, witness):
+            raise _progress_invalid("pure row is neither the durable shell nor the active result", node_id=node_id)
+        if overlay is None:
+            raise PureResultReplayIndexError(
+                DEPENDENCY_INDEX_INVALID, "pure value has not been re-derived", context={"node_id": node_id}
+            )
+        return overlay[1]
+
+    def record_full_result(self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]) -> None:
+        node = self._node(node_id)
+        if witness != self.witness(node_id) or result.get("status") != "completed":
+            raise _progress_invalid("active result does not match the single-visit witness", node_id=node_id)
+        _validate_artifacts(node, result.get("artifacts"))
+        self._active[node_id] = (witness, copy.deepcopy(dict(result)))
+
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Mapping[str, Any]],
+    ) -> dict[str, Any]:
+        node = self._node(node_id)
+        witness = self.witness_from_state(node_id, state)
+        if witness.visit_count != 1:
+            raise _progress_invalid("pure replay requires exactly one visit", node_id=node_id)
+        if classify_pure_replay_progress(state, witness=witness) != "derived_complete":
+            raise _progress_invalid("pure node has no durable completion shell", node_id=node_id)
+        try:
+            result = evaluate_node(node, self.overlay_active_state(state))
+        except PureResultReplayIndexError:
+            raise
+        except Exception as exc:
+            raise PureResultReplayIndexError(
+                "evaluation_failed",
+                f"pure node '{node_id}' could not be re-derived",
+                context={"node_id": node_id, "cause": {"type": "pure_evaluation_failed"}},
+            ) from exc
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise _evaluation_error(node_id, result if isinstance(result, Mapping) else {})
+        artifacts = _validate_artifacts(node, result.get("artifacts"))
+        row = {**build_pure_completion_shell(witness), "artifacts": copy.deepcopy(artifacts)}
+        self._overlay[node_id] = (witness, row)
+        return row
+
+    # -- address resolution ------------------------------------------
+    def resolve_state_address(self, address: Any, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.input_name in inputs:
+                return True, inputs[address.input_name]
+            return False, None
+        if not isinstance(address, NodeResultAddress):
+            return False, None
+        if address.node_id in self.index.nodes:
+            row = self._row_for(address.node_id, state)
+        else:
+            plan_node = self._plan_nodes.get(address.node_id)
+            steps = state.get("steps")
+            row = steps.get(plan_node.presentation_key) if plan_node and isinstance(steps, Mapping) else None
+        if not isinstance(row, Mapping):
+            return False, None
+        container = row if address.field == "exit_code" else row.get(address.field)
+        if address.field == "exit_code":
+            return "exit_code" in row, row.get("exit_code")
+        if isinstance(container, Mapping) and address.member in container:
+            return True, container[address.member]
+        return False, None
+
+    def value_for_state_address(self, address: Any, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise PureResultReplayIndexError(
+                "durable_input_missing", "address has no value in state", context={"address": repr(address)}
+            )
+        return value
+
+    # -- boundary -----------------------------------------------------
+    def _boundary_seed_addresses(self, restart_node_id: Optional[str]) -> list[NodeResultAddress]:
+        nodes = self.bundle.ir.nodes
+        successors = _reachable_successors(self.bundle)
+        region: set[str] = set(nodes)
+        if restart_node_id is not None:
+            region, stack = set(), [restart_node_id]
+            while stack:
+                current = stack.pop()
+                if current in region or current not in nodes:
+                    continue
+                region.add(current)
+                stack.extend(successors[current])
+        found: list[Any] = []
+        for node_id in region:
+            _collect_addresses(nodes[node_id], found, depth=0)
+        for contract in self.bundle.ir.outputs.values():
+            _collect_addresses(contract.source_address, found, depth=0)
+        by_ref_prefix = {f".steps.{n.presentation_key}.": n.node_id for n in self.index.nodes.values()}
+        seeds: list[NodeResultAddress] = []
+        for item in found:
+            if isinstance(item, NodeResultAddress):
+                seeds.append(item)
+                continue
+            for prefix, node_id in by_ref_prefix.items():
+                if prefix in item:
+                    seeds.append(NodeResultAddress(node_id, "artifacts"))
+        return seeds
+
+    def _reached_pure_node_ids(self, state: Mapping[str, Any]) -> set[str]:
+        reached = set()
+        for node_id in self.index.nodes:
+            witness = self.witness_from_state(node_id, state)
+            if classify_pure_replay_progress(state, witness=witness) == "derived_complete":
+                reached.add(node_id)
+        return reached
+
+    def required_node_ids_for_boundary(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        reached = self._reached_pure_node_ids(state)
+        seeds = [s for s in self._boundary_seed_addresses(restart_node_id) if s.node_id in reached]
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=reached)
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> None:
+        """Validate the durable leaves the required pure nodes derive from."""
+        node_ids = list(self.required_node_ids_for_boundary(restart_node_id, state=state))
+        if restart_node_id in self.index.nodes and restart_node_id not in node_ids:
+            node_ids.append(restart_node_id)  # an unstarted eligible restart node derives from the same leaves
+        for node_id in node_ids:
+            node = self._node(node_id)
+            for binding in node.bindings:
+                self._audit_leaf(node, binding, state)
+
+    def _audit_leaf(self, node: PureReplayNode, binding: PureBinding, state: Mapping[str, Any]) -> None:
+        address = binding.address
+        if isinstance(address, NodeResultAddress) and address.node_id in self.index.nodes:
+            return
+        context = {"node_id": node.node_id, "address": repr(address)}
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise PureResultReplayIndexError("durable_input_missing", "durable input is missing", context=context)
+        if isinstance(address, NodeResultAddress) and address.field == "exit_code":
+            valid = type(value) is int
+        elif isinstance(address, NodeResultAddress) and address.field == "outcome":
+            expected = _OUTCOME_FIELDS.get(str(address.member))
+            valid = expected is None or type(value) is expected
+        elif isinstance(address, WorkflowInputAddress) and len(binding.path) == 1:
+            valid = self._input_matches_type(node, binding.path[0], value)
+        else:
+            valid = True
+        if not valid:
+            raise PureResultReplayIndexError("durable_input_invalid", "durable input has the wrong type", context=context)
+
+    def _input_matches_type(self, node: PureReplayNode, binding_name: Any, value: Any) -> bool:
+        spec = self.bundle.ir.nodes[node.node_id].execution_config.pure_projection["payload"]["bindings"][binding_name]
+        try:
+            _coerce_value(value, spec["type"], context="bound input")
+        except PureExprEvaluationError:
+            return False
+        return True
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Return a copy of ``state`` whose completed pure rows carry replayed values."""
+        merged = dict(state)
+        steps = dict(state.get("steps") or {})
+        for node_id, (_, row) in self._overlay.items():
+            steps[self._node(node_id).presentation_key] = self._row_for(node_id, state)
+        merged["steps"] = steps
+        return merged
+
+    # -- persisted surfaces ------------------------------------------
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Mapping[str, Any],
+        state_manager: Any,
+        resolve_bundle_path: Callable[[str], Optional[Path]],
+    ) -> None:
+        """Reject any persisted value-bearing surface of an eligible node."""
+        lineage = state.get("private_artifact_versions") or {}
+        if not isinstance(lineage, Mapping):
+            raise PureResultReplayIndexError(
+                DEPENDENCY_INDEX_INVALID,
+                "private_artifact_versions must be a mapping",
+                context={"surface": "private_artifact_versions"},
+            )
+        for key, entries in lineage.items():
+            if not isinstance(entries, (list, tuple)):
+                raise PureResultReplayIndexError(
+                    DEPENDENCY_INDEX_INVALID,
+                    f"private_artifact_versions['{key}'] must be a list of entries",
+                    context={"surface": "private_artifact_versions"},
+                )
+        for node_id, node in self.index.nodes.items():
+            witness = self.witness(node_id)
+            row = (state.get("steps") or {}).get(node.presentation_key)
+            if (
+                isinstance(row, Mapping)
+                and row.get("status") == "completed"
+                and row.get("visit_count", 1) == 1
+                and not _is_shell(row, witness)
+            ):
+                self._conflict("steps", node_id)  # a visit-two row is an invalid witness instead
+            template = self.bundle.ir.nodes[node_id].execution_config.common.output_bundle
+            path = resolve_bundle_path(template["path"]) if template and template.get("path") else None
+            if path is not None and Path(path).exists():
+                self._conflict("pure_bundle", node_id)
+            for entries in lineage.values():
+                if any(_lineage_entry_belongs(entry, node) for entry in entries):
+                    self._conflict("private_artifact_versions", node_id)
+        from ..workflow_lisp.lexical_checkpoint_pure_audit import audit_checkpoint_surfaces
+
+        audit_checkpoint_surfaces(self, state=state, state_manager=state_manager)
+
+    @staticmethod
+    def _conflict(surface: str, node_id: str) -> None:
+        raise PureResultReplayIndexError(
+            PROFILE_CONFLICT,
+            f"persisted {surface} surface exists for eligible pure node '{node_id}'",
+            context={"surface": surface, "node_id": node_id},
+        )
+
+
+def _lineage_entry_belongs(entry: Any, node: PureReplayNode) -> bool:
+    return isinstance(entry, Mapping) and (
+        entry.get("producer") in {node.presentation_key, node.step_id}
+        or entry.get("producer_step_id") == node.step_id
+        or entry.get("producer_name") == node.presentation_key
+        or entry.get("step_id") == node.step_id
+    )
+
+
+def _collect_addresses(value: Any, out: list[Any], *, depth: int) -> None:
+    """Gather every node-result address reachable from ``value`` (over-approximate)."""
+    if depth > 12 or value is None or isinstance(value, (int, float, bool)):
+        return
+    if isinstance(value, str):
+        if ".steps." in value:
+            out.append(value)  # a textual ref; resolved to a node by the caller
+    elif isinstance(value, NodeResultAddress):
+        out.append(value)
+    elif isinstance(value, Mapping):
+        for item in value.values():
+            _collect_addresses(item, out, depth=depth + 1)
+    elif isinstance(value, (list, tuple)):
+        for item in value:
+            _collect_addresses(item, out, depth=depth + 1)
+    elif hasattr(value, "__dataclass_fields__"):
+        for name in value.__dataclass_fields__:
+            _collect_addresses(getattr(value, name), out, depth=depth + 1)

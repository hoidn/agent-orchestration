+
+def test_initialize_writes_profile_and_plain_load_never_backfills(tmp_path: Path) -> None:
+    manager = _manager(tmp_path, result_persistence_profile=PROFILE)
+    assert json.loads(manager.state_file.read_text())["result_persistence_profile"] == PROFILE
+    (tmp_path / "plain").mkdir()
+    plain = _manager(tmp_path / "plain")
+    assert "result_persistence_profile" not in json.loads(plain.state_file.read_text())
+
+
+def test_read_only_frame_loader_returns_detached_copy() -> None:
+    frame = {"state": {"steps": {"a": 1}}}
+    loaded = load_existing_call_frame_read_only(frame)
+    loaded["steps"]["a"] = 2
+    assert frame["state"]["steps"]["a"] == 1
+
+
+@pytest.mark.parametrize("frame", [{}, {"state": None}, {"state": []}])
+def test_malformed_existing_frame_is_rejected(frame: dict[str, Any]) -> None:
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        load_existing_call_frame_read_only(frame)
+
+
+# -- shell and classification --------------------------------------------------
+
+def test_shell_is_exact() -> None:
+    assert build_pure_completion_shell(WITNESS) == {
+        "name": "pure", "step_id": "root.pure", "visit_count": 1, "status": "completed", "exit_code": 0,
+        "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+        "result_storage": PROFILE,
+    }
+
+
+@pytest.mark.parametrize("key", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_rejects_extra_keys(key: str) -> None:
+    row = {**build_pure_completion_shell(WITNESS), key: 1}
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(row, witness=WITNESS)
+
+
+def test_shell_rejects_wrong_scalar_types() -> None:
+    row = {**build_pure_completion_shell(WITNESS), "exit_code": False}
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(row, witness=WITNESS)
+
+
+def _view(*, visit=1, cursor=None, row=None) -> dict[str, Any]:
+    state: dict[str, Any] = {"steps": {}, "step_visits": {}, "current_step": cursor}
+    if visit is not None:
+        state["step_visits"]["pure"] = visit
+    if row is not None:
+        state["steps"]["pure"] = row
+    return state
+
+
+def _cursor(**overrides: Any) -> dict[str, Any]:
+    return {"name": "pure", "index": 3, "type": "pure_projection", "step_id": "root.pure",
+            "visit_count": 1, "status": "running", **overrides}
+
+
+def test_classification_of_valid_progress() -> None:
+    shell = build_pure_completion_shell(WITNESS)
+    failed = {"name": "pure", "step_id": "root.pure", "visit_count": 1, "status": "failed"}
+    other = {"name": "other", "step_id": "root.other", "index": 0, "status": "running"}
+    assert classify_pure_replay_progress(_view(visit=None), witness=WITNESS) == "unstarted"
+    assert classify_pure_replay_progress(_view(visit=None, cursor=other), witness=WITNESS) == "unstarted"
+    assert classify_pure_replay_progress(_view(cursor=_cursor()), witness=WITNESS) == "interrupted"
+    assert classify_pure_replay_progress(_view(row=shell), witness=WITNESS) == "derived_complete"
+    assert classify_pure_replay_progress(_view(row=shell, cursor=other), witness=WITNESS) == "derived_complete"
+    assert classify_pure_replay_progress(_view(row=failed), witness=WITNESS) == "durable_failure_skip"
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _view(),  # visit without cursor or row
+        _view(visit=None, cursor=_cursor()),  # cursor without a visit
+        _view(visit=None, row=build_pure_completion_shell(WITNESS)),  # shell without a visit
+        _view(cursor=_cursor(), row=build_pure_completion_shell(WITNESS)),  # cursor plus row
+        _view(cursor=_cursor(visit_count=2)),
+        _view(cursor=_cursor(type="command")),
+        _view(cursor=_cursor(index=9)),
+        _view(row={"name": "pure", "step_id": "root.pure", "visit_count": 1, "status": "completed", "value": 1}),
+        _view(row={"name": "pure", "step_id": "root.pure", "visit_count": 2, "status": "failed"}),
+        _view(row={"name": "pure", "step_id": "root.pure", "visit_count": 1, "status": "running"}),
+        _view(cursor=_cursor(), row={"name": "pure", "step_id": "root.pure", "visit_count": 1, "status": "failed"}),
+        _view(visit=2, cursor=_cursor(visit_count=2)),
+    ],
+)
+def test_classification_rejects_invalid_progress(state: dict[str, Any]) -> None:
+    assert classify_pure_replay_progress(state, witness=WITNESS) == "progress_witness_invalid"
+
+
+# -- state transactions ----------------------------------------------------------
+
+def test_visit_lifecycle_is_atomic_and_single_visit(tmp_path: Path) -> None:
+    manager = _manager(tmp_path, result_persistence_profile=PROFILE)
+    assert manager.begin_eligible_pure_visit(step_name="pure", step_index=3, step_id="root.pure") == 1
+    assert manager.reuse_interrupted_eligible_pure_visit(WITNESS) == 1
+    on_disk = json.loads(manager.state_file.read_text())
+    assert on_disk["current_step"]["type"] == "pure_projection"
+    shell = manager.settle_eligible_pure_success(WITNESS)
+    on_disk = json.loads(manager.state_file.read_text())
+    assert on_disk["steps"]["pure"] == shell and "current_step" not in on_disk
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        manager.begin_eligible_pure_visit(step_name="pure", step_index=3, step_id="root.pure")
+    assert excinfo.value.reason == "progress_witness_invalid"
+
+
+def test_failure_settlement_keeps_full_row(tmp_path: Path) -> None:
+    manager = _manager(tmp_path, result_persistence_profile=PROFILE)
+    manager.begin_eligible_pure_visit(step_name="pure", step_index=3, step_id="root.pure")
+    failed = StepResult(status="failed", name="pure", step_id="root.pure", visit_count=1, exit_code=2, error={"type": "x"})
+    assert manager.settle_eligible_pure_failure(WITNESS, failed) is None
+    assert json.loads(manager.state_file.read_text())["steps"]["pure"]["error"] == {"type": "x"}
+
+
+def test_recorder_keeps_full_result_in_memory_and_persists_only_the_shell(tmp_path: Path) -> None:
+    manager = _manager(tmp_path, result_persistence_profile=PROFILE)
+    manager.begin_eligible_pure_visit(step_name="pure", step_index=3, step_id="root.pure")
+    emitted: list[Any] = []
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: "root.pure",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, row: emitted.append(row),
+    )
+    state: dict[str, Any] = {"steps": {}, "step_visits": {"pure": 1}}
+    result = recorder.persist_step_result(
+        state, "pure", {}, {"status": "completed", "exit_code": 0, "artifacts": {"a": 1}},
+        eligible_pure_settlement=WITNESS,
+    )
+    assert result["artifacts"] == {"a": 1} and state["steps"]["pure"]["artifacts"] == {"a": 1}
+    assert json.loads(manager.state_file.read_text())["steps"]["pure"] == build_pure_completion_shell(WITNESS)
+    assert emitted == [build_pure_completion_shell(WITNESS)]
+
+
+# -- index -----------------------------------------------------------------------
+
+def test_index_lists_eligible_pure_node(tmp_path: Path) -> None:
+    index = derive_pure_result_replay_index(_compile_pure_projection_bundle(tmp_path))
+    (node,) = index.nodes.values()
+    assert index.scope_kind == "root" and index.topological_node_ids == (node.node_id,)
+    assert [b.path for b in node.bindings] == [("status",), ("approved",)]
+    assert node.pure_dependency_node_ids == () and node.durable_dependency_node_ids == ()
+
+
+def test_index_scope_mismatch_names_both_scopes(tmp_path: Path) -> None:
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(_compile_pure_projection_bundle(tmp_path), scope_kind="loop")
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+    assert excinfo.value.context["expected_scope"] == "loop" and excinfo.value.context["actual_scope"] == "root"
+    assert excinfo.value.code == "pure_result_replay_unavailable"
+
+
+def _with_binding_refs(bundle: Any, binding_refs: dict[str, Any]) -> Any:
+    node_id, node = next(iter(bundle.ir.nodes.items()))
+    config = replace(node.execution_config, pure_projection={**node.execution_config.pure_projection, "binding_refs": binding_refs})
+    ir = replace(bundle.ir, nodes={node_id: replace(node, execution_config=config)})
+    return replace(bundle, ir=ir)
+
+
+@pytest.mark.parametrize(
+    "binding_refs",
+    [
+        {"approved": "yes", "status": {"ref": "inputs.status"}},  # wrong-typed literal
+        {"approved": {"ref": 5}, "status": {"ref": "inputs.status"}},  # malformed ref object
+        {"approved": {"ref": "parent.steps.x.artifacts.y"}, "status": {"ref": "inputs.status"}},  # cross-frame
+        {"approved": {"ref": "nonsense"}, "status": {"ref": "inputs.status"}},  # unbound text
+        {"approved": {"ref": "inputs.approved"}},  # declared binding without a value
+    ],
+)
+def test_index_rejects_invalid_binding_documents(tmp_path: Path, binding_refs: dict[str, Any]) -> None:
+    bundle = _with_binding_refs(_compile_pure_projection_bundle(tmp_path), binding_refs)
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(bundle)
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID

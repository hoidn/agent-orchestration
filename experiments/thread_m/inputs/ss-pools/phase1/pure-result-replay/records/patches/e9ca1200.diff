+"""Static replay-eligibility index for compiler-generated pure projections.
+
+Type signature: ``derive_pure_result_replay_index(bundle, *, scope_kind) ->
+PureResultReplayIndex``. Dependencies: the bundle's executable IR, runtime plan
+and state projection (read only). Behavior: classifies each ``pure_projection``
+node as replay-eligible (acyclic, visited at most once per scope) or not, and
+records the typed bindings, output addresses and dependency edges of eligible
+nodes. It never mutates or serializes the bundle.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BoundAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    NodeResultAddress,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import workflow_bundle
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .references import ReferenceResolutionError, parse_structured_ref
+from ..state import DERIVED_PURE_REPLAY_PROFILE
+
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+ROOT_SCOPE = "root"
+
+__all__ = [
+    "DERIVED_PURE_REPLAY_PROFILE",
+    "PURE_RESULT_REPLAY_UNAVAILABLE",
+    "DEPENDENCY_INDEX_INVALID",
+    "REACHABILITY_AMBIGUOUS",
+    "MULTIPLE_VISIT_REGION",
+    "PROGRESS_WITNESS_INVALID",
+    "PROFILE_CONFLICT",
+    "PureResultReplayIndexError",
+    "PureBinding",
+    "PureReplayNode",
+    "PureResultReplayIndex",
+    "derive_pure_result_replay_index",
+]
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed replay error carrying a stable reason and context."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(self, reason: str, message: str, *, context: Optional[Mapping[str, Any]] = None) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.message = message
+        self.context = dict(context or {})
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+@dataclass(frozen=True)
+class PureBinding:
+    """One exact ref leaf of a binding value document."""
+
+    path: tuple[str | int, ...]
+    address: BoundAddress
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    """Replay metadata for one eligible pure projection."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    """Eligible pure nodes of one workflow scope plus why others are not."""
+
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str] = field(default_factory=dict)
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[BoundAddress],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Return the pure nodes (topologically ordered) needed to rebuild the seeds."""
+        reached = set(reached_node_ids)
+        needed: set[str] = set()
+        stack = [
+            address.node_id
+            for address in seed_addresses
+            if isinstance(address, NodeResultAddress) and address.node_id in self.nodes
+        ]
+        while stack:
+            node_id = stack.pop()
+            if node_id in needed:
+                continue
+            if node_id not in reached:
+                raise PureResultReplayIndexError(
+                    REACHABILITY_AMBIGUOUS,
+                    f"pure node '{node_id}' is required but not known to be reached",
+                    context={"node_id": node_id},
+                )
+            needed.add(node_id)
+            stack.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and "ref" in doc and len(doc) == 1
+
+
+def _walk_doc(
+    doc: Any,
+    descriptor: Mapping[str, Any],
+    path: tuple[str | int, ...],
+    leaves: list[tuple[tuple[str | int, ...], str]],
+) -> None:
+    """Validate literal leaves against ``descriptor`` and collect exact refs."""
+    if _is_exact_ref(doc):
+        ref = doc["ref"]
+        if not isinstance(ref, str) or not ref:
+            raise _invalid("malformed ref object", path=list(path))
+        leaves.append((path, ref))
+        return
+    if isinstance(doc, Mapping) and "ref" in doc:
+        raise _invalid("malformed ref object", path=list(path))
+    kind = descriptor.get("kind")
+    if kind == "optional":
+        if doc is not None:
+            _walk_doc(doc, descriptor["item"], path, leaves)
+    elif kind == "list":
+        if not isinstance(doc, (list, tuple)):
+            raise _invalid("literal must be a list", path=list(path))
+        for index, item in enumerate(doc):
+            _walk_doc(item, descriptor["item"], (*path, index), leaves)
+    elif kind == "map":
+        if not isinstance(doc, Mapping):
+            raise _invalid("literal must be a map", path=list(path))
+        for key, item in doc.items():
+            _walk_doc(item, descriptor["value"], (*path, key), leaves)
+    elif kind == "record":
+        _walk_fields(doc, descriptor["fields"], path, leaves, extra_allowed=())
+    elif kind in {"union", "variant_case"}:
+        _walk_union(doc, descriptor, path, leaves)
+    else:
+        try:
+            _coerce_value(doc, descriptor, context="binding literal")
+        except PureExprEvaluationError as exc:
+            raise _invalid(f"wrong-typed literal: {exc}", path=list(path)) from exc
+
+
+def _walk_fields(
+    doc: Any,
+    fields: Iterable[Mapping[str, Any]],
+    path: tuple[str | int, ...],
+    leaves: list[tuple[tuple[str | int, ...], str]],
+    *,
+    extra_allowed: Iterable[Mapping[str, Any]],
+) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("literal must be a record", path=list(path))
+    declared = {field_["name"]: field_["type"] for field_ in fields}
+    for name, field_type in declared.items():
+        if name not in doc:
+            raise _invalid(f"literal is missing field '{name}'", path=list(path))
+        _walk_doc(doc[name], field_type, (*path, name), leaves)
+    others = {field_["name"]: field_["type"] for field_ in extra_allowed}
+    for name in doc:
+        if name in declared or name == "variant":
+            continue
+        if name not in others:
+            raise _invalid(f"literal has unexpected field '{name}'", path=list(path))
+        _walk_doc(doc[name], others[name], (*path, name), leaves)
+
+
+def _walk_union(
+    doc: Any,
+    descriptor: Mapping[str, Any],
+    path: tuple[str | int, ...],
+    leaves: list[tuple[tuple[str | int, ...], str]],
+) -> None:
+    """Union literal: the active variant is required, inactive members must still type-check.
+
+    The discriminant may itself be an exact ref; the active variant is then unknown
+    statically, so no field is required but every present member is still checked.
+    """
+    if not isinstance(doc, Mapping) or "variant" not in doc:
+        raise _invalid("union literal must declare a variant", path=list(path))
+    variants = (
+        list(descriptor.get("variants", ()))
+        if descriptor["kind"] == "union"
+        else [{"name": descriptor["variant"], "fields": descriptor["fields"]}]
+    )
+    discriminant = doc["variant"]
+    if _is_exact_ref(discriminant):
+        _walk_doc(discriminant, {"kind": "primitive", "name": "String"}, (*path, "variant"), leaves)
+        active = None
+    elif isinstance(discriminant, str):
+        active = next((v for v in variants if v["name"] == discriminant), None)
+        if active is None:
+            raise _invalid("union literal names an unknown variant", path=list(path))
+    else:
+        raise _invalid("union literal variant must be a string or ref", path=list(path))
+    declared: dict[str, Mapping[str, Any]] = {}
+    for variant in ([active] if active else []) + variants:
+        for field_ in variant.get("fields", ()):
+            declared.setdefault(field_["name"], field_["type"])
+    for field_ in (active or {}).get("fields", ()):
+        if field_["name"] not in doc:
+            raise _invalid(f"literal is missing field '{field_['name']}'", path=list(path))
+    for name, item in doc.items():
+        if name == "variant":
+            continue
+        if name not in declared:
+            raise _invalid(f"literal has unexpected field '{name}'", path=list(path))
+        _walk_doc(item, declared[name], (*path, name), leaves)
+
+
+def _reachable_successors(bundle: Any) -> dict[str, set[str]]:
+    nodes = bundle.ir.nodes
+    successors: dict[str, set[str]] = {node_id: set() for node_id in nodes}
+    for node_id, node in nodes.items():
+        targets = successors[node_id]
+        if node.fallthrough_node_id:
+            targets.add(node.fallthrough_node_id)
+        for transfer in node.routed_transfers.values():
+            if transfer.target_node_id:
+                targets.add(transfer.target_node_id)
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)) and node.body_entry_node_id:
+            targets.add(node.body_entry_node_id)
+    return {k: {t for t in v if t in nodes} for k, v in successors.items()}
+
+
+def _cyclic_node_ids(successors: Mapping[str, set[str]]) -> set[str]:
+    """Return node ids on a cycle (iterative Tarjan SCC)."""
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    on_stack: set[str] = set()
+    stack: list[str] = []
+    cyclic: set[str] = set()
+    counter = 0
+    for root in successors:
+        if root in index:
+            continue
+        work = [(root, iter(sorted(successors[root])))]
+        index[root] = low[root] = counter
+        counter += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            node, children = work[-1]
+            advanced = False
+            for child in children:
+                if child not in index:
+                    index[child] = low[child] = counter
+                    counter += 1
+                    stack.append(child)
+                    on_stack.add(child)
+                    work.append((child, iter(sorted(successors[child]))))
+                    advanced = True
+                    break
+                if child in on_stack:
+                    low[node] = min(low[node], index[child])
+            if advanced:
+                continue
+            work.pop()
+            if work:
+                parent = work[-1][0]
+                low[parent] = min(low[parent], low[node])
+            if low[node] == index[node]:
+                component = []
+                while True:
+                    member = stack.pop()
+                    on_stack.discard(member)
+                    component.append(member)
+                    if member == node:
+                        break
+                if len(component) > 1 or node in successors[node]:
+                    cyclic.update(component)
+    return cyclic
+
+
+def _multi_visit_node_ids(bundle: Any) -> set[str]:
+    """Nodes that can be visited more than once per scope: loop-owned or on a cycle."""
+    multi = _cyclic_node_ids(_reachable_successors(bundle))
+    for node in bundle.ir.nodes.values():
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)):
+            multi.update(node.body_node_ids)
+            multi.add(node.node_id)
+    return multi
+
+
+def _propagate_pure_ineligibility(
+    dependencies: Mapping[str, Iterable[str]],
+    reasons: dict[str, str],
+) -> None:
+    """Make every pure node that consumes a multiply visited pure node ineligible too."""
+    changed = True
+    while changed:
+        changed = False
+        for node_id, deps in dependencies.items():
+            if node_id in reasons:
+                continue
+            if any(reasons.get(dep) == MULTIPLE_VISIT_REGION for dep in deps):
+                reasons[node_id] = MULTIPLE_VISIT_REGION
+                changed = True
+
+
+def _address_for_ref(ref: str, by_presentation: Mapping[str, str]) -> BoundAddress:
+    if ref.startswith("inputs."):
+        name = ref[len("inputs."):]
+        if not name:
+            raise _invalid("unbound input ref", ref=ref)
+        return WorkflowInputAddress(name)
+    if ref.startswith("parent.steps."):
+        raise _invalid("cross-frame ref", ref=ref)
+    try:
+        target = parse_structured_ref(ref, by_presentation)
+    except ReferenceResolutionError as exc:
+        raise _invalid(f"unbound ref text: {exc}", ref=ref) from exc
+    node_id = by_presentation.get(target.step_name)
+    if node_id is None:
+        # Nested projections may be named by a dotted suffix of the step key.
+        suffixed = {
+            by_presentation[key] for key in by_presentation if key.endswith(f".{target.step_name}")
+        }
+        if len(suffixed) != 1:
+            raise _invalid("ref names an unknown or ambiguous step", ref=ref)
+        (node_id,) = suffixed
+    return NodeResultAddress(node_id, target.field, target.member)
+
+
+def _binding_leaves(config: Mapping[str, Any], node_id: str) -> list[tuple[tuple[str | int, ...], str]]:
+    payload = config.get("payload")
+    refs = config.get("binding_refs")
+    if not isinstance(payload, Mapping) or not isinstance(refs, Mapping):
+        raise _invalid("pure projection config is malformed", node_id=node_id)
+    declared = payload.get("bindings", {})
+    unbound = [name for name in refs if name not in declared]
+    if unbound:
+        raise _invalid("binding refs name undeclared bindings", node_id=node_id, bindings=sorted(map(str, unbound)))
+    leaves: list[tuple[tuple[str | int, ...], str]] = []
+    for name, spec in declared.items():
+        if name not in refs:
+            if "value" in spec:
+                continue
+            raise _invalid("declared binding has no value document", node_id=node_id, binding=name)
+        _walk_doc(refs[name], spec["type"], (name,), leaves)
+    return leaves
+
+
+def _topological(nodes: Mapping[str, PureReplayNode], order: Mapping[str, int]) -> tuple[str, ...]:
+    state: dict[str, int] = {}
+    result: list[str] = []
+
+    def visit(node_id: str) -> None:
+        if state.get(node_id) == 2:
+            return
+        if state.get(node_id) == 1:
+            raise _invalid("pure dependency cycle", node_id=node_id)
+        state[node_id] = 1
+        for dep in sorted(nodes[node_id].pure_dependency_node_ids, key=order.__getitem__):
+            visit(dep)
+        state[node_id] = 2
+        result.append(node_id)
+
+    for node_id in sorted(nodes, key=order.__getitem__):
+        visit(node_id)
+    return tuple(result)
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = ROOT_SCOPE) -> PureResultReplayIndex:
+    """Derive the replay index for one bundle's own nodes."""
+    loaded = workflow_bundle(bundle)
+    if loaded is None:
+        raise TypeError("LoadedWorkflowBundle required")
+    if scope_kind != ROOT_SCOPE:
+        raise _invalid("scope kind does not match the bundle scope", expected_scope=scope_kind, actual_scope=ROOT_SCOPE)
+    plan_nodes = loaded.runtime_plan.nodes
+    by_presentation: dict[str, str] = {}
+    for node_id, plan_node in plan_nodes.items():
+        if by_presentation.setdefault(plan_node.presentation_key, node_id) != node_id:
+            raise _invalid("duplicate projection authority", presentation_key=plan_node.presentation_key)
+    for node_id, entry in loaded.projection.entries_by_node_id.items():
+        plan_node = plan_nodes.get(node_id)
+        if plan_node is not None and (
+            entry.step_id != plan_node.step_id or entry.presentation_key != plan_node.presentation_key
+        ):
+            raise _invalid("projection identity mismatch", node_id=node_id)
+    step_ids = [plan_node.step_id for plan_node in plan_nodes.values()]
+    if len(set(step_ids)) != len(step_ids):

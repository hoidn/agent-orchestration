+            output_addresses=tuple(NodeResultAddress(node_id, "artifacts", name) for name in contracts),
+            output_contracts=contracts,
+            pure_dependency_node_ids=tuple(sorted((d for d in dep_ids if d in eligible), key=order.__getitem__)),
+            durable_dependency_node_ids=tuple(sorted((d for d in dep_ids if d not in eligible), key=order.__getitem__)),
+        )
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=nodes,
+        topological_node_ids=_topological(nodes, order),
+        ineligible_pure_reasons=reasons,

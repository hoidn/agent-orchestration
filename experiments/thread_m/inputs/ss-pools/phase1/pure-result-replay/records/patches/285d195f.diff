+def _progress_state(*, visit=None, cursor=None, row=None) -> dict:
+    return {
+        "step_visits": {} if visit is None else {"step": visit},
+        "current_step": cursor,
+        "steps": {} if row is None else {"step": row},
+    }
+
+
+def _cursor(**overrides) -> dict:
+    return {
+        "name": "step",
+        "index": 3,
+        "type": "pure_projection",
+        "step_id": "root.step",
+        "visit_count": 1,
+        "status": "running",
+        **overrides,
+    }
+
+
+@pytest.mark.parametrize(
+    ("state", "expected"),
+    [
+        (_progress_state(), "unstarted"),
+        (_progress_state(cursor={"name": "other", "step_id": "root.other"}), "unstarted"),
+        (_progress_state(visit=1, cursor=_cursor()), "interrupted"),
+        (_progress_state(visit=1, row=build_pure_completion_shell(WITNESS)), "derived_complete"),
+        (
+            _progress_state(visit=1, row={"name": "step", "step_id": "root.step", "visit_count": 1, "status": "failed"}),
+            "durable_failure_skip",
+        ),
+        (_progress_state(visit=1), "progress_witness_invalid"),
+        (_progress_state(cursor=_cursor()), "progress_witness_invalid"),
+        (_progress_state(visit=2, cursor=_cursor(visit_count=2)), "progress_witness_invalid"),
+        (_progress_state(visit=1, cursor=_cursor(index=9)), "progress_witness_invalid"),
+        (
+            _progress_state(visit=1, cursor=_cursor(), row=build_pure_completion_shell(WITNESS)),
+            "progress_witness_invalid",
+        ),
+        (
+            _progress_state(visit=1, row={**build_pure_completion_shell(WITNESS), "artifacts": {}}),
+            "progress_witness_invalid",
+        ),
+    ],
+)
+def test_progress_classification(state: dict, expected: str) -> None:
+    assert classify_pure_replay_progress(state, witness=WITNESS) == expected

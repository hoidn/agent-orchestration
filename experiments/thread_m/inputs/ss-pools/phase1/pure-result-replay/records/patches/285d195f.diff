+"""Behavioral tests for the ``derived_pure_replay.v1`` persistence profile."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from orchestrator.state import RunState, StateManager
+from orchestrator.workflow.call_frame_state import load_existing_call_frame_read_only
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    MULTIPLE_VISIT_REGION,
+    PureReplayRuntime,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    derive_pure_result_replay_index,
+    validate_pure_completion_shell,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from tests import test_workflow_lisp_lexical_checkpoint_restore as restore_helpers
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+VALID = REPO_ROOT / "tests" / "fixtures" / "workflow_lisp" / "valid"
+WITNESS = PureReplayVisitWitness("step", 3, "root.step", 1)
+
+
+def _compile(tmp_path: Path, fixture: str, workflow: str):
+    result = compile_stage3_entrypoint(
+        VALID / fixture,
+        source_roots=(VALID,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return result.validated_bundles_by_name[workflow]
+
+
+def _run_state(**overrides) -> RunState:
+    return RunState(
+        schema_version="2.1",
+        run_id="r",
+        workflow_file="w.orc",
+        workflow_checksum="sha256:0",
+        started_at="t",
+        updated_at="t",
+        status="running",
+        **overrides,
+    )
+
+
+# ------------------------------------------------------------------ selector
+
+
+def test_absent_profile_is_omitted_and_round_trips() -> None:
+    payload = _run_state().to_dict()
+
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None
+
+
+def test_present_profile_round_trips() -> None:
+    payload = _run_state(result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE).to_dict()
+
+    assert RunState.from_dict(payload).result_persistence_profile == DERIVED_PURE_REPLAY_PROFILE
+
+
+def test_unsupported_profile_fails_closed_at_construction() -> None:
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        _run_state(result_persistence_profile="derived_pure_replay.v2")
+
+
+def test_initialize_rejects_unsupported_profile(tmp_path: Path) -> None:
+    (tmp_path / "w.orc").write_text("x", encoding="utf-8")
+
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        StateManager(workspace=tmp_path, run_id="r").initialize("w.orc", result_persistence_profile="bogus")

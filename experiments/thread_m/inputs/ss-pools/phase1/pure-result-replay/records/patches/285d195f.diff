new file mode 100644
index 0000000..ac88135
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_runtime.py
@@ -0,0 +1,352 @@
+"""In-memory replay of eligible pure results for ``derived_pure_replay.v1``.
+
+``PureReplayRuntime`` validates durable inputs, re-derives eligible pure values
+through a caller-supplied evaluator and exposes them as a transient overlay over
+the loaded state. It never dispatches effects, increments visits, settles
+results or writes durable state.
+
+Dependencies: the replay index (derived from the bundle only), the persisted
+state mapping handed to each call, and optional runtime-sidecar JSON reads via
+``state_manager`` for checkpoint-surface audits.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from pathlib import Path
+from typing import Any, Callable, Mapping, Optional
+
+from ..contracts.output_contract import OutputContractError
+from .executable_ir import WorkflowInputAddress
+from .pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayNode,
+    PureReplayVisitWitness,
+    PureResultReplayIndex,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    derive_pure_result_replay_index,
+)
+from .references import ReferenceResolutionError
+from .resume_projection_integrity import ResumeScopePath
+
+_SHELL_KEYS = frozenset(build_pure_completion_shell(PureReplayVisitWitness("k", 0, "s", 1)))
+_SCALAR_CHECKS: dict[str, Callable[[Any], bool]] = {
+    "string": lambda v: isinstance(v, str),
+    "integer": lambda v: type(v) is int,
+    "bool": lambda v: type(v) is bool,
+    "float": lambda v: type(v) in (int, float),
+}
+_OUTCOME_CHECKS: dict[str, Callable[[Any], bool]] = {
+    "status": lambda v: isinstance(v, str),
+    "phase": lambda v: isinstance(v, str),
+    "class": lambda v: isinstance(v, str),
+    "retryable": lambda v: type(v) is bool,
+}
+
+
+def _view(state: Any) -> Mapping[str, Any]:
+    return state.to_dict() if hasattr(state, "to_dict") else state
+
+
+def _unavailable(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+class PureReplayRuntime:
+    """Replay runtime for one bundle in one resume scope."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        # Refs are scoped to the bundle holding them, so a callee frame is also "root".
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(bundle, scope_kind="root")
+        self._step_ids = {node.step_id: node_id for node_id, node in self.index.nodes.items()}
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # ------------------------------------------------------------ identities
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._step_ids.get(step_id)
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self.index.nodes[node_id]
+        step_index = self.bundle.projection.execution_index_for_step_id(node.step_id)
+        return PureReplayVisitWitness(node.presentation_key, step_index, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Any) -> PureReplayVisitWitness:
+        key = self.index.nodes[node_id].presentation_key
+        visit = (_view(state).get("step_visits") or {}).get(key)
+        return self.witness(node_id, visit_count=visit if type(visit) is int else 1)
+
+    # --------------------------------------------------------- active results
+
+    def record_full_result(self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]) -> None:
+        """Hold an active executor's validated full result for later overlay hits."""
+        if witness != self.witness(node_id):
+            raise _unavailable(PROGRESS_WITNESS_INVALID, "active result witness mismatch", node_id=node_id)
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise _unavailable(PROGRESS_WITNESS_INVALID, "only completed results are cached", node_id=node_id)
+        self._check_row_members(self.index.nodes[node_id], result.get("artifacts"))
+        self._cache[node_id] = (witness, deepcopy(dict(result)))
+
+    def _check_row_members(self, node: PureReplayNode, artifacts: Any) -> None:
+        """A row holds the discriminant, shared outputs and only the active variant's."""
+        if not isinstance(artifacts, Mapping):
+            raise _unavailable(DEPENDENCY_INDEX_INVALID, "pure row has no artifacts", node_id=node.node_id)
+        variant = artifacts.get("return__variant")
+        for name, contract in node.output_contracts.items():
+            projection = contract.get("projection")
+            inactive = (
+                isinstance(projection, Mapping)
+                and projection.get("projection_class") == "union_workflow_boundary"
+                and projection.get("field_role") == "variant"
+                and isinstance(variant, str)
+                and variant not in (projection.get("active_variants") or ())
+            )
+            if inactive and name in artifacts:
+                raise _unavailable(DEPENDENCY_INDEX_INVALID, "inactive union member present", member=name)
+            if not inactive and name not in artifacts:
+                raise _unavailable(DEPENDENCY_INDEX_INVALID, "active output member missing", member=name)
+        extra = set(artifacts) - set(node.output_contracts)
+        if extra:
+            raise _unavailable(DEPENDENCY_INDEX_INVALID, "undeclared output member", members=sorted(extra))
+
+    def overlay_active_state(self, state: Any) -> dict[str, Any]:
+        """Copy of ``state`` with each cached node's full row, revalidated per hit."""
+        view = _view(state)
+        overlay = dict(view)
+        steps = dict(view.get("steps") or {})
+        for node_id, (witness, full) in self._cache.items():
+            row = steps.get(witness.presentation_key)
+            observed = classify_pure_replay_progress(view, witness=witness)
+            durable = observed == "derived_complete"
+            active = row == full and self._active_form_valid(view, witness)
+            if not (durable or active):
+                raise _unavailable(PROGRESS_WITNESS_INVALID, "cached pure row is no longer valid", node_id=node_id)
+            steps[witness.presentation_key] = deepcopy(full)
+        overlay["steps"] = steps
+        return overlay
+
+    @staticmethod
+    def _active_form_valid(view: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+        visit = (view.get("step_visits") or {}).get(witness.presentation_key)
+        cursor = view.get("current_step")
+        related = isinstance(cursor, Mapping) and (
+            cursor.get("name") == witness.presentation_key or cursor.get("step_id") == witness.step_id
+        )
+        return type(visit) is int and visit == witness.visit_count == 1 and not related
+
+    # ------------------------------------------------------- address lookups
+
+    def resolve_state_address(self, address: Any, state: Any) -> tuple[bool, Any]:
+        view = self.overlay_active_state(state)
+        if isinstance(address, WorkflowInputAddress):
+            inputs = view.get("bound_inputs") or {}
+            return address.input_name in inputs, inputs.get(address.input_name)
+        node_id = getattr(address, "node_id", None)
+        key = self.bundle.projection.presentation_key_by_node_id.get(node_id)
+        row = (view.get("steps") or {}).get(key)
+        if not isinstance(row, Mapping):
+            return False, None
+        field = getattr(address, "field", "artifacts")
+        member = getattr(address, "member", None) or getattr(address, "output_name", None)
+        container = row.get(field)
+        if member is None:
+            return field in row, container
+        if not isinstance(container, Mapping) or member not in container:
+            return False, None
+        return True, container[member]
+
+    def value_for_state_address(self, address: Any, state: Any) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _unavailable(PROGRESS_WITNESS_INVALID, "address has no value in the overlay", address=repr(address))
+        return value
+
+    # ----------------------------------------------------------------- replay
+
+    def required_node_ids_for_boundary(self, restart_node_id: Optional[str], *, state: Any) -> tuple[str, ...]:
+        """Eligible nodes whose shell proves completion before the restart boundary.
+
+        Seeds are every completed node's outputs: later steps and the workflow
+        exports may read any of them, and reading all of a step's refs is not
+        generally decidable, so completed nodes are rebuilt conservatively.
+        """
+        view = _view(state)
+        reached = []
+        for node_id in self.index.topological_node_ids:
+            observed = classify_pure_replay_progress(view, witness=self.witness_from_state(node_id, view))
+            if observed == PROGRESS_WITNESS_INVALID:
+                raise _unavailable(PROGRESS_WITNESS_INVALID, "pure progress evidence is invalid", node_id=node_id)
+            if observed == "derived_complete" and node_id != restart_node_id:
+                reached.append(node_id)
+        seeds = [a for node_id in reached for a in self.index.nodes[node_id].output_addresses]
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=reached)
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Any) -> None:
+        """Validate the durable leaves every required node reads."""
+        view = _view(state)
+        for node_id in self.required_node_ids_for_boundary(restart_node_id, state=view):
+            for binding in self.index.nodes[node_id].bindings:
+                if getattr(binding.address, "node_id", None) in self.index.nodes:
+                    continue
+                self._audit_leaf(binding.address, view, node_id)
+
+    def _audit_leaf(self, address: Any, view: Mapping[str, Any], node_id: str) -> None:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = view.get("bound_inputs") or {}
+            if address.input_name not in inputs:
+                raise _unavailable("durable_input_missing", "bound input is missing", node_id=node_id, input=address.input_name)
+            definition = self.bundle.ir.inputs[address.input_name].definition
+            check = _SCALAR_CHECKS.get(definition.get("type") if definition.get("kind", "scalar") == "scalar" else None)
+            if check is not None and not check(inputs[address.input_name]):
+                raise _unavailable("durable_input_invalid", "bound input has the wrong type", node_id=node_id, input=address.input_name)
+            return
+        found, value = self._resolve_durable(address, view)
+        if not found:
+            raise _unavailable("durable_input_missing", "durable result leaf is missing", node_id=node_id, address=repr(address))
+        member = getattr(address, "member", None)
+        field = getattr(address, "field", None)
+        wrong = (field == "exit_code" and type(value) is not int) or (
+            field == "outcome" and member in _OUTCOME_CHECKS and not _OUTCOME_CHECKS[member](value)
+        )
+        if wrong:
+            raise _unavailable("durable_input_invalid", "durable intrinsic has the wrong type", node_id=node_id, address=repr(address))
+
+    def _resolve_durable(self, address: Any, view: Mapping[str, Any]) -> tuple[bool, Any]:
+        key = self.bundle.projection.presentation_key_by_node_id.get(getattr(address, "node_id", None))
+        row = (view.get("steps") or {}).get(key)
+        if not isinstance(row, Mapping):
+            return False, None
+        field = getattr(address, "field", "artifacts")
+        member = getattr(address, "member", None) or getattr(address, "output_name", None)
+        container = row.get(field)
+        if field == "exit_code":
+            return "exit_code" in row, container
+        if not isinstance(container, Mapping) or member not in container:
+            return False, None
+        return True, container[member]
+
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Any,
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Any],
+    ) -> dict[str, Any]:
+        """Re-derive one node over the overlay; evaluation must be pure (no effects)."""
+        node = self.index.nodes[node_id]
+        view = _view(state)
+        witness = self.witness_from_state(node_id, view)
+        if classify_pure_replay_progress(view, witness=witness) != "derived_complete":
+            raise _unavailable(PROGRESS_WITNESS_INVALID, "node has no completion shell to replay", node_id=node_id)
+        overlay = self.overlay_active_state(view)
+        try:
+            outcome = evaluate_node(node, overlay)
+        except ReferenceResolutionError as exc:
+            raise self._failure("binding_unresolved", "materialize_ref_unresolved", node_id, str(exc)) from exc
+        except OutputContractError as exc:
+            raise self._failure("output_contract_invalid", "pure_projection_contract_invalid", node_id, str(exc)) from exc
+        except Exception as exc:
+            raise self._failure("evaluation_failed", "pure_evaluation_failed", node_id, str(exc)) from exc
+        artifacts = self._artifacts_from(outcome, node_id)
+        self._check_row_members(node, artifacts)
+        full = {
+            **build_pure_completion_shell(witness),
+            "duration_ms": 0,
+            "artifacts": deepcopy(dict(artifacts)),
+            "debug": {"pure_projection": {"replayed": True}},
+        }
+        full.pop("result_storage")
+        self._cache[node_id] = (witness, full)
+        return deepcopy(full)
+
+    def _artifacts_from(self, outcome: Any, node_id: str) -> Mapping[str, Any]:
+        if isinstance(outcome, Mapping) and "status" in outcome:
+            if outcome["status"] != "completed":
+                error = outcome.get("error") or {}
+                reason = (error.get("context") or {}).get("reason") if isinstance(error, Mapping) else None
+                if error.get("type") == "materialize_ref_unresolved":
+                    raise self._failure("binding_unresolved", "materialize_ref_unresolved", node_id, error.get("message"))
+                if reason == "pure_projection_contract_invalid":
+                    raise self._failure("output_contract_invalid", "pure_projection_contract_invalid", node_id, error.get("message"))
+                raise self._failure("evaluation_failed", "pure_evaluation_failed", node_id, error.get("message"))
+            return outcome.get("artifacts") or {}
+        if isinstance(outcome, Mapping):
+            return outcome
+        raise _unavailable("evaluation_failed", "evaluator returned no artifacts", node_id=node_id)
+
+    @staticmethod
+    def _failure(reason: str, cause_type: str, node_id: str, detail: Any) -> PureResultReplayIndexError:
+        return _unavailable(reason, f"pure replay failed: {reason}", node_id=node_id, cause={"type": cause_type}, detail=detail)
+
+    # --------------------------------------------------- persisted surfaces
+
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Any,
+        state_manager: Any,
+        resolve_bundle_path: Callable[[PureReplayNode], Optional[Path]],
+    ) -> None:
+        """Fail closed on any durable value surface for an eligible node."""
+        view = _view(state)
+        for node_id, node in self.index.nodes.items():
+            witness = self.witness_from_state(node_id, view)
+            row = (view.get("steps") or {}).get(node.presentation_key)
+            if isinstance(row, Mapping) and row.get("status") == "completed" and set(row) - _SHELL_KEYS:
+                raise self._conflict("steps", node_id)
+            bundle_path = resolve_bundle_path(node)
+            if bundle_path is not None and Path(bundle_path).exists():
+                raise self._conflict("pure_bundle", node_id)
+            for versions in (view.get("private_artifact_versions") or {}).values():
+                if any(isinstance(e, Mapping) and node.step_id in (e.get("producer"), e.get("producer_name")) or
+                       isinstance(e, Mapping) and node.presentation_key in (e.get("producer"), e.get("producer_name"))
+                       for e in versions):
+                    raise self._conflict("private_artifact_versions", node_id)
+            if classify_pure_replay_progress(view, witness=witness) == PROGRESS_WITNESS_INVALID:
+                raise _unavailable(PROGRESS_WITNESS_INVALID, "pure progress evidence is invalid", node_id=node_id)
+        self._audit_checkpoint_surfaces(state_manager)
+
+    @staticmethod
+    def _conflict(surface: str, node_id: str) -> PureResultReplayIndexError:
+        return _unavailable(PROFILE_CONFLICT, f"eligible pure node has a durable {surface} surface", surface=surface, node_id=node_id)
+
+    def _audit_checkpoint_surfaces(self, state_manager: Any) -> None:
+        from orchestrator.workflow_lisp.lexical_checkpoints import (
+            resolve_checkpoint_index_path,
+            resolve_checkpoint_record_path,
+            _point_payload,
+        )
+
+        frame = self.scope_path.call_frame_ids[-1] if self.scope_path.call_frame_ids else None
+        eligible_steps = {node.step_id: node_id for node_id, node in self.index.nodes.items()}
+        plan = self.bundle.runtime_plan
+        read = state_manager.read_runtime_sidecar_json
+        for point in plan.lexical_checkpoint_points:
+            index_path = resolve_checkpoint_index_path(
+                state_manager=state_manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+            )
+            payload = read(index_path)
+            for entry in (payload or {}).get("records", ()):
+                identity = entry.get("frame_identity") or {}
+                if identity.get("call_frame_id") != frame:
+                    continue
+                if point.step_id in eligible_steps:
+                    raise self._conflict("checkpoint_record", eligible_steps[point.step_id])
+                record = read(
+                    resolve_checkpoint_record_path(
+                        state_manager=state_manager,
+                        workflow_name=point.workflow_name,
+                        checkpoint_id=point.checkpoint_id,
+                        record_id=entry["record_id"],
+                        storage_scope=(_point_payload(point).get("storage") or {}).get("resume_scope"),
+                    )
+                )
+                for binding in ((record or {}).get("restore_payload") or {}).get("bindings", ()):
+                    if binding.get("source_step_id") in eligible_steps:
+                        raise self._conflict("restore_payload", eligible_steps[binding["source_step_id"]])

+def test_replay_rebuilds_values_without_writing(tmp_path: Path) -> None:
+    bundle = _compile(tmp_path, "pure_expr_selector_action_projection.orc", "pure_expr_selector_action_projection::orchestrate")
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("w"))
+    (node,) = runtime.index.nodes.values()
+    witness = runtime.witness(node.node_id)
+    state = {
+        "bound_inputs": {"approved": False, "status": "WAIT"},
+        "step_visits": {witness.presentation_key: 1},
+        "steps": {witness.presentation_key: build_pure_completion_shell(witness)},
+    }
+    before = json.dumps(state, sort_keys=True)
+
+    row = runtime.replay_node(
+        node.node_id,
+        state=state,
+        evaluate_node=lambda n, overlay: {"return__status": "WAIT", "return__ready": False},
+    )
+
+    assert row["artifacts"] == {"return__status": "WAIT", "return__ready": False}
+    assert json.dumps(state, sort_keys=True) == before
+    assert runtime.overlay_active_state(state)["steps"][witness.presentation_key]["artifacts"] == row["artifacts"]
+

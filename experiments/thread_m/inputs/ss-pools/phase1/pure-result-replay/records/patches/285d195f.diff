+def _profiled_failed_run(tmp_path: Path, profile: str | None):
+    bundle = restore_helpers._compile_fixture(tmp_path)
+    manager = StateManager(workspace=tmp_path, run_id="profiled")
+    manager.initialize(
+        str(tmp_path / restore_helpers.FIXTURE.name),
+        context=restore_helpers.bundle_context_dict(bundle),
+        bound_inputs=restore_helpers._execution_inputs(tmp_path),
+        result_persistence_profile=profile,
+    )
+    real = WorkflowExecutor._execute_materialize_view.__globals__["render_view"]
+    armed = {"on": True}
+
+    def fail_once(*args, **kwargs):
+        if armed["on"]:
+            armed["on"] = False
+            raise RuntimeError("synthetic interruption")
+        return real(*args, **kwargs)
+
+    with patch("orchestrator.workflow.executor.render_view", side_effect=fail_once):
+        first = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    return bundle, manager, first
+
+
+def test_profiled_run_persists_value_free_shell_and_resume_reproduces_outputs(tmp_path: Path) -> None:
+    bundle, manager, first = _profiled_failed_run(tmp_path, DERIVED_PURE_REPLAY_PROFILE)
+    persisted = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    pure_rows = [row for row in persisted["steps"].values() if row.get("result_storage")]
+
+    resumed = WorkflowExecutor(bundle, tmp_path, StateManager(workspace=tmp_path, run_id="profiled")).execute(resume=True)
+
+    assert first["status"] == "failed"
+    assert [row == build_pure_completion_shell(_witness_of(row)) for row in pure_rows] == [True]
+    assert persisted["private_artifact_versions"] == {}
+    assert resumed["status"] == "completed"
+    assert resumed["workflow_outputs"]["return__selected_label"] == "ready"
+
+
+def _resume_outputs(workspace: Path, profile: str | None) -> dict:
+    workspace.mkdir()
+    bundle, _, _ = _profiled_failed_run(workspace, profile)
+    manager = StateManager(workspace=workspace, run_id="profiled")
+    return WorkflowExecutor(bundle, workspace, manager).execute(resume=True)["workflow_outputs"]
+
+
+def test_profiled_resume_matches_historical_outputs(tmp_path: Path) -> None:
+    assert _resume_outputs(tmp_path / "profiled", DERIVED_PURE_REPLAY_PROFILE) == _resume_outputs(
+        tmp_path / "historical", None
+    )

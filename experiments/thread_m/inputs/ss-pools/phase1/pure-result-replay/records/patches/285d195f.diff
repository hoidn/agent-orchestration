+"""Atomic visit/settlement transitions for eligible pure steps.
+
+Pure functions over a ``RunState``; the root ``StateManager`` applies them inside
+one state transaction and ``_CallFrameStateManager`` applies them then persists.
+Every transition validates progress with ``classify_pure_replay_progress`` first,
+so no partial or conflicting visit evidence can be extended.
+"""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from datetime import datetime, timezone
+from typing import Any, Mapping
+
+from ..state import RunState, StepResult
+from .pure_result_replay import (
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+)
+
+
+def _require(state: RunState, witness: PureReplayVisitWitness, expected: str) -> None:
+    observed = classify_pure_replay_progress(state, witness=witness)
+    if observed != expected:
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            f"pure visit progress is {observed!r}, expected {expected!r}",
+            context={"presentation_key": witness.presentation_key, "observed": observed},
+        )
+
+
+def begin_visit(state: RunState, *, step_name: str, step_index: int, step_id: str) -> int:
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    _require(state, witness, "unstarted")
+    now = datetime.now(timezone.utc).isoformat()
+    state.step_visits[step_name] = 1
+    state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": "pure_projection",
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def reuse_visit(state: RunState, witness: PureReplayVisitWitness) -> int:
+    _require(state, witness, "interrupted")
+    return witness.visit_count
+
+
+def settle_success(state: RunState, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    _require(state, witness, "interrupted")
+    shell = build_pure_completion_shell(witness)
+    state.steps[witness.presentation_key] = shell
+    state.current_step = None
+    return dict(shell)
+
+
+def settle_failure(state: RunState, witness: PureReplayVisitWitness, result: StepResult | Mapping[str, Any]) -> None:
+    _require(state, witness, "interrupted")
+    row = result if isinstance(result, StepResult) else StepResult(**dict(result))
+    if row.status not in {"failed", "skipped"}:
+        raise ValueError("only failed or skipped pure results persist as full rows")
+    identity = {"name": witness.presentation_key, "step_id": witness.step_id, "visit_count": witness.visit_count}
+    for attr, expected in identity.items():
+        if getattr(row, attr) not in (None, expected):
+            raise ValueError(f"pure result {attr} does not match the visit witness")
+    state.steps[witness.presentation_key] = replace(row, **identity)
+    state.current_step = None

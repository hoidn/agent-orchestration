+"""Derived pure-result replay: eligibility index, completion shell, progress witnesses.
+
+Under the ``derived_pure_replay.v1`` result-persistence profile an eligible
+compiler-generated ``pure_projection`` persists only a value-free completion
+shell; its values are re-derived in memory from durable inputs on resume.
+
+Dependencies: ``LoadedWorkflowBundle`` (read only), ``pure_expr`` type coercion,
+``references.parse_surface_ref``. Nothing here touches disk or mutates a bundle.
+``PureReplayRuntime`` lives in ``pure_replay_runtime`` and is re-exported lazily.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import Any, Iterable, Mapping, Optional
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE, StepResult
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallBoundaryNode,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    IfJoinNode,
+    LoopOutputAddress,
+    MatchJoinNode,
+    NodeResultAddress,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+)
+from .pure_expr import PureExprEvaluationError, _coerce_value, _descriptor_kind
+from .references import (
+    ReferenceResolutionError,
+    StructuredStepReference,
+    SurfaceRefScopeCatalog,
+    WorkflowInputReference,
+    parse_surface_ref,
+)
+
+__all__ = [
+    "DERIVED_PURE_REPLAY_PROFILE",
+    "DEPENDENCY_INDEX_INVALID",
+    "MULTIPLE_VISIT_REGION",
+    "REACHABILITY_AMBIGUOUS",
+    "PROGRESS_WITNESS_INVALID",
+    "PROFILE_CONFLICT",
+    "PURE_REPLAY_UNAVAILABLE",
+    "PureResultReplayIndexError",
+    "PureReplayBinding",
+    "PureReplayNode",
+    "PureResultReplayIndex",
+    "PureReplayVisitWitness",
+    "PureReplayRuntime",
+    "build_pure_completion_shell",
+    "validate_pure_completion_shell",
+    "classify_pure_replay_progress",
+    "derive_pure_result_replay_index",
+]
+
+PURE_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+
+_UNBOUND_TEXT = re.compile(r"\$\{[A-Za-z_][\w.\-:]*\}")
+
+
+class PureResultReplayIndexError(ValueError):
+    """Stable fail-closed error; ``reason`` names the exact unavailability."""
+
+    code = PURE_REPLAY_UNAVAILABLE
+
+    def __init__(self, reason: str, message: str, *, context: Optional[Mapping[str, Any]] = None):
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    """One exact-ref leaf of a binding document and its typed durable address."""
+
+    path: tuple[Any, ...]
+    address: BoundAddress
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Mapping[str, Any]]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str] = field(default_factory=dict)
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[BoundAddress],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Pure nodes (topological order) needed to rebuild ``seed_addresses``."""
+        reached = frozenset(reached_node_ids)
+        needed: set[str] = set()
+        pending = [
+            address.node_id
+            for address in seed_addresses
+            if isinstance(address, NodeResultAddress) and address.node_id in self.nodes
+        ]
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            if node_id not in reached:
+                raise PureResultReplayIndexError(
+                    REACHABILITY_AMBIGUOUS,
+                    f"pure node {node_id!r} is needed but was not reached",
+                    context={"node_id": node_id},
+                )
+            needed.add(node_id)
+            pending.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+# ---------------------------------------------------------------- witnesses
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completion row; never serializes a result."""
+    if witness.visit_count != 1:
+        raise ValueError("derived pure replay supports exactly one visit")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _exact(left: Any, right: Any) -> bool:
+    """JSON equality that does not conflate bool with int."""
+    if type(left) is not type(right):
+        return False
+    if isinstance(left, dict):
+        return left.keys() == right.keys() and all(_exact(left[k], right[k]) for k in left)
+    return left == right
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the shell for ``witness``."""
+    if not isinstance(row, Mapping) or not _exact(dict(row), build_pure_completion_shell(witness)):
+        raise ValueError("pure completion row is not the exact value-free shell")
+
+
+def _row_dict(row: Any) -> Any:
+    return row.to_dict() if isinstance(row, StepResult) else row
+
+
+def _state_view(state: Any) -> Mapping[str, Any]:
+    return state.to_dict() if hasattr(state, "to_dict") else state
+
+
+def _is_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True
+
+
+def _cursor_relates(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _cursor_matches(cursor: Mapping[str, Any], witness: PureReplayVisitWitness, visit: Any) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and type(cursor.get("index")) is int
+        and cursor.get("type") == "pure_projection"
+        and cursor.get("status") == "running"
+        and type(cursor.get("visit_count")) is int
+        and cursor.get("visit_count") == visit == witness.visit_count
+    )
+
+
+def _failure_row_matches(row: Any, witness: PureReplayVisitWitness, visit: Any) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("name") == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and type(row.get("visit_count")) is int
+        and row.get("visit_count") == visit == witness.visit_count
+    )
+
+
+def classify_pure_replay_progress(state: Any, *, witness: PureReplayVisitWitness) -> str:
+    """Classify visit/cursor/row evidence: unstarted, interrupted, derived_complete,
+    durable_failure_skip; anything else is ``progress_witness_invalid``."""
+    view = _state_view(state)
+    key = witness.presentation_key
+    visits = view.get("step_visits") or {}
+    steps = view.get("steps") or {}
+    cursor = view.get("current_step")
+    has_visit = key in visits
+    visit = visits.get(key)
+    has_row = key in steps
+    row = _row_dict(steps.get(key))
+    related = _cursor_relates(cursor, witness)
+    if not has_visit:
+        return PROGRESS_WITNESS_INVALID if (related or has_row) else "unstarted"
+    if type(visit) is not int or visit != witness.visit_count:
+        return PROGRESS_WITNESS_INVALID
+    if related and has_row:
+        return PROGRESS_WITNESS_INVALID
+    if related:
+        return "interrupted" if _cursor_matches(cursor, witness, visit) else PROGRESS_WITNESS_INVALID
+    if not has_row:
+        return PROGRESS_WITNESS_INVALID
+    if _is_shell(row, witness):
+        return "derived_complete"
+    if _failure_row_matches(row, witness, visit):
+        return "durable_failure_skip"
+    return PROGRESS_WITNESS_INVALID
+
+
+# ------------------------------------------------------------------- index
+
+
+def _thaw(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _thaw(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_thaw(v) for v in value]
+    return value
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and set(doc) == {"ref"} and isinstance(doc["ref"], str)
+
+
+def _check_literal(doc: Any, descriptor: Mapping[str, Any], path: tuple[Any, ...]) -> None:
+    """Walk a binding document against its declared type; refs are opaque leaves."""
+    if _is_exact_ref(doc):
+        return
+    kind = _descriptor_kind(descriptor)
+    if isinstance(doc, Mapping) and "ref" in doc and not (
+        kind in {"record", "union", "variant_case"} and _declares_field(descriptor, "ref")
+    ):
+        raise _invalid("malformed ref object in binding document", path=list(path))
+    if kind == "optional":
+        if doc is not None:
+            _check_literal(doc, descriptor["item"], path)
+    elif kind == "list":
+        if not isinstance(doc, (list, tuple)):
+            raise _invalid("literal must be a list", path=list(path))
+        for index, item in enumerate(doc):
+            _check_literal(item, descriptor["item"], (*path, index))
+    elif kind == "map":
+        if not isinstance(doc, Mapping):
+            raise _invalid("literal must be a map", path=list(path))
+        for key, item in doc.items():
+            _check_leaf(key, descriptor["key"], path)
+            _check_literal(item, descriptor["value"], (*path, key))
+    elif kind == "record":
+        _check_fields(doc, descriptor["fields"], path, exact=True)
+    elif kind in {"union", "variant_case"}:
+        _check_union(doc, descriptor, path)
+    else:
+        _check_leaf(doc, descriptor, path)
+
+
+def _declares_field(descriptor: Mapping[str, Any], name: str) -> bool:
+    fields = list(descriptor.get("fields", ()))
+    for variant in descriptor.get("variants", ()):
+        fields.extend(variant.get("fields", ()))
+    return any(isinstance(f, Mapping) and f.get("name") == name for f in fields)
+
+
+def _check_leaf(value: Any, descriptor: Mapping[str, Any], path: tuple[Any, ...]) -> None:
+    if _is_exact_ref(value):
+        return
+    if isinstance(value, str) and _UNBOUND_TEXT.search(value):
+        raise _invalid("unbound text in binding literal", path=list(path))
+    try:
+        _coerce_value(value, descriptor, context="binding")
+    except PureExprEvaluationError as exc:
+        raise _invalid(f"literal does not match declared type: {exc}", path=list(path)) from exc
+
+
+def _check_fields(doc: Any, fields: Iterable[Mapping[str, Any]], path: tuple[Any, ...], *, exact: bool) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("literal must be a record", path=list(path))
+    names = set()
+    for field_desc in fields:
+        names.add(field_desc["name"])
+        if field_desc["name"] not in doc:
+            raise _invalid(f"literal is missing field {field_desc['name']!r}", path=list(path))
+        _check_literal(doc[field_desc["name"]], field_desc["type"], (*path, field_desc["name"]))
+    if exact and set(doc) - names:
+        raise _invalid("literal has undeclared fields", path=list(path))
+
+
+def _check_union(doc: Any, descriptor: Mapping[str, Any], path: tuple[Any, ...]) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("literal must be a union value", path=list(path))
+    variant = doc.get("variant")
+    if _is_exact_ref(variant):
+        return
+    variants = {v["name"]: v for v in descriptor.get("variants", ())} if "variants" in descriptor else {
+        descriptor["variant"]: descriptor
+    }
+    if variant not in variants:
+        raise _invalid("literal names an unknown variant", path=list(path))
+    all_fields = {
+        f["name"]: f["type"] for v in variants.values() for f in v.get("fields", ())
+    }
+    active = {f["name"] for f in variants[variant].get("fields", ())}
+    for name, value in doc.items():
+        if name == "variant":
+            continue
+        if name not in all_fields:
+            raise _invalid("literal has undeclared fields", path=list(path))
+        _check_literal(value, all_fields[name], (*path, name))  # inactive members too
+    if active - set(doc):
+        raise _invalid("literal is missing active variant fields", path=list(path))
+
+
+def _walk_refs(doc: Any, path: tuple[Any, ...]) -> Iterable[tuple[tuple[Any, ...], str]]:
+    if _is_exact_ref(doc):
+        yield path, doc["ref"]
+    elif isinstance(doc, Mapping):
+        for key, item in doc.items():
+            yield from _walk_refs(item, (*path, key))
+    elif isinstance(doc, (list, tuple)):
+        for index, item in enumerate(doc):
+            yield from _walk_refs(item, (*path, index))
+
+
+def _body_owned_node_ids(nodes: Mapping[str, Any]) -> set[str]:
+    owned: set[str] = set()
+    for node in nodes.values():
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)):
+            owned.update(node.body_node_ids)
+    return owned
+
+
+def _cyclic_node_ids(nodes: Mapping[str, Any]) -> set[str]:
+    """Nodes on a control-flow cycle (iterative Tarjan SCC)."""
+    edges: dict[str, list[str]] = {}
+    for node_id, node in nodes.items():
+        targets = [node.fallthrough_node_id] + [t.target_node_id for t in node.routed_transfers.values()]
+        edges[node_id] = [t for t in targets if t in nodes]
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    on_stack: set[str] = set()
+    stack: list[str] = []
+    cyclic: set[str] = set()
+    counter = 0
+    for root in nodes:
+        if root in index:
+            continue
+        work = [(root, iter(edges[root]))]
+        index[root] = low[root] = counter
+        counter += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            current, children = work[-1]
+            advanced = False
+            for child in children:
+                if child not in index:
+                    index[child] = low[child] = counter
+                    counter += 1
+                    stack.append(child)
+                    on_stack.add(child)
+                    work.append((child, iter(edges[child])))
+                    advanced = True
+                    break
+                if child in on_stack:
+                    low[current] = min(low[current], index[child])
+            if advanced:
+                continue
+            work.pop()
+            if work:
+                parent = work[-1][0]
+                low[parent] = min(low[parent], low[current])
+            if low[current] == index[current]:
+                component = []
+                while True:
+                    member = stack.pop()
+                    on_stack.discard(member)
+                    component.append(member)
+                    if member == current:
+                        break
+                if len(component) > 1 or current in edges[current]:
+                    cyclic.update(component)
+    return cyclic
+
+
+def _propagate_pure_ineligibility(
+    reasons: Mapping[str, str],
+    pure_dependencies: Mapping[str, Iterable[str]],
+) -> dict[str, str]:
+    """A pure node reading a multiply-visited pure node sees a moving value, so it
+    cannot be re-derived deterministically either."""
+    result = dict(reasons)
+    changed = True
+    while changed:
+        changed = False
+        for node_id, deps in pure_dependencies.items():
+            if node_id not in result and any(dep in result for dep in deps):
+                result[node_id] = MULTIPLE_VISIT_REGION
+                changed = True
+    return result
+
+
+def _address_for(target: Any, ref: StructuredStepReference) -> BoundAddress:
+    if ref.field == "artifacts" and ref.member:
+        if isinstance(target, CallBoundaryNode):
+            return CallOutputAddress(node_id=target.node_id, output_name=ref.member)
+        if isinstance(target, (IfJoinNode, MatchJoinNode)):
+            return BlockOutputAddress(node_id=target.node_id, output_name=ref.member)
+        if isinstance(target, RepeatUntilFrameNode):
+            return LoopOutputAddress(node_id=target.node_id, output_name=ref.member)
+    return NodeResultAddress(node_id=target.node_id, field=ref.field, member=ref.member)
+
+
+def _verify_projection(bundle: Any) -> dict[str, str]:
+    """Check projection identities against the IR; return presentation key -> node id."""
+    projection = bundle.projection
+    by_key: dict[str, str] = {}
+    seen_step_ids: dict[str, str] = {}
+    for node_id, node in bundle.ir.nodes.items():
+        entry = projection.entries_by_node_id.get(node_id)
+        if entry is None:
+            continue
+        if entry.step_id != node.step_id or entry.node_id != node_id:
+            raise _invalid("projection identity does not match the executable node", node_id=node_id)
+        if entry.presentation_key in by_key or node.step_id in seen_step_ids:
+            raise _invalid("duplicate projection authority", node_id=node_id)
+        by_key[entry.presentation_key] = node_id
+        seen_step_ids[node.step_id] = node_id
+    return by_key
+
+
+def _node_bindings(
+    node: Any,
+    keys: Mapping[str, str],
+    bundle: Any,
+) -> tuple[tuple[PureReplayBinding, ...], Mapping[str, Any], Mapping[str, Any]]:
+    config = getattr(node.execution_config, "pure_projection", None)
+    if not isinstance(config, Mapping):
+        raise _invalid("pure projection config is missing", node_id=node.node_id)
+    payload = config.get("payload")
+    refs = _thaw(config.get("binding_refs"))
+    contracts = _thaw(config.get("output_contracts"))
+    if not isinstance(payload, Mapping) or not isinstance(refs, dict) or not isinstance(contracts, dict):
+        raise _invalid("pure projection config is malformed", node_id=node.node_id)
+    declared = payload.get("bindings")
+    if not isinstance(declared, Mapping):
+        raise _invalid("pure payload bindings are malformed", node_id=node.node_id)
+    catalog = SurfaceRefScopeCatalog(root_step_names=tuple(keys))
+    bindings = []
+    for name, doc in refs.items():
+        spec = declared.get(name)
+        if not isinstance(spec, Mapping):
+            raise _invalid(f"binding {name!r} is not declared by the payload", node_id=node.node_id)
+        _check_literal(_thaw(doc), _thaw(spec["type"]), (name,))
+        for path, ref in _walk_refs(_thaw(doc), (name,)):
+            bindings.append(PureReplayBinding(path, _bind_ref(ref, catalog, keys, bundle, node)))
+    return tuple(bindings), contracts, payload
+
+
+def _bind_ref(ref: str, catalog: SurfaceRefScopeCatalog, keys: Mapping[str, str], bundle: Any, node: Any) -> BoundAddress:
+    try:
+        parsed = parse_surface_ref(ref, catalog)
+    except ReferenceResolutionError as exc:
+        raise _invalid(f"unresolvable ref: {exc}", node_id=node.node_id, ref=ref) from exc
+    if isinstance(parsed, WorkflowInputReference):
+        if parsed.input_name not in bundle.ir.inputs:
+            raise _invalid("ref names an unknown workflow input", node_id=node.node_id, ref=ref)
+        return WorkflowInputAddress(input_name=parsed.input_name)
+    if not isinstance(parsed, StructuredStepReference) or parsed.scope != "root":
+        raise _invalid("cross-frame or unsupported ref scope", node_id=node.node_id, ref=ref)
+    target_id = keys.get(parsed.step_name)
+    if target_id is None:
+        raise _invalid("ref names an unknown step", node_id=node.node_id, ref=ref)
+    return _address_for(bundle.ir.nodes[target_id], parsed)
+
+
+def _topological_order(order: Iterable[str], deps: Mapping[str, tuple[str, ...]]) -> tuple[str, ...]:
+    remaining = [node_id for node_id in order if node_id in deps]
+    done: set[str] = set()
+    result: list[str] = []
+    while remaining:
+        ready = [n for n in remaining if all(d in done for d in deps[n])]
+        if not ready:
+            raise _invalid("pure dependency cycle", node_ids=sorted(remaining))
+        result.extend(ready)
+        done.update(ready)
+        remaining = [n for n in remaining if n not in done]
+    return tuple(result)
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = "root") -> PureResultReplayIndex:
+    """Derive replay eligibility and dependencies without mutating ``bundle``.
+
+    Refs are scoped to the bundle that holds them, so an imported callee bundle
+    is always indexed under its own scope ``"root"``.
+    """
+    actual_scope = "root"
+    if scope_kind != actual_scope:
+        raise PureResultReplayIndexError(
+            DEPENDENCY_INDEX_INVALID,
+            "scope_kind does not match the bundle's scope",
+            context={"expected_scope": scope_kind, "actual_scope": actual_scope},
+        )
+    nodes = bundle.ir.nodes
+    keys = _verify_projection(bundle)
+    pure_ids = [n for n, node in nodes.items() if node.kind is ExecutableNodeKind.PURE_PROJECTION]
+    multiply_visited = _body_owned_node_ids(nodes) | _cyclic_node_ids(nodes)
+    reasons = {n: MULTIPLE_VISIT_REGION for n in pure_ids if n in multiply_visited}
+    built = {
+        node_id: _node_bindings(nodes[node_id], keys, bundle)
+        for node_id in pure_ids
+        if node_id not in reasons
+    }
+    pure_id_set = set(pure_ids)
+    pure_deps = {
+        node_id: tuple(dict.fromkeys(
+            b.address.node_id for b in bindings if getattr(b.address, "node_id", None) in pure_id_set
+        ))
+        for node_id, (bindings, _, _) in built.items()
+    }
+    reasons = _propagate_pure_ineligibility(
+        reasons,
+        {n: [d for d in deps if d in reasons or d in built] for n, deps in pure_deps.items()},
+    )
+    eligible = {n: d for n, d in pure_deps.items() if n not in reasons}
+    eligible_deps = {n: tuple(x for x in d if x in eligible) for n, d in eligible.items()}
+    order = _topological_order(nodes, eligible_deps)
+    result_nodes = {}
+    for node_id in order:
+        bindings, contracts, _ = built[node_id]
+        node = nodes[node_id]
+        durable = tuple(dict.fromkeys(
+            b.address.node_id
+            for b in bindings
+            if hasattr(b.address, "node_id") and b.address.node_id not in eligible
+        ))
+        result_nodes[node_id] = PureReplayNode(
+            node_id=node_id,
+            step_id=node.step_id,
+            presentation_key=bundle.projection.entries_by_node_id[node_id].presentation_key,
+            bindings=bindings,
+            output_addresses=tuple(
+                NodeResultAddress(node_id=node_id, field="artifacts", member=name) for name in contracts
+            ),
+            output_contracts=MappingProxyType({k: MappingProxyType(v) for k, v in contracts.items()}),
+            pure_dependency_node_ids=eligible_deps[node_id],
+            durable_dependency_node_ids=durable,
+        )
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=MappingProxyType(result_nodes),
+        topological_node_ids=order,
+        ineligible_pure_reasons=MappingProxyType(dict(reasons)),
+    )
+
+
+def __getattr__(name: str) -> Any:
+    if name == "PureReplayRuntime":
+        from .pure_replay_runtime import PureReplayRuntime
+
+        return PureReplayRuntime
+    raise AttributeError(name)

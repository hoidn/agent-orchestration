+def test_force_restart_new_root_selects_profile_and_leaves_source_unchanged(tmp_path: Path) -> None:
+    from unittest.mock import MagicMock
+
+    from orchestrator.cli.commands.resume import resume_workflow
+
+    workflow = tmp_path / "wf.orc"
+    workflow.write_text(
+        "\n".join(
+            [
+                "(workflow-lisp", '  (:language "0.1")', '  (:target-dsl "2.15")', "  (defmodule wf)",
+                "  (export orchestrate)", "  (defrecord Out (status String) (ready Bool))",
+                "  (defworkflow orchestrate ((approved Bool) (status String)) -> Out",
+                "    (record Out :status status :ready approved)))", "",
+            ]
+        ),
+        encoding="utf-8",
+    )
+    source = StateManager(workspace=tmp_path, run_id="source")
+    source.initialize(str(workflow), bound_inputs={"approved": False, "status": "pending"})
+    before = source.state_file.read_bytes()
+
+    with patch("orchestrator.cli.commands.resume.WorkflowExecutor") as executor_cls, patch(
+        "os.getcwd", return_value=str(tmp_path)
+    ), patch("uuid.uuid4", return_value=MagicMock(hex="restarted")):
+        executor_cls.return_value.execute.return_value = {"status": "completed", "steps": {}}
+        code = resume_workflow(run_id="source", repair=False, force_restart=True, summary_mode="off")
+
+    new_state = json.loads((tmp_path / ".orchestrate" / "runs" / "restarted" / "state.json").read_text())
+    assert code == 0
+    assert new_state["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    assert "observability" in new_state
+    assert source.state_file.read_bytes() == before

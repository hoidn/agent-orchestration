+def test_value_row_for_eligible_node_is_a_profile_conflict(tmp_path: Path) -> None:
+    bundle, manager, _ = _profiled_failed_run(tmp_path, DERIVED_PURE_REPLAY_PROFILE)
+    state = manager.load()
+    key = next(k for k, v in state.steps.items() if v.get("result_storage"))
+    state.steps[key] = {**state.steps[key], "artifacts": {"return": 1}}
+    manager.state = state
+    manager._write_state()
+
+    resumed = WorkflowExecutor(bundle, tmp_path, StateManager(workspace=tmp_path, run_id="profiled")).execute(resume=True)
+
+    assert resumed["error"]["type"] == "pure_result_replay_unavailable"
+    assert resumed["error"]["context"]["reason"] == "profile_conflict"
+    assert resumed["error"]["context"]["surface"] == "steps"

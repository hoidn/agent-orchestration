+# -- index validation of binding documents ---------------------------------------------------------
+
+
+def _with_binding_refs(bundle, binding_refs):
+    from dataclasses import replace
+
+    node_id, node = next(
+        (nid, n) for nid, n in bundle.ir.nodes.items() if n.kind.value == "pure_projection"
+    )
+    config = node.execution_config
+    projection = {**dict(config.pure_projection), "binding_refs": binding_refs}
+    new_node = replace(node, execution_config=replace(config, pure_projection=projection))
+    ir = replace(bundle.ir, nodes={**dict(bundle.ir.nodes), node_id: new_node})
+    return replace(bundle, ir=ir)
+
+
+@pytest.mark.parametrize(
+    "binding_refs",
+    [
+        {"status": 5, "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": "inputs.status", "extra": 1}, "approved": {"ref": "inputs.approved"}},
+        {"status": "${unbound}", "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": "root.steps.elsewhere.artifacts.x"}, "approved": {"ref": "inputs.approved"}},
+    ],
+)
+def test_index_rejects_invalid_binding_documents(tmp_path: Path, binding_refs) -> None:
+    from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+    fixtures = SELECTOR.parent.resolve()
+    result = compile_stage3_entrypoint(
+        fixtures / SELECTOR.name, source_roots=(fixtures,), provider_externs={}, prompt_externs={},
+        command_boundaries={}, validate_shared=True, workspace_root=tmp_path,
+    )
+    bundle = result.validated_bundles_by_name["pure_expr_selector_action_projection::orchestrate"]
+    assert derive_pure_result_replay_index(bundle).nodes
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(_with_binding_refs(bundle, binding_refs))
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+

+"""Value-free completion shells and progress classification for derived pure replay.
+
+Dependencies: ``orchestrator.state`` (RunState/StepResult); ``orchestrator.state`` imports
+this module lazily inside the visit methods.
+Behavior: an eligible pure projection persists only ``build_pure_completion_shell``
+on success; failures and skips stay full durable rows. ``classify_pure_replay_progress``
+classifies one state's visit counter, ``current_step`` cursor and ``steps`` row for one
+single-visit witness.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Mapping, Optional
+
+from ..state import RunState, StepResult
+
+DERIVED_PURE_REPLAY_PROFILE = "derived_pure_replay.v1"
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+_PURE_PROJECTION_TYPE = "pure_projection"
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed replay error carrying a stable ``reason`` and ``context``."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit eligible pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completed row directly (no StepResult serialization)."""
+    if witness.visit_count != 1:
+        raise ValueError("derived pure completion shells exist only for visit 1")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _canonical(value: Any) -> str:
+    # JSON keeps True/1 and 0/False distinct, unlike ``==``.
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _is_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        return _canonical(row) == _canonical(build_pure_completion_shell(witness))
+    except (TypeError, ValueError):
+        return False
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's completion shell."""
+    if not _is_shell(row, witness):
+        raise ValueError("row is not the exact derived pure completion shell")
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID, message, context=context
+    )
+
+
+def _cursor_is_related(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _cursor_matches(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and type(cursor.get("index")) is int
+        and cursor.get("type") == _PURE_PROJECTION_TYPE
+        and cursor.get("visit_count") == witness.visit_count
+        and type(cursor.get("visit_count")) is int
+        and cursor.get("status") == "running"
+    )
+
+
+def _failure_row_matches(row: Mapping[str, Any], witness: PureReplayVisitWitness) -> bool:
+    return (
+        row.get("status") in {"failed", "skipped"}
+        and row.get("name", witness.presentation_key) == witness.presentation_key
+        and row.get("step_id", witness.step_id) == witness.step_id
+        and row.get("visit_count", witness.visit_count) == witness.visit_count
+    )
+
+
+def classify_pure_replay_progress(
+    state: Mapping[str, Any], *, witness: PureReplayVisitWitness
+) -> str:
+    """Classify visit, cursor and row for ``witness`` or raise ``progress_witness_invalid``."""
+    key = witness.presentation_key
+    visits = state.get("step_visits")
+    visit = visits.get(key) if isinstance(visits, Mapping) else None
+    cursor = state.get("current_step")
+    steps = state.get("steps")
+    row = steps.get(key) if isinstance(steps, Mapping) else None
+    related = _cursor_is_related(cursor, witness)
+
+    if visit is None:
+        if related or row is not None:
+            raise _invalid(
+                "pure replay cursor or row exists without a visit", step_id=witness.step_id
+            )
+        return UNSTARTED
+    if type(visit) is not int or visit != witness.visit_count:
+        raise _invalid(
+            "pure replay visit count does not match the witness",
+            step_id=witness.step_id,
+            observed_visit_count=visit,
+        )
+    if related and row is not None:
+        raise _invalid(
+            "pure replay cursor and row coexist", step_id=witness.step_id
+        )
+    if isinstance(cursor, Mapping) and related:
+        if not _cursor_matches(cursor, witness):
+            raise _invalid("pure replay cursor mismatch", step_id=witness.step_id)
+        return INTERRUPTED
+    if row is None:
+        raise _invalid("pure replay visit has no cursor or row", step_id=witness.step_id)
+    if _is_shell(row, witness):
+        return DERIVED_COMPLETE
+    if isinstance(row, Mapping) and _failure_row_matches(row, witness):
+        return DURABLE_FAILURE_SKIP
+    raise _invalid("pure replay row is not a shell, failure or skip", step_id=witness.step_id)
+
+
+def run_state_view(state: RunState) -> dict[str, Any]:
+    """Project the classification inputs of a RunState into plain mappings."""
+    return {
+        "step_visits": state.step_visits,
+        "current_step": state.current_step,
+        "steps": {
+            key: row.to_dict() if isinstance(row, StepResult) else row
+            for key, row in state.steps.items()
+        },
+    }
+
+
+def _require_progress(
+    state: RunState, witness: PureReplayVisitWitness, expected: str
+) -> None:
+    observed = classify_pure_replay_progress(run_state_view(state), witness=witness)
+    if observed != expected:
+        raise _invalid(
+            f"pure replay progress is {observed}, expected {expected}",
+            step_id=witness.step_id,
+        )
+
+
+def begin_pure_visit(
+    state: RunState, *, step_name: str, step_index: int, step_id: str
+) -> int:
+    """Mutate ``state`` to visit 1 with its matching running cursor."""
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    _require_progress(state, witness, UNSTARTED)
+    state.step_visits[step_name] = 1
+    now = datetime.now(timezone.utc).isoformat()
+    state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": _PURE_PROJECTION_TYPE,
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def reuse_pure_visit(state: RunState, witness: PureReplayVisitWitness) -> int:
+    """Validate an interrupted visit without writing."""
+    _require_progress(state, witness, INTERRUPTED)
+    return witness.visit_count
+
+
+def settle_pure_success(
+    state: RunState, witness: PureReplayVisitWitness
+) -> dict[str, Any]:
+    """Store the exact completion shell and clear the cursor."""
+    _require_progress(state, witness, INTERRUPTED)
+    shell = build_pure_completion_shell(witness)
+    state.steps[witness.presentation_key] = shell
+    state.current_step = None
+    return dict(shell)
+
+
+def settle_pure_failure(
+    state: RunState, witness: PureReplayVisitWitness, result: StepResult
+) -> None:
+    """Store a full failed/skipped row and clear the cursor."""
+    _require_progress(state, witness, INTERRUPTED)
+    row = result.to_dict()
+    if not _failure_row_matches(row, witness) or row.get("name") != witness.presentation_key:
+        raise _invalid(
+            "pure replay failure row does not match the witness", step_id=witness.step_id
+        )
+    state.steps[witness.presentation_key] = result
+    state.current_step = None

+    resumed_manager.load()
+    resumed = WorkflowExecutor(bundle, tmp_path, resumed_manager).execute(resume=True)
+    assert resumed["status"] == "completed", resumed.get("error")
+    assert resumed["workflow_outputs"]["return__loop_count"] == 1
+    assert resumed["workflow_outputs"]["return__selected_label"] == "ready"

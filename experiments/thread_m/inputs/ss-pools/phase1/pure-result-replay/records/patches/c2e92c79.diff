+def _failed_profiled_run(tmp_path: Path):
+    bundle = _compile_fixture(tmp_path)
+    manager = StateManager(workspace=tmp_path, run_id="profiled")
+    manager.initialize(
+        str(tmp_path / FIXTURE.name),
+        context=bundle_context_dict(bundle),
+        bound_inputs=_execution_inputs(tmp_path),
+        result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE,
+    )
+    real_render = WorkflowExecutor._execute_materialize_view.__globals__["render_view"]
+    armed = {"on": True}
+
+    def fail_once(*args, **kwargs):
+        if armed["on"]:
+            armed["on"] = False
+            raise RuntimeError("synthetic interruption")
+        return real_render(*args, **kwargs)
+
+    with patch("orchestrator.workflow.executor.render_view", side_effect=fail_once):
+        first = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    return bundle, manager, first
+
+
+def _shell_rows(manager: StateManager) -> dict:
+    steps = json.loads(manager.state_file.read_text(encoding="utf-8"))["steps"]
+    return {k: v for k, v in steps.items() if v.get("result_storage") == DERIVED_PURE_REPLAY_PROFILE}

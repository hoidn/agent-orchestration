+def test_profiled_run_persists_eligible_pure_results_value_free(tmp_path: Path) -> None:
+    bundle, manager, first = _failed_profiled_run(tmp_path)
+    assert first["status"] == "failed"
+    shells = _shell_rows(manager)
+    assert shells
+    on_disk = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    index = derive_pure_result_replay_index(bundle)
+    eligible_keys = {n.presentation_key for n in index.nodes.values()}
+    for key, row in on_disk["steps"].items():
+        if key in eligible_keys and row["status"] == "completed":
+            assert row == {**build_pure_completion_shell(
+                PureReplayVisitWitness(key, row.get("index", 0), row["step_id"], 1)), "name": key}
+    eligible_step_ids = {n.step_id for n in index.nodes.values()}
+    for versions in on_disk["private_artifact_versions"].values():
+        assert not any(v.get("producer") in eligible_step_ids for v in versions)
+    for record in (tmp_path / ".orchestrate" / "runs" / "profiled").rglob("record:*.json"):
+        payload = json.loads(record.read_text(encoding="utf-8"))
+        assert payload["pending_effect_policy"]["effect_kind"] != "pure_projection"
+        for binding in (payload.get("restore_payload") or {}).get("bindings", ()):
+            assert binding.get("source_step_id") not in eligible_step_ids

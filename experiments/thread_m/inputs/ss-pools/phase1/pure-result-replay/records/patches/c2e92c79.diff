+@pytest.mark.parametrize(
+    "failure, reason, cause",
+    [
+        ({"type": "materialize_ref_unresolved", "message": "m"}, "binding_unresolved", "materialize_ref_unresolved"),
+        ({"type": "pure_expr_payload_invalid", "message": "m"}, "evaluation_failed", "pure_evaluation_failed"),
+        (
+            {"type": "contract_violation", "message": "m", "context": {"reason": "pure_projection_contract_invalid"}},
+            "output_contract_invalid", "pure_projection_contract_invalid",
+        ),
+    ],
+)
+def test_replay_node_maps_rederivation_failures(tmp_path: Path, failure, reason, cause) -> None:
+    bundle, manager = _interrupted_single_pure_run(tmp_path)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("wf"))
+    node_id = next(iter(runtime.index.nodes))
+    state = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.replay_node(
+            node_id, state=state,
+            evaluate_node=lambda node, overlay: {"status": "failed", "exit_code": 2, "error": failure},
+        )
+    assert excinfo.value.reason == reason
+    assert excinfo.value.context["cause"] == {"type": cause}

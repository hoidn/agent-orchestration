+# -- checkpoint-surface conflicts ---------------------------------------------------------------------
+
+
+def _write_index(tmp_path: Path, bundle, step_id: str, *, call_frame_id, record: dict | None = None) -> None:
+    from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_index_path
+
+    manager = StateManager(workspace=tmp_path, run_id="profiled")
+    point = next(p for p in bundle.runtime_plan.lexical_checkpoint_points if p.step_id == step_id)
+    index_path = resolve_checkpoint_index_path(
+        state_manager=manager, workflow_name=bundle.runtime_plan.workflow_name,
+        checkpoint_id=point.checkpoint_id,
+    )
+    record_path = tmp_path / "record.json"
+    record_path.write_text(json.dumps(record or {}), encoding="utf-8")
+    index_path.parent.mkdir(parents=True, exist_ok=True)
+    index_path.write_text(
+        json.dumps({"records": [{"record_id": "r", "record_path": "record.json",
+                                 "frame_identity": {"call_frame_id": call_frame_id}}]}),
+        encoding="utf-8",
+    )
+
+
+def _resume_conflict(tmp_path: Path, bundle) -> PureResultReplayIndexError:
+    resumed_manager = StateManager(workspace=tmp_path, run_id="profiled")
+    resumed_manager.load()
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        WorkflowExecutor(bundle, tmp_path, resumed_manager).execute(resume=True)
+    return excinfo.value
+
+
+def test_checkpoint_record_for_eligible_node_is_a_profile_conflict(tmp_path: Path) -> None:
+    bundle, _, _ = _failed_profiled_run(tmp_path)
+    node = next(iter(derive_pure_result_replay_index(bundle).nodes.values()))
+    _write_index(tmp_path, bundle, node.step_id, call_frame_id=None)
+    error = _resume_conflict(tmp_path, bundle)
+    assert error.reason == "profile_conflict"
+    assert error.context["surface"] == "checkpoint_record"

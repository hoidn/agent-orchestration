+def test_resume_determines_the_restart_boundary_exactly_once(tmp_path: Path) -> None:
+    from orchestrator.workflow.resume_planner import ResumePlanner
+
+    bundle, _, _ = _failed_profiled_run(tmp_path)
+    resumed_manager = StateManager(workspace=tmp_path, run_id="profiled")
+    resumed_manager.load()
+    calls: list[str | None] = []
+    original = ResumePlanner.determine_restart_node_id
+
+    def counting(self, *args, **kwargs):
+        node_id = original(self, *args, **kwargs)
+        calls.append(node_id)
+        return node_id
+
+    with patch.object(ResumePlanner, "determine_restart_node_id", counting):
+        resumed = WorkflowExecutor(bundle, tmp_path, resumed_manager).execute(resume=True)
+    assert resumed["status"] == "completed"
+    assert len(calls) == 1

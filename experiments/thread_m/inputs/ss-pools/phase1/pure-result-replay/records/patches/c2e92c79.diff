+def test_force_restart_selects_profile_and_leaves_source_run_unchanged(tmp_path: Path, monkeypatch) -> None:
+    import hashlib
+
+    from orchestrator.cli.commands.resume import resume_workflow
+
+    workflow = tmp_path / "test_workflow.orc"
+    workflow.write_text(_ORC_SOURCE, encoding="utf-8")
+    old_dir = tmp_path / ".orchestrate" / "runs" / "old"
+    old_dir.mkdir(parents=True)
+    old_state = {
+        "schema_version": StateManager.SCHEMA_VERSION, "run_id": "old", "workflow_file": str(workflow),
+        "workflow_checksum": f"sha256:{hashlib.sha256(_ORC_SOURCE.encode()).hexdigest()}",
+        "started_at": "t", "updated_at": "t", "status": "failed", "context": {},
+        "bound_inputs": {"approved": False, "status": "pending"}, "steps": {},
+    }
+    (old_dir / "state.json").write_text(json.dumps(old_state), encoding="utf-8")
+    before = (old_dir / "state.json").read_bytes()
+    monkeypatch.chdir(tmp_path)
+    created: list[StateManager] = []
+
+    class _Executor:
+        def __init__(self, *args, **kwargs):
+            created.append(kwargs["state_manager"])
+
+        def execute(self, **kwargs):
+            return {"status": "completed", "steps": {}}
+
+    with patch("orchestrator.cli.commands.resume.WorkflowExecutor", _Executor):
+        assert resume_workflow(run_id="old", repair=False, force_restart=True) == 0
+    new_state = json.loads(created[0].state_file.read_text(encoding="utf-8"))
+    assert new_state["run_id"] != "old"
+    assert new_state["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    assert (old_dir / "state.json").read_bytes() == before

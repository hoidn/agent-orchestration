+"""In-memory replay of eligible pure projections from durable inputs.
+
+Dependencies: ``pure_replay_index`` (eligibility/dependencies), ``pure_replay_shell``
+(witnesses/classification), the bundle's projection/runtime plan, and, for the
+persisted-surface audit, the checkpoint sidecars reachable through the state manager.
+Behavior: replay validates only the required dependency leaves, re-derives pure values
+through an injected ``evaluate_node`` callable and holds them in a process-local cache.
+It never dispatches effects, bumps visits, settles results or writes durable state.
+A cache hit is always revalidated against the current state: the state row must be
+the exact durable shell or the exact validated active result held in the cache.
+"""
+
+from __future__ import annotations
+
+import json
+from copy import deepcopy
+from dataclasses import dataclass, fields, is_dataclass
+from pathlib import Path
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from ..contracts.output_contract import OutputContractError
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_index import (
+    ROOT_SCOPE,
+    PureReplayBinding,
+    PureReplayNode,
+    PureResultReplayIndex,
+    derive_pure_result_replay_index,
+)
+from .pure_replay_shell import (
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_COMPLETE,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    _canonical,
+    _is_shell,
+    classify_pure_replay_progress,
+)
+from .resume_projection_integrity import ResumeScopePath
+
+_BINDING_UNRESOLVED = "binding_unresolved"
+_EVALUATION_FAILED = "evaluation_failed"
+_OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+_DURABLE_INPUT_MISSING = "durable_input_missing"
+_DURABLE_INPUT_INVALID = "durable_input_invalid"
+_OUTCOME_FIELD_TYPES = {"status": str, "phase": str, "class": str, "retryable": bool}
+
+
+@dataclass(frozen=True)
+class _Cached:
+    witness: PureReplayVisitWitness
+    result: Mapping[str, Any]
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _state_steps(state: Mapping[str, Any]) -> Mapping[str, Any]:
+    steps = state.get("steps")
+    return steps if isinstance(steps, Mapping) else {}
+
+
+def _collect_references(value: Any, names: Mapping[str, str], found: set[str]) -> None:
+    """Collect eligible-node ids referenced by typed addresses or ``steps.<name>.`` text."""
+    if isinstance(
+        value, (NodeResultAddress, BlockOutputAddress, LoopOutputAddress, CallOutputAddress)
+    ):
+        found.add(value.node_id)
+        return
+    if isinstance(value, str):
+        for name, node_id in names.items():
+            if f"steps.{name}." in value:
+                found.add(node_id)
+    elif isinstance(value, Mapping):
+        for key, item in value.items():
+            _collect_references(key, names, found)
+            _collect_references(item, names, found)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for item in value:
+            _collect_references(item, names, found)
+    elif is_dataclass(value) and not isinstance(value, type):
+        for field_ in fields(value):
+            _collect_references(getattr(value, field_.name), names, found)
+
+
+class PureReplayRuntime:
+    """Replay eligible pure projections for one bundle scope."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        # An imported callee bundle indexes only its own nodes under its own root scope.
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(
+            bundle, scope_kind=ROOT_SCOPE
+        )
+        self._node_by_step_id = {
+            node.step_id: node_id for node_id, node in self.index.nodes.items()
+        }
+        self._cache: dict[str, _Cached] = {}
+
+    # -- identity -----------------------------------------------------------------
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        """Return the eligible node a durable step id names (never a raw node id)."""
+        return self._node_by_step_id.get(step_id)
+
+    def _step_index(self, node_id: str) -> int:
+        entry = self.bundle.projection.entries_by_node_id[node_id]
+        if isinstance(entry.compatibility_index, int):
+            return entry.compatibility_index
+        plan_node = self.bundle.runtime_plan.nodes[node_id]
+        if isinstance(plan_node.execution_index, int):
+            return plan_node.execution_index
+        raise _error(DEPENDENCY_INDEX_INVALID, "pure node has no execution index", node_id=node_id)
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self.index.nodes[node_id]
+        return PureReplayVisitWitness(
+            node.presentation_key, self._step_index(node_id), node.step_id, visit_count
+        )
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        """Witness for the state's single visit; any other visit fails closed."""
+        node = self.index.nodes[node_id]
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        if type(visit) is not int or visit != 1:
+            raise _error(
+                PROGRESS_WITNESS_INVALID,
+                "eligible pure node must have exactly one visit",
+                node_id=node_id,
+                observed_visit_count=visit,
+            )
+        return self.witness(node_id, visit_count=1)
+
+    def classify(self, node_id: str, state: Mapping[str, Any]) -> str:
+        return classify_pure_replay_progress(state, witness=self.witness(node_id))
+
+    # -- cache --------------------------------------------------------------------
+
+    def _expected_members(self, node: PureReplayNode, artifacts: Mapping[str, Any]) -> set[str]:
+        """Static catalog members that a concrete (possibly union) result must carry."""
+        expected: set[str] = set()
+        for name, contract in node.output_contracts.items():
+            projection = contract.get("projection") if isinstance(contract, Mapping) else None
+            if (
+                isinstance(projection, Mapping)
+                and projection.get("projection_class") == "union_workflow_boundary"
+                and projection.get("field_role") == "variant"
+            ):
+                active = artifacts.get(projection.get("discriminant_output"))
+                if active not in (projection.get("active_variants") or ()):
+                    continue
+            expected.add(name)
+        return expected
+
+    def _validate_result(
+        self, node: PureReplayNode, witness: PureReplayVisitWitness, result: Any
+    ) -> dict[str, Any]:
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise _error(PROGRESS_WITNESS_INVALID, "active pure result is not completed", node_id=node.node_id)
+        if result.get("name", witness.presentation_key) != witness.presentation_key or result.get(
+            "step_id", witness.step_id
+        ) != witness.step_id:
+            raise _error(PROGRESS_WITNESS_INVALID, "active pure result identity mismatch", node_id=node.node_id)
+        artifacts = result.get("artifacts")
+        if not isinstance(artifacts, Mapping):
+            raise _error(DEPENDENCY_INDEX_INVALID, "pure result carries no artifacts", node_id=node.node_id)
+        if set(artifacts) != self._expected_members(node, artifacts):
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                "pure result members do not match the active output catalog",
+                node_id=node.node_id,
+                members=sorted(artifacts),
+            )
+        return deepcopy(dict(result))
+
+    def record_full_result(
+        self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]
+    ) -> None:
+        """Hold an active executor's validated full result in the process-local cache."""
+        node = self.index.nodes[node_id]
+        if witness != self.witness(node_id):
+            raise _error(PROGRESS_WITNESS_INVALID, "active result witness mismatch", node_id=node_id)
+        self._cache[node_id] = _Cached(witness, self._validate_result(node, witness, result))
+
+    def _validated_cached(self, node_id: str, state: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
+        node = self.index.nodes[node_id]
+        witness = self.witness_from_state(node_id, state)
+        cursor = state.get("current_step")
+        if isinstance(cursor, Mapping) and (
+            cursor.get("name") == node.presentation_key or cursor.get("step_id") == node.step_id
+        ):
+            raise _error(PROGRESS_WITNESS_INVALID, "cursor targets a settled pure node", node_id=node_id)
+        row = _state_steps(state).get(node.presentation_key)
+        if not isinstance(row, Mapping):
+            raise _error(PROGRESS_WITNESS_INVALID, "pure node row is missing or malformed", node_id=node_id)
+        cached = self._cache.get(node_id)
+        if _is_shell(row, witness):
+            return cached.result if cached is not None and cached.witness == witness else None
+        if cached is None or cached.witness != witness or _canonical(row) != _canonical(cached.result):
+            raise _error(PROGRESS_WITNESS_INVALID, "pure node row does not match the validated result", node_id=node_id)
+        return cached.result
+
+    # -- address resolution ---------------------------------------------------------
+
+    def resolve_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.input_name in inputs:
+                return True, inputs[address.input_name]
+            return False, None
+        node_id = address.node_id
+        if node_id in self.index.nodes:
+            row = self._validated_cached(node_id, state)
+            if row is None:
+                return False, None
+        else:
+            entry = self.bundle.projection.entries_by_node_id.get(node_id)
+            row = _state_steps(state).get(entry.presentation_key) if entry is not None else None
+        if not isinstance(row, Mapping):
+            return False, None
+        return self._row_member(address, row)
+
+    @staticmethod
+    def _row_member(address: BoundAddress, row: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, NodeResultAddress):
+            field_name, member = address.field, address.member
+        else:
+            field_name, member = "artifacts", address.output_name
+        container = row.get(field_name)
+        if member is None:
+            return field_name in row, container
+        if isinstance(container, Mapping) and member in container:
+            return True, container[member]
+        return False, None
+
+    def value_for_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _error(_BINDING_UNRESOLVED, "address has no value in state", address=repr(address))
+        return value
+
+    # -- boundary analysis ------------------------------------------------------------
+
+    def _progress_by_node(self, state: Mapping[str, Any]) -> dict[str, str]:
+        return {node_id: self.classify(node_id, state) for node_id in self.index.nodes}
+
+    def _top_level_order(self) -> list[str]:
+        return list(self.bundle.runtime_plan.ordered_node_ids)
+
+    def _consumer_nodes(self, restart_node_id: Optional[str]) -> list[Any]:
+        order = self._top_level_order()
+        if restart_node_id is None:
+            start = len(order)
+        elif restart_node_id in order:
+            start = order.index(restart_node_id)
+        else:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID, "restart node is not a top-level node", node_id=restart_node_id
+            )
+        remaining = tuple(order[start:])
+        finalization = tuple(self.bundle.ir.finalization_region)
+        owners = remaining + tuple(n for n in finalization if n not in remaining)
+        return [
+            node
+            for node_id, node in self.bundle.ir.nodes.items()
+            if any(node_id == owner or node_id.startswith(owner + ".") for owner in owners)
+        ]
+
+    def required_node_ids_for_boundary(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        """Complete pure nodes whose values the work at/after the boundary consumes."""
+        progress = self._progress_by_node(state)
+        complete = {n for n, p in progress.items() if p == DERIVED_COMPLETE}
+        names = {self.index.nodes[n].presentation_key: n for n in self.index.nodes}
+        names.update({self.bundle.ir.nodes[n].presentation_name: n for n in self.index.nodes})
+        referenced: set[str] = set()
+        _collect_references(self.bundle.ir.outputs, names, referenced)
+        for node in self._consumer_nodes(restart_node_id):
+            if node.node_id in self.index.nodes:
+                if node.node_id in complete:
+                    continue
+                for binding in self.index.nodes[node.node_id].bindings:
+                    if not isinstance(binding.address, WorkflowInputAddress):
+                        referenced.add(binding.address.node_id)
+                continue
+            _collect_references(node, names, referenced)
+        seeds = [
+            address
+            for node_id in referenced
+            if node_id in complete
+            for address in self.index.nodes[node_id].output_addresses
+        ]
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=complete)
+
+    def _check_leaf(self, node: PureReplayNode, binding: PureReplayBinding, state: Mapping[str, Any]) -> None:
+        address = binding.address
+        context = {"node_id": node.node_id, "binding": binding.path}
+        if isinstance(address, WorkflowInputAddress):
+            found, value = self.resolve_state_address(address, state)
+            if not found:
+                raise _error(_DURABLE_INPUT_MISSING, "bound input is missing", **context)
+            try:
+                _coerce_value(value, binding.value_type, context=binding.path)
+            except PureExprEvaluationError as exc:
+                raise _error(_DURABLE_INPUT_INVALID, f"bound input is invalid: {exc}", **context) from exc
+            return
+        if address.node_id in self.index.nodes:
+            return
+        entry = self.bundle.projection.entries_by_node_id.get(address.node_id)
+        row = _state_steps(state).get(entry.presentation_key) if entry is not None else None
+        if not isinstance(row, Mapping):
+            raise _error(_DURABLE_INPUT_MISSING, "durable dependency row is missing", **context)
+        found, value = self._row_member(address, row)
+        if not found:
+            raise _error(_DURABLE_INPUT_MISSING, "durable dependency value is missing", **context)
+        if isinstance(address, NodeResultAddress) and address.field == "exit_code":
+            valid = type(value) is int
+        elif isinstance(address, NodeResultAddress) and address.field == "outcome" and address.member:
+            expected_type = _OUTCOME_FIELD_TYPES.get(address.member)
+            valid = expected_type is None or type(value) is expected_type
+        else:
+            valid = True
+        if not valid:
+            raise _error(_DURABLE_INPUT_INVALID, "durable intrinsic has the wrong type", **context)
+
+    def audit_boundary_leaves(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        """Validate every required dependency leaf; return the required node ids."""
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        for node_id in required:
+            node = self.index.nodes[node_id]
+            for binding in node.bindings:
+                self._check_leaf(node, binding, state)
+        return required
+
+    # -- replay -----------------------------------------------------------------------
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Copy ``state`` with each revalidated cached full result swapped into ``steps``."""
+        overlay = dict(state)
+        steps = dict(_state_steps(state))
+        for node_id in self.index.nodes:
+            if node_id not in self._cache:
+                continue
+            result = self._validated_cached(node_id, state)
+            if result is not None:
+                steps[self.index.nodes[node_id].presentation_key] = deepcopy(dict(result))
+        overlay["steps"] = steps
+        return overlay
+
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Mapping[str, Any]],
+    ) -> Mapping[str, Any]:
+        """Evaluate one completed node over the overlay and cache its full result."""
+        node = self.index.nodes[node_id]
+        witness = self.witness_from_state(node_id, state)
+        if classify_pure_replay_progress(state, witness=witness) != DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "only completed pure nodes replay", node_id=node_id)
+        overlay = self.overlay_active_state(state)
+        try:
+            result = evaluate_node(node, overlay)
+        except PureExprEvaluationError as exc:
+            raise _error(_EVALUATION_FAILED, str(exc), node_id=node_id, cause={"type": "pure_evaluation_failed"}) from exc
+        except OutputContractError as exc:
+            raise _error(
+                _OUTPUT_CONTRACT_INVALID, str(exc), node_id=node_id,
+                cause={"type": "pure_projection_contract_invalid"},
+            ) from exc
+        self._raise_for_failed_result(node_id, result)
+        self._cache[node_id] = _Cached(witness, self._validate_result(node, witness, result))
+        return self._cache[node_id].result
+
+    @staticmethod
+    def _raise_for_failed_result(node_id: str, result: Any) -> None:
+        if isinstance(result, Mapping) and result.get("status") == "completed":
+            return
+        error = result.get("error") if isinstance(result, Mapping) else None
+        error = error if isinstance(error, Mapping) else {}
+        context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+        if context.get("reason") == "pure_projection_contract_invalid":
+            reason, cause = _OUTPUT_CONTRACT_INVALID, "pure_projection_contract_invalid"
+        elif error.get("type") == "materialize_ref_unresolved":
+            reason, cause = _BINDING_UNRESOLVED, "materialize_ref_unresolved"
+        else:
+            reason, cause = _EVALUATION_FAILED, "pure_evaluation_failed"
+        raise _error(
+            reason, str(error.get("message", "pure replay failed")),
+            node_id=node_id, cause={"type": cause},
+        )
+
+    def replay_boundary(
+        self,
+        restart_node_id: Optional[str],
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Mapping[str, Any]],
+    ) -> dict[str, Any]:
+        """Audit leaves, replay the required nodes in order and return the overlay state."""
+        for node_id in self.audit_boundary_leaves(restart_node_id, state=state):
+            self.replay_node(node_id, state=state, evaluate_node=evaluate_node)
+        return self.overlay_active_state(state)
+
+    # -- persisted-surface audit ----------------------------------------------------------
+
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Mapping[str, Any],
+        state_manager: Any,
+        resolve_bundle_path: Callable[[PureReplayNode], Optional[Path | str]],
+    ) -> None:
+        """Raise ``profile_conflict`` for any persisted value surface of an eligible node."""
+        for node in self.index.nodes.values():
+            self._audit_node_surfaces(node, state, resolve_bundle_path)
+        self._audit_checkpoint_surfaces(state, state_manager)
+
+    @staticmethod
+    def _conflict(surface: str, node: PureReplayNode) -> PureResultReplayIndexError:
+        return _error(
+            PROFILE_CONFLICT,
+            f"persisted {surface} exists for a derived-replay pure node",
+            surface=surface,
+            node_id=node.node_id,
+        )
+
+    def _audit_node_surfaces(self, node: PureReplayNode, state: Mapping[str, Any], resolve_bundle_path: Any) -> None:
+        row = _state_steps(state).get(node.presentation_key)
+        # A completed row without the shell marker is a historical value row; a marked
+        # row that is not the exact shell is rejected by progress classification instead.
+        if (
+            isinstance(row, Mapping)
+            and row.get("status") == "completed"
+            and "result_storage" not in row
+        ):
+            raise self._conflict("steps", node)
+        bundle_path = resolve_bundle_path(node)
+        if bundle_path is not None and Path(bundle_path).exists():
+            raise self._conflict("pure_bundle", node)
+        lineage = state.get("private_artifact_versions")
+        owners = {node.step_id, node.presentation_key}
+        for versions in (lineage.values() if isinstance(lineage, Mapping) else ()):
+            for entry in versions if isinstance(versions, list) else ():
+                if isinstance(entry, Mapping) and owners & {
+                    entry.get("producer"), entry.get("producer_name"), entry.get("step_id")
+                }:
+                    raise self._conflict("private_artifact_versions", node)
+
+    def _audit_checkpoint_surfaces(self, state: Mapping[str, Any], state_manager: Any) -> None:
+        from orchestrator.workflow_lisp.lexical_checkpoints import (
+            resolve_checkpoint_index_path,
+        )
+
+        by_step_id = {node.step_id: node for node in self.index.nodes.values()}
+        frame_id = getattr(state_manager, "frame_id", None)
+        plan = self.bundle.runtime_plan
+        for point in getattr(plan, "lexical_checkpoint_points", ()):
+            index_path = resolve_checkpoint_index_path(
+                state_manager=state_manager,
+                workflow_name=plan.workflow_name,
+                checkpoint_id=point.checkpoint_id,
+            )
+            if not index_path.exists():
+                continue
+            index = json.loads(index_path.read_text(encoding="utf-8"))
+            for entry in index.get("records", ()):
+                identity = entry.get("frame_identity") or {}
+                if identity.get("call_frame_id") != frame_id:
+                    continue
+                if point.step_id in by_step_id:
+                    raise self._conflict("checkpoint_record", by_step_id[point.step_id])
+                record_path = state_manager.workspace / entry.get("record_path", "")
+                if not record_path.is_file():
+                    continue
+                record = json.loads(record_path.read_text(encoding="utf-8"))
+                payload = record.get("restore_payload") or {}
+                for binding in payload.get("bindings", ()):
+                    source = binding.get("source_step_id")
+                    if source in by_step_id:
+                        raise self._conflict("restore_payload", by_step_id[source])

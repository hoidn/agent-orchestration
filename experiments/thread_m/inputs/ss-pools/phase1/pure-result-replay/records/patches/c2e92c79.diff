diff --git a/orchestrator/workflow/pure_replay_index.py b/orchestrator/workflow/pure_replay_index.py
new file mode 100644
index 0000000..56261bf
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_index.py
@@ -0,0 +1,430 @@
+"""Derived replay-eligibility and dependency index for compiler-generated pure projections.
+
+Dependencies: a loaded workflow bundle (``ir``, ``projection``, ``runtime_plan``,
+``provenance``); read-only and never serialized into the runtime plan.
+Behavior: ``derive_pure_result_replay_index`` decides which ``pure_projection`` nodes
+are replay-eligible (acyclic, visited at most once) and what each depends on. Refs are
+scoped to the workflow bundle that holds them.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import Any, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallBoundaryNode,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    IfJoinNode,
+    LoopOutputAddress,
+    MatchJoinNode,
+    NodeResultAddress,
+    PureProjectionStepConfig,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+)
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_shell import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+
+ROOT_SCOPE = "root"
+_STRING_TYPE = {"kind": "primitive", "name": "String"}
+_NOT_COMPILER_GENERATED = "not_compiler_generated"
+_LOOP_OWNED = MULTIPLE_VISIT_REGION
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    """One exact ref leaf of a binding document and its typed address."""
+
+    path: str
+    address: BoundAddress
+    value_type: Any = None
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    """One replay-eligible pure projection and its dependencies."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    """Eligible pure nodes (by id), their topological order and ineligibility reasons."""
+
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str] = field(default_factory=dict)
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[BoundAddress],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Return the pure nodes (topologically ordered) needed to rebuild the seeds."""
+        reached = set(reached_node_ids)
+        needed: set[str] = set()
+        pending = [
+            address.node_id
+            for address in seed_addresses
+            if isinstance(address, NodeResultAddress) and address.node_id in self.nodes
+        ]
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            if node_id not in reached:
+                raise PureResultReplayIndexError(
+                    REACHABILITY_AMBIGUOUS,
+                    f"pure node {node_id!r} is required but not known to be reached",
+                    context={"node_id": node_id},
+                )
+            needed.add(node_id)
+            pending.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+def _thaw(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _thaw(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_thaw(v) for v in value]
+    return value
+
+
+def _owned_loop_prefixes(ir: Any) -> tuple[set[str], tuple[str, ...]]:
+    owned: set[str] = set()
+    prefixes: list[str] = []
+    for node in ir.nodes.values():
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)):
+            owned.update(node.body_node_ids)
+            prefixes.append(node.node_id + ".")
+    return owned, tuple(prefixes)
+
+
+def _cyclic_node_ids(ir: Any) -> set[str]:
+    """Return nodes on a control-flow cycle (goto-style revisits)."""
+    edges: dict[str, set[str]] = {node_id: set() for node_id in ir.nodes}
+    for node in ir.nodes.values():
+        targets = [node.fallthrough_node_id]
+        targets.extend(t.target_node_id for t in node.routed_transfers.values())
+        for target in targets:
+            if target in edges:
+                edges[node.node_id].add(target)
+    cyclic: set[str] = set()
+    for start in edges:
+        stack = list(edges[start])
+        seen: set[str] = set()
+        while stack:
+            current = stack.pop()
+            if current == start:
+                cyclic.add(start)
+                break
+            if current in seen:
+                continue
+            seen.add(current)
+            stack.extend(edges[current])
+    return cyclic
+
+
+def _propagate_pure_ineligibility(
+    reasons: dict[str, str],
+    pure_node_ids: Iterable[str],
+    cyclic_node_ids: set[str],
+) -> None:
+    """Mark pure nodes on a control-flow cycle as multiply visited (first reason wins)."""
+    for node_id in pure_node_ids:
+        if node_id in cyclic_node_ids:
+            reasons.setdefault(node_id, MULTIPLE_VISIT_REGION)
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, Mapping) and set(doc) == {"ref"} and isinstance(doc["ref"], str) and bool(doc["ref"])
+
+
+def _descriptor_field_names(desc: Mapping[str, Any]) -> set[str]:
+    kind = desc.get("kind")
+    if kind in {"record", "variant_case"}:
+        return {f["name"] for f in desc.get("fields", ())}
+    if kind == "union":
+        return {f["name"] for v in desc.get("variants", ()) for f in v.get("fields", ())} | {"variant"}
+    return set()
+
+
+def _walk_binding_doc(
+    doc: Any,
+    desc: Mapping[str, Any],
+    path: str,
+    refs: list[tuple[str, str, Mapping[str, Any]]],
+) -> None:
+    """Collect exact ref leaves; type-check every literal subtree against ``desc``."""
+    if isinstance(doc, Mapping) and "ref" in doc and "ref" not in _descriptor_field_names(desc):
+        if not _is_exact_ref(doc):
+            raise _invalid("malformed ref object in binding document", path=path)
+        refs.append((path, doc["ref"], desc))
+        return
+    kind = desc.get("kind")
+    if kind == "optional":
+        if doc is not None:
+            _walk_binding_doc(doc, desc["item"], path, refs)
+        return
+    if kind == "list":
+        if not isinstance(doc, (list, tuple)):
+            raise _invalid("list binding literal is not a list", path=path)
+        for index, item in enumerate(doc):
+            _walk_binding_doc(item, desc["item"], f"{path}[{index}]", refs)
+        return
+    if kind == "map":
+        if not isinstance(doc, Mapping):
+            raise _invalid("map binding literal is not a mapping", path=path)
+        for key, item in doc.items():
+            _check_leaf(key, desc["key"], f"{path}.{key}")
+            _walk_binding_doc(item, desc["value"], f"{path}.{key}", refs)
+        return
+    if kind in {"record", "union", "variant_case"}:
+        _walk_composite(doc, desc, path, refs)
+        return
+    _check_leaf(doc, desc, path)
+
+
+def _walk_composite(
+    doc: Any, desc: Mapping[str, Any], path: str, refs: list[tuple[str, str, Mapping[str, Any]]]
+) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("composite binding literal is not a mapping", path=path)
+    kind = desc["kind"]
+    if kind == "record":
+        field_types = {f["name"]: f["type"] for f in desc["fields"]}
+        if set(doc) != set(field_types):
+            raise _invalid("record binding literal fields do not match its type", path=path)
+    else:
+        variants = desc["variants"] if kind == "union" else (desc,)
+        # Union literals carry every member, including inactive variants' fields.
+        field_types = {f["name"]: f["type"] for v in variants for f in v["fields"]}
+        extra = set(doc) - set(field_types) - {"variant"}
+        if extra:
+            raise _invalid("union binding literal has unknown members", path=path)
+        names = {v["name"] if kind == "union" else v["variant"] for v in variants}
+        variant = doc.get("variant")
+        if isinstance(variant, Mapping) and _is_exact_ref(variant):
+            refs.append((f"{path}.variant", variant["ref"], _STRING_TYPE))
+        elif variant not in names:
+            raise _invalid("union binding literal names an unknown variant", path=path)
+    for name, item in doc.items():
+        if name == "variant" and kind != "record":
+            continue
+        _walk_binding_doc(item, field_types[name], f"{path}.{name}", refs)
+
+
+def _check_leaf(value: Any, desc: Mapping[str, Any], path: str) -> None:
+    if isinstance(value, str) and "${" in value:
+        raise _invalid("binding literal contains unbound text", path=path)
+    try:
+        _coerce_value(value, desc, context=path)
+    except PureExprEvaluationError as exc:
+        raise _invalid(f"binding literal does not match its type: {exc}", path=path) from exc
+
+
+class _RefResolver:
+    """Resolve ref strings to typed addresses inside one bundle."""
+
+    def __init__(self, ir: Any) -> None:
+        self.ir = ir
+        self.by_name: dict[str, list[str]] = {}
+        for node in ir.nodes.values():
+            self.by_name.setdefault(node.presentation_name, []).append(node.node_id)
+
+    def resolve(self, ref: str, *, node_id: str) -> BoundAddress:
+        if ref.startswith("inputs."):
+            name = ref[len("inputs."):]
+            if not name or name not in self.ir.inputs:
+                raise _invalid("ref names an unknown workflow input", ref=ref, node_id=node_id)
+            return WorkflowInputAddress(input_name=name)
+        scope, sep, rest = ref.partition(".steps.")
+        if not sep or scope not in {"root", "self", "parent"}:
+            raise _invalid("ref is not a supported address", ref=ref, node_id=node_id)
+        for name in sorted(self.by_name, key=len, reverse=True):
+            if rest.startswith(name + "."):
+                tail = rest[len(name) + 1:]
+                break
+        else:
+            raise _invalid("ref targets a step outside this workflow scope", ref=ref, node_id=node_id)
+        if len(self.by_name[name]) != 1:
+            raise _invalid("ref step name is ambiguous", ref=ref, node_id=node_id)
+        target = self.ir.nodes[self.by_name[name][0]]
+        field_name, _, member = tail.partition(".")
+        if field_name == "artifacts" and member:
+            if isinstance(target, (IfJoinNode, MatchJoinNode)):
+                return BlockOutputAddress(node_id=target.node_id, output_name=member)
+            if isinstance(target, RepeatUntilFrameNode):
+                return LoopOutputAddress(node_id=target.node_id, output_name=member)
+            if isinstance(target, CallBoundaryNode):
+                return CallOutputAddress(node_id=target.node_id, output_name=member)
+        return NodeResultAddress(node_id=target.node_id, field=field_name, member=member or None)
+
+
+def _address_node_id(address: BoundAddress) -> Optional[str]:
+    return None if isinstance(address, WorkflowInputAddress) else address.node_id
+
+
+def _build_node(
+    node: Any, entry: Any, resolver: _RefResolver, candidates: set[str]
+) -> PureReplayNode:
+    config = node.execution_config
+    spec = _thaw(config.pure_projection)
+    payload = spec.get("payload")
+    binding_refs = spec.get("binding_refs")
+    contracts = spec.get("output_contracts")
+    if not (
+        isinstance(payload, dict)
+        and isinstance(binding_refs, dict)
+        and isinstance(contracts, dict)
+        and isinstance(payload.get("bindings"), dict)
+    ):
+        raise _invalid("pure projection config is malformed", node_id=node.node_id)
+    declared = payload["bindings"]
+    if set(binding_refs) - set(declared):
+        raise _invalid("binding refs name undeclared bindings", node_id=node.node_id)
+    bindings: list[PureReplayBinding] = []
+    for name, binding_spec in declared.items():
+        if name not in binding_refs:
+            if "value" not in binding_spec:
+                raise _invalid("declared binding has no ref or value", node_id=node.node_id, binding=name)
+            continue
+        refs: list[tuple[str, str, Mapping[str, Any]]] = []
+        _walk_binding_doc(binding_refs[name], binding_spec["type"], name, refs)
+        bindings.extend(
+            PureReplayBinding(path, resolver.resolve(ref, node_id=node.node_id), desc)
+            for path, ref, desc in refs
+        )
+    pure_deps: list[str] = []
+    durable_deps: list[str] = []
+    for binding in bindings:
+        target = _address_node_id(binding.address)
+        if target is None:
+            continue
+        bucket = pure_deps if target in candidates else durable_deps
+        if target not in bucket:
+            bucket.append(target)
+    outputs = tuple(
+        NodeResultAddress(node_id=node.node_id, field="artifacts", member=name)
+        for name in contracts
+    )
+    return PureReplayNode(
+        node_id=node.node_id,
+        step_id=node.step_id,
+        presentation_key=entry.presentation_key,
+        bindings=tuple(bindings),
+        output_addresses=outputs,
+        output_contracts=MappingProxyType(contracts),
+        pure_dependency_node_ids=tuple(pure_deps),
+        durable_dependency_node_ids=tuple(durable_deps),
+    )
+
+
+def _check_projection(bundle: Any, node: Any) -> Any:
+    projection = bundle.projection
+    entry = projection.entries_by_node_id.get(node.node_id)
+    if entry is None:
+        raise _invalid("pure node has no projection authority", node_id=node.node_id)
+    plan_node = bundle.runtime_plan.nodes.get(node.node_id)
+    owners = [
+        other.node_id
+        for other in bundle.ir.nodes.values()
+        if other.step_id == node.step_id
+    ]
+    if len(owners) != 1 or projection.node_id_by_step_id.get(node.step_id) not in {None, node.node_id}:
+        raise _invalid("duplicate projection authority for step id", node_id=node.node_id)
+    if entry.step_id != node.step_id or (
+        plan_node is not None
+        and (plan_node.step_id != node.step_id or plan_node.presentation_key != entry.presentation_key)
+    ):
+        raise _invalid("projection identity mismatch", node_id=node.node_id)
+    return entry
+
+
+def _topological_order(nodes: Mapping[str, PureReplayNode], order: list[str]) -> tuple[str, ...]:
+    ranked = sorted(nodes, key=lambda n: order.index(n) if n in order else len(order))
+    result: list[str] = []
+    state: dict[str, int] = {}
+
+    def visit(node_id: str, chain: tuple[str, ...]) -> None:
+        if state.get(node_id) == 2:
+            return
+        if state.get(node_id) == 1:
+            raise _invalid("pure dependency cycle", cycle=list(chain) + [node_id])
+        state[node_id] = 1
+        for dep in nodes[node_id].pure_dependency_node_ids:
+            visit(dep, chain + (node_id,))
+        state[node_id] = 2
+        result.append(node_id)
+
+    for node_id in ranked:
+        visit(node_id, ())
+    return tuple(result)
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = ROOT_SCOPE) -> PureResultReplayIndex:
+    """Derive the replay index for one bundle's own nodes without mutating it."""
+    if scope_kind != ROOT_SCOPE:
+        raise PureResultReplayIndexError(
+            DEPENDENCY_INDEX_INVALID,
+            "scope_kind does not match the bundle's scope",
+            context={"expected_scope": scope_kind, "actual_scope": ROOT_SCOPE},
+        )
+    ir = bundle.ir
+    pure_nodes = {
+        node_id: node
+        for node_id, node in ir.nodes.items()
+        if node.kind is ExecutableNodeKind.PURE_PROJECTION
+        and isinstance(node.execution_config, PureProjectionStepConfig)
+    }
+    reasons: dict[str, str] = {}
+    if bundle.provenance.frontend_kind != "workflow_lisp":
+        reasons = {node_id: _NOT_COMPILER_GENERATED for node_id in pure_nodes}
+        return PureResultReplayIndex(ROOT_SCOPE, MappingProxyType({}), (), MappingProxyType(reasons))
+    owned, prefixes = _owned_loop_prefixes(ir)
+    cyclic = _cyclic_node_ids(ir)
+    for node_id in pure_nodes:
+        if node_id in owned or node_id.startswith(prefixes):
+            reasons[node_id] = _LOOP_OWNED
+    _propagate_pure_ineligibility(reasons, pure_nodes, cyclic)
+    candidates = {node_id for node_id in pure_nodes if node_id not in reasons}
+    resolver = _RefResolver(ir)
+    built: dict[str, PureReplayNode] = {}
+    for node_id in candidates:
+        entry = _check_projection(bundle, pure_nodes[node_id])
+        built[node_id] = _build_node(pure_nodes[node_id], entry, resolver, candidates)
+    order = list(bundle.runtime_plan.ordered_node_ids) + [
+        n for n in ir.nodes if n not in bundle.runtime_plan.ordered_node_ids
+    ]
+    topo = _topological_order(built, order)
+    return PureResultReplayIndex(
+        ROOT_SCOPE,
+        MappingProxyType(built),
+        topo,
+        MappingProxyType(reasons),
+    )

@@ -0,0 +1,268 @@
+"""Eligibility, dependency index and value-free replay of pure projections."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from pathlib import Path
+from types import MappingProxyType
+
+import pytest
+
+from orchestrator.workflow.executable_ir import NodeResultAddress, WorkflowInputAddress
+from orchestrator.workflow.pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.test_workflow_lisp_pure_projection_runtime import _compile_pure_projection_bundle
+
+
+@pytest.fixture()
+def bundle(tmp_path: Path):
+    return _compile_pure_projection_bundle(tmp_path)
+
+
+def _only(bundle):
+    (node_id,) = [n for n in bundle.ir.nodes]
+    return node_id, bundle.ir.nodes[node_id]
+
+
+def _with_refs(bundle, binding_refs, *, binding_types=None):
+    node_id, node = _only(bundle)
+    projection = dict(node.execution_config.pure_projection)
+    projection["binding_refs"] = binding_refs
+    if binding_types is not None:
+        payload = {k: v for k, v in projection["payload"].items()}
+        payload["bindings"] = {k: {"type": t} for k, t in binding_types.items()}
+        projection["payload"] = payload
+    config = replace(node.execution_config, pure_projection=MappingProxyType(projection))
+    nodes = {node_id: replace(node, execution_config=config)}
+    return replace(bundle, ir=replace(bundle.ir, nodes=MappingProxyType(nodes)))
+
+
+def _clone(bundle, suffix, binding_refs, binding_types):
+    """Add a second pure node whose bindings reference the first node."""
+    node_id, node = _only(bundle)
+    new_id = f"{node_id}_{suffix}"
+    plan = bundle.runtime_plan.nodes[node_id]
+    entry = bundle.projection.entries_by_node_id[node_id]
+    new_key = f"{plan.presentation_key}_{suffix}"
+    projection = dict(node.execution_config.pure_projection)
+    projection["binding_refs"] = binding_refs
+    payload = dict(projection["payload"])
+    payload["bindings"] = {k: {"type": t} for k, t in binding_types.items()}
+    projection["payload"] = payload
+    config = replace(node.execution_config, pure_projection=MappingProxyType(projection))
+    new_node = replace(node, node_id=new_id, step_id=new_id, presentation_name=new_key, execution_config=config)
+    new_plan = replace(plan, node_id=new_id, step_id=new_id, presentation_key=new_key, execution_index=1)
+    new_entry = replace(entry, node_id=new_id, step_id=new_id, presentation_key=new_key, compatibility_index=1)
+    projection_view = replace(
+        bundle.projection,
+        entries_by_node_id={**bundle.projection.entries_by_node_id, new_id: new_entry},
+        node_id_by_step_id={**bundle.projection.node_id_by_step_id, new_id: new_id},
+    )
+    runtime_plan = replace(
+        bundle.runtime_plan,
+        ordered_node_ids=(node_id, new_id),
+        nodes=MappingProxyType({**bundle.runtime_plan.nodes, new_id: new_plan}),
+    )
+    ir = replace(bundle.ir, nodes=MappingProxyType({**bundle.ir.nodes, new_id: new_node}))
+    return replace(bundle, ir=ir, projection=projection_view, runtime_plan=runtime_plan), new_id
+
+
+STRING = {"kind": "primitive", "name": "String"}
+
+
+def _rewire(bundle, node_id, binding_refs):
+    node = bundle.ir.nodes[node_id]
+    projection = {**node.execution_config.pure_projection, "binding_refs": binding_refs}
+    payload = dict(projection["payload"])
+    payload["bindings"] = {k: {"type": STRING} for k in binding_refs}
+    projection["payload"] = payload
+    config = replace(node.execution_config, pure_projection=MappingProxyType(projection))
+    nodes = {**bundle.ir.nodes, node_id: replace(node, execution_config=config)}
+    return replace(bundle, ir=replace(bundle.ir, nodes=MappingProxyType(nodes)))
+
+
+def test_single_pure_node_is_eligible_with_typed_input_bindings(bundle) -> None:
+    index = derive_pure_result_replay_index(bundle)
+    node_id, _ = _only(bundle)
+    node = index.nodes[node_id]
+    assert index.scope_kind == "root"
+    assert index.topological_node_ids == (node_id,)
+    assert index.ineligible_pure_reasons == {}
+    assert [(b.path, b.address) for b in node.bindings] == [
+        ("status", WorkflowInputAddress("status")),
+        ("approved", WorkflowInputAddress("approved")),
+    ]
+    assert node.pure_dependency_node_ids == () and node.durable_dependency_node_ids == ()
+    assert node.output_addresses == (
+        NodeResultAddress(node_id, "artifacts", "return__status"),
+        NodeResultAddress(node_id, "artifacts", "return__ready"),
+    )
+
+
+def test_scope_kind_must_match_bundle_scope(bundle) -> None:
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(bundle, scope_kind="call_frame")
+    assert info.value.reason == DEPENDENCY_INDEX_INVALID
+    assert info.value.context["expected_scope"] == "call_frame"
+    assert info.value.context["actual_scope"] == "root"
+
+
+def test_literal_leaf_and_exact_refs_form_edges(bundle) -> None:
+    changed = _with_refs(
+        bundle,
+        {"status": "WAIT", "approved": {"ref": "inputs.approved"}},
+    )
+    node = next(iter(derive_pure_result_replay_index(changed).nodes.values()))
+    assert [b.path for b in node.bindings] == ["approved"]
+
+
+@pytest.mark.parametrize(
+    "refs",
+    [
+        {"status": 5, "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": 3}, "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": "inputs.status", "extra": 1}, "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": "inputs.missing"}, "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": "root.steps.nowhere.artifacts.x"}, "approved": {"ref": "inputs.approved"}},
+        {"status": {"ref": "${inputs.status}"}, "approved": {"ref": "inputs.approved"}},
+    ],
+)
+def test_bad_binding_documents_fail(bundle, refs) -> None:
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(_with_refs(bundle, refs))
+    assert info.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+def test_union_literal_inactive_members_must_be_typed(bundle) -> None:
+    union = {
+        "kind": "union",
+        "name": "U",
+        "variants": [
+            {"name": "A", "fields": [{"name": "a", "type": STRING}]},
+            {"name": "B", "fields": [{"name": "b", "type": {"kind": "primitive", "name": "Int"}}]},
+        ],
+    }
+    types = {"u": union}
+    good = _with_refs(bundle, {"u": {"variant": "A", "a": "x"}}, binding_types=types)
+    derive_pure_result_replay_index(good)
+    bad = _with_refs(bundle, {"u": {"variant": "A", "a": "x", "b": "not-an-int"}}, binding_types=types)
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(bad)
+    assert info.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+def _chained(bundle):
+    first, _ = _only(bundle)
+    key = bundle.runtime_plan.nodes[first].presentation_key
+    ref = {"ref": f"root.steps.{key}.artifacts.return__status"}
+    return first, *_clone(bundle, "second", {"status": ref}, {"status": STRING})
+
+
+def test_pure_chain_dependencies_and_required_nodes(bundle) -> None:
+    first, chained, second = _chained(bundle)
+    index = derive_pure_result_replay_index(chained)
+    assert index.topological_node_ids == (first, second)
+    assert index.nodes[second].pure_dependency_node_ids == (first,)
+    seeds = index.nodes[second].output_addresses
+    assert index.required_pure_node_ids(seeds, reached_node_ids={first, second}) == (first, second)
+    assert index.required_pure_node_ids([], reached_node_ids={first, second}) == ()
+    assert index.required_pure_node_ids(seeds, reached_node_ids={first}) == ()
+    with pytest.raises(PureResultReplayIndexError) as info:
+        index.required_pure_node_ids(seeds, reached_node_ids={second})
+    assert info.value.reason == "reachability_ambiguous"
+
+
+def test_pure_dependency_cycle_is_invalid(bundle) -> None:
+    first, chained, second = _chained(bundle)
+    key = chained.runtime_plan.nodes[second].presentation_key
+    cyclic = _rewire(chained, first, {"status": {"ref": f"root.steps.{key}.artifacts.return__status"}})
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(cyclic)
+    assert info.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+def test_duplicate_projection_authority_is_invalid(bundle) -> None:
+    first, chained, second = _chained(bundle)
+    dup_key = chained.runtime_plan.nodes[first].presentation_key
+    plan = chained.runtime_plan
+    clashing = replace(
+        chained,
+        runtime_plan=replace(
+            plan,
+            nodes=MappingProxyType({**plan.nodes, second: replace(plan.nodes[second], presentation_key=dup_key)}),
+        ),
+        projection=replace(
+            chained.projection,
+            entries_by_node_id={
+                **chained.projection.entries_by_node_id,
+                second: replace(chained.projection.entries_by_node_id[second], presentation_key=dup_key),
+            },
+        ),
+    )
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(clashing)
+    assert info.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+def test_projection_identity_mismatch_is_invalid(bundle) -> None:
+    node_id, _ = _only(bundle)
+    entry = bundle.projection.entries_by_node_id[node_id]
+    skewed = replace(
+        bundle,
+        projection=replace(
+            bundle.projection,
+            entries_by_node_id={node_id: replace(entry, presentation_key="somewhere else")},
+        ),
+    )
+    with pytest.raises(PureResultReplayIndexError) as info:
+        derive_pure_result_replay_index(skewed)
+    assert info.value.reason == DEPENDENCY_INDEX_INVALID
+
+
+def test_recurrent_pure_nodes_are_ineligible(tmp_path: Path) -> None:
+    from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+    from tests.test_workflow_lisp_pure_projection_runtime import PURE_EXPR_LOOP_COUNTER, VALID_FIXTURES
+
+    result = compile_stage3_entrypoint(
+        PURE_EXPR_LOOP_COUNTER,
+        source_roots=(VALID_FIXTURES,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    loop_bundle = next(iter(result.validated_bundles_by_name.values()))
+    index = derive_pure_result_replay_index(loop_bundle)
+    assert index.nodes == {}
+    assert set(index.ineligible_pure_reasons.values()) == {MULTIPLE_VISIT_REGION}
+
+

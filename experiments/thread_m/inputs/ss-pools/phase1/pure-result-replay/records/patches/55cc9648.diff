@@ -0,0 +1,116 @@
+"""Default resume with replay-eligible pure points filtered from durable boundaries."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from orchestrator.workflow.pure_result_replay import PureReplayRuntime, build_pure_completion_shell
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.lexical_checkpoint_default_resume import (
+    determine_runtime_default_resume_decision,
+)
+from tests.test_workflow_lisp_pure_projection_runtime import _compile_pure_projection_bundle
+
+RESTART = "root.after"
+DURABLE = "root.durable"
+
+
+@pytest.fixture()
+def bundle(tmp_path: Path):
+    return _compile_pure_projection_bundle(tmp_path)
+
+
+def _point(checkpoint_id: str, node_id: str):
+    return SimpleNamespace(
+        checkpoint_id=checkpoint_id, node_id=node_id, point_kind="effect_boundary", details={}, origin_key="o"
+    )
+
+
+def _plan(bundle, *, durable: bool):
+    pure_id = next(iter(bundle.ir.nodes))
+    order = [pure_id, DURABLE, RESTART] if durable else [pure_id, RESTART]
+    points = [_point("ckpt:pure", pure_id), _point("ckpt:restart", RESTART)]
+    if durable:
+        points.insert(1, _point("ckpt:durable", DURABLE))
+    return SimpleNamespace(
+        workflow_name="wf::run",
+        ordered_node_ids=tuple(order),
+        lexical_checkpoint_points=tuple(points),
+        nodes={},
+    ), pure_id
+
+
+def _state(bundle, *, profiled=True, **overrides):
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("wf.orc"))
+    node = next(iter(runtime.index.nodes.values()))
+    state = {
+        "workflow_file": "wf.orc",
+        "context": {"workflow_lisp": {"lowering_schema_version": 2}},
+        "bound_inputs": {"status": "WAIT", "approved": False},
+        "step_visits": {node.presentation_key: 1},
+        "steps": {node.presentation_key: build_pure_completion_shell(runtime.witness(node.node_id))},
+        "current_step": None,
+    }
+    if profiled:
+        state["result_persistence_profile"] = "derived_pure_replay.v1"
+    state.update(overrides)
+    return state
+
+
+def _selector(restorable_checkpoints=()):
+    def select(**kwargs):
+        checkpoint_id = kwargs.get("checkpoint_id")
+        if checkpoint_id in restorable_checkpoints:
+            return SimpleNamespace(kind="RESTORED", checkpoint_id=checkpoint_id, record_id="rec", diagnostics=(), selection_observation=None)
+        return SimpleNamespace(kind="NOT_RESTORABLE", checkpoint_id=None, record_id=None, diagnostics=(), selection_observation="record_absent")
+
+    return select
+
+
+def _decide(bundle, plan, state, selector):
+    return determine_runtime_default_resume_decision(
+        state=state,
+        runtime_plan=plan,
+        restart_node_id=RESTART,
+        restore_selector=selector,
+        loaded_workflow=bundle,
+        is_workflow_lisp=True,
+    )
+
+
+def test_zero_record_resume_replays_from_validated_frame_entry(bundle) -> None:
+    plan, _ = _plan(bundle, durable=False)
+    decision = _decide(bundle, plan, _state(bundle), _selector())
+    assert decision["restore_decision"] == "VALIDATED_FRAME_ENTRY_REPLAY"
+    assert decision["mode"] == "LEXICAL_CHECKPOINT_DEFAULT"
+    assert decision["checkpoint_id"] is None
+    assert decision["selection_reason"] == "validated_frame_entry_replay"
+
+
+def test_zero_record_resume_requires_valid_leaves_and_profile(bundle) -> None:
+    plan, _ = _plan(bundle, durable=False)
+    broken = _state(bundle, bound_inputs={"approved": False})
+    decision = _decide(bundle, plan, broken, _selector())
+    assert decision["mode"] == "FAIL_CLOSED"
+    assert decision["diagnostics"] == ["lexical_default_resume_prior_boundary_not_restorable"]
+    unprofiled = _decide(bundle, plan, _state(bundle, profiled=False), _selector())
+    assert unprofiled["mode"] == "FAIL_CLOSED"
+    assert unprofiled["restore_decision"] != "VALIDATED_FRAME_ENTRY_REPLAY"
+
+
+def test_restorable_nearest_durable_boundary_is_used(bundle) -> None:
+    plan, _ = _plan(bundle, durable=True)
+    decision = _decide(bundle, plan, _state(bundle), _selector({"ckpt:durable"}))
+    assert decision["mode"] == "LEXICAL_CHECKPOINT_DEFAULT"
+    assert decision["selection_reason"] == "validated_prior_boundary"
+    assert decision["checkpoint_id"] == "ckpt:durable"
+
+
+def test_filtering_never_scans_past_an_invalid_nearest_boundary(bundle) -> None:
+    plan, _ = _plan(bundle, durable=True)
+    decision = _decide(bundle, plan, _state(bundle), _selector())
+    assert decision["mode"] == "FAIL_CLOSED"
+    assert decision["diagnostics"][0] == "lexical_default_resume_prior_boundary_not_restorable"

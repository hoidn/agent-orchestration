+"""End-to-end resume behaviour under the derived_pure_replay.v1 profile."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.loaded_bundle import workflow_runtime_input_contracts
+from orchestrator.workflow.pure_result_replay import PureResultReplayIndexError
+from orchestrator.workflow.resume_planner import ResumePlanner
+from orchestrator.workflow.signatures import bind_workflow_inputs
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.wcc.route import workflow_lisp_context_with_lowering_schema
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+PROFILE = "derived_pure_replay.v1"
+PURE_KEY = "pure_replay_e2e::run__condition"
+PROBE_KEY = "pure_replay_e2e::run__probe__probe_step"
+SOURCE = """(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.15")
+  (defmodule pure_replay_e2e)
+  (export run)
+  (defworkflow run
+    ((status String))
+    -> Bool
+    (let* ((probe
+             (command-result probe_step
+               :argv ("python" "scripts/probe_step.py")
+               :returns Bool))
+           (flag (and probe (= status "WAIT"))))
+      (if flag
+          (command-result finish_step
+            :argv ("python" "scripts/finish_step.py")
+            :returns Bool)
+          (command-result other_step
+            :argv ("python" "scripts/other_step.py")
+            :returns Bool)))))
+"""
+
+
+def _write_scripts(workspace: Path) -> None:
+    scripts = workspace / "scripts"
+    scripts.mkdir()
+    for name, value in (("probe_step", "true"), ("finish_step", "true"), ("other_step", "false")):
+        (scripts / f"{name}.py").write_text(
+            "import os, pathlib\n"
+            f'pathlib.Path("{name}.count").open("a").write("x")\n'
+            'bundle = pathlib.Path(os.environ["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])\n'
+            "bundle.parent.mkdir(parents=True, exist_ok=True)\n"
+            f'bundle.write_text("{value}\\n", encoding="utf-8")\n',
+            encoding="utf-8",
+        )
+
+
+def _run(workspace: Path, *, profile: str | None, source_text: str = SOURCE):
+    _write_scripts(workspace)
+    source = workspace / "pure_replay_e2e.orc"
+    source.write_text(source_text, encoding="utf-8")
+    result = compile_stage3_entrypoint(
+        source,
+        source_roots=(workspace,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={
+            name: ExternalToolBinding(name=name, stable_command=("python", f"scripts/{name}.py"))
+            for name in ("probe_step", "finish_step", "other_step")
+        },
+        validate_shared=True,
+        workspace_root=workspace,
+    )
+    bundle = result.validated_bundles_by_name["pure_replay_e2e::run"]
+    inputs = {
+        name: contract
+        for name, contract in dict(workflow_runtime_input_contracts(bundle)).items()
+        if not name.startswith("__write_root__")
+    }
+    manager = StateManager(workspace=workspace, run_id="pure-e2e")
+    manager.initialize(
+        str(source),
+        context=workflow_lisp_context_with_lowering_schema(bundle_context_dict(bundle), 2),
+        bound_inputs=bind_workflow_inputs(inputs, {"status": "WAIT"}, workspace),
+        result_persistence_profile=profile,
+    )
+    final = WorkflowExecutor(bundle, workspace, manager).execute()
+    return bundle, manager, final
+
+
+def _interrupt_after_condition(manager: StateManager) -> None:
+    """Rewind to the moment the branch effect had not yet committed."""
+    with manager.state_transaction() as state:
+        state.status = "running"
+        state.workflow_outputs = {}
+        for key in list(state.steps):
+            if key not in (PROBE_KEY, PURE_KEY):
+                del state.steps[key]
+                state.step_visits.pop(key, None)
+        state.transition_count = 0
+
+
+def _counts(workspace: Path) -> dict[str, str]:
+    return {p.name: p.read_text() for p in workspace.glob("*.count")}
+
+
+@pytest.fixture()
+def profiled(tmp_path: Path):
+    return (*_run(tmp_path, profile=PROFILE), tmp_path)
+
+
+def test_profiled_run_leaves_value_free_pure_state(profiled) -> None:
+    bundle, manager, final, workspace = profiled
+    on_disk = json.loads(manager.state_file.read_text())
+    assert final["workflow_outputs"] == {"__result__": True}
+    assert on_disk["result_persistence_profile"] == PROFILE
+    assert set(on_disk["steps"][PURE_KEY]) == {
+        "name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage",
+    }
+    assert on_disk["private_artifact_versions"] == {}
+    assert not [p for p in workspace.rglob("*condition*result_bundle*")]
+    assert "artifacts" in on_disk["steps"][PROBE_KEY]
+
+
+def test_resume_replays_pure_value_and_calls_no_committed_effect_again(profiled) -> None:
+    bundle, manager, _final, workspace = profiled
+    _interrupt_after_condition(manager)
+    resumed = WorkflowExecutor(bundle, workspace, manager).execute(resume=True)
+    assert resumed["status"] == "completed"
+    assert resumed["workflow_outputs"] == {"__result__": True}
+    assert _counts(workspace) == {"probe_step.count": "x", "finish_step.count": "xx"}
+    assert "artifacts" not in json.loads(manager.state_file.read_text())["steps"][PURE_KEY]
+
+
+def test_resume_determines_restart_boundary_once(profiled, monkeypatch: pytest.MonkeyPatch) -> None:
+    bundle, manager, _final, workspace = profiled
+    _interrupt_after_condition(manager)
+    calls = []
+    original = ResumePlanner.determine_restart_node_id
+
+    def counting(self, *args, **kwargs):
+        calls.append(1)
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(ResumePlanner, "determine_restart_node_id", counting)
+    assert WorkflowExecutor(bundle, workspace, manager).execute(resume=True)["status"] == "completed"
+    assert len(calls) == 1
+
+
+def test_missing_bound_input_fails_before_any_effect(profiled) -> None:
+    bundle, manager, _final, workspace = profiled

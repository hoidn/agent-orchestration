+"""Profile selection for call frames and the read-only existing-frame loader."""
+
+from __future__ import annotations
+
+import json
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.call_frame_state import (
+    _CallFrameStateManager,
+    load_existing_call_frame_read_only,
+)
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.loaded_bundle import workflow_runtime_input_contracts
+from orchestrator.workflow.signatures import bind_workflow_inputs
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from tests.workflow_bundle_helpers import bundle_context_dict
+
+PROFILE = "derived_pure_replay.v1"
+MODULES = Path(__file__).parent / "fixtures" / "workflow_lisp" / "modules" / "valid"
+CONSUMER = MODULES / "pure_projection_boundary_decision_consumer"
+
+
+def _run_consumer(tmp_path: Path, *, profile: str | None):
+    entry = CONSUMER / "pure_projection_boundary_decision_consumer" / "entry.orc"
+    result = compile_stage3_entrypoint(
+        entry,
+        source_roots=(CONSUMER,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    bundle = result.validated_bundles_by_name["pure_projection_boundary_decision_consumer/entry::run"]
+    inputs = {
+        n: c
+        for n, c in dict(workflow_runtime_input_contracts(bundle)).items()
+        if not n.startswith("__write_root__")
+    }
+    manager = StateManager(workspace=tmp_path, run_id="frames")
+    manager.initialize(
+        entry.as_posix(),
+        context=bundle_context_dict(bundle),
+        bound_inputs=bind_workflow_inputs(inputs, {"bundle_path": "state/s.json", "reason": "gap"}, tmp_path),
+        result_persistence_profile=profile,
+    )
+    final = WorkflowExecutor(bundle, tmp_path, manager, retry_delay_ms=0).execute(on_error="stop")
+    return final, json.loads(manager.state_file.read_text())
+
+
+@pytest.mark.parametrize("root_profile", [None, PROFILE])
+def test_workflow_lisp_callee_frames_select_profile_from_callee_provenance(tmp_path: Path, root_profile) -> None:
+    final, persisted = _run_consumer(tmp_path, profile=root_profile)
+    assert final["status"] == "completed"
+    assert persisted.get("result_persistence_profile") == root_profile
+    frames = persisted["call_frames"].values()
+    assert frames
+    for frame in frames:
+        state = frame["state"]
+        assert state["result_persistence_profile"] == PROFILE
+        pure_rows = [row for row in state["steps"].values() if row.get("result_storage")]
+        assert pure_rows and all("artifacts" not in row for row in pure_rows)
+    assert final["workflow_outputs"] == {
+        "return__selected_path": "state/s.json",
+        "return__path_detail": "READY",
+        "return__shared_detail": "gap-computed",
+    }
+
+
+def test_existing_frames_are_never_backfilled(tmp_path: Path) -> None:
+    _final, persisted = _run_consumer(tmp_path, profile=None)
+    frame = next(iter(persisted["call_frames"].values()))
+    legacy = deepcopy(frame)
+    legacy["state"].pop("result_persistence_profile")
+    manager = StateManager(workspace=tmp_path / "other", run_id="legacy")
+    (tmp_path / "other").mkdir()
+    (tmp_path / "other" / "wf.orc").write_text("x")
+    manager.initialize("wf.orc")
+    resumed = _CallFrameStateManager(
+        parent_manager=manager,
+        workflow=None,
+        frame_id="f",
+        call_step_name="n",
+        call_step_id="i",
+        import_alias="a",
+        bound_inputs={},
+        existing_frame=legacy,
+    )
+    assert resumed.state.result_persistence_profile is None
+    assert "result_persistence_profile" not in manager.state.call_frames["f"]["state"]
+
+
+def test_read_only_loader_returns_detached_copy_without_writes(tmp_path: Path) -> None:
+    frame = {"state": {
+        "schema_version": "2.1", "run_id": "r", "workflow_file": "w", "workflow_checksum": "c",
+        "started_at": "t", "updated_at": "t", "status": "running", "steps": {"a": {"status": "completed"}},
+        "result_persistence_profile": PROFILE,
+    }}
+    before = deepcopy(frame)
+    loaded = load_existing_call_frame_read_only(frame)
+    loaded.steps["a"]["status"] = "mutated"
+    assert frame == before
+    assert loaded.result_persistence_profile == PROFILE
+    assert list(tmp_path.iterdir()) == []
+
+
+@pytest.mark.parametrize("frame", [{}, {"state": None}, {"state": "x"}, {"state": ["x"]}])
+def test_malformed_existing_frame_is_rejected_before_any_write(tmp_path: Path, frame) -> None:
+    (tmp_path / "wf.orc").write_text("x")
+    parent = StateManager(workspace=tmp_path, run_id="parent")
+    parent.initialize("wf.orc")
+    before = parent.state_file.read_bytes()
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        load_existing_call_frame_read_only(frame)
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        _CallFrameStateManager(
+            parent_manager=parent, workflow=None, frame_id="f", call_step_name="n",
+            call_step_id="i", import_alias="a", bound_inputs={}, existing_frame=frame,
+        )
+    assert parent.state_file.read_bytes() == before
+    assert not (parent.run_root / "call_frames").exists()

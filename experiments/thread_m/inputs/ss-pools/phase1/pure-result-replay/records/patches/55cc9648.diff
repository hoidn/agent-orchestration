+"""PureReplayRuntime: cache revalidation, union rows, error mapping, surface audits."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from pathlib import Path
+from types import MappingProxyType, SimpleNamespace
+
+import pytest
+
+from orchestrator.workflow.executable_ir import NodeResultAddress, WorkflowInputAddress
+from orchestrator.workflow.pure_replay_runtime import expected_output_names
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+)
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.test_workflow_lisp_pure_projection_runtime import _compile_pure_projection_bundle
+
+
+@pytest.fixture()
+def runtime(tmp_path: Path):
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    return PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("wf.orc"))
+
+
+def _node(runtime):
+    return next(iter(runtime.index.nodes.values()))
+
+
+def _durable_state(runtime, **overrides):
+    node = _node(runtime)
+    witness = runtime.witness(node.node_id)
+    state = {
+        "bound_inputs": {"status": "WAIT", "approved": False},
+        "step_visits": {node.presentation_key: 1},
+        "steps": {node.presentation_key: build_pure_completion_shell(witness)},
+        "current_step": None,
+    }
+    state.update(overrides)
+    return state
+
+
+def _completed(**artifacts):
+    return {"status": "completed", "exit_code": 0, "artifacts": artifacts}
+
+
+GOOD = {"return__status": "WAIT", "return__ready": False}
+
+
+def test_replay_reconstructs_value_without_mutating_state(runtime) -> None:
+    node = _node(runtime)
+    state = _durable_state(runtime)
+    before = repr(state)
+    seen = []
+    row = runtime.replay_node(
+        node.node_id, state=state, evaluate_node=lambda n, overlay: seen.append(overlay) or _completed(**GOOD)
+    )
+    assert row["artifacts"] == GOOD and row["step_id"] == node.step_id
+    assert repr(state) == before and seen == [state]
+
+
+@pytest.mark.parametrize(
+    ("error", "reason", "cause"),
+    [
+        ({"type": "materialize_ref_unresolved"}, "binding_unresolved", "materialize_ref_unresolved"),
+        ({"type": "pure_expr_operand_type_mismatch"}, "evaluation_failed", "pure_evaluation_failed"),
+        (
+            {"type": "contract_violation", "context": {"reason": "pure_projection_contract_invalid"}},
+            "output_contract_invalid",
+            "pure_projection_contract_invalid",
+        ),
+    ],
+)
+def test_failed_rederivation_maps_to_reasons(runtime, error, reason, cause) -> None:
+    with pytest.raises(PureResultReplayIndexError) as info:
+        runtime.replay_node(
+            _node(runtime).node_id,
+            state=_durable_state(runtime),
+            evaluate_node=lambda n, o: {"status": "failed", "exit_code": 2, "error": error},
+        )
+    assert info.value.reason == reason
+    assert info.value.context["cause"] == {"type": cause}
+
+
+def test_cache_hit_accepts_shell_or_exact_active_result_only(runtime) -> None:
+    node = _node(runtime)
+    witness = runtime.witness(node.node_id)
+    runtime.record_full_result(node.node_id, witness=witness, result={**_completed(**GOOD), "name": node.presentation_key})
+    shell_state = _durable_state(runtime)
+    assert runtime.overlay_active_state(shell_state)["steps"][node.presentation_key]["artifacts"] == GOOD
+    active = runtime.overlay_active_state(shell_state)
+    assert runtime.replay_node(node.node_id, state=active, evaluate_node=None)["artifacts"] == GOOD
+
+    cursor = {"name": node.presentation_key, "step_id": node.step_id, "status": "running"}
+    for bad in (
+        _durable_state(runtime, current_step=cursor),
+        _durable_state(runtime, step_visits={}),
+        _durable_state(runtime, step_visits={node.presentation_key: 2}),
+        _durable_state(runtime, steps={}),
+        {**active, "steps": {node.presentation_key: {**active["steps"][node.presentation_key], "artifacts": {"x": 1}}}},
+    ):
+        with pytest.raises(PureResultReplayIndexError) as info:
+            runtime.overlay_active_state(bad)
+        assert info.value.reason == "progress_witness_invalid"
+
+
+def test_unrelated_cursor_does_not_invalidate_cached_result(runtime) -> None:
+    node = _node(runtime)
+    runtime.record_full_result(node.node_id, witness=runtime.witness(node.node_id), result=_completed(**GOOD))
+    other = {"name": "Other", "step_id": "other", "status": "running"}
+    overlay = runtime.overlay_active_state(_durable_state(runtime, current_step=other))
+    assert overlay["steps"][node.presentation_key]["artifacts"] == GOOD
+
+
+def test_union_rows_hold_discriminant_shared_and_active_member_only(runtime) -> None:
+    def contract(role, **extra):
+        return MappingProxyType({"kind": "scalar", "projection": {"projection_class": "union_workflow_boundary", "field_role": role, **extra}})
+
+    node = replace(
+        _node(runtime),
+        output_contracts=MappingProxyType(
+            {
+                "return__variant": contract("discriminant"),
+                "return__shared": contract("shared"),
+                "return__a": contract("variant", active_variants=["A"]),
+                "return__b": contract("variant", active_variants=["B"]),
+            }
+        ),
+    )
+    assert expected_output_names(node, {"return__variant": "A"}) == {"return__variant", "return__shared", "return__a"}
+    swapped = replace(runtime.index, nodes=MappingProxyType({node.node_id: node}))
+    runtime.index = swapped
+    ok = {"return__variant": "A", "return__shared": 1, "return__a": 2}
+    runtime.record_full_result(node.node_id, witness=runtime.witness(node.node_id), result=_completed(**ok))
+    for bad in ({"return__variant": "A", "return__shared": 1}, {**ok, "return__b": 3}):
+        with pytest.raises(PureResultReplayIndexError) as info:
+            runtime.record_full_result(node.node_id, witness=runtime.witness(node.node_id), result=_completed(**bad))
+        assert info.value.reason == "dependency_index_invalid"
+
+
+def test_state_addresses_resolve_inputs_rows_and_intrinsics(runtime) -> None:
+    node = _node(runtime)
+    state = _durable_state(runtime)
+    state["steps"][node.presentation_key] = {"artifacts": GOOD, "exit_code": 0, "outcome": {"status": "completed"}}
+    assert runtime.resolve_state_address(WorkflowInputAddress("status"), state) == (True, "WAIT")
+    assert runtime.resolve_state_address(WorkflowInputAddress("nope"), state) == (False, None)
+    assert runtime.value_for_state_address(NodeResultAddress(node.node_id, "artifacts", "return__ready"), state) is False
+    assert runtime.value_for_state_address(NodeResultAddress(node.node_id, "outcome", "status"), state) == "completed"
+    with pytest.raises(PureResultReplayIndexError) as info:
+        runtime.value_for_state_address(NodeResultAddress(node.node_id, "artifacts", "absent"), state)
+    assert info.value.reason == "durable_input_missing"
+
+
+def test_boundary_audit_names_missing_and_invalid_leaves(runtime) -> None:
+    node = _node(runtime)
+    state = _durable_state(runtime)
+    assert runtime.required_node_ids_for_boundary(None, state=state) == (node.node_id,)
+    runtime.audit_boundary_leaves(None, state=state)
+    for bad_inputs, reason in (
+        ({"approved": False}, "durable_input_missing"),
+        ({"status": 4, "approved": False}, "durable_input_invalid"),
+    ):
+        with pytest.raises(PureResultReplayIndexError) as info:
+            runtime.audit_boundary_leaves(None, state=_durable_state(runtime, bound_inputs=bad_inputs))
+        assert info.value.reason == reason
+
+
+def _fake_manager(records: dict):
+    return SimpleNamespace(
+        run_id="r",
+        workspace=Path("/ws"),
+        read_runtime_sidecar_json=lambda path: records.get(Path(path).name),
+    )
+
+
+def test_checkpoint_surfaces_conflict_only_within_the_same_scope(runtime, tmp_path: Path) -> None:
+    node = _node(runtime)
+    point = SimpleNamespace(checkpoint_id="ckpt:pure", step_id=node.step_id, node_id=node.node_id)
+    other = SimpleNamespace(checkpoint_id="ckpt:other", step_id="root.other", node_id="root.other")
+    plan = replace(runtime.bundle.runtime_plan, lexical_checkpoint_points=(point, other))
+    runtime.bundle = replace(runtime.bundle, runtime_plan=plan)
+
+    from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_index_path
+
+    def index_name(checkpoint_id):
+        return resolve_checkpoint_index_path(
+            state_manager=_fake_manager({}), workflow_name=plan.workflow_name, checkpoint_id=checkpoint_id
+        ).name
+
+    def audit(records):
+        runtime.audit_persisted_surfaces(
+            state=_durable_state(runtime),
+            state_manager=_fake_manager(records),
+            resolve_bundle_path=lambda n: None,
+        )
+
+    audit({})
+    from orchestrator.workflow_lisp.lexical_checkpoints import resolve_checkpoint_record_path
+
+    canonical = resolve_checkpoint_record_path(
+        state_manager=_fake_manager({}), workflow_name=plan.workflow_name,
+        checkpoint_id="ckpt:other", record_id="rec",
+    ).relative_to("/ws").as_posix()
+    entry = {"record_id": "rec", "record_path": canonical, "frame_identity": {"call_frame_id": None}}
+    with pytest.raises(PureResultReplayIndexError) as info:
+        audit({index_name("ckpt:pure"): {"records": [entry]}})
+    assert info.value.context["surface"] == "checkpoint_record"
+    audit({index_name("ckpt:pure"): {"records": [{**entry, "frame_identity": {"call_frame_id": "frame-9"}}]}})
+
+    binding = {"restore_payload": {"bindings": [{"source_step_id": node.step_id}]}}
+    with pytest.raises(PureResultReplayIndexError) as info:
+        audit({index_name("ckpt:other"): {"records": [entry]}, "rec.json": binding})
+    assert info.value.context["surface"] == "restore_payload"
+    audit({index_name("ckpt:other"): {"records": [entry]}, "rec.json": {"restore_payload": {"bindings": [{"source_step_id": "root.else"}]}}})
+
+    for bad_path in ("../escape/rec.json", "other/rec.json", 7):
+        with pytest.raises(PureResultReplayIndexError) as info:
+            audit({index_name("ckpt:other"): {"records": [{**entry, "record_path": bad_path}]}})
+        assert info.value.code == "pure_result_replay_unavailable"
+        assert info.value.context["surface"] == "checkpoint_record"
+
+
+@pytest.mark.parametrize(

+"""Resume-time reconstruction of eligible pure results from durable inputs.
+
+Replay never dispatches an effect, increments a visit, settles a result or
+writes durable state: it only builds an in-memory overlay.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from copy import deepcopy
+from pathlib import Path
+from typing import Any, Callable, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_errors import (
+    DEPENDENCY_INDEX_INVALID,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PureResultReplayIndexError,
+)
+from .pure_replay_index import (
+    PureResultReplayIndex,
+    PureResultReplayNode,
+    derive_pure_result_replay_index,
+)
+from .pure_replay_progress import (
+    DERIVED_COMPLETE,
+    DURABLE_FAILURE_SKIP,
+    PureReplayVisitWitness,
+    _is_exact_shell,
+    classify_pure_replay_progress,
+)
+from .resume_projection_integrity import ResumeScopePath
+
+DURABLE_INPUT_MISSING = "durable_input_missing"
+DURABLE_INPUT_INVALID = "durable_input_invalid"
+BINDING_UNRESOLVED = "binding_unresolved"
+EVALUATION_FAILED = "evaluation_failed"
+OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+
+_OUTCOME_TYPES = {"status": str, "phase": str, "class": str, "retryable": bool}
+_FAILURE_REASONS = {
+    "materialize_ref_unresolved": (BINDING_UNRESOLVED, "materialize_ref_unresolved"),
+    "pure_projection_contract_invalid": (OUTPUT_CONTRACT_INVALID, "pure_projection_contract_invalid"),
+}
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _iter_strings(obj: Any) -> Iterable[str]:
+    if isinstance(obj, str):
+        yield obj
+    elif isinstance(obj, Mapping):
+        for key, value in obj.items():
+            yield from _iter_strings(key)
+            yield from _iter_strings(value)
+    elif isinstance(obj, (list, tuple, set, frozenset)):
+        for item in obj:
+            yield from _iter_strings(item)
+    elif dataclasses.is_dataclass(obj) and not isinstance(obj, type):
+        for f in dataclasses.fields(obj):
+            yield from _iter_strings(getattr(obj, f.name))
+
+
+def _iter_addresses(obj: Any) -> Iterable[Any]:
+    if isinstance(obj, (NodeResultAddress, BlockOutputAddress, LoopOutputAddress, CallOutputAddress)):
+        yield obj
+    elif isinstance(obj, Mapping):
+        for value in obj.values():
+            yield from _iter_addresses(value)
+    elif isinstance(obj, (list, tuple)):
+        for item in obj:
+            yield from _iter_addresses(item)
+    elif dataclasses.is_dataclass(obj) and not isinstance(obj, type):
+        for f in dataclasses.fields(obj):
+            yield from _iter_addresses(getattr(obj, f.name))
+
+
+def _active_variant(node: PureResultReplayNode, artifacts: Mapping[str, Any]) -> Optional[str]:
+    for name, contract in node.output_contracts.items():
+        projection = contract.get("projection")
+        if isinstance(projection, Mapping) and projection.get("field_role") == "discriminant":
+            return artifacts.get(name)
+    return None
+
+
+def expected_output_names(node: PureResultReplayNode, artifacts: Mapping[str, Any]) -> set[str]:
+    """Row members that must exist: discriminant, shared and the active variant's."""
+    active = _active_variant(node, artifacts)
+    names = set()
+    for name, contract in node.output_contracts.items():
+        projection = contract.get("projection")
+        if (
+            isinstance(projection, Mapping)
+            and projection.get("projection_class") == "union_workflow_boundary"
+            and projection.get("field_role") == "variant"
+            and active not in (projection.get("active_variants") or ())
+        ):
+            continue
+        names.add(name)
+    return names
+
+
+class PureReplayRuntime:
+    """Replay state for one scope (a bundle plus its resume scope path)."""
+
+    def __init__(self, *, bundle: LoadedWorkflowBundle, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(bundle)
+        self._node_id_by_step_id = {n.step_id: n.node_id for n in self.index.nodes.values()}
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # -- identity ---------------------------------------------------------
+    def _node(self, node_id: str) -> PureResultReplayNode:
+        try:
+            return self.index.nodes[node_id]
+        except KeyError:
+            raise _error(DEPENDENCY_INDEX_INVALID, f"{node_id!r} is not a replay-eligible pure node", node_id=node_id) from None
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._node_id_by_step_id.get(step_id)
+
+    def _step_index(self, node_id: str) -> int:
+        entry = self.bundle.projection.entries_by_node_id.get(node_id)
+        if entry is not None and isinstance(entry.compatibility_index, int):
+            return entry.compatibility_index
+        return self.bundle.runtime_plan.nodes[node_id].execution_index
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        return PureReplayVisitWitness(node.presentation_key, self._step_index(node_id), node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        visits = state.get("step_visits")
+        visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+        if type(visit) is not int:
+            raise _error(PROGRESS_WITNESS_INVALID, f"{node.presentation_key!r} has no valid visit", node_id=node_id)
+        return self.witness(node_id, visit_count=visit)
+
+    # -- cache ------------------------------------------------------------
+    def _validated_row(self, node: PureResultReplayNode, result: Mapping[str, Any]) -> dict[str, Any]:
+        artifacts = result.get("artifacts")
+        if result.get("status") != "completed" or not isinstance(artifacts, Mapping):
+            raise _error(DEPENDENCY_INDEX_INVALID, "active pure result is not a completed value", node_id=node.node_id)
+        expected = expected_output_names(node, artifacts)
+        if set(artifacts) != expected:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                "pure result members do not match the active variant",
+                node_id=node.node_id,
+                missing=sorted(expected - set(artifacts)),
+                extra=sorted(set(artifacts) - expected),
+            )
+        return deepcopy(dict(result))
+
+    def record_full_result(self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]) -> None:
+        """Hold an active executor's validated full result for this process."""
+        self._cache[node_id] = (witness, self._validated_row(self._node(node_id), result))
+
+    def _check_cache_hit(self, node_id: str, state: Mapping[str, Any]) -> dict[str, Any]:
+        witness, row = self._cache[node_id]
+        cursor = state.get("current_step")
+        if isinstance(cursor, Mapping) and (
+            cursor.get("name") == witness.presentation_key or cursor.get("step_id") == witness.step_id
+        ):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure result conflicts with a live cursor", node_id=node_id)
+        visits = state.get("step_visits")
+        if not isinstance(visits, Mapping) or visits.get(witness.presentation_key) != 1 or type(visits.get(witness.presentation_key)) is not int:
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure result lacks visit one", node_id=node_id)
+        durable = (state.get("steps") or {}).get(witness.presentation_key)
+        if durable == row:
+            return row
+        probe = {**state, "current_step": None}
+        if classify_pure_replay_progress(probe, witness=witness) != DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure result does not match durable progress", node_id=node_id)
+        return row
+
+    # -- replay -----------------------------------------------------------
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureResultReplayNode, Mapping[str, Any]], Mapping[str, Any]],
+    ) -> dict[str, Any]:
+        """Return the full row for one completed eligible node.
+
+        `evaluate_node(node, overlay)` re-derives the node from the overlay and
+        returns an ordinary step result. State is not mutated.
+        """
+        node = self._node(node_id)
+        if node_id in self._cache:
+            return deepcopy(self._check_cache_hit(node_id, state))
+        witness = self.witness_from_state(node_id, state)
+        progress = classify_pure_replay_progress(state, witness=witness)
+        if progress == DURABLE_FAILURE_SKIP:
+            return deepcopy(state["steps"][node.presentation_key])
+        if progress != DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, f"{node.presentation_key!r} is {progress}, not complete", node_id=node_id)
+        result = evaluate_node(node, state)
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            raise self._failure(node, result)
+        row = self._validated_row(node, result)
+        shell = state["steps"][node.presentation_key]
+        row = {**shell, **row, "name": shell["name"], "step_id": shell["step_id"], "visit_count": 1}
+        self._cache[node_id] = (witness, row)
+        return deepcopy(row)
+
+    @staticmethod
+    def _failure(node: PureResultReplayNode, result: Any) -> PureResultReplayIndexError:
+        error = result.get("error") if isinstance(result, Mapping) else None
+        error_type = error.get("type") if isinstance(error, Mapping) else None
+        context = error.get("context") if isinstance(error, Mapping) else None
+        if error_type in _FAILURE_REASONS:
+            reason, cause = _FAILURE_REASONS[error_type]
+        elif error_type == "contract_violation" and isinstance(context, Mapping) and context.get("reason") == "pure_projection_contract_invalid":
+            reason, cause = OUTPUT_CONTRACT_INVALID, "pure_projection_contract_invalid"
+        else:
+            reason, cause = EVALUATION_FAILED, "pure_evaluation_failed"
+        return _error(reason, f"pure node {node.presentation_key!r} could not be re-derived", node_id=node.node_id, cause={"type": cause}, error=error)
+
+    # -- state addresses --------------------------------------------------
+    def _row_for_node(self, node_id: str, state: Mapping[str, Any]) -> Any:
+        plan = self.bundle.runtime_plan.nodes.get(node_id)
+        steps = state.get("steps")
+        if plan is None or not isinstance(steps, Mapping):
+            return None
+        return steps.get(plan.presentation_key)
+
+    def resolve_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if isinstance(inputs, Mapping) and address.input_name in inputs:
+                return True, inputs[address.input_name]
+            return False, None
+        row = self._row_for_node(getattr(address, "node_id", ""), state)
+        if not isinstance(row, Mapping):
+            return False, None
+        if isinstance(address, NodeResultAddress):
+            field, member = address.field, address.member
+        else:
+            field, member = "artifacts", address.output_name
+        container = row.get(field)
+        if member is None:
+            return (field in row), container
+        if isinstance(container, Mapping) and member in container:
+            return True, container[member]
+        return False, None
+
+    def value_for_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _error(DURABLE_INPUT_MISSING, f"no durable value for {address!r}", address=repr(address))
+        return value
+
+    # -- boundary ---------------------------------------------------------
+    def _progress(self, node_id: str, state: Mapping[str, Any], *, visit_count: int = 1) -> str:
+        """Classify one node; an overlay row equal to the held result is complete."""
+        node = self.index.nodes[node_id]
+        if node_id in self._cache:
+            steps = state.get("steps")
+            if isinstance(steps, Mapping) and steps.get(node.presentation_key) == self._cache[node_id][1]:
+                self._check_cache_hit(node_id, state)
+                return DERIVED_COMPLETE
+        return classify_pure_replay_progress(
+            state, witness=self.witness(node_id, visit_count=visit_count)
+        )
+
+    def _reached_node_ids(self, state: Mapping[str, Any]) -> list[str]:
+        visits = state.get("step_visits") or {}
+        return [
+            node.node_id
+            for node in self.index.nodes.values()
+            if node.presentation_key in visits
+            and self._progress(node.node_id, state) == DERIVED_COMPLETE
+        ]
+
+    def _boundary_seeds(self, restart_node_id: Optional[str]) -> list[Any]:
+        plan, ir = self.bundle.runtime_plan, self.bundle.ir
+        order = {n: i for i, n in enumerate(plan.ordered_node_ids)}
+        floor = order.get(restart_node_id) if restart_node_id is not None else None
+        seeds: list[Any] = [c.source_address for c in ir.outputs.values() if getattr(c, "source_address", None)]
+        if floor is not None:
+            for node_id, node in ir.nodes.items():
+                if node_id not in order or order[node_id] >= floor:
+                    seeds.extend(_iter_addresses(node))
+                    text = list(_iter_strings(node.execution_config))
+                    for pure in self.index.nodes.values():
+                        if any(pure.presentation_key in s for s in text):
+                            seeds.extend(pure.output_addresses)
+        return seeds
+
+    def required_node_ids_for_boundary(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> tuple[str, ...]:
+        reached = self._reached_node_ids(state)
+        seeds = self._boundary_seeds(restart_node_id)
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=reached)
+
+    def audit_boundary_leaves(self, restart_node_id: Optional[str], *, state: Mapping[str, Any]) -> None:
+        """Validate only the durable leaves the required pure nodes depend on."""
+        for node_id in self.required_node_ids_for_boundary(restart_node_id, state=state):
+            for binding in self.index.nodes[node_id].bindings:
+                address = binding.address
+                if isinstance(address, NodeResultAddress) and address.node_id in self.index.nodes:
+                    continue
+                found, value = self.resolve_state_address(address, state)
+                if not found:
+                    raise _error(DURABLE_INPUT_MISSING, f"durable input {address!r} is missing", node_id=node_id, path=binding.path)
+                self._validate_leaf(node_id, binding, value)
+
+    @staticmethod
+    def _validate_leaf(node_id: str, binding: Any, value: Any) -> None:
+        address = binding.address
+        try:
+            if isinstance(address, NodeResultAddress) and address.field == "exit_code":
+                if type(value) is not int:
+                    raise TypeError("exit_code must be an int")
+            elif isinstance(address, NodeResultAddress) and address.field == "outcome":
+                expected = _OUTCOME_TYPES.get(address.member)
+                if expected is not None and type(value) is not expected:
+                    raise TypeError(f"outcome.{address.member} must be {expected.__name__}")
+            else:
+                _coerce_value(value, binding.declared_type, context=binding.path)
+        except (TypeError, PureExprEvaluationError) as exc:
+            raise _error(DURABLE_INPUT_INVALID, f"durable input {address!r} is invalid: {exc}", node_id=node_id, path=binding.path) from exc
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Copy of `state` with held, revalidated full pure rows applied."""
+        overlay = deepcopy(dict(state))
+        steps = overlay.setdefault("steps", {})
+        for node_id, (witness, _row) in self._cache.items():
+            steps[witness.presentation_key] = deepcopy(self._check_cache_hit(node_id, state))
+        return overlay
+
+    def replay_required(
+        self,
+        restart_node_id: Optional[str],
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureResultReplayNode, Mapping[str, Any]], Mapping[str, Any]],
+    ) -> dict[str, Any]:
+        """Overlay every pure value the restart boundary needs, in order."""
+        self.audit_boundary_leaves(restart_node_id, state=state)
+        overlay = self.overlay_active_state(state)
+        for node_id in self.required_node_ids_for_boundary(restart_node_id, state=state):
+            node = self.index.nodes[node_id]
+            overlay["steps"][node.presentation_key] = self.replay_node(
+                node_id, state=overlay, evaluate_node=evaluate_node
+            )
+        return overlay
+
+    # -- audits -----------------------------------------------------------
+    def audit_progress(self, state: Mapping[str, Any]) -> None:
+        """Classify every eligible node; raise on any invalid witness."""
+        for node in self.index.nodes.values():
+            visits = state.get("step_visits")
+            visit = visits.get(node.presentation_key) if isinstance(visits, Mapping) else None
+            self._progress(node.node_id, state, visit_count=visit if type(visit) is int else 1)
+
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Mapping[str, Any],
+        state_manager: Any,
+        resolve_bundle_path: Callable[[PureResultReplayNode], Any],
+    ) -> None:
+        """Reject any durable value surface held for an eligible node."""
+        if not self.index.nodes:
+            return
+        self._audit_rows(state)
+        self._audit_bundles(resolve_bundle_path)
+        self._audit_private_lineage(state)
+        self._audit_checkpoints(state_manager)
+
+    def _conflict(self, surface: str, node: PureResultReplayNode, **context: Any) -> PureResultReplayIndexError:
+        return _error(
+            PROFILE_CONFLICT,
+            f"derived_pure_replay.v1 forbids a persisted {surface} for pure node {node.presentation_key!r}",
+            surface=surface,
+            node_id=node.node_id,
+            **context,
+        )
+
+    def _audit_rows(self, state: Mapping[str, Any]) -> None:
+        steps = state.get("steps")
+        steps = steps if isinstance(steps, Mapping) else {}
+        for node in self.index.nodes.values():
+            row = steps.get(node.presentation_key)
+            if row is None:
+                continue
+            if _is_exact_shell(row, self.witness(node.node_id)):
+                continue
+            if isinstance(row, Mapping) and row.get("status") in {"failed", "skipped"}:
+                continue
+            raise self._conflict("steps", node)
+
+    def _audit_bundles(self, resolve_bundle_path: Callable[[PureResultReplayNode], Any]) -> None:
+        for node in self.index.nodes.values():
+            path = resolve_bundle_path(node)
+            if path is not None and Path(path).exists():
+                raise self._conflict("pure_bundle", node, path=str(path))
+
+    def _audit_private_lineage(self, state: Mapping[str, Any]) -> None:
+        lineage = state.get("private_artifact_versions")
+        if not isinstance(lineage, Mapping):
+            return
+        for node in self.index.nodes.values():
+            owners = {node.step_id, node.node_id}
+            for versions in lineage.values():
+                for entry in versions if isinstance(versions, list) else ():
+                    if isinstance(entry, Mapping) and (
+                        entry.get("producer") in owners
+                        or entry.get("producer_name") == node.presentation_key
+                    ):
+                        raise self._conflict("private_artifact_versions", node)
+
+    def _scope_frame_id(self) -> Optional[str]:
+        ids = self.scope_path.call_frame_ids
+        return ids[-1] if ids else None
+
+    def _audit_checkpoints(self, state_manager: Any) -> None:
+        from ..workflow_lisp.lexical_checkpoint_restore import canonical_indexed_record_relative_path
+        from ..workflow_lisp.lexical_checkpoints import _point_payload, resolve_checkpoint_index_path
+
+        by_step = {n.step_id: n for n in self.index.nodes.values()}
+        frame_id = self._scope_frame_id()
+        workflow_name = self.bundle.runtime_plan.workflow_name
+        for point in self.bundle.runtime_plan.lexical_checkpoint_points:
+            try:
+                index = state_manager.read_runtime_sidecar_json(
+                    resolve_checkpoint_index_path(
+                        state_manager=state_manager,
+                        workflow_name=workflow_name,
+                        checkpoint_id=point.checkpoint_id,
+                    )
+                )
+            except (ValueError, OSError) as exc:
+                raise _error(
+                    DEPENDENCY_INDEX_INVALID,
+                    f"checkpoint index for {point.checkpoint_id!r} is unreadable or malformed",
+                    surface="checkpoint_record",
+                    checkpoint_id=point.checkpoint_id,
+                ) from exc
+            for entry in self._index_records(index, point.checkpoint_id):
+                if entry["frame_identity"].get("call_frame_id") != frame_id:
+                    continue
+                owner = by_step.get(getattr(point, "step_id", None))
+                if owner is not None:
+                    raise self._conflict("checkpoint_record", owner, record_id=entry.get("record_id"))
+                relative = canonical_indexed_record_relative_path(
+                    state_manager=state_manager,
+                    workflow_name=workflow_name,
+                    checkpoint_id=point.checkpoint_id,
+                    point_payload=_point_payload(point),
+                    entry=entry,
+                )
+                if relative is None:
+                    raise _error(
+                        DEPENDENCY_INDEX_INVALID,
+                        f"checkpoint index for {point.checkpoint_id!r} names a non-canonical record_path",
+                        surface="checkpoint_record",
+                        checkpoint_id=point.checkpoint_id,
+                        record_id=entry.get("record_id"),
+                    )
+                self._audit_restore_bindings(state_manager, relative, entry, by_step)
+
+    @staticmethod
+    def _index_records(index: Any, checkpoint_id: str) -> list:
+        """Return validated checkpoint index records; malformed shapes fail closed."""
+        if index is None:
+            return []
+        records = index.get("records", []) if isinstance(index, Mapping) else None
+        if not isinstance(records, list) or not all(
+            isinstance(r, Mapping)
+            and isinstance(r.get("frame_identity"), Mapping)
+            and isinstance(r.get("record_path"), str)
+            for r in records
+        ):
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                f"checkpoint index for {checkpoint_id!r} has a malformed records entry",
+                surface="checkpoint_record",
+                checkpoint_id=checkpoint_id,
+            )
+        return records
+
+    def _audit_restore_bindings(
+        self, state_manager: Any, relative: str, entry: Mapping[str, Any], by_step: Mapping[str, Any]
+    ) -> None:
+        try:
+            record = state_manager.read_runtime_sidecar_json(state_manager.workspace / relative)
+            payload = (record or {}).get("restore_payload") or {}
+            bindings = list(payload.get("bindings", ()))
+            owners = [by_step.get(b.get("source_step_id")) for b in bindings]
+        except (ValueError, AttributeError, TypeError, OSError) as exc:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                f"checkpoint record {entry.get('record_id')!r} is unreadable or malformed",
+                surface="checkpoint_record",
+                record_id=entry.get("record_id"),
+            ) from exc
+        for owner in owners:
+            if owner is not None:
+                raise self._conflict("restore_payload", owner, record_id=entry.get("record_id"))

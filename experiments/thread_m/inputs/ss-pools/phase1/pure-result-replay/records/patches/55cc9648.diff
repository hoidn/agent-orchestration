+def test_visit_two_shell_is_rejected_before_the_prologue(profiled) -> None:
+    bundle, manager, _final, workspace = profiled
+    _interrupt_after_condition(manager)
+    with manager.state_transaction() as state:
+        state.step_visits[PURE_KEY] = 2
+    failed = WorkflowExecutor(bundle, workspace, manager).execute(resume=True)
+    assert failed["error"]["context"]["reason"] == "progress_witness_invalid"
+    assert _counts(workspace)["finish_step.count"] == "x"
+
+
+@pytest.mark.parametrize("surface", ["steps", "private_artifact_versions", "pure_bundle"])
+def test_persisted_value_surfaces_conflict_before_any_write(profiled, surface: str) -> None:
+    bundle, manager, _final, workspace = profiled

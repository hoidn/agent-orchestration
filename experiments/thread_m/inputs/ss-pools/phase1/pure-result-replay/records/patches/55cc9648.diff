index 0000000..2ea1210
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_index.py
@@ -0,0 +1,461 @@
+"""Derive the replay index for compiler-generated pure projections.
+
+The index is computed from a loaded bundle without mutating or serializing it.
+It answers which pure nodes are replay-eligible (acyclic, visited at most once
+per scope) and what each depends on. Refs are scoped to the bundle that holds
+them: an imported callee bundle indexes only its own nodes under its own
+"root" scope.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+from types import MappingProxyType
+from typing import Any, Iterable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_replay_errors import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+
+ROOT_SCOPE = "root"
+DEPENDS_ON_INELIGIBLE = "depends_on_ineligible_pure"
+LINEAGE_BEARING = "artifact_lineage_bearing"
+_LOOP_KINDS = {ExecutableNodeKind.REPEAT_UNTIL_FRAME, ExecutableNodeKind.FOR_EACH}
+_BLOCK_KINDS = {ExecutableNodeKind.IF_JOIN, ExecutableNodeKind.MATCH_JOIN}
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+@dataclass(frozen=True)
+class PureResultReplayBinding:
+    """One exact `{"ref": ...}` leaf of a binding value document."""
+
+    path: str
+    address: BoundAddress
+    declared_type: Mapping[str, Any]
+
+
+@dataclass(frozen=True)
+class PureResultReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureResultReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Mapping[str, Any]]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureResultReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+
+    def required_pure_node_ids(
+        self, seed_addresses: Iterable[Any], *, reached_node_ids: Iterable[str]
+    ) -> tuple[str, ...]:
+        """Pure nodes needed to rebuild `seed_addresses`, in dependency order.
+
+        Seeds naming an eligible pure node that was not reached are skipped
+        (the value legitimately does not exist). A reached pure node that
+        depends on an unreached one is inconsistent.
+        """
+        reached = set(reached_node_ids)
+        needed: set[str] = set()
+        stack = [
+            a.node_id
+            for a in seed_addresses
+            if isinstance(a, NodeResultAddress)
+            and a.node_id in self.nodes
+            and a.node_id in reached
+        ]
+        while stack:
+            node_id = stack.pop()
+            if node_id in needed:
+                continue
+            needed.add(node_id)
+            for dep in self.nodes[node_id].pure_dependency_node_ids:
+                if dep not in reached:
+                    raise PureResultReplayIndexError(
+                        REACHABILITY_AMBIGUOUS,
+                        f"pure node {node_id!r} depends on unreached pure node {dep!r}",
+                        context={"node_id": node_id, "dependency": dep},
+                    )
+                stack.append(dep)
+        return tuple(n for n in self.topological_node_ids if n in needed)
+
+
+def _thaw(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _thaw(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_thaw(v) for v in value]
+    return value
+
+
+def _is_exact_ref(doc: Any) -> bool:
+    return isinstance(doc, dict) and set(doc) == {"ref"} and isinstance(doc["ref"], str) and bool(doc["ref"])
+
+
+def _check_doc(doc: Any, desc: Any, path: str, refs: list[tuple[str, str, Any]]) -> None:
+    """Match a binding value document to its declared type, collecting refs."""
+    if isinstance(doc, dict) and "ref" in doc:
+        if not _is_exact_ref(doc):
+            raise _invalid("malformed ref object in binding document", path=path)
+        refs.append((path, doc["ref"], desc))
+        return
+    kind = desc.get("kind") if isinstance(desc, Mapping) else None
+    try:
+        if kind == "optional":
+            if doc is not None:
+                _check_doc(doc, desc["item"], path, refs)
+        elif kind == "list":
+            if not isinstance(doc, list):
+                raise PureExprEvaluationError("pure_expr_operand_type_mismatch", "must be a list")
+            for i, item in enumerate(doc):
+                _check_doc(item, desc["item"], f"{path}[{i}]", refs)
+        elif kind == "map":
+            if not isinstance(doc, dict):
+                raise PureExprEvaluationError("pure_expr_operand_type_mismatch", "must be a map")
+            for key, item in doc.items():
+                _coerce_value(key, desc["key"], context=path)
+                _check_doc(item, desc["value"], f"{path}.{key}", refs)
+        elif kind == "record":
+            _check_fields(doc, desc["fields"], path, refs, closed=True)
+        elif kind in {"union", "variant_case"}:
+            _check_union(doc, desc, path, refs)
+        else:
+            _coerce_value(doc, desc, context=path)
+    except PureExprEvaluationError as exc:
+        raise _invalid(
+            f"binding literal at {path!r} does not match its declared type: {exc}",
+            path=path,
+        ) from exc
+
+
+def _check_fields(doc: Any, fields: Any, path: str, refs: list, *, closed: bool) -> None:
+    if not isinstance(doc, dict):
+        raise PureExprEvaluationError("pure_expr_operand_type_mismatch", "must be a record")
+    names = {f["name"] for f in fields}
+    for field in fields:
+        if field["name"] not in doc:
+            raise PureExprEvaluationError(
+                "pure_expr_operand_type_mismatch", f"missing field {field['name']}"
+            )
+        _check_doc(doc[field["name"]], field["type"], f"{path}.{field['name']}", refs)
+    if closed and set(doc) - names:
+        raise PureExprEvaluationError("pure_expr_operand_type_mismatch", "unexpected fields")
+
+
+def _check_union(doc: Any, desc: Mapping[str, Any], path: str, refs: list) -> None:
+    """Active variant fields are required; inactive members must still be typed."""
+    if not isinstance(doc, dict):
+        raise PureExprEvaluationError("pure_expr_operand_type_mismatch", "must be a union value")
+    variants = [desc] if desc["kind"] == "variant_case" else list(desc["variants"])
+    declared: dict[str, list[Any]] = {}
+    for variant in variants:
+        vname = variant.get("name", variant.get("variant"))
+        for field in variant["fields"]:
+            declared.setdefault(field["name"], []).append((vname, field["type"]))
+    active = doc.get("variant")
+    if _is_exact_ref(active):
+        refs.append((f"{path}.variant", active["ref"], {"kind": "primitive", "name": "String"}))
+    elif active not in {v.get("name", v.get("variant")) for v in variants}:
+        raise PureExprEvaluationError("pure_expr_operand_type_mismatch", "unknown variant")
+    else:
+        required = next(v for v in variants if v.get("name", v.get("variant")) == active)
+        for field in required["fields"]:
+            if field["name"] not in doc:
+                raise PureExprEvaluationError(
+                    "pure_expr_operand_type_mismatch", f"missing field {field['name']}"
+                )
+    for name, value in doc.items():
+        if name == "variant":
+            continue
+        if name not in declared:
+            raise PureExprEvaluationError("pure_expr_operand_type_mismatch", f"unknown member {name}")
+        _check_member(value, declared[name], f"{path}.{name}", refs)
+
+
+def _check_member(value: Any, candidates: list, path: str, refs: list) -> None:
+    last: Optional[PureResultReplayIndexError] = None
+    for _vname, ftype in candidates:
+        trial: list = []
+        try:
+            _check_doc(value, ftype, path, trial)
+        except PureResultReplayIndexError as exc:
+            last = exc
+            continue
+        refs.extend(trial)
+        return
+    assert last is not None
+    raise last
+
+
+class _Scope:
+    """Name resolution for one bundle: presentation keys, ids, graph facts."""
+
+    def __init__(self, bundle: LoadedWorkflowBundle) -> None:
+        self.bundle = bundle
+        self.ir_nodes = bundle.ir.nodes
+        self.plan_nodes = bundle.runtime_plan.nodes
+        self.entries = bundle.projection.entries_by_node_id
+        self.order = {n: i for i, n in enumerate(bundle.runtime_plan.ordered_node_ids)}
+        self.by_key: dict[str, list[str]] = {}
+        for node_id, plan in self.plan_nodes.items():
+            self.by_key.setdefault(plan.presentation_key, []).append(node_id)
+
+    def check_identities(self, pure_ids: Iterable[str]) -> None:
+        seen_steps: dict[str, str] = {}
+        seen_keys: dict[str, str] = {}
+        for node_id in pure_ids:
+            plan, entry = self.plan_nodes.get(node_id), self.entries.get(node_id)
+            if plan is None or entry is None:
+                raise _invalid("pure node lacks projection authority", node_id=node_id)
+            if (plan.presentation_key, plan.step_id) != (entry.presentation_key, entry.step_id):
+                raise _invalid("projection identity mismatch", node_id=node_id)
+            if self.bundle.projection.node_id_by_step_id.get(plan.step_id) != node_id:
+                raise _invalid("duplicate projection authority for step id", node_id=node_id)
+            for table, key in ((seen_steps, plan.step_id), (seen_keys, plan.presentation_key)):
+                if key in table:
+                    raise _invalid(
+                        "duplicate projection authority", node_ids=[table[key], node_id]
+                    )
+                table[key] = node_id
+
+    def multiple_visit_ids(self) -> set[str]:
+        """Nodes on a routing cycle or owned by a loop frame."""
+        edges: dict[str, set[str]] = {n: set() for n in self.ir_nodes}
+        for node_id, node in self.ir_nodes.items():
+            targets = [node.fallthrough_node_id]
+            targets += [t.target_node_id for t in (node.routed_transfers or {}).values()]
+            for target in targets:
+                if target in edges:
+                    edges[node_id].add(target)
+        loops = [n for n, v in self.ir_nodes.items() if v.kind in _LOOP_KINDS]
+        multi = {
+            n for n in self.ir_nodes if any(n.startswith(f"{loop}.") for loop in loops)
+        }
+        return multi | _nodes_on_cycles(edges)
+
+    def address_for_ref(self, ref: str) -> BoundAddress:
+        if ref.startswith("inputs."):
+            name = ref[len("inputs."):]
+            if name not in self.bundle.ir.inputs:
+                raise _invalid("ref names an unbound workflow input", ref=ref)
+            return WorkflowInputAddress(name)
+        scope, sep, rest = ref.partition(".steps.")
+        if not sep or scope not in {"root", "self", "parent"}:
+            raise _invalid("ref text is not a bound input or step ref", ref=ref)
+        matches = [k for k in self.by_key if rest.startswith(k + ".")]
+        if not matches:
+            raise _invalid(self._unbound_message(rest), ref=ref, cross_frame=self._in_import(rest))
+        key = max(matches, key=len)
+        if len(self.by_key[key]) != 1:
+            raise PureResultReplayIndexError(
+                REACHABILITY_AMBIGUOUS,
+                f"ref {ref!r} matches several nodes",
+                context={"ref": ref, "node_ids": list(self.by_key[key])},
+            )
+        node_id = self.by_key[key][0]
+        field, _, member = rest[len(key) + 1:].partition(".")
+        kind = self.ir_nodes[node_id].kind
+        if field == "artifacts" and member:
+            if kind in _BLOCK_KINDS:
+                return BlockOutputAddress(node_id, member)
+            if kind in _LOOP_KINDS:
+                return LoopOutputAddress(node_id, member)
+            if kind is ExecutableNodeKind.CALL_BOUNDARY:
+                return CallOutputAddress(node_id, member)
+        return NodeResultAddress(node_id, field, member or None)
+
+    def _in_import(self, rest: str) -> bool:
+        return any(
+            rest.startswith(p.presentation_key + ".")
+            for imported in self.bundle.imports.values()
+            for p in imported.runtime_plan.nodes.values()
+        )
+
+    def _unbound_message(self, rest: str) -> str:
+        if self._in_import(rest):
+            return "ref crosses into another call frame"
+        return "ref names an unbound step"
+
+
+def _nodes_on_cycles(edges: Mapping[str, set[str]]) -> set[str]:
+    """Iterative Tarjan: members of non-trivial SCCs plus self-loops."""
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    on_stack: set[str] = set()
+    stack: list[str] = []
+    cyclic: set[str] = set()
+    counter = 0
+    for root in edges:
+        if root in index:
+            continue
+        work = [(root, iter(sorted(edges[root])))]
+        index[root] = low[root] = counter
+        counter += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            node, it = work[-1]
+            advanced = False
+            for nxt in it:
+                if nxt not in index:
+                    index[nxt] = low[nxt] = counter
+                    counter += 1
+                    stack.append(nxt)
+                    on_stack.add(nxt)
+                    work.append((nxt, iter(sorted(edges[nxt]))))
+                    advanced = True
+                    break
+                if nxt in on_stack:
+                    low[node] = min(low[node], index[nxt])
+            if advanced:
+                continue
+            work.pop()
+            if work:
+                parent = work[-1][0]
+                low[parent] = min(low[parent], low[node])
+            if low[node] == index[node]:
+                comp = []
+                while True:
+                    member = stack.pop()
+                    on_stack.discard(member)
+                    comp.append(member)
+                    if member == node:
+                        break
+                if len(comp) > 1 or node in edges[node]:
+                    cyclic.update(comp)
+    return cyclic
+
+
+def _propagate_pure_ineligibility(
+    deps: Mapping[str, Iterable[str]], reasons: dict[str, str]
+) -> None:
+    """Make dependents of ineligible pure nodes ineligible, to a fixed point."""
+    changed = True
+    while changed:
+        changed = False
+        for node_id, pure_deps in deps.items():
+            if node_id in reasons:
+                continue
+            if any(dep in reasons for dep in pure_deps):
+                reasons[node_id] = DEPENDS_ON_INELIGIBLE
+                changed = True
+
+
+def _build_node(scope: _Scope, node_id: str) -> tuple[PureResultReplayNode, list[BoundAddress]]:
+    node = scope.ir_nodes[node_id]
+    config = node.execution_config
+    projection = _thaw(config.pure_projection)
+    payload, refs = projection.get("payload"), projection.get("binding_refs")
+    contracts = projection.get("output_contracts")
+    if not (isinstance(payload, dict) and isinstance(refs, dict) and isinstance(contracts, dict)):
+        raise _invalid("pure projection config is malformed", node_id=node_id)
+    declared = payload.get("bindings")
+    if not isinstance(declared, dict) or set(declared) != set(refs):
+        raise _invalid("binding documents do not match declared bindings", node_id=node_id)
+    bindings: list[PureResultReplayBinding] = []
+    for name, doc in refs.items():
+        leaves: list[tuple[str, str, Any]] = []
+        _check_doc(doc, declared[name]["type"], name, leaves)
+        for path, ref, desc in leaves:
+            bindings.append(
+                PureResultReplayBinding(path, scope.address_for_ref(ref), MappingProxyType(_thaw(desc)))
+            )
+    plan = scope.plan_nodes[node_id]
+    outputs = tuple(NodeResultAddress(node_id, "artifacts", name) for name in contracts)
+    built = PureResultReplayNode(
+        node_id=node_id,
+        step_id=plan.step_id,
+        presentation_key=plan.presentation_key,
+        bindings=tuple(bindings),
+        output_addresses=outputs,
+        output_contracts=MappingProxyType({k: MappingProxyType(v) for k, v in contracts.items()}),
+        pure_dependency_node_ids=(),
+        durable_dependency_node_ids=(),
+    )
+    return built, [b.address for b in bindings]
+
+
+def _topological(order: Mapping[str, int], deps: Mapping[str, Iterable[str]]) -> tuple[str, ...]:
+    remaining = {n: set(d) for n, d in deps.items()}
+    result: list[str] = []
+    while remaining:
+        ready = sorted((n for n, d in remaining.items() if not d), key=lambda n: order.get(n, 0))
+        if not ready:
+            raise _invalid("pure dependency cycle", node_ids=sorted(remaining))
+        for node_id in ready:
+            result.append(node_id)
+            del remaining[node_id]
+        for pending in remaining.values():
+            pending.difference_update(ready)
+    return tuple(result)
+
+
+def derive_pure_result_replay_index(
+    bundle: LoadedWorkflowBundle, *, scope_kind: str = ROOT_SCOPE
+) -> PureResultReplayIndex:
+    """Derive eligibility and dependencies for `bundle`'s own pure nodes."""
+    if scope_kind != ROOT_SCOPE:
+        raise _invalid(
+            "scope_kind does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=ROOT_SCOPE,
+        )
+    scope = _Scope(bundle)
+    pure_ids = [
+        n for n, v in scope.ir_nodes.items() if v.kind is ExecutableNodeKind.PURE_PROJECTION
+    ]
+    scope.check_identities(pure_ids)
+    multi = scope.multiple_visit_ids()
+    reasons = {n: MULTIPLE_VISIT_REGION for n in pure_ids if n in multi}
+    for node_id in pure_ids:
+        common = scope.ir_nodes[node_id].execution_config.common
+        if node_id not in reasons and (common.publishes or common.consumes):
+            reasons[node_id] = LINEAGE_BEARING
+    built: dict[str, PureResultReplayNode] = {}
+    addresses: dict[str, list[BoundAddress]] = {}
+    for node_id in pure_ids:
+        if node_id not in reasons:
+            built[node_id], addresses[node_id] = _build_node(scope, node_id)
+    pure_set = set(pure_ids)
+    pure_deps = {
+        n: sorted({a.node_id for a in addrs if isinstance(a, NodeResultAddress) and a.node_id in pure_set})
+        for n, addrs in addresses.items()
+    }
+    _propagate_pure_ineligibility(pure_deps, reasons)
+    eligible = set(built) - set(reasons)
+    nodes: dict[str, PureResultReplayNode] = {}
+    for node_id in sorted(eligible, key=lambda n: scope.order.get(n, 0)):
+        address_nodes = {a.node_id for a in addresses[node_id] if hasattr(a, "node_id")}
+        nodes[node_id] = replace(
+            built[node_id],
+            pure_dependency_node_ids=tuple(d for d in pure_deps[node_id] if d in eligible),
+            durable_dependency_node_ids=tuple(sorted(address_nodes - eligible)),
+        )
+    topo = _topological(scope.order, {n: v.pure_dependency_node_ids for n, v in nodes.items()})
+    return PureResultReplayIndex(
+        ROOT_SCOPE, MappingProxyType(nodes), topo, MappingProxyType(dict(reasons))
+    )

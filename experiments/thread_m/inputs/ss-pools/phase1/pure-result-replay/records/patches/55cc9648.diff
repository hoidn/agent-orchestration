@@ -0,0 +1,255 @@
+"""Value-free completion shell and visit-progress classification for pure replay.
+
+Pure data in, pure data out: no state writes happen here. `StateManager` and
+`OutcomeRecorder` call these helpers inside their own transactions.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Mapping
+
+from ..state import DERIVED_PURE_REPLAY_PROFILE, RunState, StepResult
+from .pure_replay_errors import (
+    PROGRESS_WITNESS_INVALID,
+    PURE_PROJECTION_KIND,
+    PureResultReplayIndexError,
+)
+
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+_COMPLETED_OUTCOME = {
+    "status": "completed",
+    "phase": "execution",
+    "class": "completed",
+    "retryable": False,
+}
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit eligible pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free success row without serializing a result."""
+    if witness.visit_count != 1:
+        raise ValueError("pure completion shell requires visit_count 1")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": dict(_COMPLETED_OUTCOME),
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _is_exact_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    if witness.visit_count != 1 or not isinstance(row, Mapping):
+        return False
+    expected = build_pure_completion_shell(witness)
+    if set(row) != set(expected):
+        return False
+    if not _same_json(row.get("outcome"), expected["outcome"]):
+        return False
+    return all(
+        _same_json(row.get(key), value)
+        for key, value in expected.items()
+        if key != "outcome"
+    )
+
+
+def _same_json(actual: Any, expected: Any) -> bool:
+    """Equality that does not conflate bool with int (0 == False)."""
+    if isinstance(expected, Mapping):
+        return (
+            isinstance(actual, Mapping)
+            and set(actual) == set(expected)
+            and all(_same_json(actual[k], v) for k, v in expected.items())
+        )
+    return type(actual) is type(expected) and actual == expected
+
+
+def validate_pure_completion_shell(
+    row: Any, *, witness: PureReplayVisitWitness
+) -> None:
+    """Raise ValueError unless `row` is exactly the witness's completion shell."""
+    if not _is_exact_shell(row, witness):
+        raise ValueError(
+            f"pure completion row for {witness.presentation_key!r} is not the "
+            f"exact {DERIVED_PURE_REPLAY_PROFILE} completion shell"
+        )
+
+
+def _visit_of(state: Mapping[str, Any], key: str) -> Any:
+    visits = state.get("step_visits")
+    return visits.get(key) if isinstance(visits, Mapping) else None
+
+
+def _row_of(state: Mapping[str, Any], key: str) -> Any:
+    steps = state.get("steps")
+    return steps.get(key) if isinstance(steps, Mapping) else None
+
+
+def _cursor_targets(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def cursor_matches_witness(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    """True when `cursor` is exactly the running cursor for the witness."""
+    return (
+        isinstance(cursor, Mapping)
+        and cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and type(cursor.get("index")) is int
+        and cursor.get("type") == PURE_PROJECTION_KIND
+        and cursor.get("status") == "running"
+        and cursor.get("visit_count") == witness.visit_count
+        and type(cursor.get("visit_count")) is int
+    )
+
+
+def _failure_skip_matches(row: Any, witness: PureReplayVisitWitness) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("name") == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and row.get("visit_count") == witness.visit_count
+        and type(row.get("visit_count")) is int
+    )
+
+
+def _invalid(witness: PureReplayVisitWitness, why: str) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID,
+        f"pure replay progress for {witness.presentation_key!r} is invalid: {why}",
+        context={
+            "presentation_key": witness.presentation_key,
+            "step_id": witness.step_id,
+            "visit_count": witness.visit_count,
+            "why": why,
+        },
+    )
+
+
+def classify_pure_replay_progress(
+    state: Mapping[str, Any], *, witness: PureReplayVisitWitness
+) -> str:
+    """Classify visit, cursor and row for one witness, or raise
+    `PureResultReplayIndexError(progress_witness_invalid)`.
+    """
+    if not isinstance(state, Mapping):
+        state = state.to_dict()  # a RunState
+    key = witness.presentation_key
+    visit = _visit_of(state, key)
+    row = _row_of(state, key)
+    cursor = state.get("current_step")
+    related = _cursor_targets(cursor, witness)
+
+    if related:
+        if row is not None:
+            raise _invalid(witness, "cursor present with a result row")
+        if visit != witness.visit_count or type(visit) is not int:
+            raise _invalid(witness, "cursor visit does not match the visit counter")
+        if not cursor_matches_witness(cursor, witness):
+            raise _invalid(witness, "cursor identity does not match the witness")
+        return INTERRUPTED
+
+    if visit is None:
+        if row is not None:
+            raise _invalid(witness, "result row without a visit")
+        return UNSTARTED
+    if row is None:
+        raise _invalid(witness, "visit without cursor or row")
+    if visit != witness.visit_count or type(visit) is not int:
+        raise _invalid(witness, "visit count does not match the witness")
+    if _is_exact_shell(row, witness):
+        return DERIVED_COMPLETE
+    if _failure_skip_matches(row, witness):
+        return DURABLE_FAILURE_SKIP
+    raise _invalid(witness, "row is neither the exact shell nor a failure/skip")
+
+
+def require_progress(
+    state: RunState, witness: PureReplayVisitWitness, expected: str
+) -> None:
+    """Classify `state` for the witness and require the `expected` class."""
+    view = {
+        "step_visits": state.step_visits,
+        "steps": {
+            k: (v.to_dict() if isinstance(v, StepResult) else v)
+            for k, v in state.steps.items()
+        },
+        "current_step": state.current_step,
+    }
+    actual = classify_pure_replay_progress(view, witness=witness)
+    if actual != expected:
+        raise ValueError(
+            f"eligible pure visit {witness.presentation_key!r} is {actual}, "
+            f"expected {expected}"
+        )
+
+
+def begin_visit(state: RunState, name: str, index: int, step_id: str) -> int:
+    """Record visit one plus its running cursor on an unstarted node."""
+    require_progress(state, PureReplayVisitWitness(name, index, step_id, 1), UNSTARTED)
+    now = datetime.now(timezone.utc).isoformat()
+    state.step_visits[name] = 1
+    state.current_step = {
+        "name": name,
+        "index": index,
+        "type": PURE_PROJECTION_KIND,
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def settle_success(state: RunState, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Replace the interrupted cursor with the exact shell row."""
+    require_progress(state, witness, INTERRUPTED)
+    shell = build_pure_completion_shell(witness)
+    state.steps[witness.presentation_key] = shell
+    state.current_step = None
+    return deepcopy(shell)
+
+
+def settle_failure(
+    state: RunState, witness: PureReplayVisitWitness, result: StepResult
+) -> None:
+    """Persist a full failed/skipped row for the interrupted visit."""
+    if result.status not in ("failed", "skipped"):
+        raise ValueError("eligible pure failure settlement requires failed/skipped")
+    identity = (
+        (result.name, witness.presentation_key),
+        (result.step_id, witness.step_id),
+        (result.visit_count, witness.visit_count),
+    )
+    if any(actual not in (None, expected) for actual, expected in identity):
+        raise ValueError("eligible pure failure row identity mismatches witness")
+    require_progress(state, witness, INTERRUPTED)
+    result.name = witness.presentation_key
+    result.step_id = witness.step_id
+    result.visit_count = witness.visit_count
+    state.steps[witness.presentation_key] = result
+    state.current_step = None

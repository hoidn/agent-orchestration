+    with manager.state_transaction() as state:
+        if surface == "steps":
+            state.steps[PURE_KEY] = {**state.steps[PURE_KEY], "artifacts": {"x": 1}}
+        elif surface == "private_artifact_versions":
+            state.private_artifact_versions = {
+                "lineage": [{"version": 1, "value": 1, "producer": bundle.runtime_plan.nodes[
+                    next(n for n in bundle.runtime_plan.nodes if bundle.runtime_plan.nodes[n].presentation_key == PURE_KEY)
+                ].step_id, "producer_name": PURE_KEY}]
+            }
+    if surface == "pure_bundle":
+        executor = WorkflowExecutor(bundle, workspace, manager)
+        executor._activate_pure_replay_profile(manager.state)
+        node = next(iter(executor._pure_replay_runtime.index.nodes.values()))
+        path = executor._pure_bundle_path_for_node(node)
+        path.parent.mkdir(parents=True, exist_ok=True)

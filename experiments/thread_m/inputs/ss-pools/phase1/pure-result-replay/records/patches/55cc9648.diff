+"""Profile selector, value-free shell, visit atomicity and progress classification."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import RunState, StateManager, StepResult
+from orchestrator.workflow.outcomes import OutcomeRecorder
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+WITNESS = PureReplayVisitWitness("Project", 3, "root.project", 1)
+SHELL = {
+    "name": "Project",
+    "step_id": "root.project",
+    "visit_count": 1,
+    "status": "completed",
+    "exit_code": 0,
+    "outcome": {
+        "status": "completed",
+        "phase": "execution",
+        "class": "completed",
+        "retryable": False,
+    },
+    "result_storage": "derived_pure_replay.v1",
+}
+
+
+def _manager(tmp_path: Path, **kwargs) -> StateManager:
+    (tmp_path / "wf.orc").write_text("x", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="run-1")
+    manager.initialize("wf.orc", **kwargs)
+    return manager
+
+
+def _state(**overrides):
+    state = {
+        "step_visits": {},
+        "steps": {},
+        "current_step": None,
+    }
+    state.update(overrides)
+    return state
+
+
+def _cursor(**overrides):
+    cursor = {
+        "name": "Project",
+        "index": 3,
+        "type": "pure_projection",
+        "step_id": "root.project",
+        "visit_count": 1,
+        "status": "running",
+        "started_at": "t",
+        "last_heartbeat_at": "t",
+    }
+    cursor.update(overrides)
+    return cursor
+
+
+def test_profile_absent_is_omitted_and_roundtrips(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    payload = json.loads(manager.state_file.read_text())
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None
+    assert RunState.from_dict(payload).to_dict() == payload
+
+
+def test_initialize_writes_profile_before_any_visit(tmp_path: Path) -> None:
+    manager = _manager(tmp_path, result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+    payload = json.loads(manager.state_file.read_text())
+    assert payload["result_persistence_profile"] == "derived_pure_replay.v1"
+    assert payload["step_visits"] == {}
+    assert payload["schema_version"] == "2.1"
+
+
+def test_unknown_profile_fails_closed_everywhere(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        RunState(
+            schema_version="2.1", run_id="r", workflow_file="w", workflow_checksum="c",
+            started_at="t", updated_at="t", status="running",
+            result_persistence_profile="other.v9",
+        )
+    (tmp_path / "wf.orc").write_text("x", encoding="utf-8")
+    fresh = StateManager(tmp_path, run_id="run-2")
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        fresh.initialize("wf.orc", result_persistence_profile="other.v9")
+    assert not fresh.state_file.exists()
+
+    manager = _manager(tmp_path)
+    payload = json.loads(manager.state_file.read_text())
+    payload["result_persistence_profile"] = "other.v9"
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        StateManager(tmp_path, run_id="run-1").load()
+    assert manager.state_file.read_bytes() == before
+
+
+def test_shell_is_exact() -> None:
+    assert build_pure_completion_shell(WITNESS) == SHELL
+    validate_pure_completion_shell(dict(SHELL), witness=WITNESS)
+
+
+@pytest.mark.parametrize("extra", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_rejects_value_bearing_keys(extra: str) -> None:
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell({**SHELL, extra: 1}, witness=WITNESS)
+
+
+def test_shell_rejects_missing_wrong_and_foreign_outcome() -> None:
+    missing = {k: v for k, v in SHELL.items() if k != "result_storage"}
+    for row in (
+        missing,
+        {**SHELL, "exit_code": False},
+        {**SHELL, "visit_count": 2},
+        {**SHELL, "outcome": {**SHELL["outcome"], "retryable": 0}},
+        {**SHELL, "outcome": {**SHELL["outcome"], "extra": 1}},
+    ):
+        with pytest.raises(ValueError):
+            validate_pure_completion_shell(row, witness=WITNESS)
+
+
+def test_begin_settle_success_is_atomic_and_value_free(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    assert manager.begin_eligible_pure_visit(step_name="Project", step_index=3, step_id="root.project") == 1
+    on_disk = json.loads(manager.state_file.read_text())
+    assert on_disk["step_visits"] == {"Project": 1}
+    assert {k: on_disk["current_step"][k] for k in ("name", "index", "type", "step_id", "visit_count", "status")} == {
+        "name": "Project", "index": 3, "type": "pure_projection",
+        "step_id": "root.project", "visit_count": 1, "status": "running",
+    }
+    assert manager.reuse_interrupted_eligible_pure_visit(WITNESS) == 1
+    assert manager.settle_eligible_pure_success(WITNESS) == SHELL
+    on_disk = json.loads(manager.state_file.read_text())
+    assert on_disk["steps"]["Project"] == SHELL
+    assert "current_step" not in on_disk
+
+
+def test_begin_twice_is_rejected_and_leaves_state_unchanged(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.begin_eligible_pure_visit(step_name="Project", step_index=3, step_id="root.project")
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError):
+        manager.begin_eligible_pure_visit(step_name="Project", step_index=3, step_id="root.project")
+    assert manager.state_file.read_bytes() == before
+
+
+def test_settle_failure_persists_full_row(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.begin_eligible_pure_visit(step_name="Project", step_index=3, step_id="root.project")
+    result = StepResult(status="failed", exit_code=2, error={"type": "x"})
+    assert manager.settle_eligible_pure_failure(WITNESS, result) is None
+    row = json.loads(manager.state_file.read_text())["steps"]["Project"]
+    assert row["status"] == "failed" and row["error"] == {"type": "x"} and row["visit_count"] == 1
+    assert manager.state.current_step is None
+
+
+def test_outcome_recorder_settles_shell_but_returns_full_result(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.begin_eligible_pure_visit(step_name="Project", step_index=3, step_id="root.project")
+    summaries = []
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: "root.project",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, row: summaries.append(row),
+    )
+    state = {"step_visits": {"Project": 1}}
+    finalized = recorder.persist_step_result(
+        state, "Project", {}, {"status": "completed", "exit_code": 0, "artifacts": {"a": 1}},
+        eligible_pure_settlement=WITNESS,
+    )
+    assert finalized["artifacts"] == {"a": 1}
+    assert state["steps"]["Project"]["artifacts"] == {"a": 1}
+    assert summaries == [SHELL]
+    assert json.loads(manager.state_file.read_text())["steps"]["Project"] == SHELL
+
+
+@pytest.mark.parametrize(
+    ("state", "expected"),
+    [
+        (_state(), "unstarted"),
+        (_state(current_step={"name": "Other", "status": "running", "step_id": "o"}), "unstarted"),
+        (_state(step_visits={"Project": 1}, current_step=_cursor()), "interrupted"),
+        (_state(step_visits={"Project": 1}, steps={"Project": SHELL}), "derived_complete"),
+        (_state(step_visits={"Project": 1}, steps={"Project": SHELL}, current_step={"name": "Other", "step_id": "o"}), "derived_complete"),
+        (
+            _state(step_visits={"Project": 1}, steps={"Project": {
+                "name": "Project", "step_id": "root.project", "visit_count": 1, "status": "failed", "exit_code": 2}}),
+            "durable_failure_skip",
+        ),
+    ],
+)
+def test_classification_accepts(state, expected) -> None:
+    assert classify_pure_replay_progress(state, witness=WITNESS) == expected
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _state(step_visits={"Project": 1}),
+        _state(current_step=_cursor()),
+        _state(steps={"Project": SHELL}),
+        _state(step_visits={"Project": 1}, steps={"Project": SHELL}, current_step=_cursor()),
+        _state(step_visits={"Project": 2}, current_step=_cursor(visit_count=2)),
+        _state(step_visits={"Project": 2}, steps={"Project": {**SHELL, "visit_count": 2}}),
+        _state(step_visits={"Project": 1}, current_step=_cursor(index=4)),
+        _state(step_visits={"Project": 1}, current_step=_cursor(type="command")),
+        _state(step_visits={"Project": 1}, current_step=_cursor(status="failed")),
+        _state(step_visits={"Project": 1}, current_step=_cursor(step_id="other")),
+        _state(step_visits={"Project": 1}, steps={"Project": {**SHELL, "value": 1}}),
+        _state(step_visits={"Project": 1}, steps={"Project": {"name": "Project", "status": "running"}}),
+        _state(step_visits={"Project": 1}, steps={"Project": {"status": "failed", "name": "Project", "step_id": "root.project", "visit_count": 2}}),
+    ],
+)
+def test_classification_rejects(state) -> None:
+    with pytest.raises(PureResultReplayIndexError) as info:
+        classify_pure_replay_progress(state, witness=WITNESS)
+    assert info.value.reason == "progress_witness_invalid"
+    assert info.value.code == "pure_result_replay_unavailable"
+
+
+def test_outcome_recorder_settles_failure_as_full_row(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.begin_eligible_pure_visit(step_name="Project", step_index=3, step_id="root.project")
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: "root.project",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, row: None,
+    )
+    state = {"step_visits": {"Project": 1}}
+    recorder.persist_step_result(
+        state, "Project", {}, {"status": "failed", "exit_code": 2, "error": {"type": "boom"}},
+        eligible_pure_settlement=WITNESS,
+    )
+    row = json.loads(manager.state_file.read_text())["steps"]["Project"]
+    assert row["status"] == "failed" and row["error"] == {"type": "boom"} and "result_storage" not in row
+    assert manager.state.current_step is None

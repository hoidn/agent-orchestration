+def test_outcome_recorder_keeps_full_row_in_memory_and_shell_durably(tmp_path: Path) -> None:
+    manager = _profiled_manager(tmp_path)
+    manager.begin_eligible_pure_visit(
+        step_name="pure::step", step_index=3, step_id="root.pure_step"
+    )
+    summaries = []
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: "root.pure_step",
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, result: summaries.append(result),
+    )
+    state = {"step_visits": {"pure::step": 1}, "steps": {}}
+    finalized = recorder.persist_step_result(
+        state, "pure::step", {}, {"status": "completed", "exit_code": 0, "artifacts": {"a": 1}},
+        eligible_pure_settlement=WITNESS,
+    )
+    assert finalized["artifacts"] == {"a": 1}
+    assert state["steps"]["pure::step"] is finalized
+    assert summaries == [SHELL]
+    assert json.loads(manager.state_file.read_text())["steps"]["pure::step"] == SHELL
+

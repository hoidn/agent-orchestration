diff --git a/orchestrator/workflow/pure_replay_index.py b/orchestrator/workflow/pure_replay_index.py
new file mode 100644
index 0000000..5f44c41
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_index.py
@@ -0,0 +1,478 @@
+"""Replay-eligibility and dependency index for compiler-generated pure projections.
+
+``derive_pure_result_replay_index`` inspects one loaded bundle (without mutating
+or serializing it) and reports which pure nodes may keep value-free completion
+shells, and which results/inputs each one depends on.
+
+Dependencies: ``LoadedWorkflowBundle`` (IR nodes, projection, runtime plan) and
+``references.parse_surface_ref`` for ref binding. No durable state is read.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from types import MappingProxyType
+from typing import Any, Iterable, Mapping
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    LeafExecutableNode,
+    LoopOutputAddress,
+    NodeResultAddress,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+    WorkflowRegion,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_replay_shell import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+from .references import (
+    ReferenceResolutionError,
+    SelfOutputReference,
+    StructuredStepReference,
+    SurfaceRefScopeCatalog,
+    WorkflowInputReference,
+    parse_surface_ref,
+)
+
+DURABLE_PUBLICATION = "durable_publication"
+NOT_COMPILER_GENERATED = "not_compiler_generated"
+FINALIZATION_REGION = "finalization_region"
+_PRIMITIVE_PYTHON = {"Bool": bool, "Int": int, "Float": float}
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    """One exact ref leaf: its location in the binding document and its address."""
+
+    path: tuple[str | int, ...]
+    address: BoundAddress
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[BoundAddress],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Pure nodes (topologically ordered) needed to rebuild ``seed_addresses``."""
+        reached = frozenset(reached_node_ids)
+        needed: set[str] = set()
+        pending = [
+            address.node_id
+            for address in seed_addresses
+            if getattr(address, "node_id", None) in self.nodes
+        ]
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            if node_id not in reached:
+                raise PureResultReplayIndexError(
+                    REACHABILITY_AMBIGUOUS,
+                    f"pure node {node_id!r} is needed but was not reached",
+                    context={"node_id": node_id},
+                )
+            needed.add(node_id)
+            pending.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(n for n in self.topological_node_ids if n in needed)
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        DEPENDENCY_INDEX_INVALID, message, context=context
+    )
+
+
+def _loop_owned_node_ids(nodes: Mapping[str, Any]) -> set[str]:
+    owned: set[str] = set()
+    stack = [n for n in nodes.values() if isinstance(n, (ForEachNode, RepeatUntilFrameNode))]
+    while stack:
+        loop = stack.pop()
+        for body_id in loop.body_node_ids:
+            if body_id in owned:
+                continue
+            owned.add(body_id)
+            body = nodes.get(body_id)
+            if isinstance(body, (ForEachNode, RepeatUntilFrameNode)):
+                stack.append(body)
+    return owned
+
+
+def _cyclic_node_ids(nodes: Mapping[str, Any]) -> set[str]:
+    """Nodes on a control-flow cycle (Tarjan SCCs of fallthrough/routed edges)."""
+    edges = {
+        node_id: [
+            t
+            for t in (
+                [node.fallthrough_node_id]
+                + [x.target_node_id for x in node.routed_transfers.values()]
+            )
+            if isinstance(t, str) and t in nodes
+        ]
+        for node_id, node in nodes.items()
+    }
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    on_stack: set[str] = set()
+    stack: list[str] = []
+    cyclic: set[str] = set()
+    counter = [0]
+
+    def visit(root: str) -> None:
+        work = [(root, iter(edges[root]))]
+        index[root] = low[root] = counter[0]
+        counter[0] += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            node_id, successors = work[-1]
+            for succ in successors:
+                if succ not in index:
+                    index[succ] = low[succ] = counter[0]
+                    counter[0] += 1
+                    stack.append(succ)
+                    on_stack.add(succ)
+                    work.append((succ, iter(edges[succ])))
+                    break
+                if succ in on_stack:
+                    low[node_id] = min(low[node_id], index[succ])
+            else:
+                work.pop()
+                if work:
+                    parent = work[-1][0]
+                    low[parent] = min(low[parent], low[node_id])
+                if low[node_id] == index[node_id]:
+                    component = []
+                    while True:
+                        member = stack.pop()
+                        on_stack.discard(member)
+                        component.append(member)
+                        if member == node_id:
+                            break
+                    if len(component) > 1 or node_id in edges[node_id]:
+                        cyclic.update(component)
+
+    for node_id in nodes:
+        if node_id not in index:
+            visit(node_id)
+    return cyclic
+
+
+def _propagate_pure_ineligibility(
+    nodes: Mapping[str, Any], reasons: dict[str, str]
+) -> None:
+    """Extend ineligibility to every pure node nested under an ineligible owner."""
+    for body_id in _loop_owned_node_ids(nodes):
+        node = nodes[body_id]
+        if node.kind is ExecutableNodeKind.PURE_PROJECTION:
+            reasons.setdefault(body_id, MULTIPLE_VISIT_REGION)
+
+
+def _type_error(path: tuple[Any, ...], expected: str) -> PureResultReplayIndexError:
+    return _invalid(
+        "binding literal does not match its declared type",
+        path=list(path),
+        expected=expected,
+    )
+
+
+def _is_ref_leaf(value: Any) -> bool:
+    return isinstance(value, Mapping) and "ref" in value
+
+
+def _check_literal(value: Any, descriptor: Mapping[str, Any], path: tuple[Any, ...]) -> None:
+    """Validate a binding document against ``descriptor``; exact ref leaves are skipped."""
+    if _is_ref_leaf(value):
+        if set(value) != {"ref"} or not isinstance(value["ref"], str) or not value["ref"]:
+            raise _invalid("malformed ref object", path=list(path))
+        return
+    kind = descriptor.get("kind")
+    if kind == "primitive":
+        py = _PRIMITIVE_PYTHON.get(descriptor["name"], str)
+        ok = type(value) is py or (py is float and type(value) is int)
+        if descriptor["name"] == "Json":
+            ok = True
+        if not ok:
+            raise _type_error(path, descriptor["name"])
+        if isinstance(value, str) and "${" in value:
+            raise _invalid("unbound text in binding literal", path=list(path))
+    elif kind in {"enum", "path"}:
+        if not isinstance(value, str) or (kind == "enum" and value not in descriptor["allowed"]):
+            raise _type_error(path, kind)
+    elif kind == "optional":
+        if value is not None:
+            _check_literal(value, descriptor["item"], path)
+    elif kind == "list":
+        if not isinstance(value, (list, tuple)):
+            raise _type_error(path, "list")
+        for i, item in enumerate(value):
+            _check_literal(item, descriptor["item"], path + (i,))
+    elif kind == "map":
+        if not isinstance(value, Mapping):
+            raise _type_error(path, "map")
+        for key, item in value.items():
+            _check_literal(key, descriptor["key"], path + (key,))
+            _check_literal(item, descriptor["value"], path + (key,))
+    elif kind == "record":
+        _check_fields(value, descriptor["fields"], path, extra_ok=())
+    elif kind in {"union", "variant_case"}:
+        _check_union(value, descriptor, path)
+    else:
+        raise _type_error(path, str(kind))
+
+
+def _check_fields(
+    value: Any,
+    required: Iterable[Mapping[str, Any]],
+    path: tuple[Any, ...],
+    *,
+    extra_ok: Iterable[str],
+) -> None:
+    if not isinstance(value, Mapping):
+        raise _type_error(path, "record")
+    required = list(required)
+    names = {f["name"] for f in required}
+    for field in required:
+        if field["name"] not in value:
+            raise _type_error(path + (field["name"],), "present field")
+        _check_literal(value[field["name"]], field["type"], path + (field["name"],))
+    allowed_extra = set(extra_ok)
+    for key in value:
+        if key not in names and key not in allowed_extra:
+            raise _type_error(path + (key,), "declared field")
+
+
+def _check_union(value: Any, descriptor: Mapping[str, Any], path: tuple[Any, ...]) -> None:
+    if not isinstance(value, Mapping) or not isinstance(value.get("variant"), str):
+        raise _type_error(path, "union with variant")
+    variants = (
+        [descriptor]
+        if descriptor["kind"] == "variant_case"
+        else list(descriptor["variants"])
+    )
+    name_key = "variant" if descriptor["kind"] == "variant_case" else "name"
+    active = next((v for v in variants if v[name_key] == value["variant"]), None)
+    if active is None:
+        raise _type_error(path, "declared variant")
+    active_names = {f["name"] for f in active["fields"]}
+    inactive: dict[str, list[Mapping[str, Any]]] = {}
+    for variant in variants:
+        for field in variant["fields"]:
+            if field["name"] not in active_names:
+                inactive.setdefault(field["name"], []).append(field["type"])
+    _check_fields(value, active["fields"], path, extra_ok={"variant", *inactive})
+    for name, types in inactive.items():
+        if name not in value:
+            continue
+        errors = []
+        for candidate in types:
+            try:
+                _check_literal(value[name], candidate, path + (name,))
+                break
+            except PureResultReplayIndexError as exc:
+                errors.append(exc)
+        else:
+            raise errors[0]
+
+
+def _ref_leaves(
+    value: Any, path: tuple[str | int, ...]
+) -> Iterable[tuple[tuple[str | int, ...], str]]:
+    if _is_ref_leaf(value):
+        yield path, value["ref"]
+    elif isinstance(value, Mapping):
+        for key, item in value.items():
+            yield from _ref_leaves(item, path + (key,))
+    elif isinstance(value, (list, tuple)):
+        for i, item in enumerate(value):
+            yield from _ref_leaves(item, path + (i,))
+
+
+def _bind_ref(ref: str, path: tuple[Any, ...], by_name: Mapping[str, Any]) -> BoundAddress:
+    try:
+        parsed = parse_surface_ref(
+            ref, SurfaceRefScopeCatalog(root_step_names=tuple(by_name))
+        )
+    except ReferenceResolutionError as exc:
+        raise _invalid("unbound ref text", ref=ref, path=list(path)) from exc
+    if isinstance(parsed, WorkflowInputReference):
+        return WorkflowInputAddress(input_name=parsed.input_name)
+    if isinstance(parsed, SelfOutputReference) or parsed.scope != "root":
+        raise _invalid("cross-frame ref in pure binding", ref=ref, path=list(path))
+    assert isinstance(parsed, StructuredStepReference)
+    target = by_name.get(parsed.step_name)
+    if target is None:
+        raise _invalid("ref names an unknown step", ref=ref, path=list(path))
+    if parsed.field == "artifacts" and parsed.member:
+        if target.kind in {ExecutableNodeKind.IF_JOIN, ExecutableNodeKind.MATCH_JOIN}:
+            return BlockOutputAddress(node_id=target.node_id, output_name=parsed.member)
+        if target.kind is ExecutableNodeKind.REPEAT_UNTIL_FRAME:
+            return LoopOutputAddress(node_id=target.node_id, output_name=parsed.member)
+        if target.kind is ExecutableNodeKind.CALL_BOUNDARY:
+            return CallOutputAddress(node_id=target.node_id, output_name=parsed.member)
+    return NodeResultAddress(
+        node_id=target.node_id, field=parsed.field, member=parsed.member
+    )
+
+
+def _check_projection_identity(bundle: LoadedWorkflowBundle, nodes: Mapping[str, Any]) -> None:
+    projection = bundle.projection
+    for field_name in ("step_id", "presentation_name"):
+        seen: dict[str, str] = {}
+        for node in nodes.values():
+            key = getattr(node, field_name)
+            if key in seen:
+                raise _invalid(
+                    "duplicate projection authority", key=key, nodes=[seen[key], node.node_id]
+                )
+            seen[key] = node.node_id
+    for node in nodes.values():
+        entry = projection.entries_by_node_id.get(node.node_id)
+        if (
+            entry is None
+            or entry.step_id != node.step_id
+            or entry.presentation_key != node.presentation_name
+            or projection.node_id_by_step_id.get(node.step_id) != node.node_id
+        ):
+            raise _invalid("projection identity mismatch", node_id=node.node_id)
+
+
+def _build_node(
+    node: Any, by_name: Mapping[str, Any]
+) -> tuple[PureReplayNode, list[BoundAddress]]:
+    config = node.execution_config.pure_projection
+    refs = config.get("binding_refs")
+    contracts = config.get("output_contracts")
+    declared = (config.get("payload") or {}).get("bindings")
+    if not isinstance(refs, Mapping) or not isinstance(contracts, Mapping) or not isinstance(declared, Mapping):
+        raise _invalid("pure projection config is malformed", node_id=node.node_id)
+    bindings: list[PureReplayBinding] = []
+    for name, document in refs.items():
+        spec = declared.get(name)
+        if not isinstance(spec, Mapping) or "type" not in spec:
+            raise _invalid("binding has no declared type", binding=name)
+        _check_literal(document, spec["type"], (name,))
+        for path, ref in _ref_leaves(document, (name,)):
+            bindings.append(PureReplayBinding(path, _bind_ref(ref, path, by_name)))
+    outputs = tuple(
+        NodeResultAddress(node_id=node.node_id, field="artifacts", member=name)
+        for name in contracts
+    )
+    built = PureReplayNode(
+        node_id=node.node_id,
+        step_id=node.step_id,
+        presentation_key=node.presentation_name,
+        bindings=tuple(bindings),
+        output_addresses=outputs,
+        output_contracts=MappingProxyType(dict(contracts)),
+        pure_dependency_node_ids=(),
+        durable_dependency_node_ids=(),
+    )
+    return built, [b.address for b in bindings]
+
+
+def _topological_order(deps: Mapping[str, tuple[str, ...]], order: list[str]) -> tuple[str, ...]:
+    done: list[str] = []
+    state: dict[str, int] = {}
+
+    def visit(node_id: str) -> None:
+        if state.get(node_id) == 2:
+            return
+        if state.get(node_id) == 1:
+            raise _invalid("pure dependency cycle", node_id=node_id)
+        state[node_id] = 1
+        for dep in deps[node_id]:
+            visit(dep)
+        state[node_id] = 2
+        done.append(node_id)
+
+    for node_id in order:
+        visit(node_id)
+    return tuple(done)
+
+
+def derive_pure_result_replay_index(
+    bundle: LoadedWorkflowBundle, *, scope_kind: str = "root"
+) -> PureResultReplayIndex:
+    """Derive eligibility and dependencies for ``bundle``'s own pure nodes."""
+    actual_scope = "root"  # an imported bundle is always indexed as its own root
+    if scope_kind != actual_scope:
+        raise _invalid(
+            "scope_kind does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=actual_scope,
+        )
+    nodes = bundle.ir.nodes
+    pure_ids = [
+        nid for nid, n in nodes.items() if n.kind is ExecutableNodeKind.PURE_PROJECTION
+    ]
+    reasons: dict[str, str] = {}
+    generated = bundle.provenance.frontend_kind == "workflow_lisp"
+    cyclic = _cyclic_node_ids(nodes)
+    for nid in pure_ids:
+        node = nodes[nid]
+        if not generated:
+            reasons[nid] = NOT_COMPILER_GENERATED
+        elif not isinstance(node, LeafExecutableNode) or node.region is not WorkflowRegion.BODY:
+            reasons[nid] = FINALIZATION_REGION
+        elif nid in cyclic:
+            reasons[nid] = MULTIPLE_VISIT_REGION
+        elif node.execution_config.common.publishes or node.execution_config.common.consumes:
+            reasons[nid] = DURABLE_PUBLICATION
+    _propagate_pure_ineligibility(nodes, reasons)
+    eligible = [nid for nid in pure_ids if nid not in reasons]
+    _check_projection_identity(bundle, {nid: nodes[nid] for nid in eligible})
+
+    by_name = {
+        nodes[nid].presentation_name: nodes[nid]
+        for nid in bundle.projection.ordered_execution_node_ids()
+        if nid in nodes
+    }
+    built: dict[str, PureReplayNode] = {}
+    addresses: dict[str, list[BoundAddress]] = {}
+    for nid in eligible:
+        built[nid], addresses[nid] = _build_node(nodes[nid], by_name)
+    for nid, node in list(built.items()):
+        targets = [a.node_id for a in addresses[nid] if hasattr(a, "node_id")]
+        pure = tuple(dict.fromkeys(t for t in targets if t in built))
+        durable = tuple(dict.fromkeys(t for t in targets if t not in built))
+        built[nid] = PureReplayNode(
+            **{**node.__dict__, "pure_dependency_node_ids": pure, "durable_dependency_node_ids": durable}
+        )
+    order = _topological_order(
+        {nid: n.pure_dependency_node_ids for nid, n in built.items()}, eligible
+    )
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=MappingProxyType(built),
+        topological_node_ids=order,
+        ineligible_pure_reasons=MappingProxyType(reasons),
+    )

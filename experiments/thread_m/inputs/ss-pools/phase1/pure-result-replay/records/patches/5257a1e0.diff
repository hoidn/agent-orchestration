+def test_progress_classification_valid_forms() -> None:
+    unrelated = _cursor(name="other", step_id="root.other")
+    failed = {**SHELL, "status": "failed", "exit_code": 2}
+    skipped = {**SHELL, "status": "skipped"}
+    assert classify_pure_replay_progress(_state(), witness=WITNESS) == "unstarted"
+    assert classify_pure_replay_progress(_state(cursor=unrelated), witness=WITNESS) == "unstarted"
+    assert (
+        classify_pure_replay_progress(_state(visit=1, cursor=_cursor()), witness=WITNESS)
+        == "interrupted"
+    )
+    assert (
+        classify_pure_replay_progress(_state(visit=1, row=SHELL), witness=WITNESS)
+        == "derived_complete"
+    )
+    assert (
+        classify_pure_replay_progress(
+            _state(visit=1, row=SHELL, cursor=unrelated), witness=WITNESS
+        )
+        == "derived_complete"
+    )
+    for row in (failed, skipped):
+        assert (
+            classify_pure_replay_progress(_state(visit=1, row=row), witness=WITNESS)
+            == "durable_failure_skip"
+        )
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _state(visit=1),
+        _state(cursor=_cursor()),
+        _state(row=SHELL),
+        _state(visit=1, cursor=_cursor(), row=SHELL),
+        _state(visit=2, cursor=_cursor(visit_count=2)),
+        _state(visit=2, row={**SHELL, "visit_count": 2}),
+        _state(visit=1, cursor=_cursor(step_id="root.else")),
+        _state(visit=1, cursor=_cursor(index=9)),
+        _state(visit=1, cursor=_cursor(type="command")),
+        _state(visit=1, cursor=_cursor(status="failed")),
+        _state(visit=1, row={**SHELL, "value": 1}),
+        _state(visit=1, row={**SHELL, "status": "running"}),
+        _state(visit=1, row={**SHELL, "status": "failed", "visit_count": 2}),
+        _state(visit=1, row={**SHELL, "status": "failed", "step_id": "root.else"}),
+        _state(visit=1, cursor=_cursor(), row={**SHELL, "status": "failed"}),
+    ],
+)
+def test_progress_classification_rejects_invalid_forms(state: dict) -> None:
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        classify_pure_replay_progress(state, witness=WITNESS)
+    assert excinfo.value.reason == "progress_witness_invalid"
+    assert excinfo.value.code == "pure_result_replay_unavailable"
+

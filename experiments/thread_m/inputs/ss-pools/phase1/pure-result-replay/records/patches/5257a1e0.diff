+from orchestrator.cli.main import main as cli_main
+from orchestrator.state import StateManager
+from orchestrator.workflow.executable_ir import PureProjectionStepConfig
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_result_replay import (
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_PURE_REPLAY_PROFILE,
+    MULTIPLE_VISIT_REGION,
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow.resume_planner import ResumePlanner
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.lexical_checkpoint_default_resume import (
+    determine_runtime_default_resume_decision,
+)
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+
+VALID_FIXTURES = Path(__file__).resolve().parent / "fixtures" / "workflow_lisp" / "valid"
+
+CONDITIONAL_EFFECT = """\
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule two)
+  (export orchestrate)
+  (defrecord Checks (n Int) (label String))
+  (defworkflow orchestrate ((c Int)) -> Checks
+    (let* ((a (command-result step_a :argv ("python" "scripts/step_a.py") :returns Checks))
+           (go (> a.n c)))
+      (if go
+        (command-result step_b :argv ("python" "scripts/step_b.py") :returns Checks)
+        (record Checks :n 0 :label "none")))))
+"""
+
+PURE_BEFORE_FIRST_EFFECT = """\
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule early)
+  (export orchestrate)
+  (defrecord Checks (n Int) (label String))
+  (defworkflow orchestrate ((c Int)) -> Checks
+    (let* ((go (> c 0)))
+      (if go
+        (command-result step_a :argv ("python" "scripts/step_a.py") :returns Checks)
+        (record Checks :n 0 :label "none")))))
+"""
+
+CALLER_AND_CALLEE = """\
+(workflow-lisp
+  (:language "0.1")
+  (:target-dsl "2.14")
+  (defmodule callpair)
+  (export orchestrate)
+  (defrecord Res (count Int))
+  (defworkflow helper ((count Int)) -> Res
+    (record Res :count (+ count 1)))
+  (defworkflow orchestrate ((count Int)) -> Res
+    (call helper :count count)))
+"""
+
+SCRIPT = """\
+import os, pathlib, sys
+bundle = pathlib.Path(os.environ["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"])
+bundle.parent.mkdir(parents=True, exist_ok=True)
+fail = {fail}
+if fail and not pathlib.Path("state/allow_{name}").exists():
+    open("state/log.txt", "a").write("{name}-failed\\n")
+    sys.exit(1)
+bundle.write_text('{{"n": {n}, "label": "{label}"}}')
+open("state/log.txt", "a").write("{name}\\n")
+"""
+
+
+class Project:
+    """A scratch workspace holding one compiled `.orc` program."""
+
+    def __init__(self, root: Path, source: str, module: str, tools=("step_a", "step_b")):
+        self.root = root
+        (root / "scripts").mkdir()
+        (root / "state").mkdir()
+        for name, fail in (("step_a", False), ("step_b", True)):
+            (root / "scripts" / f"{name}.py").write_text(
+                SCRIPT.format(name=name, fail=fail, n=5 if name == "step_a" else 7, label=name[-1].upper()),
+                encoding="utf-8",
+            )
+        self.orc = root / f"{module}.orc"
+        self.orc.write_text(source, encoding="utf-8")
+        result = compile_stage3_entrypoint(
+            self.orc,
+            source_roots=(root,),
+            provider_externs={},
+            prompt_externs={},
+            command_boundaries={
+                name: ExternalToolBinding(name=name, stable_command=("python", f"scripts/{name}.py"))
+                for name in tools
+            },
+            validate_shared=True,
+            workspace_root=root,
+        )
+        self.bundle = next(
+            b for n, b in result.validated_bundles_by_name.items() if n.endswith("::orchestrate")
+        )
+
+    def start(self, inputs, *, profile=DERIVED_PURE_REPLAY_PROFILE, run_id="r1") -> StateManager:
+        manager = StateManager(self.root, run_id=run_id)
+        manager.initialize(
+            self.orc.name, {}, bound_inputs=dict(inputs), result_persistence_profile=profile
+        )
+        return manager
+
+    def executor(self, manager: StateManager) -> WorkflowExecutor:
+        return WorkflowExecutor(self.bundle, self.root, manager, provider_observation_enabled=False)
+
+    def resume(self, run_id="r1"):
+        manager = StateManager(self.root, run_id=run_id)
+        manager.load()
+        return self.executor(manager).execute(resume=True)
+
+    def state(self, run_id="r1") -> dict:
+        return json.loads((self.root / ".orchestrate" / "runs" / run_id / "state.json").read_text())
+
+    def write_state(self, payload: dict, run_id="r1") -> None:
+        path = self.root / ".orchestrate" / "runs" / run_id / "state.json"
+        path.write_text(json.dumps(payload), encoding="utf-8")
+
+    def interrupt_after(self, presentation_name: str, run_id="r1") -> None:
+        """Rewind durable state to just after ``presentation_name`` committed."""
+        state = self.state(run_id)
+        order = [
+            self.bundle.projection.entries_by_node_id[n].presentation_key
+            for n in self.bundle.projection.ordered_execution_node_ids()
+        ]
+        for name in order[order.index(presentation_name) + 1 :]:
+            state["steps"].pop(name, None)
+            state["step_visits"].pop(name, None)
+        state.update(status="running", workflow_outputs={}, error=None, current_step=None)
+        self.write_state(state, run_id)
+
+    @property
+    def log(self) -> list[str]:
+        path = self.root / "state" / "log.txt"
+        return path.read_text().split() if path.exists() else []
+

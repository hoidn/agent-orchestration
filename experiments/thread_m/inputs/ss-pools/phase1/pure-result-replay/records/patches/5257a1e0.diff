index 0000000..cdd98ba
--- /dev/null
+++ b/orchestrator/workflow/pure_replay_shell.py
@@ -0,0 +1,185 @@
+"""Value-free completion shell and progress classification for derived pure replay.
+
+Dependencies: none beyond the stdlib. The shell, witness and classifier operate
+on plain state mappings (``RunState.to_dict()`` shape) so ``StateManager`` can
+use them without importing the replay runtime.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+DERIVED_PURE_REPLAY_PROFILE = "derived_pure_replay.v1"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+PURE_PROJECTION_TYPE = "pure_projection"
+
+PROGRESS_UNSTARTED = "unstarted"
+PROGRESS_INTERRUPTED = "interrupted"
+PROGRESS_DERIVED_COMPLETE = "derived_complete"
+PROGRESS_DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed replay error carrying a machine-readable reason."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit eligible pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def _progress_error(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID, message, context=context
+    )
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Build the exact value-free completed row for one eligible pure visit."""
+    if witness.visit_count != 1:
+        raise ValueError("pure completion shell requires a single visit")
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _canonical(value: Any) -> str:
+    # Canonical JSON keeps True/1 and 1/1.0 distinct, unlike ==.
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _is_exact_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    if not isinstance(row, Mapping):
+        return False
+    try:
+        return _canonical(dict(row)) == _canonical(build_pure_completion_shell(witness))
+    except (TypeError, ValueError):
+        return False
+
+
+def validate_pure_completion_shell(
+    row: Any, *, witness: PureReplayVisitWitness
+) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the witness's shell."""
+    if not _is_exact_shell(row, witness):
+        raise ValueError(
+            f"row for {witness.presentation_key!r} is not the exact pure completion shell"
+        )
+
+
+def _mapping(value: Any) -> Mapping[str, Any]:
+    return value if isinstance(value, Mapping) else {}
+
+
+def _cursor_is_related(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def pure_cursor_matches(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    """Whether ``cursor`` is the exact running cursor for the witness."""
+    return (
+        isinstance(cursor, Mapping)
+        and cursor.get("name") == witness.presentation_key
+        and cursor.get("step_id") == witness.step_id
+        and cursor.get("index") == witness.step_index
+        and not isinstance(cursor.get("index"), bool)
+        and cursor.get("type") == PURE_PROJECTION_TYPE
+        and cursor.get("status") == "running"
+        and cursor.get("visit_count") == witness.visit_count
+        and not isinstance(cursor.get("visit_count"), bool)
+    )
+
+
+def _is_failure_row(row: Any, witness: PureReplayVisitWitness) -> bool:
+    return (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("name") == witness.presentation_key
+        and row.get("step_id") == witness.step_id
+        and row.get("visit_count") == witness.visit_count
+        and not isinstance(row.get("visit_count"), bool)
+    )
+
+
+def classify_pure_replay_progress(
+    state: Mapping[str, Any], *, witness: PureReplayVisitWitness
+) -> str:
+    """Classify visit, cursor and row for one witness.
+
+    Returns one of ``unstarted``, ``interrupted``, ``derived_complete`` or
+    ``durable_failure_skip``; raises ``progress_witness_invalid`` otherwise.
+    """
+    if witness.visit_count != 1:
+        raise _progress_error(
+            "eligible pure nodes are single-visit", step=witness.presentation_key
+        )
+    name = witness.presentation_key
+    visit = _mapping(state.get("step_visits")).get(name)
+    cursor = state.get("current_step")
+    related = _cursor_is_related(cursor, witness)
+    row = _mapping(state.get("steps")).get(name)
+    has_row = name in _mapping(state.get("steps"))
+
+    if visit is None:
+        if not related and not has_row:
+            return PROGRESS_UNSTARTED
+        raise _progress_error(
+            "cursor or row exists without a recorded visit", step=name
+        )
+    if visit != witness.visit_count or isinstance(visit, bool):
+        raise _progress_error(
+            "recorded visit does not match the witness",
+            step=name,
+            recorded=visit,
+            expected=witness.visit_count,
+        )
+    if related:
+        if not has_row and pure_cursor_matches(cursor, witness):
+            return PROGRESS_INTERRUPTED
+        raise _progress_error("pure cursor does not match the witness", step=name)
+    if not has_row:
+        raise _progress_error("visit has neither cursor nor row", step=name)
+    if _is_exact_shell(row, witness):
+        return PROGRESS_DERIVED_COMPLETE
+    if _is_failure_row(row, witness):
+        return PROGRESS_DURABLE_FAILURE_SKIP
+    raise _progress_error("pure row is not a shell, failure or skip", step=name)
diff --git a/orchestrator/workflow/pure_result_replay.py b/orchestrator/workflow/pure_result_replay.py
new file mode 100644
index 0000000..28c0987
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,489 @@
+"""Derived pure-result replay runtime (profile ``derived_pure_replay.v1``).
+
+Under the profile an eligible compiler-generated pure projection persists only a
+value-free completion shell. ``PureReplayRuntime`` re-derives the values a resumed
+run needs from durable leaves (bound inputs, effect rows) in memory.
+
+Dependencies: ``derive_pure_result_replay_index`` for eligibility, the shell
+module for row/progress contracts, and the loaded bundle's IR/projection. It never
+dispatches effects, increments visits, settles results or writes durable state;
+the only mutable state is a process-local cache of validated full rows.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import re
+from copy import deepcopy
+from pathlib import Path
+from typing import Any, Callable, Mapping, Optional
+
+from .executable_ir import (
+    BlockOutputAddress,
+    BoundAddress,
+    CallOutputAddress,
+    LoopOutputAddress,
+    NodeResultAddress,
+    WorkflowInputAddress,
+)
+from .loaded_bundle import LoadedWorkflowBundle
+from .pure_replay_index import (  # noqa: F401  (re-exported)
+    PureReplayBinding,
+    PureReplayNode,
+    PureResultReplayIndex,
+    _propagate_pure_ineligibility,
+    derive_pure_result_replay_index,
+)
+from .pure_replay_shell import (  # noqa: F401  (re-exported)
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_PURE_REPLAY_PROFILE,
+    MULTIPLE_VISIT_REGION,
+    PROFILE_CONFLICT,
+    PROGRESS_DERIVED_COMPLETE,
+    PROGRESS_WITNESS_INVALID,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+from .references import ReferenceResolutionError, parse_structured_ref
+from .resume_projection_integrity import ResumeScopePath
+
+_REF_TEXT = re.compile(r"root\.steps\.[^\s'\"{}\[\]),]+")
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def expected_output_names(
+    contracts: Mapping[str, Any], artifacts: Mapping[str, Any]
+) -> set[str]:
+    """Names a transient row must hold: all outputs minus inactive union members."""
+    expected: set[str] = set()
+    for name, contract in contracts.items():
+        projection = contract.get("projection") if isinstance(contract, Mapping) else None
+        if (
+            isinstance(projection, Mapping)
+            and projection.get("projection_class") == "union_workflow_boundary"
+            and projection.get("field_role") == "variant"
+        ):
+            active = artifacts.get(projection.get("discriminant_output"))
+            if active not in (projection.get("active_variants") or ()):
+                continue
+        expected.add(name)
+    return expected
+
+
+def _input_matches(value: Any, definition: Mapping[str, Any]) -> bool:
+    kind = definition.get("type")
+    if kind == "integer":
+        return type(value) is int
+    if kind == "float":
+        return type(value) in (int, float)
+    if kind == "bool":
+        return type(value) is bool
+    if kind == "enum":
+        return isinstance(value, str) and value in (definition.get("allowed") or ())
+    if kind in {"string", "relpath"}:
+        return isinstance(value, str)
+    if kind == "list":
+        return isinstance(value, list)
+    if kind == "map":
+        return isinstance(value, dict)
+    return True
+
+
+_INTRINSIC_TYPES: dict[tuple[str, Optional[str]], Callable[[Any], bool]] = {
+    ("exit_code", None): lambda v: type(v) is int,
+    ("outcome", "status"): lambda v: isinstance(v, str),
+    ("outcome", "phase"): lambda v: isinstance(v, str),
+    ("outcome", "class"): lambda v: isinstance(v, str),
+    ("outcome", "retryable"): lambda v: type(v) is bool,
+}
+
+
+def _failure_reason(result: Mapping[str, Any]) -> tuple[str, str]:
+    error = result.get("error") if isinstance(result.get("error"), Mapping) else {}
+    context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+    if error.get("type") == "materialize_ref_unresolved":
+        return "binding_unresolved", "materialize_ref_unresolved"
+    if context.get("reason") in {
+        "pure_projection_contract_invalid",
+        "invalid_reused_pure_projection_result",
+    }:
+        return "output_contract_invalid", "pure_projection_contract_invalid"
+    return "evaluation_failed", "pure_evaluation_failed"
+
+
+class PureReplayRuntime:
+    """Process-local replay of eligible pure nodes for one workflow scope."""
+
+    def __init__(self, *, bundle: LoadedWorkflowBundle, scope_path: ResumeScopePath):
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index = derive_pure_result_replay_index(bundle)
+        self._by_step_id = {n.step_id: n.node_id for n in self.index.nodes.values()}
+        self._cache: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._node_by_name = {n.presentation_name: n for n in bundle.ir.nodes.values()}
+
+    # -- identity ---------------------------------------------------------
+    def _node(self, node_id: str) -> PureReplayNode:
+        node = self.index.nodes.get(node_id)
+        if node is None:
+            raise _error(DEPENDENCY_INDEX_INVALID, "node is not replay-eligible", node_id=node_id)
+        return node
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._by_step_id.get(step_id)
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        step_index = self.bundle.projection.execution_index_for_step_id(node.step_id)
+        return PureReplayVisitWitness(
+            node.presentation_key, step_index if step_index is not None else -1,
+            node.step_id, visit_count,
+        )
+
+    def witness_from_state(self, node_id: str, state: Mapping[str, Any]) -> PureReplayVisitWitness:
+        key = self._node(node_id).presentation_key
+        visits = state.get("step_visits")
+        visit = visits.get(key) if isinstance(visits, Mapping) else None
+        ok = isinstance(visit, int) and not isinstance(visit, bool)
+        return self.witness(node_id, visit_count=visit if ok else 1)
+
+    # -- cache ------------------------------------------------------------
+    def _check_artifacts(self, node: PureReplayNode, artifacts: Any) -> dict[str, Any]:
+        if not isinstance(artifacts, Mapping):
+            raise _error(DEPENDENCY_INDEX_INVALID, "pure row has no artifacts", node_id=node.node_id)
+        expected = expected_output_names(node.output_contracts, artifacts)
+        if set(artifacts) != expected:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                "pure row outputs do not match the active contract members",
+                node_id=node.node_id,
+                missing=sorted(expected - set(artifacts)),
+                extra=sorted(set(artifacts) - expected),
+            )
+        return dict(artifacts)
+
+    def record_full_result(
+        self, node_id: str, *, witness: PureReplayVisitWitness, result: Mapping[str, Any]
+    ) -> None:
+        """Hold an active executor's validated full result for later cache hits."""
+        node = self._node(node_id)
+        expected = self.witness(node_id, visit_count=1)
+        if witness != expected and (
+            witness.presentation_key != node.presentation_key
+            or witness.step_id != node.step_id
+            or witness.visit_count != 1
+        ):
+            raise _error(PROGRESS_WITNESS_INVALID, "witness does not match node", node_id=node_id)
+        if result.get("status") != "completed":
+            raise _error(DEPENDENCY_INDEX_INVALID, "active result is not completed", node_id=node_id)
+        self._check_artifacts(node, result.get("artifacts"))
+        self._cache[node_id] = (witness, deepcopy(dict(result)))
+
+    def _cached_row(
+        self, node_id: str, state: Mapping[str, Any]
+    ) -> Optional[dict[str, Any]]:
+        """Revalidate a cache entry against current state authority."""
+        entry = self._cache.get(node_id)
+        if entry is None:
+            return None
+        witness, row = entry
+        key = witness.presentation_key
+        visits = state.get("step_visits")
+        if not isinstance(visits, Mapping) or visits.get(key) != 1 or isinstance(visits.get(key), bool):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure visit is not one", step=key)
+        durable = (state.get("steps") or {}).get(key) if isinstance(state.get("steps"), Mapping) else None
+        if not isinstance(durable, Mapping):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure row is missing", step=key)
+        cursor = state.get("current_step")
+        related = isinstance(cursor, Mapping) and (
+            cursor.get("name") == key or cursor.get("step_id") == witness.step_id
+        )
+        if dict(durable) == row and "artifacts" in row:
+            # Active form: the in-memory row is exactly the validated result.
+            if related:
+                raise _error(PROGRESS_WITNESS_INVALID, "cursor targets the active pure row", step=key)
+        elif classify_pure_replay_progress(state, witness=witness) != PROGRESS_DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure row is not the durable shell", step=key)
+        return row
+
+    def overlay_active_state(self, state: Mapping[str, Any]) -> dict[str, Any]:
+        """Copy of ``state`` with validated cached full rows over eligible shells."""
+        overlay = dict(state)
+        steps = dict(state.get("steps") or {})
+        for node_id in self._cache:
+            row = self._cached_row(node_id, state)
+            if row is not None:
+                steps[self._cache[node_id][0].presentation_key] = deepcopy(row)
+        overlay["steps"] = steps
+        return overlay
+
+    # -- address resolution ----------------------------------------------
+    def _row(self, node_id: str, state: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
+        if node_id in self.index.nodes:
+            return self._cached_row(node_id, state)
+        node = self.bundle.ir.nodes.get(node_id)
+        steps = state.get("steps")
+        if node is None or not isinstance(steps, Mapping):
+            return None
+        row = steps.get(node.presentation_name)
+        return row if isinstance(row, Mapping) else None
+
+    def resolve_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> tuple[bool, Any]:
+        if isinstance(address, WorkflowInputAddress):
+            inputs = state.get("bound_inputs")
+            if not isinstance(inputs, Mapping) or address.input_name not in inputs:
+                return False, None
+            value = inputs[address.input_name]
+            contract = self.bundle.ir.inputs.get(address.input_name)
+            definition = contract.definition if contract is not None else {}
+            if isinstance(definition, Mapping) and not _input_matches(value, definition):
+                raise _error("durable_input_invalid", "bound input has the wrong type", input=address.input_name)
+            return True, value
+        row = self._row(address.node_id, state)
+        if row is None or row.get("status") != "completed":
+            return False, None
+        if isinstance(address, NodeResultAddress) and address.field != "artifacts":
+            if address.field == "exit_code":
+                found, value = "exit_code" in row, row.get("exit_code")
+            else:
+                outcome = row.get("outcome")
+                found = isinstance(outcome, Mapping) and address.member in outcome
+                value = outcome.get(address.member) if found else None
+            check = _INTRINSIC_TYPES.get((address.field, address.member if address.field == "outcome" else None))
+            if found and check is not None and not check(value):
+                raise _error("durable_input_invalid", "durable intrinsic has the wrong type", address=repr(address))
+            return found, value
+        member = address.member if isinstance(address, NodeResultAddress) else address.output_name
+        artifacts = row.get("artifacts")
+        if not isinstance(artifacts, Mapping) or member not in artifacts:
+            return False, None
+        return True, artifacts[member]
+
+    def value_for_state_address(self, address: BoundAddress, state: Mapping[str, Any]) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _error("durable_input_missing", "durable leaf is missing", address=repr(address))
+        return value
+
+    # -- replay -----------------------------------------------------------
+    def replay_node(
+        self,
+        node_id: str,
+        *,
+        state: Mapping[str, Any],
+        evaluate_node: Callable[[PureReplayNode, dict[str, Any]], Any],
+    ) -> dict[str, Any]:
+        """Re-derive one node's row in memory; never writes durable state."""
+        node = self._node(node_id)
+        cached = self._cached_row(node_id, state)
+        if cached is not None:
+            return cached
+        witness = self.witness_from_state(node_id, state)
+        if classify_pure_replay_progress(state, witness=witness) != PROGRESS_DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "node is not a derived completion", node_id=node_id)
+        for dependency in node.pure_dependency_node_ids:
+            self.replay_node(dependency, state=state, evaluate_node=evaluate_node)
+        self._audit_leaves(node, state)
+        try:
+            outcome = evaluate_node(node, self.overlay_active_state(state))
+        except PureResultReplayIndexError:
+            raise
+        except Exception as exc:
+            raise _error(
+                "evaluation_failed", f"pure evaluation failed: {exc}",
+                node_id=node_id, cause={"type": "pure_evaluation_failed"},
+            ) from exc
+        if not isinstance(outcome, Mapping):
+            raise _error(DEPENDENCY_INDEX_INVALID, "evaluator returned no result", node_id=node_id)
+        if outcome.get("status", "completed") != "completed":
+            reason, cause = _failure_reason(outcome)
+            raise _error(reason, "pure replay evaluation failed", node_id=node_id, cause={"type": cause})
+        artifacts = self._check_artifacts(node, outcome.get("artifacts"))
+        row = {**build_pure_completion_shell(witness), "artifacts": artifacts}
+        self._cache[node_id] = (witness, row)
+        return row
+
+    # -- boundary analysis -----------------------------------------------
+    def _addresses_in(self, value: Any, found: list[BoundAddress], seen: set[int]) -> None:
+        if isinstance(value, (NodeResultAddress, BlockOutputAddress, LoopOutputAddress, CallOutputAddress)):
+            found.append(value)
+        elif isinstance(value, str):
+            for text in _REF_TEXT.findall(value):
+                try:
+                    target = parse_structured_ref(text, self._node_by_name)
+                except ReferenceResolutionError:
+                    continue
+                node = self._node_by_name.get(target.step_name)
+                if node is not None:
+                    found.append(NodeResultAddress(node.node_id, target.field, target.member))
+        elif id(value) in seen:
+            return
+        elif isinstance(value, Mapping):
+            seen.add(id(value))
+            for item in value.values():
+                self._addresses_in(item, found, seen)
+        elif isinstance(value, (list, tuple)):
+            seen.add(id(value))
+            for item in value:
+                self._addresses_in(item, found, seen)
+        elif dataclasses.is_dataclass(value) and not isinstance(value, type):
+            seen.add(id(value))
+            for f in dataclasses.fields(value):
+                self._addresses_in(getattr(value, f.name), found, seen)
+
+    def _owner_index(self, order: Mapping[str, int]) -> dict[str, int]:
+        owner: dict[str, int] = {}
+        for node_id, node in self.bundle.ir.nodes.items():
+            if node_id in order:
+                owner[node_id] = order[node_id]
+            for body_id in getattr(node, "body_node_ids", ()):
+                if node_id in order:
+                    owner[body_id] = order[node_id]
+        return owner
+
+    def required_node_ids_for_boundary(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        """Derived-complete pure nodes whose values the run needs at/after the boundary."""
+        order = {n: i for i, n in enumerate(self.bundle.projection.ordered_execution_node_ids())}
+        restart = order.get(restart_node_id, len(order)) if restart_node_id else len(order)
+        owner = self._owner_index(order)
+        found: list[BoundAddress] = []
+        seen: set[int] = set()
+        self._addresses_in(dict(self.bundle.ir.outputs), found, seen)
+        for node_id, node in self.bundle.ir.nodes.items():
+            if owner.get(node_id, len(order)) >= restart:
+                self._addresses_in(node, found, seen)
+        steps = state.get("steps") if isinstance(state.get("steps"), Mapping) else {}
+        reached = {
+            nid for nid, n in self.bundle.ir.nodes.items() if n.presentation_name in steps
+        }
+        seeds = [
+            a for a in found
+            if a.node_id in self.index.nodes and owner.get(a.node_id, len(order)) < restart
+        ]
+        required = self.index.required_pure_node_ids(seeds, reached_node_ids=reached)
+        return tuple(
+            n for n in required
+            if classify_pure_replay_progress(state, witness=self.witness_from_state(n, state))
+            == PROGRESS_DERIVED_COMPLETE
+        )
+
+    def audit_boundary_leaves(
+        self, restart_node_id: Optional[str], *, state: Mapping[str, Any]
+    ) -> tuple[str, ...]:
+        """Validate the durable leaves of every required pure node; no evaluation."""
+        required = self.required_node_ids_for_boundary(restart_node_id, state=state)
+        for node_id in required:
+            self._audit_leaves(self.index.nodes[node_id], state)
+        return required
+
+    def _audit_leaves(self, node: PureReplayNode, state: Mapping[str, Any]) -> None:
+        """Bound inputs must exist and be well typed; durable intrinsics well typed.
+
+        Missing durable effect rows/artifacts are left to the evaluator, which
+        reports them as unresolved bindings.
+        """
+        for binding in node.bindings:
+            address = binding.address
+            if isinstance(address, WorkflowInputAddress):
+                self.value_for_state_address(address, state)
+            elif isinstance(address, NodeResultAddress) and address.field != "artifacts":
+                self.resolve_state_address(address, state)
+
+    # -- persisted surfaces ----------------------------------------------
+    def audit_persisted_surfaces(
+        self,
+        *,
+        state: Mapping[str, Any],
+        state_manager: Any,
+        resolve_bundle_path: Callable[[PureReplayNode], Optional[Path | str]],
+    ) -> None:
+        """Raise ``profile_conflict`` for any durable value surface of an eligible node."""
+        steps = state.get("steps") if isinstance(state.get("steps"), Mapping) else {}
+        private = state.get("private_artifact_versions")
+        frame_id = self.scope_path.call_frame_ids[-1] if self.scope_path.call_frame_ids else None
+        for node in self.index.nodes.values():
+            row = steps.get(node.presentation_key)
+            if (
+                isinstance(row, Mapping)
+                and row.get("status") == "completed"
+                and set(row) != set(build_pure_completion_shell(self.witness(node.node_id)))
+            ):
+                raise _error(PROFILE_CONFLICT, "eligible pure node has a value row",
+                             surface="steps", node_id=node.node_id)
+            path = resolve_bundle_path(node)
+            if path is not None and Path(path).exists():
+                raise _error(PROFILE_CONFLICT, "eligible pure node has a result bundle",
+                             surface="pure_bundle", node_id=node.node_id)
+            for versions in (private.values() if isinstance(private, Mapping) else ()):
+                for entry in versions if isinstance(versions, list) else ():
+                    if isinstance(entry, Mapping) and (
+                        entry.get("producer") == node.step_id
+                        or entry.get("producer_name") == node.presentation_key
+                    ):
+                        raise _error(PROFILE_CONFLICT, "eligible pure node has private lineage",
+                                     surface="private_artifact_versions", node_id=node.node_id)
+        self._audit_checkpoint_surfaces(state_manager, frame_id)
+
+    def _audit_checkpoint_surfaces(self, state_manager: Any, frame_id: Optional[str]) -> None:
+        from orchestrator.workflow_lisp import lexical_checkpoints as checkpoints
+
+        eligible_step_ids = {n.step_id for n in self.index.nodes.values()}
+        for point in self.bundle.runtime_plan.lexical_checkpoint_points:
+            index_path = checkpoints.resolve_checkpoint_index_path(
+                state_manager=state_manager,
+                workflow_name=point.workflow_name,
+                checkpoint_id=point.checkpoint_id,
+            )
+            index = state_manager.read_runtime_sidecar_json(index_path)
+            for entry in (index or {}).get("records", ()):
+                identity = entry.get("frame_identity") or {}
+                if identity.get("call_frame_id") != frame_id:
+                    continue
+                if point.step_id in eligible_step_ids:
+                    raise _error(PROFILE_CONFLICT, "eligible pure node has a checkpoint record",
+                                 surface="checkpoint_record", step_id=point.step_id)
+                record = state_manager.read_runtime_sidecar_json(
+                    Path(state_manager.workspace) / entry.get("record_path", "")
+                ) or {}
+                for binding in (record.get("restore_payload") or {}).get("bindings", ()):
+                    if binding.get("source_step_id") in eligible_step_ids:
+                        raise _error(PROFILE_CONFLICT, "restore binding sourced from eligible pure node",
+                                     surface="restore_payload", step_id=binding.get("source_step_id"))
+
+    def audit_progress(self, state: Mapping[str, Any]) -> None:
+        """Classify every eligible node; raises ``progress_witness_invalid``."""
+        for node_id in self.index.nodes:
+            classify_pure_replay_progress(state, witness=self.witness_from_state(node_id, state))
+
+
+def _cached_index(bundle: LoadedWorkflowBundle) -> PureResultReplayIndex:
+    cached = _INDEX_CACHE.get(id(bundle))
+    if cached is None or cached[0] is not bundle:
+        cached = (bundle, derive_pure_result_replay_index(bundle))
+        _INDEX_CACHE[id(bundle)] = cached
+    return cached[1]
+
+
+def eligible_pure_step_ids(bundle: Any) -> frozenset[str]:
+    """Step ids of replay-eligible nodes (derived index, cached per bundle object)."""
+    if not isinstance(bundle, LoadedWorkflowBundle):
+        return frozenset()
+    return frozenset(n.step_id for n in _cached_index(bundle).nodes.values())
+
+
+def eligible_pure_node_ids(bundle: Any) -> frozenset[str]:
+    """Node ids of replay-eligible nodes (derived index, cached per bundle object)."""
+    if not isinstance(bundle, LoadedWorkflowBundle):
+        return frozenset()
+    return frozenset(_cached_index(bundle).nodes)
+
+
+_INDEX_CACHE: dict[int, tuple[LoadedWorkflowBundle, PureResultReplayIndex]] = {}

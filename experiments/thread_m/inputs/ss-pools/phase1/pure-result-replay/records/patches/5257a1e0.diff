+    bundle = compile_stage3_entrypoint(
+        source, source_roots=(tmp_path,), provider_externs={}, prompt_externs={},
+        validate_shared=True, workspace_root=tmp_path,
+    )
+    bundle = next(b for n, b in bundle.validated_bundles_by_name.items() if n.endswith("::orchestrate"))
+    work = tmp_path / "artifacts" / "work"
+    work.mkdir(parents=True, exist_ok=True)

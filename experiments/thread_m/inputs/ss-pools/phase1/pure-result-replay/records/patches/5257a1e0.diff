+def test_index_records_pure_and_durable_dependencies(project) -> None:
+    index = derive_pure_result_replay_index(project.bundle)
+    node = index.nodes["root.two_orchestrate__condition"]
+    assert node.durable_dependency_node_ids == ("root.two_orchestrate__a__step_a",)
+    assert node.pure_dependency_node_ids == ()
+    assert {b.path for b in node.bindings} == {("a", "n"), ("a", "label"), ("c",)}
+    assert index.topological_node_ids == tuple(index.nodes)
+    assert "root.two_orchestrate__a__step_a" not in index.nodes

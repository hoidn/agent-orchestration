+        derive_pure_result_replay_index(project.bundle, scope_kind="call_frame")
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID
+    assert excinfo.value.context["expected_scope"] == "call_frame"
+    assert excinfo.value.context["actual_scope"] == "root"

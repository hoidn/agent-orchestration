+def _with_bindings(bundle, node_id, binding_refs):
+    node = bundle.ir.nodes[node_id]
+    config = node.execution_config
+    patched = PureProjectionStepConfig(
+        common=config.common,
+        pure_projection=MappingProxyType({**config.pure_projection, "binding_refs": binding_refs}),
+    )
+    nodes = {**bundle.ir.nodes, node_id: replace(node, execution_config=patched)}
+    return replace(bundle, ir=replace(bundle.ir, nodes=nodes))
+
+
+@pytest.mark.parametrize(
+    "binding_refs",
+    [
+        {"c": "not an int", "a": {"n": 1, "label": "x"}},
+        {"c": {"ref": "parent.steps.x.artifacts.y"}, "a": {"n": 1, "label": "x"}},
+        {"c": {"ref": "inputs.c", "extra": 1}, "a": {"n": 1, "label": "x"}},
+        {"c": {"ref": "root.steps.nowhere.artifacts.y"}, "a": {"n": 1, "label": "x"}},
+        {"c": 1, "a": {"n": 1, "label": "${inputs.c}"}},
+    ],
+)
+def test_invalid_binding_documents_fail_the_index(project, binding_refs) -> None:
+    bundle = _with_bindings(project.bundle, "root.two_orchestrate__condition", binding_refs)
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(bundle)
+    assert excinfo.value.reason == DEPENDENCY_INDEX_INVALID

new file mode 100644
index 0000000..f82e0a1
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_core.py
@@ -0,0 +1,242 @@
+"""Value-free completion shell, visit witnesses and progress classification.
+
+Dependencies: none beyond the stdlib; operates on plain state mappings or
+``RunState`` objects handed in by callers (``orchestrator.state`` imports this
+module lazily). Behavior: see ``specs/state.md`` (derived pure-result
+persistence profile).
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Mapping, Optional
+
+DERIVED_PURE_REPLAY_PROFILE = "derived_pure_replay.v1"
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+PURE_PROJECTION_TYPE = "pure_projection"
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+
+
+class PureResultReplayIndexError(ValueError):
+    """Typed fail-closed error for the derived pure-result profile."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(
+        self,
+        reason: str,
+        message: str,
+        *,
+        context: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit eligible pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Return the exact value-free completion row for one pure success."""
+
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": {
+            "status": "completed",
+            "phase": "execution",
+            "class": "completed",
+            "retryable": False,
+        },
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=repr)
+
+
+def _row_dict(row: Any) -> Any:
+    return row.to_dict() if hasattr(row, "to_dict") else row
+
+
+def is_pure_completion_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    """Whether ``row`` is exactly the value-free shell for ``witness``."""
+
+    row = _row_dict(row)
+    return isinstance(row, Mapping) and _canonical(dict(row)) == _canonical(
+        build_pure_completion_shell(witness)
+    )
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ``ValueError`` unless ``row`` is exactly the completion shell."""
+
+    row = _row_dict(row)
+    if not isinstance(row, Mapping):
+        raise ValueError("pure completion shell must be a mapping")
+    expected = build_pure_completion_shell(witness)
+    extra = sorted(set(row) - set(expected))
+    missing = sorted(set(expected) - set(row))
+    if extra or missing:
+        raise ValueError(
+            f"pure completion shell keys differ: extra={extra} missing={missing}"
+        )
+    if _canonical(dict(row)) != _canonical(expected):
+        raise ValueError("pure completion shell does not match the witnessed completion")
+
+
+def _state_dict(state: Any) -> Mapping[str, Any]:
+    return state.to_dict() if hasattr(state, "to_dict") else state
+
+
+def _invalid(message: str, witness: PureReplayVisitWitness) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID,
+        message,
+        context={
+            "presentation_key": witness.presentation_key,
+            "step_id": witness.step_id,
+        },
+    )
+
+
+def _cursor_is_related(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key
+        or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _validate_cursor(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> None:
+    expected = {
+        "name": witness.presentation_key,
+        "index": witness.step_index,
+        "type": PURE_PROJECTION_TYPE,
+        "step_id": witness.step_id,
+        "visit_count": witness.visit_count,
+        "status": "running",
+    }
+    for key, value in expected.items():
+        if _canonical(cursor.get(key)) != _canonical(value):
+            raise _invalid(f"pure running cursor field {key!r} does not match", witness)
+
+
+def _classify_row(row: Any, witness: PureReplayVisitWitness) -> str:
+    if is_pure_completion_shell(row, witness):
+        return DERIVED_COMPLETE
+    if (
+        isinstance(row, Mapping)
+        and row.get("status") in {"failed", "skipped"}
+        and row.get("visit_count") == witness.visit_count
+        and row.get("step_id") == witness.step_id
+        and row.get("name", witness.presentation_key) == witness.presentation_key
+    ):
+        return DURABLE_FAILURE_SKIP
+    raise _invalid("pure step row is neither the completion shell nor a failure/skip", witness)
+
+
+def classify_pure_replay_progress(state: Any, *, witness: PureReplayVisitWitness) -> str:
+    """Classify the visit, cursor and row of one witnessed pure execution."""
+
+    data = _state_dict(state)
+    visit = (data.get("step_visits") or {}).get(witness.presentation_key)
+    cursor = data.get("current_step")
+    related = _cursor_is_related(cursor, witness)
+    row = _row_dict((data.get("steps") or {}).get(witness.presentation_key))
+    if visit is None and not related and row is None:
+        return UNSTARTED
+    if visit != witness.visit_count or type(visit) is not int:
+        raise _invalid("pure visit count does not match the witness", witness)
+    if related:
+        if row is not None:
+            raise _invalid("pure step has both a running cursor and a row", witness)
+        _validate_cursor(cursor, witness)
+        return INTERRUPTED
+    if row is None:
+        raise _invalid("pure visit has neither a cursor nor a row", witness)
+    return _classify_row(row, witness)
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def begin_visit(run_state: Any, *, step_name: str, step_index: int, step_id: str) -> int:
+    """Increment the visit of one never-visited eligible pure node and publish its cursor."""
+
+    if run_state.step_visits.get(step_name, 0) != 0:
+        raise PureResultReplayIndexError(
+            PROGRESS_WITNESS_INVALID,
+            f"eligible pure step {step_name!r} was already visited",
+            context={"presentation_key": step_name, "step_id": step_id},
+        )
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, 1)
+    if _cursor_is_related(run_state.current_step, witness) or step_name in run_state.steps:
+        raise _invalid("eligible pure step has stale cursor or row", witness)
+    run_state.step_visits[step_name] = 1
+    now = _now()
+    run_state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": PURE_PROJECTION_TYPE,
+        "step_id": step_id,
+        "visit_count": 1,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return 1
+
+
+def reuse_visit(run_state: Any, witness: PureReplayVisitWitness) -> int:
+    """Validate an interrupted visit and return its visit count."""
+
+    if classify_pure_replay_progress(run_state, witness=witness) != INTERRUPTED:
+        raise _invalid("pure visit is not interrupted", witness)
+    return witness.visit_count
+
+
+def settle_success(run_state: Any, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Persist the exact completion shell and clear the cursor."""
+
+    if classify_pure_replay_progress(run_state, witness=witness) != INTERRUPTED:
+        raise _invalid("pure success can only settle an interrupted visit", witness)
+    shell = build_pure_completion_shell(witness)
+    run_state.steps[witness.presentation_key] = shell
+    run_state.current_step = None
+    return dict(shell)
+
+
+def settle_failure(run_state: Any, witness: PureReplayVisitWitness, result: Any) -> None:
+    """Persist a full failed or skipped row and clear the cursor."""
+
+    row = _row_dict(result)
+    if not isinstance(row, Mapping) or row.get("status") not in {"failed", "skipped"}:
+        raise _invalid("pure failure settlement requires a failed or skipped row", witness)
+    if classify_pure_replay_progress(run_state, witness=witness) != INTERRUPTED:
+        raise _invalid("pure failure can only settle an interrupted visit", witness)
+    run_state.steps[witness.presentation_key] = result
+    run_state.current_step = None

+"""Index derivation, profiled execution and resume replay on a compiled .orc bundle."""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    derive_pure_result_replay_index,
+)
+from orchestrator.workflow.pure_result_replay_index import _walk_doc
+from orchestrator.workflow.resume_planner import ResumePlanner
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+FIXTURE_ROOT = (
+    REPO_ROOT / "tests/fixtures/workflow_lisp/modules/valid/pure_projection_boundary_decision_consumer"
+)
+ENTRY = "pure_projection_boundary_decision_consumer/entry::run"
+HELPER = "pure_projection_boundary_decision_consumer/helper::project-path-decision"
+INPUTS = {"bundle_path": "x.json", "reason": "why"}
+OUTPUTS = {
+    "return__selected_path": "state/x.json",
+    "return__path_detail": "READY",
+    "return__shared_detail": "why-computed",
+}
+
+
+def _compile(tmp_path: Path):
+    result = compile_stage3_entrypoint(
+        FIXTURE_ROOT / "pure_projection_boundary_decision_consumer/entry.orc",
+        source_roots=(FIXTURE_ROOT,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={},
+        validate_shared=True,
+        workspace_root=tmp_path,
+    )
+    return result.validated_bundles_by_name
+
+
+def _manager(tmp_path: Path, bundle, *, profile, bound_inputs=None) -> StateManager:
+    manager = StateManager(workspace=tmp_path, run_id="r1")
+    manager.initialize(
+        str(bundle.provenance.workflow_path),
+        bound_inputs=dict(INPUTS if bound_inputs is None else bound_inputs),
+        result_persistence_profile=profile,
+    )
+    return manager
+
+
+@pytest.fixture()
+def profiled_run(tmp_path: Path):
+    bundles = _compile(tmp_path)
+    bundle = bundles[ENTRY]
+    manager = _manager(tmp_path, bundle, profile=DERIVED_PURE_REPLAY_PROFILE)
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    return tmp_path, bundles, bundle, manager, result
+
+
+def _interrupt_after(manager: StateManager, keep: int) -> None:
+    """Rewrite the finished state as if the run stopped after its first `keep` steps."""
+    state = json.loads(manager.state_file.read_text())
+    for name in list(state["steps"])[keep:]:
+        state["steps"].pop(name)
+        state["step_visits"].pop(name, None)
+    for frame_id in [f for f in state["call_frames"] if "shared_decision" in f]:
+        state["call_frames"].pop(frame_id)
+    state.update(status="running", workflow_outputs={})
+    state.pop("finalization", None)
+    manager.state_file.write_text(json.dumps(state))
+
+
+def _resume(tmp_path: Path, bundle):
+    manager = StateManager(workspace=tmp_path, run_id="r1")
+    manager.load()
+    return WorkflowExecutor(bundle, tmp_path, manager).execute(resume=True), manager
+
+
+# ---- index --------------------------------------------------------------
+
+
+def test_index_lists_eligible_nodes_with_typed_bindings(tmp_path: Path) -> None:
+    index = derive_pure_result_replay_index(_compile(tmp_path)[ENTRY])
+    assert index.scope_kind == "root"
+    assert index.ineligible_pure_reasons == {}
+    assert len(index.topological_node_ids) == 5
+    reason_node = next(n for n in index.nodes.values() if n.presentation_key.endswith("path-decision__bind_reason"))
+    assert [b.path for b in reason_node.bindings] == [("reason",)]
+    assert reason_node.pure_dependency_node_ids == () and reason_node.durable_dependency_node_ids == ()
+    assert [a.member for a in reason_node.output_addresses] == ["reason"]
+
+
+def test_imported_callee_indexes_only_its_own_nodes(tmp_path: Path) -> None:
+    index = derive_pure_result_replay_index(_compile(tmp_path)[HELPER])
+    assert index.scope_kind == "root"
+    assert len(index.nodes) == 1
+
+
+def test_scope_kind_mismatch_is_rejected(tmp_path: Path) -> None:
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        derive_pure_result_replay_index(_compile(tmp_path)[ENTRY], scope_kind="call_frame")
+    assert excinfo.value.reason == "dependency_index_invalid"
+    assert excinfo.value.context["expected_scope"] == "call_frame"
+    assert excinfo.value.context["actual_scope"] == "root"
+
+
+def test_derivation_does_not_change_the_runtime_plan(tmp_path: Path) -> None:
+    bundle = _compile(tmp_path)[ENTRY]
+    before = repr(bundle.runtime_plan)
+    derive_pure_result_replay_index(bundle)
+    assert repr(bundle.runtime_plan) == before
+
+
+def test_step_identity_is_distinct_from_raw_node_id(tmp_path: Path) -> None:
+    bundle = _compile(tmp_path)[ENTRY]
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("wf.orc"))
+    node = next(iter(runtime.index.nodes.values()))
+    assert runtime.node_id_for_step_id(node.step_id) == node.node_id
+    assert runtime.node_id_for_step_id("no-such-step") is None
+

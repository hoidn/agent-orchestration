+def test_child_frame_of_workflow_lisp_callee_selects_the_profile(profiled_run) -> None:
+    *_, manager, _result = profiled_run
+    frames = json.loads(manager.state_file.read_text())["call_frames"]
+    assert frames
+    assert {f["state"].get("result_persistence_profile") for f in frames.values()} == {
+        DERIVED_PURE_REPLAY_PROFILE
+    }
+
+
+def test_historical_profile_keeps_full_rows(tmp_path: Path) -> None:
+    bundle = _compile(tmp_path)[ENTRY]
+    manager = _manager(tmp_path, bundle, profile=None)
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute()
+    assert "result_persistence_profile" not in json.loads(manager.state_file.read_text())
+    node = next(iter(derive_pure_result_replay_index(bundle).nodes.values()))
+    assert "artifacts" in result["steps"][node.presentation_key]

index 0000000..d0da873
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_index.py
@@ -0,0 +1,421 @@
+"""Derive the replay-eligible pure-node dependency index from a loaded bundle.
+
+Dependencies: ``LoadedWorkflowBundle`` (executable IR, runtime plan, state
+projection) and ``pure_expr`` type descriptors. The derivation is read-only: it
+never mutates or serializes the bundle. Behavior: see ``specs/state.md``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Optional
+
+from .executable_ir import (
+    BoundAddress,
+    ExecutableNodeKind,
+    ForEachNode,
+    NodeResultAddress,
+    RepeatUntilFrameNode,
+    WorkflowInputAddress,
+)
+from .pure_expr import PureExprEvaluationError, _coerce_value, _descriptor_kind
+from .pure_result_replay_core import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+from .references import ReferenceResolutionError, parse_structured_ref
+
+_ROOT_SCOPE = "root"
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+def _thaw(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _thaw(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_thaw(v) for v in value]
+    return value
+
+
+@dataclass(frozen=True)
+class PureBinding:
+    """One exact ref leaf of a binding value document."""
+
+    path: tuple[str | int, ...]
+    address: BoundAddress
+    value_type: Optional[Mapping[str, Any]] = None
+
+
+@dataclass(frozen=True)
+class PureResultNode:
+    """One replay-eligible pure projection and its dependencies."""
+
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureBinding, ...]
+    output_addresses: tuple[NodeResultAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    """Eligible pure nodes, their order and the reasons others are excluded."""
+
+    scope_kind: str
+    nodes: Mapping[str, PureResultNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str] = field(default_factory=dict)
+
+    def required_pure_node_ids(
+        self, seed_addresses: Any, *, reached_node_ids: Any
+    ) -> tuple[str, ...]:
+        """Pure nodes (topologically ordered) needed to rebuild ``seed_addresses``."""
+
+        reached = set(reached_node_ids)
+        owner = {
+            (a.node_id, a.field, a.member): n.node_id
+            for n in self.nodes.values()
+            for a in n.output_addresses
+        }
+        needed: set[str] = set()
+        stack: list[str] = []
+        for seed in seed_addresses:
+            if isinstance(seed, NodeResultAddress):
+                node_id = owner.get((seed.node_id, seed.field, seed.member))
+                if node_id is None and seed.node_id in self.nodes and seed.field != "artifacts":
+                    node_id = seed.node_id
+                if node_id is None and seed.node_id in self.nodes and seed.member is None:
+                    node_id = seed.node_id
+                if node_id is None and seed.node_id in self.ineligible_pure_reasons:
+                    continue
+                if node_id is not None:
+                    stack.append(node_id)
+        while stack:
+            node_id = stack.pop()
+            if node_id in needed:
+                continue
+            if node_id not in reached:
+                raise PureResultReplayIndexError(
+                    REACHABILITY_AMBIGUOUS,
+                    f"pure node {node_id!r} is required but was not reached",
+                    context={"node_id": node_id},
+                )
+            needed.add(node_id)
+            stack.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(n for n in self.topological_node_ids if n in needed)
+
+
+def _ir_nodes(bundle: Any) -> Mapping[str, Any]:
+    return bundle.ir.nodes
+
+
+def _control_cycles(nodes: Mapping[str, Any]) -> set[str]:
+    """Node ids on a control-flow cycle (iterative Tarjan SCC)."""
+
+    graph = {nid: [] for nid in nodes}
+    for nid, node in nodes.items():
+        targets = [node.fallthrough_node_id]
+        targets += [t.target_node_id for t in node.routed_transfers.values()]
+        graph[nid] = [t for t in targets if isinstance(t, str) and t in nodes]
+    index: dict[str, int] = {}
+    low: dict[str, int] = {}
+    on_stack: set[str] = set()
+    stack: list[str] = []
+    cyclic: set[str] = set()
+    counter = 0
+    for root in graph:
+        if root in index:
+            continue
+        work = [(root, iter(graph[root]))]
+        index[root] = low[root] = counter
+        counter += 1
+        stack.append(root)
+        on_stack.add(root)
+        while work:
+            current, children = work[-1]
+            advanced = False
+            for child in children:
+                if child not in index:
+                    index[child] = low[child] = counter
+                    counter += 1
+                    stack.append(child)
+                    on_stack.add(child)
+                    work.append((child, iter(graph[child])))
+                    advanced = True
+                    break
+                if child in on_stack:
+                    low[current] = min(low[current], index[child])
+            if advanced:
+                continue
+            work.pop()
+            if work:
+                parent = work[-1][0]
+                low[parent] = min(low[parent], low[current])
+            if low[current] == index[current]:
+                component = []
+                while True:
+                    member = stack.pop()
+                    on_stack.discard(member)
+                    component.append(member)
+                    if member == current:
+                        break
+                if len(component) > 1 or current in graph[current]:
+                    cyclic.update(component)
+    return cyclic
+
+
+def _propagate_pure_ineligibility(nodes: Mapping[str, Any], seeds: set[str]) -> set[str]:
+    """Close a multiply-visited node set over nested loop bodies."""
+
+    closed = set(seeds)
+    pending = list(seeds)
+    while pending:
+        node = nodes.get(pending.pop())
+        for body_id in getattr(node, "body_node_ids", ()) or ():
+            if body_id not in closed:
+                closed.add(body_id)
+                pending.append(body_id)
+    return closed
+
+
+def _multiply_visited(nodes: Mapping[str, Any]) -> set[str]:
+    seeds = _control_cycles(nodes)
+    for node_id, node in nodes.items():
+        if isinstance(node, (ForEachNode, RepeatUntilFrameNode)):
+            seeds.update(node.body_node_ids)
+    return _propagate_pure_ineligibility(nodes, seeds)
+
+
+def _check_authorities(bundle: Any, pure_ids: list[str]) -> None:
+    nodes = _ir_nodes(bundle)
+    plan_nodes = bundle.runtime_plan.nodes
+    entries = bundle.projection.entries_by_node_id
+    seen: dict[tuple[str, str], str] = {}
+    for node_id in pure_ids:
+        node, plan = nodes[node_id], plan_nodes.get(node_id)
+        if plan is None or plan.step_id != node.step_id:
+            raise _invalid("runtime plan identity differs from the node", node_id=node_id)
+        entry = entries.get(node_id)
+        if entry is not None and (
+            entry.presentation_key != plan.presentation_key or entry.step_id != node.step_id
+        ):
+            raise _invalid("projection identity differs from the node", node_id=node_id)
+        for kind, value in (("step_id", node.step_id), ("presentation_key", plan.presentation_key)):
+            other = seen.setdefault((kind, value), node_id)
+            if other != node_id:
+                raise _invalid(
+                    "duplicate projection authority", authority=kind, value=value
+                )
+
+
+def _is_ref_object(doc: Any, expected: Any) -> bool:
+    if not isinstance(doc, Mapping) or "ref" not in doc:
+        return False
+    if expected is not None and _descriptor_kind(expected) == "record":
+        if any(f["name"] == "ref" for f in expected["fields"]):
+            return False
+    if set(doc) != {"ref"} or not isinstance(doc["ref"], str) or not doc["ref"]:
+        raise _invalid("malformed ref object", value=_thaw(doc))
+    return True
+
+
+def _walk_doc(doc: Any, descriptor: Mapping[str, Any], path: tuple, refs: list) -> None:
+    """Type-check literal leaves and collect exact ref leaves of one binding document."""
+
+    if _is_ref_object(doc, descriptor):
+        refs.append((path, doc["ref"], descriptor))
+        return
+    kind = _descriptor_kind(descriptor)
+    try:
+        if kind == "optional":
+            if doc is not None:
+                _walk_doc(doc, descriptor["item"], path, refs)
+        elif kind == "list":
+            if not isinstance(doc, (list, tuple)):
+                raise _invalid("literal must be a list", path=list(path))
+            for i, item in enumerate(doc):
+                _walk_doc(item, descriptor["item"], (*path, i), refs)
+        elif kind == "map":
+            if not isinstance(doc, Mapping):
+                raise _invalid("literal must be a map", path=list(path))
+            for key, item in doc.items():
+                _coerce_value(key, descriptor["key"], context="key")
+                _walk_doc(item, descriptor["value"], (*path, key), refs)
+        elif kind == "record":
+            _walk_fields(doc, {f["name"]: f["type"] for f in descriptor["fields"]}, path, refs)
+        elif kind in {"union", "variant_case"}:
+            _walk_union(doc, descriptor, kind, path, refs)
+        else:
+            _coerce_value(doc, descriptor, context="literal")
+    except PureExprEvaluationError as exc:
+        raise _invalid(f"literal does not match its binding type: {exc}", path=list(path)) from exc
+
+
+def _walk_fields(doc: Any, fields: Mapping[str, Any], path: tuple, refs: list, *, extra: Optional[Mapping] = None) -> None:
+    if not isinstance(doc, Mapping):
+        raise _invalid("literal must be a mapping", path=list(path))
+    allowed = {**(extra or {}), **fields}
+    unknown = sorted(set(doc) - set(allowed))
+    missing = sorted(set(fields) - set(doc))
+    if unknown or missing:
+        raise _invalid("literal fields differ from the binding type", path=list(path), unknown=unknown, missing=missing)
+    for name, item in doc.items():
+        _walk_doc(item, allowed[name], (*path, name), refs)
+
+
+def _walk_union(doc: Any, descriptor: Mapping[str, Any], kind: str, path: tuple, refs: list) -> None:
+    if not isinstance(doc, Mapping) or "variant" not in doc:
+        raise _invalid("union literal must declare a variant", path=list(path))
+    variants = (
+        [descriptor] if kind == "variant_case" else list(descriptor["variants"])
+    )
+    names = [descriptor["variant"]] if kind == "variant_case" else [v["name"] for v in variants]
+    variant_doc = doc["variant"]
+    if _is_ref_object(variant_doc, None):
+        refs.append(((*path, "variant"), variant_doc["ref"], {"kind": "primitive", "name": "String"}))
+        active = None
+    else:
+        if variant_doc not in names:
+            raise _invalid("union literal names an undeclared variant", path=list(path))
+        active = next(v for v in variants if (v.get("name") or v.get("variant")) == variant_doc)
+    inactive: dict[str, Any] = {}
+    for variant in variants:
+        for f in variant["fields"]:
+            inactive.setdefault(f["name"], f["type"])
+    own = {f["name"]: f["type"] for f in active["fields"]} if active is not None else {}
+    if active is None:
+        own = {}
+    rest = {k: v for k, v in doc.items() if k != "variant"}
+    for name, item in rest.items():
+        field_type = own.get(name) or inactive.get(name)
+        if field_type is None:
+            raise _invalid("union literal has an undeclared member", path=list(path), member=name)
+        _walk_doc(item, field_type, (*path, name), refs)
+    missing = sorted(set(own) - set(rest))
+    if missing:
+        raise _invalid("union literal misses active members", path=list(path), missing=missing)
+
+
+def _parse_ref(ref: str, plan_keys: Mapping[str, list[str]]) -> BoundAddress:
+    if ref.startswith("inputs."):
+        name = ref[len("inputs."):]
+        if not name:
+            raise _invalid("malformed input ref", ref=ref)
+        return WorkflowInputAddress(name)
+    if not ref.startswith("root.steps."):
+        raise _invalid("cross-frame or unsupported ref", ref=ref)
+    try:
+        target = parse_structured_ref(ref, plan_keys)
+    except ReferenceResolutionError as exc:
+        raise _invalid(f"unresolvable ref: {exc}", ref=ref) from exc
+    owners = plan_keys.get(target.step_name, [])
+    if len(owners) != 1:
+        raise _invalid("ref does not name exactly one node", ref=ref)
+    return NodeResultAddress(owners[0], target.field, target.member)
+
+
+def _derive_node(node: Any, plan: Any, plan_keys: Mapping[str, list[str]]) -> PureResultNode:
+    config = _thaw(node.execution_config.pure_projection)
+    payload, refs_doc = config.get("payload"), config.get("binding_refs")
+    contracts = config.get("output_contracts")
+    if not all(isinstance(v, dict) for v in (payload, refs_doc, contracts)):
+        raise _invalid("pure projection config is malformed", node_id=node.node_id)
+    declared = payload.get("bindings") or {}
+    if set(declared) != set(refs_doc):
+        raise _invalid(
+            "binding text is unbound",
+            node_id=node.node_id,
+            unbound=sorted(set(declared) ^ set(refs_doc)),
+        )
+    collected: list[tuple[tuple, str, Mapping[str, Any]]] = []
+    for name, doc in refs_doc.items():
+        _walk_doc(doc, declared[name]["type"], (name,), collected)
+    bindings = tuple(PureBinding(path, _parse_ref(ref, plan_keys), value_type)
+        for path, ref, value_type in collected)
+    return PureResultNode(
+        node_id=node.node_id,
+        step_id=node.step_id,
+        presentation_key=plan.presentation_key,
+        bindings=bindings,
+        output_addresses=tuple(
+            NodeResultAddress(node.node_id, "artifacts", name) for name in contracts
+        ),
+        output_contracts=contracts,
+        pure_dependency_node_ids=(),
+        durable_dependency_node_ids=(),
+    )
+
+
+def _topological(nodes: Mapping[str, PureResultNode], order: list[str]) -> tuple[str, ...]:
+    result: list[str] = []
+    state: dict[str, int] = {}
+
+    def visit(node_id: str) -> None:
+        if state.get(node_id) == 2:
+            return
+        if state.get(node_id) == 1:
+            raise _invalid("pure dependency cycle", node_id=node_id)
+        state[node_id] = 1
+        for dep in nodes[node_id].pure_dependency_node_ids:
+            visit(dep)
+        state[node_id] = 2
+        result.append(node_id)
+
+    for node_id in order:
+        visit(node_id)
+    return tuple(result)
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = "root") -> PureResultReplayIndex:
+    """Derive the replay index of one bundle's own pure nodes without mutating it."""
+
+    if scope_kind != _ROOT_SCOPE:
+        raise _invalid(
+            "scope kind does not match the bundle scope",
+            expected_scope=scope_kind,
+            actual_scope=_ROOT_SCOPE,
+        )
+    ir_nodes = _ir_nodes(bundle)
+    pure_ids = [
+        nid for nid, n in ir_nodes.items() if n.kind is ExecutableNodeKind.PURE_PROJECTION
+    ]
+    _check_authorities(bundle, pure_ids)
+    multiply = _multiply_visited(ir_nodes)
+    reasons = {nid: MULTIPLE_VISIT_REGION for nid in pure_ids if nid in multiply}
+    eligible_ids = [nid for nid in pure_ids if nid not in reasons]
+    plan_keys: dict[str, list[str]] = {}
+    for nid, plan in bundle.runtime_plan.nodes.items():
+        plan_keys.setdefault(plan.presentation_key, []).append(nid)
+    raw = {
+        nid: _derive_node(ir_nodes[nid], bundle.runtime_plan.nodes[nid], plan_keys)
+        for nid in eligible_ids
+    }
+    resolved: dict[str, PureResultNode] = {}
+    for nid, node in raw.items():
+        pure_deps: list[str] = []
+        durable: list[str] = []
+        for binding in node.bindings:
+            address = binding.address
+            if not isinstance(address, NodeResultAddress):
+                continue
+            bucket = pure_deps if address.node_id in raw else durable
+            if address.node_id not in bucket:
+                bucket.append(address.node_id)
+        resolved[nid] = PureResultNode(
+            **{**node.__dict__, "pure_dependency_node_ids": tuple(pure_deps),
+               "durable_dependency_node_ids": tuple(durable)}
+        )
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=resolved,
+        topological_node_ids=_topological(resolved, eligible_ids),
+        ineligible_pure_reasons=reasons,
+    )

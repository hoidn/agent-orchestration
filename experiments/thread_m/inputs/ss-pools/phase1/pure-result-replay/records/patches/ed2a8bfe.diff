+"""Behavioral tests for the derived pure-result persistence profile."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import RunState, StateManager, StepResult
+from orchestrator.workflow.call_frame_state import (
+    _CallFrameStateManager,
+    load_existing_call_frame_read_only,
+)
+from orchestrator.workflow.outcomes import OutcomeRecorder
+from orchestrator.workflow.pure_result_replay import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+WITNESS = PureReplayVisitWitness("Pure", 3, "root.pure", 1)
+EXPECTED_SHELL = {
+    "name": "Pure",
+    "step_id": "root.pure",
+    "visit_count": 1,
+    "status": "completed",
+    "exit_code": 0,
+    "outcome": {
+        "status": "completed",
+        "phase": "execution",
+        "class": "completed",
+        "retryable": False,
+    },
+    "result_storage": "derived_pure_replay.v1",
+}
+
+
+def _cursor(**overrides):
+    cursor = {
+        "name": "Pure",
+        "index": 3,
+        "type": "pure_projection",
+        "step_id": "root.pure",
+        "visit_count": 1,
+        "status": "running",
+    }
+    cursor.update(overrides)
+    return cursor
+
+
+def _state(*, visit=None, cursor=None, row=None):
+    return {
+        "step_visits": {} if visit is None else {"Pure": visit},
+        "current_step": cursor,
+        "steps": {} if row is None else {"Pure": row},
+    }
+
+
+def _workflow(tmp_path: Path) -> str:
+    (tmp_path / "wf.orc").write_text("(workflow-lisp)\n", encoding="utf-8")
+    return "wf.orc"
+
+
+# ---- profile selector -------------------------------------------------
+
+
+def _run_state(**kwargs) -> RunState:
+    return RunState(
+        schema_version="2.1",
+        run_id="r",
+        workflow_file="wf.orc",
+        workflow_checksum="sha256:x",
+        started_at="t",
+        updated_at="t",
+        status="running",
+        **kwargs,
+    )
+
+
+def test_absent_profile_is_omitted_and_round_trips() -> None:
+    payload = _run_state().to_dict()
+    assert "result_persistence_profile" not in payload
+    assert RunState.from_dict(payload).result_persistence_profile is None
+
+
+def test_present_profile_round_trips() -> None:
+    state = _run_state(result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+    assert RunState.from_dict(state.to_dict()).result_persistence_profile == "derived_pure_replay.v1"
+
+
+def test_unknown_profile_fails_closed_at_construction() -> None:
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        _run_state(result_persistence_profile="derived_pure_replay.v2")
+
+
+def test_unknown_profile_fails_closed_at_initialize(tmp_path: Path) -> None:
+    manager = StateManager(tmp_path, run_id="r")
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        manager.initialize(_workflow(tmp_path), result_persistence_profile="nope")
+    assert not manager.state_file.exists()
+
+
+def test_initialize_writes_profile_and_load_does_not_change_it(tmp_path: Path) -> None:
+    manager = StateManager(tmp_path, run_id="r")
+    manager.initialize(_workflow(tmp_path), result_persistence_profile=DERIVED_PURE_REPLAY_PROFILE)
+    raw = json.loads(manager.state_file.read_text())
+    assert raw["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    legacy = StateManager(tmp_path, run_id="legacy")
+    legacy.initialize(_workflow(tmp_path))
+    assert StateManager(tmp_path, run_id="legacy").load().result_persistence_profile is None
+
+
+def test_unknown_profile_on_load_leaves_file_unchanged(tmp_path: Path) -> None:
+    manager = StateManager(tmp_path, run_id="r")
+    manager.initialize(_workflow(tmp_path))
+    raw = json.loads(manager.state_file.read_text())
+    raw["result_persistence_profile"] = "bogus"
+    manager.state_file.write_text(json.dumps(raw))
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        StateManager(tmp_path, run_id="r").load()
+    assert manager.state_file.read_bytes() == before
+
+
+# ---- completion shell -------------------------------------------------
+
+
+def test_shell_is_exact() -> None:
+    assert build_pure_completion_shell(WITNESS) == EXPECTED_SHELL
+
+
+@pytest.mark.parametrize("extra", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_rejects_extra_keys(extra: str) -> None:
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell({**EXPECTED_SHELL, extra: 1}, witness=WITNESS)
+
+
+def test_shell_rejects_missing_key_and_wrong_value() -> None:
+    missing = dict(EXPECTED_SHELL)
+    del missing["exit_code"]
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(missing, witness=WITNESS)
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell({**EXPECTED_SHELL, "visit_count": True}, witness=WITNESS)
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(
+            {**EXPECTED_SHELL, "outcome": {**EXPECTED_SHELL["outcome"], "retryable": 0}},
+            witness=WITNESS,
+        )
+
+

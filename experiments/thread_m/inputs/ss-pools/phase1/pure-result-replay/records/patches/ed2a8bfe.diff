+def test_overlay_rejects_cursor_on_a_settled_node(tmp_path: Path) -> None:
+    bundle = _compile(tmp_path)[ENTRY]
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("wf.orc"))
+    node = next(n for n in runtime.index.nodes.values() if not n.bindings)
+    witness = runtime.witness(node.node_id)
+    result = {
+        "status": "completed",
+        "exit_code": 0,
+        "artifacts": {a.member: "READY" for a in node.output_addresses},
+    }
+    runtime.record_full_result(node.node_id, witness=witness, result=result)
+    state = {
+        "step_visits": {witness.presentation_key: 1},
+        "steps": {witness.presentation_key: copy.deepcopy(result)},
+        "current_step": None,
+    }
+    assert runtime.overlay_active_state(state)["steps"][witness.presentation_key] == result
+    state["current_step"] = {"name": witness.presentation_key, "status": "running"}
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        runtime.overlay_active_state(state)
+    assert excinfo.value.reason == "progress_witness_invalid"

+STRING = {"kind": "primitive", "name": "String"}
+UNION = {
+    "kind": "union",
+    "name": "U",
+    "variants": [
+        {"name": "A", "fields": [{"name": "a", "type": STRING}]},
+        {"name": "B", "fields": [{"name": "b", "type": {"kind": "primitive", "name": "Int"}}]},
+    ],
+}
+
+
+def test_literal_leaves_are_type_checked_and_refs_collected() -> None:
+    refs: list = []
+    _walk_doc({"variant": "A", "a": {"ref": "inputs.x"}}, UNION, ("u",), refs)
+    assert [(path, ref) for path, ref, _ in refs] == [(("u", "a"), "inputs.x")]
+    with pytest.raises(PureResultReplayIndexError):
+        _walk_doc(3, STRING, ("s",), [])
+
+
+def test_inactive_union_members_must_match_their_types() -> None:
+    _walk_doc({"variant": "A", "a": "x", "b": 1}, UNION, (), [])
+    with pytest.raises(PureResultReplayIndexError):
+        _walk_doc({"variant": "A", "a": "x", "b": "not-an-int"}, UNION, (), [])
+    with pytest.raises(PureResultReplayIndexError):
+        _walk_doc({"variant": "A", "b": 1}, UNION, (), [])
+
+
+def test_malformed_ref_object_is_rejected() -> None:
+    with pytest.raises(PureResultReplayIndexError):
+        _walk_doc({"ref": "inputs.x", "extra": 1}, STRING, (), [])
+    with pytest.raises(PureResultReplayIndexError):
+        _walk_doc({"ref": 3}, STRING, (), [])
+
+
+# ---- profiled run -------------------------------------------------------
+
+
+def test_profiled_run_matches_historical_outputs_and_stays_value_free(profiled_run) -> None:
+    tmp_path, bundles, bundle, manager, result = profiled_run
+    assert result["status"] == "completed"
+    assert result["workflow_outputs"] == OUTPUTS
+    persisted = json.loads(manager.state_file.read_text())
+    assert persisted["result_persistence_profile"] == DERIVED_PURE_REPLAY_PROFILE
+    index = derive_pure_result_replay_index(bundle)
+    for node in index.nodes.values():
+        assert persisted["steps"][node.presentation_key]["result_storage"] == DERIVED_PURE_REPLAY_PROFILE
+        assert "artifacts" not in persisted["steps"][node.presentation_key]
+    assert persisted["private_artifact_versions"] == {}
+
+    historical_dir = tmp_path / "historical"
+    historical_dir.mkdir()
+    historical_bundle = _compile(historical_dir)[ENTRY]
+    historical = WorkflowExecutor(
+        historical_bundle,
+        historical_dir,
+        _manager(historical_dir, historical_bundle, profile=None),
+    ).execute()
+    assert historical["workflow_outputs"] == result["workflow_outputs"]
+

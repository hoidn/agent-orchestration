+        (_state(cursor={"name": "Other", "step_id": "root.other", "status": "running"}), "unstarted"),
+        (_state(visit=1, cursor=_cursor()), "interrupted"),
+        (_state(visit=1, row=EXPECTED_SHELL), "derived_complete"),
+        (_state(visit=1, row=EXPECTED_SHELL, cursor={"name": "Other", "step_id": "o"}), "derived_complete"),
+        (_state(visit=1, row={"name": "Pure", "step_id": "root.pure", "visit_count": 1, "status": "failed"}), "durable_failure_skip"),
+        (_state(visit=1, row={"name": "Pure", "step_id": "root.pure", "visit_count": 1, "status": "skipped"}), "durable_failure_skip"),
+    ],
+)
+def test_classification(state, expected) -> None:
+    assert classify_pure_replay_progress(state, witness=WITNESS) == expected
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _state(visit=1),
+        _state(cursor=_cursor()),
+        _state(row=EXPECTED_SHELL),
+        _state(visit=1, cursor=_cursor(), row=EXPECTED_SHELL),
+        _state(visit=2, cursor=_cursor(visit_count=2)),
+        _state(visit=2, row={**EXPECTED_SHELL, "visit_count": 2}),
+        _state(visit=1, cursor=_cursor(index=4)),
+        _state(visit=1, cursor=_cursor(type="command")),
+        _state(visit=1, cursor=_cursor(status="done")),
+        _state(visit=1, row={**EXPECTED_SHELL, "artifacts": {"a": 1}}),
+        _state(visit=1, row={"name": "Pure", "step_id": "root.pure", "visit_count": 1, "status": "running"}),
+        _state(visit=1, row={"name": "Pure", "step_id": "root.other", "visit_count": 1, "status": "failed"}),
+        _state(visit=1, row={"name": "Pure", "step_id": "root.pure", "visit_count": 2, "status": "failed"}),
+        _state(visit=1, cursor=_cursor(), row={"name": "Pure", "step_id": "root.pure", "visit_count": 1, "status": "failed"}),
+    ],
+)
+def test_invalid_progress(state) -> None:

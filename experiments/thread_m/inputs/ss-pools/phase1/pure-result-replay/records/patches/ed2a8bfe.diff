+def test_private_lineage_of_an_eligible_node_is_a_profile_conflict(profiled_run) -> None:
+    tmp_path, _b, bundle, manager, _r = profiled_run
+    node = next(iter(derive_pure_result_replay_index(bundle).nodes.values()))
+    state = json.loads(manager.state_file.read_text())
+    state["private_artifact_versions"] = {"a": [{"producer": node.step_id, "version": 1}]}
+    state["status"] = "running"

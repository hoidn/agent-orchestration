+# ---- resume -------------------------------------------------------------
+
+
+def test_resume_replays_pure_values_without_rerunning_committed_steps(profiled_run, monkeypatch) -> None:
+    tmp_path, _bundles, bundle, manager, _result = profiled_run
+    _interrupt_after(manager, 4)
+    calls = []
+    original = ResumePlanner.determine_restart_node_id
+
+    def counting(self, *args, **kwargs):
+        calls.append(1)
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(ResumePlanner, "determine_restart_node_id", counting)
+    resumed, resumed_manager = _resume(tmp_path, bundle)
+    assert resumed["status"] == "completed"
+    assert resumed["workflow_outputs"] == OUTPUTS
+    assert len(calls) == 1
+    persisted = json.loads(resumed_manager.state_file.read_text())
+    assert persisted["private_artifact_versions"] == {}
+    assert all(
+        "artifacts" not in row
+        for row in persisted["steps"].values()
+        if row.get("result_storage") == DERIVED_PURE_REPLAY_PROFILE
+    )
+
+
+def test_persisted_value_row_is_a_profile_conflict_before_any_write(profiled_run) -> None:
+    tmp_path, _b, bundle, manager, _r = profiled_run
+    state = json.loads(manager.state_file.read_text())
+    name = next(iter(derive_pure_result_replay_index(bundle).nodes.values())).presentation_key
+    state["steps"][name]["artifacts"] = {"route": "READY"}
+    state["status"] = "running"
+    manager.state_file.write_text(json.dumps(state))
+    before = manager.state_file.read_bytes()
+    with pytest.raises(PureResultReplayIndexError) as excinfo:
+        _resume(tmp_path, bundle)
+    assert excinfo.value.reason == "profile_conflict"
+    assert excinfo.value.context["surface"] == "steps"
+    assert manager.state_file.read_bytes() == before
+

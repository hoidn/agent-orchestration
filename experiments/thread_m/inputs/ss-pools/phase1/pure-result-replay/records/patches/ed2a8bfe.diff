index 0000000..bd400c8
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay.py
@@ -0,0 +1,401 @@
+"""Resume-time replay of eligible pure results under ``derived_pure_replay.v1``.
+
+Dependencies: the replay index (``pure_result_replay_index``), the value-free
+shell/progress helpers (``pure_result_replay_core``), the bundle's runtime plan,
+and (for surface audits) ``StateManager`` run storage and lexical-checkpoint
+record files. Behavior: replay validates only the required dependency leaves and
+rebuilds typed values into an in-memory overlay; it never dispatches an effect,
+increments a visit, settles a result or writes durable state.
+"""
+
+from __future__ import annotations
+
+import copy
+import inspect
+import json
+from typing import Any, Callable, Mapping, Optional
+
+from .executable_ir import NodeResultAddress, WorkflowInputAddress
+from .pure_expr import PureExprEvaluationError, _coerce_value
+from .pure_result_replay_core import (  # noqa: F401  (re-exported public names)
+    DEPENDENCY_INDEX_INVALID,
+    DERIVED_COMPLETE,
+    DERIVED_PURE_REPLAY_PROFILE,
+    DURABLE_FAILURE_SKIP,
+    INTERRUPTED,
+    MULTIPLE_VISIT_REGION,
+    PROFILE_CONFLICT,
+    PROGRESS_WITNESS_INVALID,
+    PURE_RESULT_REPLAY_UNAVAILABLE,
+    REACHABILITY_AMBIGUOUS,
+    UNSTARTED,
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    is_pure_completion_shell,
+    validate_pure_completion_shell,
+)
+from .pure_result_replay_index import (  # noqa: F401  (re-exported public names)
+    PureBinding,
+    PureResultNode,
+    PureResultReplayIndex,
+    _propagate_pure_ineligibility,
+    derive_pure_result_replay_index,
+)
+from .resume_projection_integrity import ResumeScopePath
+
+_INTRINSIC_TYPES = {
+    "status": str,
+    "phase": str,
+    "class": str,
+    "retryable": bool,
+}
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=repr)
+
+
+def _state_dict(state: Any) -> dict[str, Any]:
+    return state.to_dict() if hasattr(state, "to_dict") else state
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _failure_reason(result: Mapping[str, Any]) -> tuple[str, str]:
+    """Map a failed evaluation result to a (reason, cause type) pair."""
+
+    error = result.get("error") if isinstance(result.get("error"), Mapping) else {}
+    error_type = error.get("type")
+    context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+    if error_type == "materialize_ref_unresolved":
+        return "binding_unresolved", "materialize_ref_unresolved"
+    if context.get("reason") == "pure_projection_contract_invalid":
+        return "output_contract_invalid", "pure_projection_contract_invalid"
+    return "evaluation_failed", "pure_evaluation_failed"
+
+
+class PureReplayRuntime:
+    """Process-local replay of one scope's eligible pure nodes."""
+
+    def __init__(self, *, bundle: Any, scope_path: ResumeScopePath) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index = derive_pure_result_replay_index(bundle)
+        self._by_step_id = {n.step_id: nid for nid, n in self.index.nodes.items()}
+        self._active: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+
+    # ---- identities -------------------------------------------------
+    def _node(self, node_id: str) -> PureResultNode:
+        try:
+            return self.index.nodes[node_id]
+        except KeyError:
+            raise _error(DEPENDENCY_INDEX_INVALID, "node is not replay-eligible", node_id=node_id)
+
+    def witness(self, node_id: str, *, visit_count: int = 1) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        projection = self.bundle.projection
+        step_index = projection.compatibility_index_by_node_id.get(node_id)
+        if step_index is None:
+            step_index = self.bundle.runtime_plan.nodes[node_id].execution_index or 0
+        return PureReplayVisitWitness(node.presentation_key, step_index, node.step_id, visit_count)
+
+    def witness_from_state(self, node_id: str, state: Any) -> PureReplayVisitWitness:
+        node = self._node(node_id)
+        visit = (_state_dict(state).get("step_visits") or {}).get(node.presentation_key, 1)
+        return self.witness(node_id, visit_count=visit)
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._by_step_id.get(step_id)
+
+    # ---- active results ---------------------------------------------
+    def _validate_result(self, node: PureResultNode, result: Any) -> dict[str, Any]:
+        """Check a full completed result carries exactly the expected outputs."""
+
+        if (
+            not isinstance(result, Mapping)
+            or result.get("status") != "completed"
+            or result.get("exit_code", 0) != 0
+            or not isinstance(result.get("artifacts"), Mapping)
+        ):
+            raise _error(DEPENDENCY_INDEX_INVALID, "pure result is not a completed value row", node_id=node.node_id)
+        artifacts = result["artifacts"]
+        contracts = node.output_contracts
+        discriminants = [
+            name for name, c in contracts.items()
+            if (c.get("projection") or {}).get("field_role") == "discriminant"
+        ]
+        expected: set[str] = set()
+        active = artifacts.get(discriminants[0]) if discriminants else None
+        for name, contract in contracts.items():
+            role = (contract.get("projection") or {}).get("field_role")
+            if role == "variant":
+                if active in (contract["projection"].get("active_variants") or ()):
+                    expected.add(name)
+            else:
+                expected.add(name)
+        if set(artifacts) != expected:
+            raise _error(
+                DEPENDENCY_INDEX_INVALID,
+                "pure result members differ from the active union members",
+                node_id=node.node_id,
+                missing=sorted(expected - set(artifacts)),
+                extra=sorted(set(artifacts) - expected),
+            )
+        return copy.deepcopy(dict(result))
+
+    def record_full_result(
+        self, node_id: str, *, witness: PureReplayVisitWitness, result: Any
+    ) -> None:
+        node = self._node(node_id)
+        if witness != self.witness(node_id, visit_count=witness.visit_count) or witness.visit_count != 1:
+            raise _error(PROGRESS_WITNESS_INVALID, "witness does not identify this node", node_id=node_id)
+        self._active[node_id] = (witness, self._validate_result(node, result))
+
+    def _revalidate_cache_hit(self, node_id: str, state: Mapping[str, Any]) -> dict[str, Any]:
+        witness, result = self._active[node_id]
+        key = witness.presentation_key
+        row = (state.get("steps") or {}).get(key)
+        visit = (state.get("step_visits") or {}).get(key)
+        cursor = state.get("current_step")
+        if visit != 1 or type(visit) is not int:
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure result has no single visit", node_id=node_id)
+        if is_pure_completion_shell(row, witness):
+            if isinstance(cursor, Mapping) and (
+                cursor.get("name") == key or cursor.get("step_id") == witness.step_id
+            ):
+                raise _error(PROGRESS_WITNESS_INVALID, "cursor targets a settled pure node", node_id=node_id)
+            return result
+        if not isinstance(row, Mapping) or _canonical(row) != _canonical(result):
+            raise _error(PROGRESS_WITNESS_INVALID, "cached pure result does not match the state row", node_id=node_id)
+        if isinstance(cursor, Mapping) and (
+            cursor.get("name") == key or cursor.get("step_id") == witness.step_id
+        ):
+            raise _error(PROGRESS_WITNESS_INVALID, "cursor targets the active pure node", node_id=node_id)
+        return result
+
+    def overlay_active_state(self, state: Any) -> dict[str, Any]:
+        """Copy ``state`` and overlay each revalidated active/replayed pure row."""
+
+        overlay = copy.deepcopy(_state_dict(state))
+        for node_id in self._active:
+            result = self._revalidate_cache_hit(node_id, overlay)
+            overlay.setdefault("steps", {})[self._active[node_id][0].presentation_key] = copy.deepcopy(result)
+        return overlay
+
+    # ---- replay -----------------------------------------------------
+    def replay_node(
+        self, node_id: str, *, state: Any, evaluate_node: Callable[..., Any]
+    ) -> dict[str, Any]:
+        node = self._node(node_id)
+        data = _state_dict(state)
+        witness = self.witness_from_state(node_id, data)
+        if node_id in self._active:
+            return self._revalidate_cache_hit(node_id, data)
+        if classify_pure_replay_progress(data, witness=witness) != DERIVED_COMPLETE:
+            raise _error(PROGRESS_WITNESS_INVALID, "pure node is not derived-complete", node_id=node_id)
+        overlay = self.overlay_active_state(data)
+        params = len(inspect.signature(evaluate_node).parameters)
+        result = evaluate_node(node, overlay) if params >= 2 else evaluate_node(node)
+        if not isinstance(result, Mapping) or result.get("status") != "completed":
+            reason, cause = _failure_reason(result if isinstance(result, Mapping) else {})
+            raise _error(reason, "pure result could not be re-derived", node_id=node_id, cause={"type": cause})
+        shell = build_pure_completion_shell(witness)
+        shell.pop("result_storage")
+        self._active[node_id] = (witness, self._validate_result(node, {**shell, **result}))
+        return copy.deepcopy(self._active[node_id][1])
+
+    # ---- address resolution -----------------------------------------
+    def resolve_state_address(self, address: Any, state: Any) -> tuple[bool, Any]:
+        data = self.overlay_active_state(state)
+        if isinstance(address, WorkflowInputAddress):
+            inputs = data.get("bound_inputs") or {}
+            return (address.input_name in inputs), inputs.get(address.input_name)
+        if not isinstance(address, NodeResultAddress):
+            return False, None
+        plan_node = self.bundle.runtime_plan.nodes.get(address.node_id)
+        row = (data.get("steps") or {}).get(plan_node.presentation_key) if plan_node else None
+        if not isinstance(row, Mapping):
+            return False, None
+        if address.field == "exit_code":
+            return "exit_code" in row, row.get("exit_code")
+        container = row.get(address.field)
+        if address.member is None:
+            return address.field in row, container
+        if isinstance(container, Mapping) and address.member in container:
+            return True, container[address.member]
+        return False, None
+
+    def value_for_state_address(self, address: Any, state: Any) -> Any:
+        found, value = self.resolve_state_address(address, state)
+        if not found:
+            raise _error("durable_input_missing", "address has no value in state", address=repr(address))
+        return value
+
+    def audit_progress(self, state: Any) -> None:
+        """Reject any impossible visit/cursor/row combination of an eligible node."""
+
+        data = _state_dict(state)
+        steps, visits = data.get("steps") or {}, data.get("step_visits") or {}
+        for node_id, node in self.index.nodes.items():
+            row = steps.get(node.presentation_key)
+            if (
+                isinstance(row, Mapping)
+                and row.get("status") in {"failed", "skipped"}
+                and node.presentation_key not in visits
+            ):
+                continue  # historical full row without a visit
+            classify_pure_replay_progress(data, witness=self.witness(node_id))
+
+    # ---- boundary ---------------------------------------------------
+    def _classification(self, node_id: str, state: Mapping[str, Any]) -> str:
+        return classify_pure_replay_progress(state, witness=self.witness_from_state(node_id, state))
+
+    def _consumed_addresses(self, restart_node_id: str, state: Mapping[str, Any]) -> list[NodeResultAddress]:
+        keys = {n.presentation_key: nid for nid, n in self.index.nodes.items()}
+        done = {
+            k for k, row in (state.get("steps") or {}).items()
+            if isinstance(row, Mapping) and row.get("status") in {"completed", "failed", "skipped"}
+        }
+        found: list[NodeResultAddress] = []
+        for nid, ir_node in self.bundle.ir.nodes.items():
+            plan = self.bundle.runtime_plan.nodes.get(nid)
+            if nid != restart_node_id and plan is not None and plan.presentation_key in done:
+                continue
+            _collect_addresses(ir_node, keys, found, self.bundle.runtime_plan)
+        for contract in self.bundle.ir.outputs.values():
+            _collect_addresses(contract.source_address, keys, found, self.bundle.runtime_plan)
+        return found
+
+    def required_node_ids_for_boundary(self, restart_node_id: str, *, state: Any) -> tuple[str, ...]:
+        data = _state_dict(state)
+        complete = {
+            nid for nid in self.index.nodes
+            if self._classification(nid, data) == DERIVED_COMPLETE
+        }
+        seeds = [
+            a for a in self._consumed_addresses(restart_node_id, data) if a.node_id in complete
+        ]
+        return self.index.required_pure_node_ids(seeds, reached_node_ids=complete)
+
+    def audit_boundary_leaves(self, restart_node_id: str, *, state: Any) -> None:
+        data = _state_dict(state)
+        for node_id in self.required_node_ids_for_boundary(restart_node_id, state=data):
+            for binding in self.index.nodes[node_id].bindings:
+                self._audit_leaf(node_id, binding, data)
+
+    def _audit_leaf(self, node_id: str, binding: PureBinding, data: Mapping[str, Any]) -> None:
+        address = binding.address
+        if isinstance(address, NodeResultAddress) and address.node_id in self.index.nodes:
+            return  # derived, not a durable leaf
+        found, value = self.resolve_state_address(address, data)
+        if not found:
+            raise _error("durable_input_missing", "durable leaf is missing", node_id=node_id, address=repr(address))
+        try:
+            if isinstance(address, NodeResultAddress) and address.field == "exit_code":
+                if type(value) is not int:
+                    raise ValueError("exit_code must be an integer")
+            elif isinstance(address, NodeResultAddress) and address.field == "outcome":
+                if type(value) is not _INTRINSIC_TYPES.get(address.member):
+                    raise ValueError(f"outcome.{address.member} has the wrong type")
+            if binding.value_type is not None:
+                _coerce_value(value, binding.value_type, context="durable leaf")
+        except (ValueError, PureExprEvaluationError) as exc:
+            raise _error("durable_input_invalid", f"durable leaf is invalid: {exc}", node_id=node_id, address=repr(address))
+
+    # ---- persisted-surface audit --------------------------------------
+    def audit_persisted_surfaces(
+        self, *, state: Any, state_manager: Any, resolve_bundle_path: Callable[[PureResultNode], Any]
+    ) -> None:
+        data = _state_dict(state)
+        for node in self.index.nodes.values():
+            self._audit_state_surfaces(node, data)
+            path = resolve_bundle_path(node)
+            if path is not None and path.exists():
+                raise _error(PROFILE_CONFLICT, "pure result bundle persisted", surface="pure_bundle", node_id=node.node_id)
+        self._audit_checkpoint_surfaces(data, state_manager)
+
+    def _audit_state_surfaces(self, node: PureResultNode, data: Mapping[str, Any]) -> None:
+        row = (data.get("steps") or {}).get(node.presentation_key)
+        witness = self.witness(node.node_id)
+        if row is not None and not is_pure_completion_shell(row, witness) and not (
+            isinstance(row, Mapping) and row.get("status") in {"failed", "skipped"}
+        ):
+            raise _error(PROFILE_CONFLICT, "value row persisted", surface="steps", node_id=node.node_id)
+        for versions in (data.get("private_artifact_versions") or {}).values():
+            for entry in versions:
+                if isinstance(entry, Mapping) and (
+                    entry.get("producer") == node.step_id
+                    or entry.get("producer_name") == node.presentation_key
+                ):
+                    raise _error(
+                        PROFILE_CONFLICT, "private lineage persisted",
+                        surface="private_artifact_versions", node_id=node.node_id,
+                    )
+
+    def _audit_checkpoint_surfaces(self, data: Mapping[str, Any], state_manager: Any) -> None:
+        from orchestrator.workflow_lisp.lexical_checkpoints import (
+            resolve_checkpoint_record_family_path,
+        )
+
+        frame_id = self.scope_path.call_frame_ids[-1] if self.scope_path.call_frame_ids else None
+        step_ids = {n.step_id: n for n in self.index.nodes.values()}
+        for point in self.bundle.runtime_plan.lexical_checkpoint_points:
+            family = resolve_checkpoint_record_family_path(
+                state_manager=state_manager,
+                workflow_name=point.workflow_name,
+                checkpoint_id=point.checkpoint_id,
+                storage_scope=(point.details.get("storage") or {}).get("resume_scope"),
+            )
+            if not family.is_dir():
+                continue
+            for record_file in sorted(family.glob("*.json")):
+                record = json.loads(record_file.read_text(encoding="utf-8"))
+                identity = record.get("frame_identity") or {}
+                if identity.get("call_frame_id") != frame_id:
+                    continue
+                if point.step_id in step_ids:
+                    raise _error(
+                        PROFILE_CONFLICT, "checkpoint record persisted",
+                        surface="checkpoint_record", step_id=point.step_id,
+                    )
+                for binding in (record.get("restore_payload") or {}).get("bindings", ()):
+                    if binding.get("source_step_id") in step_ids:
+                        raise _error(
+                            PROFILE_CONFLICT, "restore binding persisted",
+                            surface="restore_payload", step_id=binding.get("source_step_id"),
+                        )
+
+
+def _collect_addresses(obj: Any, keys: Mapping[str, str], out: list, plan: Any, _depth: int = 0) -> None:
+    """Collect NodeResultAddress values and ``root.steps.<key>`` refs inside an IR object."""
+
+    if _depth > 12 or obj is None:
+        return
+    if isinstance(obj, NodeResultAddress):
+        out.append(obj)
+    elif isinstance(obj, str):
+        for key, nid in keys.items():
+            prefix = f"root.steps.{key}."
+            at = obj.find(prefix)
+            if at < 0:
+                continue
+            tail = obj[at + len(prefix):]
+            for field_name in ("artifacts", "outcome"):
+                if tail.startswith(field_name + "."):
+                    member = tail[len(field_name) + 1:].split()[0].split("}")[0].split('"')[0]
+                    out.append(NodeResultAddress(nid, field_name, member or None))
+            if tail.startswith("exit_code"):
+                out.append(NodeResultAddress(nid, "exit_code"))
+    elif isinstance(obj, Mapping):
+        for value in obj.values():
+            _collect_addresses(value, keys, out, plan, _depth + 1)
+    elif isinstance(obj, (list, tuple, set, frozenset)):
+        for value in obj:
+            _collect_addresses(value, keys, out, plan, _depth + 1)
+    elif hasattr(obj, "__dataclass_fields__"):
+        for name in obj.__dataclass_fields__:
+            _collect_addresses(getattr(obj, name), keys, out, plan, _depth + 1)

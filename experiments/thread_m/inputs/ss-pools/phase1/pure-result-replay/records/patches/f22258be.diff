+"""Persisted-surface conflicts of eligible pure nodes (read-only audit)."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.workflow.pure_result_replay import PureReplayRuntime, PureResultReplayIndexError
+from orchestrator.workflow.pure_result_replay_conflicts import pure_bundle_path_from_state
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.pure_replay_helpers import FIXTURES, CliWorkspace, compile_bundle
+
+SUMMARY = "interrupt::orchestrate__summary"
+SUMMARY_STEP_ID = "root.interrupt_orchestrate__summary"
+
+
+@pytest.fixture
+def audited(tmp_path: Path):
+    """A completed profiled run plus a function that audits it read-only."""
+    ws = CliWorkspace(tmp_path, "interrupt.orc")
+    assert ws.run().returncode == 0
+    (tmp_path / "bundle").mkdir()
+    bundle = compile_bundle(FIXTURES / "interrupt.orc", tmp_path / "bundle")
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("interrupt.orc"))
+
+    from orchestrator.state import StateManager
+
+    def audit(state: dict) -> None:
+        manager = StateManager(ws.root, run_id=ws.run_id)
+        manager.load()
+        runtime.audit_persisted_surfaces(
+            state=state,
+            state_manager=manager,
+            resolve_bundle_path=lambda node: pure_bundle_path_from_state(runtime, node, state, ws.root),
+        )
+
+    return ws, runtime, audit
+
+
+def _surface(error: pytest.ExceptionInfo) -> str:
+    assert error.value.reason == "profile_conflict"
+    return error.value.context["surface"]
+
+
+def test_clean_profiled_state_passes_and_audit_writes_nothing(audited) -> None:
+    ws, _runtime, audit = audited
+    before = ws.tree_snapshot()
+    audit(ws.state())
+    assert ws.tree_snapshot() == before
+
+
+def test_value_row_is_a_steps_conflict(audited) -> None:
+    ws, _runtime, audit = audited
+    state = ws.state()
+    state["steps"][SUMMARY]["artifacts"] = {"return__label": "x"}
+    with pytest.raises(PureResultReplayIndexError) as error:
+        audit(state)
+    assert _surface(error) == "steps"
+
+
+def test_private_lineage_is_a_private_artifact_versions_conflict(audited) -> None:
+    ws, _runtime, audit = audited
+    state = ws.state()
+    state["private_artifact_versions"] = {"a": [{"version": 1, "producer": SUMMARY_STEP_ID}]}
+    with pytest.raises(PureResultReplayIndexError) as error:
+        audit(state)
+    assert _surface(error) == "private_artifact_versions"
+
+
+def test_existing_bundle_file_is_a_pure_bundle_conflict(audited) -> None:
+    ws, runtime, audit = audited
+    state = ws.state()
+    node = next(n for n in runtime.index.nodes.values() if n.presentation_key == SUMMARY)
+    path = pure_bundle_path_from_state(runtime, node, state, ws.root)
+    assert path is not None and not path.exists()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text("{}", encoding="utf-8")
+    with pytest.raises(PureResultReplayIndexError) as error:
+        audit(state)
+    assert _surface(error) == "pure_bundle"
+
+
+def _first_effect_record(ws: CliWorkspace) -> Path:
+    return next((ws.run_root / "workflow_lisp" / "checkpoints" / "records").rglob("*.json"))
+
+
+def test_restore_binding_sourced_from_eligible_step_is_a_restore_payload_conflict(audited) -> None:
+    ws, _runtime, audit = audited
+    for path in (ws.run_root / "workflow_lisp" / "checkpoints" / "records").rglob("*.json"):
+        record = json.loads(path.read_text(encoding="utf-8"))
+        record["restore_payload"] = {"bindings": [{"source_step_id": "interrupt_orchestrate__summary"}]}
+        path.write_text(json.dumps(record), encoding="utf-8")
+    with pytest.raises(PureResultReplayIndexError) as error:
+        audit(ws.state())
+    assert _surface(error) == "restore_payload"
+
+
+def test_checkpoint_record_for_eligible_point_is_a_conflict_but_other_frames_are_allowed(audited) -> None:
+    ws, runtime, audit = audited
+    from orchestrator.workflow_lisp.lexical_checkpoints import (
+        _runtime_plan_points_by_step_id,
+        resolve_checkpoint_index_path,
+    )
+    from orchestrator.state import StateManager
+
+    manager = StateManager(ws.root, run_id=ws.run_id)
+    manager.load()
+    point = _runtime_plan_points_by_step_id(runtime.bundle.runtime_plan).get(SUMMARY_STEP_ID)
+    if point is None:
+        pytest.skip("eligible node has no checkpoint point in this fixture")
+    index_path = resolve_checkpoint_index_path(
+        state_manager=manager, workflow_name=point.workflow_name, checkpoint_id=point.checkpoint_id
+    )
+    record_path = ws.root / "foreign_record.json"
+    record_path.write_text("{}", encoding="utf-8")
+    entry = {"record_id": "r", "frame_identity": {"call_frame_id": "other-frame"}, "record_path": "foreign_record.json"}
+    index_path.parent.mkdir(parents=True, exist_ok=True)
+    index_path.write_text(json.dumps({"records": [entry]}), encoding="utf-8")
+    audit(ws.state())  # another frame's record is allowed
+    entry["frame_identity"] = {"call_frame_id": None}
+    index_path.write_text(json.dumps({"records": [entry]}), encoding="utf-8")
+    with pytest.raises(PureResultReplayIndexError) as error:
+        audit(ws.state())
+    assert _surface(error) == "checkpoint_record"

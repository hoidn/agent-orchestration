+def _bundle_with_config(bundle, node_id, config):
+    node = bundle.ir.nodes[node_id]
+    new_node = replace(node, execution_config=replace(node.execution_config, pure_projection=config))
+    nodes = dict(bundle.ir.nodes)
+    nodes[node_id] = new_node
+    return replace(bundle, ir=replace(bundle.ir, nodes=nodes))

+
+def test_scope_kind_mismatch_reports_expected_and_actual_scope(tmp_path: Path) -> None:
+    bundle = compile_bundle(FIXTURES / "chain.orc", tmp_path)
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        derive_pure_result_replay_index(bundle, scope_kind="call_frame")
+    assert exc.value.reason == DEPENDENCY_INDEX_INVALID
+    assert exc.value.context["expected_scope"] == "call_frame"
+    assert exc.value.context["actual_scope"] == "root"
+    assert exc.value.code == "pure_result_replay_unavailable"

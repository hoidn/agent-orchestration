diff --git a/tests/test_result_persistence_profile_state.py b/tests/test_result_persistence_profile_state.py
new file mode 100644
index 0000000..660368d
--- /dev/null
+++ b/tests/test_result_persistence_profile_state.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import RunState, StateManager
+
+PROFILE = "derived_pure_replay.v1"
+
+
+def _manager(tmp_path: Path) -> StateManager:
+    (tmp_path / "wf.yaml").write_text("version: '1.1'\n", encoding="utf-8")
+    return StateManager(tmp_path, run_id="r1")
+
+
+def _minimal(**extra) -> RunState:
+    return RunState(
+        schema_version="2.1", run_id="r", workflow_file="w", workflow_checksum="c",
+        started_at="t", updated_at="t", status="running", **extra,
+    )
+
+
+def test_absent_profile_omits_key_and_round_trips() -> None:
+    payload = _minimal().to_dict()
+    assert "result_persistence_profile" not in payload
+    restored = RunState.from_dict(payload)
+    assert restored.result_persistence_profile is None
+    assert restored.to_dict() == payload
+
+
+def test_profile_set_by_keyword_serializes_and_round_trips() -> None:
+    payload = _minimal(result_persistence_profile=PROFILE).to_dict()
+    assert payload["result_persistence_profile"] == PROFILE
+    assert RunState.from_dict(payload).result_persistence_profile == PROFILE
+
+
+def test_unknown_profile_fails_at_construction() -> None:
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        _minimal(result_persistence_profile="other.v9")
+
+
+def test_initialize_writes_profile_in_first_write(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.initialize("wf.yaml", result_persistence_profile=PROFILE)
+    on_disk = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert on_disk["result_persistence_profile"] == PROFILE
+    assert on_disk["schema_version"] == "2.1"
+
+
+def test_initialize_rejects_unknown_profile_before_creating_anything(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        manager.initialize("wf.yaml", result_persistence_profile="bogus")
+    assert not manager.run_root.exists()
+
+
+def test_load_rejects_unknown_profile_and_leaves_file_unchanged(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.initialize("wf.yaml")
+    payload = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    payload["result_persistence_profile"] = "bogus"
+    manager.state_file.write_text(json.dumps(payload), encoding="utf-8")
+    before = manager.state_file.read_bytes()
+    with pytest.raises(ValueError, match="result_persistence_profile"):
+        StateManager(tmp_path, run_id="r1").load()
+    assert manager.state_file.read_bytes() == before
+
+
+def test_load_never_backfills_profile(tmp_path: Path) -> None:
+    manager = _manager(tmp_path)
+    manager.initialize("wf.yaml")
+    before = manager.state_file.read_bytes()
+    loaded = StateManager(tmp_path, run_id="r1").load()
+    assert loaded.result_persistence_profile is None
+    assert manager.state_file.read_bytes() == before

--- /dev/null
+++ b/tests/pure_replay_helpers.py
@@ -0,0 +1,152 @@
+"""Compile helpers for derived-pure-replay tests (real compiler, no mocks)."""
+
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+from orchestrator.workflow_lisp.compiler import compile_stage3_entrypoint
+from orchestrator.workflow_lisp.workflows import ExternalToolBinding
+
+FIXTURES = Path(__file__).parent / "fixtures" / "pure_result_replay"
+VALID = Path(__file__).parent / "fixtures" / "workflow_lisp" / "valid"
+COMMANDS = ("step_one", "step_two")
+
+
+def compile_bundles(fixture: Path, tmp_path: Path):
+    local = tmp_path / fixture.name
+    shutil.copy(fixture, local)
+    return compile_stage3_entrypoint(
+        local,
+        source_roots=(tmp_path,),
+        provider_externs={},
+        prompt_externs={},
+        command_boundaries={
+            n: ExternalToolBinding(name=n, stable_command=("python", f"scripts/{n}.py")) for n in COMMANDS
+        },
+        validate_shared=True,
+        workspace_root=tmp_path,
+    ).validated_bundles_by_name
+
+
+def compile_bundle(fixture: Path, tmp_path: Path, name: str = "orchestrate"):
+    bundles = compile_bundles(fixture, tmp_path)
+    return next(b for k, b in bundles.items() if k == name or k.endswith(f"::{name}"))
+
+
+# --- end-to-end CLI workspace -------------------------------------------------
+
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+
+_STEP_ONE = """\
+import json, os, sys
+os.makedirs("marker", exist_ok=True)
+with open("marker/one", "a") as f:
+    f.write("x\\n")
+n = len(open("marker/one").read().splitlines())
+json.dump({"count": n, "report": sys.argv[1]}, open(os.environ["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"], "w"))
+"""
+_STEP_TWO = """\
+import json, os, sys, time
+os.makedirs("marker", exist_ok=True)
+with open("marker/two", "a") as f:
+    f.write("x\\n")
+while os.path.exists("hold"):
+    time.sleep(0.05)
+n = len(open("marker/two").read().splitlines())
+json.dump({"count": 10 + n, "report": sys.argv[1]}, open(os.environ["ORCHESTRATOR_OUTPUT_BUNDLE_PATH"], "w"))
+"""
+
+
+class CliWorkspace:
+    """A temp workspace that runs/resumes a fixture through the real CLI."""
+
+    def __init__(self, tmp_path: Path, fixture: str, inputs: dict[str, str] | None = None) -> None:
+        self.root = tmp_path
+        self.fixture = fixture
+        self.inputs = {"report_path": "artifacts/work/report.txt", **(inputs or {})}
+        shutil.copy(FIXTURES / fixture, tmp_path / fixture)
+        (tmp_path / "scripts").mkdir()
+        (tmp_path / "scripts" / "step_one.py").write_text(_STEP_ONE, encoding="utf-8")
+        (tmp_path / "scripts" / "step_two.py").write_text(_STEP_TWO, encoding="utf-8")
+        (tmp_path / "artifacts" / "work").mkdir(parents=True)
+        (tmp_path / "artifacts" / "work" / "report.txt").write_text("r\n", encoding="utf-8")
+        (tmp_path / "commands.json").write_text(
+            json.dumps({n: {"kind": "external_tool", "stable_command": ["python", f"scripts/{n}.py"]} for n in COMMANDS}),
+            encoding="utf-8",
+        )
+
+    def _cmd(self, *args: str) -> list[str]:
+        return [sys.executable, "-m", "orchestrator", *args]
+
+    def _env(self) -> dict[str, str]:
+        return {**os.environ, "PYTHONPATH": str(REPO_ROOT)}
+
+    def run_args(self) -> list[str]:
+        out = ["run", self.fixture, "--source-root", ".", "--entry-workflow", "orchestrate",
+               "--command-boundaries-file", "commands.json"]
+        for key, value in self.inputs.items():
+            out += ["--input", f"{key}={value}"]
+        return out
+
+    def run(self, hold: bool = False) -> subprocess.CompletedProcess:
+        if hold:
+            (self.root / "hold").write_text("", encoding="utf-8")
+        return subprocess.run(self._cmd(*self.run_args()), cwd=self.root, env=self._env(),
+                              capture_output=True, text=True, timeout=120)
+
+    def run_until_step_two_blocks(self) -> None:
+        """Start a run whose second command blocks on ``hold``, then SIGKILL the run."""
+        (self.root / "hold").write_text("", encoding="utf-8")
+        proc = subprocess.Popen(self._cmd(*self.run_args()), cwd=self.root, env=self._env(),
+                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
+        deadline = time.time() + 60
+        while not (self.root / "marker" / "two").exists() and time.time() < deadline:
+            time.sleep(0.05)
+        time.sleep(0.3)
+        os.killpg(proc.pid, signal.SIGKILL)  # the run and its blocked command die together
+        proc.wait()
+        (self.root / "hold").unlink()
+
+    def resume(self, *extra: str) -> subprocess.CompletedProcess:
+        return subprocess.run(self._cmd("resume", self.run_id, *extra), cwd=self.root, env=self._env(),
+                              capture_output=True, text=True, timeout=120)
+
+    @property
+    def run_root(self) -> Path:
+        """The first run directory created in this workspace (later force-restart roots excluded)."""
+        if not hasattr(self, "_first_run_root"):
+            (self._first_run_root,) = sorted((self.root / ".orchestrate" / "runs").iterdir())
+        return self._first_run_root
+
+    @property
+    def run_id(self) -> str:
+        return self.run_root.name
+
+    @property
+    def state_path(self) -> Path:
+        return self.run_root / "state.json"
+
+    def state(self) -> dict:
+        return json.loads(self.state_path.read_text(encoding="utf-8"))
+
+    def write_state(self, state: dict) -> None:
+        self.state_path.write_text(json.dumps(state, indent=2), encoding="utf-8")
+
+    def count(self, marker: str) -> int:
+        path = self.root / "marker" / marker
+        return len(path.read_text().splitlines()) if path.exists() else 0
+
+    def tree_snapshot(self) -> dict[str, bytes]:
+        return {
+            p.relative_to(self.root).as_posix(): p.read_bytes()
+            for p in sorted(self.root.rglob("*"))
+            if p.is_file() and ".orchestrate/build" not in p.as_posix()
+        }

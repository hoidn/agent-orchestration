+++ b/tests/test_pure_result_replay_progress.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+import copy
+
+import pytest
+
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+W = PureReplayVisitWitness("wf::pure", 3, "root.pure", 1)
+CURSOR = {
+    "name": "wf::pure", "index": 3, "type": "pure_projection", "step_id": "root.pure",
+    "visit_count": 1, "status": "running", "started_at": "t", "last_heartbeat_at": "t",
+}
+OTHER_CURSOR = {**CURSOR, "name": "wf::other", "step_id": "root.other", "type": "command"}
+FAILED = {"name": "wf::pure", "step_id": "root.pure", "visit_count": 1, "status": "failed", "exit_code": 2}
+SKIPPED = {**FAILED, "status": "skipped", "skipped": True, "exit_code": 0}
+
+
+def _state(visit=None, cursor=None, row=None):
+    state = {"step_visits": {}, "steps": {}, "current_step": cursor}
+    if visit is not None:
+        state["step_visits"]["wf::pure"] = visit
+    if row is not None:
+        state["steps"]["wf::pure"] = row
+    return state
+
+
+def test_shell_is_exact_literal() -> None:
+    assert build_pure_completion_shell(W) == {
+        "name": "wf::pure", "step_id": "root.pure", "visit_count": 1, "status": "completed",
+        "exit_code": 0,
+        "outcome": {"status": "completed", "phase": "execution", "class": "completed", "retryable": False},
+        "result_storage": "derived_pure_replay.v1",
+    }
+    validate_pure_completion_shell(build_pure_completion_shell(W), witness=W)
+
+
+@pytest.mark.parametrize("extra", ["value", "output", "text", "json", "artifacts", "debug", "duration_ms", "output_bundle"])
+def test_shell_rejects_extra_keys(extra: str) -> None:
+    row = {**build_pure_completion_shell(W), extra: 1}
+    with pytest.raises(ValueError):
+        validate_pure_completion_shell(row, witness=W)
+
+
+def test_shell_rejects_missing_wrong_value_and_inexact_outcome() -> None:
+    good = build_pure_completion_shell(W)
+    for mutate in (
+        lambda r: r.pop("result_storage"),
+        lambda r: r.update(exit_code=1),
+        lambda r: r.update(visit_count=2),
+        lambda r: r.update(name="other"),
+        lambda r: r["outcome"].update(extra=1),
+        lambda r: r["outcome"].update(retryable=True),
+        lambda r: r.update(exit_code=False),
+    ):
+        row = copy.deepcopy(good)
+        mutate(row)
+        with pytest.raises(ValueError):
+            validate_pure_completion_shell(row, witness=W)
+
+
+@pytest.mark.parametrize(
+    "state,expected",
+    [
+        (_state(), "unstarted"),
+        (_state(cursor=OTHER_CURSOR), "unstarted"),
+        (_state(visit=1, cursor=CURSOR), "interrupted"),
+        (_state(visit=1, row=build_pure_completion_shell(W)), "derived_complete"),
+        (_state(visit=1, cursor=OTHER_CURSOR, row=build_pure_completion_shell(W)), "derived_complete"),
+        (_state(visit=1, row=FAILED), "durable_failure_skip"),
+        (_state(visit=1, row=SKIPPED), "durable_failure_skip"),
+    ],
+)
+def test_valid_progress_states(state, expected) -> None:
+    assert classify_pure_replay_progress(state, witness=W) == expected
+
+
+@pytest.mark.parametrize(
+    "state",
+    [
+        _state(visit=1),
+        _state(cursor=CURSOR),
+        _state(row=build_pure_completion_shell(W)),
+        _state(visit=1, cursor=CURSOR, row=FAILED),
+        _state(visit=1, cursor=CURSOR, row=build_pure_completion_shell(W)),
+        _state(visit=2, cursor={**CURSOR, "visit_count": 2}),
+        _state(visit=2, row={**build_pure_completion_shell(W), "visit_count": 2}),
+        _state(visit=1, cursor={**CURSOR, "step_id": "root.x"}),
+        _state(visit=1, cursor={**CURSOR, "index": 4}),
+        _state(visit=1, cursor={**CURSOR, "type": "command"}),
+        _state(visit=1, cursor={**CURSOR, "status": "paused"}),
+        _state(visit=1, row={**FAILED, "visit_count": 2}),
+        _state(visit=1, row={**FAILED, "step_id": "root.x"}),
+        _state(visit=1, row={**SKIPPED, "name": "wf::x"}),
+        _state(visit=1, row={"status": "completed", "exit_code": 0, "artifacts": {"a": 1},
+                              "name": "wf::pure", "step_id": "root.pure", "visit_count": 1}),
+        _state(visit=1, row={**FAILED, "status": "running"}),
+    ],
+)
+def test_invalid_progress_states(state) -> None:
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        classify_pure_replay_progress(state, witness=W)
+    assert exc.value.reason == "progress_witness_invalid"
+
+
+def test_visitless_structural_skip_requires_opt_in_and_matching_identity() -> None:
+    skip = {"name": "wf::pure", "step_id": "root.pure", "status": "skipped", "exit_code": 0, "skipped": True}
+    state = _state(row=skip)
+    assert classify_pure_replay_progress(state, witness=W, structural_skip_allowed=True) == "durable_failure_skip"
+    with pytest.raises(PureResultReplayIndexError):
+        classify_pure_replay_progress(state, witness=W)
+    bad = _state(row={**skip, "step_id": "root.other"})
+    with pytest.raises(PureResultReplayIndexError):
+        classify_pure_replay_progress(bad, witness=W, structural_skip_allowed=True)

new file mode 100644
index 0000000..6396416
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_conflicts.py
@@ -0,0 +1,127 @@
+"""Read-only audit of persisted surfaces against the derived pure-result profile.
+
+Reads: run state rows, private lineage, pure bundle files (existence only), and
+checkpoint index/record sidecars of the current scope. Never writes or creates
+anything; callers run it before any state, session or observation write.
+"""
+
+from __future__ import annotations
+
+from hashlib import sha256
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from .pure_result_replay_core import PROFILE_CONFLICT, PureResultReplayIndexError
+
+_SHELL_KEYS = frozenset(
+    {"name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage"}
+)
+
+
+def _conflict(surface: str, node: Any, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROFILE_CONFLICT,
+        message,
+        context={"surface": surface, "node_id": node.node_id, "step_id": node.step_id, **context},
+    )
+
+
+def _is_value_bearing(row: Any) -> bool:
+    return isinstance(row, Mapping) and row.get("status") == "completed" and bool(set(row) - _SHELL_KEYS)
+
+
+def _checkpoint_points(runtime: Any) -> dict[str, Any]:
+    from orchestrator.workflow_lisp.lexical_checkpoints import _runtime_plan_points_by_step_id
+
+    return _runtime_plan_points_by_step_id(runtime.bundle.runtime_plan)
+
+
+def _scope_records(runtime: Any, state_manager: Any, point: Any) -> list[Mapping[str, Any]]:
+    """Checkpoint records of this scope (current frame) for one point; read-only."""
+    from orchestrator.workflow_lisp.lexical_checkpoints import (
+        _point_payload,
+        resolve_checkpoint_index_path,
+    )
+
+    payload = _point_payload(point)
+    workflow_name = str(payload.get("workflow_name") or runtime.bundle.runtime_plan.workflow_name or "")
+    index_path = resolve_checkpoint_index_path(
+        state_manager=state_manager,
+        workflow_name=workflow_name,
+        checkpoint_id=str(payload.get("checkpoint_id") or ""),
+    )
+    index = state_manager.read_runtime_sidecar_json(index_path)
+    frame_id = getattr(state_manager, "frame_id", None)
+    records = []
+    for entry in (index or {}).get("records", ()):
+        identity = entry.get("frame_identity") if isinstance(entry, Mapping) else None
+        if isinstance(identity, Mapping) and identity.get("call_frame_id") == frame_id:
+            path = state_manager.workspace / str(entry.get("record_path"))
+            record = state_manager.read_runtime_sidecar_json(path)
+            records.append(record if isinstance(record, Mapping) else {})
+    return records
+
+
+def _audit_checkpoints(runtime: Any, state_manager: Any) -> None:
+    eligible_step_ids = {n.step_id: n for n in runtime.index.nodes.values()}
+    for step_id, point in _checkpoint_points(runtime).items():
+        for record in _scope_records(runtime, state_manager, point):
+            if step_id in eligible_step_ids:
+                raise _conflict("checkpoint_record", eligible_step_ids[step_id], "eligible pure node has a checkpoint record")
+            payload = record.get("restore_payload")
+            for binding in (payload or {}).get("bindings", ()) if isinstance(payload, Mapping) else ():
+                source = binding.get("source_step_id") if isinstance(binding, Mapping) else None
+                owner = eligible_step_ids.get(source) or eligible_step_ids.get(f"root.{source}")
+                if owner is not None:
+                    raise _conflict("restore_payload", owner, "restore binding sources an eligible pure step")
+
+
+def pure_bundle_path_from_state(runtime: Any, node: Any, state: Mapping[str, Any], workspace: Path) -> Path | None:
+    """Historical pure-bundle path of ``node`` derived from bound inputs; creates nothing."""
+    ir_node = runtime.bundle.ir.nodes.get(node.node_id)
+    bundle = getattr(getattr(ir_node, "execution_config", None), "common", None)
+    template = (getattr(bundle, "output_bundle", None) or {}).get("path")
+    if not isinstance(template, str) or not template.startswith("${inputs.") or not template.endswith("}"):
+        return None
+    raw = (state.get("bound_inputs") or {}).get(template[len("${inputs."):-1])
+    if not isinstance(raw, str) or not raw:
+        return None
+    path = (workspace / raw).resolve()
+    try:
+        relative = path.relative_to(workspace.resolve())
+    except ValueError:
+        return path
+    if all(len(part.encode("utf-8")) <= 240 for part in relative.parts):
+        return path
+    digest = sha256(relative.as_posix().encode("utf-8")).hexdigest()
+    return workspace / ".orchestrate" / "runtime_sidecars" / "pure_projection" / digest[:2] / f"{digest}.json"
+
+
+def _audit_node(runtime: Any, node: Any, view: Mapping[str, Any], resolve_bundle_path: Callable[[Any], Path | None]) -> None:
+    if _is_value_bearing((view.get("steps") or {}).get(node.presentation_key)):
+        raise _conflict("steps", node, "eligible pure node has a persisted value row")
+    bundle_path = resolve_bundle_path(node)
+    if bundle_path is not None and Path(bundle_path).exists():
+        raise _conflict("pure_bundle", node, "eligible pure node has a persisted result bundle", path=str(bundle_path))
+    for versions in (view.get("private_artifact_versions") or {}).values():
+        for entry in versions if isinstance(versions, list) else ():
+            if isinstance(entry, Mapping) and (
+                entry.get("producer") == node.step_id or entry.get("producer_name") == node.presentation_key
+            ):
+                raise _conflict("private_artifact_versions", node, "eligible pure node has private lineage")
+
+
+def audit_persisted_surfaces(
+    runtime: Any,
+    *,
+    state: Any,
+    state_manager: Any,
+    resolve_bundle_path: Callable[[Any], Path | None],
+) -> None:
+    """Raise ``profile_conflict`` / ``progress_witness_invalid``; writes nothing."""
+    view = state.to_dict() if hasattr(state, "to_dict") else state
+    for node in runtime.index.nodes.values():
+        _audit_node(runtime, node, view, resolve_bundle_path)
+    _audit_checkpoints(runtime, state_manager)
+    for node_id in runtime.index.nodes:
+        runtime.classify(node_id, view)
diff --git a/orchestrator/workflow/pure_result_replay_core.py b/orchestrator/workflow/pure_result_replay_core.py
new file mode 100644
index 0000000..0ba526c
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_core.py
@@ -0,0 +1,43 @@
+"""Dependency-free constants, error type and validator for derived_pure_replay.v1.
+
+Contract: ``specs/state.md``. Imported by every ``pure_result_replay_*`` module.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+DERIVED_PURE_REPLAY_PROFILE = "derived_pure_replay.v1"
+PURE_RESULT_REPLAY_UNAVAILABLE = "pure_result_replay_unavailable"
+
+DEPENDENCY_INDEX_INVALID = "dependency_index_invalid"
+REACHABILITY_AMBIGUOUS = "reachability_ambiguous"
+MULTIPLE_VISIT_REGION = "multiple_visit_region"
+PROGRESS_WITNESS_INVALID = "progress_witness_invalid"
+PROFILE_CONFLICT = "profile_conflict"
+DURABLE_INPUT_MISSING = "durable_input_missing"
+DURABLE_INPUT_INVALID = "durable_input_invalid"
+BINDING_UNRESOLVED = "binding_unresolved"
+EVALUATION_FAILED = "evaluation_failed"
+OUTPUT_CONTRACT_INVALID = "output_contract_invalid"
+
+
+class PureResultReplayIndexError(ValueError):
+    """Fail-closed error for derived pure-result replay."""
+
+    code = PURE_RESULT_REPLAY_UNAVAILABLE
+
+    def __init__(self, reason: str, message: str, *, context: Optional[Mapping[str, Any]] = None):
+        super().__init__(message)
+        self.reason = reason
+        self.context = dict(context or {})
+
+
+def validate_result_persistence_profile(value: Any) -> Optional[str]:
+    """Return ``value`` if it is None or the supported profile, else raise ValueError."""
+    if value is None or value == DERIVED_PURE_REPLAY_PROFILE:
+        return value
+    raise ValueError(
+        f"unsupported result_persistence_profile {value!r}; "
+        f"only {DERIVED_PURE_REPLAY_PROFILE!r} is supported"
+    )
diff --git a/orchestrator/workflow/pure_result_replay_executor.py b/orchestrator/workflow/pure_result_replay_executor.py
new file mode 100644
index 0000000..2b73443
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_executor.py
@@ -0,0 +1,186 @@
+"""Executor-side glue for derived pure-result replay (kept out of executor.py).
+
+Every function takes the ``WorkflowExecutor`` explicitly and reads its
+``state_manager``, ``loaded_bundle`` and ``_pure_replay`` runtime; none of
+them dispatches effects.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, Mapping, Optional
+
+from .loaded_bundle import workflow_bundle
+from .pure_result_replay_conflicts import pure_bundle_path_from_state
+from .pure_result_replay_core import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PURE_RESULT_REPLAY_UNAVAILABLE,
+    PureResultReplayIndexError,
+)
+from .pure_result_replay_progress import INTERRUPTED, UNSTARTED
+from .pure_result_replay_runtime import PureReplayRuntime
+
+
+def configure_runtime(executor: Any, state: Mapping[str, Any]) -> Optional[PureReplayRuntime]:
+    """Build the replay runtime only for a profiled scope with a typed bundle."""
+    if state.get("result_persistence_profile") != DERIVED_PURE_REPLAY_PROFILE:
+        return None
+    bundle = workflow_bundle(executor.loaded_bundle)
+    if bundle is None:
+        return None
+    return PureReplayRuntime(bundle=bundle, scope_path=executor.resume_scope_path)
+
+
+def preflight(executor: Any, state: Dict[str, Any]) -> None:
+    """Read-only profile audit; raises ``PureResultReplayIndexError`` without writing."""
+    runtime = executor._pure_replay
+    if runtime is None:
+        return
+    runtime.audit_persisted_surfaces(
+        state=state,
+        state_manager=executor.state_manager,
+        resolve_bundle_path=lambda node: pure_bundle_path_from_state(
+            runtime, node, state, executor.workspace
+        ),
+    )
+
+
+def failure_error(exc: PureResultReplayIndexError) -> Dict[str, Any]:
+    return {
+        "type": PURE_RESULT_REPLAY_UNAVAILABLE,
+        "message": str(exc),
+        "context": {"reason": exc.reason, **exc.context},
+    }
+
+
+def fail_closed(executor: Any, exc: PureResultReplayIndexError) -> Dict[str, Any]:
+    """Record the single failed-run diagnostic and return the persisted state."""
+    executor.state_manager.record_pure_result_replay_rejection(failure_error(exc))
+    persisted = executor.state_manager.load().to_dict()
+    persisted["status"] = "failed"
+    return persisted
+
+
+def witness_for_step(executor: Any, step_id: Optional[str]):
+    runtime = executor._pure_replay
+    node_id = runtime.node_id_for_step_id(step_id) if runtime is not None and step_id else None
+    return (node_id, runtime.witness(node_id)) if node_id is not None else (None, None)
+
+
+def begin_visit(executor: Any, state: Dict[str, Any], node_id: str, witness: Any) -> int:
+    """Begin (or reuse the interrupted) single visit of an eligible node, atomically."""
+    manager = executor.state_manager
+    progress = executor._pure_replay.classify(node_id, manager.state.to_dict())
+    if progress == UNSTARTED:
+        count = manager.begin_eligible_pure_visit(
+            step_name=witness.presentation_key, step_index=witness.step_index, step_id=witness.step_id
+        )
+    elif progress == INTERRUPTED:
+        count = manager.reuse_interrupted_eligible_pure_visit(witness)
+    else:
+        raise RuntimeError(f"eligible pure node {node_id} reached in state {progress}")
+    state.setdefault("step_visits", {})[witness.presentation_key] = count
+    executor._pure_visit_witness = witness
+    return count
+
+
+def take_settlement(executor: Any, step_name: str):
+    """Consume the active visit witness when it belongs to ``step_name``."""
+    witness = executor._pure_visit_witness
+    if witness is not None and witness.presentation_key == step_name:
+        executor._pure_visit_witness = None
+        return witness
+    return None
+
+
+def record_result(executor: Any, witness: Any, finalized: Mapping[str, Any]) -> None:
+    runtime = executor._pure_replay
+    if finalized.get("status") == "completed":
+        runtime.record_full_result(runtime.node_id_for_step_id(witness.step_id), witness=witness, result=finalized)
+
+
+def replay_results(executor: Any, state: Dict[str, Any], restart_node_id: Optional[str]) -> None:
+    """Audit leaves, re-derive completed eligible nodes and install them in memory only."""
+    runtime = executor._pure_replay
+    if runtime is None:
+        return
+    runtime.audit_boundary_leaves(restart_node_id, state=state)
+
+    def evaluate(node_id: str, overlay: Dict[str, Any]) -> Mapping[str, Any]:
+        step = executor._runtime_step_for_node_id(node_id)
+        from .steps.pure_projection import evaluate_pure_projection
+
+        return evaluate_pure_projection(executor, executor._typed_execution_step(step), overlay)
+
+    required = runtime.required_node_ids_for_boundary(restart_node_id, state=state)
+    rows = {
+        node_id: runtime.replay_node(node_id, state=state, evaluate_node=evaluate)
+        for node_id in required
+    }
+    steps = state.setdefault("steps", {})
+    for node_id, row in rows.items():
+        steps[runtime.index.nodes[node_id].presentation_key] = row
+
+
+_EFFECT_KINDS = frozenset(
+    {
+        "command", "provider", "provider_supervision", "provider_peer_group", "adjudicated_provider",
+        "wait_for", "resource_transition", "materialize_view", "materialize_artifacts",
+        "call_boundary", "for_each", "repeat_until_frame",
+    }
+)
+
+
+def _entry_prefix_is_effect_free(executor: Any, state: Mapping[str, Any], restart_node_id: Optional[str]) -> bool:
+    """Every node before the boundary is replayable pure work or an untouched non-effect/effect node."""
+    runtime = executor._pure_replay
+    plan = executor.runtime_plan
+    ordered = tuple(plan.ordered_node_ids)
+    if restart_node_id not in ordered:
+        return False
+    cursor = state.get("current_step")
+    for node_id in ordered[: ordered.index(restart_node_id)]:
+        node = plan.nodes[node_id]
+        if runtime.is_eligible(node_id):
+            if runtime.classify(node_id, state) not in ("derived_complete", "unstarted", "durable_failure_skip"):
+                return False
+        elif node.kind in _EFFECT_KINDS:
+            touched = (
+                node.presentation_key in (state.get("step_visits") or {})
+                or node.presentation_key in (state.get("steps") or {})
+                or (isinstance(cursor, Mapping) and cursor.get("name") == node.presentation_key)
+            )
+            if touched:
+                return False
+    return True
+
+
+def default_resume_witness(executor: Any, state: Mapping[str, Any], restart_node_id: Optional[str]) -> Dict[str, Any]:
+    """Keyword arguments carrying the profile witness into default-resume selection."""
+    runtime = executor._pure_replay
+    if runtime is None:
+        return {}
+    return {
+        "eligible_pure_step_ids": frozenset(n.step_id for n in runtime.index.nodes.values()),
+        # classify the durable view: the in-memory state already carries replayed full rows
+        "frame_entry_replay_validated": _entry_prefix_is_effect_free(
+            executor, executor.state_manager.state.to_dict(), restart_node_id
+        ),
+    }
+
+
+def preflight_profiled_resume(bundle: Any, state: Any, state_manager: Any, workflow_path: Any) -> None:
+    """CLI entry: the same read-only audit as the executor, before any resume write."""
+    from .resume_projection_integrity import ResumeScopePath
+
+    typed = workflow_bundle(bundle)
+    if typed is None:
+        return
+    runtime = PureReplayRuntime(bundle=typed, scope_path=ResumeScopePath.root(str(workflow_path)))
+    view = state.to_dict()
+    runtime.audit_persisted_surfaces(
+        state=view,
+        state_manager=state_manager,
+        resolve_bundle_path=lambda node: pure_bundle_path_from_state(
+            runtime, node, view, state_manager.workspace
+        ),
+    )
diff --git a/orchestrator/workflow/pure_result_replay_index.py b/orchestrator/workflow/pure_result_replay_index.py
new file mode 100644
index 0000000..8729854
--- /dev/null
+++ b/orchestrator/workflow/pure_result_replay_index.py
@@ -0,0 +1,475 @@
+"""Derive the pure-result replay index from a loaded workflow bundle.
+
+Dependencies: reads (never mutates or serializes) ``bundle.runtime_plan``,
+``bundle.ir`` pure-projection configs and ``bundle.projection``. No external or
+stateful inputs. Refs are scoped to the bundle that holds them.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field, replace
+from typing import Any, Iterable, Mapping, Optional
+
+from .pure_result_replay_core import (
+    DEPENDENCY_INDEX_INVALID,
+    MULTIPLE_VISIT_REGION,
+    REACHABILITY_AMBIGUOUS,
+    PureResultReplayIndexError,
+)
+
+ROOT_SCOPE = "root"
+_LOOP_KINDS = {"for_each", "repeat_until_frame"}
+_MARKER_KINDS = {"if_branch_marker", "match_case_marker"}
+_INTRINSICS = ("exit_code", "outcome.status", "outcome.phase", "outcome.class", "outcome.retryable")
+
+
+@dataclass(frozen=True)
+class PureReplayAddress:
+    """Typed address of one durable or derived value inside a scope."""
+
+    kind: str  # "input" | "step_artifact" | "step_intrinsic"
+    owner: str  # presentation key of the owning step; "" for inputs
+    field: str  # input path, artifact name, or intrinsic path
+
+    @property
+    def ref(self) -> str:
+        if self.kind == "input":
+            return f"inputs.{self.field}"
+        section = "artifacts." if self.kind == "step_artifact" else ""
+        return f"root.steps.{self.owner}.{section}{self.field}"
+
+
+@dataclass(frozen=True)
+class PureReplayBinding:
+    path: tuple
+    address: PureReplayAddress
+
+
+@dataclass(frozen=True)
+class PureReplayNode:
+    node_id: str
+    step_id: str
+    presentation_key: str
+    bindings: tuple[PureReplayBinding, ...]
+    output_addresses: tuple[PureReplayAddress, ...]
+    output_contracts: Mapping[str, Any]
+    pure_dependency_node_ids: tuple[str, ...]
+    durable_dependency_node_ids: tuple[str, ...]
+    structural_skip_owner: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class PureResultReplayIndex:
+    scope_kind: str
+    nodes: Mapping[str, PureReplayNode]
+    topological_node_ids: tuple[str, ...]
+    ineligible_pure_reasons: Mapping[str, str]
+    _owner_by_key: Mapping[str, str] = field(default_factory=dict, repr=False, compare=False)
+
+    def required_pure_node_ids(
+        self,
+        seed_addresses: Iterable[Any],
+        *,
+        reached_node_ids: Iterable[str],
+    ) -> tuple[str, ...]:
+        """Eligible pure nodes (and their pure inputs) needed to rebuild the seeds."""
+        reached = set(reached_node_ids)
+        pending = []
+        for seed in seed_addresses:
+            owner = seed.owner if isinstance(seed, PureReplayAddress) else self._owner_for_ref(str(seed))
+            node_id = self._owner_by_key.get(owner)
+            if node_id in self.nodes and node_id in reached:
+                pending.append(node_id)
+        needed: set[str] = set()
+        while pending:
+            node_id = pending.pop()
+            if node_id in needed:
+                continue
+            needed.add(node_id)
+            pending.extend(self.nodes[node_id].pure_dependency_node_ids)
+        return tuple(node_id for node_id in self.topological_node_ids if node_id in needed)
+
+    def _owner_for_ref(self, ref: str) -> str:
+        for key in sorted(self._owner_by_key, key=len, reverse=True):
+            if ref.startswith(f"root.steps.{key}."):
+                return key
+        return ""
+
+
+def _invalid(message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(DEPENDENCY_INDEX_INVALID, message, context=context)
+
+
+def _plain(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {str(k): _plain(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(v) for v in value]
+    return value
+
+
+def loop_owned_node_ids(plan_nodes: Mapping[str, Any]) -> set[str]:
+    owned: set[str] = set()
+    claimed_by: dict[str, str] = {}
+    for node in plan_nodes.values():
+        for nested in node.nested_body_node_ids:
+            if claimed_by.setdefault(nested, node.node_id) != node.node_id:
+                raise PureResultReplayIndexError(
+                    REACHABILITY_AMBIGUOUS,
+                    f"node {nested} is claimed by multiple owners",
+                    context={"node_id": nested},
+                )
+        if node.kind in _LOOP_KINDS:
+            stack = list(node.nested_body_node_ids)
+            while stack:
+                nested = stack.pop()
+                if nested not in owned:
+                    owned.add(nested)
+                    child = plan_nodes.get(nested)
+                    if child is not None:
+                        stack.extend(child.nested_body_node_ids)
+    return owned
+
+
+def _cyclic_node_ids(plan_nodes: Mapping[str, Any]) -> set[str]:
+    """Nodes on a control-flow cycle (fallthrough/routed transfers).
+
+    ponytail: per-node reachability, O(nodes * edges); switch to Tarjan SCC if plans grow large.
+    """
+    edges = {
+        nid: [t for t in ([n.fallthrough_node_id] + list(n.routed_transfer_targets.values())) if t in plan_nodes]
+        for nid, n in plan_nodes.items()
+    }
+
+    def reaches_itself(start: str) -> bool:
+        seen: set[str] = set()
+        stack = list(edges[start])
+        while stack:
+            node = stack.pop()
+            if node == start:
+                return True
+            if node not in seen:
+                seen.add(node)
+                stack.extend(edges[node])
+        return False
+
+    return {nid for nid in plan_nodes if reaches_itself(nid)}
+
+
+def _propagate_pure_ineligibility(
+    dependencies: Mapping[str, Iterable[str]],
+    reasons: dict[str, str],
+    *,
+    region_of: Optional[Mapping[str, Any]] = None,
+) -> dict[str, str]:
+    """Push ineligibility to pure dependents that share a multi-visit region with it.
+
+    An ineligible dependency in a *different* region keeps a full durable row, so
+    its dependents stay replayable and are not touched.
+    """
+    region_of = region_of or {}
+    changed = True
+    while changed:
+        changed = False
+        for node_id, deps in dependencies.items():
+            if node_id in reasons:
+                continue
+            for dep in deps:
+                if dep in reasons and region_of.get(dep) is not None and region_of.get(dep) == region_of.get(node_id):
+                    reasons[node_id] = reasons[dep]
+                    changed = True
+                    break
+    return reasons
+
+
+def _literal_error(path: str, expected: str) -> PureResultReplayIndexError:
+    return _invalid(f"literal at {path} does not match declared type {expected}", path=path, expected=expected)
+
+
+def _reject_unbound_text(doc: str, path: str) -> None:
+    if "${" in doc:
+        raise _invalid(f"unbound text at {path}", path=path)
+
+
+_PRIMITIVE_CHECKS = {
+    "String": lambda v: isinstance(v, str),
+    "Bool": lambda v: isinstance(v, bool),
+    "Int": lambda v: isinstance(v, int) and not isinstance(v, bool),
+    "Float": lambda v: isinstance(v, (int, float)) and not isinstance(v, bool),
+}
+
+
+def _check_primitive(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    name = descriptor.get("name")
+    check = _PRIMITIVE_CHECKS.get(name)
+    if check is not None and not check(doc):
+        raise _literal_error(path, str(name))
+    if name == "String":
+        _reject_unbound_text(doc, path)
+
+
+def _check_enum(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    if doc not in descriptor.get("allowed", ()):
+        raise _literal_error(path, "enum")
+
+
+def _check_path(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    if not isinstance(doc, str):
+        raise _literal_error(path, "path")
+    _reject_unbound_text(doc, path)
+
+
+def _check_optional(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    if doc is not None:
+        _check_literal(doc, descriptor["item"], path, refs)
+
+
+def _check_list(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    if not isinstance(doc, list):
+        raise _literal_error(path, "list")
+    for i, item in enumerate(doc):
+        _check_literal(item, descriptor["item"], f"{path}[{i}]", refs)
+
+
+def _check_map(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    if not isinstance(doc, Mapping):
+        raise _literal_error(path, "map")
+    for key, item in doc.items():
+        _check_literal(item, descriptor["value"], f"{path}.{key}", refs)
+
+
+def _check_record(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    fields = {f["name"]: f["type"] for f in descriptor["fields"]}
+    if not isinstance(doc, Mapping) or set(doc) != set(fields):
+        raise _literal_error(path, "record")
+    for name, ftype in fields.items():
+        _check_literal(doc[name], ftype, f"{path}.{name}", refs)
+
+
+def _check_literal(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    """Type-check literal leaves of a binding document; exact refs are collected."""
+    if isinstance(doc, Mapping) and "ref" in doc:
+        if set(doc) != {"ref"} or not isinstance(doc["ref"], str) or not doc["ref"]:
+            raise _invalid(f"malformed ref object at {path}", path=path)
+        refs.append((path, doc["ref"]))
+        return
+    checker = _LITERAL_CHECKERS.get(descriptor.get("kind"))
+    if checker is not None:
+        checker(doc, descriptor, path, refs)
+
+
+def _check_union_literal(doc: Any, descriptor: Mapping[str, Any], path: str, refs: list) -> None:
+    if not isinstance(doc, Mapping):
+        raise _literal_error(path, "union")
+    variants = {v["name"]: v["fields"] for v in descriptor.get("variants", ())}
+    if descriptor.get("kind") == "variant_case":
+        variants = {descriptor["variant"]: descriptor["fields"]}
+    variant = doc.get("variant")
+    if isinstance(variant, Mapping):  # ref-valued discriminant
+        _check_literal(variant, {"kind": "primitive", "name": "String"}, f"{path}.variant", refs)
+        active: dict[str, Any] = {}
+    elif variant in variants:
+        active = {f["name"]: f["type"] for f in variants[variant]}
+    else:
+        raise _literal_error(path, "union")
+    known = {**{f["name"]: f["type"] for fields in variants.values() for f in fields}, **active}
+    for name, value in doc.items():
+        if name == "variant":
+            continue
+        if name not in known:
+            raise _literal_error(path, "union")
+        _check_literal(value, known[name], f"{path}.{name}", refs)  # inactive members too
+    if any(name not in doc for name in active):
+        raise _literal_error(path, "union")
+
+
+_LITERAL_CHECKERS = {
+    "primitive": _check_primitive,
+    "enum": _check_enum,
+    "path": _check_path,
+    "optional": _check_optional,
+    "list": _check_list,
+    "map": _check_map,
+    "record": _check_record,
+    "union": _check_union_literal,
+    "variant_case": _check_union_literal,
+}
+
+
+def _scoped_prefix(node_key: str, levels: int) -> str:
+    """Presentation-key prefix of the scope ``levels`` above the node's own scope."""
+    prefix = node_key
+    for _ in range(levels):
+        prefix = prefix.rsplit(".", 1)[0] if "." in prefix else ""
+    return prefix
+
+
+def _address_from_rest(key: str, rest: str, ref: str, path: str) -> PureReplayAddress:
+    if rest.startswith("artifacts.") and len(rest) > len("artifacts."):
+        return PureReplayAddress("step_artifact", key, rest[len("artifacts."):])
+    if rest in _INTRINSICS:
+        return PureReplayAddress("step_intrinsic", key, rest)
+    raise _invalid(f"unsupported ref {ref!r}", path=path, ref=ref)
+
+
+def _parse_ref(ref: str, owners: Mapping[str, str], path: str, node_key: str) -> PureReplayAddress:
+    if ref.startswith("inputs."):
+        return PureReplayAddress("input", "", ref[len("inputs."):])
+    for scope_name, levels in (("root", None), ("self", 1), ("parent", 2)):
+        head = f"{scope_name}.steps."
+        if not ref.startswith(head):
+            continue
+        tail = ref[len(head):]
+        base = _scoped_prefix(node_key, levels) if levels else ""
+        for key in sorted(owners, key=len, reverse=True):
+            if levels and base and not key.startswith(base + "."):
+                continue
+            local = key[len(base) + 1:] if levels and base else key
+            if tail.startswith(local + "."):
+                return _address_from_rest(key, tail[len(local) + 1:], ref, path)
+    raise _invalid(f"ref {ref!r} does not resolve inside this workflow scope", path=path, ref=ref)
+
+
+def _structural_skip_owner(node: Any, plan_nodes: Mapping[str, Any]) -> Optional[str]:
+    scope = tuple(node.lexical_scope)
+    for other in plan_nodes.values():
+        if other.kind in _MARKER_KINDS and other.node_id != node.node_id:
+            other_scope = tuple(other.lexical_scope)
+            if len(other_scope) < len(scope) and scope[: len(other_scope)] == other_scope:
+                return other.node_id
+    return None
+
+
+def _check_identities(bundle: Any, plan_nodes: Mapping[str, Any]) -> None:
+    seen: dict[tuple[str, str], str] = {}
+    entries = bundle.projection.entries_by_node_id
+    for node in plan_nodes.values():
+        for label, value in (("step_id", node.step_id), ("presentation_key", node.presentation_key)):
+            if seen.setdefault((label, value), node.node_id) != node.node_id:
+                raise _invalid(f"duplicate projection authority for {label} {value!r}", node_id=node.node_id)
+        entry = entries.get(node.node_id)
+        if entry is not None and (
+            entry.step_id != node.step_id or entry.presentation_key != node.presentation_key
+        ):
+            raise _invalid("projection identity mismatch", node_id=node.node_id)
+
+
+def _node_from_config(node: Any, config: Mapping[str, Any], owners: Mapping[str, str], plan_nodes) -> PureReplayNode:
+    payload, binding_refs = config.get("payload"), config.get("binding_refs")
+    if not isinstance(payload, Mapping) or not isinstance(binding_refs, Mapping):
+        raise _invalid("pure projection config is malformed", node_id=node.node_id)
+    declared = payload.get("bindings") or {}
+    if set(declared) != set(binding_refs):
+        raise _invalid("binding refs do not match payload bindings", node_id=node.node_id)
+    bindings, pure_deps, durable_deps = [], [], []
+    for name, doc in binding_refs.items():
+        refs: list = []
+        _check_literal(_plain(doc), declared[name]["type"], name, refs)
+        for path, ref in refs:
+            address = _parse_ref(ref, owners, path, node.presentation_key)
+            bindings.append(PureReplayBinding(tuple(path.replace("[", ".").replace("]", "").split(".")), address))
+            if address.owner:
+                (pure_deps if plan_nodes[owners[address.owner]].kind == "pure_projection" else durable_deps).append(
+                    owners[address.owner]
+                )
+    contracts = _plain(config.get("output_contracts") or {})
+    return PureReplayNode(
+        node_id=node.node_id,
+        step_id=node.step_id,
+        presentation_key=node.presentation_key,
+        bindings=tuple(bindings),
+        output_addresses=tuple(PureReplayAddress("step_artifact", node.presentation_key, n) for n in contracts),
+        output_contracts=contracts,
+        pure_dependency_node_ids=tuple(dict.fromkeys(pure_deps)),
+        durable_dependency_node_ids=tuple(dict.fromkeys(durable_deps)),
+        structural_skip_owner=_structural_skip_owner(node, plan_nodes),
+    )
+
+
+def _demote_ineligible_deps(node: PureReplayNode, reasons: Mapping[str, str]) -> PureReplayNode:
+    """An ineligible pure input keeps a full durable row, so it is a durable dependency."""
+    moved = tuple(d for d in node.pure_dependency_node_ids if d in reasons)
+    if not moved:
+        return node
+    return replace(
+        node,
+        pure_dependency_node_ids=tuple(d for d in node.pure_dependency_node_ids if d not in reasons),
+        durable_dependency_node_ids=node.durable_dependency_node_ids + moved,
+    )
+
+
+def _topological(nodes: Mapping[str, PureReplayNode]) -> tuple[str, ...]:
+    order: list[str] = []
+    state: dict[str, int] = {}
+
+    def visit(node_id: str) -> None:
+        if state.get(node_id) == 2:
+            return
+        if state.get(node_id) == 1:
+            raise _invalid("pure dependency cycle", node_id=node_id)
+        state[node_id] = 1
+        for dep in nodes[node_id].pure_dependency_node_ids:
+            if dep in nodes:
+                visit(dep)
+        state[node_id] = 2
+        order.append(node_id)
+
+    for node_id in nodes:
+        visit(node_id)
+    return tuple(order)
+
+
+def _pure_config(bundle: Any, node_id: str) -> Mapping[str, Any]:
+    ir_node = bundle.ir.nodes.get(node_id)
+    config = getattr(getattr(ir_node, "execution_config", None), "pure_projection", None)
+    if config is None:
+        raise _invalid("pure projection node has no executable config", node_id=node_id)
+    return config
+
+
+def _static_ineligibility(bundle: Any, node_id: str, loop_owned: set, cyclic: set, generated: bool) -> Optional[str]:
+    if node_id in loop_owned or node_id in cyclic:
+        return MULTIPLE_VISIT_REGION
+    if not generated:
+        return "not_compiler_generated"
+    common = bundle.ir.nodes[node_id].execution_config.common
+    if getattr(common, "publishes", ()):
+        return "publishes_artifacts"  # published values need durable lineage
+    return None
+
+
+def derive_pure_result_replay_index(bundle: Any, *, scope_kind: str = ROOT_SCOPE) -> PureResultReplayIndex:
+    """Derive replay eligibility and dependencies for ``bundle``'s own nodes."""
+    if scope_kind != ROOT_SCOPE:
+        raise PureResultReplayIndexError(
+            DEPENDENCY_INDEX_INVALID,
+            f"scope_kind {scope_kind!r} does not match the bundle scope",
+            context={"expected_scope": scope_kind, "actual_scope": ROOT_SCOPE},
+        )
+    plan_nodes: Mapping[str, Any] = bundle.runtime_plan.nodes
+    _check_identities(bundle, plan_nodes)
+    owners = {n.presentation_key: n.node_id for n in plan_nodes.values()}
+    loop_owned = loop_owned_node_ids(plan_nodes)
+    cyclic = _cyclic_node_ids(plan_nodes)
+    generated = getattr(bundle.provenance, "frontend_kind", None) == "workflow_lisp"
+
+    reasons: dict[str, str] = {}
+    nodes: dict[str, PureReplayNode] = {}
+    for node_id, node in plan_nodes.items():
+        if node.kind != "pure_projection":
+            continue
+        reason = _static_ineligibility(bundle, node_id, loop_owned, cyclic, generated)
+        if reason is not None:
+            reasons[node_id] = reason
+        else:
+            nodes[node_id] = _node_from_config(node, _pure_config(bundle, node_id), owners, plan_nodes)
+    deps = {nid: n.pure_dependency_node_ids for nid, n in nodes.items()}
+    _propagate_pure_ineligibility(deps, reasons, region_of={})
+    nodes = {nid: _demote_ineligible_deps(n, reasons) for nid, n in nodes.items() if nid not in reasons}
+    return PureResultReplayIndex(
+        scope_kind=scope_kind,
+        nodes=nodes,
+        topological_node_ids=_topological(nodes),
+        ineligible_pure_reasons=reasons,
+        _owner_by_key={n.presentation_key: nid for nid, n in nodes.items()},
+    )

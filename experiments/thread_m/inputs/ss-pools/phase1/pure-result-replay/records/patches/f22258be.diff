new file mode 100644
index 0000000..be5b2e3
--- /dev/null
+++ b/tests/test_pure_result_replay_runtime.py
@@ -0,0 +1,212 @@
+from __future__ import annotations
+
+import copy
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayRuntime,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+)
+from orchestrator.workflow.pure_result_replay_index import PureReplayAddress, PureReplayBinding
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.pure_replay_helpers import FIXTURES, compile_bundle
+from tests.test_workflow_lisp_pure_projection_runtime import _compile_runtime_union_variant_bundle
+
+OWNER = "interrupt::orchestrate__first__step_one"
+
+
+@pytest.fixture
+def runtime(tmp_path: Path) -> PureReplayRuntime:
+    bundle = compile_bundle(FIXTURES / "interrupt.orc", tmp_path)
+    return PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("interrupt.orc"))
+
+
+@pytest.fixture
+def summary_id(runtime: PureReplayRuntime) -> str:
+    return next(nid for nid, n in runtime.index.nodes.items() if n.presentation_key.endswith("__summary"))
+
+
+def _state(runtime: PureReplayRuntime, node_id: str, **overrides) -> dict:
+    node = runtime.index.nodes[node_id]
+    state = {
+        "bound_inputs": {"report_path": "artifacts/work/report.txt"},
+        "step_visits": {OWNER: 1, node.presentation_key: 1},
+        "current_step": None,
+        "steps": {
+            OWNER: {"status": "completed", "exit_code": 0, "outcome": {"status": "completed", "phase": "execution",
+                    "class": "completed", "retryable": False}, "artifacts": {"count": 3, "report": "r"}},
+            node.presentation_key: build_pure_completion_shell(runtime.witness(node_id)),
+        },
+    }
+    state.update(overrides)
+    return state
+
+
+def _ok(node_id, overlay):
+    return {"status": "completed", "exit_code": 0, "artifacts": {"return__label": "positive", "return__next": 3}}
+
+
+def test_replay_builds_full_row_over_overlay_without_mutating_state(runtime, summary_id) -> None:
+    state = _state(runtime, summary_id)
+    before = copy.deepcopy(state)
+    row = runtime.replay_node(summary_id, state=state, evaluate_node=_ok)
+    assert row["artifacts"]["return__next"] == 3 and row["status"] == "completed"
+    assert state == before
+    overlay = runtime.overlay_active_state(state)
+    assert overlay["steps"][runtime.index.nodes[summary_id].presentation_key]["artifacts"]["return__next"] == 3
+    assert state == before
+
+
+@pytest.mark.parametrize(
+    "error,reason,cause",
+    [
+        ({"type": "materialize_ref_unresolved"}, "binding_unresolved", "materialize_ref_unresolved"),
+        ({"type": "pure_expr_operand_type_mismatch"}, "evaluation_failed", "pure_evaluation_failed"),
+        ({"type": "contract_violation", "context": {"reason": "pure_projection_contract_invalid"}},
+         "output_contract_invalid", "pure_projection_contract_invalid"),
+    ],
+)
+def test_rederivation_failures_map_to_declared_reasons(runtime, summary_id, error, reason, cause) -> None:
+    state = _state(runtime, summary_id)
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.replay_node(summary_id, state=state, evaluate_node=lambda *_: {"status": "failed", "error": error})
+    assert exc.value.reason == reason
+    assert exc.value.context["cause"] == {"type": cause}
+
+
+def test_replay_requires_derived_complete_progress(runtime, summary_id) -> None:
+    state = _state(runtime, summary_id, step_visits={OWNER: 1})
+    state["steps"].pop(runtime.index.nodes[summary_id].presentation_key)
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.replay_node(summary_id, state=state, evaluate_node=_ok)
+    assert exc.value.reason == "progress_witness_invalid"
+
+
+def _active_state(runtime, node_id, result, **overrides):
+    key = runtime.index.nodes[node_id].presentation_key
+    state = _state(runtime, node_id, **overrides)
+    state["steps"][key] = copy.deepcopy(result)
+    return state
+
+
+def _active_result(runtime, node_id):
+    shell = build_pure_completion_shell(runtime.witness(node_id))
+    return {**{k: v for k, v in shell.items() if k != "result_storage"},
+            "artifacts": {"return__label": "positive", "return__next": 3}}
+
+
+def test_active_result_cache_hit_is_valid_when_exactly_held(runtime, summary_id) -> None:
+    result = _active_result(runtime, summary_id)
+    runtime.record_full_result(summary_id, witness=runtime.witness(summary_id), result=result)
+    row = runtime.replay_node(summary_id, state=_active_state(runtime, summary_id, result), evaluate_node=_ok)
+    assert row == result
+
+
+@pytest.mark.parametrize(
+    "mutate",
+    [
+        lambda s, key: s.update(current_step={"name": key, "step_id": "x", "status": "running"}),
+        lambda s, key: s["step_visits"].update({key: 2}),
+        lambda s, key: s["step_visits"].pop(key),
+    ],
+)
+def test_active_result_cache_hit_revalidates_cursor_and_visit(runtime, summary_id, mutate) -> None:
+    result = _active_result(runtime, summary_id)
+    runtime.record_full_result(summary_id, witness=runtime.witness(summary_id), result=result)
+    key = runtime.index.nodes[summary_id].presentation_key
+    state = _active_state(runtime, summary_id, result)
+    mutate(state, key)
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.replay_node(summary_id, state=state, evaluate_node=_ok)
+    assert exc.value.reason == "progress_witness_invalid"
+
+
+def test_mismatched_active_row_is_rejected(runtime, summary_id) -> None:
+    result = _active_result(runtime, summary_id)
+    runtime.record_full_result(summary_id, witness=runtime.witness(summary_id), result=result)
+    tampered = {**result, "artifacts": {"return__label": "other", "return__next": 3}}
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.replay_node(summary_id, state=_active_state(runtime, summary_id, tampered), evaluate_node=_ok)
+    assert exc.value.reason == "progress_witness_invalid"
+
+
+def test_unrelated_cursor_does_not_invalidate_active_hit(runtime, summary_id) -> None:
+    result = _active_result(runtime, summary_id)
+    runtime.record_full_result(summary_id, witness=runtime.witness(summary_id), result=result)
+    state = _active_state(runtime, summary_id, result, current_step={"name": "other", "step_id": "o", "status": "running"})
+    assert runtime.replay_node(summary_id, state=state, evaluate_node=_ok) == result
+
+
+def test_durable_step_id_maps_to_node_and_unknown_ids_do_not(runtime, summary_id) -> None:
+    node = runtime.index.nodes[summary_id]
+    assert runtime.node_id_for_step_id(node.step_id) == summary_id
+    assert runtime.node_id_for_step_id("not-a-step") is None
+
+
+def _with_binding(runtime, node_id, address):
+    node = runtime.index.nodes[node_id]
+    runtime.index.nodes[node_id] = replace(node, bindings=(PureReplayBinding(("x",), address),))
+
+
+def test_bound_input_leaves_are_audited(runtime, summary_id) -> None:
+    _with_binding(runtime, summary_id, PureReplayAddress("input", "", "report_path"))
+    runtime.audit_boundary_leaves(None, state=_state(runtime, summary_id))
+    state = _state(runtime, summary_id)
+    state["bound_inputs"].pop("report_path")
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.audit_boundary_leaves(None, state=state)
+    assert exc.value.reason == "durable_input_missing"
+    state["bound_inputs"]["report_path"] = 7
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.audit_boundary_leaves(None, state=state)
+    assert exc.value.reason == "durable_input_invalid"
+
+
+@pytest.mark.parametrize(
+    "field,bad",
+    [("exit_code", "0"), ("outcome.status", 1), ("outcome.phase", None), ("outcome.class", 3), ("outcome.retryable", "no")],
+)
+def test_durable_intrinsics_are_type_checked(runtime, summary_id, field, bad) -> None:
+    _with_binding(runtime, summary_id, PureReplayAddress("step_intrinsic", OWNER, field))
+    state = _state(runtime, summary_id)
+    runtime.audit_boundary_leaves(None, state=state)
+    row = state["steps"][OWNER]
+    target = row["outcome"] if field.startswith("outcome.") else row
+    target[field.split(".")[-1]] = bad
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        runtime.audit_boundary_leaves(None, state=state)
+    assert exc.value.reason == "durable_input_invalid"
+
+
+def test_state_address_resolution_reads_the_overlay(runtime, summary_id) -> None:
+    state = _state(runtime, summary_id)
+    runtime.replay_node(summary_id, state=state, evaluate_node=_ok)
+    node = runtime.index.nodes[summary_id]
+    address = PureReplayAddress("step_artifact", node.presentation_key, "return__next")
+    assert runtime.resolve_state_address(address, state) == (True, 3)
+    assert runtime.value_for_state_address(address, state) == 3
+    missing = PureReplayAddress("step_artifact", node.presentation_key, "nope")
+    assert runtime.resolve_state_address(missing, state)[0] is False
+    with pytest.raises(PureResultReplayIndexError):
+        runtime.value_for_state_address(missing, state)
+
+
+def test_union_rows_hold_discriminant_and_active_variant_outputs_only(tmp_path: Path) -> None:
+    bundle = _compile_runtime_union_variant_bundle(tmp_path)
+    runtime = PureReplayRuntime(bundle=bundle, scope_path=ResumeScopePath.root("u.orc"))
+    (node_id,) = runtime.index.nodes
+    node = runtime.index.nodes[node_id]
+    assert len(node.output_addresses) == 3  # static catalog keeps every typed address
+    shell = {k: v for k, v in build_pure_completion_shell(runtime.witness(node_id)).items() if k != "result_storage"}
+    good = {**shell, "artifacts": {"return__variant": "BLOCKED", "return__blocked_reason": "r"}}
+    runtime.record_full_result(node_id, witness=runtime.witness(node_id), result=good)
+    extra = {**shell, "artifacts": {**good["artifacts"], "return__selected_item_selection_bundle": "state/x"}}
+    missing = {**shell, "artifacts": {"return__variant": "BLOCKED"}}
+    for bad in (extra, missing):
+        with pytest.raises(PureResultReplayIndexError) as exc:
+            runtime.record_full_result(node_id, witness=runtime.witness(node_id), result=bad)
+        assert exc.value.reason == "dependency_index_invalid"
diff --git a/tests/test_pure_result_replay_state_transactions.py b/tests/test_pure_result_replay_state_transactions.py
new file mode 100644
index 0000000..3020758
--- /dev/null
+++ b/tests/test_pure_result_replay_state_transactions.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager, StepResult
+from orchestrator.workflow.call_frame_state import _CallFrameStateManager
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayVisitWitness,
+    PureResultReplayIndexError,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+)
+from tests.pure_replay_helpers import FIXTURES, compile_bundle
+
+NAME, STEP_ID = "wf::pure", "root.pure"
+
+
+def _root(tmp_path: Path) -> StateManager:
+    (tmp_path / "wf.yaml").write_text("x: 1\n", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="r1")
+    manager.initialize("wf.yaml", result_persistence_profile="derived_pure_replay.v1")
+    return manager
+
+
+def _frame(tmp_path: Path) -> _CallFrameStateManager:
+    root = _root(tmp_path)
+    bundle = compile_bundle(FIXTURES / "chain.orc", tmp_path)
+    return _CallFrameStateManager(
+        parent_manager=root, workflow=bundle, frame_id="f1", call_step_name="call",
+        call_step_id="root.call", import_alias="child", bound_inputs={},
+    )
+
+
+def _persisted(manager) -> dict:
+    if isinstance(manager, StateManager):
+        return json.loads(manager.state_file.read_text(encoding="utf-8"))
+    return manager.parent_manager.state.call_frames["f1"]["state"]
+
+
+@pytest.fixture(params=["root", "frame"])
+def manager(request, tmp_path):
+    return _root(tmp_path) if request.param == "root" else _frame(tmp_path)
+
+
+def _witness(visit: int = 1) -> PureReplayVisitWitness:
+    return PureReplayVisitWitness(NAME, 4, STEP_ID, visit)
+
+
+def test_begin_publishes_visit_and_cursor_together(manager) -> None:
+    assert manager.begin_eligible_pure_visit(step_name=NAME, step_index=4, step_id=STEP_ID) == 1
+    assert classify_pure_replay_progress(_persisted(manager), witness=_witness()) == "interrupted"
+
+
+def test_second_begin_is_rejected_without_writing(manager) -> None:
+    manager.begin_eligible_pure_visit(step_name=NAME, step_index=4, step_id=STEP_ID)
+    before = _persisted(manager)
+    with pytest.raises(PureResultReplayIndexError):
+        manager.begin_eligible_pure_visit(step_name=NAME, step_index=4, step_id=STEP_ID)
+    assert _persisted(manager) == before
+
+
+def test_settle_success_persists_exact_shell_and_clears_cursor(manager) -> None:
+    manager.begin_eligible_pure_visit(step_name=NAME, step_index=4, step_id=STEP_ID)
+    shell = manager.settle_eligible_pure_success(_witness())
+    persisted = _persisted(manager)
+    assert shell == build_pure_completion_shell(_witness())
+    assert persisted["steps"][NAME] == shell
+    assert "current_step" not in persisted
+    assert classify_pure_replay_progress(persisted, witness=_witness()) == "derived_complete"
+
+
+def test_settle_failure_persists_full_row_and_clears_cursor(manager) -> None:
+    manager.begin_eligible_pure_visit(step_name=NAME, step_index=4, step_id=STEP_ID)
+    result = manager.settle_eligible_pure_failure(
+        _witness(), StepResult(status="failed", exit_code=2, error={"type": "boom"})
+    )
+    persisted = _persisted(manager)
+    assert result is None
+    assert persisted["steps"][NAME]["error"] == {"type": "boom"}
+    assert "current_step" not in persisted
+    assert classify_pure_replay_progress(persisted, witness=_witness()) == "durable_failure_skip"
+
+
+def test_settle_failure_rejects_completed_result(manager) -> None:
+    manager.begin_eligible_pure_visit(step_name=NAME, step_index=4, step_id=STEP_ID)
+    with pytest.raises(ValueError):
+        manager.settle_eligible_pure_failure(_witness(), StepResult(status="completed"))

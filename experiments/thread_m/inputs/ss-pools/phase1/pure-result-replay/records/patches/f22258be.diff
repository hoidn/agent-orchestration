+"""End-to-end behaviour of derived_pure_replay.v1 through the real CLI."""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from orchestrator.workflow.pure_result_replay import PureReplayRuntime
+from orchestrator.workflow.resume_projection_integrity import ResumeScopePath
+from tests.pure_replay_helpers import FIXTURES, REPO_ROOT, VALID, CliWorkspace, compile_bundle
+
+SUMMARY = "interrupt::orchestrate__summary"
+TERMINAL = "interrupt::orchestrate__terminal_projection"
+STEP_ONE = "interrupt::orchestrate__first__step_one"
+SHELL_KEYS = {"name", "step_id", "visit_count", "status", "exit_code", "outcome", "result_storage"}
+
+
+@pytest.fixture
+def completed(tmp_path: Path) -> CliWorkspace:
+    ws = CliWorkspace(tmp_path, "interrupt.orc")
+    result = ws.run()
+    assert result.returncode == 0, result.stderr
+    return ws
+
+
+@pytest.fixture
+def interrupted(tmp_path: Path) -> CliWorkspace:
+    ws = CliWorkspace(tmp_path, "interrupt.orc")
+    ws.run_until_step_two_blocks()
+    return ws
+
+
+def test_clean_profiled_run_leaves_pure_results_value_free(completed: CliWorkspace) -> None:
+    state = completed.state()
+    assert state["result_persistence_profile"] == "derived_pure_replay.v1"

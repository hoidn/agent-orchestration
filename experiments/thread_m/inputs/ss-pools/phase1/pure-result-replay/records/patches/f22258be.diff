+"""Provider-observation manager lifecycle: created when execution starts, closed once."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+import orchestrator.workflow.executor as executor_module
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.test_pure_result_replay_executor_forward import INPUTS, PROFILE, _manager
+from tests.test_workflow_lisp_pure_projection_runtime import _compile_pure_projection_bundle
+
+
+class _Manager:
+    created: list["_Manager"] = []
+
+    def __init__(self, run_root: Path) -> None:
+        self.run_root = run_root
+        self.close_calls = 0
+        self.created.append(self)
+
+    def close(self) -> None:
+        self.close_calls += 1
+
+
+@pytest.fixture(autouse=True)
+def _fake_manager(monkeypatch: pytest.MonkeyPatch):
+    _Manager.created = []
+    monkeypatch.setattr(executor_module, "ProviderObservationManager", _Manager)
+
+
+def _executor(tmp_path: Path, **kwargs):
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    manager = _manager(tmp_path, bundle, profile=PROFILE)
+    return WorkflowExecutor(bundle, tmp_path, manager, **kwargs), manager
+
+
+def test_construction_creates_no_manager(tmp_path: Path) -> None:
+    executor, _ = _executor(tmp_path, provider_observation_enabled=True)
+    assert _Manager.created == []
+    assert executor.provider_observation_manager is None
+
+
+def test_one_execute_creates_one_manager_and_closes_it_once(tmp_path: Path) -> None:
+    executor, _ = _executor(tmp_path, provider_observation_enabled=True)
+    executor.execute()
+    assert len(_Manager.created) == 1
+    assert _Manager.created[0].close_calls == 1
+    assert executor.provider_observation_manager is None
+
+
+def test_second_execute_creates_a_fresh_manager(tmp_path: Path) -> None:
+    executor, manager = _executor(tmp_path, provider_observation_enabled=True)
+    executor.execute()
+    manager.initialize(
+        manager.state.workflow_file,
+        context=manager.state.context,
+        bound_inputs=dict(INPUTS),
+        result_persistence_profile=PROFILE,
+    )
+    executor.execute()
+    assert len(_Manager.created) == 2
+    assert [m.close_calls for m in _Manager.created] == [1, 1]
+
+
+def test_disabled_observation_creates_no_manager(tmp_path: Path) -> None:
+    executor, _ = _executor(tmp_path, provider_observation_enabled=False)
+    executor.execute()
+    assert _Manager.created == []
+
+
+def test_injected_manager_is_neither_closed_nor_replaced(tmp_path: Path) -> None:
+    injected = _Manager(tmp_path)
+    _Manager.created.clear()
+    executor, _ = _executor(tmp_path, provider_observation_enabled=True, provider_observation_manager=injected)
+    executor.execute()
+    assert _Manager.created == []
+    assert injected.close_calls == 0
+    assert executor.provider_observation_manager is injected
+
+
+def test_profile_rejection_creates_no_observation_manager(tmp_path: Path) -> None:
+    executor, manager = _executor(tmp_path, provider_observation_enabled=True)
+    name = next(iter(executor.runtime_plan.nodes.values())).presentation_key
+    manager.state.steps[name] = {"status": "completed", "exit_code": 0, "artifacts": {"return__status": "WAIT"}}
+    manager._write_state()
+    result = executor.execute()
+    assert result["status"] == "failed"
+    assert result["error"]["type"] == "pure_result_replay_unavailable"
+    assert result["error"]["context"]["surface"] == "steps"
+    assert _Manager.created == []

+++ b/orchestrator/workflow/pure_result_replay_progress.py
@@ -0,0 +1,224 @@
+"""Completion shell, visit witness and progress classification for derived pure replay.
+
+Pure functions over a state mapping; the atomic state transactions that use them
+live on ``StateManager`` / the call-frame state manager.
+Reads: ``step_visits``, ``current_step`` and ``steps`` of one run state.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Mapping
+
+from .pure_result_replay_core import (
+    DERIVED_PURE_REPLAY_PROFILE,
+    PROGRESS_WITNESS_INVALID,
+    PureResultReplayIndexError,
+)
+
+UNSTARTED = "unstarted"
+INTERRUPTED = "interrupted"
+DERIVED_COMPLETE = "derived_complete"
+DURABLE_FAILURE_SKIP = "durable_failure_skip"
+PURE_PROJECTION_TYPE = "pure_projection"
+
+_SHELL_OUTCOME = {"status": "completed", "phase": "execution", "class": "completed", "retryable": False}
+_CURSOR_KEYS = {
+    "name", "index", "type", "step_id", "visit_count", "status", "started_at", "last_heartbeat_at",
+}
+
+
+@dataclass(frozen=True)
+class PureReplayVisitWitness:
+    """Identity of one single-visit pure execution."""
+
+    presentation_key: str
+    step_index: int
+    step_id: str
+    visit_count: int
+
+
+def build_pure_completion_shell(witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """The exact value-free completion row (built directly, never via StepResult)."""
+    return {
+        "name": witness.presentation_key,
+        "step_id": witness.step_id,
+        "visit_count": 1,
+        "status": "completed",
+        "exit_code": 0,
+        "outcome": dict(_SHELL_OUTCOME),
+        "result_storage": DERIVED_PURE_REPLAY_PROFILE,
+    }
+
+
+def validate_pure_completion_shell(row: Any, *, witness: PureReplayVisitWitness) -> None:
+    """Raise ValueError unless ``row`` is exactly the canonical shell for ``witness``."""
+    expected = build_pure_completion_shell(witness)
+    if not isinstance(row, Mapping):
+        raise ValueError("pure completion shell must be an object")
+    if set(row) != set(expected):
+        raise ValueError(
+            f"pure completion shell keys {sorted(row)} differ from {sorted(expected)}"
+        )
+    for key, value in expected.items():
+        observed = row[key]
+        if type(observed) is not type(value) or observed != value:
+            raise ValueError(f"pure completion shell field {key!r} is not {value!r}")
+    if set(row["outcome"]) != set(_SHELL_OUTCOME):
+        raise ValueError("pure completion shell outcome must be exact")
+
+
+def _invalid(message: str, witness: PureReplayVisitWitness, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(
+        PROGRESS_WITNESS_INVALID,
+        message,
+        context={"step_id": witness.step_id, "presentation_key": witness.presentation_key, **context},
+    )
+
+
+def _is_exact_shell(row: Any, witness: PureReplayVisitWitness) -> bool:
+    try:
+        validate_pure_completion_shell(row, witness=witness)
+    except ValueError:
+        return False
+    return True
+
+
+def _cursor_relates(cursor: Any, witness: PureReplayVisitWitness) -> bool:
+    return isinstance(cursor, Mapping) and (
+        cursor.get("name") == witness.presentation_key or cursor.get("step_id") == witness.step_id
+    )
+
+
+def _validate_cursor(cursor: Mapping[str, Any], witness: PureReplayVisitWitness) -> None:
+    expected = {
+        "name": witness.presentation_key,
+        "index": witness.step_index,
+        "type": PURE_PROJECTION_TYPE,
+        "step_id": witness.step_id,
+        "visit_count": witness.visit_count,
+        "status": "running",
+    }
+    if not _CURSOR_KEYS <= set(cursor) or any(cursor.get(k) != v for k, v in expected.items()):
+        raise _invalid("running cursor does not match the visit witness", witness)
+    if any(type(cursor[k]) is not type(v) for k, v in expected.items()):
+        raise _invalid("running cursor field types do not match the visit witness", witness)
+
+
+def _classify_row(row: Mapping[str, Any], witness: PureReplayVisitWitness, *, visitless: bool) -> str:
+    status = row.get("status")
+    if status == "completed":
+        raise _invalid("completed pure row is not the exact completion shell", witness)
+    if status not in {"failed", "skipped"}:
+        raise _invalid("pure row is not terminal", witness, status=status)
+    if row.get("name") not in (None, witness.presentation_key) or row.get("step_id") not in (None, witness.step_id):
+        raise _invalid("failure or skip row identity mismatch", witness)
+    if visitless:
+        if row.get("visit_count") not in (None, 0) or status != "skipped":
+            raise _invalid("visitless row must be a structural skip", witness)
+    elif row.get("visit_count") != witness.visit_count:
+        raise _invalid("failure or skip row visit mismatch", witness, observed=row.get("visit_count"))
+    return DURABLE_FAILURE_SKIP
+
+
+def _classify_without_cursor(
+    visit: Any, row: Any, witness: PureReplayVisitWitness, structural_skip_allowed: bool
+) -> str:
+    if visit is None:
+        if row is None:
+            return UNSTARTED
+        if structural_skip_allowed and isinstance(row, Mapping):
+            return _classify_row(row, witness, visitless=True)
+        raise _invalid("row without a visit", witness)
+    if visit != witness.visit_count or type(visit) is not int:
+        raise _invalid("visit count does not match the witness", witness, observed=visit)
+    if row is None:
+        raise _invalid("visit without cursor or row", witness)
+    if _is_exact_shell(row, witness):
+        return DERIVED_COMPLETE
+    if not isinstance(row, Mapping):
+        raise _invalid("row is not an object", witness)
+    return _classify_row(row, witness, visitless=False)
+
+
+def classify_pure_replay_progress(
+    state: Mapping[str, Any],
+    *,
+    witness: PureReplayVisitWitness,
+    structural_skip_allowed: bool = False,
+) -> str:
+    """Classify visit/cursor/row for ``witness`` or raise ``progress_witness_invalid``."""
+    visit = (state.get("step_visits") or {}).get(witness.presentation_key)
+    cursor = state.get("current_step")
+    row = (state.get("steps") or {}).get(witness.presentation_key)
+    if not _cursor_relates(cursor, witness):
+        return _classify_without_cursor(visit, row, witness, structural_skip_allowed)
+    _validate_cursor(cursor, witness)
+    if visit != witness.visit_count:
+        raise _invalid("cursor without matching visit", witness, observed=visit)
+    if row is not None:
+        raise _invalid("cursor and row coexist", witness)
+    return INTERRUPTED
+
+
+def apply_begin_visit(run_state: Any, *, step_name: str, step_index: int, step_id: str) -> int:
+    """Increment the visit and publish the running cursor on ``run_state`` (caller writes)."""
+    visit_count = run_state.step_visits.get(step_name, 0) + 1
+    witness = PureReplayVisitWitness(step_name, step_index, step_id, visit_count)
+    if visit_count != 1 or run_state.steps.get(step_name) is not None:
+        raise _invalid("eligible pure step is single-visit", witness, observed=visit_count)
+    now = datetime.now(timezone.utc).isoformat()
+    run_state.step_visits[step_name] = visit_count
+    run_state.current_step = {
+        "name": step_name,
+        "index": step_index,
+        "type": PURE_PROJECTION_TYPE,
+        "step_id": step_id,
+        "visit_count": visit_count,
+        "status": "running",
+        "started_at": now,
+        "last_heartbeat_at": now,
+    }
+    return visit_count
+
+
+def require_interrupted(run_state: Any, witness: PureReplayVisitWitness) -> int:
+    """Return the witness visit when the state is exactly interrupted, else raise ValueError."""
+    view = {
+        "step_visits": run_state.step_visits,
+        "current_step": run_state.current_step,
+        "steps": run_state.steps,
+    }
+    if classify_pure_replay_progress(view, witness=witness) != INTERRUPTED:
+        raise ValueError("eligible pure visit is not interrupted")
+    return witness.visit_count
+
+
+def apply_settle_success(run_state: Any, witness: PureReplayVisitWitness) -> dict[str, Any]:
+    """Settle an interrupted visit as the exact shell and clear its cursor."""
+    require_interrupted(run_state, witness)
+    shell = build_pure_completion_shell(witness)
+    run_state.steps[witness.presentation_key] = shell
+    run_state.current_step = None
+    return shell
+
+
+def apply_settle_failure(run_state: Any, witness: PureReplayVisitWitness, result: Any) -> None:
+    """Persist a full failed or skipped row for an interrupted visit and clear its cursor."""
+    require_interrupted(run_state, witness)
+    row = result.to_dict() if hasattr(result, "to_dict") else dict(result)
+    if row.get("status") not in {"failed", "skipped"}:
+        raise ValueError("eligible pure failure settlement requires a failed or skipped result")
+    for key, value in (
+        ("name", witness.presentation_key),
+        ("step_id", witness.step_id),
+        ("visit_count", witness.visit_count),
+    ):
+        if row.get(key) is None:
+            if hasattr(result, "to_dict"):
+                setattr(result, key, value)
+            else:
+                result[key] = value
+    run_state.steps[witness.presentation_key] = result
+    run_state.current_step = None

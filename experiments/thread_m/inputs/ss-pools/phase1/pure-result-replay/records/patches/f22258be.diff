@@ -0,0 +1,316 @@
+"""In-memory replay of eligible pure projections for one workflow scope.
+
+Dependencies: a loaded bundle (via the derived index) and the run-state mapping
+passed to each call. Replay never dispatches effects, increments visits, settles
+results or writes durable state; it only builds a transient overlay of full rows.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any, Callable, Mapping, Optional
+
+from .pure_result_replay_core import (
+    BINDING_UNRESOLVED,
+    DEPENDENCY_INDEX_INVALID,
+    DURABLE_INPUT_INVALID,
+    DURABLE_INPUT_MISSING,
+    EVALUATION_FAILED,
+    OUTPUT_CONTRACT_INVALID,
+    PROGRESS_WITNESS_INVALID,
+    PureResultReplayIndexError,
+)
+from .pure_result_replay_index import (
+    PureReplayAddress,
+    PureReplayNode,
+    PureResultReplayIndex,
+    derive_pure_result_replay_index,
+)
+from .pure_result_replay_progress import (
+    DERIVED_COMPLETE,
+    DURABLE_FAILURE_SKIP,
+    INTERRUPTED,
+    PureReplayVisitWitness,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+    validate_pure_completion_shell,
+)
+
+_CAUSE_BY_REASON = {
+    BINDING_UNRESOLVED: "materialize_ref_unresolved",
+    EVALUATION_FAILED: "pure_evaluation_failed",
+    OUTPUT_CONTRACT_INVALID: "pure_projection_contract_invalid",
+}
+_INTRINSIC_TYPES: dict[str, Callable[[Any], bool]] = {
+    "exit_code": lambda v: isinstance(v, int) and not isinstance(v, bool),
+    "outcome.status": lambda v: isinstance(v, str),
+    "outcome.phase": lambda v: isinstance(v, str),
+    "outcome.class": lambda v: isinstance(v, str),
+    "outcome.retryable": lambda v: isinstance(v, bool),
+}
+_INPUT_TYPES: dict[str, Callable[[Any], bool]] = {
+    "string": lambda v: isinstance(v, str),
+    "relpath": lambda v: isinstance(v, str),
+    "integer": lambda v: isinstance(v, int) and not isinstance(v, bool),
+    "float": lambda v: isinstance(v, (int, float)) and not isinstance(v, bool),
+    "bool": lambda v: isinstance(v, bool),
+    "list": lambda v: isinstance(v, list),
+    "map": lambda v: isinstance(v, dict),
+}
+
+
+def _error(reason: str, message: str, **context: Any) -> PureResultReplayIndexError:
+    return PureResultReplayIndexError(reason, message, context=context)
+
+
+def _failure_reason(row: Mapping[str, Any]) -> str:
+    error = row.get("error") if isinstance(row.get("error"), Mapping) else {}
+    if error.get("type") == "materialize_ref_unresolved":
+        return BINDING_UNRESOLVED
+    context = error.get("context") if isinstance(error.get("context"), Mapping) else {}
+    if context.get("reason") == "pure_projection_contract_invalid":
+        return OUTPUT_CONTRACT_INVALID
+    return EVALUATION_FAILED
+
+
+def _walk(value: Any, path: str) -> tuple[bool, Any]:
+    for part in filter(None, path.split(".")):
+        if not isinstance(value, Mapping) or part not in value:
+            return False, None
+        value = value[part]
+    return True, value
+
+
+class PureReplayRuntime:
+    """Per-scope replay runtime; ``scope_path`` is the existing ``ResumeScopePath``."""
+
+    def __init__(self, *, bundle: Any, scope_path: Any) -> None:
+        self.bundle = bundle
+        self.scope_path = scope_path
+        self.index: PureResultReplayIndex = derive_pure_result_replay_index(bundle)
+        self._node_id_by_step_id = {n.step_id: nid for nid, n in self.index.nodes.items()}
+        self._node_id_by_key = {n.presentation_key: nid for nid, n in self.index.nodes.items()}
+        # node id -> (witness, validated full result) held for the active executor
+        self._active: dict[str, tuple[PureReplayVisitWitness, dict[str, Any]]] = {}
+        self._overlay: dict[str, dict[str, Any]] = {}
+
+    # -- identity -----------------------------------------------------------
+    def is_eligible(self, node_id: str) -> bool:
+        return node_id in self.index.nodes
+
+    def node_id_for_step_id(self, step_id: str) -> Optional[str]:
+        return self._node_id_by_step_id.get(step_id)
+

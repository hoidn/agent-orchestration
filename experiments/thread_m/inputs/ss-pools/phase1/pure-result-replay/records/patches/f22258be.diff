+
+
+def _setup(tmp_path: Path):
+    (tmp_path / "wf.yaml").write_text("x: 1\n", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="r1")
+    manager.initialize("wf.yaml", result_persistence_profile="derived_pure_replay.v1")
+    manager.begin_eligible_pure_visit(step_name=NAME, step_index=2, step_id=STEP_ID)
+    emitted: list = []
+    recorder = OutcomeRecorder(
+        state_manager=manager,
+        step_id_resolver=lambda step: STEP_ID,
+        step_type_resolver=lambda step: "pure_projection",
+        summary_emitter=lambda name, step, row: emitted.append(row),
+    )
+    state = {"step_visits": {NAME: 1}, "steps": {}}
+    return manager, recorder, state, emitted
+
+
+def _durable(manager) -> dict:
+    return json.loads(manager.state_file.read_text(encoding="utf-8"))
+
+
+def test_success_persists_shell_but_keeps_full_result_in_memory(tmp_path: Path) -> None:
+    manager, recorder, state, emitted = _setup(tmp_path)
+    full = recorder.persist_step_result(
+        state, NAME, {}, {"status": "completed", "exit_code": 0, "artifacts": {"a": 1}},
+        eligible_pure_settlement=W,
+    )
+    shell = build_pure_completion_shell(W)
+    assert _durable(manager)["steps"][NAME] == shell
+    assert "current_step" not in _durable(manager)
+    assert full["artifacts"] == {"a": 1}
+    assert state["steps"][NAME]["artifacts"] == {"a": 1}
+    assert emitted == [shell]
+
+
+def test_failure_persists_full_row_and_clears_cursor(tmp_path: Path) -> None:
+    manager, recorder, state, emitted = _setup(tmp_path)
+    recorder.persist_step_result(
+        state, NAME, {}, {"status": "failed", "exit_code": 1, "error": {"type": "boom"}},
+        eligible_pure_settlement=W,
+    )
+    row = _durable(manager)["steps"][NAME]
+    assert row["status"] == "failed" and row["error"] == {"type": "boom"}
+    assert row["visit_count"] == 1 and row["step_id"] == STEP_ID
+    assert "current_step" not in _durable(manager)
+    assert emitted[0]["status"] == "failed"
+
+
+def test_historical_path_unchanged_without_witness(tmp_path: Path) -> None:
+    manager, recorder, state, _ = _setup(tmp_path)
+    recorder.persist_step_result(state, NAME, {}, {"status": "completed", "exit_code": 0, "artifacts": {"a": 1}})
+    assert _durable(manager)["steps"][NAME]["artifacts"] == {"a": 1}

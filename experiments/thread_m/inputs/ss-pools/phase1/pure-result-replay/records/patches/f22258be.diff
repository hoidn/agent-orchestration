+def test_cross_frame_ref_is_rejected(tmp_path: Path) -> None:
+    bundle = compile_bundle(FIXTURES / "chain.orc", tmp_path)
+    node = next(n for n in bundle.ir.nodes.values() if n.kind.value == "pure_projection")
+    config = dict(node.execution_config.pure_projection)
+    refs = _plain(config["binding_refs"])
+    refs["second"]["count"] = {"ref": "root.steps.other::wf__x.artifacts.count"}
+    config["binding_refs"] = refs
+    bad = _bundle_with_config(bundle, node.node_id, config)
+    with pytest.raises(PureResultReplayIndexError) as exc:
+        derive_pure_result_replay_index(bad)

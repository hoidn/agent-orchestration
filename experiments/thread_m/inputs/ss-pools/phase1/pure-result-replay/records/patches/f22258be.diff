+"""Forward execution of eligible pure steps under derived_pure_replay.v1 (in-process)."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.executor import WorkflowExecutor
+from orchestrator.workflow.pure_result_replay import (
+    PureReplayVisitWitness,
+    build_pure_completion_shell,
+    classify_pure_replay_progress,
+)
+from tests.test_workflow_lisp_pure_projection_runtime import (
+    PURE_EXPR_SELECTOR_PROJECTION,
+    _compile_pure_projection_bundle,
+)
+from tests.workflow_bundle_helpers import historical_workflow_lisp_bundle_context
+
+PROFILE = "derived_pure_replay.v1"
+INPUTS = {"approved": False, "status": "WAIT"}
+
+
+def _manager(tmp_path: Path, bundle, *, profile, cls=StateManager, run_id="forward") -> StateManager:
+    manager = cls(workspace=tmp_path, run_id=run_id)
+    manager.initialize(
+        str(PURE_EXPR_SELECTOR_PROJECTION),
+        context=historical_workflow_lisp_bundle_context(bundle),
+        bound_inputs=dict(INPUTS),
+        result_persistence_profile=profile,
+    )
+    return manager
+
+
+def _witness(bundle, manager) -> PureReplayVisitWitness:
+    node = bundle.runtime_plan.nodes[next(iter(bundle.runtime_plan.nodes))]
+    return PureReplayVisitWitness(node.presentation_key, node.execution_index, node.step_id, 1)
+
+
+def test_profiled_run_persists_only_the_shell_and_creates_no_bundle(tmp_path: Path) -> None:
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    manager = _manager(tmp_path, bundle, profile=PROFILE)
+    result = WorkflowExecutor(bundle, tmp_path, manager).execute()
+
+    witness = _witness(bundle, manager)
+    persisted = json.loads(manager.state_file.read_text(encoding="utf-8"))
+    assert persisted["steps"][witness.presentation_key] == build_pure_completion_shell(witness)
+    assert persisted["step_visits"][witness.presentation_key] == 1
+    assert "current_step" not in persisted
+    assert not list(tmp_path.rglob("*result_bundle*"))
+    assert result["workflow_outputs"] == {"return__status": "WAIT", "return__ready": False}
+
+
+def test_profiled_and_historical_runs_produce_identical_outputs(tmp_path: Path) -> None:
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    profiled = WorkflowExecutor(bundle, tmp_path, _manager(tmp_path, bundle, profile=PROFILE, run_id="a")).execute()
+    historical = WorkflowExecutor(bundle, tmp_path, _manager(tmp_path, bundle, profile=None, run_id="b")).execute()
+    assert profiled["workflow_outputs"] == historical["workflow_outputs"]
+    assert any(tmp_path.rglob("*result_bundle*"))  # only the historical run wrote a bundle
+
+
+class _CrashAfterBegin(StateManager):
+    def begin_eligible_pure_visit(self, **kwargs):
+        super().begin_eligible_pure_visit(**kwargs)
+        raise RuntimeError("crash after begin")
+
+
+def test_crash_after_begin_leaves_an_interrupted_visit_one_and_resume_completes(tmp_path: Path) -> None:
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    crashing = _manager(tmp_path, bundle, profile=PROFILE, cls=_CrashAfterBegin)
+    with pytest.raises(RuntimeError, match="crash after begin"):
+        WorkflowExecutor(bundle, tmp_path, crashing).execute()
+
+    witness = _witness(bundle, crashing)
+    reloaded = StateManager(workspace=tmp_path, run_id="forward")
+    persisted = reloaded.load().to_dict()
+    assert persisted["step_visits"][witness.presentation_key] == 1
+    assert classify_pure_replay_progress(persisted, witness=witness) == "interrupted"
+
+    resumed = WorkflowExecutor(bundle, tmp_path, reloaded).execute(resume=True)
+    assert resumed["status"] == "completed"
+    assert resumed["step_visits"][witness.presentation_key] == 1
+    assert resumed["steps"][witness.presentation_key] == build_pure_completion_shell(witness)
+
+
+def test_resume_determines_the_restart_boundary_exactly_once(tmp_path: Path) -> None:
+    from orchestrator.workflow.resume_planner import ResumePlanner
+
+    class CountingPlanner(ResumePlanner):
+        calls = 0
+
+        def determine_restart_node_id(self, *args, **kwargs):
+            type(self).calls += 1
+            return super().determine_restart_node_id(*args, **kwargs)
+
+    bundle = _compile_pure_projection_bundle(tmp_path)
+    crashing = _manager(tmp_path, bundle, profile=PROFILE, cls=_CrashAfterBegin)
+    with pytest.raises(RuntimeError):
+        WorkflowExecutor(bundle, tmp_path, crashing).execute()
+    executor = WorkflowExecutor(bundle, tmp_path, StateManager(workspace=tmp_path, run_id="forward"))
+    executor.resume_planner = CountingPlanner()
+
+    assert executor.execute(resume=True)["status"] == "completed"
+    assert CountingPlanner.calls == 1

+"""Default-resume selection with replay-eligible pure points filtered out."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from orchestrator.workflow_lisp.lexical_checkpoint_default_resume import determine_runtime_default_resume_decision
+
+WORKFLOW = "lisp_frontend_design_delta/drain::drain"
+DETAILS = {
+    "restore": {"eligibility": ["pure_binding"]},
+    "effect_boundary": {
+        "effect_kind": "command",
+        "policy": {"policy_kind": "reuse_validated_structured_output", "unsafe_pending_behavior": "fail_closed"},
+    },
+}
+
+
+def _point(name: str, *, kind: str = "effect_boundary"):
+    return SimpleNamespace(
+        checkpoint_id=f"ckpt:{name}", node_id=f"root.{name}", step_id=f"root.{name}",
+        point_kind=kind, workflow_name=WORKFLOW, details=DETAILS, origin_key=f"source:{name}",
+    )
+
+
+def _plan(*names: str):
+    points = tuple(_point(n) for n in names)
+    return SimpleNamespace(
+        workflow_name=WORKFLOW,
+        lexical_checkpoint_points=points,
+        ordered_node_ids=tuple(f"root.{n}" for n in names),
+        nodes={},
+        observability=SimpleNamespace(has_compiled_frontend_lineage=True),
+    )
+
+
+def _restore(kind: str, checkpoint_id: str | None = None, observation: str | None = None):
+    return SimpleNamespace(
+        kind=kind, checkpoint_id=checkpoint_id, record_id=f"record:{checkpoint_id}" if checkpoint_id else None,
+        source_map_origin_key="source", diagnostics=(), selection_observation=observation,
+        restore_payload=None, policy_decision=None, transition_resume=None,
+    )
+
+
+def _selector(prior: str | None, prior_kind: str = "RESTORED", own_observation: str = "record_absent"):
+    def select(**kwargs):
+        if kwargs.get("restart_node_id") is not None:
+            return _restore("NOT_RESTORABLE", None, own_observation)
+        assert kwargs["checkpoint_id"] == f"ckpt:{prior}"
+        return _restore(prior_kind, kwargs["checkpoint_id"])
+
+    return select
+
+
+def _decide(plan, restart: str, selector, **kwargs):
+    return determine_runtime_default_resume_decision(
+        state={"context": {"workflow_lisp": {"lowering_schema_version": 2}}},
+        runtime_plan=plan, restart_node_id=f"root.{restart}", restore_selector=selector,
+        is_workflow_lisp=True, **kwargs,
+    )
+
+
+ELIGIBLE = frozenset({"root.p"})
+
+
+def test_eligible_pure_point_is_filtered_before_nearest_selection() -> None:
+    decision = _decide(_plan("a", "p", "b"), "b", _selector("a"), eligible_pure_step_ids=ELIGIBLE)
+    assert decision["mode"] == "LEXICAL_CHECKPOINT_DEFAULT"
+    assert decision["checkpoint_id"] == "ckpt:a"
+    assert decision["selection_reason"] == "validated_prior_boundary"
+
+
+def test_unfiltered_historical_selection_keeps_the_pure_point() -> None:
+    decision = _decide(_plan("a", "p", "b"), "b", _selector("p"))
+    assert decision["checkpoint_id"] == "ckpt:p"
+
+
+def test_non_restorable_nearest_noneligible_point_fails_closed_without_scanning_past_it() -> None:
+    decision = _decide(
+        _plan("a", "p", "b"), "b", _selector("a", prior_kind="NOT_RESTORABLE"), eligible_pure_step_ids=ELIGIBLE
+    )
+    assert decision["mode"] == "FAIL_CLOSED"
+    assert decision["diagnostics"] == ["lexical_default_resume_prior_boundary_not_restorable"]
+
+
+def test_zero_record_frame_entry_replay_is_admitted_only_when_validated() -> None:
+    plan = _plan("p", "b")
+    admitted = _decide(plan, "b", _selector(None), eligible_pure_step_ids=ELIGIBLE, frame_entry_replay_validated=True)
+    assert admitted["mode"] == "LEXICAL_CHECKPOINT_DEFAULT"
+    assert admitted["restore_decision"] == "VALIDATED_FRAME_ENTRY_REPLAY"
+    assert admitted["checkpoint_id"] is None
+    assert admitted["selection_reason"] == "validated_frame_entry_replay"
+    rejected = _decide(plan, "b", _selector(None), eligible_pure_step_ids=ELIGIBLE, frame_entry_replay_validated=False)
+    assert rejected["mode"] == "FAIL_CLOSED"
+    assert rejected["diagnostics"] == ["lexical_default_resume_prior_boundary_not_restorable"]
+
+
+def test_present_but_unusable_record_is_not_a_zero_record_case() -> None:
+    decision = _decide(
+        _plan("p", "b"), "b", _selector(None, own_observation="record_present_unusable"),
+        eligible_pure_step_ids=ELIGIBLE, frame_entry_replay_validated=True,
+    )
+    assert decision["mode"] == "FAIL_CLOSED"
+    assert decision["restore_decision"] != "VALIDATED_FRAME_ENTRY_REPLAY"
+
+
+def test_historical_profile_without_prior_boundary_keeps_prior_boundary_missing() -> None:
+    decision = _decide(_plan("b"), "b", _selector(None))
+    assert decision["mode"] == "FAIL_CLOSED"
+    assert decision["diagnostics"] == ["lexical_default_resume_prior_boundary_missing"]

+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+from orchestrator.state import StateManager
+from orchestrator.workflow.call_frame_state import _CallFrameStateManager, load_existing_call_frame_read_only
+from orchestrator.workflow.executor import WorkflowExecutor
+from tests.pure_replay_helpers import FIXTURES, compile_bundle
+from tests.workflow_fixture_loader import WorkflowLoader
+
+PROFILE = "derived_pure_replay.v1"
+
+
+def _root(tmp_path: Path) -> StateManager:
+    (tmp_path / "wf.yaml").write_text("x: 1\n", encoding="utf-8")
+    manager = StateManager(tmp_path, run_id="r1")
+    manager.initialize("wf.yaml")
+    return manager
+
+
+def _parent(tmp_path: Path) -> StateManager:
+    if not (tmp_path / ".orchestrate").exists():
+        return _root(tmp_path)
+    manager = StateManager(tmp_path, run_id="r1")
+    manager.load()
+    return manager
+
+
+def _frame(tmp_path: Path, bundle, *, existing=None, profile=None, frame_id="f1") -> _CallFrameStateManager:
+    return _CallFrameStateManager(
+        parent_manager=_parent(tmp_path),
+        workflow=bundle, frame_id=frame_id, call_step_name="call", call_step_id="root.call",
+        import_alias="child", bound_inputs={}, existing_frame=existing, result_persistence_profile=profile,
+    )
+
+
+@pytest.fixture
+def lisp_bundle(tmp_path: Path):
+    (tmp_path / "lisp").mkdir()
+    return compile_bundle(FIXTURES / "chain.orc", tmp_path / "lisp")
+
+
+def test_fresh_frame_records_requested_profile(tmp_path: Path, lisp_bundle) -> None:
+    manager = _frame(tmp_path, lisp_bundle, profile=PROFILE)
+    assert manager.state.result_persistence_profile == PROFILE
+    assert manager.parent_manager.state.call_frames["f1"]["state"]["result_persistence_profile"] == PROFILE
+
+
+def test_existing_frame_is_never_backfilled(tmp_path: Path, lisp_bundle) -> None:
+    first = _frame(tmp_path, lisp_bundle)
+    snapshot = json.loads(json.dumps(first.parent_manager.state.call_frames["f1"]))
+    assert "result_persistence_profile" not in snapshot["state"]
+    again = _frame(tmp_path, lisp_bundle, existing=snapshot, profile=PROFILE)
+    assert again.state.result_persistence_profile is None
+
+
+def test_loader_returns_detached_copy_and_writes_nothing(tmp_path: Path) -> None:
+    frame = {"state": {"steps": {"a": {"status": "completed"}}}}
+    loaded = load_existing_call_frame_read_only(frame)
+    loaded["steps"]["a"]["status"] = "mutated"
+    assert frame["state"]["steps"]["a"]["status"] == "completed"
+    assert not (tmp_path / ".orchestrate").exists()
+
+
+@pytest.mark.parametrize("frame", [{}, {"state": None}, {"state": []}, {"state": "x"}])
+def test_malformed_existing_frame_is_rejected_before_any_write(tmp_path: Path, lisp_bundle, frame) -> None:
+    root = _root(tmp_path)
+    before = root.state_file.read_bytes()
+    with pytest.raises(ValueError, match="existing call-frame state"):
+        _CallFrameStateManager(
+            parent_manager=root, workflow=lisp_bundle, frame_id="f1", call_step_name="c",
+            call_step_id="root.c", import_alias="a", bound_inputs={}, existing_frame=frame,
+        )
+    assert root.state_file.read_bytes() == before
+    assert not (root.run_root / "call_frames").exists()
+
+
+@pytest.fixture
+def parent_executor(tmp_path: Path, lisp_bundle):
+    manager = _root(tmp_path)
+    return WorkflowExecutor(lisp_bundle, tmp_path, manager)
+
+
+def _select(executor, target, **kwargs):
+    step = executor._runtime_step_for_node_id(next(iter(executor.executable_ir.nodes)))
+    kwargs.setdefault("existing_frame", None)
+    kwargs.setdefault("runtime_step_id", None)
+    return executor.call_executor._fresh_frame_result_persistence_profile(step, target, **kwargs)
+
+
+def test_fresh_workflow_lisp_callee_selects_profile_from_its_provenance(parent_executor, lisp_bundle) -> None:
+    assert _select(parent_executor, lisp_bundle) == PROFILE
+
+
+def test_non_lisp_callee_keeps_historical_profile(parent_executor, tmp_path: Path) -> None:
+    path = tmp_path / "child.fixture.json"
+    path.write_text(json.dumps({"version": "2.7", "name": "c", "steps": [
+        {"name": "S", "id": "s", "command": [sys.executable, "-c", "pass"]}]}), encoding="utf-8")
+    child = WorkflowLoader(tmp_path).load_bundle(path)
+    assert _select(parent_executor, child) is None
+
+
+def test_existing_and_iteration_owned_frames_keep_historical_profile(parent_executor, lisp_bundle) -> None:
+    assert _select(parent_executor, lisp_bundle, existing_frame={"state": {}}) is None
+    assert _select(parent_executor, lisp_bundle, runtime_step_id="loop.0.call") is None

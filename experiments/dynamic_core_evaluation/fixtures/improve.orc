; DC-2b ordinary helper fragment; the experiment driver assembles its caller.
(define (improve initial review revise limit)
  (if (<= limit 0)
      (fail "invalid_limit")
      (improve-loop initial review revise limit 0)))

(define (improve-loop current review revise limit iteration)
  (if (= iteration limit)
      (record (variant "EXHAUSTED") (value current))
      (let* ((decision (review current))
             (tag (field decision "variant")))
        (if (= tag "APPROVE")
            (record (variant "APPROVED")
                    (value current)
                    (evidence (field decision "evidence")))
            (if (= tag "BLOCKED")
                (record (variant "BLOCKED")
                        (value current)
                        (reason (field decision "reason")))
                (if (= tag "REVISE")
                    (improve-loop (revise current (field decision "feedback"))
                                  review revise limit (+ iteration 1))
                    (fail "unknown_review_decision")))))))

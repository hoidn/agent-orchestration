+    from orchestrator.workflow_lisp.diagnostics import LispFrontendCompileError, LispFrontendDiagnostic
+    from orchestrator.workflow_lisp.spans import SourcePosition, SourceSpan
+
+    found = find_parallel_agent(tree)
+    if found is None:
+        return

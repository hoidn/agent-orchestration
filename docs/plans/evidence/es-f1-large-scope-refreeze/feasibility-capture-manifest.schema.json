{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestration.invalid/schemas/es-f1-feasibility-capture-manifest-v1.json",
  "title": "ES F1 authenticated feasibility capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "captured_at",
    "lifecycle",
    "bindings",
    "disposable_roots",
    "tree_algebra",
    "ledgers",
    "directed_ast_edges",
    "volatile_fields",
    "deterministic_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "es_f1_feasibility_capture_manifest.v1"},
    "capture_id": {"type": "string", "pattern": "^capture-[0-9a-f]{32}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "lifecycle": {"const": "retained_pending_ordered_reviews"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "disposable_roots": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "source_tree"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "source_tree"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "source_tree"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "source_tree"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "source_tree"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "source_tree"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/disposable_root"},
            {"properties": {"root_kind": {"const": "git_object_store"}}}
          ]
        }
      ],
      "items": false
    },
    "tree_algebra": {"$ref": "#/$defs/tree_algebra"},
    "ledgers": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {"$ref": "#/$defs/collection_ledger"},
        {"$ref": "#/$defs/baseline_ledger_0"},
        {"$ref": "#/$defs/baseline_ledger_1"},
        {"$ref": "#/$defs/baseline_ledger_2"},
        {"$ref": "#/$defs/baseline_ledger_3"},
        {"$ref": "#/$defs/green_ledger_0"},
        {"$ref": "#/$defs/green_ledger_1"},
        {"$ref": "#/$defs/remove_one_ledger_0"},
        {"$ref": "#/$defs/remove_one_ledger_1"},
        {"$ref": "#/$defs/remove_one_ledger_2"},
        {"$ref": "#/$defs/remove_one_ledger_3"},
        {"$ref": "#/$defs/adjacent_ledger"}
      ],
      "items": false
    },
    "directed_ast_edges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/edge_binding"}
    },
    "volatile_fields": {
      "const": [
        "captured_at",
        "ledgers.*.elapsed_ns",
        "ledgers.*.sha256"
      ]
    },
    "deterministic_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)"},
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "literal_path",
        "real_path",
        "sha256",
        "version_argv",
        "version_output"
      ],
      "properties": {
        "literal_path": {"$ref": "#/$defs/absolute_path"},
        "real_path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "version_output": {"type": "string", "minLength": 1}
      }
    },
    "frozen_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "inventory_sha256",
        "leaf_count"
      ],
      "properties": {
        "repository": {"$ref": "#/$defs/absolute_path"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "leaf_count": {"type": "integer", "minimum": 1}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_path",
        "runner_sha256",
        "git",
        "python",
        "execution_wrapper",
        "frozen_base",
        "object_store"
      ],
      "properties": {
        "runner_path": {"const": "scripts/experiments/es/feasibility_proofs.py"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "git": {"$ref": "#/$defs/executable"},
        "python": {"$ref": "#/$defs/executable"},
        "execution_wrapper": {"$ref": "#/$defs/executable"},
        "frozen_base": {"$ref": "#/$defs/frozen_base"},
        "object_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_path", "snapshot_sha256"],
          "properties": {
            "canonical_path": {"$ref": "#/$defs/absolute_path"},
            "snapshot_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "source_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "root_kind",
        "canonical_path",
        "variant_id",
        "pre_purge_lstat",
        "tree_oid"
      ],
      "properties": {
        "root_id": {"type": "string", "pattern": "^root-[0-9a-f]{32}$"},
        "root_kind": {"const": "source_tree"},
        "canonical_path": {"$ref": "#/$defs/absolute_path"},
        "variant_id": {"type": "string", "minLength": 1},
        "pre_purge_lstat": {"const": "directory"},
        "tree_oid": {"$ref": "#/$defs/sha1"}
      }
    },
    "object_store_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "root_kind",
        "canonical_path",
        "pre_purge_lstat",
        "snapshot_sha256"
      ],
      "properties": {
        "root_id": {"type": "string", "pattern": "^root-[0-9a-f]{32}$"},
        "root_kind": {"const": "git_object_store"},
        "canonical_path": {"$ref": "#/$defs/absolute_path"},
        "pre_purge_lstat": {"const": "directory"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "disposable_root": {
      "oneOf": [
        {"$ref": "#/$defs/source_root"},
        {"$ref": "#/$defs/object_store_root"}
      ]
    },
    "overlay_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_id", "ordinal", "path", "mode", "blob_oid"],
      "properties": {
        "slice_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "path": {"$ref": "#/$defs/relative_path"},
        "mode": {"const": "100644"},
        "blob_oid": {"$ref": "#/$defs/sha1"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "tree_oid", "leaf_count", "included_slice_ids"],
      "properties": {
        "variant_id": {"type": "string", "minLength": 1},
        "tree_oid": {"$ref": "#/$defs/sha1"},
        "leaf_count": {"type": "integer", "minimum": 1},
        "included_slice_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "numstat_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "additions", "deletions", "physical_line_count"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "additions": {"type": "integer", "minimum": 1},
        "deletions": {"const": 0},
        "physical_line_count": {"type": "integer", "minimum": 1}
      }
    },
    "cluster_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "ordinal",
        "primary_production_paths",
        "responsibility_ids",
        "baseline_ledger_id",
        "remove_one_ledger_id"
      ],
      "properties": {
        "cluster_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4},
        "primary_production_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relative_path"},
          "uniqueItems": true
        },
        "responsibility_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "baseline_ledger_id": {"type": "string", "minLength": 1},
        "remove_one_ledger_id": {"type": "string", "minLength": 1}
      }
    },
    "tree_algebra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay", "variants", "numstat", "cluster_contracts"],
      "properties": {
        "overlay": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/overlay_row"}
        },
        "variants": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/variant"}
        },
        "numstat": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/numstat_row"}
        },
        "cluster_contracts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/cluster_contract"}
        }
      }
    },
    "writable_mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "host_path", "pre_tree", "post_tree"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "host_path": {"$ref": "#/$defs/absolute_path"},
        "pre_tree": {"$ref": "#/$defs/sha1"},
        "post_tree": {"$ref": "#/$defs/sha1"}
      }
    },
    "direct_execution_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "launcher",
        "launcher_argv",
        "runtime_project_root",
        "home_root",
        "tmp_root",
        "writable_mounts"
      ],
      "properties": {
        "kind": {"const": "direct"},
        "launcher": {"type": "null"},
        "launcher_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "runtime_project_root": {"$ref": "#/$defs/absolute_path"},
        "home_root": {"type": "null"},
        "tmp_root": {"type": "null"},
        "writable_mounts": {"type": "array", "maxItems": 0}
      }
    },
    "bwrap_execution_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "launcher",
        "launcher_argv",
        "runtime_project_root",
        "home_root",
        "tmp_root",
        "writable_mounts"
      ],
      "properties": {
        "kind": {"const": "bwrap_ro_project.v1"},
        "launcher": {"$ref": "#/$defs/executable"},
        "launcher_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "runtime_project_root": {"const": "/run/orc-pytest-project"},
        "home_root": {"$ref": "#/$defs/absolute_path"},
        "tmp_root": {"$ref": "#/$defs/absolute_path"},
        "writable_mounts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/writable_mount"}
        }
      }
    },
    "adjacent_execution_envelope": {
      "allOf": [
        {"$ref": "#/$defs/bwrap_execution_envelope"},
        {
          "properties": {
            "writable_mounts": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "allOf": [
                    {"$ref": "#/$defs/writable_mount"},
                    {"properties": {"relative_path": {"const": "memoized_data"}}}
                  ]
                },
                {
                  "allOf": [
                    {"$ref": "#/$defs/writable_mount"},
                    {"properties": {"relative_path": {"const": "training_outputs"}}}
                  ]
                }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "execution_envelope": {
      "oneOf": [
        {"$ref": "#/$defs/direct_execution_envelope"},
        {"$ref": "#/$defs/bwrap_execution_envelope"}
      ]
    },
    "project_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_name", "resolved_path"],
      "properties": {
        "module_name": {"type": "string", "minLength": 1},
        "resolved_path": {"$ref": "#/$defs/absolute_path"}
      }
    },
    "call_trace_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "pytest_node_id",
        "caller_path",
        "caller_line",
        "callee_path",
        "callee_name",
        "callee_first_line"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "pytest_node_id": {"type": "string", "minLength": 1},
        "caller_path": {"$ref": "#/$defs/relative_path"},
        "caller_line": {"type": "integer", "minimum": 1},
        "callee_path": {"$ref": "#/$defs/relative_path"},
        "callee_name": {"type": "string", "minLength": 1},
        "callee_first_line": {"type": "integer", "minimum": 1}
      }
    },
    "ledger_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "runner_path",
        "runner_sha256",
        "git",
        "python",
        "variant_id",
        "project_root",
        "expected_tree",
        "argv",
        "execution_envelope",
        "expected_project_origins",
        "call_trace_specs"
      ],
      "properties": {
        "slice_id": {"type": ["string", "null"], "minLength": 1},
        "runner_path": {"$ref": "#/$defs/absolute_path"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "git": {"$ref": "#/$defs/executable"},
        "python": {"$ref": "#/$defs/executable"},
        "variant_id": {"type": "string", "minLength": 1},
        "project_root": {"$ref": "#/$defs/absolute_path"},
        "expected_tree": {"$ref": "#/$defs/sha1"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "execution_envelope": {"$ref": "#/$defs/execution_envelope"},
        "expected_project_origins": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/project_origin"}
        },
        "call_trace_specs": {
          "type": "array",
          "items": {"$ref": "#/$defs/call_trace_spec"}
        }
      }
    },
    "adjacent_ledger_authority": {
      "allOf": [
        {"$ref": "#/$defs/ledger_authority"},
        {
          "properties": {
            "execution_envelope": {"$ref": "#/$defs/adjacent_execution_envelope"}
          }
        }
      ]
    },
    "ledger_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_id",
        "ordinal",
        "role",
        "role_index",
        "path",
        "sha256",
        "deterministic_sha256",
        "elapsed_ns",
        "authority"
      ],
      "properties": {
        "ledger_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 11},
        "role": {"enum": ["collection", "baseline", "green", "remove_one", "adjacent"]},
        "role_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "deterministic_sha256": {"$ref": "#/$defs/sha256"},
        "elapsed_ns": {"type": "integer", "minimum": 1},
        "authority": {"$ref": "#/$defs/ledger_authority"}
      }
    },
    "collection_ledger": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 0}, "role": {"const": "collection"}, "role_index": {"const": 0}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/00-collection.json"}}}
      ]
    },
    "baseline_ledger_0": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 1}, "role": {"const": "baseline"}, "role_index": {"const": 0}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/01-baseline-identity-config.json"}}}
      ]
    },
    "baseline_ledger_1": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 2}, "role": {"const": "baseline"}, "role_index": {"const": 1}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/02-baseline-construction-adapters.json"}}}
      ]
    },
    "baseline_ledger_2": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 3}, "role": {"const": "baseline"}, "role_index": {"const": 2}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/03-baseline-persistence-rebuild.json"}}}
      ]
    },
    "baseline_ledger_3": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 4}, "role": {"const": "baseline"}, "role_index": {"const": 3}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/04-baseline-inference-workflows.json"}}}
      ]
    },
    "green_ledger_0": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 5}, "role": {"const": "green"}, "role_index": {"const": 0}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/05-green-first.json"}}}
      ]
    },
    "green_ledger_1": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 6}, "role": {"const": "green"}, "role_index": {"const": 1}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/06-green-second.json"}}}
      ]
    },
    "remove_one_ledger_0": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 7}, "role": {"const": "remove_one"}, "role_index": {"const": 0}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/07-remove-one-identity-config.json"}}}
      ]
    },
    "remove_one_ledger_1": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 8}, "role": {"const": "remove_one"}, "role_index": {"const": 1}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/08-remove-one-construction-adapters.json"}}}
      ]
    },
    "remove_one_ledger_2": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 9}, "role": {"const": "remove_one"}, "role_index": {"const": 2}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/09-remove-one-persistence-rebuild.json"}}}
      ]
    },
    "remove_one_ledger_3": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 10}, "role": {"const": "remove_one"}, "role_index": {"const": 3}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/10-remove-one-inference-workflows.json"}}}
      ]
    },
    "adjacent_ledger": {
      "allOf": [
        {"$ref": "#/$defs/ledger_binding"},
        {"properties": {"ordinal": {"const": 11}, "role": {"const": "adjacent"}, "role_index": {"const": 0}, "path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture/ledgers/11-adjacent.json"}, "authority": {"$ref": "#/$defs/adjacent_ledger_authority"}}}
      ]
    },
    "ast_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 0},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 0}
      }
    },
    "ast_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob_oid", "node_type", "name", "span"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "blob_oid": {"$ref": "#/$defs/sha1"},
        "node_type": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "span": {"$ref": "#/$defs/ast_span"}
      }
    },
    "edge_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from_cluster",
        "to_cluster",
        "producer",
        "consumer",
        "pytest_node_id",
        "ledger_id"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from_cluster": {"type": "string", "minLength": 1},
        "to_cluster": {"type": "string", "minLength": 1},
        "producer": {"$ref": "#/$defs/ast_node"},
        "consumer": {"$ref": "#/$defs/ast_node"},
        "pytest_node_id": {"type": "string", "minLength": 1},
        "ledger_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

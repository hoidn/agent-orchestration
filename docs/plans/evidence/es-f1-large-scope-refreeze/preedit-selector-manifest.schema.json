        "pre_tree": {"$ref": "#/$defs/sha1"},
        "post_tree": {"$ref": "#/$defs/sha1"},
        "aggregate_pytest_argv": {"type": "array", "minItems": 24, "items": {"type": "string"}},
        "collected_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "collected_node_sha256": {"$ref": "#/$defs/sha256"},
        "collection_total": {"type": "integer", "minimum": 1},
        "outcomes": {"$ref": "#/$defs/outcomes"},
        "origin_isolation": {"$ref": "#/$defs/origin_isolation"},
        "selector_results": {"type": "array", "minItems": 19, "maxItems": 19, "items": {"$ref": "#/$defs/selector_result"}},
        "controller_selector_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controller_selector_result"}},
        "witness_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/witness_result"}}
      }
    },
    "cluster_id": {"enum": ["IDENTITY_CONFIG", "CONSTRUCTION_ADAPTERS", "TRAINING_OPTIMIZER", "PERSISTENCE_REBUILD", "INFERENCE_WORKFLOWS", "CONSUMER_BYPASS"]},
    "unmet_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "baseline_ledger_id", "remove_one_ledger_id", "primary_production_paths", "changed_production_paths", "responsibility_ids"],
      "properties": {
        "cluster_id": {"$ref": "#/$defs/cluster_id"},
        "baseline_ledger_id": {"type": "string", "minLength": 1},
        "remove_one_ledger_id": {"type": "string", "minLength": 1},
        "primary_production_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "changed_production_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "responsibility_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "integration_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_cluster", "to_cluster", "producer_blob_oid", "consumer_blob_oid", "ledger_id", "pytest_node_id"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from_cluster": {"$ref": "#/$defs/cluster_id"},
        "to_cluster": {"$ref": "#/$defs/cluster_id"},
        "producer_blob_oid": {"$ref": "#/$defs/sha1"},
        "consumer_blob_oid": {"$ref": "#/$defs/sha1"},
        "ledger_id": {"type": "string", "minLength": 1},
        "pytest_node_id": {"type": "string", "minLength": 1}
      }
    },
    "spike_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_additions", "implementation_deletions", "physical_line_count", "changed_production_paths"],
      "properties": {
        "implementation_additions": {"type": "integer", "minimum": 1},
        "implementation_deletions": {"type": "integer", "minimum": 0},
        "physical_line_count": {"type": "integer", "minimum": 1},
        "changed_production_paths": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "feasibility_spike": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capture_manifest_path", "capture_manifest_sha256", "capture_deterministic_sha256", "capture_lifecycle", "source_tree_before", "source_tree_after", "cluster_domain", "unmet_clusters", "integration_edges", "delta", "non_collapse"],
      "properties": {
        "schema_version": {"const": "es_f1_structural_multi_context_feasibility.v1"},
        "capture_manifest_path": {"const": "docs/plans/evidence/es-f1-large-scope-refreeze/feasibility-capture-manifest.json"},
        "capture_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "capture_deterministic_sha256": {"$ref": "#/$defs/sha256"},
        "capture_lifecycle": {"const": "retained_pending_ordered_reviews"},
        "source_tree_before": {"$ref": "#/$defs/sha1"},
        "source_tree_after": {"$ref": "#/$defs/sha1"},
        "cluster_domain": {"const": ["IDENTITY_CONFIG", "CONSTRUCTION_ADAPTERS", "TRAINING_OPTIMIZER", "PERSISTENCE_REBUILD", "INFERENCE_WORKFLOWS", "CONSUMER_BYPASS"]},
        "unmet_clusters": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/unmet_cluster"}},
        "integration_edges": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/integration_edge"}},
        "delta": {"$ref": "#/$defs/spike_delta"},
        "non_collapse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distinct_production_blob_count", "distinct_cluster_path_sets"],
          "properties": {
            "distinct_production_blob_count": {"type": "integer", "minimum": 4},
            "distinct_cluster_path_sets": {"type": "integer", "minimum": 4}
          }
        }
      }
    },
    "json_value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/json_value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}
      ]
    }
  }
}

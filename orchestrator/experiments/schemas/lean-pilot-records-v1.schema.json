{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestration.invalid/schemas/lean-pilot-records-v1.schema.json",
  "$defs": {
    "pilot_lock.v1": {
      "$defs": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nonempty_string": {
          "type": "string",
          "minLength": 1
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "treatment_id": {
              "enum": [
                "DIRECT",
                "COORDINATOR",
                "ORC"
              ]
            },
            "source_digest": {
              "$ref": "#/$defs/digest"
            },
            "command_digest": {
              "$ref": "#/$defs/digest"
            },
            "provider_call_bounds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minimum": {
                  "type": "integer"
                },
                "maximum": {
                  "type": "integer"
                }
              },
              "required": [
                "minimum",
                "maximum"
              ]
            }
          },
          "required": [
            "treatment_id",
            "source_digest",
            "command_digest",
            "provider_call_bounds"
          ],
          "oneOf": [
            {
              "properties": {
                "treatment_id": {
                  "const": "DIRECT"
                },
                "provider_call_bounds": {
                  "properties": {
                    "minimum": {
                      "const": 1
                    },
                    "maximum": {
                      "const": 1
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "treatment_id": {
                  "const": "COORDINATOR"
                },
                "provider_call_bounds": {
                  "properties": {
                    "minimum": {
                      "const": 5
                    },
                    "maximum": {
                      "const": 9
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "treatment_id": {
                  "const": "ORC"
                },
                "provider_call_bounds": {
                  "properties": {
                    "minimum": {
                      "const": 5
                    },
                    "maximum": {
                      "const": 9
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "const": "pilot_lock.v1"
        },
        "pilot_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "profile_digest": {
              "$ref": "#/$defs/digest"
            },
            "brief_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "task_id",
            "profile_digest",
            "brief_digest"
          ]
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository_identity": {
              "$ref": "#/$defs/nonempty_string"
            },
            "revision_identity": {
              "$ref": "#/$defs/nonempty_string"
            },
            "archive_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "repository_identity",
            "revision_identity",
            "archive_digest"
          ]
        },
        "provider_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "$ref": "#/$defs/nonempty_string"
            },
            "model": {
              "$ref": "#/$defs/nonempty_string"
            },
            "reasoning_effort": {
              "$ref": "#/$defs/nonempty_string"
            },
            "tool_policy": {
              "$ref": "#/$defs/nonempty_string"
            },
            "timeout_milliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "family",
            "model",
            "reasoning_effort",
            "tool_policy",
            "timeout_milliseconds",
            "currency"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer_ids": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonempty_string"
              }
            },
            "rubric_digest": {
              "$ref": "#/$defs/digest"
            },
            "calibration_evidence_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "reviewer_ids",
            "rubric_digest",
            "calibration_evidence_digest"
          ]
        },
        "randomization_seed": {
          "$ref": "#/$defs/nonempty_string"
        },
        "evidence_root": {
          "$ref": "#/$defs/nonempty_string"
        },
        "valid_block_count": {
          "const": 3
        },
        "max_live_attempt_count": {
          "const": 5
        },
        "fixture_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "live_attempt_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "claim_level": {
          "const": "exploratory_controlled_task"
        },
        "treatments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/treatment"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "treatment_id": {
                    "const": "DIRECT"
                  }
                },
                "required": [
                  "treatment_id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "treatment_id": {
                    "const": "COORDINATOR"
                  }
                },
                "required": [
                  "treatment_id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "treatment_id": {
                    "const": "ORC"
                  }
                },
                "required": [
                  "treatment_id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      },
      "required": [
        "record_kind",
        "pilot_id",
        "task",
        "archive",
        "provider_policy",
        "review",
        "randomization_seed",
        "evidence_root",
        "valid_block_count",
        "max_live_attempt_count",
        "fixture_id",
        "smoke_id",
        "live_attempt_ids",
        "claim_level",
        "treatments"
      ]
    },
    "block_attempt.v1": {
      "$defs": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nonempty_string": {
          "type": "string",
          "minLength": 1
        },
        "treatment_execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opaque_arm_label": {
              "$ref": "#/$defs/nonempty_string"
            },
            "treatment_id": {
              "enum": [
                "DIRECT",
                "COORDINATOR",
                "ORC"
              ]
            },
            "command_digest": {
              "$ref": "#/$defs/digest"
            },
            "lifecycle_outcome": {
              "$ref": "#/$defs/nonempty_string"
            },
            "product_frozen": {
              "type": "boolean"
            },
            "product_manifest_digest": {
              "$ref": "#/$defs/digest"
            },
            "provider_call_count": {
              "type": "integer",
              "minimum": 0
            },
            "elapsed_milliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_references": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonempty_string"
              }
            },
            "token_counts": {
              "oneOf": [
                {
                  "const": "UNKNOWN"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "input": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "input",
                    "output"
                  ]
                }
              ]
            },
            "cost": {
              "oneOf": [
                {
                  "const": "UNKNOWN"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cost_microunits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    }
                  },
                  "required": [
                    "cost_microunits",
                    "currency"
                  ]
                }
              ]
            }
          },
          "required": [
            "opaque_arm_label",
            "treatment_id",
            "command_digest",
            "lifecycle_outcome",
            "product_frozen",
            "provider_call_count",
            "elapsed_milliseconds",
            "evidence_references",
            "token_counts",
            "cost"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "product_frozen": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "product_manifest_digest"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "product_manifest_digest"
                  ]
                }
              }
            }
          ]
        },
        "treatment_executions": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/treatment_execution"
          }
        }
      },
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "const": "block_attempt.v1"
        },
        "pilot_lock_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_class": {
          "enum": [
            "FIXTURE",
            "SMOKE",
            "LIVE"
          ]
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "block_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "status": {
          "enum": [
            "STARTED",
            "VALID",
            "INVALID",
            "ABORTED"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/nonempty_string"
        },
        "treatment_executions": {
          "$ref": "#/$defs/treatment_executions"
        }
      },
      "required": [
        "record_kind",
        "pilot_lock_digest",
        "attempt_class",
        "sequence_index",
        "block_id",
        "status"
      ],
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "STARTED"
            },
            "treatment_executions": {
              "maxItems": 0
            }
          },
          "not": {
            "required": [
              "reason_code"
            ]
          }
        },
        {
          "properties": {
            "status": {
              "const": "VALID"
            },
            "treatment_executions": {
              "minItems": 3,
              "maxItems": 3,
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "treatment_id": {
                        "const": "DIRECT"
                      }
                    },
                    "required": [
                      "treatment_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "treatment_id": {
                        "const": "COORDINATOR"
                      }
                    },
                    "required": [
                      "treatment_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "treatment_id": {
                        "const": "ORC"
                      }
                    },
                    "required": [
                      "treatment_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          },
          "required": [
            "treatment_executions"
          ],
          "not": {
            "required": [
              "reason_code"
            ]
          }
        },
        {
          "properties": {
            "status": {
              "enum": [
                "INVALID",
                "ABORTED"
              ]
            }
          },
          "required": [
            "reason_code"
          ]
        }
      ]
    },
    "review_result.v1": {
      "$defs": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nonempty_string": {
          "type": "string",
          "minLength": 1
        },
        "evidence_citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      },
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "const": "review_result.v1"
        },
        "review_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "pilot_lock_digest": {
          "$ref": "#/$defs/digest"
        },
        "reviewer_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "session_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "review_class": {
          "enum": [
            "CALIBRATION",
            "LIVE"
          ]
        },
        "rubric_digest": {
          "$ref": "#/$defs/digest"
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "opaque_label": {
                "$ref": "#/$defs/nonempty_string"
              },
              "evidence_citations": {
                "$ref": "#/$defs/evidence_citations"
              },
              "sealed_treatment_guess": {
                "enum": [
                  "DIRECT",
                  "COORDINATOR",
                  "ORC",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "opaque_label",
              "evidence_citations",
              "sealed_treatment_guess"
            ]
          }
        },
        "pairwise_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_a_label": {
                "$ref": "#/$defs/nonempty_string"
              },
              "candidate_b_label": {
                "$ref": "#/$defs/nonempty_string"
              },
              "outcome": {
                "enum": [
                  "A",
                  "B",
                  "TIE",
                  "INDETERMINATE"
                ]
              },
              "evidence_citations": {
                "$ref": "#/$defs/evidence_citations"
              }
            },
            "required": [
              "candidate_a_label",
              "candidate_b_label",
              "outcome",
              "evidence_citations"
            ]
          }
        }
      },
      "required": [
        "record_kind",
        "review_id",
        "pilot_lock_digest",
        "reviewer_id",
        "session_id",
        "review_class",
        "rubric_digest",
        "candidates",
        "pairwise_results"
      ]
    },
    "pilot_summary.v1": {
      "$defs": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nonempty_string": {
          "type": "string",
          "minLength": 1
        },
        "fraction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "exact_value": {
          "oneOf": [
            {
              "const": "UNKNOWN"
            },
            {
              "$ref": "#/$defs/fraction"
            }
          ]
        },
        "product_quality_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "A",
                "B",
                "TIE",
                "INDETERMINATE"
              ]
            },
            "review_result_digests": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "required": [
            "outcome",
            "review_result_digests"
          ]
        },
        "method_outcome": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "comparison": {
              "enum": [
                "DIRECT_VS_ORC",
                "COORDINATOR_VS_ORC"
              ]
            },
            "viability_case": {
              "enum": [
                "A_ONLY",
                "B_ONLY",
                "BOTH",
                "NEITHER"
              ]
            },
            "method_outcome": {
              "enum": [
                "A_WIN",
                "B_WIN",
                "TIE",
                "INDETERMINATE",
                "TIE_NONVIABLE"
              ]
            },
            "product_quality_review": {
              "oneOf": [
                {
                  "enum": [
                    "NOT_APPLICABLE",
                    "NOT_REVIEWABLE"
                  ]
                },
                {
                  "$ref": "#/$defs/product_quality_review"
                }
              ]
            }
          },
          "required": [
            "comparison",
            "viability_case",
            "method_outcome",
            "product_quality_review"
          ],
          "oneOf": [
            {
              "properties": {
                "viability_case": {
                  "const": "A_ONLY"
                },
                "method_outcome": {
                  "const": "A_WIN"
                },
                "product_quality_review": {
                  "const": "NOT_APPLICABLE"
                }
              }
            },
            {
              "properties": {
                "viability_case": {
                  "const": "B_ONLY"
                },
                "method_outcome": {
                  "const": "B_WIN"
                },
                "product_quality_review": {
                  "const": "NOT_APPLICABLE"
                }
              }
            },
            {
              "properties": {
                "viability_case": {
                  "const": "BOTH"
                },
                "product_quality_review": {
                  "$ref": "#/$defs/product_quality_review"
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "method_outcome": {
                      "const": "A_WIN"
                    },
                    "product_quality_review": {
                      "properties": {
                        "outcome": {
                          "const": "A"
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "method_outcome": {
                      "const": "B_WIN"
                    },
                    "product_quality_review": {
                      "properties": {
                        "outcome": {
                          "const": "B"
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "method_outcome": {
                      "const": "TIE"
                    },
                    "product_quality_review": {
                      "properties": {
                        "outcome": {
                          "const": "TIE"
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "method_outcome": {
                      "const": "INDETERMINATE"
                    },
                    "product_quality_review": {
                      "properties": {
                        "outcome": {
                          "const": "INDETERMINATE"
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "properties": {
                "viability_case": {
                  "const": "NEITHER"
                },
                "method_outcome": {
                  "const": "TIE_NONVIABLE"
                },
                "product_quality_review": {
                  "oneOf": [
                    {
                      "const": "NOT_REVIEWABLE"
                    },
                    {
                      "$ref": "#/$defs/product_quality_review"
                    }
                  ]
                }
              }
            }
          ]
        },
        "valid_block": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "block_id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "block_attempt_digest": {
              "$ref": "#/$defs/digest"
            },
            "method_outcomes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/method_outcome"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "comparison": {
                        "const": "DIRECT_VS_ORC"
                      }
                    },
                    "required": [
                      "comparison"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "comparison": {
                        "const": "COORDINATOR_VS_ORC"
                      }
                    },
                    "required": [
                      "comparison"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          },
          "required": [
            "block_id",
            "block_attempt_digest",
            "method_outcomes"
          ]
        },
        "excluded_block_reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "block_id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "block_attempt_digest": {
              "$ref": "#/$defs/digest"
            },
            "status": {
              "enum": [
                "INVALID",
                "ABORTED",
                "STARTED"
              ]
            }
          },
          "required": [
            "block_id",
            "block_attempt_digest",
            "status"
          ]
        },
        "median": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": {
              "$ref": "#/$defs/nonempty_string"
            },
            "treatment_id": {
              "enum": [
                "DIRECT",
                "COORDINATOR",
                "ORC"
              ]
            },
            "value": {
              "$ref": "#/$defs/exact_value"
            }
          },
          "required": [
            "metric",
            "treatment_id",
            "value"
          ]
        },
        "ratio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": {
              "$ref": "#/$defs/nonempty_string"
            },
            "numerator_treatment_id": {
              "enum": [
                "DIRECT",
                "COORDINATOR",
                "ORC"
              ]
            },
            "denominator_treatment_id": {
              "enum": [
                "DIRECT",
                "COORDINATOR",
                "ORC"
              ]
            },
            "value": {
              "$ref": "#/$defs/exact_value"
